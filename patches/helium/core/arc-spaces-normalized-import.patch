+bool SamePinNode(const base::DictValue& stored,
+                 const base::DictValue& captured) {
+  const std::string* stored_type = stored.FindString(kTypeKey);
+  const std::string* captured_type = captured.FindString(kTypeKey);
+  if (!stored_type || !captured_type || *stored_type != *captured_type) {
+    return false;
