+
+#include "chrome/browser/ui/helium/helium_space_model.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <variant>
+#include <vector>
+
+#include "base/values.h"
+
+namespace helium {
+
+namespace {
+
+constexpr char kVersionKey[] = "version";
+constexpr char kSourceProfileKey[] = "source_profile";
+constexpr char kFavoritesKey[] = "favorites";
+constexpr char kSpacesKey[] = "spaces";
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kPinsKey[] = "pins";
+
+constexpr char kTypeKey[] = "type";
+constexpr char kTabType[] = "tab";
+constexpr char kFolderType[] = "folder";
+constexpr char kSourceIdKey[] = "source_id";
+constexpr char kTitleKey[] = "title";
+constexpr char kUrlKey[] = "url";
+constexpr char kCollapsedKey[] = "collapsed";
+constexpr char kChildrenKey[] = "children";
+
+base::Value EncodeTab(const HeliumSpaceTab& tab) {
+  base::DictValue value;
+  value.Set(kTypeKey, kTabType);
+  value.Set(kSourceIdKey, tab.source_id);
+  value.Set(kTitleKey, tab.title);
+  value.Set(kUrlKey, tab.url.spec());
+  return base::Value(std::move(value));
+}
+
+base::Value EncodeNode(const HeliumSpaceNode& node);
+
+base::Value EncodeFolder(const HeliumSpaceFolder& folder) {
+  base::ListValue children;
+  children.reserve(folder.children.size());
+  for (const HeliumSpaceNode& child : folder.children) {
+    children.Append(EncodeNode(child));
+  }
+
+  base::DictValue value;
+  value.Set(kTypeKey, kFolderType);
+  value.Set(kSourceIdKey, folder.source_id);
+  value.Set(kTitleKey, folder.title);
+  value.Set(kCollapsedKey, folder.collapsed);
+  value.Set(kChildrenKey, std::move(children));
+  return base::Value(std::move(value));
+}
+
+base::Value EncodeNode(const HeliumSpaceNode& node) {
+  if (const auto* tab = std::get_if<HeliumSpaceTab>(&node.data)) {
+    return EncodeTab(*tab);
+  }
+  return EncodeFolder(std::get<HeliumSpaceFolder>(node.data));
+}
+
+std::optional<HeliumSpaceTab> DecodeTab(const base::DictValue& value) {
+  if (value.size() != 4u) {
+    return std::nullopt;
+  }
+
+  const std::string* type = value.FindString(kTypeKey);
+  const std::string* source_id = value.FindString(kSourceIdKey);
+  const std::string* title = value.FindString(kTitleKey);
+  const std::string* url_string = value.FindString(kUrlKey);
+  if (!type || *type != kTabType || !source_id || source_id->empty() ||
+      !title || !url_string || url_string->empty()) {
+    return std::nullopt;
+  }
+
+  GURL url(*url_string);
+  if (!url.is_valid()) {
+    return std::nullopt;
+  }
+
+  return HeliumSpaceTab{
+      .source_id = *source_id,
+      .title = *title,
+      .url = std::move(url),
+  };
+}
+
+std::optional<HeliumSpaceNode> DecodeNode(const base::Value& value) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict) {
+    return std::nullopt;
+  }
+
+  const std::string* type = dict->FindString(kTypeKey);
+  if (!type) {
+    return std::nullopt;
+  }
+
+  if (*type == kTabType) {
+    std::optional<HeliumSpaceTab> tab = DecodeTab(*dict);
+    if (!tab) {
+      return std::nullopt;
+    }
+    return HeliumSpaceNode{.data = std::move(*tab)};
+  }
+
+  if (*type != kFolderType) {
+    return std::nullopt;
+  }
+
+  if (dict->size() != 5u) {
+    return std::nullopt;
+  }
+
+  const std::string* source_id = dict->FindString(kSourceIdKey);
+  const std::string* title = dict->FindString(kTitleKey);
+  std::optional<bool> collapsed = dict->FindBool(kCollapsedKey);
+  const base::ListValue* encoded_children = dict->FindList(kChildrenKey);
+  if (!source_id || source_id->empty() || !title || !collapsed ||
+      !encoded_children) {
+    return std::nullopt;
+  }
+
+  std::vector<HeliumSpaceNode> children;
+  children.reserve(encoded_children->size());
+  for (const base::Value& encoded_child : *encoded_children) {
+    std::optional<HeliumSpaceNode> child = DecodeNode(encoded_child);
+    if (!child) {
+      return std::nullopt;
+    }
+    children.push_back(std::move(*child));
+  }
+
+  return HeliumSpaceNode{.data = HeliumSpaceFolder{
+                             .source_id = *source_id,
+                             .title = *title,
+                             .collapsed = *collapsed,
+                             .children = std::move(children),
+                         }};
+}
+
+std::optional<HeliumSpaceRecord> DecodeSpace(const base::Value& value) {
+  const base::DictValue* dict = value.GetIfDict();
+  if (!dict || dict->size() != 4u) {
+    return std::nullopt;
+  }
+
+  const std::string* id = dict->FindString(kIdKey);
+  const std::string* name = dict->FindString(kNameKey);
+  const std::string* source_profile = dict->FindString(kSourceProfileKey);
+  const base::ListValue* encoded_pins = dict->FindList(kPinsKey);
+  if (!id || id->empty() || !name || !source_profile ||
+      source_profile->empty() || !encoded_pins) {
+    return std::nullopt;
+  }
+
+  std::vector<HeliumSpaceNode> pins;
+  pins.reserve(encoded_pins->size());
+  for (const base::Value& encoded_pin : *encoded_pins) {
+    std::optional<HeliumSpaceNode> pin = DecodeNode(encoded_pin);
+    if (!pin) {
+      return std::nullopt;
+    }
+    pins.push_back(std::move(*pin));
+  }
+
+  return HeliumSpaceRecord{
+      .id = *id,
+      .name = *name,
+      .source_profile = *source_profile,
+      .pins = std::move(pins),
+  };
+}
+
+base::Value EncodeSpace(const HeliumSpaceRecord& space) {
+  base::ListValue pins;
+  pins.reserve(space.pins.size());
+  for (const HeliumSpaceNode& pin : space.pins) {
+    pins.Append(EncodeNode(pin));
+  }
+
+  base::DictValue value;
+  value.Set(kIdKey, space.id);
+  value.Set(kNameKey, space.name);
+  value.Set(kSourceProfileKey, space.source_profile);
+  value.Set(kPinsKey, std::move(pins));
+  return base::Value(std::move(value));
+}
+
+}  // namespace
+
+base::Value HeliumSpaceModel::ToValue() const {
+  base::ListValue encoded_favorites;
+  encoded_favorites.reserve(favorites.size());
+  for (const HeliumSpaceTab& favorite : favorites) {
+    encoded_favorites.Append(EncodeTab(favorite));
+  }
+
+  base::ListValue encoded_spaces;
+  encoded_spaces.reserve(spaces.size());
+  for (const HeliumSpaceRecord& space : spaces) {
+    encoded_spaces.Append(EncodeSpace(space));
+  }
+
+  base::DictValue root;
+  root.Set(kVersionKey, kCurrentVersion);
+  root.Set(kSourceProfileKey, source_profile);
+  root.Set(kFavoritesKey, std::move(encoded_favorites));
+  root.Set(kSpacesKey, std::move(encoded_spaces));
+  return base::Value(std::move(root));
+}
+
+// static
+std::optional<HeliumSpaceModel> HeliumSpaceModel::FromValue(
+    const base::Value& value) {
+  const base::DictValue* root = value.GetIfDict();
+  if (!root || root->size() != 4u ||
+      root->FindInt(kVersionKey) != kCurrentVersion) {
+    return std::nullopt;
+  }
+
+  const std::string* source_profile = root->FindString(kSourceProfileKey);
+  const base::ListValue* encoded_favorites = root->FindList(kFavoritesKey);
+  const base::ListValue* encoded_spaces = root->FindList(kSpacesKey);
+  if (!source_profile || source_profile->empty() || !encoded_favorites ||
+      !encoded_spaces) {
+    return std::nullopt;
+  }
+
+  std::vector<HeliumSpaceTab> favorites;
+  favorites.reserve(encoded_favorites->size());
+  for (const base::Value& encoded_favorite : *encoded_favorites) {
+    const base::DictValue* favorite_dict = encoded_favorite.GetIfDict();
+    if (!favorite_dict) {
+      return std::nullopt;
+    }
+    std::optional<HeliumSpaceTab> favorite = DecodeTab(*favorite_dict);
+    if (!favorite) {
+      return std::nullopt;
+    }
+    favorites.push_back(std::move(*favorite));
+  }
+
+  std::vector<HeliumSpaceRecord> spaces;
+  spaces.reserve(encoded_spaces->size());
+  for (const base::Value& encoded_space : *encoded_spaces) {
+    std::optional<HeliumSpaceRecord> space = DecodeSpace(encoded_space);
+    if (!space) {
+      return std::nullopt;
+    }
+    spaces.push_back(std::move(*space));
+  }
+
+  return HeliumSpaceModel{
+      .source_profile = *source_profile,
+      .favorites = std::move(favorites),
+      .spaces = std::move(spaces),
+  };
+}
+
+}  // namespace helium
