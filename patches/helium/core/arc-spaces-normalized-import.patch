+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_MODEL_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_MODEL_H_
+
+#include <optional>
+#include <string>
+#include <variant>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace helium {
+
+// A persistent tab imported from a source browser. `source_id` is the stable
+// identity used to reconcile later imports.
+struct HeliumSpaceTab {
+  std::string source_id;
+  std::string title;
+  GURL url;
+
+  bool operator==(const HeliumSpaceTab&) const = default;
+};
+
+struct HeliumSpaceNode;
+
+// A folder remains a first-class node even when it has no children. This
+// preserves empty folders, ordering, and collapsed state across persistence.
+struct HeliumSpaceFolder {
+  std::string source_id;
+  std::string title;
+  bool collapsed = false;
+  std::vector<HeliumSpaceNode> children;
+
+  bool operator==(const HeliumSpaceFolder&) const = default;
+};
+
+// An ordered pin-tree entry. Tabs and folders deliberately have disjoint
+// representations so a malformed mixed node cannot enter the model through
+// decoding.
+struct HeliumSpaceNode {
+  std::variant<HeliumSpaceTab, HeliumSpaceFolder> data;
+
+  bool operator==(const HeliumSpaceNode&) const = default;
+};
+
+struct HeliumSpaceRecord {
+  std::string id;
+  std::string name;
+  std::string source_profile;
+  std::vector<HeliumSpaceNode> pins;
+
+  bool operator==(const HeliumSpaceRecord&) const = default;
+};
+
+// Lossless normalized representation of an imported sidebar snapshot.
+// Favorites are profile-wide tabs; each Space owns an ordered recursive pin
+// tree and records the source profile that supplied it.
+struct HeliumSpaceModel {
+  static constexpr int kCurrentVersion = 1;
+
+  std::string source_profile;
+  std::vector<HeliumSpaceTab> favorites;
+  std::vector<HeliumSpaceRecord> spaces;
+
+  base::Value ToValue() const;
+  static std::optional<HeliumSpaceModel> FromValue(const base::Value& value);
+
+  bool operator==(const HeliumSpaceModel&) const = default;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_SPACE_MODEL_H_
