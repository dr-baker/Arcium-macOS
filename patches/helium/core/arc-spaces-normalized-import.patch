+void ApplyArcSidebarModel(Profile* profile,
+                          HeliumSpaceService* service,
+                          const HeliumSpaceModel& model) {
+  CHECK(profile);
+  CHECK(service);
+  StartupTabs favorites = PinnedTabCodec::ReadPinnedTabs(profile);
+  const std::string source_prefix =
+      base::StrCat({"arc:", model.source_profile, ":"});
+  std::erase_if(favorites, [&source_prefix](const StartupTab& tab) {
+    return tab.helium_source_id.starts_with(source_prefix);
+  });
+  StartupTabs imported_favorites;
+  for (const HeliumSpaceTab& imported : model.favorites) {
+    StartupTab favorite(imported.url, StartupTab::Type::kPinned);
+    favorite.helium_has_home = true;
+    favorite.helium_home_title = base::UTF8ToUTF16(imported.title);
+    favorite.helium_source_id =
+        ArcFavoriteId(model.source_profile, imported.source_id);
+    imported_favorites.push_back(std::move(favorite));
+  }
+  // Arc Favorites belong to an Arc profile and are shared only by that
+  // profile's Spaces. Keep Chromium's native pinned-tabs preference for local
+  // Favorites so importing several Arc profiles cannot pool their rows.
+  PinnedTabCodec::WritePinnedTabs(profile, favorites);
+  ScopedDictPrefUpdate update(profile->GetPrefs(),
+                              kHeliumArcFavoritesByProfilePref);
+  update->Set(model.source_profile,
+              PinnedTabCodec::EncodeTabs(imported_favorites));

