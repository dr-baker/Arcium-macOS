+++ src/chrome/utility/importer/arc_sidebar_snapshot.cc
@@ -0,0 +1,377 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/utility/importer/arc_sidebar_snapshot.h"
+
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace helium {
+
+namespace {
+
+enum class RawItemKind {
+  kUnknown,
+  kTab,
+  kFolder,
+  kContainer,
+  kSplitView,
+};
+
+struct RawItem {
+  std::string id;
+  std::string title;
+  std::string saved_title;
+  std::string saved_url;
+  bool collapsed = false;
+  std::vector<std::string> children_ids;
+  RawItemKind kind = RawItemKind::kUnknown;
+};
+
+enum class WalkMode {
+  kFavorites,
+  kPins,
+};
+
+std::optional<bool> FindCollapsed(const base::DictValue& item,
+                                  const base::DictValue* kind_data) {
+  if (std::optional<bool> collapsed = item.FindBool("collapsed")) {
+    return collapsed;
+  }
+  if (std::optional<bool> collapsed = item.FindBool("isCollapsed")) {
+    return collapsed;
+  }
+  if (kind_data) {
+    if (std::optional<bool> collapsed = kind_data->FindBool("collapsed")) {
+      return collapsed;
+    }
+    if (std::optional<bool> collapsed = kind_data->FindBool("isCollapsed")) {
+      return collapsed;
+    }
+  }
+  return std::nullopt;
+}
+
+std::map<std::string, RawItem> ParseItems(const base::ListValue& item_values) {
+  std::map<std::string, RawItem> items;
+  for (size_t i = 0; i + 1 < item_values.size(); i += 2) {
+    const std::string* id = item_values[i].GetIfString();
+    const base::DictValue* value = item_values[i + 1].GetIfDict();
+    if (!id || id->empty() || !value) {
+      continue;
+    }
+
+    RawItem item;
+    item.id = *id;
+    if (const std::string* title = value->FindString("title")) {
+      item.title = *title;
+    }
+    if (const base::ListValue* child_values = value->FindList("childrenIds")) {
+      item.children_ids.reserve(child_values->size());
+      for (const base::Value& child_value : *child_values) {
+        if (const std::string* child_id = child_value.GetIfString()) {
+          item.children_ids.push_back(*child_id);
+        }
+      }
+    }
+
+    const base::DictValue* data = value->FindDict("data");
+    const base::DictValue* kind_data = nullptr;
+    if (data) {
+      if (const base::DictValue* tab = data->FindDict("tab")) {
+        item.kind = RawItemKind::kTab;
+        kind_data = tab;
+        if (const std::string* url = tab->FindString("savedURL")) {
+          item.saved_url = *url;
+        }
+        if (const std::string* title = tab->FindString("savedTitle")) {
+          item.saved_title = *title;
+        }
+      } else if (const base::DictValue* list = data->FindDict("list")) {
+        item.kind = RawItemKind::kFolder;
+        kind_data = list;
+      } else if (const base::DictValue* tab_group =
+                     data->FindDict("tabGroup")) {
+        item.kind = RawItemKind::kFolder;
+        kind_data = tab_group;
+        if (const std::string* title = tab_group->FindString("title")) {
+          item.title = *title;
+        }
+      } else if (const base::DictValue* container =
+                     data->FindDict("itemContainer")) {
+        item.kind = RawItemKind::kContainer;
+        kind_data = container;
+      } else if (const base::DictValue* split_view =
+                     data->FindDict("splitView")) {
+        item.kind = RawItemKind::kSplitView;
+        kind_data = split_view;
+      }
+    }
+    item.collapsed = FindCollapsed(*value, kind_data).value_or(false);
+    items.insert_or_assign(item.id, std::move(item));
+  }
+  return items;
+}
+
+std::string ParseProfileDirectory(const base::DictValue* profile) {
+  if (!profile) {
+    return {};
+  }
+  if (profile->FindBool("default").value_or(false)) {
+    return "Default";
+  }
+
+  const base::DictValue* custom = profile->FindDict("custom");
+  if (!custom) {
+    return {};
+  }
+  const base::DictValue* payload = custom->FindDict("_0");
+  if (!payload) {
+    payload = custom;
+  }
+  const std::string* directory = payload->FindString("directoryBasename");
+  return directory ? *directory : std::string();
+}
+
+const base::DictValue* FindSidebarData(const base::DictValue& root) {
+  const base::DictValue* sidebar = root.FindDict("sidebar");
+  const base::ListValue* containers =
+      sidebar ? sidebar->FindList("containers") : nullptr;
+  if (!containers) {
+    return nullptr;
+  }
+
+  for (const base::Value& container_value : *containers) {
+    const base::DictValue* container = container_value.GetIfDict();
+    if (container && container->FindList("items")) {
+      return container;
+    }
+  }
+  return nullptr;
+}
+
+std::string DisplayTitle(const RawItem& item) {
+  return item.title.empty() ? item.saved_title : item.title;
+}
+
+void AppendNodes(const std::string& item_id,
+                 WalkMode mode,
+                 const std::map<std::string, RawItem>& items,
+                 std::unordered_set<std::string>* ancestors,
+                 std::vector<ArcSidebarNode>* output) {
+  const auto item_it = items.find(item_id);
+  if (item_it == items.end() || !ancestors->insert(item_id).second) {
+    return;
+  }
+
+  const RawItem& item = item_it->second;
+  switch (item.kind) {
+    case RawItemKind::kTab: {
+      const GURL url(item.saved_url);
+      if (url.is_valid() && !url.SchemeIs("arc")) {
+        output->push_back(ArcSidebarNode{
+            .type = ArcSidebarNode::Type::kTab,
+            .source_id = item.id,
+            .title = DisplayTitle(item),
+            .url = url.spec(),
+        });
+      }
+      break;
+    }
+    case RawItemKind::kFolder: {
+      if (mode == WalkMode::kFavorites) {
+        // Favorites are profile-wide tabs in Helium. If a synced Arc snapshot
+        // contains a structural wrapper here, retain its tab order without
+        // emitting a folder that the normalized model cannot represent.
+        for (const std::string& child_id : item.children_ids) {
+          AppendNodes(child_id, mode, items, ancestors, output);
+        }
+        break;
+      }
+
+      ArcSidebarNode folder{
+          .type = ArcSidebarNode::Type::kFolder,
+          .source_id = item.id,
+          .title = DisplayTitle(item),
+          .collapsed = item.collapsed,
+      };
+      for (const std::string& child_id : item.children_ids) {
+        AppendNodes(child_id, mode, items, ancestors, &folder.children);
+      }
+      output->push_back(std::move(folder));
+      break;
+    }
+    case RawItemKind::kUnknown:
+    case RawItemKind::kContainer:
+    case RawItemKind::kSplitView:
+      // Arc split views have presentation metadata but Helium's normalized
+      // model has no split node. Flatten their children at the split's exact
+      // position so tabs and folders retain relative sidebar order.
+      for (const std::string& child_id : item.children_ids) {
+        AppendNodes(child_id, mode, items, ancestors, output);
+      }
+      break;
+  }
+
+  ancestors->erase(item_id);
+}
+
+std::string FindPinnedContainerId(const base::DictValue& space) {
+  const base::ListValue* container_ids = space.FindList("containerIDs");
+  if (!container_ids) {
+    return {};
+  }
+  for (size_t i = 0; i + 1 < container_ids->size(); i += 2) {
+    const std::string* kind = (*container_ids)[i].GetIfString();
+    const std::string* id = (*container_ids)[i + 1].GetIfString();
+    if (kind && id && *kind == "pinned") {
+      return *id;
+    }
+  }
+  return {};
+}
+
+void ParseFavorites(const base::DictValue& sidebar_data,
+                    std::string_view source_profile_directory,
+                    const std::map<std::string, RawItem>& items,
+                    std::vector<ArcSidebarNode>* favorites) {
+  const base::ListValue* top_apps =
+      sidebar_data.FindList("topAppsContainerIDs");
+  if (!top_apps) {
+    return;
+  }
+
+  for (size_t i = 0; i + 1 < top_apps->size(); i += 2) {
+    const base::DictValue* profile = (*top_apps)[i].GetIfDict();
+    const std::string* container_id = (*top_apps)[i + 1].GetIfString();
+    if (!container_id ||
+        ParseProfileDirectory(profile) != source_profile_directory) {
+      continue;
+    }
+    std::unordered_set<std::string> ancestors;
+    AppendNodes(*container_id, WalkMode::kFavorites, items, &ancestors,
+                favorites);
+  }
+}
+
+void ParseSpaces(const base::DictValue& sidebar_data,
+                 std::string_view source_profile_directory,
+                 const std::map<std::string, RawItem>& items,
+                 std::vector<ArcSidebarSpace>* spaces) {
+  const base::ListValue* space_values = sidebar_data.FindList("spaces");
+  if (!space_values) {
+    return;
+  }
+
+  for (size_t i = 0; i + 1 < space_values->size(); i += 2) {
+    const std::string* space_id = (*space_values)[i].GetIfString();
+    const base::DictValue* space_value = (*space_values)[i + 1].GetIfDict();
+    if (!space_id || space_id->empty() || !space_value ||
+        ParseProfileDirectory(space_value->FindDict("profile")) !=
+            source_profile_directory) {
+      continue;
+    }
+
+    ArcSidebarSpace space{
+        .id = *space_id,
+        .source_profile = std::string(source_profile_directory),
+    };
+    if (const std::string* name = space_value->FindString("title")) {
+      space.name = *name;
+    }
+
+    const std::string pinned_container_id = FindPinnedContainerId(*space_value);
+    if (!pinned_container_id.empty()) {
+      std::unordered_set<std::string> ancestors;
+      AppendNodes(pinned_container_id, WalkMode::kPins, items, &ancestors,
+                  &space.pins);
+    }
+    spaces->push_back(std::move(space));
+  }
+}
+
+base::ListValue NodesToList(const std::vector<ArcSidebarNode>& nodes) {
+  base::ListValue values;
+  values.reserve(nodes.size());
+  for (const ArcSidebarNode& node : nodes) {
+    values.Append(node.ToDict());
+  }
+  return values;
+}
+
+}  // namespace
+
+base::DictValue ArcSidebarNode::ToDict() const {
+  base::DictValue value;
+  value.Set("type", type == Type::kTab ? "tab" : "folder");
+  value.Set("source_id", source_id);
+  value.Set("title", title);
+  if (type == Type::kTab) {
+    value.Set("url", url);
+  } else {
+    value.Set("collapsed", collapsed);
+    value.Set("children", NodesToList(children));
+  }
+  return value;
+}
+
+base::DictValue ArcSidebarSpace::ToDict() const {
+  base::DictValue value;
+  value.Set("id", id);
+  value.Set("name", name);
+  value.Set("source_profile", source_profile);
+  value.Set("pins", NodesToList(pins));
+  return value;
+}
+
+base::DictValue ArcSidebarSnapshot::ToDict() const {
+  base::ListValue space_values;
+  space_values.reserve(spaces.size());
+  for (const ArcSidebarSpace& space : spaces) {
+    space_values.Append(space.ToDict());
+  }
+
+  base::DictValue value;
+  value.Set("version", version);
+  value.Set("source_profile", source_profile);
+  value.Set("favorites", NodesToList(favorites));
+  value.Set("spaces", std::move(space_values));
+  return value;
+}
+
+std::optional<ArcSidebarSnapshot> ParseArcSidebarSnapshot(
+    const base::DictValue& root,
+    std::string_view source_profile_directory) {
+  if (source_profile_directory.empty()) {
+    return std::nullopt;
+  }
+  const base::DictValue* sidebar_data = FindSidebarData(root);
+  if (!sidebar_data) {
+    return std::nullopt;
+  }
+
+  const base::ListValue* item_values = sidebar_data->FindList("items");
+  if (!item_values) {
+    return std::nullopt;
+  }
+  const std::map<std::string, RawItem> items = ParseItems(*item_values);
+
+  ArcSidebarSnapshot snapshot{
+      .source_profile = std::string(source_profile_directory),
+  };
+  ParseFavorites(*sidebar_data, source_profile_directory, items,
+                 &snapshot.favorites);
+  ParseSpaces(*sidebar_data, source_profile_directory, items, &snapshot.spaces);
+  return snapshot;
+}
+
+}  // namespace helium
