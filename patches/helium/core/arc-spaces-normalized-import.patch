+void HeliumSpaceService::ReconcileImportedSpaces(
+    const HeliumSpaceModel& model) {
+  PrepareForArcImport();
+
+  base::Value encoded_model = model.ToValue();
+  const base::ListValue* imported_spaces =
+      encoded_model.GetDict().FindList("spaces");
+  CHECK(imported_spaces);
+
+  std::set<std::string> imported_ids;
+  for (const base::Value& value : *imported_spaces) {
+    const std::string* id = value.GetDict().FindString("id");
+    CHECK(id);
+    imported_ids.insert(*id);
+  }
+
+  base::ListValue reconciled;
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(kHeliumSpacesPref)) {
+    const base::DictValue* record = value.GetIfDict();
+    if (!record) {
+      continue;
+    }
+    const std::string* id = record->FindString("id");
+    const std::string* source_profile = record->FindString("source_profile");
+    if ((source_profile && *source_profile == model.source_profile) ||
+        (id && imported_ids.contains(*id))) {
+      continue;
+    }
+    reconciled.Append(value.Clone());
+  }
+  for (const base::Value& value : *imported_spaces) {
+    reconciled.Append(value.Clone());
+  }
+  profile_->GetPrefs()->SetList(kHeliumSpacesPref, std::move(reconciled));
+
+  spaces_.clear();
+  LoadSpaces();
+  std::erase_if(session_space_ids_, [this](const auto& entry) {
+    return !GetSpaceById(entry.second);
+  });
+  EnsureDefaultSpace();
+}
