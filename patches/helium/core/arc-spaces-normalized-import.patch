+  const base::ListValue* children = node.FindList(kChildrenKey);
+  if (!children) {
+    return false;
+  }
+  for (const base::Value& child : *children) {
+    const base::DictValue* child_dict = child.GetIfDict();
+    if (child_dict && ContainsTabNode(*child_dict)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void MergeImportedNodeMetadata(const base::ListValue& stored,
+                               base::ListValue* captured) {
+  std::vector<bool> matched(stored.size(), false);
+  for (base::Value& captured_value : *captured) {
+    base::DictValue* captured_node = captured_value.GetIfDict();
+    if (!captured_node) {
+      continue;
+    }
+    for (size_t i = 0; i < stored.size(); ++i) {
+      const base::DictValue* stored_node = stored[i].GetIfDict();
+      if (matched[i] || !stored_node ||
+          !SamePinNode(*stored_node, *captured_node)) {
+        continue;
+      }
+      matched[i] = true;
+      if (const std::string* source_id =
+              stored_node->FindString(kSourceIdKey)) {
+        captured_node->Set(kSourceIdKey, *source_id);
+      }
+      const base::ListValue* stored_children =
+          stored_node->FindList(kChildrenKey);
+      base::ListValue* captured_children =
+          captured_node->FindList(kChildrenKey);
+      if (stored_children && captured_children) {
+        MergeImportedNodeMetadata(*stored_children, captured_children);
+      }
+      break;
+    }
+  }
+
+  // The current tab collection cannot materialize an imported empty folder.
+  // Keep those source nodes in persistence until the folder UI can display or
+  // explicitly delete them.
+  for (size_t i = 0; i < stored.size(); ++i) {
+    const base::DictValue* stored_node = stored[i].GetIfDict();
+    if (!matched[i] && stored_node && !ContainsTabNode(*stored_node)) {
+      captured->Append(stored[i].Clone());
+    }
+  }
+}
