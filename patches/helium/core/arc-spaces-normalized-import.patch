+  const char* identity_key = *stored_type == kFolderType ? kTitleKey : kUrlKey;
+  const std::string* stored_identity = stored.FindString(identity_key);
+  const std::string* captured_identity = captured.FindString(identity_key);
+  return stored_identity && captured_identity &&
