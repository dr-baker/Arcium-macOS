+TEST(HeliumSpaceModelTest, ExactValueRoundTripPreservesOrderedTree) {
+  const HeliumSpaceModel model = MakeModel();
+  base::Value encoded = model.ToValue();
+
+  std::optional<HeliumSpaceModel> decoded =
+      HeliumSpaceModel::FromValue(encoded);
+
+  ASSERT_TRUE(decoded);
+  EXPECT_EQ(model, *decoded);
+  EXPECT_EQ(encoded, decoded->ToValue());
+
+  ASSERT_EQ(2u, decoded->spaces.size());
+  ASSERT_EQ(3u, decoded->spaces[0].pins.size());
+  const auto* populated_folder =
+      std::get_if<HeliumSpaceFolder>(&decoded->spaces[0].pins[1].data);
+  ASSERT_NE(nullptr, populated_folder);
+  EXPECT_EQ("folder-full", populated_folder->source_id);
+  EXPECT_TRUE(populated_folder->collapsed);
+  ASSERT_EQ(2u, populated_folder->children.size());
+  EXPECT_EQ(
+      "pin-nested-1",
+      std::get<HeliumSpaceTab>(populated_folder->children[0].data).source_id);
+  EXPECT_EQ(
+      "pin-nested-2",
+      std::get<HeliumSpaceTab>(populated_folder->children[1].data).source_id);
+
+  const auto* empty_folder =
+      std::get_if<HeliumSpaceFolder>(&decoded->spaces[0].pins[2].data);
+  ASSERT_NE(nullptr, empty_folder);
+  EXPECT_EQ("folder-empty", empty_folder->source_id);
+  EXPECT_TRUE(empty_folder->children.empty());
+}
