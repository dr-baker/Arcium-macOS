+// Owns itself until the pending primary navigation has committed. Discarding
+// earlier preserves only the initial about:blank entry in the replacement
+// WebContents, corrupting the URL that should be restored on activation.
+class AnchoredTabCommitDiscarder : public content::WebContentsObserver {
+ public:
+  explicit AnchoredTabCommitDiscarder(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override {
+    if (!navigation_handle->IsInPrimaryMainFrame() ||
+        !navigation_handle->HasCommitted()) {
+      return;
+    }
+    content::WebContents* contents = web_contents();
+    if (!contents) {
+      delete this;
+      return;
+    }
+    // Discard replaces and destroys this WebContents. Doing so synchronously
+    // while WebContentsImpl is broadcasting DidFinishNavigation violates its
+    // observer-notification lifetime check. Wait until that callback unwinds.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<content::WebContents> weak_contents) {
+              if (!weak_contents) {
+                return;
+              }
+              if (auto* lifecycle = resource_coordinator::
+                      TabLifecycleUnitExternal::FromWebContents(
+                          weak_contents.get())) {
+                lifecycle->DiscardTab(
+                    mojom::LifecycleUnitDiscardReason::EXTERNAL);
+              }
+            },
+            contents->GetWeakPtr()));
+    delete this;
+  }
+
+  void WebContentsDestroyed() override { delete this; }
+};
