+std::vector<PersistentOmniboxItem>
+HeliumSpaceService::GetOmniboxItemsForBrowser(Browser* browser) const {
+  std::vector<PersistentOmniboxItem> items;
+  if (!IsEligibleBrowser(browser)) {
+    return items;
+  }
+  auto* self = const_cast<HeliumSpaceService*>(this);
+  const std::string active_space_id(GetSpaceIdForBrowser(browser));
+  HeliumSpace* active_space = self->GetSpaceById(active_space_id);
+  if (!active_space) {
+    return items;
+  }
+
+  // Keep the order useful for the omnibox: the active Space's Pins are the
+  // closest navigation targets, then Favorites visible in this Space, then
+  // Pins owned by every other Space. The recursive walk retains tree order.
+  AppendOmniboxItems(active_space->pins(), PersistentRecordKind::kPin,
+                     active_space->id(), active_space->name(),
+                     PersistentOmniboxItem::Tier::kActiveSpacePin,
+                     persistent_item_usage_, lifecycle_, {}, &items);
+  AppendOmniboxItems(GetFavoritesForBrowser(browser),
+                     PersistentRecordKind::kFavorite, {}, {},
+                     PersistentOmniboxItem::Tier::kFavorite,
+                     persistent_item_usage_, lifecycle_, {}, &items);
+  for (const auto& space : spaces_) {
+    if (space->id() == active_space->id()) {
+      continue;
+    }
+    AppendOmniboxItems(space->pins(), PersistentRecordKind::kPin,
+                       space->id(), space->name(),
+                       PersistentOmniboxItem::Tier::kOtherSpacePin,
+                       persistent_item_usage_, lifecycle_, {}, &items);
+  }
+
+  // The tree walk intentionally has no dependency on live tab pointers. Fill
+  // active state from the service's associations in a second pass so a tab
+  // activation cannot invalidate the recursive enumeration itself.
+  for (PersistentOmniboxItem& item : items) {
+    const std::string key = ItemKeyForSpace(item.kind, item.space_id, item.id);
+    const auto token = lifecycle_.GetLiveTab(key);
+    if (!token) {
+      continue;
+    }
+    const auto association = live_associations_.find(*token);
+    item.is_active = association != live_associations_.end() &&
+                     association->second->tab &&
+                     association->second->tab->IsActivated();
+    item.is_live = true;
+  }
+  return items;
+}
+
+bool HeliumSpaceService::ActivateOmniboxItem(
+    Browser* source_browser,
+    const PersistentOmniboxItem& item) {
+  if (!IsEligibleBrowser(source_browser)) {
+    return false;
+  }
+
+  if (item.kind == PersistentRecordKind::kFavorite) {
+    // Favorites are profile-scoped and the item snapshot is visible in the
+    // source browser's current Space. Their stable identity, not their URL,
+    // determines the activation target.
+    if (!ResolveItem(source_browser, item.kind, item.id)) {
+      return false;
+    }
+    return ActivatePersistentItem(source_browser, item.kind, item.id);
+  }
+
+  if (item.space_id.empty()) {
+    return false;
+  }
+  HeliumSpace* target_space = GetSpaceById(item.space_id);
+  if (!target_space || !ResolvePinInSpace(item.space_id, item.id)) {
+    return false;
+  }
+  BrowserWindowInterface* target_window =
+      target_space->ActivateOrCreatePrimaryWindow();
+  Browser* target_browser =
+      target_window ? target_window->GetBrowserForMigrationOnly() : nullptr;
+  if (!IsEligibleBrowser(target_browser) ||
+      GetSpaceIdForBrowser(target_browser) != item.space_id) {
+    return false;
+  }
+  return ActivatePersistentItem(target_browser, PersistentRecordKind::kPin,
+                                item.id);
+}
+
+bool HeliumSpaceService::ActivatePersistentItemForUrl(Browser* browser,
+                                                      const GURL& url) {
+  if (!url.is_valid()) {
+    return false;
+  }
+  const GURL comparable_url = url.GetWithoutRef();
+  for (const PersistentOmniboxItem& item : GetOmniboxItemsForBrowser(browser)) {
+    if (item.url.GetWithoutRef() == comparable_url &&
+        ActivateOmniboxItem(browser, item)) {
+      return true;
+    }
+  }
+  return false;
+}
