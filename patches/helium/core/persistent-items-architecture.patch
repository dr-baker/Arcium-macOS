+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_PERSISTENT_TAB_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_PERSISTENT_TAB_VIEW_H_
+
+#include <memory>
+#include <set>
