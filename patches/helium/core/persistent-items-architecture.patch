+
+TEST(TabStripViewReplacementTest, PreservesVisibleViewportPosition) {
+  const std::optional<int> delta = CalculateViewReplacementScrollDelta(
+      gfx::Rect(0, 120, 100, 40), gfx::Rect(0, 40, 100, 200),
+      gfx::Rect(0, 360, 100, 40), gfx::Rect(0, 240, 100, 200));
+  ASSERT_TRUE(delta);
+  EXPECT_EQ(40, *delta);
+}
+
+TEST(TabStripViewReplacementTest, PreservesPartiallyVisibleViewportPosition) {
+  const std::optional<int> delta = CalculateViewReplacementScrollDelta(
+      gfx::Rect(0, 20, 100, 40), gfx::Rect(0, 40, 100, 200),
