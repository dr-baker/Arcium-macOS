+bool ActivatePersistentOmniboxItem(
+    helium::HeliumSpaceService* service,
+    Browser* browser,
+    const OmniboxPersistentItem& item) {
+  if (!service || !browser || item.id.empty()) {
+    return false;
+  }
+
+  const std::optional<helium::PersistentRecordKind> kind =
+      PersistentRecordKindForOmniboxKind(item.kind);
+  if (!kind) {
+    return false;
+  }
