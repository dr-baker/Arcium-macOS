+// Persistent items are records, not URL bookmarks. Two records may point at
+// the same destination while remaining separately selectable and actionable.
+std::string PersistentIdentitySuffix(const AutocompleteMatch& match) {
+  if (match.persistent_command) {
+    const OmniboxPersistentCommand& command = *match.persistent_command;
+    std::string suffix = "\x1f"
+                         "command\x1f";
+    suffix += base::NumberToString(static_cast<int>(command.type));
+    suffix += "\x1f";
+    suffix += command.item_id;
+    suffix += "\x1f";
+    suffix += command.space_id;
+    suffix += "\x1f";
+    suffix += command.target_space_id;
+    return suffix;
+  }
+
+  if (!match.persistent_item) {
+    return {};
+  }
+
+  const OmniboxPersistentItem& item = *match.persistent_item;
+  std::string suffix = "\x1f";
+  suffix += base::NumberToString(static_cast<int>(item.kind));
+  suffix += "\x1f";
+  suffix += item.id;
+  suffix += "\x1f";
+  suffix += item.space_id;
+  if (item.id.empty()) {
+    // Older embedders may not have a stable id yet. Keep distinct records
+    // apart when their descriptive fields still distinguish them.
+    suffix += "\x1f";
+    suffix += base::UTF16ToUTF8(item.title);
+    suffix += "\x1f";
+    suffix += item.space_id;
+  }
+  return suffix;
+}
+
+bool IsSamePersistentIdentity(const AutocompleteMatch& first,
+                              const AutocompleteMatch& second) {
+  if (!first.persistent_item || !second.persistent_item) {
+    return false;
+  }
+  const auto& first_item = *first.persistent_item;
+  const auto& second_item = *second.persistent_item;
+  if (first_item.kind != second_item.kind) {
+    return false;
+  }
+  if (!first_item.id.empty() && !second_item.id.empty()) {
+    return first_item.id == second_item.id &&
+           first_item.space_id == second_item.space_id;
+  }
+  return first_item.id.empty() && second_item.id.empty() &&
