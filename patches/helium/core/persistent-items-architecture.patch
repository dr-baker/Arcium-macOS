+// Keep the score lexicographic: tier, match quality, then bounded usage and
+// recency. The tier stride is larger than every lower-order contribution.
+constexpr int kPersistentMatchWeight = 100;
+constexpr int kPersistentCommandRelevance = 700;
+constexpr int kMaxPersistentUsageCount = 20;
+constexpr int kMaxPersistentRecencyScore = 10;
+constexpr int kPersistentTierStride =
+    60 * kPersistentMatchWeight + kMaxPersistentUsageCount * 2 +
+    kMaxPersistentRecencyScore + 1;
+constexpr int kPersistentActivePinRelevance = kPersistentTierStride * 3;
+constexpr int kPersistentFavoriteRelevance = kPersistentTierStride * 2;
+constexpr int kPersistentOtherPinRelevance = kPersistentTierStride;
+
+std::u16string Lowercase(std::u16string value) {
+  return base::ToLowerASCII(value);
+}
+
+AutocompleteMatch::ACMatchClassifications ClassifyPersistentText(
+    const std::u16string& text,
+    const std::u16string& query) {
+  const size_t match_start = Lowercase(text).find(query);
+  if (match_start == std::u16string::npos) {
+    return {{0, AutocompleteMatch::ACMatchClassification::NONE}};
+  }
+
+  AutocompleteMatch::ACMatchClassifications classifications;
+  if (match_start != 0) {
+    classifications.emplace_back(
+        0, AutocompleteMatch::ACMatchClassification::NONE);
+  }
+  classifications.emplace_back(match_start,
+                                AutocompleteMatch::ACMatchClassification::MATCH);
+  if (match_start + query.size() < text.size()) {
+    classifications.emplace_back(
+        match_start + query.size(),
+        AutocompleteMatch::ACMatchClassification::NONE);
+  }
+  return classifications;
+}
+
+int MatchQuality(const std::u16string& query,
+                 const std::u16string& title,
+                 const std::u16string& url) {
+  const std::u16string lower_title = Lowercase(title);
+  const std::u16string lower_url = Lowercase(url);
+
+  // The score leaves a strict gap between exact, prefix, and substring
+  // matches, while preferring a title over an otherwise equivalent URL.
+  if (query == lower_title)
+    return 60;
+  if (query == lower_url)
+    return 55;
+  if (base::StartsWith(lower_title, query, base::CompareCase::SENSITIVE))
+    return 40;
+  if (base::StartsWith(lower_url, query, base::CompareCase::SENSITIVE))
+    return 35;
+  if (lower_title.find(query) != std::u16string::npos)
+    return 20;
+  if (lower_url.find(query) != std::u16string::npos)
+    return 15;
+  return 0;
+}
+
+OmniboxPersistentItem::Tier EffectiveTier(const OmniboxPersistentItem& item) {
+  if (item.tier != OmniboxPersistentItem::Tier::kUnspecified) {
+    return item.tier;
+  }
+  if (item.kind == OmniboxPersistentItem::Kind::kFavorite) {
+    return OmniboxPersistentItem::Tier::kFavorite;
+  }
+  return item.state == OmniboxPersistentItem::State::kActive
+             ? OmniboxPersistentItem::Tier::kActivePin
+             : OmniboxPersistentItem::Tier::kOtherPin;
