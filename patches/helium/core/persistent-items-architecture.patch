+namespace {
+
+class TestChromeImporter : public ChromeImporter {
+ public:
+  TestChromeImporter() = default;
+  ~TestChromeImporter() override = default;
+
+  FaviconMap SelectFaviconMappings(sql::Database* db,
+                                   const std::set<GURL>& requested_urls) {
+    FaviconMap result;
+    ImportFaviconURLs(db, &requested_urls, /*fallback_to_host=*/true, &result);
+    return result;
+  }
+};
+
+TEST(ChromeImporterTest, HostFallbackIsDeterministicAndMapsOnlyRequestedUrls) {
+  sql::Database db(sql::test::kTestTag);
+  ASSERT_TRUE(db.OpenInMemory());
+  ASSERT_TRUE(db.Execute(
+      "CREATE TABLE favicons ("
+      "id INTEGER PRIMARY KEY, url LONGVARCHAR, icon_type INTEGER);"));
+  ASSERT_TRUE(db.Execute(
+      "CREATE TABLE icon_mapping ("
+      "id INTEGER PRIMARY KEY, page_url LONGVARCHAR, icon_id INTEGER, "
+      "page_url_type INTEGER DEFAULT 0);"));
+  ASSERT_TRUE(
+      db.Execute("CREATE TABLE favicon_bitmaps ("
+                 "id INTEGER PRIMARY KEY, icon_id INTEGER, image_data BLOB);"));
+
+  ASSERT_TRUE(
+      db.Execute("INSERT INTO favicons VALUES "
+                 "(1, 'https://exact.test/icon.png', 1), "
+                 "(2, 'https://host.test/redirect.png', 1), "
+                 "(3, 'https://host.test/regular.png', 1), "
+                 "(4, 'https://unrelated.test/icon.png', 1), "
+                 "(5, 'https://host.test/regular-earlier.png', 1), "
+                 "(6, 'https://host.test/manifest.png', 4), "
+                 "(7, 'https://host.test/empty.png', 1);"));
+  ASSERT_TRUE(
+      db.Execute("INSERT INTO icon_mapping VALUES "
+                 "(1, 'https://exact.test/requested', 1, 0), "
+                 "(2, 'https://host.test/a', 2, 1), "
+                 "(3, 'https://host.test/z', 3, 0), "
+                 "(4, 'https://unrelated.test/unrelated-path', 4, 0), "
+                 "(5, 'https://host.test/b', 5, 0), "
+                 "(6, 'https://host.test/a-manifest', 6, 0), "
+                 "(7, 'https://host.test/aa-empty', 7, 0);"));
+  ASSERT_TRUE(
+      db.Execute("INSERT INTO favicon_bitmaps VALUES "
+                 "(1, 1, X'01'), (2, 2, X'02'), (3, 3, X'03'), "
+                 "(4, 4, X'04'), (5, 5, X'05'), (6, 6, X'06'), "
+                 "(7, 7, X'');"));
+
+  const GURL exact_url("https://exact.test/requested");
+  const GURL fallback_url("https://host.test/requested");
+  const GURL missing_url("https://missing.test/requested");
+  const std::set<GURL> requested_urls = {exact_url, fallback_url, missing_url};
+
+  scoped_refptr<TestChromeImporter> importer =
+      base::MakeRefCounted<TestChromeImporter>();
+  const auto mappings = importer->SelectFaviconMappings(&db, requested_urls);
+
+  ASSERT_EQ(2u, mappings.size());
+  EXPECT_EQ(std::set<GURL>({exact_url}), mappings.at(1));
+  EXPECT_EQ(std::set<GURL>({fallback_url}), mappings.at(5));
+  for (const auto& mapping : mappings) {
+    const std::set<GURL>& urls = mapping.second;
+    EXPECT_TRUE(requested_urls.contains(*urls.begin()));
+    EXPECT_FALSE(urls.contains(GURL("https://unrelated.test/unrelated-path")));
+  }
+}
+
+}  // namespace
