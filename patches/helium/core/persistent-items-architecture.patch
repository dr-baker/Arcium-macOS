+    handle_ = std::make_unique<content::MockNavigationHandle>(
+        GURL(kAway), web_contents()->GetPrimaryMainFrame());
+    handle_->set_is_renderer_initiated(true);
+    handle_->set_is_in_primary_main_frame(true);
+    handle_->set_page_transition(ui::PAGE_TRANSITION_LINK);
+    handle_->set_is_form_submission(false);
+    handle_->set_is_same_document(false);
+    handle_->set_reload_type(content::ReloadType::NONE);
+    ON_CALL(*handle_, WasInitiatedByLinkClick()).WillByDefault(Return(true));
+    registry_ = std::make_unique<content::MockNavigationThrottleRegistry>(
+        handle_.get(),
+        content::MockNavigationThrottleRegistry::RegistrationMode::kHold);
+  }
+
+  void TearDown() override {
+    throttle_.reset();
+    registry_.reset();
+    handle_.reset();
+    ChromeRenderViewHostTestHarness::TearDown();
+  }
+
+ protected:
+  HeliumAnchoredNavigationThrottle::Dependencies MakeDependencies(
+      bool is_anchored,
+      bool open_succeeds) {
+    HeliumAnchoredNavigationThrottle::Dependencies deps;
+    deps.resolve_anchored_home = base::BindRepeating(
+        [](bool is_anchored, const GURL& home, Profile* profile,
+           content::WebContents*, GURL* home_url, Profile** out_profile) {
+          if (!is_anchored) {
+            return false;
+          }
+          *home_url = home;
+          *out_profile = profile;
+          return true;
+        },
+        is_anchored, GURL(kHome), profile());
+    deps.open_little_arc = base::BindRepeating(
+        [](int* open_count, GURL* last_opened, bool* open_succeeds, Profile*,
+           const GURL& url) {
+          ++*open_count;
+          *last_opened = url;
+          return *open_succeeds;
+        },
+        &open_count_, &last_opened_, &open_succeeds_);
+    open_succeeds_ = open_succeeds;
+    return deps;
+  }
+
+  HeliumAnchoredNavigationThrottle* CreateThrottle(bool is_anchored = true,
+                                                   bool open_succeeds = true) {
+    throttle_ = std::make_unique<HeliumAnchoredNavigationThrottle>(
+        *registry_, MakeDependencies(is_anchored, open_succeeds));
+    return throttle_.get();
+  }
+
+  int open_count_ = 0;
+  GURL last_opened_;
+  bool open_succeeds_ = true;
+  std::unique_ptr<content::MockNavigationHandle> handle_;
+  std::unique_ptr<content::MockNavigationThrottleRegistry> registry_;
+  std::unique_ptr<HeliumAnchoredNavigationThrottle> throttle_;
+};
