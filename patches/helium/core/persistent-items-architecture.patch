+  selection.new_tab = GetActiveTab();
+  selection.new_contents = GetActiveWebContents();
+  // Changing collection ownership is a semantic move even when the flattened
+  // index is unchanged (for example, the first ordinary tab moving to an
+  // otherwise empty Pins collection).
+  SendMoveNotificationForTab(initial_index, final_index_as_int, tab, selection);
+  return final_index_as_int;
