+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_anchored_navigation_throttle.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/helium/helium_favorites_and_pins.h"
+#include "chrome/browser/ui/helium/helium_little_arc.h"
+#include "chrome/browser/ui/helium/helium_persistent_item_model.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/page_transition_types.h"
+
+namespace helium {
+namespace {
+
+bool ResolveAnchoredHome(content::WebContents* contents,
+                         GURL* home_url,
+                         Profile** profile) {
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  std::u16string home_title;
+  if (!GetAnchoredPinnedTabHome(tab, home_url, &home_title) ||
+      !tab->GetProfile()) {
+    return false;
+  }
+  *profile = tab->GetProfile();
+  return true;
+}
+
+bool OpenLittleArc(Profile* profile, const GURL& url) {
+  return OpenUrlsInLittleArc(profile, {url}) != nullptr;
+}
+
+}  // namespace
+
+void HeliumAnchoredNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  if (!IsHeliumFavoritesAndPinsEnabled()) {
+    return;
+  }
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (!handle.IsInPrimaryMainFrame()) {
+    return;
+  }
+  // Attach for any live anchored tab so a same-home start that later redirects
+  // away can still be diverted. Destination checks happen in MaybeDivert().
+  content::WebContents* contents = handle.GetWebContents();
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  if (!IsAnchoredTab(tab)) {
+    return;
+  }
+  registry.AddThrottle(
+      std::make_unique<HeliumAnchoredNavigationThrottle>(
+          registry, ProductionDependencies()));
+}
+
+HeliumAnchoredNavigationThrottle::Dependencies
+HeliumAnchoredNavigationThrottle::ProductionDependencies() {
+  return {
+      .resolve_anchored_home = base::BindRepeating(&ResolveAnchoredHome),
+      .open_little_arc = base::BindRepeating(&OpenLittleArc),
+  };
+}
+
+HeliumAnchoredNavigationThrottle::HeliumAnchoredNavigationThrottle(
+    content::NavigationThrottleRegistry& registry,
+    Dependencies dependencies)
+    : content::NavigationThrottle(registry),
+      dependencies_(std::move(dependencies)) {}
+
+HeliumAnchoredNavigationThrottle::~HeliumAnchoredNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+HeliumAnchoredNavigationThrottle::WillStartRequest() {
+  return MaybeDivert();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+HeliumAnchoredNavigationThrottle::WillRedirectRequest() {
+  return MaybeDivert();
+}
+
+const char* HeliumAnchoredNavigationThrottle::GetNameForLogging() {
+  return "HeliumAnchoredNavigationThrottle";
+}
+
+bool HeliumAnchoredNavigationThrottle::IsOrdinaryCurrentTabLinkNavigation()
+    const {
+  content::NavigationHandle* handle = navigation_handle();
+  if (!handle || !handle->IsInPrimaryMainFrame() ||
+      !handle->IsRendererInitiated() || handle->IsFormSubmission() ||
+      handle->IsSameDocument() ||
+      handle->GetReloadType() != content::ReloadType::NONE) {
+    return false;
+  }
+  const ui::PageTransition transition = handle->GetPageTransition();
+  return ui::PageTransitionCoreTypeIs(transition, ui::PAGE_TRANSITION_LINK) &&
+         ui::PageTransitionIsNewNavigation(transition) &&
+         handle->WasInitiatedByLinkClick();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+HeliumAnchoredNavigationThrottle::MaybeDivert() {
+  if (diverted_ || !IsOrdinaryCurrentTabLinkNavigation()) {
+    return PROCEED;
+  }
+
+  content::WebContents* contents = navigation_handle()->GetWebContents();
+  GURL home_url;
+  Profile* profile = nullptr;
+  const bool is_anchored = dependencies_.resolve_anchored_home &&
+                           dependencies_.resolve_anchored_home.Run(
+                               contents, &home_url, &profile);
+  const bool is_link_transition = ui::PageTransitionCoreTypeIs(
+      navigation_handle()->GetPageTransition(), ui::PAGE_TRANSITION_LINK);
+  if (!ShouldOpenAnchoredNavigationInLittleArc(
+          PersistentNavigationDisposition::kCurrentTab, is_link_transition,
+          is_anchored, home_url, navigation_handle()->GetURL()) ||
+      !profile || !dependencies_.open_little_arc ||
+      !dependencies_.open_little_arc.Run(profile,
+                                         navigation_handle()->GetURL())) {
+    return PROCEED;
+  }
+
+  diverted_ = true;
+  return CANCEL_AND_IGNORE;
+}
+
+}  // namespace helium
