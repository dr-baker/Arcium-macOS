+void ImportDataHandler::HandleImportArcSidebars(const base::ListValue& args) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(args.empty());
+
+  if (!importer_list_loaded_ || importer_host_ || importing_arc_sidebars_) {
+    return;
+  }
+
+  arc_sidebar_import_queue_.clear();
+  for (size_t i = 0; i < importer_list_->count(); ++i) {
+    const user_data_importer::SourceProfile& source_profile =
+        importer_list_->GetSourceProfileAt(i);
+    if (source_profile.importer_type == user_data_importer::TYPE_ARC &&
+        (source_profile.services_supported & user_data_importer::FAVORITES)) {
+      arc_sidebar_import_queue_.push_back(source_profile);
+    }
+  }
+
+  if (arc_sidebar_import_queue_.empty()) {
+    FireWebUIListener("import-data-status-changed",
+                      base::Value(kImportStatusFailed));
+    return;
+  }
+
+  Profile::FromWebUI(web_ui())->GetPrefs()->SetBoolean(
+      prefs::kImportArcSidebarToPins, true);
+  arc_sidebar_import_index_ = 0;
+  importing_arc_sidebars_ = true;
+  arc_sidebar_batch_did_succeed_ = true;
+  VLOG(1) << "Arc sidebar batch starting; profile_count="
+          << arc_sidebar_import_queue_.size();
+  StartNextArcSidebarImport();
+}
+
+void ImportDataHandler::StartNextArcSidebarImport() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(importing_arc_sidebars_);
+  CHECK_LT(arc_sidebar_import_index_, arc_sidebar_import_queue_.size());
+  StartImport(arc_sidebar_import_queue_[arc_sidebar_import_index_],
+              user_data_importer::FAVORITES);
+}
