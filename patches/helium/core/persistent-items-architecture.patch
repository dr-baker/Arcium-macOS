+    const gfx::Point& point_in_screen) {
+  // Virtual records never accept real TabViews. Route a drag over this region
+  // to the ordinary-tabs container so collection ownership stays coherent.
+  for (views::View* ancestor = parent(); ancestor;
+       ancestor = ancestor->parent()) {
+    if (auto* strip = views::AsViewClass<TabStripView>(ancestor)) {
+      auto* ordinary = strip->GetUnpinnedTabsContainer();
+      CHECK(ordinary);
+      return ordinary->GetTabDragTarget(point_in_screen);
+    }
+  }
