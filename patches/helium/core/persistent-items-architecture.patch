+bool DispatchPersistentOmniboxCommand(
+    helium::HeliumSpaceService* service,
+    Browser* browser,
+    const OmniboxPersistentCommand& command) {
+  if (!service || !browser) {
+    return false;
+  }
+
+  switch (command.type) {
+    case OmniboxPersistentCommand::Type::kPinCurrentTab:
+      return service->AddPinFromTab(browser->GetActiveTabInterface());
+    case OmniboxPersistentCommand::Type::kAddCurrentTabToFavorites:
+      return service->AddFavoriteFromTab(browser->GetActiveTabInterface());
+    case OmniboxPersistentCommand::Type::kMovePinToSpace:
+      // MovePinToSpace performs the item lookup and mutation. Check the
+      // target first so a stale result cannot turn into a navigation or a
+      // mutation against an implicit/default Space.
+      if (command.item_id.empty() || command.target_space_id.empty() ||
+          command.item_kind !=
+              static_cast<int>(OmniboxPersistentItem::Kind::kPin) ||
+          !service->GetSpaceById(command.target_space_id)) {
+        return false;
+      }
+      return service->MovePinToSpace(browser, command.item_id,
+                                     command.space_id,
+                                     command.target_space_id);
+    case OmniboxPersistentCommand::Type::kCloseLiveInstance:
+    case OmniboxPersistentCommand::Type::kReturnPinHome: {
+      if (command.item_id.empty()) {
