+constexpr int kMaxPersistentItemUseCount = 1000;
+constexpr size_t kMaxPersistentItemUsageEntries = 256;
+
+// Usage is intentionally a very small, identity-only store. In particular,
+// this record must never grow into a second copy of the sidebar model.
+constexpr char kUsageCountKey[] = "count";
+constexpr char kUsageLastUsedKey[] = "last_used";
+
+using OmniboxItemTier = PersistentOmniboxItem::Tier;
+
+std::string MakeItemKeyForSpace(PersistentRecordKind kind,
+                                std::string_view space_id,
+                                std::string_view id) {
+  if (kind == PersistentRecordKind::kFavorite) {
+    return base::StrCat({"f:", id});
+  }
+  return base::StrCat({"p:", space_id, ":", id});
+}
+
+template <typename UsageMap>
+void AppendOmniboxItems(const PersistentNodes& nodes,
+                        PersistentRecordKind kind,
+                        std::string_view space_id,
+                        std::u16string_view space_name,
+                        OmniboxItemTier tier,
+                        const UsageMap& usage,
+                        const PersistentItemLifecycle& lifecycle,
+                        std::vector<std::u16string> folder_path,
+                        std::vector<PersistentOmniboxItem>* items) {
+  for (const PersistentNode& node : nodes) {
+    if (const auto* link = std::get_if<PersistentLink>(&node.data)) {
+      const std::string key = MakeItemKeyForSpace(kind, space_id, link->id);
+      PersistentOmniboxItem item;
+      item.kind = kind;
+      item.id = link->id;
+      item.space_id = std::string(space_id);
+      item.space_name = std::u16string(space_name);
+      item.folder_path.assign(folder_path.rbegin(), folder_path.rend());
+      item.title = link->title;
+      item.url = link->url;
+      item.tier = tier;
+      const auto state = lifecycle.GetState(key);
+      item.is_live = state &&
+                     (*state == PersistentItemLifecycle::State::kLive ||
+                      *state == PersistentItemLifecycle::State::kClosing);
+      if (const auto usage_entry = usage.find(key); usage_entry != usage.end()) {
+        item.use_count = usage_entry->second.count;
+        item.last_used_internal_value =
+            usage_entry->second.last_used.ToInternalValue();
+      }
+      if (lifecycle.GetLiveTab(key)) {
+        // The service owns the association map, so active state is filled by
+        // the caller after this pure tree walk. Keep this branch intentionally
+        // cheap; it only distinguishes a live identity here.
+        item.is_live = true;
+      }
+      items->push_back(std::move(item));
+      continue;
+    }
+    const PersistentFolder& folder = std::get<PersistentFolder>(node.data);
+    folder_path.push_back(folder.title);
+    AppendOmniboxItems(folder.children, kind, space_id, space_name, tier,
+                       usage, lifecycle, folder_path, items);
+  }
+}
+
+std::string NewId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+std::string ImportedId(std::string_view profile,
+                       std::string_view scope,
+                       std::string_view source_id) {
+  return base::StrCat({"arc:", profile, ":", scope, ":", source_id});
+}
+
+PersistentLink LinkFromStartupTab(const StartupTab& tab) {
+  return {.id = tab.helium_source_id.empty() ? NewId() : tab.helium_source_id,
+          .title = tab.helium_home_title,
+          .url = tab.url};
+}
+
+PersistentNodes ConvertLegacyNodes(const base::ListValue& values,
+                                   std::string_view source_profile,
+                                   std::string_view space_id) {
+  PersistentNodes result;
+  for (const base::Value& value : values) {
+    const base::DictValue* dict = value.GetIfDict();
+    const std::string* type = dict ? dict->FindString("type") : nullptr;
+    if (!dict || !type) {
+      continue;
+    }
+    const std::string* source_id = dict->FindString("source_id");
+    std::string id = source_id && !source_id->empty()
+                         ? ImportedId(source_profile, space_id, *source_id)
+                         : NewId();
+    const std::string* title = dict->FindString("title");
+    if (*type == "tab" || *type == "link") {
+      const std::string* url_string = dict->FindString("url");
+      GURL url(url_string ? *url_string : std::string());
+      if (!url.is_valid() || url.is_empty() || url.spec() == "about:blank") {
+        continue;
+      }
+      result.push_back(PersistentNode{
+          .data = PersistentLink{
+              .id = std::move(id),
+              .title = base::UTF8ToUTF16(title ? *title : std::string()),
+              .url = std::move(url)}});
+      continue;
+    }
+    const base::ListValue* children = dict->FindList("children");
+    if (*type == "folder" && children) {
+      result.push_back(PersistentNode{
+          .data = PersistentFolder{
+              .id = std::move(id),
+              .title = base::UTF8ToUTF16(title ? *title : std::string()),
+              .collapsed = dict->FindBool("collapsed").value_or(false),
+              .children =
+                  ConvertLegacyNodes(*children, source_profile, space_id)}});
+    }
+  }
+  return result;
+}
+
+bool IsLegacyPinnedTabList(const base::ListValue& values) {
+  return !values.empty() && std::ranges::all_of(values, [](const auto& value) {
+    const base::DictValue* dict = value.GetIfDict();
+    return dict && dict->FindString("url") && !dict->Find("type");
+  });
+}
+
+bool IsLegacySpaceNodeList(const base::ListValue& values) {
+  return std::ranges::all_of(values, [](const auto& value) {
+    const base::DictValue* dict = value.GetIfDict();
+    return dict && dict->FindString("source_id") && !dict->Find("id");
+  });
+}
+
+PersistentNodes ConvertImportedNodes(const std::vector<HeliumSpaceNode>& nodes,
+                                     std::string_view source_profile,
+                                     std::string_view space_id) {
+  PersistentNodes result;
+  result.reserve(nodes.size());
+  for (const HeliumSpaceNode& node : nodes) {
+    if (const auto* tab = std::get_if<HeliumSpaceTab>(&node.data)) {
+      result.push_back(PersistentNode{
+          .data = PersistentLink{
+              .id = ImportedId(source_profile, space_id, tab->source_id),
+              .title = base::UTF8ToUTF16(tab->title),
+              .url = tab->url}});
+      continue;
+    }
+    const auto& folder = std::get<HeliumSpaceFolder>(node.data);
+    result.push_back(PersistentNode{
+        .data = PersistentFolder{
+            .id = ImportedId(source_profile, space_id, folder.source_id),
+            .title = base::UTF8ToUTF16(folder.title),
+            .collapsed = folder.collapsed,
+            .children = ConvertImportedNodes(folder.children, source_profile,
+                                             space_id)}});
+  }
+  return result;
+}
+
+void CollectLifecycleKeys(std::set<std::string>* keys,
+                          std::string_view prefix,
+                          const PersistentNodes& nodes) {
+  for (const PersistentNode& node : nodes) {
+    if (const auto* link = std::get_if<PersistentLink>(&node.data)) {
+      keys->insert(base::StrCat({prefix, link->id}));
+    } else {
+      CollectLifecycleKeys(keys, prefix,
+                           std::get<PersistentFolder>(node.data).children);
+    }
+  }
+}
+
+bool ParseItemKey(std::string_view key,
+                  PersistentRecordKind* kind,
+                  std::string* id) {
+  constexpr std::string_view kFavoritePrefix = "f:";
+  constexpr std::string_view kPinPrefix = "p:";
+  if (key.starts_with(kFavoritePrefix)) {
+    *kind = PersistentRecordKind::kFavorite;
+    *id = std::string(key.substr(kFavoritePrefix.size()));
+    return !id->empty();
+  }
+  if (!key.starts_with(kPinPrefix)) {
+    return false;
+  }
+  const std::string_view rest = key.substr(kPinPrefix.size());
+  const size_t split = rest.find(':');
+  if (split == std::string_view::npos || split + 1 >= rest.size()) {
+    return false;
+  }
+  *kind = PersistentRecordKind::kPin;
+  *id = std::string(rest.substr(split + 1));
+  return true;
+}
