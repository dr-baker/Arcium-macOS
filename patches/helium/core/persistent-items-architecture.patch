+  const auto* tab = std::get_if<const tabs::TabInterface*>(&node_data);
+  if (tab && space_service_->GetPersistentItemKind(*tab) ==
+                 helium::PersistentRecordKind::kFavorite) {
+    child->SetVisible(false);
+  }
+}
+
+void PinnedTabContainerView::ScheduleReconcileFavorites() {
+  if (reconcile_scheduled_) {
+    return;
+  }
+  reconcile_scheduled_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PinnedTabContainerView::ReconcileFavorites,
+                                weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PinnedTabContainerView::ReconcileFavorites() {
+  reconcile_scheduled_ = false;
+  if (!collection_node_ || !space_service_) {
+    return;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  Browser* browser = browser_view ? browser_view->browser() : nullptr;
+  if (!browser) {
+    return;
+  }
+
+  for (const auto& child_node : collection_node_->children()) {
+    tabs::ConstChildPtr node_data = child_node->GetNodeData();
+    const auto* tab = std::get_if<const tabs::TabInterface*>(&node_data);
+    if (tab &&
+        space_service_->GetPersistentItemKind(*tab) ==
+            helium::PersistentRecordKind::kFavorite &&
+        child_node->view()) {
+      child_node->view()->SetVisible(false);
+    }
+  }
+
+  const std::vector<FavoriteTileSpec> tiles = BuildFavoriteTiles();
+  std::set<std::string, std::less<>> desired_ids;
+  std::vector<helium::PersistentGridSlot> slots;
+  std::map<std::string, raw_ptr<views::View>, std::less<>> live_views;
+  views::View* replacement_native_row = nullptr;
+  slots.reserve(tiles.size());
+  for (const FavoriteTileSpec& spec : tiles) {
+    desired_ids.insert(spec.id);
+    views::View* tile = nullptr;
+    const auto existing = favorite_tiles_.find(spec.id);
+    if (existing != favorite_tiles_.end()) {
+      tile = existing->second;
+    } else {
+      auto compact_tile = std::make_unique<PersistentTabView>(
+          browser_view->GetProfile(), spec.id, spec.title, spec.url,
+          PersistentTabView::PresentationMode::kCompactGrid,
+          base::BindRepeating(&PinnedTabContainerView::ActivateFavorite,
+                              weak_ptr_factory_.GetWeakPtr(), spec.id),
+          base::BindRepeating(&PinnedTabContainerView::RemoveFavorite,
+                              weak_ptr_factory_.GetWeakPtr(), spec.id));
+      tile = AddChildView(std::move(compact_tile));
+      favorite_tiles_.emplace(spec.id, tile);
+    }
+
+    auto* link_tile = views::AsViewClass<PersistentTabView>(tile);
+    CHECK(link_tile);
+    link_tile->Update(spec.title, spec.url, spec.selected);
+
+    TabView* live_tab_view = nullptr;
+    if (spec.live_tab) {
+      TabCollectionNode* live_node =
+          collection_node_->GetNodeForHandle(spec.live_tab->GetHandle());
+      live_tab_view =
+          live_node ? views::AsViewClass<TabView>(live_node->view()) : nullptr;
+      if (live_tab_view && live_tab_view->parent() != this) {
+        live_tab_view = nullptr;
+      }
+    }
+
+    tile->SetVisible(!live_tab_view);
+    if (live_tab_view) {
+      live_tab_view->SetVisible(true);
+      live_views.emplace(spec.id, live_tab_view);
+    }
+    slots.push_back({.id = spec.id, .live = live_tab_view != nullptr});
+    if (pending_replacement_id_ == spec.id && live_tab_view) {
+      replacement_native_row = live_tab_view;
+    }
+  }
+
+  size_t target_index = 0;
+  for (const helium::PersistentGridChild& child :
+       helium::PackPersistentGridChildren(slots)) {
+    views::View* view = nullptr;
+    if (child.kind == helium::PersistentGridChildKind::kLiveTab) {
+      const auto found = live_views.find(child.id);
+      view = found != live_views.end() ? found->second.get() : nullptr;
+    } else {
+      const auto found = favorite_tiles_.find(child.id);
+      view = found != favorite_tiles_.end() ? found->second.get() : nullptr;
+    }
+    CHECK(view);
+    ReorderChildView(view, target_index++);
+  }
+
+  for (auto it = favorite_tiles_.begin(); it != favorite_tiles_.end();) {
+    if (desired_ids.contains(it->first)) {
+      ++it;
+      continue;
+    }
+    RemoveChildViewT(it->second);
+    it = favorite_tiles_.erase(it);
+  }
+
+  std::vector<const views::View*> views_to_snap(children().begin(),
+                                                children().end());
+  layout_manager_->ResetViewsToTargetLayout(views_to_snap);
+  InvalidateLayout();
+  PreferredSizeChanged();
+
+  if (pending_replacement_id_) {
+    if (TabStripView* tab_strip = GetTabStripView(this)) {
+      if (replacement_native_row) {
+        tab_strip->CompletePersistentRowReplacement(replacement_native_row);
+      } else {
+        tab_strip->CancelPersistentRowReplacement();
+      }
+    }
+    pending_replacement_id_.reset();
+  }
+}
+
+std::vector<PinnedTabContainerView::FavoriteTileSpec>
+PinnedTabContainerView::BuildFavoriteTiles() const {
+  std::vector<FavoriteTileSpec> tiles;
+  if (!collection_node_ || !collection_node_->GetController() ||
+      !space_service_) {
+    return tiles;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  Browser* browser = browser_view ? browser_view->browser() : nullptr;
+  if (!browser) {
+    return tiles;
+  }
+  std::vector<helium::PersistentLink> links;
+  CollectFavoriteLinks(space_service_->GetFavoritesForBrowser(browser), &links);
+  tiles.reserve(links.size());
+  for (const helium::PersistentLink& link : links) {
+    tiles.push_back(FavoriteTileSpec{
+        .id = link.id,
+        .selected = space_service_->IsPersistentItemActive(
+            browser, helium::PersistentRecordKind::kFavorite, link.id),
+        .live_tab = space_service_->GetLiveTabForPersistentItem(
+            browser, helium::PersistentRecordKind::kFavorite, link.id),
+        .title = link.title.empty() ? base::UTF8ToUTF16(link.url.host())
+                                    : link.title,
+        .url = link.url,
+    });
+  }
+  return tiles;
+}
+
+void PinnedTabContainerView::ActivateFavorite(std::string id) {
+  if (!collection_node_ || !collection_node_->GetController() ||
+      !space_service_) {
+    return;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  if (!browser_view) {
+    return;
+  }
+  const auto tile = favorite_tiles_.find(id);
+  TabStripView* tab_strip = GetTabStripView(this);
+  if (tile != favorite_tiles_.end() && tab_strip) {
+    tab_strip->BeginPersistentRowReplacement(tile->second);
+    pending_replacement_id_ = id;
+  }
+  if (!space_service_->ActivatePersistentItem(
+          browser_view->browser(), helium::PersistentRecordKind::kFavorite,
+          id)) {
+    if (tab_strip) {
+      tab_strip->CancelPersistentRowReplacement();
+    }
+    pending_replacement_id_.reset();
+  }
+}
+
+void PinnedTabContainerView::RemoveFavorite(std::string id) {
+  if (!collection_node_ || !collection_node_->GetController() ||
+      !space_service_) {
+    return;
+  }
+  BrowserView* browser_view =
+      collection_node_->GetController()->GetBrowserView();
+  if (browser_view) {
+    space_service_->RemovePersistentItem(
+        browser_view->browser(), helium::PersistentRecordKind::kFavorite, id);
+  }
+}
+
 BEGIN_METADATA(PinnedTabContainerView)
 END_METADATA
