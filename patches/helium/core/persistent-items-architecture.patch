+
+std::u16string PersistentStateLabel(OmniboxPersistentItem::State state) {
+  switch (state) {
+    case OmniboxPersistentItem::State::kDormant:
+      return u"Dormant";
+    case OmniboxPersistentItem::State::kLive:
+      return u"Live";
+    case OmniboxPersistentItem::State::kActive:
+      return u"Active";
+  }
+  return u"";
+}
+
+std::u16string PersistentActionLabel(const OmniboxPersistentItem& item) {
+  const bool favorite =
+      item.kind == OmniboxPersistentItem::Kind::kFavorite;
+  if (item.state == OmniboxPersistentItem::State::kActive) {
+    return favorite ? u"Current Favorite" : u"Current Pin";
+  }
+  if (EffectiveTier(item) == OmniboxPersistentItem::Tier::kOtherPin) {
+    return item.space_name.empty() ? u"Switch Space"
+                                   : u"Switch to " + item.space_name;
+  }
+  if (item.state == OmniboxPersistentItem::State::kLive) {
+    return favorite ? u"Switch to Favorite" : u"Switch to Pin";
+  }
+  return favorite ? u"Open Favorite" : u"Restore Pin";
