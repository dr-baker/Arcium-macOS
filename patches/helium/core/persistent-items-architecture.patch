+  const int title_width =
+      std::max(0, contents.right() - kHorizontalInset - title_x);
+  const int title_height = title_->GetLineHeight();
+  title_->SetBounds(title_x,
+                    contents.y() + (contents.height() - title_height) / 2,
+                    title_width, title_height);
+  LayoutSuperclass<views::Button>(this);
+}
+
+gfx::Size PersistentTabView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  if (presentation_mode_ == PresentationMode::kCompactGrid) {
+    return gfx::Size(
+        available_size.width().value_or(
+            GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth)),
+        GetLayoutConstant(LayoutConstant::kVerticalTabPinnedHeight));
+  }
+  const int width = available_size.width().value_or(
+      GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth));
+  return gfx::Size(width,
+                   GetLayoutConstant(LayoutConstant::kVerticalTabHeight));
+}
+
+void PersistentTabView::PaintButtonContents(gfx::Canvas* canvas) {
+  const bool hovered =
+      GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+  if (selected_ || hovered) {
+    const TabStyle::TabSelectionState selection_state =
+        selected_ ? TabStyle::TabSelectionState::kActive
+                  : TabStyle::TabSelectionState::kInactive;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(tab_style_->GetCurrentTabBackgroundColor(
+        selection_state, hovered, hovered ? 1.0f : 0.0f, IsFrameActive(),
+        GetColorProvider()));
+    canvas->DrawRoundRect(
+        gfx::RectF(GetLocalBounds()),
+        GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), flags);
+  }
+
+  views::Button::PaintButtonContents(canvas);
+}
+
+void PersistentTabView::AddedToWidget() {
+  views::Button::AddedToWidget();
+  paint_as_active_subscription_ =
+      GetWidget()->RegisterPaintAsActiveChangedCallback(base::BindRepeating(
+          &PersistentTabView::UpdateColors, base::Unretained(this)));
+  UpdateColors();
+}
+
+void PersistentTabView::RemovedFromWidget() {
+  paint_as_active_subscription_ = {};
+  views::Button::RemovedFromWidget();
+}
+
+void PersistentTabView::OnThemeChanged() {
+  views::Button::OnThemeChanged();
+  UpdateColors();
+}
+
+void PersistentTabView::StateChanged(ButtonState old_state) {
+  UpdateColors();
+}
+
+void PersistentTabView::SetSelected(bool selected) {
+  if (selected_ == selected) {
+    return;
+  }
+  selected_ = selected;
+  // The durable home row mirrors the associated foreground tab's native
+  // active treatment while ownership remains with the ordinary live tab.
+  icon_->SetActiveState(selected_);
+  GetViewAccessibility().SetIsSelected(selected_);
+  UpdateColors();
+}
+
+void PersistentTabView::UpdateColors() {
+  if (!GetColorProvider()) {
+    return;
+  }
+  const bool hovered =
+      GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+  const auto selection_state = selected_
+                                   ? TabStyle::TabSelectionState::kActive
+                                   : TabStyle::TabSelectionState::kInactive;
+  const TabStyle::TabColors colors = tab_style_->CalculateTargetColors(
+      selection_state, selected_ || hovered, hovered, IsFrameActive(),
+      GetColorProvider());
+  title_->SetEnabledColor(colors.foreground_color);
+  views::FocusRing::Get(this)->SetColorId(colors.focus_ring_color);
+  SchedulePaint();
+}
+
+void PersistentTabView::LoadFavicon() {
+  favicon_task_tracker_.TryCancelAll();
+
+  if (!url_.is_valid()) {
+    return;
+  }
+  favicon::FaviconService* favicon_service =
+      FaviconServiceFactory::GetForProfile(profile_,
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (!favicon_service) {
+    ApplyMonogramFavicon();
+    return;
+  }
+
+  // This native image query returns representations for every display scale
+  // supported by the platform. FaviconService reads the profile's existing
+  // database; it does not issue a network request or add favicon state to the
+  // persistent-item model.
+  favicon_service->GetFaviconImageForPageURL(
+      url_,
+      base::BindOnce(&PersistentTabView::OnExactFaviconAvailable,
+                     weak_ptr_factory_.GetWeakPtr(), url_),
+      &favicon_task_tracker_);
+}
+
+void PersistentTabView::OnExactFaviconAvailable(
+    const GURL& requested_url,
+    const favicon_base::FaviconImageResult& image_result) {
+  if (requested_url != url_) {
+    return;
+  }
+  if (!image_result.image.IsEmpty()) {
+    SetFavicon(ui::ImageModel::FromImage(image_result.image),
+               PersistentFaviconState::kResolved);
+    return;
+  }
+  LoadHostFallbackFavicon(requested_url);
+}
+
+void PersistentTabView::LoadHostFallbackFavicon(const GURL& requested_url) {
+  favicon::FaviconService* favicon_service =
+      FaviconServiceFactory::GetForProfile(profile_,
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (requested_url != url_) {
+    return;
+  }
+  if (!favicon_service) {
+    ApplyMonogramFavicon();
+    return;
+  }
+
+  // Host fallback is useful for imported URLs that differ from a previously
+  // visited path. Request enough physical pixels for the densest supported
+  // display, then tag the decoded bitmap with that scale instead of treating
+  // it as a 1x image and upscaling it on Retina displays.
+  const int desired_size_in_pixel = static_cast<int>(std::ceil(
+      kIconDesignWidth * ui::GetScaleForMaxSupportedResourceScaleFactor()));
+  favicon_service->GetRawFaviconForPageURL(
+      requested_url, {favicon_base::IconType::kFavicon}, desired_size_in_pixel,
+      /*fallback_to_host=*/true,
+      base::BindOnce(&PersistentTabView::OnFaviconAvailable,
+                     weak_ptr_factory_.GetWeakPtr(), url_),
+      &favicon_task_tracker_);
+}
+
+void PersistentTabView::ApplyMonogramFavicon() {
+  if (!url_.is_valid() || !ShouldApplyGeneratedFavicon(favicon_state_)) {
+    return;
+  }
+  SetFavicon(MakeMonogramFavicon(url_), PersistentFaviconState::kGenerated);
+}
+
+void PersistentTabView::SetFavicon(const ui::ImageModel& favicon_model,
+                                   PersistentFaviconState state) {
+  favicon_state_ = state;
+  tabs::TabData data;
+  data.favicon = favicon_model;
+  data.visible_url = url_;
+  data.should_themify_favicon = state == PersistentFaviconState::kResolved &&
+                                favicon::ShouldThemifyFavicon(url_);
+  icon_->SetData(data);
+  icon_->SetActiveState(selected_);
+}
+
+void PersistentTabView::OnFaviconAvailable(
+    const GURL& requested_url,
+    const favicon_base::FaviconRawBitmapResult& bitmap_result) {
+  if (requested_url != url_) {
+    return;
+  }
+  if (!bitmap_result.is_valid()) {
+    ApplyMonogramFavicon();
+    return;
+  }
+  gfx::Image decoded =
+      gfx::Image::CreateFrom1xPNGBytes(bitmap_result.bitmap_data);
+  if (decoded.IsEmpty() || bitmap_result.pixel_size.width() <= 0) {
+    ApplyMonogramFavicon();
+    return;
+  }
+  const float bitmap_scale =
+      std::max(1.0f, static_cast<float>(bitmap_result.pixel_size.width()) /
+                         kIconDesignWidth);
+  gfx::ImageSkia image =
+      gfx::ImageSkia::CreateFromBitmap(decoded.AsBitmap(), bitmap_scale);
+  image.EnsureRepsForSupportedScales();
+  SetFavicon(ui::ImageModel::FromImageSkia(image),
+             PersistentFaviconState::kResolved);
+}
+
+void PersistentTabView::OnFaviconsChanged(const std::set<GURL>& page_urls,
+                                          const GURL&) {
+  const bool matching_host =
+      std::ranges::any_of(page_urls, [this](const GURL& changed_url) {
+        return changed_url.SchemeIsHTTPOrHTTPS() &&
+               changed_url.host() == url_.host();
+      });
+  if (page_urls.empty() || page_urls.contains(url_) || matching_host) {
+    LoadFavicon();
+  }
+}
+
+bool PersistentTabView::IsFrameActive() const {
+  return GetWidget() ? GetWidget()->ShouldPaintAsActive() : true;
+}
+
+void PersistentTabView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  AppendDormantPersistentItemMenuItems(context_menu_model_.get());
+  context_menu_runner_ = std::make_unique<views::MenuRunner>(
+      context_menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  context_menu_runner_->RunMenuAt(
+      GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+      views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void PersistentTabView::ExecuteCommand(int command_id, int event_flags) {
+  switch (static_cast<PersistentItemMenuCommand>(command_id)) {
+    case PersistentItemMenuCommand::kOpen:
+      ActivateFromMenu();
+      break;
+    case PersistentItemMenuCommand::kRemove:
+      if (context_menu_runner_) {
+        context_menu_runner_->Cancel();
+      }
+      if (remove_callback_) {
+        // The menu is owned by this view. Removal rebuilds the parent and
+        // would otherwise destroy the pressed tile before ExecuteCommand
+        // returns.
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, remove_callback_);
+      }
+      break;
+  }
+}
+
+void PersistentTabView::ActivateFromMenu() {
+  ui::MouseEvent event(ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+                       base::TimeTicks(), ui::EF_LEFT_MOUSE_BUTTON,
+                       ui::EF_LEFT_MOUSE_BUTTON);
+  NotifyClick(event);
+}
+
+BEGIN_METADATA(PersistentTabView)
+END_METADATA
