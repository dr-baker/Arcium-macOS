+  // ActivateOmniboxItem owns the identity and Space revalidation. Construct
+  // its service-side value instead of reconstructing an identity from the
+  // URL; duplicate persistent links are valid and must remain distinct.
+  helium::PersistentOmniboxItem target;
+  target.kind = *kind;
+  target.id = item.id;
+  target.title = item.title;
+  target.url = item.url;
+  CopyPersistentItemSpace(item, target);
+  return service->ActivateOmniboxItem(browser, target);
