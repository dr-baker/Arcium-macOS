+std::vector<OmniboxPersistentItem>
+ChromeAutocompleteProviderClient::GetPersistentItems() const {
+  content::WebContents* contents =
+      web_contents_getter_ ? web_contents_getter_.Run() : nullptr;
+  if (!contents) {
+    return {};
+  }
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  helium::HeliumSpaceService* service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!browser || browser->profile() != profile_ ||
+      browser->type() != Browser::TYPE_NORMAL || profile_->IsOffTheRecord() ||
+      profile_->IsGuestSession() || !service) {
+    return {};
+  }
+  std::vector<OmniboxPersistentItem> result;
+  for (const helium::PersistentOmniboxItem& item :
+       service->GetOmniboxItemsForBrowser(browser)) {
+    OmniboxPersistentItem mapped;
+    mapped.kind = item.kind == helium::PersistentRecordKind::kFavorite
+                      ? OmniboxPersistentItem::Kind::kFavorite
+                      : OmniboxPersistentItem::Kind::kPin;
+    mapped.title = item.title;
+    mapped.url = item.url;
+    mapped.id = item.id;
+    mapped.space_id = item.space_id;
+    mapped.space_name = item.space_name;
+    mapped.folder_path = item.folder_path;
+    mapped.state = item.is_active
+                       ? OmniboxPersistentItem::State::kActive
+                       : item.is_live ? OmniboxPersistentItem::State::kLive
+                                      : OmniboxPersistentItem::State::kDormant;
+    mapped.tier = item.tier == helium::PersistentOmniboxItem::Tier::kActiveSpacePin
+                     ? OmniboxPersistentItem::Tier::kActivePin
+                     : item.tier == helium::PersistentOmniboxItem::Tier::kFavorite
+                         ? OmniboxPersistentItem::Tier::kFavorite
+                         : OmniboxPersistentItem::Tier::kOtherPin;
+    mapped.use_count = item.use_count;
+    if (item.last_used_internal_value > 0) {
+      mapped.last_used =
+          base::Time::FromInternalValue(item.last_used_internal_value);
+    }
+    result.push_back(std::move(mapped));
+  }
+  return result;
+}
+
+std::vector<OmniboxPersistentCommand>
+ChromeAutocompleteProviderClient::GetPersistentCommands() const {
+  content::WebContents* contents =
+      web_contents_getter_ ? web_contents_getter_.Run() : nullptr;
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  helium::HeliumSpaceService* service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(profile_);
+  if (!browser || browser->profile() != profile_ ||
+      browser->type() != Browser::TYPE_NORMAL || profile_->IsOffTheRecord() ||
+      profile_->IsGuestSession() || !service) {
+    return {};
+  }
+
+  std::vector<OmniboxPersistentCommand> commands;
+  auto append_global = [&commands](OmniboxPersistentCommand::Type type,
+                                   std::u16string label) {
+    OmniboxPersistentCommand command;
+    command.type = type;
+    command.label = std::move(label);
+    command.search_text = command.label;
+    commands.push_back(std::move(command));
+  };
+  if (tab && helium::CanMakePin(tab)) {
+    append_global(OmniboxPersistentCommand::Type::kPinCurrentTab,
+                  u"Pin current tab");
+  }
+  if (tab && helium::CanMakeFavorite(tab)) {
+    append_global(OmniboxPersistentCommand::Type::kAddCurrentTabToFavorites,
+                  u"Add current tab to Favorites");
+  }
+
+  const auto items = service->GetOmniboxItemsForBrowser(browser);
+  const auto spaces = service->GetSpaces();
+  for (const helium::PersistentOmniboxItem& item : items) {
+    const int kind = item.kind == helium::PersistentRecordKind::kFavorite ? 0 : 1;
+    if (item.is_live) {
+      OmniboxPersistentCommand close;
+      close.type = OmniboxPersistentCommand::Type::kCloseLiveInstance;
+      close.item_kind = kind;
+      close.item_id = item.id;
+      close.item_title = item.title;
+      close.space_id = item.space_id;
+      close.label = u"Close live instance";
+      close.search_text = item.title + u" " + close.label;
+      commands.push_back(std::move(close));
+
+      if (item.kind == helium::PersistentRecordKind::kPin) {
+        OmniboxPersistentCommand home;
+        home.type = OmniboxPersistentCommand::Type::kReturnPinHome;
+        home.item_kind = kind;
+        home.item_id = item.id;
+        home.item_title = item.title;
+        home.space_id = item.space_id;
+        home.label = u"Return Pin home";
+        home.search_text = item.title + u" " + home.label;
+        commands.push_back(std::move(home));
+      }
+    }
+    if (item.kind != helium::PersistentRecordKind::kPin) {
+      continue;
+    }
+    for (helium::HeliumSpace* target_space : spaces) {
+      if (!target_space || target_space->id() == item.space_id) {
+        continue;
+      }
+      OmniboxPersistentCommand move;
+      move.type = OmniboxPersistentCommand::Type::kMovePinToSpace;
+      move.item_kind = kind;
+      move.item_id = item.id;
+      move.item_title = item.title;
+      move.space_id = item.space_id;
+      move.target_space_id = target_space->id();
