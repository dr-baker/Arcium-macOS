+
+bool HeliumSpaceService::AddFromTab(tabs::TabInterface* tab,
+                                    PersistentRecordKind kind) {
+  if (!tab || tab->GetProfile() != profile_ || profile_->IsOffTheRecord() ||
+      profile_->IsGuestSession() || IsPersistentItemTab(tab) ||
+      tab->IsSplit() || tab->GetGroup().has_value()) {
+    return false;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  const GURL url = tab->GetContents()->GetLastCommittedURL();
+  if (!browser || !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  PersistentLink link{
+      .id = NewId(), .title = tab->GetContents()->GetTitle(), .url = url};
+  const std::string key = ItemKey(browser, kind, link.id);
+  if (kind == PersistentRecordKind::kFavorite) {
+    local_favorites_.push_back(PersistentNode{.data = link});
+    profile_->GetPrefs()->SetList(
+        kHeliumFavoritesPref, PersistentItemCodec::Encode(local_favorites_));
+  } else {
+    HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+    if (!space) {
+      return false;
+    }
+    space->AppendPin(link);
+  }
+  lifecycle_.AddDormant(key);
+  if (!AssociateLiveTab(key, kind, link.id, tab)) {
+    // The durable record remains valid even if the existing tab cannot be
+    // associated. Its next activation will materialize from the stored URL.
+    NotifyItemsChanged();
+    return true;
+  }
+  NotifyItemsChanged();
+  return true;
+}
+
+bool HeliumSpaceService::IsPersistentItemTab(
+    const tabs::TabInterface* tab) const {
+  return GetPersistentItemKind(tab).has_value();
+}
+
+std::optional<PersistentRecordKind> HeliumSpaceService::GetPersistentItemKind(
+    const tabs::TabInterface* tab) const {
+  if (!tab) {
+    return std::nullopt;
+  }
+  for (const auto& [token, association] : live_associations_) {
+    if (association->tab == tab) {
+      return association->kind;
+    }
+  }
+  return std::nullopt;
+}
+
+bool HeliumSpaceService::GetPersistentItemHome(
+    const tabs::TabInterface* tab,
+    GURL* home_url,
+    std::u16string* home_title) const {
+  if (!tab || !home_url || !home_title) {
+    return false;
+  }
+  for (const auto& [token, association] : live_associations_) {
+    if (association->tab != tab) {
+      continue;
+    }
+    const BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+    // ResolveItem only inspects browser identity and profile state. Preserve
+    // its established API while entering from a const TabInterface observer.
+    Browser* browser =
+        window ? const_cast<Browser*>(window->GetBrowserForMigrationOnly())
+               : nullptr;
+    std::optional<PersistentLink> item =
+        ResolveItem(browser, association->kind, association->item_id);
+    if (!item) {
+      return false;
+    }
+    *home_url = item->url;
+    *home_title = item->title;
+    return true;
+  }
+  return false;
+}
+
+bool HeliumSpaceService::AssociateLiveTab(std::string key,
+                                          PersistentRecordKind kind,
+                                          std::string_view id,
+                                          tabs::TabInterface* tab) {
+  if (!tab) {
+    return false;
+  }
+  const uint64_t token = next_live_token_++;
+  auto association =
+      std::make_unique<LiveAssociation>(token, key, kind, std::string(id), tab);
+  association->will_detach_subscription = tab->RegisterWillDetach(
+      base::BindRepeating(&HeliumSpaceService::OnLiveTabWillDetach,
+                          weak_factory_.GetWeakPtr(), token));
+  association->did_insert_subscription = tab->RegisterDidInsert(
+      base::BindRepeating(&HeliumSpaceService::OnLiveTabDidInsert,
+                          weak_factory_.GetWeakPtr(), token));
+  association->did_activate_subscription = tab->RegisterDidActivate(
+      base::BindRepeating(&HeliumSpaceService::OnLiveTabActivationChanged,
+                          weak_factory_.GetWeakPtr()));
+  association->will_deactivate_subscription = tab->RegisterWillDeactivate(
+      base::BindRepeating(&HeliumSpaceService::OnLiveTabActivationChanged,
+                          weak_factory_.GetWeakPtr()));
+  if (lifecycle_.GetState(key) == PersistentItemLifecycle::State::kMaterializing
+          ? !lifecycle_.DidMaterialize(key, token)
+          : !lifecycle_.RestoreLive(key, token)) {
+    return false;
+  }
+  live_associations_.emplace(token, std::move(association));
+  if (SessionService* sessions =
+          SessionServiceFactory::GetForProfile(profile_)) {
+    BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+    if (window) {
+      sessions->AddTabExtraData(
+          window->GetSessionID(),
+          sessions::SessionTabHelper::IdForTab(tab->GetContents()),
+          kHeliumPersistentItemTabExtraDataKey, key);
+    }
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (std::optional<PersistentLink> item = ResolveItem(browser, kind, id)) {
+    SeedAnchoredHome(tab, *item);
+  }
+  // Register ownership before moving the native view so synchronous
+  // collection observers can recognize it as the live persistent instance.
+  MoveLiveTabToPersistentRegion(kind, tab);
+  return true;
+}
+
+void HeliumSpaceService::MoveLiveTabToPersistentRegion(
+    PersistentRecordKind kind,
+    tabs::TabInterface* tab) {
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  if (!model) {
+    return;
+  }
+  if (LiveCollectionForKind(kind) == PersistentLiveCollection::kPinnedGrid) {
+    model->SetTabPinned(model->GetIndexOfTab(tab), true);
+  } else {
+    model->MoveTabToPin(tab);
+  }
+}
+
+void HeliumSpaceService::SeedAnchoredHome(tabs::TabInterface* tab,
+                                          const PersistentLink& item) {
+  TabUIHelper* helper = TabUIHelper::From(tab);
+  if (!helper || !item.url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  std::u16string title = item.title;
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(item.url.host());
+  }
+  helper->SetAnchoredPinnedTabHome(item.url, std::move(title));
+}
+
+void HeliumSpaceService::OnLiveTabWillDetach(
+    uint64_t token,
+    tabs::TabInterface* tab,
+    tabs::TabInterface::DetachReason reason) {
+  if (reason != tabs::TabInterface::DetachReason::kDelete) {
+    return;
+  }
+  lifecycle_.BeginClose(token);
+  // The callback is inside TabInterface teardown. Only bookkeeping is queued;
+  // this service never destroys WebContents from an observer callback.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSpaceService::CompleteLiveTabClose,
+                                weak_factory_.GetWeakPtr(), token));
+}
+
+void HeliumSpaceService::OnLiveTabDidInsert(uint64_t token,
+                                            tabs::TabInterface* tab) {
+  auto association = live_associations_.find(token);
+  if (association == live_associations_.end()) {
+    return;
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (IsItemKeyVisibleInBrowser(browser, association->second->key) &&
+      IsLiveTabInExpectedCollection(association->second->kind, tab)) {
+    return;
+  }
+  // Moving a live instance out of its collection, Space, or window leaves the
+  // ordinary tab in place and returns only the persistent association to
+  // dormant. Defer subscription destruction until the insertion callback
+  // unwinds.
+  lifecycle_.BeginClose(token);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSpaceService::CompleteLiveTabClose,
+                                weak_factory_.GetWeakPtr(), token));
+}
+
+bool HeliumSpaceService::IsLiveTabInExpectedCollection(
+    PersistentRecordKind kind,
+    const tabs::TabInterface* tab) const {
+  if (!tab) {
+    return false;
+  }
+  if (LiveCollectionForKind(kind) == PersistentLiveCollection::kPinnedGrid) {
+    return tab->IsPinned();
+  }
+  const tabs::TabStripCollection* strip = nullptr;
+  if (const BrowserWindowInterface* window = tab->GetBrowserWindowInterface()) {
+    if (const TabStripModel* model = window->GetTabStripModel();
+        model && model->Root()) {
+      strip = static_cast<const tabs::TabStripCollection*>(model->Root());
+    }
+  }
+  return strip && strip->IsPinTab(tab);
+}
+
+void HeliumSpaceService::OnLiveTabActivationChanged(tabs::TabInterface* tab) {
+  // WillDeactivate runs before TabInterface flips its active state. Rebuild
+  // after the observer callback so collapsed folders expose only the item
+  // that is actually active once the selection transition has completed.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void HeliumSpaceService::CompleteLiveTabClose(uint64_t token) {
+  lifecycle_.CompleteClose(token);
+  live_associations_.erase(token);
+  NotifyItemsChanged();
+}
+
+bool HeliumSpaceService::IsPersistentItemLive(Browser* browser,
+                                              PersistentRecordKind kind,
+                                              std::string_view id) const {
+  const auto state = lifecycle_.GetState(ItemKey(browser, kind, id));
+  return state && (*state == PersistentItemLifecycle::State::kLive ||
+                   *state == PersistentItemLifecycle::State::kClosing);
+}
+
+tabs::TabInterface* HeliumSpaceService::GetLiveTabForPersistentItem(
+    Browser* browser,
+    PersistentRecordKind kind,
+    std::string_view id) const {
+  const auto token = lifecycle_.GetLiveTab(ItemKey(browser, kind, id));
+  if (!token) {
+    return nullptr;
+  }
+  const auto association = live_associations_.find(*token);
+  tabs::TabInterface* tab = association == live_associations_.end()
+                                ? nullptr
+                                : association->second->tab.get();
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  return tab && window && window->GetBrowserForMigrationOnly() == browser
+             ? tab
+             : nullptr;
+}
+
+bool HeliumSpaceService::IsPersistentItemActive(Browser* browser,
+                                                PersistentRecordKind kind,
+                                                std::string_view id) const {
+  const auto token = lifecycle_.GetLiveTab(ItemKey(browser, kind, id));
+  if (!token) {
+    return false;
+  }
+  const auto association = live_associations_.find(*token);
+  return association != live_associations_.end() && association->second->tab &&
+         association->second->tab->GetBrowserWindowInterface() &&
+         association->second->tab->GetBrowserWindowInterface()
+                 ->GetBrowserForMigrationOnly() == browser &&
+         association->second->tab->IsActivated();
+}
+
+bool HeliumSpaceService::CloseLiveInstanceForKey(std::string_view key,
+                                                 bool close_tab) {
+  const auto token = lifecycle_.GetLiveTab(key);
+  if (!token) {
+    return false;
+  }
+  auto association = live_associations_.find(*token);
+  if (association == live_associations_.end() || !association->second->tab) {
+    lifecycle_.BeginClose(*token);
+    lifecycle_.CompleteClose(*token);
+    return true;
+  }
+
+  tabs::TabInterface* tab = association->second->tab.get();
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  const int index = model ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+  if (!close_tab) {
+    if (TabUIHelper* helper = TabUIHelper::From(tab)) {
+      helper->ClearAnchoredPinnedTabHome();
+    }
+    lifecycle_.BeginClose(*token);
+    live_associations_.erase(association);
+    lifecycle_.CompleteClose(*token);
+    NotifyItemsChanged();
+    return true;
+  }
+  if (!model || index == TabStripModel::kNoTab) {
+    lifecycle_.BeginClose(*token);
+    live_associations_.erase(association);
+    lifecycle_.CompleteClose(*token);
+    NotifyItemsChanged();
+    return true;
+  }
+
+  // Mark the transition before asking TabStripModel to delete the tab. The
+  // detach observer may run synchronously, while its final bookkeeping is
+  // deliberately posted until the TabInterface callback has unwound.
+  lifecycle_.BeginClose(*token);
+  model->CloseWebContentsAt(index,
+                            TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  return true;
+}
+
+bool HeliumSpaceService::ClosePersistentItemInstance(
+    Browser* browser,
+    PersistentRecordKind kind,
+    std::string_view id,
+    std::string_view source_space_id) {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
   }
+  if (kind == PersistentRecordKind::kFavorite) {
+    if (!ResolveItem(browser, kind, id)) {
+      return false;
+    }
+    return CloseLiveInstanceForKey(ItemKey(browser, kind, id), true);
+  }
+  if (source_space_id.empty() || !ResolvePinInSpace(source_space_id, id)) {
+    return false;
+  }
+  return CloseLiveInstanceForKey(
+      ItemKeyForSpace(PersistentRecordKind::kPin, source_space_id, id), true);
+}
+
+bool HeliumSpaceService::ReturnPersistentItemHome(Browser* browser,
+                                                  PersistentRecordKind kind,
+                                                  std::string_view id,
+                                                  std::string_view source_space_id) {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  std::string key;
+  if (kind == PersistentRecordKind::kFavorite) {
+    if (!ResolveItem(browser, kind, id)) {
+      return false;
+    }
+    key = ItemKey(browser, kind, id);
+  } else {
+    if (source_space_id.empty() || !ResolvePinInSpace(source_space_id, id)) {
+      return false;
+    }
+    key = ItemKeyForSpace(PersistentRecordKind::kPin, source_space_id, id);
+  }
+  const auto token = lifecycle_.GetLiveTab(key);
+  if (!token) {
+    return false;
+  }
+  const auto association = live_associations_.find(*token);
+  if (association == live_associations_.end() || !association->second->tab) {
+    return false;
+  }
+  ResetAnchoredPinnedTab(association->second->tab.get());
+  NotifyItemsChanged();
+  return true;
+}
+
+bool HeliumSpaceService::MovePinToSpace(Browser* browser,
+                                        std::string_view id,
+                                        std::string_view source_space_id,
+                                        std::string_view target_space_id) {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  if (source_space_id.empty() || target_space_id.empty()) {
+    return false;
+  }
+  HeliumSpace* target_space = GetSpaceById(target_space_id);
+  HeliumSpace* source_space = GetSpaceById(source_space_id);
+  if (!source_space || !target_space || source_space == target_space) {
+    return false;
+  }
+  std::optional<PersistentLink> link =
+      ResolvePinInSpace(source_space->id(), id);
+  if (!link || ResolvePinInSpace(target_space_id, id)) {
+    return false;
+  }
+  const std::string old_key =
+      ItemKeyForSpace(PersistentRecordKind::kPin, source_space_id, id);
+  const std::string new_key =
+      ItemKeyForSpace(PersistentRecordKind::kPin, target_space_id, id);
+  const auto state = lifecycle_.GetState(old_key);
+  if (state && (*state == PersistentItemLifecycle::State::kLive ||
+                *state == PersistentItemLifecycle::State::kClosing) &&
+      !CloseLiveInstanceForKey(old_key, true)) {
+    return false;
+  }
+  if (!source_space->RemovePin(id)) {
+    return false;
+  }
+  target_space->AppendPin(*link);
+
+  // Space ownership is part of a Pin's stable identity. Carry the bounded
+  // usage record along with a move without storing any URL or title data.
+  if (const auto usage = persistent_item_usage_.find(old_key);
+      usage != persistent_item_usage_.end()) {
+    persistent_item_usage_.insert_or_assign(new_key, usage->second);
+    persistent_item_usage_.erase(usage);
+    PersistPersistentItemUsage();
+  }
+  RegisterDormantItems();
+  NotifyItemsChanged();
+  return true;
+}
+
+bool HeliumSpaceService::ToggleFolderCollapsed(Browser* browser,
+                                               PersistentRecordKind kind,
+                                               std::string_view folder_id) {
+  if (!IsEligibleBrowser(browser)) {
+    return false;
+  }
+  if (kind == PersistentRecordKind::kFavorite) {
+    if (PersistentFolder* folder =
+            PersistentItemCodec::FindFolder(local_favorites_, folder_id)) {
+      folder->collapsed = !folder->collapsed;
+      profile_->GetPrefs()->SetList(
+          kHeliumFavoritesPref, PersistentItemCodec::Encode(local_favorites_));
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                    weak_factory_.GetWeakPtr()));
+      return true;
+    }
+
+    HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+    if (!space || space->source_profile().empty()) {
+      return false;
+    }
+    ScopedDictPrefUpdate favorites_update(profile_->GetPrefs(),
+                                          kHeliumArcFavoritesByProfilePref);
+    base::ListValue* encoded =
+        favorites_update->FindList(space->source_profile());
+    auto favorites =
+        encoded ? PersistentItemCodec::Decode(*encoded, false) : std::nullopt;
+    PersistentFolder* folder =
+        favorites ? PersistentItemCodec::FindFolder(*favorites, folder_id)
+                  : nullptr;
+    if (!folder) {
+      return false;
+    }
+    folder->collapsed = !folder->collapsed;
+    favorites_update->Set(space->source_profile(),
+                          PersistentItemCodec::Encode(*favorites));
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                  weak_factory_.GetWeakPtr()));
+    return true;
+  }
+
+  HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+  if (!space || !space->ToggleFolderCollapsed(folder_id)) {
+    return false;
+  }
+  // The notification rebuilds the virtual row tree. Defer it until the
+  // pressed row's input callback unwinds so the view cannot be destroyed and
+  // replaced underneath the same mouse event.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+bool HeliumSpaceService::ReplacePersistentItemHome(tabs::TabInterface* tab) {
+  if (!tab || !tab->GetContents()) {
+    return false;
+  }
+  const GURL url = tab->GetContents()->GetLastCommittedURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  std::u16string title = tab->GetContents()->GetTitle();
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(url.host());
+  }
+  for (const auto& [token, association] : live_associations_) {
+    if (association->tab != tab) {
+      continue;
+    }
+    BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+    Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+    bool updated = false;
+    if (association->kind == PersistentRecordKind::kFavorite) {
+      updated = MutateFavoriteHome(browser, association->item_id, url, title);
+    } else if (HeliumSpace* space =
+                   GetSpaceById(GetSpaceIdForBrowser(browser))) {
+      updated = space->UpdatePinHome(association->item_id, url, title);
+    }
+    if (!updated) {
+      return false;
+    }
+    SeedAnchoredHome(
+        tab,
+        PersistentLink{.id = association->item_id, .title = title, .url = url});
+    NotifyItemsChanged();
+    return true;
+  }
+  return false;
+}
+
+bool HeliumSpaceService::RemovePersistentItem(tabs::TabInterface* tab) {
+  for (const auto& [token, association] : live_associations_) {
+    if (association->tab != tab) {
+      continue;
+    }
+    BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+    Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+    return RemovePersistentItem(browser, association->kind,
+                                association->item_id);
+  }
+  return false;
+}
+
+bool HeliumSpaceService::RemovePersistentItem(Browser* browser,
+                                              PersistentRecordKind kind,
+                                              std::string_view id) {
+  std::optional<PersistentLink> item = ResolveItem(browser, kind, id);
+  if (!item) {
+    return false;
+  }
+  const std::string key = ItemKey(browser, kind, id);
+  tabs::TabInterface* live_tab = GetLiveTabForPersistentItem(browser, kind, id);
+  bool removed = false;
+  if (kind == PersistentRecordKind::kFavorite) {
+    removed = RemoveFavoriteRecord(browser, id);
+  } else if (HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser))) {
+    removed = space->RemovePin(id);
+  }
+  if (!removed) {
+    return false;
+  }
+  DisassociateLiveTab(live_tab);
+  lifecycle_.Forget(key);
+  RegisterDormantItems();
+  // Defer the view rebuild. Dormant Remove runs from a menu owned by the
+  // tile being deleted; destroying that view inside ExecuteCommand is unsafe.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSpaceService::NotifyItemsChanged,
+                                weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+void HeliumSpaceService::PersistLocalFavorites() {
+  profile_->GetPrefs()->SetList(kHeliumFavoritesPref,
+                                PersistentItemCodec::Encode(local_favorites_));
+}
+
+bool HeliumSpaceService::MutateFavoriteHome(Browser* browser,
+                                            std::string_view id,
+                                            GURL url,
+                                            std::u16string title) {
+  if (PersistentItemCodec::UpdateLinkHome(local_favorites_, id, url, title)) {
+    PersistLocalFavorites();
+    return true;
+  }
+  HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+  if (!space || space->source_profile().empty()) {
+    return false;
+  }
+  ScopedDictPrefUpdate favorites_update(profile_->GetPrefs(),
+                                        kHeliumArcFavoritesByProfilePref);
+  base::ListValue* encoded =
+      favorites_update->FindList(space->source_profile());
+  auto favorites =
+      encoded ? PersistentItemCodec::Decode(*encoded, false) : std::nullopt;
+  if (!favorites || !PersistentItemCodec::UpdateLinkHome(
+                        *favorites, id, std::move(url), std::move(title))) {
+    return false;
+  }
+  favorites_update->Set(space->source_profile(),
+                        PersistentItemCodec::Encode(*favorites));
+  return true;
+}
+
+bool HeliumSpaceService::RemoveFavoriteRecord(Browser* browser,
+                                              std::string_view id) {
+  if (PersistentItemCodec::RemoveNode(local_favorites_, id)) {
+    PersistLocalFavorites();
+    return true;
+  }
+  HeliumSpace* space = GetSpaceById(GetSpaceIdForBrowser(browser));
+  if (!space || space->source_profile().empty()) {
+    return false;
+  }
+  ScopedDictPrefUpdate favorites_update(profile_->GetPrefs(),
+                                        kHeliumArcFavoritesByProfilePref);
+  base::ListValue* encoded =
+      favorites_update->FindList(space->source_profile());
+  auto favorites =
+      encoded ? PersistentItemCodec::Decode(*encoded, false) : std::nullopt;
+  if (!favorites || !PersistentItemCodec::RemoveNode(*favorites, id)) {
+    return false;
+  }
+  favorites_update->Set(space->source_profile(),
+                        PersistentItemCodec::Encode(*favorites));
+  return true;
+}
+
+void HeliumSpaceService::DisassociateLiveTab(tabs::TabInterface* tab) {
+  if (!tab) {
+    return;
+  }
+  for (auto it = live_associations_.begin(); it != live_associations_.end();
+       ++it) {
+    if (it->second->tab != tab) {
+      continue;
+    }
+    const uint64_t token = it->first;
+    if (TabUIHelper* helper = TabUIHelper::From(tab)) {
+      helper->ClearAnchoredPinnedTabHome();
+    }
+    BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+    TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+    lifecycle_.BeginClose(token);
+    live_associations_.erase(it);
+    lifecycle_.CompleteClose(token);
+    if (!model) {
+      return;
+    }
+    if (tab->IsPinned()) {
+      const int index = model->GetIndexOfTab(tab);
+      if (index != TabStripModel::kNoTab) {
+        model->SetTabPinned(index, false);
+      }
+    } else if (const tabs::TabStripCollection* strip =
+                   model->Root() ? static_cast<const tabs::TabStripCollection*>(
+                                       model->Root())
+                                 : nullptr;
+               strip && strip->IsPinTab(tab)) {
+      model->MoveTabFromPin(tab);
+    }
+    return;
+  }
+}
+
+void HeliumSpaceService::LoadPersistentItemUsage() {
+  persistent_item_usage_.clear();
+  const base::DictValue& encoded =
+      profile_->GetPrefs()->GetDict(kHeliumPersistentItemUsagePref);
+  const base::Time now = base::Time::Now();
+  for (const auto [key, value] : encoded) {
+    if ((!key.starts_with("f:") && !key.starts_with("p:")) ||
+        key.size() <= 2u) {
+      continue;
+    }
+    const base::DictValue* entry = value.GetIfDict();
+    if (!entry) {
+      continue;
+    }
+    const int count = entry->FindInt(kUsageCountKey).value_or(0);
+    const std::string* encoded_timestamp =
+        entry->FindString(kUsageLastUsedKey);
+    int64_t raw_timestamp = 0;
+    if (count <= 0 || !encoded_timestamp ||
+        !base::StringToInt64(*encoded_timestamp, &raw_timestamp) ||
+        raw_timestamp <= 0) {
+      continue;
+    }
+    base::Time last_used = base::Time::FromInternalValue(raw_timestamp);
+    if (last_used.is_null()) {
+      continue;
+    }
+    if (last_used > now) {
+      last_used = now;
+    }
+    persistent_item_usage_.emplace(
+        key, UsageEntry{.count = std::min(count, kMaxPersistentItemUseCount),
+                        .last_used = last_used});
+  }
+  PersistPersistentItemUsage();
+}
+
+void HeliumSpaceService::PersistPersistentItemUsage() {
+  base::DictValue encoded;
+  for (const auto& [key, entry] : persistent_item_usage_) {
+    base::DictValue value;
+    value.Set(kUsageCountKey,
+              std::min(entry.count, kMaxPersistentItemUseCount));
+    value.Set(kUsageLastUsedKey,
+              base::NumberToString(entry.last_used.ToInternalValue()));
+    encoded.Set(key, std::move(value));
+  }
+  profile_->GetPrefs()->SetDict(kHeliumPersistentItemUsagePref,
+                                std::move(encoded));
+}
+
+void HeliumSpaceService::PrunePersistentItemUsage(
+    const std::set<std::string>& durable_keys) {
+  bool changed = false;
+  for (auto it = persistent_item_usage_.begin();
+       it != persistent_item_usage_.end();) {
+    if (!durable_keys.contains(it->first) || it->second.count <= 0 ||
+        it->second.last_used.is_null()) {
+      it = persistent_item_usage_.erase(it);
+      changed = true;
+      continue;
+    }
+    const int capped_count =
+        std::min(it->second.count, kMaxPersistentItemUseCount);
+    if (capped_count != it->second.count) {
+      it->second.count = capped_count;
+      changed = true;
+    }
+    const base::Time now = base::Time::Now();
+    if (it->second.last_used > now) {
+      it->second.last_used = now;
+      changed = true;
+    }
+    ++it;
+  }
+
+  if (persistent_item_usage_.size() > kMaxPersistentItemUsageEntries) {
+    std::vector<std::string> keys;
+    keys.reserve(persistent_item_usage_.size());
+    for (const auto& [key, entry] : persistent_item_usage_) {
+      static_cast<void>(entry);
+      keys.push_back(key);
+    }
+    std::ranges::sort(keys, [this](const std::string& lhs,
+                                   const std::string& rhs) {
+      const base::Time lhs_time = persistent_item_usage_.at(lhs).last_used;
+      const base::Time rhs_time = persistent_item_usage_.at(rhs).last_used;
+      return lhs_time == rhs_time ? lhs < rhs : lhs_time > rhs_time;
+    });
+    for (size_t index = kMaxPersistentItemUsageEntries; index < keys.size();
+         ++index) {
+      persistent_item_usage_.erase(keys[index]);
+    }
+    changed = true;
+  }
+  if (changed) {
+    PersistPersistentItemUsage();
+  }
+}
+
+void HeliumSpaceService::RecordPersistentItemUsage(std::string_view key) {
+  if (key.empty()) {
+    return;
+  }
+  UsageEntry& entry = persistent_item_usage_[std::string(key)];
+  entry.count = entry.count >= kMaxPersistentItemUseCount
+                    ? kMaxPersistentItemUseCount
+                    : entry.count + 1;
+  entry.last_used = base::Time::Now();
+  PersistPersistentItemUsage();
+}
