+
+class PersistentTabViewTest : public ChromeViewsTestBase {
+ protected:
+  std::unique_ptr<PersistentTabView> MakeView(
+      PersistentTabView::PresentationMode mode,
+      views::Button::PressedCallback activate =
+          base::BindRepeating([](const ui::Event&) {}),
+      base::RepeatingClosure remove = base::RepeatingClosure()) {
+    return std::make_unique<PersistentTabView>(
+        &profile_, "item-id", u"Example", GURL("https://example.test/"), mode,
+        std::move(activate), std::move(remove));
+  }
+
+  TestingProfile profile_;
+};
+
+TEST_F(PersistentTabViewTest, UsesNativeTabSemanticsAndSelection) {
+  auto row = MakeView(PersistentTabView::PresentationMode::kFullRow);
+
+  EXPECT_EQ(2u, row->children().size());
+  EXPECT_EQ(GetLayoutConstant(LayoutConstant::kVerticalTabHeight),
+            row->GetPreferredSize().height());
+  EXPECT_TRUE(row->title_visible_for_testing());
+
+  ui::AXNodeData node_data;
+  row->GetViewAccessibility().GetAccessibleNodeData(&node_data);
+  EXPECT_EQ(ax::mojom::Role::kTab, node_data.role);
+  EXPECT_FALSE(node_data.GetBoolAttribute(ax::mojom::BoolAttribute::kSelected));
+
+  row->Update(u"Updated", GURL("https://example.test/"), true);
+  node_data = ui::AXNodeData();
+  row->GetViewAccessibility().GetAccessibleNodeData(&node_data);
+  EXPECT_TRUE(row->selected());
+  EXPECT_TRUE(node_data.GetBoolAttribute(ax::mojom::BoolAttribute::kSelected));
+}
+
+TEST_F(PersistentTabViewTest, CompactGridHidesTitleAndUsesPinnedMetrics) {
+  auto tile = MakeView(PersistentTabView::PresentationMode::kCompactGrid);
+
+  EXPECT_FALSE(tile->title_visible_for_testing());
+  EXPECT_EQ(PersistentTabView::PresentationMode::kCompactGrid,
+            tile->presentation_mode());
+  EXPECT_EQ(GetLayoutConstant(LayoutConstant::kVerticalTabPinnedHeight),
+            tile->GetPreferredSize().height());
+  EXPECT_EQ(GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth),
+            tile->GetPreferredSize().width());
+}
+
+TEST_F(PersistentTabViewTest, FallsBackToGeneratedMonogramWithoutCachedIcon) {
+  auto row = MakeView(PersistentTabView::PresentationMode::kFullRow);
+  task_environment()->RunUntilIdle();
+  EXPECT_TRUE(row->using_generated_favicon_for_testing());
+  EXPECT_EQ(PersistentFaviconState::kGenerated,
+            row->favicon_state_for_testing());
+}
+
+TEST(PersistentFaviconPolicyTest, GeneratedFallbackDoesNotReplaceResolvedIcon) {
+  EXPECT_TRUE(
+      ShouldApplyGeneratedFavicon(PersistentFaviconState::kPlaceholder));
+  EXPECT_TRUE(ShouldApplyGeneratedFavicon(PersistentFaviconState::kGenerated));
+  EXPECT_FALSE(ShouldApplyGeneratedFavicon(PersistentFaviconState::kResolved));
+}
+
+TEST_F(PersistentTabViewTest, ResolvedFaviconSurvivesFailedSameUrlRefresh) {
+  auto row = MakeView(PersistentTabView::PresentationMode::kFullRow);
+  row->SetResolvedFaviconStateForTesting();
+  row->Update(u"Example", GURL("https://example.test/"), true);
+  row->Update(u"Example", GURL("https://example.test/"), false);
+  row->ApplyGeneratedFaviconForTesting();
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(PersistentFaviconState::kResolved,
+            row->favicon_state_for_testing());
+  EXPECT_FALSE(row->using_generated_favicon_for_testing());
+}
+
+TEST_F(PersistentTabViewTest,
+       UrlChangeResetsFaviconAndAllowsGeneratedFallback) {
+  auto row = MakeView(PersistentTabView::PresentationMode::kFullRow);
+  row->SetResolvedFaviconStateForTesting();
+  row->Update(u"Other", GURL("https://other.test/"), false);
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(PersistentFaviconState::kGenerated,
+            row->favicon_state_for_testing());
+  EXPECT_TRUE(row->using_generated_favicon_for_testing());
+}
+
+TEST_F(PersistentTabViewTest, DormantMenuExposesOpenAndRemove) {
+  ui::SimpleMenuModel model(nullptr);
+  AppendDormantPersistentItemMenuItems(&model);
+  ASSERT_EQ(2u, model.GetItemCount());
+  EXPECT_EQ(static_cast<int>(PersistentItemMenuCommand::kOpen),
+            model.GetCommandIdAt(0));
+  EXPECT_EQ(static_cast<int>(PersistentItemMenuCommand::kRemove),
+            model.GetCommandIdAt(1));
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_NTP_CUSTOM_LINKS_REMOVE),
+            model.GetLabelAt(1));
+  EXPECT_NE(l10n_util::GetStringUTF16(IDS_TAB_CXMENU_REMOVE_PIN),
+            model.GetLabelAt(1));
+}
+
+TEST_F(PersistentTabViewTest, PressEmitsExactlyOneActivation) {
+  int activation_count = 0;
+  auto row = MakeView(PersistentTabView::PresentationMode::kFullRow,
+                      base::BindRepeating([](int* count) { ++*count; },
+                                          base::Unretained(&activation_count)));
+
+  ui::MouseEvent event(ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+                       base::TimeTicks(), ui::EF_LEFT_MOUSE_BUTTON,
+                       ui::EF_LEFT_MOUSE_BUTTON);
+  views::test::ButtonTestApi(row.get()).NotifyClick(event);
+
+  EXPECT_EQ(1, activation_count);
+}
+
+TEST_F(PersistentTabViewTest, ContextMenuRemoveUsesDedicatedCallback) {
+  int remove_count = 0;
+  auto row = MakeView(PersistentTabView::PresentationMode::kCompactGrid,
+                      base::BindRepeating([](const ui::Event&) {}),
+                      base::BindRepeating([](int* count) { ++*count; },
+                                          base::Unretained(&remove_count)));
+
+  row->ExecuteCommand(static_cast<int>(PersistentItemMenuCommand::kRemove), 0);
+  EXPECT_EQ(0, remove_count);
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(1, remove_count);
+}
