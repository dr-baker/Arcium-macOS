+
+std::u16string PersistentDescription(const OmniboxPersistentItem& item) {
+  const bool has_metadata =
+      !item.id.empty() || item.tier != OmniboxPersistentItem::Tier::kUnspecified ||
+      !item.space_id.empty() || !item.space_name.empty() ||
+      !item.folder_path.empty() ||
+      item.state != OmniboxPersistentItem::State::kDormant;
+
+  if (!has_metadata) {
+    return item.kind == OmniboxPersistentItem::Kind::kFavorite ? u"Favorite"
+                                                               : u"Pin";
+  }
+
+  std::u16string description = PersistentActionLabel(item);
+
+  // Preserve the compact legacy labels for callers that only provide the
+  // original kind/title/url tuple. New snapshots carry an id or state and get
+  // the state-aware form below.
+  description += u" · ";
+  description += item.kind == OmniboxPersistentItem::Kind::kFavorite
+                     ? u"Favorite"
+                     : u"Pin";
+  description += u" · ";
+  description += PersistentStateLabel(item.state);
+
+  std::vector<std::u16string> breadcrumb;
+  if (!item.space_name.empty()) {
+    breadcrumb.push_back(item.space_name);
+  } else if (item.kind == OmniboxPersistentItem::Kind::kFavorite) {
+    breadcrumb.push_back(u"All Spaces");
+  }
+  // The generic descriptor stores the immediate parent first. Render a
+  // conventional root-to-leaf breadcrumb without mutating the snapshot.
+  for (auto it = item.folder_path.rbegin(); it != item.folder_path.rend();
+       ++it) {
+    if (!it->empty()) {
+      breadcrumb.push_back(*it);
+    }
+  }
+  if (!breadcrumb.empty()) {
+    description += u" · ";
+    description += base::JoinString(breadcrumb, u" › ");
+  }
+  return description;
+}
+
+int PersistentRecencyScore(const base::Time& last_used) {
+  if (last_used.is_null()) {
+    return 0;
+  }
+  base::TimeDelta age = base::Time::Now() - last_used;
+  if (age.is_negative()) {
+    age = base::TimeDelta();
+  }
+  return std::max(0, kMaxPersistentRecencyScore -
+                         static_cast<int>(age.InDays()));
+}
+
+int PersistentRelevance(const OmniboxPersistentItem& item,
+                        const std::u16string& query) {
+  int relevance = 0;
+  switch (EffectiveTier(item)) {
+    case OmniboxPersistentItem::Tier::kActivePin:
+      relevance = kPersistentActivePinRelevance;
+      break;
+    case OmniboxPersistentItem::Tier::kFavorite:
+      relevance = kPersistentFavoriteRelevance;
+      break;
+    case OmniboxPersistentItem::Tier::kOtherPin:
+      relevance = kPersistentOtherPinRelevance;
+      break;
+    case OmniboxPersistentItem::Tier::kUnspecified:
+      break;
+  }
+
+  const std::u16string url = base::UTF8ToUTF16(item.url.spec());
+  relevance += MatchQuality(query, item.title, url) * kPersistentMatchWeight;
+  relevance +=
+      std::min(std::max(item.use_count, 0), kMaxPersistentUsageCount) * 2;
+  relevance += PersistentRecencyScore(item.last_used);
+  return relevance;
+}
+
+std::u16string PersistentCommandText(
+    const OmniboxPersistentCommand& command) {
+  if (!command.label.empty()) {
+    return command.label;
+  }
+
+  switch (command.type) {
+    case OmniboxPersistentCommand::Type::kPinCurrentTab:
+      return u"Pin current tab";
+    case OmniboxPersistentCommand::Type::kAddCurrentTabToFavorites:
+      return u"Favorite current tab";
+    case OmniboxPersistentCommand::Type::kMovePinToSpace: {
+      std::u16string text = u"Move pin";
+      if (!command.item_title.empty()) {
+        text += u" \"";
+        text += command.item_title;
+        text += u"\"";
+      }
+      text += u" to ";
+      text += command.target_space_name.empty() ? u"target Space"
+                                                : command.target_space_name;
+      return text;
+    }
+    case OmniboxPersistentCommand::Type::kCloseLiveInstance:
+      return command.item_title.empty() ? u"Close live instance"
+                                        : u"Close live instance: " +
+                                              command.item_title;
+    case OmniboxPersistentCommand::Type::kReturnPinHome:
+      return command.item_title.empty() ? u"Return pin home"
+                                        : u"Return pin home: " +
+                                              command.item_title;
+  }
+}
+
+std::u16string PersistentCommandDescription(
+    const OmniboxPersistentCommand& command) {
+  std::u16string description = u"Helium command";
+  if (!command.target_space_name.empty()) {
+    description += u" · ";
+    description += command.target_space_name;
+  }
+  return description;
+}
+
+bool CommandMatches(const OmniboxPersistentCommand& command,
+                     const std::u16string& query,
+                     const std::u16string& text) {
+  const std::u16string lower_query = Lowercase(query);
+  if (Lowercase(text).find(lower_query) != std::u16string::npos ||
+      Lowercase(command.search_text).find(lower_query) !=
+          std::u16string::npos ||
+      Lowercase(command.item_title).find(lower_query) !=
+          std::u16string::npos ||
+      Lowercase(command.target_space_name).find(lower_query) !=
+          std::u16string::npos) {
