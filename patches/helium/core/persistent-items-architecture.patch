Index: src/chrome/browser/ui/helium/helium_persistent_item_model.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/helium_persistent_item_model.cc
@@ -0,0 +1,372 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_persistent_item_model.h"
+
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+
+namespace helium {
+namespace {
+
+base::Value EncodeNode(const PersistentNode& node) {
+  base::DictValue value;
+  if (const auto* link = std::get_if<PersistentLink>(&node.data)) {
+    value.Set("type", "link");
+    value.Set("id", link->id);
+    value.Set("title", base::UTF16ToUTF8(link->title));
+    value.Set("url", link->url.spec());
+    return base::Value(std::move(value));
+  }
+  const auto& folder = std::get<PersistentFolder>(node.data);
+  base::ListValue children;
+  for (const PersistentNode& child : folder.children) {
+    children.Append(EncodeNode(child));
+  }
+  value.Set("type", "folder");
+  value.Set("id", folder.id);
+  value.Set("title", base::UTF16ToUTF8(folder.title));
+  value.Set("collapsed", folder.collapsed);
+  value.Set("children", std::move(children));
+  return base::Value(std::move(value));
+}
+
+std::optional<PersistentNode> DecodeNode(const base::Value& value,
+                                         bool allow_folders,
+                                         std::set<std::string>* ids) {
+  const base::DictValue* dict = value.GetIfDict();
+  const std::string* type = dict ? dict->FindString("type") : nullptr;
+  const std::string* id = dict ? dict->FindString("id") : nullptr;
+  const std::string* title = dict ? dict->FindString("title") : nullptr;
+  if (!dict || !type || !id || id->empty() || !title ||
+      !ids->insert(*id).second) {
+    return std::nullopt;
+  }
+  if (*type == "link") {
+    if (dict->size() != 4u) {
+      return std::nullopt;
+    }
+    const std::string* spec = dict->FindString("url");
+    GURL url(spec ? *spec : std::string());
+    if (!url.is_valid() || url.is_empty() || url.spec() == "about:blank") {
+      return std::nullopt;
+    }
+    return PersistentNode{.data =
+                              PersistentLink{.id = *id,
+                                             .title = base::UTF8ToUTF16(*title),
+                                             .url = std::move(url)}};
+  }
+  if (*type != "folder" || !allow_folders || dict->size() != 5u) {
+    return std::nullopt;
+  }
+  std::optional<bool> collapsed = dict->FindBool("collapsed");
+  const base::ListValue* encoded = dict->FindList("children");
+  if (!collapsed || !encoded) {
+    return std::nullopt;
+  }
+  PersistentNodes children;
+  for (const base::Value& child_value : *encoded) {
+    auto child = DecodeNode(child_value, true, ids);
+    if (!child) {
+      return std::nullopt;
+    }
+    children.push_back(std::move(*child));
+  }
+  return PersistentNode{.data =
+                            PersistentFolder{.id = *id,
+                                             .title = base::UTF8ToUTF16(*title),
+                                             .collapsed = *collapsed,
+                                             .children = std::move(children)}};
+}
+
+template <typename Nodes>
+auto* FindLinkRecursive(Nodes& nodes, std::string_view id) {
+  for (auto& node : nodes) {
+    if (auto* link = std::get_if<PersistentLink>(&node.data)) {
+      if (link->id == id) {
+        return link;
+      }
+    } else if (auto* found = FindLinkRecursive(
+                   std::get<PersistentFolder>(node.data).children, id)) {
+      return found;
+    }
+  }
+  return static_cast<decltype(std::get_if<PersistentLink>(&nodes[0].data))>(
+      nullptr);
+}
+
+template <typename Nodes>
+auto* FindFolderRecursive(Nodes& nodes, std::string_view id) {
+  for (auto& node : nodes) {
+    auto* folder = std::get_if<PersistentFolder>(&node.data);
+    if (!folder) {
+      continue;
+    }
+    if (folder->id == id) {
+      return folder;
+    }
+    if (auto* found = FindFolderRecursive(folder->children, id)) {
+      return found;
+    }
+  }
+  return static_cast<decltype(std::get_if<PersistentFolder>(&nodes[0].data))>(
+      nullptr);
+}
+
+bool RemoveNodeRecursive(PersistentNodes& nodes, std::string_view id) {
+  for (auto it = nodes.begin(); it != nodes.end(); ++it) {
+    if (const auto* link = std::get_if<PersistentLink>(&it->data)) {
+      if (link->id == id) {
+        nodes.erase(it);
+        return true;
+      }
+      continue;
+    }
+    auto& folder = std::get<PersistentFolder>(it->data);
+    if (folder.id == id) {
+      nodes.erase(it);
+      return true;
+    }
+    if (RemoveNodeRecursive(folder.children, id)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+PersistentLiveCollection LiveCollectionForKind(PersistentRecordKind kind) {
+  return kind == PersistentRecordKind::kFavorite
+             ? PersistentLiveCollection::kPinnedGrid
+             : PersistentLiveCollection::kPinList;
+}
+
+bool ShouldOpenAnchoredNavigationInLittleArc(
+    PersistentNavigationDisposition disposition,
+    bool is_link_transition,
+    bool is_anchored_live_item,
+    const GURL& home_url,
+    const GURL& target_url) {
+  if (disposition != PersistentNavigationDisposition::kCurrentTab ||
+      !is_link_transition || !is_anchored_live_item || !target_url.is_valid() ||
+      !home_url.is_valid()) {
+    return false;
+  }
+  return target_url.GetWithoutRef() != home_url.GetWithoutRef();
+}
+
+std::vector<PersistentGridChild> PackPersistentGridChildren(
+    const std::vector<PersistentGridSlot>& slots) {
+  std::vector<PersistentGridChild> children;
+  children.reserve(slots.size() * 2);
+  for (const PersistentGridSlot& slot : slots) {
+    children.push_back({.id = slot.id,
+                        .kind = slot.live
+                                    ? PersistentGridChildKind::kLiveTab
+                                    : PersistentGridChildKind::kHomeTile});
+  }
+  for (const PersistentGridSlot& slot : slots) {
+    if (slot.live) {
+      children.push_back(
+          {.id = slot.id, .kind = PersistentGridChildKind::kHomeTile});
+    }
+  }
+  return children;
+}
+
+base::ListValue PersistentItemCodec::Encode(const PersistentNodes& nodes) {
+  base::ListValue values;
+  for (const PersistentNode& node : nodes) {
+    values.Append(EncodeNode(node));
+  }
+  return values;
+}
+
+std::optional<PersistentNodes> PersistentItemCodec::Decode(
+    const base::ListValue& values,
+    bool allow_folders) {
+  PersistentNodes nodes;
+  std::set<std::string> ids;
+  for (const base::Value& value : values) {
+    auto node = DecodeNode(value, allow_folders, &ids);
+    if (!node) {
+      return std::nullopt;
+    }
+    nodes.push_back(std::move(*node));
+  }
+  return nodes;
+}
+
+const PersistentLink* PersistentItemCodec::FindLink(
+    const PersistentNodes& nodes,
+    std::string_view id) {
+  return FindLinkRecursive(nodes, id);
+}
+
+PersistentLink* PersistentItemCodec::FindLink(PersistentNodes& nodes,
+                                              std::string_view id) {
+  return FindLinkRecursive(nodes, id);
+}
+
+const PersistentFolder* PersistentItemCodec::FindFolder(
+    const PersistentNodes& nodes,
+    std::string_view id) {
+  return FindFolderRecursive(nodes, id);
+}
+
+PersistentFolder* PersistentItemCodec::FindFolder(PersistentNodes& nodes,
+                                                  std::string_view id) {
+  return FindFolderRecursive(nodes, id);
+}
+
+bool PersistentItemCodec::UpdateLinkHome(PersistentNodes& nodes,
+                                         std::string_view id,
+                                         GURL url,
+                                         std::u16string title) {
+  PersistentLink* link = FindLink(nodes, id);
+  if (!link || !url.is_valid() || url.is_empty() ||
+      url.spec() == "about:blank") {
+    return false;
+  }
+  link->url = std::move(url);
+  link->title = std::move(title);
+  return true;
+}
+
+bool PersistentItemCodec::RemoveNode(PersistentNodes& nodes,
+                                     std::string_view id) {
+  return RemoveNodeRecursive(nodes, id);
+}
+
+bool PersistentItemLifecycle::AddDormant(std::string id) {
+  return !id.empty() && entries_.try_emplace(std::move(id), Entry()).second;
+}
+
+bool PersistentItemLifecycle::Forget(std::string_view id) {
+  auto found = entries_.find(id);
+  if (found == entries_.end()) {
+    return false;
+  }
+  if (found->second.live_tab) {
+    items_by_live_tab_.erase(*found->second.live_tab);
+  }
+  entries_.erase(found);
+  return true;
+}
+
+void PersistentItemLifecycle::RetainOnly(const std::set<std::string>& ids) {
+  for (auto it = entries_.begin(); it != entries_.end();) {
+    if (ids.contains(it->first)) {
+      ++it;
+      continue;
+    }
+    if (it->second.live_tab) {
+      items_by_live_tab_.erase(*it->second.live_tab);
+    }
+    it = entries_.erase(it);
+  }
+}
+
+PersistentItemLifecycle::ActivationDecision
+PersistentItemLifecycle::BeginActivation(std::string_view id) {
+  auto found = entries_.find(id);
+  if (found == entries_.end()) {
+    return {};
+  }
+  if (found->second.state == State::kDormant) {
+    found->second.state = State::kMaterializing;
+    return {.action = ActivationAction::kMaterialize};
+  }
+  if (found->second.state == State::kLive) {
+    return {.action = ActivationAction::kActivateExisting,
+            .live_tab = found->second.live_tab};
+  }
+  return {.action = ActivationAction::kWaitForTransition};
+}
+
+bool PersistentItemLifecycle::DidMaterialize(std::string_view id,
+                                             LiveTabToken token) {
+  auto found = entries_.find(id);
+  if (found == entries_.end() || found->second.state != State::kMaterializing ||
+      items_by_live_tab_.contains(token)) {
+    return false;
+  }
+  found->second = {.state = State::kLive, .live_tab = token};
+  items_by_live_tab_.emplace(token, found->first);
+  return true;
+}
+
+bool PersistentItemLifecycle::CancelMaterialization(std::string_view id) {
+  auto found = entries_.find(id);
+  if (found == entries_.end() || found->second.state != State::kMaterializing) {
+    return false;
+  }
+  found->second.state = State::kDormant;
+  return true;
+}
+
+bool PersistentItemLifecycle::RestoreLive(std::string_view id,
+                                          LiveTabToken token) {
+  auto found = entries_.find(id);
+  if (found == entries_.end() || found->second.state != State::kDormant ||
+      items_by_live_tab_.contains(token)) {
+    return false;
+  }
+  found->second = {.state = State::kLive, .live_tab = token};
+  items_by_live_tab_.emplace(token, found->first);
+  return true;
+}
+
+std::optional<std::string> PersistentItemLifecycle::BeginClose(
+    LiveTabToken token) {
+  auto reverse = items_by_live_tab_.find(token);
+  if (reverse == items_by_live_tab_.end()) {
+    return std::nullopt;
+  }
+  auto found = entries_.find(reverse->second);
+  if (found == entries_.end() || found->second.state != State::kLive) {
+    return std::nullopt;
+  }
+  found->second.state = State::kClosing;
+  return found->first;
+}
+
+bool PersistentItemLifecycle::CompleteClose(LiveTabToken token) {
+  auto reverse = items_by_live_tab_.find(token);
+  if (reverse == items_by_live_tab_.end()) {
+    return false;
+  }
+  auto found = entries_.find(reverse->second);
+  if (found == entries_.end() || found->second.state != State::kClosing) {
+    return false;
+  }
+  found->second = {};
+  items_by_live_tab_.erase(reverse);
+  return true;
+}
+
+std::optional<PersistentItemLifecycle::State> PersistentItemLifecycle::GetState(
+    std::string_view id) const {
+  auto found = entries_.find(id);
+  return found == entries_.end() ? std::nullopt
+                                 : std::optional(found->second.state);
+}
+
+std::optional<PersistentItemLifecycle::LiveTabToken>
+PersistentItemLifecycle::GetLiveTab(std::string_view id) const {
+  auto found = entries_.find(id);
+  return found == entries_.end() ? std::nullopt : found->second.live_tab;
+}
+
+std::optional<std::string_view> PersistentItemLifecycle::GetItemForLiveTab(
+    LiveTabToken token) const {
+  auto found = items_by_live_tab_.find(token);
+  return found == items_by_live_tab_.end()
+             ? std::nullopt
+             : std::optional<std::string_view>(found->second);
+}
+
+}  // namespace helium
