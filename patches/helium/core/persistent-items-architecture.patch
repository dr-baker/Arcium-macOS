 void ProfileWriter::AddFavicons(
     const favicon_base::FaviconUsageDataList& favicons) {
+  if (importer_type_ == user_data_importer::TYPE_ARC) {
+    // SetImportedFavicons intentionally drops mappings for page URLs that do
+    // not yet exist in the target History database. Virtual Favorites and
+    // Pins have no bookmark or visit row by design, so establish zero-visit
+    // rows before the queued favicon import. Both operations use the same
+    // HistoryService sequence, preserving their order without importing Arc
+    // browsing history.
+    history::HistoryService* history_service =
+        HistoryServiceFactory::GetForProfile(
+            profile_, ServiceAccessType::EXPLICIT_ACCESS);
+    if (history_service) {
+      std::set<GURL> imported_page_urls;
+      for (const auto& favicon : favicons) {
+        imported_page_urls.insert(favicon.urls.begin(), favicon.urls.end());
+      }
+      for (const GURL& url : imported_page_urls) {
+        history_service->AddPageNoVisitForBookmark(url, std::u16string());
+      }
+    }
+  }
   FaviconServiceFactory::GetForProfile(profile_,
                                        ServiceAccessType::EXPLICIT_ACCESS)
       ->SetImportedFavicons(favicons);
