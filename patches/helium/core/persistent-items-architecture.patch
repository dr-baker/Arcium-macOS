+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_ANCHORED_NAVIGATION_THROTTLE_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_ANCHORED_NAVIGATION_THROTTLE_H_
+
+#include "base/functional/callback.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "url/gurl.h"
+
+class Profile;
+
+namespace content {
+class NavigationThrottleRegistry;
+class WebContents;
+}  // namespace content
+
+namespace helium {
+
+// Intercepts renderer-initiated primary-main-frame link navigations that would
+// take a live Favorite/Pin away from its stored home. Those destinations open
+// in Helium Little Arc; the original same-tab navigation is ignored only after
+// the popup is created. chrome::Navigate never sees ordinary same-tab renderer
+// link clicks, so this throttle is the ownership point for that path.
+class HeliumAnchoredNavigationThrottle : public content::NavigationThrottle {
+ public:
+  using ResolveAnchoredHomeCallback = base::RepeatingCallback<
+      bool(content::WebContents* contents, GURL* home_url, Profile** profile)>;
+  using OpenLittleArcCallback =
+      base::RepeatingCallback<bool(Profile* profile, const GURL& url)>;
+
+  struct Dependencies {
+    ResolveAnchoredHomeCallback resolve_anchored_home;
+    OpenLittleArcCallback open_little_arc;
+  };
+
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+  static Dependencies ProductionDependencies();
+
+  HeliumAnchoredNavigationThrottle(
+      content::NavigationThrottleRegistry& registry,
+      Dependencies dependencies);
+  HeliumAnchoredNavigationThrottle(const HeliumAnchoredNavigationThrottle&) =
+      delete;
+  HeliumAnchoredNavigationThrottle& operator=(
+      const HeliumAnchoredNavigationThrottle&) = delete;
+  ~HeliumAnchoredNavigationThrottle() override;
+
+  ThrottleCheckResult WillStartRequest() override;
+  ThrottleCheckResult WillRedirectRequest() override;
+  const char* GetNameForLogging() override;
+
+ private:
+  ThrottleCheckResult MaybeDivert();
+  bool IsOrdinaryCurrentTabLinkNavigation() const;
+
+  Dependencies dependencies_;
+  bool diverted_ = false;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_ANCHORED_NAVIGATION_THROTTLE_H_
