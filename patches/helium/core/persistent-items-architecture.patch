+void ImportDataHandler::CompleteImport(bool did_succeed) {
+  if (importing_arc_sidebars_) {
+    VLOG(1) << "Arc sidebar batch item completed; index="
+            << arc_sidebar_import_index_ << "; success=" << did_succeed;
+    arc_sidebar_batch_did_succeed_ &= did_succeed;
+    ++arc_sidebar_import_index_;
+    if (arc_sidebar_import_index_ < arc_sidebar_import_queue_.size()) {
+      StartNextArcSidebarImport();
+      return;
+    }
+
+    importing_arc_sidebars_ = false;
+    arc_sidebar_import_queue_.clear();
+    arc_sidebar_import_index_ = 0;
+    FireWebUIListener(
+        "import-data-status-changed",
+        base::Value(arc_sidebar_batch_did_succeed_ ? kImportStatusSucceeded
+                                                   : kImportStatusFailed));
+    return;
+  }
+
+  FireWebUIListener(
+      "import-data-status-changed",
+      base::Value(did_succeed ? kImportStatusSucceeded : kImportStatusFailed));
 }
 
