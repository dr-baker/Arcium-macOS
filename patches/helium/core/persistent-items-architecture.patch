+
+class Profile;
+class TabIcon;
+class TabStyle;
+class TabTitle;
+
+namespace favicon_base {
+struct FaviconImageResult;
+struct FaviconRawBitmapResult;
+}  // namespace favicon_base
+
+namespace views {
+class MenuRunner;
+}  // namespace views
+
+// Commands for the dedicated dormant Favorite/Pin menu. Live items use the
+// ordinary tab menu instead.
+enum class PersistentItemMenuCommand {
+  kOpen = 1,
+  kRemove = 2,
+};
+
+enum class PersistentFaviconState {
+  kPlaceholder,
+  kResolved,
+  kGenerated,
+};
+
+bool ShouldApplyGeneratedFavicon(PersistentFaviconState state);
+
+void AppendDormantPersistentItemMenuItems(ui::SimpleMenuModel* model);
+
+// A durable Favorite or Pin presented with the same visual vocabulary as a
+// vertical tab. This view intentionally has no TabInterface or WebContents;
+// pressing it delegates materialization to HeliumSpaceService.
+class PersistentTabView : public views::Button,
+                          public views::ContextMenuController,
+                          public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(PersistentTabView, views::Button)
+
+ public:
+  enum class PresentationMode {
+    kCompactGrid,
+    kFullRow,
+  };
+
+  PersistentTabView(Profile* profile,
+                    std::string stable_id,
+                    std::u16string title,
+                    GURL url,
+                    PresentationMode presentation_mode,
+                    PressedCallback callback,
+                    base::RepeatingClosure remove_callback);
+  PersistentTabView(const PersistentTabView&) = delete;
+  PersistentTabView& operator=(const PersistentTabView&) = delete;
+  ~PersistentTabView() override;
+
+  const std::string& stable_id() const { return stable_id_; }
+  const GURL& url() const { return url_; }
+  bool selected() const { return selected_; }
+  PresentationMode presentation_mode() const { return presentation_mode_; }
+  bool using_generated_favicon_for_testing() const {
+    return favicon_state_ == PersistentFaviconState::kGenerated;
+  }
+  PersistentFaviconState favicon_state_for_testing() const {
+    return favicon_state_;
+  }
+  void SetResolvedFaviconStateForTesting();
+  void ApplyGeneratedFaviconForTesting();
+  bool title_visible_for_testing() const;
+
+  // Reconciles presentation state without replacing the view, preserving
+  // input/focus state while the persistent model changes around it.
+  void Update(std::u16string title, const GURL& url, bool selected);
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  // views::View:
+  void Layout(PassKey) override;
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+  void OnThemeChanged() override;
+
+  // views::Button:
+  void PaintButtonContents(gfx::Canvas* canvas) override;
+  void StateChanged(ButtonState old_state) override;
+
+  void SetSelected(bool selected);
+  void UpdateColors();
+  void LoadFavicon();
+  void OnExactFaviconAvailable(
+      const GURL& requested_url,
+      const favicon_base::FaviconImageResult& image_result);
+  void LoadHostFallbackFavicon(const GURL& requested_url);
+  void ApplyMonogramFavicon();
+  void SetFavicon(const ui::ImageModel& favicon_model,
+                  PersistentFaviconState state);
+  void OnFaviconAvailable(
+      const GURL& requested_url,
+      const favicon_base::FaviconRawBitmapResult& bitmap_result);
+  void OnFaviconsChanged(const std::set<GURL>& page_urls, const GURL&);
+  bool IsFrameActive() const;
+  void ActivateFromMenu();
+
+  const raw_ptr<Profile> profile_;
+  const std::string stable_id_;
+  const PresentationMode presentation_mode_;
+  const raw_ptr<const TabStyle> tab_style_;
+  const raw_ptr<TabIcon> icon_;
+  const raw_ptr<TabTitle> title_;
+  base::RepeatingClosure remove_callback_;
+
+  GURL url_;
+  bool selected_ = false;
+  PersistentFaviconState favicon_state_ = PersistentFaviconState::kPlaceholder;
+  std::unique_ptr<ui::SimpleMenuModel> context_menu_model_;
+  std::unique_ptr<views::MenuRunner> context_menu_runner_;
+  base::CancelableTaskTracker favicon_task_tracker_;
+  base::CallbackListSubscription favicons_changed_subscription_;
+  base::CallbackListSubscription paint_as_active_subscription_;
+  base::WeakPtrFactory<PersistentTabView> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_PERSISTENT_TAB_VIEW_H_
