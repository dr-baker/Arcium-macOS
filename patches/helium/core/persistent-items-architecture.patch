+bool HeliumSpaceService::RestorePersistentItemFromSession(
+    tabs::TabInterface* tab,
+    const std::map<std::string, std::string>& extra_data) {
+  const auto found = extra_data.find(kHeliumPersistentItemTabExtraDataKey);
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (!tab || found == extra_data.end() ||
+      !IsItemKeyVisibleInBrowser(browser, found->second) ||
+      !lifecycle_.GetState(found->second)) {
+    return false;
+  }
+  if (lifecycle_.GetState(found->second) !=
+      PersistentItemLifecycle::State::kDormant) {
+    return false;
+  }
+  PersistentRecordKind kind;
+  std::string id;
+  if (!ParseItemKey(found->second, &kind, &id) ||
+      !AssociateLiveTab(found->second, kind, id, tab)) {
+    return false;
+  }
+  NotifyItemsChanged();
+  return true;
+}
+
+bool HeliumSpaceService::RestoreLegacyFavoriteFromSession(
+    tabs::TabInterface* tab) {
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Browser* browser = window ? window->GetBrowserForMigrationOnly() : nullptr;
+  if (!browser || IsPersistentItemTab(tab)) {
+    return false;
+  }
+  const GURL restored_url = tab->GetContents()->GetLastCommittedURL();
+  std::optional<PersistentLink> match;
+  const PersistentNodes favorites = GetFavoritesForBrowser(browser);
+  for (const PersistentNode& node : favorites) {
+    const auto* link = std::get_if<PersistentLink>(&node.data);
+    if (!link || link->url != restored_url) {
+      continue;
+    }
+    if (match) {
+      return false;
+    }
+    match = *link;
+  }
+  if (!match) {
+    return false;
+  }
+  const std::string key =
+      ItemKey(browser, PersistentRecordKind::kFavorite, match->id);
+  if (lifecycle_.GetState(key) != PersistentItemLifecycle::State::kDormant ||
+      !AssociateLiveTab(key, PersistentRecordKind::kFavorite, match->id, tab)) {
+    return false;
+  }
+  NotifyItemsChanged();
+  return true;
 }
 
