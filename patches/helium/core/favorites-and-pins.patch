+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_PIN_TAB_CODEC_H_
+#define CHROME_BROWSER_UI_TABS_PIN_TAB_CODEC_H_
+
+#include "chrome/browser/ui/startup/startup_tab.h"
+
+class Profile;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+// Persists Helium pins, nested folders, and home metadata
+// per profile. Pref shape is a recursive list of tab/folder nodes.
+class PinTabCodec {
+ public:
+  PinTabCodec(const PinTabCodec&) = delete;
+  PinTabCodec& operator=(const PinTabCodec&) = delete;
+
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+  static void WritePins(Profile* profile);
+  static void WritePins(Profile* profile, const StartupTabs& tabs);
+  // Depth-first flatten of the tree; folder ancestry is on each StartupTab.
+  static StartupTabs ReadPins(Profile* profile);
+
+ private:
+  PinTabCodec();
+  ~PinTabCodec();
+};
+
+#endif  // CHROME_BROWSER_UI_TABS_PIN_TAB_CODEC_H_
