+
+bool TabStripCollection::IsPinTab(const TabInterface* tab) const {
+  if (!tab) {
+    return false;
+  }
+  const TabCollection* ancestor = tab->GetParentCollection();
+  while (ancestor) {
+    if (ancestor == pin_collection_) {
+      return true;
+    }
+    if (ancestor == pinned_collection_ || ancestor == unpinned_collection_ ||
+        ancestor == this) {
+      return false;
+    }
+    ancestor = ancestor->GetParentCollection();
+  }
+  return false;
+}
+
+size_t TabStripCollection::MoveTabToPin(TabInterface* tab,
+                                               size_t direct_index) {
+  CHECK(tab);
+  const size_t dst_direct =
+      std::min(direct_index, pin_collection_->ChildCount());
+  TabCollection::Position position{pin_collection_->GetHandle(),
+                                   dst_direct};
+  MoveTabImpl(tab, position);
+  return GetIndexOfTabRecursive(tab).value();
+}
+
+size_t TabStripCollection::MoveTabFromPin(TabInterface* tab) {
+  CHECK(tab);
+  CHECK(IsPinTab(tab));
+  TabCollection::Position position{unpinned_collection_->GetHandle(), 0};
+  MoveTabImpl(tab, position);
+  return GetIndexOfTabRecursive(tab).value();
+}
+
+FolderTabCollection* TabStripCollection::CreatePinFolder(
+    std::u16string title,
+    size_t direct_index) {
+  const size_t dst_direct =
+      std::min(direct_index, pin_collection_->ChildCount());
+  auto folder = std::make_unique<FolderTabCollection>(std::move(title));
+  FolderTabCollection* folder_ptr = folder.get();
+  AddTabCollectionImpl(
+      std::move(folder),
+      TabCollection::Position{pin_collection_->GetHandle(), dst_direct});
+  return folder_ptr;
+}
+
+FolderTabCollection* TabStripCollection::FindOrCreateFolder(
+    TabCollection* parent,
+    const std::u16string& title,
+    bool collapsed) {
+  CHECK(parent);
+  CHECK(parent == pin_collection_ ||
+        parent->type() == TabCollection::Type::FOLDER);
+
+  for (const auto& child : parent->GetChildren()) {
+    if (!std::holds_alternative<std::unique_ptr<TabCollection>>(child)) {
+      continue;
+    }
+    TabCollection* child_collection =
+        std::get<std::unique_ptr<TabCollection>>(child).get();
+    if (child_collection->type() != TabCollection::Type::FOLDER) {
+      continue;
+    }
+    auto* folder = static_cast<FolderTabCollection*>(child_collection);
+    if (folder->title() == title) {
+      folder->SetCollapsed(collapsed);
+      return folder;
+    }
+  }
+
+  auto folder = std::make_unique<FolderTabCollection>(title);
+  folder->SetCollapsed(collapsed);
+  FolderTabCollection* folder_ptr = folder.get();
+  AddTabCollectionImpl(
+      std::move(folder),
+      TabCollection::Position{parent->GetHandle(), parent->ChildCount()});
+  return folder_ptr;
+}
+
+size_t TabStripCollection::MoveTabToCollection(TabInterface* tab,
+                                               TabCollection* parent,
+                                               size_t direct_index) {
+  CHECK(tab);
+  CHECK(parent);
+  CHECK(parent == pin_collection_ ||
+        parent->type() == TabCollection::Type::FOLDER);
+  const size_t dst_direct = direct_index == SIZE_MAX
+                                ? parent->ChildCount()
+                                : std::min(direct_index, parent->ChildCount());
+  TabCollection::Position position{parent->GetHandle(), dst_direct};
+  MoveTabImpl(tab, position);
+  return GetIndexOfTabRecursive(tab).value();
+}
