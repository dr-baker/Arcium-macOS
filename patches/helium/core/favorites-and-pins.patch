+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/pin_tab_codec.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/helium/helium_favorites_and_pins.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/pref_names.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/pin_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_strip_collection.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+constexpr char kType[] = "type";
+constexpr char kTypeTab[] = "tab";
+constexpr char kTypeFolder[] = "folder";
+constexpr char kURL[] = "url";
+constexpr char kTitle[] = "title";
+constexpr char kCollapsed[] = "collapsed";
+constexpr char kChildren[] = "children";
+
+base::DictValue EncodeTabNode(const GURL& url, const std::u16string& title) {
+  base::DictValue dict;
+  dict.Set(kType, kTypeTab);
+  dict.Set(kURL, url.spec());
+  if (!title.empty()) {
+    dict.Set(kTitle, base::UTF16ToUTF8(title));
+  }
+  return dict;
+}
+
+void EncodeTabInterface(tabs::TabInterface* tab, base::ListValue& out) {
+  GURL url;
+  std::u16string title;
+  if (!helium::GetAnchoredPinnedTabHome(tab, &url, &title)) {
+    content::NavigationEntry* entry =
+        tab->GetContents()->GetController().GetLastCommittedEntry();
+    if (!entry) {
+      return;
+    }
+    url = entry->GetURL();
+    title = entry->GetTitleForDisplay();
+  }
+  out.Append(EncodeTabNode(url, title));
+}
+
+void EncodeCollectionChildren(const tabs::TabCollection* collection,
+                              base::ListValue& out);
+
+void EncodeFolderNode(const tabs::FolderTabCollection* folder,
+                      base::ListValue& out) {
+  base::DictValue dict;
+  dict.Set(kType, kTypeFolder);
+  dict.Set(kTitle, base::UTF16ToUTF8(folder->title()));
+  dict.Set(kCollapsed, folder->collapsed());
+  base::ListValue children;
+  EncodeCollectionChildren(folder, children);
+  dict.Set(kChildren, std::move(children));
+  out.Append(std::move(dict));
+}
+
+void EncodeCollectionChildren(const tabs::TabCollection* collection,
+                              base::ListValue& out) {
+  for (const auto& child : collection->GetChildren()) {
+    if (std::holds_alternative<std::unique_ptr<tabs::TabInterface>>(child)) {
+      EncodeTabInterface(
+          std::get<std::unique_ptr<tabs::TabInterface>>(child).get(), out);
+      continue;
+    }
+    tabs::TabCollection* child_collection =
+        std::get<std::unique_ptr<tabs::TabCollection>>(child).get();
+    if (child_collection->type() == tabs::TabCollection::Type::FOLDER) {
+      EncodeFolderNode(
+          static_cast<const tabs::FolderTabCollection*>(child_collection),
+          out);
+    } else if (child_collection->type() == tabs::TabCollection::Type::SPLIT) {
+      // Persist split members as ordinary pins.
+      EncodeCollectionChildren(child_collection, out);
+    }
+  }
+}
+
+void EncodePinTree(BrowserWindowInterface* browser,
+                          base::ListValue& serialized) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  auto* strip = static_cast<tabs::TabStripCollection*>(
+      const_cast<tabs::TabCollection*>(model->Root()));
+  if (!strip || !strip->pin_collection()) {
+    return;
+  }
+  EncodeCollectionChildren(strip->pin_collection(), serialized);
+}
+
+void DecodeTreeList(
+    const base::ListValue& list,
+    const std::vector<StartupTab::FolderPathSegment>& ancestors,
+    StartupTabs* results);
+
+void DecodeNode(const base::DictValue& value,
+                const std::vector<StartupTab::FolderPathSegment>& ancestors,
+                StartupTabs* results) {
+  const std::string* type = value.FindString(kType);
+  const bool is_folder =
+      (type && *type == kTypeFolder) || value.FindList(kChildren);
+
+  if (is_folder) {
+    const std::string* title = value.FindString(kTitle);
+    if (!title) {
+      return;
+    }
+    std::vector<StartupTab::FolderPathSegment> nested = ancestors;
+    nested.push_back(StartupTab::FolderPathSegment{
+        .title = base::UTF8ToUTF16(*title),
+        .collapsed = value.FindBool(kCollapsed).value_or(false),
+    });
+    if (const base::ListValue* children = value.FindList(kChildren)) {
+      DecodeTreeList(*children, nested, results);
+    }
+    return;
+  }
+
+  // Tab node — also accepts legacy flat {url, title} without type.
+  const std::string* url_string = value.FindString(kURL);
+  if (!url_string) {
+    return;
+  }
+  StartupTab tab(GURL(*url_string), StartupTab::Type::kPin);
+  tab.helium_has_home = true;
+  if (const std::string* title = value.FindString(kTitle)) {
+    tab.helium_home_title = base::UTF8ToUTF16(*title);
+  }
+  tab.helium_folder_path = ancestors;
+  results->push_back(std::move(tab));
+}
+
+void DecodeTreeList(
+    const base::ListValue& list,
+    const std::vector<StartupTab::FolderPathSegment>& ancestors,
+    StartupTabs* results) {
+  for (const auto& entry : list) {
+    if (!entry.is_dict()) {
+      continue;
+    }
+    DecodeNode(entry.GetDict(), ancestors, results);
+  }
+}
+
+}  // namespace
+
+// static
+void PinTabCodec::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterListPref(prefs::kHeliumPins);
+}
+
+// static
+void PinTabCodec::WritePins(Profile* profile) {
+  PrefService* prefs = profile->GetPrefs();
+  if (!prefs || profile->IsOffTheRecord() || profile->IsGuestSession()) {
+    return;
+  }
+
+  base::ListValue values;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [profile, &values](BrowserWindowInterface* browser) {
+        if (browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            browser->GetProfile() == profile) {
+          EncodePinTree(browser, values);
+        }
+        return true;
+      });
+  prefs->SetList(prefs::kHeliumPins, std::move(values));
+}
+
+// static
+void PinTabCodec::WritePins(Profile* profile,
+                                             const StartupTabs& tabs) {
+  PrefService* prefs = profile->GetPrefs();
+  if (!prefs) {
+    return;
+  }
+  // Rebuild a tree from flat tabs that carry folder paths.
+  base::ListValue root;
+  for (const auto& tab : tabs) {
+    base::ListValue* target = &root;
+    for (const auto& segment : tab.helium_folder_path) {
+      base::DictValue* folder_dict = nullptr;
+      for (auto& entry : *target) {
+        if (!entry.is_dict()) {
+          continue;
+        }
+        base::DictValue& dict = entry.GetDict();
+        const std::string* type = dict.FindString(kType);
+        const std::string* title = dict.FindString(kTitle);
+        if (type && *type == kTypeFolder && title &&
+            base::UTF8ToUTF16(*title) == segment.title) {
+          folder_dict = &dict;
+          break;
+        }
+      }
+      if (!folder_dict) {
+        base::DictValue dict;
+        dict.Set(kType, kTypeFolder);
+        dict.Set(kTitle, base::UTF16ToUTF8(segment.title));
+        dict.Set(kCollapsed, segment.collapsed);
+        dict.Set(kChildren, base::ListValue());
+        target->Append(std::move(dict));
+        folder_dict = &target->back().GetDict();
+      }
+      target = folder_dict->FindList(kChildren);
+      CHECK(target);
+    }
+    target->Append(
+        EncodeTabNode(tab.url, tab.helium_home_title));
+  }
+
+  prefs->SetList(prefs::kHeliumPins, std::move(root));
+}
+
+// static
+StartupTabs PinTabCodec::ReadPins(Profile* profile) {
+  PrefService* prefs = profile->GetPrefs();
+  if (!prefs) {
+    return {};
+  }
+  StartupTabs results;
+  DecodeTreeList(prefs->GetList(prefs::kHeliumPins), {}, &results);
+  return results;
+}
