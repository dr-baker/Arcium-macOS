   }
@@ -13,5 +97,71 @@ int GetSystemWindowRadius() {
 
 gfx::RoundedCornersF GetFrameRadiiForView(const views::View* view,
                                           int fallback_inset) {
-  return gfx::RoundedCornersF(GetFrameRadiusForContentInset(fallback_inset));
+  const auto fallback =
+      gfx::RoundedCornersF(GetFrameRadiusForContentInset(fallback_inset));
+  const auto* widget = view ? view->GetWidget() : nullptr;
+  NSWindow* window =
+      widget ? widget->GetNativeWindow().GetNativeNSWindow() : nil;
+  if (!window || view->GetLocalBounds().IsEmpty()) {
+    return fallback;
+  }
+  const gfx::Rect bounds = view->GetBoundsInScreen();
+  // gfx screen coordinates have their origin at the main screen's top left;
+  // AppKit screen coordinates have their origin at its bottom left.
+  NSScreen* mainScreen = NSScreen.screens.firstObject;
+  const CGFloat screenTop = NSMaxY(mainScreen.frame);
+  const NSRect screenRect = NSMakeRect(bounds.x(), screenTop - bounds.bottom(),
+                                       bounds.width(), bounds.height());
+  const NSRect windowRect = [window convertRectFromScreen:screenRect];
+
+  if (@available(macOS 27, *)) {
+    if ([NSView instancesRespondToSelector:@selector(effectiveCornerRadii)] &&
+        [NSView instancesRespondToSelector:@selector
+                (invalidateCornerConfiguration)]) {
+      static char probeKey;
+      ArciumConcentricCornerProbe* probe =
+          objc_getAssociatedObject(window, &probeKey);
+      if (!probe) {
+        probe = [[ArciumConcentricCornerProbe alloc] initWithFrame:NSZeroRect];
+        objc_setAssociatedObject(window, &probeKey, probe,
+                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+      }
+      NSView* content = window.contentView;
+      if (probe.superview != content) {
+        [probe removeFromSuperview];
+        [content addSubview:probe];
+      }
+      probe.frame = [content convertRect:windowRect fromView:nil];
+      id<ArciumCornerResolution> resolver = (id<ArciumCornerResolution>)probe;
+      [resolver invalidateCornerConfiguration];
+      id<ArciumEffectiveCornerRadii> radii = [resolver effectiveCornerRadii];
+      if (radii && ValidRadius(radii.topLeft) && ValidRadius(radii.topRight) &&
+          ValidRadius(radii.bottomLeft) && ValidRadius(radii.bottomRight)) {
+        const CGFloat maximum =
+            std::min<CGFloat>(bounds.width(), bounds.height()) / 2;
+        return gfx::RoundedCornersF(std::min(radii.topLeft, maximum),
+                                    std::min(radii.topRight, maximum),
+                                    std::min(radii.bottomRight, maximum),
+                                    std::min(radii.bottomLeft, maximum));
+      }
+    }
+  }
+
+  BrowserNativeWidgetWindow* browserWindow =
+      base::apple::ObjCCast<BrowserNativeWidgetWindow>(window);
+  if (!browserWindow) {
+    return fallback;
+  }
+  const CGFloat radius = [browserWindow arciumWindowCornerRadius];
+  if (!ValidRadius(radius)) {
+    return fallback;
+  }
+  // Clamp a corrupt/custom policy to the window's possible radius. Read it on
+  // every layout, so changing native policy, zoom or fullscreen cannot stale
+  // it.
+  return RadiiForWindowRect(
+      window, windowRect,
+      std::min<CGFloat>(
+          radius,
+          std::min(window.frame.size.width, window.frame.size.height) / 2));
 }
