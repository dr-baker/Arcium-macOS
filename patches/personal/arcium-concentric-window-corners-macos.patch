+// Public macOS 27 APIs, dispatched through protocols so SDK 26 builds can use
+// them when running on 27. Signatures are from Apple's AppKit documentation:
+// NSViewCornerRadius/containerConcentric(_:), NSViewCornerConfiguration/
+// corners(radius:), and NSView/effectiveCornerRadii. No private selectors are
+// used by the 27 resolver and no new clipping layer is installed.
+@protocol ArciumCornerRadiusFactory
++ (id)containerConcentricRadiusWithMinimum:(CGFloat)minimumRadius;
+@end
+@protocol ArciumCornerConfigurationFactory
++ (id)configurationWithRadius:(id)radius;
+@end
+@protocol ArciumEffectiveCornerRadii
+@property(readonly) CGFloat topLeft;
+@property(readonly) CGFloat topRight;
+@property(readonly) CGFloat bottomLeft;
+@property(readonly) CGFloat bottomRight;
+@end
+@protocol ArciumCornerResolution
+- (id<ArciumEffectiveCornerRadii>)effectiveCornerRadii;
+- (void)invalidateCornerConfiguration;
+@end
+
+@class NSViewCornerConfiguration;
+
+@interface ArciumConcentricCornerProbe : NSView
+@end
+
+@implementation ArciumConcentricCornerProbe
+- (NSViewCornerConfiguration*)cornerConfiguration {
+  Class<ArciumCornerRadiusFactory> radiusClass =
+      NSClassFromString(@"NSViewCornerRadius");
+  Class<ArciumCornerConfigurationFactory> configurationClass =
+      NSClassFromString(@"NSViewCornerConfiguration");
+  if (![(id)radiusClass respondsToSelector:@selector
+                    (containerConcentricRadiusWithMinimum:)] ||
+      ![(id)configurationClass
+          respondsToSelector:@selector(configurationWithRadius:)]) {
+    return nil;
+  }
+  return [configurationClass
+      configurationWithRadius:[radiusClass
+                                  containerConcentricRadiusWithMinimum:0]];
+}
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+- (BOOL)isAccessibilityElement {
+  return NO;
+}
+@end
+
+namespace {
+
+bool ValidRadius(CGFloat radius) {
+  return std::isfinite(radius) && radius >= 0;
+}
+
+gfx::RoundedCornersF RadiiForWindowRect(NSWindow* window,
+                                        NSRect rect,
+                                        float radius) {
+  const NSSize size = window.frame.size;
+  return InsetFrameRadii(
+      gfx::RoundedCornersF(radius),
+      gfx::InsetsF::TLBR(std::max<CGFloat>(0, size.height - NSMaxY(rect)),
+                         std::max<CGFloat>(0, NSMinX(rect)),
+                         std::max<CGFloat>(0, NSMinY(rect)),
+                         std::max<CGFloat>(0, size.width - NSMaxX(rect))));
+}
+
+}  // namespace
+
 int GetSystemWindowRadius() {
+  // This legacy helper is used without a window by non-browser surfaces.
+  // Content uses the actual native window below, including custom policy.
   if (@available(macOS 26, *)) {
