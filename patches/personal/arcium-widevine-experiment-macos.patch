Index: src/chrome/browser/ui/cocoa/arcium_widevine_installer.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_widevine_installer.cc
@@ -0,0 +1,114 @@
+// Copyright 2026 The Arcium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/cocoa/arcium_widevine_installer.h"
+
+#include <stdio.h>
+
+#include "base/functional/bind.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "components/cdm/common/cdm_manifest.h"
+#include "components/prefs/pref_service.h"
+#include "components/update_client/activity_data_service.h"
+#include "components/update_client/persisted_data.h"
+#include "media/base/cdm_capability.h"
+#include "media/cdm/cdm_paths.h"
+
+namespace arcium_settings {
+namespace {
+
+base::FilePath LibraryPath(const base::FilePath& directory) {
+  return media::GetPlatformSpecificDirectory(directory)
+      .AppendASCII("libwidevinecdm.dylib");
+}
+
+bool SamePayload(const base::FilePath& source, const base::FilePath& other) {
+  return base::ContentsEqual(source.AppendASCII("manifest.json"),
+                             other.AppendASCII("manifest.json")) &&
+         base::ContentsEqual(LibraryPath(source), LibraryPath(other));
+}
+
+}  // namespace
+
+base::expected<base::Version, std::string> InstallWidevineFromChrome(
+    const base::FilePath& source,
+    const base::FilePath& component_root) {
+  // Settings for different profiles share the component directory.
+  static base::NoDestructor<base::Lock> install_lock;
+  base::AutoLock hold(*install_lock);
+
+  media::CdmCapability capability;
+  if (!ParseCdmManifestFromPath(source.AppendASCII("manifest.json"),
+                                &capability)) {
+    return base::unexpected(
+        "Chrome's Widevine module is missing or incompatible with Arcium. "
+        "Update Google Chrome, then try again.");
+  }
+  if (!base::PathExists(LibraryPath(source))) {
+    return base::unexpected(
+        "Chrome's Widevine module does not include a library for this Mac. "
+        "Install Google Chrome for this Mac, then try again.");
+  }
+
+  const auto destination =
+      component_root.AppendASCII(capability.version.GetString());
+  if (base::PathExists(destination)) {
+    if (SamePayload(source, destination)) {
+      return capability.version;
+    }
+    return base::unexpected(
+        "A different Widevine copy with this version is already installed. "
+        "Existing files were left unchanged.");
+  }
+  if (!base::CreateDirectory(component_root)) {
+    return base::unexpected("Arcium could not create its Widevine folder.");
+  }
+
+  base::ScopedTempDir staging;
+  if (!staging.CreateUniqueTempDirUnderPath(component_root)) {
+    return base::unexpected("Arcium could not prepare the Widevine copy.");
+  }
+  const auto payload = staging.GetPath().AppendASCII("payload");
+  if (!base::CopyDirectory(source, payload, true)) {
+    return base::unexpected(
+        "Arcium could not copy Widevine from Chrome. Check available disk "
+        "space and try again.");
+  }
+  // Do not publish a partial copy or one changed by a concurrent Chrome update.
+  media::CdmCapability staged_capability;
+  if (!ParseCdmManifestFromPath(payload.AppendASCII("manifest.json"),
+                                &staged_capability) ||
+      staged_capability.version != capability.version ||
+      !SamePayload(source, payload)) {
+    return base::unexpected(
+        "Chrome's Widevine files changed while copying. Try again after "
+        "Chrome finishes updating.");
+  }
+  // Both paths are on the same volume. Never fall back to a recursive copy or
+  // overwrite a version installed by another process while we were staging.
+  if (renamex_np(payload.value().c_str(), destination.value().c_str(),
+                 RENAME_EXCL) != 0 && !SamePayload(source, destination)) {
+    return base::unexpected("Arcium could not finish installing Widevine.");
+  }
+  return capability.version;
+}
+
+bool SelectInstalledWidevineVersion(PrefService* local_state,
+                                   const base::Version& version) {
+  if (!local_state || !version.IsValid() ||
+      !local_state->FindPreference(update_client::kPersistedDataPreference)) {
+    return false;
+  }
+  auto persisted = update_client::CreatePersistedData(
+      base::BindRepeating([](PrefService* prefs) { return prefs; }, local_state),
+      nullptr);
+  // Component ID derived from Widevine's public component signing key.
+  persisted->SetProductVersion("oimompecagnajdejgnnjijobebaeigek", version);
+  return true;
+}
+
+}  // namespace arcium_settings
