+// Copyright 2026 The Arcium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_COCOA_ARCIUM_WIDEVINE_INSTALLER_H_
+#define CHROME_BROWSER_UI_COCOA_ARCIUM_WIDEVINE_INSTALLER_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/types/expected.h"
+#include "base/version.h"
+
+class PrefService;
+
+namespace arcium_settings {
+
+// Copies a compatible, locally installed Chrome CDM into the browser's
+// WidevineCdm component root. Performs blocking I/O. Existing versions and
+// Chrome's source files are preserved. Registration happens on next launch.
+base::expected<base::Version, std::string> InstallWidevineFromChrome(
+    const base::FilePath& source,
+    const base::FilePath& component_root);
+
+// Selects the copied version for component registration on next launch.
+// Must run on the local-state preference sequence, even if Settings has closed.
+bool SelectInstalledWidevineVersion(PrefService* local_state,
+                                   const base::Version& version);
+
+}  // namespace arcium_settings
+
+#endif  // CHROME_BROWSER_UI_COCOA_ARCIUM_WIDEVINE_INSTALLER_H_
Index: src/chrome/browser/ui/cocoa/arcium_widevine_installer_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_widevine_installer_unittest.cc
@@ -0,0 +1,162 @@
+// Copyright 2026 The Arcium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/cocoa/arcium_widevine_installer.h"
+
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_file_value_serializer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "components/prefs/testing_pref_service.h"
+#include "components/update_client/persisted_data.h"
+#include "media/cdm/api/content_decryption_module.h"
+#include "media/cdm/cdm_paths.h"
+#include "media/cdm/supported_cdm_versions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace arcium_settings {
+namespace {
+
+class ArciumWidevineInstallerTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_.CreateUniqueTempDir());
+    source_ = temp_.GetPath().AppendASCII("ChromeWidevine");
+    components_ = temp_.GetPath().AppendASCII("ArciumWidevine");
+    ASSERT_TRUE(base::CreateDirectory(Library(source_).DirName()));
+    ASSERT_TRUE(base::WriteFile(Library(source_), "chrome-cdm-fixture"));
+    WriteManifest("1.2.3.4");
+  }
+
+  base::FilePath Library(const base::FilePath& root) {
+    return media::GetPlatformSpecificDirectory(root)
+        .AppendASCII("libwidevinecdm.dylib");
+  }
+
+  void WriteManifest(const std::string& version, bool compatible = true) {
+    static_assert(media::kSupportedCdmInterfaceVersions[0].enabled);
+    base::DictValue manifest;
+    manifest.Set("version", version);
+    manifest.Set("x-cdm-module-versions",
+                 base::NumberToString(CDM_MODULE_VERSION));
+    manifest.Set("x-cdm-interface-versions",
+                 base::NumberToString(compatible
+                     ? media::kSupportedCdmInterfaceVersions[0].version : 0));
+    manifest.Set("x-cdm-host-versions",
+                 base::NumberToString(media::kMinSupportedCdmHostVersion));
+    manifest.Set("x-cdm-codecs", "vp8,vp09,av01");
+    manifest.Set("x-cdm-persistent-license-support", false);
+    manifest.Set("x-cdm-supported-encryption-schemes",
+                 base::ListValue().Append("cenc").Append("cbcs"));
+    ASSERT_TRUE(JSONFileValueSerializer(source_.AppendASCII("manifest.json"))
+                    .Serialize(manifest));
+  }
+
+  base::ScopedTempDir temp_;
+  base::FilePath source_;
+  base::FilePath components_;
+};
+
+TEST_F(ArciumWidevineInstallerTest, CopiesCompleteVersionAndPreservesSource) {
+  ASSERT_TRUE(base::WriteFile(source_.AppendASCII("LICENSE"), "fixture-license"));
+  const auto result = InstallWidevineFromChrome(source_, components_);
+  ASSERT_TRUE(result.has_value()) << result.error();
+  EXPECT_EQ(result->GetString(), "1.2.3.4");
+  const auto installed = components_.AppendASCII("1.2.3.4");
+  EXPECT_TRUE(base::ContentsEqual(Library(source_), Library(installed)));
+  EXPECT_TRUE(base::ContentsEqual(source_.AppendASCII("manifest.json"),
+                                  installed.AppendASCII("manifest.json")));
+  EXPECT_TRUE(base::ContentsEqual(source_.AppendASCII("LICENSE"),
+                                  installed.AppendASCII("LICENSE")));
+  base::FileEnumerator folders(components_, false,
+                               base::FileEnumerator::DIRECTORIES);
+  EXPECT_EQ(folders.Next(), installed);
+  EXPECT_TRUE(folders.Next().empty());
+}
+
+TEST_F(ArciumWidevineInstallerTest, RepeatedInstallPreservesExistingFiles) {
+  ASSERT_TRUE(InstallWidevineFromChrome(source_, components_).has_value());
+  const auto marker = components_.AppendASCII("1.2.3.4").AppendASCII("keep-me");
+  ASSERT_TRUE(base::WriteFile(marker, "keep"));
+  EXPECT_TRUE(InstallWidevineFromChrome(source_, components_).has_value());
+  EXPECT_TRUE(base::PathExists(marker));
+}
+
+TEST_F(ArciumWidevineInstallerTest, RejectsIncompatibleModuleWithoutPublishing) {
+  WriteManifest("1.2.3.4", false);
+  EXPECT_FALSE(InstallWidevineFromChrome(source_, components_).has_value());
+  EXPECT_FALSE(base::PathExists(components_));
+}
+
+TEST_F(ArciumWidevineInstallerTest, RejectsPathTraversalVersion) {
+  WriteManifest("../escaped");
+  EXPECT_FALSE(InstallWidevineFromChrome(source_, components_).has_value());
+  EXPECT_FALSE(base::PathExists(temp_.GetPath().AppendASCII("escaped")));
+  EXPECT_FALSE(base::PathExists(components_));
+}
+
+TEST_F(ArciumWidevineInstallerTest, RejectsMissingArchitectureLibrary) {
+  ASSERT_TRUE(base::DeleteFile(Library(source_)));
+  EXPECT_FALSE(InstallWidevineFromChrome(source_, components_).has_value());
+  EXPECT_FALSE(base::PathExists(components_));
+}
+
+TEST_F(ArciumWidevineInstallerTest, RefusesToOverwriteDifferentExistingVersion) {
+  ASSERT_TRUE(InstallWidevineFromChrome(source_, components_).has_value());
+  ASSERT_TRUE(base::WriteFile(Library(source_), "changed-cdm-fixture"));
+  EXPECT_FALSE(InstallWidevineFromChrome(source_, components_).has_value());
+  std::string installed;
+  ASSERT_TRUE(base::ReadFileToString(
+      Library(components_.AppendASCII("1.2.3.4")), &installed));
+  EXPECT_EQ(installed, "chrome-cdm-fixture");
+}
+
+TEST_F(ArciumWidevineInstallerTest, KeepsOlderVersionsWhenInstallingNewVersion) {
+  ASSERT_TRUE(InstallWidevineFromChrome(source_, components_).has_value());
+  WriteManifest("2.3.4.5");
+  EXPECT_TRUE(InstallWidevineFromChrome(source_, components_).has_value());
+  EXPECT_TRUE(base::PathExists(Library(components_.AppendASCII("1.2.3.4"))));
+  EXPECT_TRUE(base::PathExists(Library(components_.AppendASCII("2.3.4.5"))));
+}
+
+TEST_F(ArciumWidevineInstallerTest, ReportsUnwritableComponentLocation) {
+  ASSERT_TRUE(base::WriteFile(components_, "file-instead-of-directory"));
+  EXPECT_FALSE(InstallWidevineFromChrome(source_, components_).has_value());
+  std::string original;
+  ASSERT_TRUE(base::ReadFileToString(components_, &original));
+  EXPECT_EQ(original, "file-instead-of-directory");
+}
+
+TEST(ArciumWidevineSelectionTest, SelectsCopiedVersionWithoutChangingOtherMetadata) {
+  TestingPrefServiceSimple local_state;
+  update_client::RegisterPersistedDataPrefs(local_state.registry());
+  base::DictValue data;
+  data.SetByDottedPath("apps.oimompecagnajdejgnnjijobebaeigek.pv", "0.1");
+  data.SetByDottedPath("apps.oimompecagnajdejgnnjijobebaeigek.cohort", "keep");
+  data.SetByDottedPath("apps.othercomponent.pv", "9.9");
+  local_state.SetDict(update_client::kPersistedDataPreference, std::move(data));
+  ASSERT_TRUE(SelectInstalledWidevineVersion(&local_state, base::Version("1.2.3.4")));
+  const auto& selected = local_state.GetDict(update_client::kPersistedDataPreference);
+  ASSERT_TRUE(selected.FindStringByDottedPath("apps.oimompecagnajdejgnnjijobebaeigek.pv"));
+  EXPECT_EQ(*selected.FindStringByDottedPath("apps.oimompecagnajdejgnnjijobebaeigek.pv"),
+            "1.2.3.4");
+  EXPECT_EQ(*selected.FindStringByDottedPath("apps.oimompecagnajdejgnnjijobebaeigek.cohort"),
+            "keep");
+  EXPECT_EQ(*selected.FindStringByDottedPath("apps.othercomponent.pv"), "9.9");
+}
+
+TEST(ArciumWidevineSelectionTest, RejectsUnavailablePreferencesAndInvalidVersion) {
+  TestingPrefServiceSimple local_state;
+  EXPECT_FALSE(SelectInstalledWidevineVersion(nullptr, base::Version("1.2.3.4")));
+  EXPECT_FALSE(SelectInstalledWidevineVersion(&local_state, base::Version("1.2.3.4")));
+  update_client::RegisterPersistedDataPrefs(local_state.registry());
+  EXPECT_FALSE(SelectInstalledWidevineVersion(&local_state, base::Version()));
+}
+
+}  // namespace
+}  // namespace arcium_settings
