+- (void)installWidevineFromChrome {
+  if (profile_destroying_ || !model_ || widevine_installing_ ||
+      !model_->profile()->IsRegularProfile() ||
+      model_->profile()->IsOffTheRecord()) {
+    return;
+  }
+  NSURL* chrome_url = [NSWorkspace.sharedWorkspace
+      URLForApplicationWithBundleIdentifier:@"com.google.Chrome"];
+  base::FilePath destination;
+  if (!chrome_url || !base::PathService::Get(
+                     chrome::DIR_COMPONENT_UPDATED_WIDEVINE_CDM, &destination)) {
+    [self presentAlertWithTitle:@"Couldn't install Widevine"
+                informativeText:chrome_url ? @"Arcium could not find its component folder."
+                                       : @"Install Google Chrome first, then try again."
+               firstButtonTitle:@"OK"
+              secondButtonTitle:nil
+                     completion:nil];
+    return;
+  }
+  NSURL* source_url = [chrome_url URLByAppendingPathComponent:
+      @"Contents/Frameworks/Google Chrome Framework.framework/Libraries/WidevineCdm"];
+  const base::FilePath source(source_url.fileSystemRepresentation);
+  widevine_installing_ = YES;
+  __weak ArciumSettingsWindowController* weak_self = self;
+  dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+    @autoreleasepool {
+      const auto result =
+          arcium_settings::InstallWidevineFromChrome(source, destination);
+      dispatch_async(dispatch_get_main_queue(), ^{
+        const bool selected = result.has_value() && g_browser_process &&
+            arcium_settings::SelectInstalledWidevineVersion(
+                g_browser_process->local_state(), *result);
+        ArciumSettingsWindowController* controller = weak_self;
+        if (!controller || controller->profile_destroying_ ||
+            controller->window_closing_) {
+          return;
+        }
+        controller->widevine_installing_ = NO;
+        NSString* message;
+        if (!result.has_value()) {
+          message = base::SysUTF8ToNSString(result.error());
+        } else if (!selected) {
+          message = @"Widevine was copied, but Arcium could not select it for "
+                     "the next launch. Try again before quitting.";
+        } else {
+          message = [NSString stringWithFormat:
+              @"Widevine %@ is installed. Quit and reopen Arcium, then try "
+               "Netflix or another streaming service. Playback is experimental.",
+              base::SysUTF8ToNSString(result->GetString())];
+        }
+        NSString* title = result.has_value() && selected
+                              ? @"Widevine installed"
+                              : @"Couldn't install Widevine";
+        [controller presentAlertWithTitle:title
+                          informativeText:message
+                         firstButtonTitle:@"OK"
+                        secondButtonTitle:nil
+                               completion:nil];
+      });
+    }
+  });
+}
