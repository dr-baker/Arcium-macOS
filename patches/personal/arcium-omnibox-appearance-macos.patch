+base::DictValue ArciumSettingsModel::GetCommandPanelLayout() const {
+  return prefs_ && HasPreference(arcium::kCommandPanelLayoutPref)
+             ? prefs_->GetDict(arcium::kCommandPanelLayoutPref).Clone()
+             : base::DictValue();
+}
+
+bool ArciumSettingsModel::SetCommandPanelLayout(const base::DictValue& layout) {
+  if (shutting_down_ || !prefs_ ||
+      !HasPreference(arcium::kCommandPanelLayoutPref) ||
+      !prefs_->IsUserModifiablePreference(arcium::kCommandPanelLayoutPref) ||
+      layout.size() != 7) {
+    return false;
+  }
+  for (const auto* key : {"labels", "icons", "scope_reveal"}) {
+    const auto value = layout.FindInt(key);
+    if (!value || *value < 0 ||
+        *value > (std::string_view(key) == "icons" ? 3 : 2)) {
+      return false;
+    }
+  }
+  for (const auto* key :
+       {"connected", "full_width", "scope_tints", "activity_dots"}) {
+    if (!layout.FindBool(key).has_value()) {
+      return false;
+    }
+  }
+  prefs_->SetDict(arcium::kCommandPanelLayoutPref, layout.Clone());
+  return true;
+}
