@@ -0,0 +1,65 @@
+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#ifndef CHROME_BROWSER_UI_COCOA_ARCIUM_COMMAND_PANEL_LAYOUT_MAC_H_
+#define CHROME_BROWSER_UI_COCOA_ARCIUM_COMMAND_PANEL_LAYOUT_MAC_H_
+
+#import <Foundation/Foundation.h>
+
+#include <cmath>
+#include <initializer_list>
+#include <optional>
+
+#include "base/values.h"
+
+namespace arcium_settings {
+
+// The shared palette bridge intentionally uses doubles. Command-bar enum
+// values and booleans have a different schema and must retain their types.
+inline std::optional<base::DictValue> CommandPanelLayoutFromNSObject(id value) {
+  if (![value isKindOfClass:[NSDictionary class]] || [value count] != 8) {
+    return std::nullopt;
+  }
+  NSDictionary* layout = value;
+  base::DictValue result;
+  constexpr struct {
+    const char* key;
+    int maximum;
+  } enums[] = {{"labels", 2}, {"icons", 3}, {"scope_reveal", 5}};
+  for (const auto& field : enums) {
+    id object = layout[[NSString stringWithUTF8String:field.key]];
+    if (![object isKindOfClass:[NSNumber class]] ||
+        CFGetTypeID((__bridge CFTypeRef)object) == CFBooleanGetTypeID()) {
+      return std::nullopt;
+    }
+    const double number = [object doubleValue];
+    if (!std::isfinite(number) || std::trunc(number) != number ||
+        number < 0 || number > field.maximum) {
+      return std::nullopt;
+    }
+    result.Set(field.key, static_cast<int>(number));
+  }
+  for (const char* key :
+       {"connected", "full_width", "scope_tints", "activity_dots"}) {
+    id object = layout[[NSString stringWithUTF8String:key]];
+    if (![object isKindOfClass:[NSNumber class]] ||
+        CFGetTypeID((__bridge CFTypeRef)object) != CFBooleanGetTypeID()) {
+      return std::nullopt;
+    }
+    result.Set(key, static_cast<bool>([object boolValue]));
+  }
+  id strength = layout[@"glow_strength"];
+  if (![strength isKindOfClass:[NSNumber class]] ||
+      CFGetTypeID((__bridge CFTypeRef)strength) == CFBooleanGetTypeID()) {
+    return std::nullopt;
+  }
+  const double number = [strength doubleValue];
+  if (!std::isfinite(number) || number < 0.0 || number > 2.0) {
+    return std::nullopt;
+  }
+  result.Set("glow_strength", number);
+  return result;
+}
+
+}  // namespace arcium_settings
+#endif  // CHROME_BROWSER_UI_COCOA_ARCIUM_COMMAND_PANEL_LAYOUT_MAC_H_
