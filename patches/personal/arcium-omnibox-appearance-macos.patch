+    @MainActor
+    func testCommandBarAppearanceUsesTypedProfileCallbackAndExternalSnapshot() {
+        let delegate = TestDelegate()
+        let store = ArciumSettingsStore(snapshot: ["available": true, "appearance": [
+            "commandBarAppearance": 0,
+            "commandBarAppearanceAvailable": true,
+            "commandBarAppearanceManaged": false
+        ]], delegate: delegate)
+        let otherProfile = ArciumSettingsStore(snapshot: ["available": true, "appearance": [
+            "commandBarAppearance": 0,
+            "commandBarAppearanceAvailable": true
+        ]], delegate: TestDelegate())
+
+        store.setCommandBarAppearance(1)
+        store.setCommandBarAppearance(99)
+        store.setCommandBarAppearance(-1)
+        XCTAssertEqual(delegate.settings.map(\.key), ["command_bar_appearance"])
+        XCTAssertEqual(delegate.settings.first?.value as? Int, 1)
+        store.updateSnapshot(["available": true, "appearance": [
+            "commandBarAppearance": 1,
+            "commandBarAppearanceAvailable": true,
+            "commandBarAppearanceManaged": false
+        ]])
+        XCTAssertEqual(store.snapshot.appearance.commandBarAppearance, 1)
+        XCTAssertEqual(otherProfile.snapshot.appearance.commandBarAppearance, 0)
+        store.setCommandBarAppearance(0)
+        XCTAssertEqual(delegate.settings.map { $0.value as? Int }, [1, 0])
+    }
+
+    @MainActor
+    func testCommandBarAppearanceHonorsManagedAndUnavailablePreferences() {
+        let delegate = TestDelegate()
+        let managed = ArciumSettingsStore(snapshot: ["available": true, "appearance": [
+            "commandBarAppearance": 1,
+            "commandBarAppearanceAvailable": true,
+            "commandBarAppearanceManaged": true
+        ]], delegate: delegate)
+        managed.setCommandBarAppearance(0)
+        XCTAssertFalse(managed.snapshot.appearance.canEditCommandBarAppearance)
+        XCTAssertEqual(managed.snapshot.appearance.commandBarAppearance, 1)
+
+        let unavailable = ArciumSettingsStore(snapshot: ["available": true], delegate: delegate)
+        unavailable.setCommandBarAppearance(1)
+        XCTAssertFalse(unavailable.snapshot.appearance.canEditCommandBarAppearance)
+        XCTAssertEqual(unavailable.snapshot.appearance.commandBarAppearance, 0)
+        XCTAssertTrue(delegate.settings.isEmpty)
+    }
+
+    @MainActor
+    func testCommandBarAppearanceRejectsMalformedSnapshotValues() {
+        for value: Any in [true, 1.5, -1, 2, "glass", Double.infinity] {
+            let snapshot = ArciumAppearanceSnapshot(["commandBarAppearance": value])
+            XCTAssertEqual(snapshot.commandBarAppearance, 0)
+        }
+        XCTAssertEqual(ArciumAppearanceSnapshot(["commandBarAppearance": 1]).commandBarAppearance, 1)
+        XCTAssertEqual(ArciumAppearanceSnapshot(["commandBarAppearance": 0]).commandBarAppearance, 0)
     }
 
