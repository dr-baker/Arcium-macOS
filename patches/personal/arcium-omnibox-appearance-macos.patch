+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by the GPL-3.0 license.
+
+#include "chrome/browser/ui/cocoa/arcium_command_panel_layout_mac.h"
+
+#include "base/functional/callback_helpers.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/helium/arcium_appearance_prefs.h"
+#include "chrome/browser/ui/helium/arcium_settings_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/prefs/pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace arcium_settings {
+namespace {
+NSMutableDictionary* Layout() {
+  return [@{@"labels": @1, @"icons": @2, @"scope_reveal": @2,
+            @"connected": @YES, @"full_width": @YES, @"scope_tints": @YES,
+            @"activity_dots": @YES, @"glow_strength": @1.0} mutableCopy];
+}
+}
+
+TEST(CommandPanelLayoutMacTest, PreservesEnumAndBooleanTypes) {
+  auto layout = Layout();
+  layout[@"scope_reveal"] = @3;
+  layout[@"connected"] = @NO;
+  auto converted = CommandPanelLayoutFromNSObject(layout);
+  ASSERT_TRUE(converted);
+  EXPECT_EQ(1, converted->FindInt("labels"));
+  EXPECT_EQ(2, converted->FindInt("icons"));
+  EXPECT_EQ(3, converted->FindInt("scope_reveal"));
+  EXPECT_EQ(false, converted->FindBool("connected"));
+  EXPECT_EQ(true, converted->FindBool("activity_dots"));
+}
+TEST(CommandPanelLayoutMacTest, ValidatesGlowStrength) {
+  for (NSNumber* strength in @[ @0.0, @0.75, @2.0 ]) {
+    auto layout = Layout();
+    layout[@"glow_strength"] = strength;
+    auto converted = CommandPanelLayoutFromNSObject(layout);
+    ASSERT_TRUE(converted);
+    EXPECT_EQ([strength doubleValue], converted->FindDouble("glow_strength"));
+  }
+  for (id invalid in @[ @YES, @(-0.1), @2.1, @"1", @(INFINITY), @(NAN) ]) {
+    auto layout = Layout();
+    layout[@"glow_strength"] = invalid;
+    EXPECT_FALSE(CommandPanelLayoutFromNSObject(layout));
+  }
+}
+TEST(CommandPanelLayoutMacTest, RejectsMalformedEnums) {
+  for (id invalid in
+       @[ @YES, @1.5, @(-1), @6, @"1", [NSNull null], @(INFINITY), @(NAN) ]) {
+    auto layout = Layout();
+    layout[@"scope_reveal"] = invalid;
+    EXPECT_FALSE(CommandPanelLayoutFromNSObject(layout));
+  }
+}
+TEST(CommandPanelLayoutMacTest, PreservesFlushDivotAndExistingHiddenValues) {
+  for (NSNumber* reveal in @[ @3, @4, @5 ]) {
+    auto layout = Layout();
+    layout[@"scope_reveal"] = reveal;
+    auto converted = CommandPanelLayoutFromNSObject(layout);
+    ASSERT_TRUE(converted);
+    EXPECT_EQ([reveal intValue], converted->FindInt("scope_reveal"));
+  }
+}
+TEST(CommandPanelLayoutMacTest, RejectsNumericBooleanSubstitutes) {
+  for (NSString* key in @[@"connected", @"full_width", @"scope_tints",
+                          @"activity_dots"]) {
+    auto layout = Layout();
+    layout[key] = @1;
+    EXPECT_FALSE(CommandPanelLayoutFromNSObject(layout));
+  }
+}
+TEST(CommandPanelLayoutMacTest, RejectsMissingAndUnexpectedKeys) {
+  EXPECT_FALSE(CommandPanelLayoutFromNSObject(nil));
+  EXPECT_FALSE(CommandPanelLayoutFromNSObject(@[]));
+  auto layout = Layout();
+  [layout removeObjectForKey:@"icons"];
+  EXPECT_FALSE(CommandPanelLayoutFromNSObject(layout));
+  layout[@"unknown"] = @2;
+  EXPECT_FALSE(CommandPanelLayoutFromNSObject(layout));
+  layout = Layout();
+  layout[@"unknown"] = @2;
+  EXPECT_FALSE(CommandPanelLayoutFromNSObject(layout));
+}
+// The profile contract needs a test window, without a native BrowserWidget.
+using CommandPanelLayoutModelTest = BrowserWithTestWindowTest;
+TEST_F(CommandPanelLayoutModelTest, BridgePayloadSavesThroughProfileOwner) {
+  ArciumSettingsModel model(browser()->profile(), base::DoNothing(),
+                             base::DoNothing());
+  for (NSNumber* reveal in @[ @3, @4, @5 ]) {
+    auto layout = Layout();
+    layout[@"scope_reveal"] = reveal;
+    layout[@"scope_tints"] = @NO;
+    auto converted = CommandPanelLayoutFromNSObject(layout);
+    ASSERT_TRUE(converted);
+    ASSERT_TRUE(model.SetCommandPanelLayout(*converted));
+    EXPECT_EQ(*converted, model.GetCommandPanelLayout());
+    EXPECT_EQ(*converted, browser()->profile()->GetPrefs()->GetDict(
+                              arcium::kCommandPanelLayoutPref));
+  }
+  auto malformed = model.GetCommandPanelLayout();
+  malformed.Set("scope_reveal", 6);
+  EXPECT_FALSE(model.SetCommandPanelLayout(malformed));
+}
+}  // namespace arcium_settings
