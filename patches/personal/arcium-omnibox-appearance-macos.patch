+class CommandBarNativeBackgroundMac : public CommandBarNativeBackground {
+ public:
+  CommandBarNativeBackgroundMac(views::Widget* widget,
+                                base::RepeatingClosure appearance_changed)
+      : widget_(widget) {
+    accessibility_observer_ = [NSWorkspace.sharedWorkspace.notificationCenter
+        addObserverForName:
+            NSWorkspaceAccessibilityDisplayOptionsDidChangeNotification
+                    object:nil
+                     queue:NSOperationQueue.mainQueue
+                usingBlock:^(NSNotification*) {
+                  appearance_changed.Run();
+                }];
+  }
+
+  ~CommandBarNativeBackgroundMac() override {
+    [NSWorkspace.sharedWorkspace.notificationCenter
+        removeObserver:accessibility_observer_];
+    [background_view_ removeFromSuperview];
+  }
+
+  std::optional<int> ResizeHeight(std::optional<int> height,
+                                  base::TimeDelta duration) override {
+    NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+    if (!window) {
+      return std::nullopt;
+    }
+    NSRect frame = window.frame;
+    if (height) {
+      // Cocoa coordinates grow upward. Keep the search field's top edge fixed.
+      frame.origin.y = NSMaxY(frame) - *height;
+      frame.size.height = *height;
+    }
+    const bool animate = height && duration.is_positive() &&
+        !NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion;
+    NSDictionary* previous_animations = window.animations;
+    CASpringAnimation* spring = nil;
+    if (animate) {
+      if (@available(macOS 14.0, *)) {
+        spring = [[CASpringAnimation alloc]
+            initWithPerceptualDuration:duration.InSecondsF() bounce:0];
+      } else {
+        // Critically damped equivalent for older AppKit: no undershoot that
+        // could briefly clip the last result while the panel contracts.
+        spring = [CASpringAnimation animation];
+        const double frequency = 6.283185307179586 / duration.InSecondsF();
+        spring.stiffness = frequency * frequency;
+        spring.damping = 2 * frequency;
+      }
+      spring.duration = spring.settlingDuration;
+      NSMutableDictionary* animations =
+          [previous_animations mutableCopy] ?: [NSMutableDictionary dictionary];
+      animations[@"frame"] = spring;
+      window.animations = animations;
+    }
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+      // A spring's duration is perceptual; let its short settling tail finish.
+      // Zero duration also stops an in-flight resize at its current frame.
+      context.duration = animate ? spring.settlingDuration : 0;
+      [[window animator] setFrame:frame display:YES];
+    } completionHandler:nil];
+    window.animations = previous_animations;
+    return base::ClampRound(NSHeight(window.frame));
+  }
+
+  void SetContour(const SkPath& contour) override {
+    if (contour_ == contour) {
+      return;
+    }
+    contour_ = contour;
+    contour_changed_ = true;
+  }
+
+  bool Update(bool requested,
+              const helium::GlassSurfaceConfiguration& configuration,
+              const gfx::Rect& bounds,
+              const gfx::RoundedCornersF& corner_radii) override {
+    NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+    NSView* content_view = window.contentView;
+    const helium::GlassBackendAvailability availability =
+        helium::GetNativeFrameGlassAvailability();
+    const helium::GlassSurfaceResolution resolution =
+        helium::ResolveGlassSurfaceConfiguration(
+            configuration, helium::GetRequestedGlassBackend(),
+            availability.native_liquid_glass, availability.native_material,
+            availability.reduce_transparency);
+    if (!requested || !resolution.paints_chrome_transparent || !content_view ||
+        bounds.IsEmpty()) {
+      [background_view_ removeFromSuperview];
+      background_view_ = nil;
+      last_configuration_.reset();
+      return false;
+    }
+
+    // Views publishes the new frameless window size before remote_cocoa has
+    // resized its NSView. Use the same target height as the clip so a shorter
+    // result list cannot cache a frame offset derived from the previous size.
+    const CGFloat content_height = widget_->GetWindowBoundsInScreen().height();
+    const NSRect frame =
+        NSMakeRect(bounds.x(),
+                   content_view.isFlipped
+                       ? bounds.y()
+                       : content_height - bounds.bottom(),
+                   bounds.width(), bounds.height());
+    const auto color_mode = widget_->GetColorMode();
+    const SkColor theme_color =
+        widget_->GetColorProvider()->GetColor(kColorToolbar);
+    if (background_view_ && NSEqualRects(background_view_.frame, frame) &&
+        last_configuration_ == configuration &&
+        last_active_material_ == resolution.active && last_bounds_ == bounds &&
+        last_corner_radii_ == corner_radii && last_color_mode_ == color_mode &&
+        last_theme_color_ == theme_color &&
+        !(contour_changed_ && contour_.isEmpty())) {
+      if (contour_changed_ && !contour_.isEmpty()) {
+        CGMutablePathRef path =
+            ContourToCGPath(contour_, bounds, NSHeight(background_view_.bounds),
+                            background_view_.isFlipped);
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        mask_.path = path;
+        [CATransaction commit];
+        CGPathRelease(path);
+        contour_changed_ = false;
+      }
+      return true;
+    }
+    if (!background_view_) {
+      background_view_ = helium::CreateNativeGlassBackgroundView(
+          frame, color_mode, theme_color, configuration, resolution);
+      if (!background_view_) {
+        return false;
+      }
+      // Match the existing browser native-frame integration. This view is a
+      // background effect, so remote_cocoa leaves it below Views content.
+      [content_view addSubview:background_view_
+                    positioned:NSWindowBelow
+                    relativeTo:nil];
+    } else {
+      helium::ApplyNativeGlassBackgroundView(background_view_, frame,
+                                             color_mode, theme_color,
+                                             configuration, resolution);
+    }
+    background_view_.wantsLayer = YES;
+    // The results top edge is square below the search-bar cutout. Preserve
+    // each painted corner rather than imposing a second rounded silhouette.
+    const CGFloat width = NSWidth(background_view_.bounds);
+    const CGFloat height = NSHeight(background_view_.bounds);
+    const CGFloat maximum = std::min(width, height) / 2.0;
+    const auto radius = [maximum](float value) {
+      return std::clamp<CGFloat>(value, 0.0, maximum);
+    };
+    const bool flipped = background_view_.isFlipped;
+    const CGFloat top_left =
+        radius(flipped ? corner_radii.lower_left() : corner_radii.upper_left());
+    const CGFloat top_right = radius(flipped ? corner_radii.lower_right()
+                                             : corner_radii.upper_right());
+    const CGFloat bottom_left =
+        radius(flipped ? corner_radii.upper_left() : corner_radii.lower_left());
+    const CGFloat bottom_right = radius(flipped ? corner_radii.upper_right()
+                                                : corner_radii.lower_right());
+    CGMutablePathRef path = CGPathCreateMutable();
+    CGPathMoveToPoint(path, nullptr, bottom_left, 0);
+    CGPathAddLineToPoint(path, nullptr, width - bottom_right, 0);
+    CGPathAddArcToPoint(path, nullptr, width, 0, width, bottom_right,
+                        bottom_right);
+    CGPathAddLineToPoint(path, nullptr, width, height - top_right);
+    CGPathAddArcToPoint(path, nullptr, width, height, width - top_right, height,
+                        top_right);
+    CGPathAddLineToPoint(path, nullptr, top_left, height);
+    CGPathAddArcToPoint(path, nullptr, 0, height, 0, height - top_left,
+                        top_left);
+    CGPathAddLineToPoint(path, nullptr, 0, bottom_left);
+    CGPathAddArcToPoint(path, nullptr, 0, 0, bottom_left, 0, bottom_left);
+    CGPathCloseSubpath(path);
+    if (!contour_.isEmpty()) {
+      CGPathRelease(path);
+      path = ContourToCGPath(contour_, bounds, height, flipped);
+    }
+    if (!mask_) {
+      mask_ = [CAShapeLayer layer];
+    }
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    mask_.frame = background_view_.bounds;
+    mask_.fillColor = NSColor.blackColor.CGColor;
+    mask_.fillRule = contour_.getFillType() == SkPathFillType::kEvenOdd
+                         ? kCAFillRuleEvenOdd
+                         : kCAFillRuleNonZero;
+    mask_.path = path;
+    background_view_.layer.mask = mask_;
+    [CATransaction commit];
+    CGPathRelease(path);
+    contour_changed_ = false;
+    last_configuration_ = configuration;
+    last_active_material_ = resolution.active;
+    last_bounds_ = bounds;
+    last_corner_radii_ = corner_radii;
+    last_color_mode_ = color_mode;
+    last_theme_color_ = theme_color;
+    return true;
+  }
+
+ private:
+  raw_ptr<views::Widget> widget_;
+  NSView* __strong background_view_ = nil;
+  CAShapeLayer* __strong mask_ = nil;
+  SkPath contour_;
+  bool contour_changed_ = false;
+  id __strong accessibility_observer_ = nil;
+  std::optional<helium::GlassSurfaceConfiguration> last_configuration_;
+  helium::GlassSurfaceMaterial last_active_material_ =
+      helium::GlassSurfaceMaterial::kAuto;
+  gfx::Rect last_bounds_;
+  gfx::RoundedCornersF last_corner_radii_;
+  std::optional<ui::ColorProviderKey::ColorMode> last_color_mode_;
+  std::optional<SkColor> last_theme_color_;
+};
+
+}  // namespace
+
+std::unique_ptr<CommandBarNativeBackground> CreateCommandBarNativeBackground(
+    views::Widget* widget,
+    base::RepeatingClosure appearance_changed) {
+  return std::make_unique<CommandBarNativeBackgroundMac>(
+      widget, std::move(appearance_changed));
+}
+
+}  // namespace arcium
