+IN_PROC_BROWSER_TEST_F(AppControllerHeliumSpacesBrowserTest,
+                       DockMenuListsLoadedSpaceIdentities) {
+  ASSERT_TRUE(helium::IsHeliumFavoritesAndPinsEnabled());
+
+  Profile* profile = browser()->profile();
+  helium::HeliumSpaceService* space_service =
+      helium::HeliumSpaceServiceFactory::GetInstance()
+          ->SetTestingSubclassFactoryAndUse<helium::HeliumSpaceService>(
+              profile,
+              base::BindOnce(
+                  [](content::BrowserContext* context)
+                      -> std::unique_ptr<helium::HeliumSpaceService> {
+                    return std::make_unique<helium::HeliumSpaceService>(
+                        static_cast<Profile*>(context));
+                  }));
+  ASSERT_TRUE(space_service);
+
+  constexpr char kWorkSpaceID[] = "dock-work";
+  constexpr char kResearchSpaceID[] = "dock-research";
+  ASSERT_TRUE(space_service->GetOrCreateSpace(kWorkSpaceID, u"Work"));
+  ASSERT_TRUE(space_service->GetOrCreateSpace(kResearchSpaceID, u"Research"));
+
+  NSMenu* menu = [AppController.sharedController applicationDockMenu:NSApp];
+  ASSERT_TRUE(menu);
+
+  NSString* expected_profile_path =
+      base::SysUTF8ToNSString(profile->GetPath().AsUTF8Unsafe());
+  NSString* expected_work_id = base::SysUTF8ToNSString(kWorkSpaceID);
+  NSString* expected_research_id = base::SysUTF8ToNSString(kResearchSpaceID);
+  bool found_work = false;
+  bool found_research = false;
+  NSUInteger space_item_count = 0;
+
+  for (NSMenuItem* item in menu.itemArray) {
+    if (item.action != @selector(openSpaceFromDock:)) {
+      continue;
+    }
+
+    ++space_item_count;
+    NSDictionary* identity = item.representedObject;
+    ASSERT_TRUE(identity);
+    EXPECT_NSEQ(expected_profile_path, identity[@"profilePath"]);
+
+    NSString* space_id = identity[@"spaceID"];
+    ASSERT_TRUE(space_id);
+    if ([space_id isEqualToString:expected_work_id]) {
+      EXPECT_NSEQ(@"Work", item.title);
+      found_work = true;
+    } else if ([space_id isEqualToString:expected_research_id]) {
+      EXPECT_NSEQ(@"Research", item.title);
+      found_research = true;
+    }
+  }
+
+  EXPECT_EQ(space_service->GetSpaces().size(), space_item_count);
+  EXPECT_TRUE(found_work);
+  EXPECT_TRUE(found_research);
+}
