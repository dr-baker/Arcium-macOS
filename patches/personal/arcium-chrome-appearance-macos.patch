+- (void)applyConfiguration:
+    (const helium::GlassSurfaceConfiguration&)configuration {
+  configuration_ = configuration;
+  [self setNeedsDisplay:YES];
+}
+
+- (void)drawRect:(NSRect)dirtyRect {
+  CGContextRef context = NSGraphicsContext.currentContext.CGContext;
+  CGContextSaveGState(context);
+  CGContextClipToRect(context, self.bounds);
+
+  const CGFloat width = NSWidth(self.bounds);
+  const CGFloat height = NSHeight(self.bounds);
+  const CGFloat radius_scale = std::min(width, height);
+  for (size_t index = 0; index < configuration_.point_count; ++index) {
+    const helium::GlassColorPoint& point = configuration_.points[index];
+    if (point.opacity <= 0.0f || radius_scale <= 0.0) {
+      continue;
+    }
+
+    const CGPoint center = {
+        static_cast<CGFloat>(point.x) * width,
+        (1.0 - static_cast<CGFloat>(point.y)) * height,
+    };
+    const CGFloat radius = std::max<CGFloat>(
+        1.0, static_cast<CGFloat>(point.radius) * radius_scale);
+    const CGFloat point_alpha =
+        static_cast<CGFloat>(point.opacity) *
+        static_cast<CGFloat>(configuration_.tint_strength);
+    CGColorRef start = CGColorFromSkColor4f(point.color, point_alpha);
+    CGColorRef end = CGColorFromSkColor4f(point.color, 0.0);
+    NSArray* colors = @[
+      (__bridge id)start,
+      (__bridge id)end,
+    ];
+    const CGFloat locations[] = {0.0, 1.0};
+    CGColorSpaceRef color_space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    if (!color_space) {
+      color_space = CGColorSpaceCreateDeviceRGB();
+    }
+    CGGradientRef gradient = CGGradientCreateWithColors(
+        color_space, (__bridge CFArrayRef)colors, locations);
+    if (gradient) {
+      CGContextDrawRadialGradient(context, gradient, center, 0.0, center,
+                                  radius, kCGGradientDrawsAfterEndLocation);
+      CGGradientRelease(gradient);
+    }
+    CGColorSpaceRelease(color_space);
+    CGColorRelease(start);
+    CGColorRelease(end);
+  }
+
+  // Draw the cached grain after the color points in one backing layer.
+  if (tile_ && configuration_.grain > 0.0) {
+    CGContextSetAlpha(context, configuration_.grain);
+    CGContextSetBlendMode(context, kCGBlendModeOverlay);
+    CGContextSetInterpolationQuality(context, kCGInterpolationNone);
+    const CGFloat scale =
+        std::max<CGFloat>(1.0, self.window.backingScaleFactor);
+    const CGFloat grain_scale = std::clamp<CGFloat>(
+        static_cast<CGFloat>(configuration_.grain_scale), 0.5, 2.0);
+    CGContextDrawTiledImage(
+        context,
+        CGRectMake(0, 0, CGImageGetWidth(tile_) / scale * grain_scale,
+                   CGImageGetHeight(tile_) / scale * grain_scale),
+        tile_);
+  }
+
+  CGContextRestoreGState(context);
+}
+
+@end
