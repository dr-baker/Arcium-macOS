+CGColorRef CGColorFromSkColor4f(const SkColor4f& color, CGFloat alpha) {
+  const CGFloat components[] = {
+      std::clamp<CGFloat>(color.fR, 0.0, 1.0),
+      std::clamp<CGFloat>(color.fG, 0.0, 1.0),
+      std::clamp<CGFloat>(color.fB, 0.0, 1.0),
+      std::clamp<CGFloat>(color.fA * alpha, 0.0, 1.0),
+  };
+  CGColorSpaceRef color_space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+  if (!color_space) {
+    color_space = CGColorSpaceCreateDeviceRGB();
+  }
+  CGColorRef result = CGColorCreate(color_space, components);
+  CGColorSpaceRelease(color_space);
+  return result;
+}
+
+void ReleaseGrainBytes(void*, const void* data, size_t) {
+  free(const_cast<void*>(data));
+}
+
+CGImageRef CreateGrainTile() {
+  constexpr size_t kTileSize = 64;
+  constexpr size_t kBytesPerPixel = 4;
+  constexpr size_t kDataSize = kTileSize * kTileSize * kBytesPerPixel;
+  auto* bytes = static_cast<uint8_t*>(malloc(kDataSize));
+  if (!bytes) {
+    return nullptr;
+  }
+
+  uint32_t state = 0x9e3779b9u;
+  for (size_t index = 0; index < kTileSize * kTileSize; ++index) {
+    // A deterministic tile avoids animation and keeps the profile setting
+    // stable across windows and launches.
+    state = state * 1664525u + 1013904223u;
+    const uint8_t value = static_cast<uint8_t>(state >> 24);
+    bytes[index * kBytesPerPixel + 0] = value;
+    bytes[index * kBytesPerPixel + 1] = value;
+    bytes[index * kBytesPerPixel + 2] = value;
+    bytes[index * kBytesPerPixel + 3] = 255;
+  }
+
+  CGColorSpaceRef color_space = CGColorSpaceCreateDeviceRGB();
+  CGDataProviderRef provider = CGDataProviderCreateWithData(
+      nullptr, bytes, kDataSize, &ReleaseGrainBytes);
+  CGImageRef image =
+      provider ? CGImageCreate(kTileSize, kTileSize, 8, 32,
+                               kTileSize * kBytesPerPixel, color_space,
+                               kCGImageAlphaPremultipliedLast, provider,
+                               nullptr, false, kCGRenderingIntentDefault)
+               : nullptr;
+  if (provider) {
+    CGDataProviderRelease(provider);
+  }
+  CGColorSpaceRelease(color_space);
+  if (!provider) {
+    free(bytes);
+  }
+  return image;
+}
+
 }  // namespace
 
