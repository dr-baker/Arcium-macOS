+// One key window owns both the SwiftUI controls and the real Views presenter.
+// NativeViewHost is the supported direction for mixing these two view trees.
+class CommandSettingsPreviewView : public views::View {
+ public:
+  explicit CommandSettingsPreviewView(
+      std::unique_ptr<arcium::CommandPanelView> panel) {
+    controls_ = AddChildView(std::make_unique<views::NativeViewHost>());
+    panel_ = AddChildView(std::move(panel));
+    panel_->SetEmbedded(true);
+    preview_height_ = panel_->GetPreferredSize().height();
+  }
+  views::NativeViewHost* controls() { return controls_; }
+  arcium::CommandPanelView* panel() { return panel_; }
+  void SetGeometryChanged(base::RepeatingClosure callback) {
+    geometry_changed_ = std::move(callback);
+  }
+  int ResizePreview(std::optional<int> height) {
+    if (height) {
+      preview_height_ = *height;
+      InvalidateLayout();
+      if (GetWidget()) {
+        GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+      }
+    }
+    return panel_->height();
+  }
+  int AvailablePreviewWidth() const { return std::max(280, panel_->width()); }
+
+ protected:
+  void Layout(PassKey) override {
+    const int controls_width = std::min(520, std::max(0, width() - 320));
+    controls_->SetBounds(0, 0, controls_width, height());
+    panel_->SetBounds(controls_width + 16, 16,
+                      std::max(1, width() - controls_width - 32),
+                      std::clamp(preview_height_, 1, std::max(1, height() - 32)));
+    if (geometry_changed_) {
+      geometry_changed_.Run();
+    }
+  }
+
+ private:
+  raw_ptr<views::NativeViewHost> controls_;
+  raw_ptr<arcium::CommandPanelView> panel_;
+  int preview_height_ = 1;
+  base::RepeatingClosure geometry_changed_;
+};
+
+// Resolve the same complete Space palette as BrowserWidget, using Settings'
+// captured target rather than whichever browser was activated most recently.
+class CommandSettingsPreviewWidget : public views::Widget {
+ public:
+  CommandSettingsPreviewWidget(Profile* profile, const helium::HeliumSpace* space,
+                               ui::ColorProviderKey key)
+      : profile_(profile), browser_key_(std::move(key)) {
+    if (space) theme_ = space->theme();
+  }
+  void UpdateBrowserKey(ui::ColorProviderKey key) {
+    browser_key_ = std::move(key);
+    ThemeChanged();
+  }
+  void UpdateSpace(const helium::HeliumSpace* space) {
+    theme_ = space ? std::optional(space->theme()) : std::nullopt;
+    ThemeChanged();
+  }
+
+ protected:
+  ui::ColorProviderKey GetColorProviderKey() const override {
+    auto key = browser_key_;
+    const auto system_mode = views::Widget::GetColorProviderKey().color_mode;
+    auto* themes = ThemeServiceFactory::GetForProfile(profile_);
+    if (!themes->UsingPolicyTheme() &&
+        key.contrast_mode != ui::ColorProviderKey::ContrastMode::kHigh &&
+        key.forced_colors == ui::ColorProviderKey::ForcedColors::kNone) {
+      const auto palette = helium::SpacePaletteKey(
+          theme_ ? &*theme_ : nullptr,
+          helium::ReadGlassSurfaceConfiguration(profile_->GetPrefs()));
+      key.user_color = palette.seed;
+      key.user_color_source = ui::ColorProviderKey::UserColorSource::kAccent;
+      key.custom_theme = nullptr;
+      key.color_mode = system_mode;
+      if (theme_ && theme_->mode != helium::SpaceTheme::Mode::kAuto) {
+        key.color_mode = theme_->mode == helium::SpaceTheme::Mode::kDark
+                             ? ui::ColorProviderKey::ColorMode::kDark
+                             : ui::ColorProviderKey::ColorMode::kLight;
+      }
+      key.app_controller = arcium::GetSpacePaletteInitializer(palette);
+    }
+    return key;
+  }
+
+ private:
+  raw_ptr<Profile> profile_;
+  ui::ColorProviderKey browser_key_;
+  std::optional<helium::SpaceTheme> theme_;
+};
