+- (void)showCommandBarEditor {
+  if (command_editor_ || command_controls_sheet_ || profile_destroying_ ||
+      !model_ || self.window.attachedSheet || !settings_ui_controller_) return;
+  SEL selector = NSSelectorFromString(@"makeCommandBarEditorWithPreviewAvailable:");
+  if (![settings_ui_controller_ respondsToSelector:selector]) return;
+  const auto* space = model_->GetAppearanceSpace();
+  BrowserView* target = nullptr;
+  auto* primary = space ? space->GetPrimaryBrowser() : nullptr;
+  if (IsMatchingNormalBrowser(primary, profile_)) {
+    target = BrowserView::GetBrowserViewForBrowser(primary);
+  }
+  auto* collection = GlobalBrowserCollection::GetInstance();
+  if (!target && collection) {
+    collection->ForEach([&](BrowserWindowInterface* browser) {
+      if (IsMatchingNormalBrowser(browser, profile_)) {
+        target = BrowserView::GetBrowserViewForBrowser(browser);
+        return false;
+      }
+      return true;
+    }, BrowserCollection::Order::kActivation);
+  }
+  if (target && (!target->GetWidget() || target->GetWidget()->IsClosed())) target = nullptr;
+  using MakeEditor = NSViewController* (*)(id, SEL, BOOL);
+  NSViewController* controls = reinterpret_cast<MakeEditor>(objc_msgSend)(
+      settings_ui_controller_, selector, target != nullptr);
+  if (!controls) return;
+  if (!target) {
+    // Settings remains usable after the last browser closes. The same controls
+    // are available in a normal sheet, with an explicit unavailable preview.
+    command_controls_sheet_ = [[NSWindow alloc]
+        initWithContentRect:NSMakeRect(0, 0, 520, 620)
+                  styleMask:NSWindowStyleMaskBorderless
+                    backing:NSBackingStoreBuffered defer:NO];
+    command_controls_sheet_.releasedWhenClosed = NO;
+    command_controls_sheet_.contentViewController = controls;
+    [self.window beginSheet:command_controls_sheet_ completionHandler:nil];
+    return;
+  }
+  __weak ArciumSettingsWindowController* weak_self = self;
+  command_editor_ = std::make_unique<CommandSettingsEditor>(
+      self.window, controls, target, space,
+      ^{ [weak_self closeCommandBarEditor]; });
+}
+
+- (void)closeCommandBarEditor {
+  command_editor_.reset();
+  if (command_controls_sheet_) {
+    [command_controls_sheet_.sheetParent endSheet:command_controls_sheet_];
+    [command_controls_sheet_ orderOut:nil];
+    [command_controls_sheet_ close];
+    command_controls_sheet_ = nil;
+  }
