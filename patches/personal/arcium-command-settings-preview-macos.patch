+    auto root = std::make_unique<CommandSettingsPreviewView>(std::move(panel));
+    root_ = root.get();
+    delegate_ = std::make_unique<views::WidgetDelegate>();
+    delegate_->SetCanActivate(true);
+    delegate_->SetTitle(u"Command bar");
+    delegate_->SetContentsView(std::move(root));
+    delegate_->RegisterWindowClosingCallback(base::BindOnce(
+        &CommandSettingsEditor::RequestClose, base::Unretained(this)));
+    widget_ = std::make_unique<CommandSettingsPreviewWidget>(
+        profile, space, browser_widget_->GetSpaceContentColorProviderKey());
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    const NSRect visible = (parent.screen ?: NSScreen.mainScreen).visibleFrame;
+    params.bounds = gfx::Rect(0, 0, std::min(1380, static_cast<int>(visible.size.width) - 48),
+                             std::min(720, static_cast<int>(visible.size.height) - 64));
+    params.delegate = delegate_.get();
+    widget_->Init(std::move(params));
+    root_->controls()->Attach(gfx::NativeView(controls_.view));
+    root_->panel()->SetHeightResizeCallback(base::BindRepeating(
+        [](CommandSettingsEditor* owner, std::optional<int> height,
+           base::TimeDelta duration) {
+          return owner->root_->ResizePreview(height);
+        }, base::Unretained(this)));
+    root_->panel()->BindPreferences(
+        profile->GetPrefs(),
+        base::BindRepeating([](Profile* owner) {
+          return static_cast<float>(arcium::GetChromeUIScale(owner));
+        }, base::Unretained(profile)),
+        base::BindRepeating([](CommandSettingsEditor* owner) {
+          return owner->root_->AvailablePreviewWidth();
+        }, base::Unretained(this)));
+    material_ = std::make_unique<arcium::CommandBarMaterial>(
+        widget_.get(), profile->GetPrefs(),
+        base::BindRepeating([](CommandSettingsEditor* owner) {
+          arcium::CommandBarMaterial::Clip clip;
+          const auto bounds = owner->root_->panel()->bounds();
+          clip.insets = gfx::Insets::TLBR(bounds.y(), bounds.x(),
+              owner->root_->height() - bounds.bottom(),
+              owner->root_->width() - bounds.right());
+          clip.contour = owner->root_->panel()->GetContourPath().makeOffset(
+              bounds.x(), bounds.y());
+          return clip;
+        }, base::Unretained(this)),
