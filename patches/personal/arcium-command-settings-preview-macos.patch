+
+    private func commandLayoutBinding<Value>(_ key: WritableKeyPath<ArciumCommandPanelLayout, Value>) -> Binding<Value> {
+        Binding(get: { store.snapshot.appearance.commandPanelLayout[keyPath: key] },
+                set: { value in
+                    var layout = store.snapshot.appearance.commandPanelLayout
+                    layout[keyPath: key] = value
