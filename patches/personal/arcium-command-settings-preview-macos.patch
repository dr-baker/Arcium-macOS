+- (void)showCommandBarEditor {
+  if (command_editor_ || profile_destroying_ || !model_ ||
+      self.window.attachedSheet || !settings_ui_controller_) return;
+  SEL selector = NSSelectorFromString(@"makeCommandBarEditor");
+  if (![settings_ui_controller_ respondsToSelector:selector]) return;
+  BrowserView* target = nullptr;
+  auto* collection = GlobalBrowserCollection::GetInstance();
+  if (!collection) return;
+  collection->ForEach([&](BrowserWindowInterface* browser) {
+    if (IsMatchingNormalBrowser(browser, profile_)) {
+      target = BrowserView::GetBrowserViewForBrowser(browser);
+      return false;
+    }
+    return true;
+  }, BrowserCollection::Order::kActivation);
+  if (!target || !target->GetWidget() || target->GetWidget()->IsClosed()) return;
+  using MakeEditor = NSViewController* (*)(id, SEL);
+  NSViewController* controls = reinterpret_cast<MakeEditor>(objc_msgSend)(
+      settings_ui_controller_, selector);
+  if (!controls) return;
+  __weak ArciumSettingsWindowController* weak_self = self;
+  command_editor_ = std::make_unique<CommandSettingsEditor>(
+      self.window, controls, target, ^{ [weak_self closeCommandBarEditor]; });
+}
+
+- (void)closeCommandBarEditor {
+  command_editor_.reset();
+}
