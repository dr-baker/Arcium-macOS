+struct ArciumCommandBarEditorView: View {
+    @ObservedObject var store: ArciumSettingsStore
+
+    var body: some View {
+        if let preset = store.preset {
+            let scheme = store.webColorScheme()
+            let style = scheme == .dark ? preset.dark : preset.light
+            let theme = store.snapshot.appearance.spacePalette.theme(
+                fallback: style.theme(brand: preset.brand), colorScheme: scheme)
+            ArciumLiveSettingsSheet(title: "Command bar", onClose: {
+                store.actionInvoked(name: "close_command_bar_editor")
+            }) {
+                Text("Select scopes or type in the preview. Results won't open.")
+                    .settingsFont(\.caption).foregroundStyle(.secondary)
+                ArciumCommandBarControls(store: store)
+            }
+            .settingsTheme(theme)
+            .settingsFont(preset.font)
+            .settingsFontScale(CGFloat(style.surface.fontScale))
+            .settingsLayout(SettingsLayoutConfiguration(
+                pageGutter: 24, compactPageGutter: 16, maximumPageWidth: 960,
+                cardPadding: 14, sectionSpacing: 20, rowSpacing: 7, inputWidth: 220))
+            .environment(\.colorScheme, scheme)
+        }
+    }
+}
