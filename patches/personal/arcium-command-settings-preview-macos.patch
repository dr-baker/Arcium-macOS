+          owner->root_->panel()->SetNativeMaterial(enabled);
+        }, base::Unretained(this)));
+    const auto refresh = base::BindRepeating([](CommandSettingsEditor* owner) {
+      if (owner->material_) owner->material_->Refresh();
+    }, base::Unretained(this));
+    root_->SetGeometryChanged(refresh);
+    root_->panel()->SetGeometryChangedCallback(refresh);
+    browser_widget_->AddObserver(this);
+    widget_->GetRootView()->DeprecatedLayoutImmediately();
+    material_->Refresh();
+    NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+    [parent beginSheet:window completionHandler:nil];
+  }
+
+  ~CommandSettingsEditor() override {
+    closing_ = true;
+    if (browser_widget_) browser_widget_->RemoveObserver(this);
+    CloseWindow();
+  }
+  void UpdateSpace(const helium::HeliumSpace* space) {
+    if (widget_) widget_->UpdateSpace(space);
+  }
+  void RequestClose() {
+    if (closing_) return;
+    closing_ = true;
+    // Widget callbacks must finish before their client-owned tree is deleted.
+    dispatch_async(dispatch_get_main_queue(), closed_);
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    browser_widget_->RemoveObserver(this);
+    browser_widget_ = nullptr;
+    CloseWindow();
+    RequestClose();
+  }
+  void OnWidgetThemeChanged(views::Widget* widget) override {
+    if (!widget_) return;
+    widget_->UpdateBrowserKey(browser_widget_->GetSpaceContentColorProviderKey());
+  }
+
+ private:
+  void CloseWindow() {
+    if (!widget_) return;
+    material_.reset();
+    NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+    if (window.sheetParent) [window.sheetParent endSheet:window];
+    root_->controls()->Detach();
+    widget_->CloseNow();
+    widget_.reset();
+    delegate_.reset();
+    root_ = nullptr;
+  }
+  NSViewController* controls_;
+  void (^closed_)(void);
+  raw_ptr<BrowserWidget> browser_widget_;
+  raw_ptr<CommandSettingsPreviewView> root_ = nullptr;
+  std::unique_ptr<views::WidgetDelegate> delegate_;
+  std::unique_ptr<CommandSettingsPreviewWidget> widget_;
+  std::unique_ptr<arcium::CommandBarMaterial> material_;
+  bool closing_ = false;
+};
