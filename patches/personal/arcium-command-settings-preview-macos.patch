+// One key window owns both the SwiftUI controls and the real Views presenter.
+// NativeViewHost is the supported direction for mixing these two view trees.
+class CommandSettingsPreviewView : public views::View {
+ public:
+  explicit CommandSettingsPreviewView(
+      std::unique_ptr<arcium::CommandPanelView> panel) {
+    controls_ = AddChildView(std::make_unique<views::NativeViewHost>());
+    panel_ = AddChildView(std::move(panel));
+    panel_->SetEmbedded(true);
+    preview_height_ = panel_->GetPreferredSize().height();
+  }
+  views::NativeViewHost* controls() { return controls_; }
+  arcium::CommandPanelView* panel() { return panel_; }
+  void SetGeometryChanged(base::RepeatingClosure callback) {
+    geometry_changed_ = std::move(callback);
+  }
+  int ResizePreview(std::optional<int> height) {
+    if (height) {
+      preview_height_ = *height;
+      InvalidateLayout();
+      if (GetWidget()) {
+        GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+      }
+    }
+    return panel_->height();
+  }
+  int AvailablePreviewWidth() const { return std::max(280, width() - 544); }
+
+ protected:
+  void Layout(PassKey) override {
+    const int controls_width = std::min(520, std::max(0, width() - 320));
+    controls_->SetBounds(0, 0, controls_width, height());
+    panel_->SetBounds(controls_width + 16, 16,
+                      std::max(1, width() - controls_width - 32),
+                      std::clamp(preview_height_, 1, std::max(1, height() - 32)));
+    if (geometry_changed_) {
+      geometry_changed_.Run();
+    }
+  }
+
+ private:
+  raw_ptr<views::NativeViewHost> controls_;
+  raw_ptr<arcium::CommandPanelView> panel_;
+  int preview_height_ = 1;
+  base::RepeatingClosure geometry_changed_;
+};
+
+class CommandSettingsEditor : public views::WidgetObserver {
+ public:
+  CommandSettingsEditor(NSWindow* parent, NSViewController* controls,
+                        BrowserView* browser_view, void (^closed)(void))
+      : controls_(controls), closed_(closed),
+        browser_widget_(browser_view->GetWidget()) {
+    auto* browser = browser_view->browser();
+    auto* profile = browser->profile()->GetOriginalProfile();
+    auto panel = std::make_unique<arcium::CommandPanelView>(
+        std::make_unique<arcium::CommandPreviewSession>(
+            arcium::CreateCommandSession(browser)),
+        base::BindRepeating(&CommandSettingsEditor::RequestClose,
+                            base::Unretained(this)),
+        base::DoNothing());
+    auto root = std::make_unique<CommandSettingsPreviewView>(std::move(panel));
+    root_ = root.get();
+    delegate_ = std::make_unique<views::WidgetDelegate>();
+    delegate_->SetCanActivate(true);
+    delegate_->SetTitle(u"Command bar");
+    delegate_->SetContentsView(std::move(root));
+    delegate_->RegisterWindowClosingCallback(base::BindOnce(
+        &CommandSettingsEditor::RequestClose, base::Unretained(this)));
+    widget_ = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    const NSRect visible = (parent.screen ?: NSScreen.mainScreen).visibleFrame;
+    params.bounds = gfx::Rect(0, 0, std::min(1380, static_cast<int>(visible.size.width) - 48),
+                             std::min(720, static_cast<int>(visible.size.height) - 64));
+    params.delegate = delegate_.get();
+    widget_->Init(std::move(params));
+    widget_->SetColorModeOverride(browser_widget_->GetColorMode());
+    widget_->SetUserColorOverride(browser_widget_->user_color_override());
+    root_->controls()->Attach(gfx::NativeView(controls_.view));
+    root_->panel()->SetHeightResizeCallback(base::BindRepeating(
+        [](CommandSettingsEditor* owner, std::optional<int> height,
+           base::TimeDelta duration) {
+          return owner->root_->ResizePreview(height);
+        }, base::Unretained(this)));
+    root_->panel()->BindPreferences(
+        profile->GetPrefs(),
+        base::BindRepeating([](Profile* owner) {
+          return static_cast<float>(arcium::GetChromeUIScale(owner));
+        }, base::Unretained(profile)),
+        base::BindRepeating([](CommandSettingsEditor* owner) {
+          return owner->root_->AvailablePreviewWidth();
+        }, base::Unretained(this)));
+    material_ = std::make_unique<arcium::CommandBarMaterial>(
+        widget_.get(), profile->GetPrefs(),
+        base::BindRepeating([](CommandSettingsEditor* owner) {
+          arcium::CommandBarMaterial::Clip clip;
+          const auto bounds = owner->root_->panel()->bounds();
+          clip.insets = gfx::Insets::TLBR(bounds.y(), bounds.x(),
+              owner->root_->height() - bounds.bottom(),
+              owner->root_->width() - bounds.right());
+          clip.contour = owner->root_->panel()->GetContourPath().makeOffset(
+              bounds.x(), bounds.y());
+          return clip;
+        }, base::Unretained(this)),
+        base::BindRepeating([](CommandSettingsEditor* owner, bool enabled) {
+          owner->root_->panel()->SetNativeMaterial(enabled);
+        }, base::Unretained(this)));
+    const auto refresh = base::BindRepeating([](CommandSettingsEditor* owner) {
+      if (owner->material_) owner->material_->Refresh();
+    }, base::Unretained(this));
+    root_->SetGeometryChanged(refresh);
+    root_->panel()->SetGeometryChangedCallback(refresh);
+    browser_widget_->AddObserver(this);
+    widget_->GetRootView()->DeprecatedLayoutImmediately();
+    material_->Refresh();
+    NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+    [parent beginSheet:window completionHandler:nil];
+  }
+
+  ~CommandSettingsEditor() override {
+    closing_ = true;
+    if (browser_widget_) browser_widget_->RemoveObserver(this);
+    CloseWindow();
+  }
+  void RequestClose() {
+    if (closing_) return;
+    closing_ = true;
+    // Widget callbacks must finish before their client-owned tree is deleted.
+    dispatch_async(dispatch_get_main_queue(), closed_);
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    browser_widget_->RemoveObserver(this);
+    browser_widget_ = nullptr;
+    CloseWindow();
+    RequestClose();
+  }
+  void OnWidgetThemeChanged(views::Widget* widget) override {
+    if (!widget_) return;
+    widget_->SetColorModeOverride(browser_widget_->GetColorMode());
+    widget_->SetUserColorOverride(browser_widget_->user_color_override());
+    widget_->ThemeChanged();
+  }
+
+ private:
+  void CloseWindow() {
+    if (!widget_) return;
+    material_.reset();
+    NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+    if (window.sheetParent) [window.sheetParent endSheet:window];
+    root_->controls()->Detach();
+    widget_->CloseNow();
+    widget_.reset();
+    delegate_.reset();
+    root_ = nullptr;
+  }
+  NSViewController* controls_;
+  void (^closed_)(void);
+  raw_ptr<views::Widget> browser_widget_;
+  raw_ptr<CommandSettingsPreviewView> root_ = nullptr;
+  std::unique_ptr<views::WidgetDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  std::unique_ptr<arcium::CommandBarMaterial> material_;
+  bool closing_ = false;
+};
