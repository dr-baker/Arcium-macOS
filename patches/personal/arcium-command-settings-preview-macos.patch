+private struct ArciumCommandBarControls: View {
+    @ObservedObject var store: ArciumSettingsStore
+
+    private func commandLayoutBinding<Value>(_ key: WritableKeyPath<ArciumCommandPanelLayout, Value>) -> Binding<Value> {
+        Binding(get: { store.snapshot.appearance.commandPanelLayout[keyPath: key] },
+                set: { value in
+                    var layout = store.snapshot.appearance.commandPanelLayout
+                    layout[keyPath: key] = value
+                    store.setCommandPanelLayout(layout)
+                })
+    }
+
+    var body: some View {
+        SGroupedSections(showsSurfaces: false, showsDividers: false) {
+            Section("Style") {
+                Group {
+                    SPicker("Categories", selection: commandLayoutBinding(\.labels), options: [
+                        (value: 0, label: "Pill"), (value: 1, label: "Text"), (value: 2, label: "Joined")])
+                    SPicker("Destination icons", selection: commandLayoutBinding(\.icons), options: [
+                        (value: 0, label: "Actions"), (value: 1, label: "Arrows"),
+                        (value: 2, label: "Go / Switch"), (value: 3, label: "Return")])
+                    SPicker("Scope reveal", selection: commandLayoutBinding(\.reveal), options: [
+                        (value: 0, label: "Full tabs"), (value: 1, label: "Icon peek"),
+                        (value: 2, label: "Edge peek"), (value: 3, label: "Hidden"),
+                        (value: 4, label: "Flat"), (value: 5, label: "Divot")])
+                    SToggle("Connected scopes", isOn: commandLayoutBinding(\.connected))
+                    SPicker("Scope width", selection: commandLayoutBinding(\.width), options: [
+                        (value: .flush, label: "Flush"), (value: .iconWidth, label: "Icon-width"),
+                        (value: .offset, label: "Offset")])
+                    SToggle("Scope tints", isOn: commandLayoutBinding(\.scopeTints))
+                    if store.snapshot.appearance.commandPanelLayout.scopeTints {
+                        SSlider("Glow strength", value: commandLayoutBinding(\.glowStrength),
+                            range: 0...2, step: 0.05,
+                            format: { "\(Int(($0 * 100).rounded()))%" },
+                            help: SHelp(description: "Adjust the glow behind Omnibox scopes. 75% is the default strength."))
+                        .accessibilityIdentifier("omnibox-scope-glow-strength")
+                    }
+                    SToggle("Activity dots", isOn: commandLayoutBinding(\.activityDots))
+                }
+                .disabled(!store.snapshot.appearance.commandPanelLayoutAvailable
+                          || store.snapshot.appearance.commandPanelLayoutManaged)
+            }
+        }
+    }
+
+}
