+@interface ArciumWorkshopBackdrop : NSView
+@end
+@implementation ArciumWorkshopBackdrop
+- (BOOL)isOpaque { return YES; }
+- (NSView*)hitTest:(NSPoint)point { return nil; }
+- (void)drawRect:(NSRect)dirtyRect {
+  BOOL dark = [[self.effectiveAppearance bestMatchFromAppearancesWithNames:
+      @[NSAppearanceNameDarkAqua, NSAppearanceNameAqua]] isEqual:NSAppearanceNameDarkAqua];
+  [(dark ? [NSColor colorWithSRGBRed:.17 green:.20 blue:.27 alpha:1]
+          : [NSColor colorWithSRGBRed:.86 green:.90 blue:.97 alpha:1]) setFill];
+  NSRectFill(self.bounds);
+}
+@end
+namespace arcium::workshop {
+namespace {
+std::optional<bool> transparency_override, motion_override;
+BOOL (*original_transparency)(id, SEL) = nullptr;
+BOOL (*original_motion)(id, SEL) = nullptr;
+BOOL WorkshopTransparency(id owner, SEL selector) {
+  return transparency_override.has_value() ? *transparency_override : original_transparency(owner, selector);
+}
+BOOL WorkshopMotion(id owner, SEL selector) {
+  return motion_override.has_value() ? *motion_override : original_motion(owner, selector);
+}
+}
+void ApplyAccessibilityContext(const base::DictValue& document) {
+  // Test-host input override only. Never changes the system accessibility setting.
+  if (!original_transparency) {
+    Method method = class_getInstanceMethod(NSWorkspace.class, @selector(accessibilityDisplayShouldReduceTransparency));
+    original_transparency = reinterpret_cast<BOOL (*)(id, SEL)>(method_getImplementation(method));
+    method_setImplementation(method, reinterpret_cast<IMP>(WorkshopTransparency));
+    Method motion = class_getInstanceMethod(NSWorkspace.class, @selector(accessibilityDisplayShouldReduceMotion));
+    original_motion = reinterpret_cast<BOOL (*)(id, SEL)>(method_getImplementation(motion));
+    method_setImplementation(motion, reinterpret_cast<IMP>(WorkshopMotion));
+  }
+  const auto* context = document.FindDict("context");
+  transparency_override = context ? context->FindBool("reduce_transparency") : std::nullopt;
+  motion_override = context ? context->FindBool("reduce_motion") : std::nullopt;
+  gfx::Animation::SetPrefersReducedMotionForTesting(NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion);
+}
+
+void InstallBackdrop(views::Widget* parent) {
+  CGWarpMouseCursorPosition(CGPointMake(5, 5));
+  NSWindow* window = parent->GetNativeWindow().GetNativeNSWindow();
+  for (NSView* view in window.contentView.subviews.copy)
+    if ([view isKindOfClass:ArciumWorkshopBackdrop.class]) [view removeFromSuperview];
+  auto* backdrop = [[ArciumWorkshopBackdrop alloc] initWithFrame:window.contentView.bounds];
+  backdrop.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  // Above browser content, below the separate child popup. Test-only backdrop.
+  [window.contentView addSubview:backdrop positioned:NSWindowAbove relativeTo:nil];
+}
+bool CapturePopup(views::Widget* popup, const base::FilePath& path) {
+  if (!popup || popup->IsClosed()) return false;
+  NSWindow* window = popup->GetNativeWindow().GetNativeNSWindow();
+  NSTask* capture = [[NSTask alloc] init];
+  capture.executableURL = [NSURL fileURLWithPath:@"/usr/sbin/screencapture"];
+  capture.arguments = @[@"-x", @"-o", @"-a", @"-l", [NSString stringWithFormat:@"%ld", window.windowNumber],
+                       [NSString stringWithUTF8String:path.value().c_str()]];
+  NSError* error = nil;
+  if (![capture launchAndReturnError:&error]) return false;
+  [capture waitUntilExit];
+  return capture.terminationStatus == 0;
+}
+namespace {
+struct HeightTrace {
+  base::RepeatingCallback<CommandPanelPresentation*()> popup;
+  base::FilePath path;
+  base::OnceClosure complete;
+  base::TimeTicks start = base::TimeTicks::Now();
+  base::ListValue samples;
+};
+void SampleHeight(std::shared_ptr<HeightTrace> trace) {
+  auto* popup = trace->popup.Run();
+  const double elapsed = (base::TimeTicks::Now() - trace->start).InMillisecondsF();
+  if (popup && popup->widget() && popup->panel()) {
+    NSWindow* window = popup->widget()->GetNativeWindow().GetNativeNSWindow();
+    NSArray* info = CFBridgingRelease(CGWindowListCopyWindowInfo(kCGWindowListOptionIncludingWindow, static_cast<CGWindowID>(window.windowNumber)));
+    CGRect server = CGRectZero;
+    if (info.count) CGRectMakeWithDictionaryRepresentation((__bridge CFDictionaryRef)info.firstObject[(__bridge NSString*)kCGWindowBounds], &server);
+    trace->samples.Append(base::DictValue().Set("ms", elapsed)
+        .Set("model_height", static_cast<double>(window.frame.size.height))
+        .Set("server_height", static_cast<double>(server.size.height))
+        .Set("target_height", popup->panel()->GetPreferredSize().height())
+        .Set("rows", static_cast<int>(popup->panel()->row_count_for_testing())));
+  }
+  if (elapsed < 700 && popup && popup->is_open()) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(FROM_HERE,
+        base::BindOnce(SampleHeight, trace), base::Milliseconds(5)); return;
+  }
+  base::DictValue result; result.Set("samples", std::move(trace->samples));
+  std::string json; base::JSONWriter::WriteWithOptions(result, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json);
+  base::WriteFile(trace->path, json); std::move(trace->complete).Run();
+}
+}
+void RecordHeightTrace(base::RepeatingCallback<CommandPanelPresentation*()> popup,
+                       base::FilePath path, base::OnceClosure complete) {
+  auto trace = std::make_shared<HeightTrace>(); trace->popup = std::move(popup);
+  trace->path = std::move(path); trace->complete = std::move(complete); SampleHeight(std::move(trace));
+}
+base::DictValue DescribePanel(views::Widget* popup, CommandPanelView* panel) {
+  base::DictValue result;
+  if (!popup || !panel) return result;
+  const auto bounds = popup->GetWindowBoundsInScreen();
+  NSWindow* native = popup->GetNativeWindow().GetNativeNSWindow();
+  result.Set("key", static_cast<bool>(native.keyWindow)); result.Set("main", static_cast<bool>(native.mainWindow));
+  result.Set("parent_main", static_cast<bool>(native.parentWindow.mainWindow));
+  result.Set("parent_key", static_cast<bool>(native.parentWindow.keyWindow));
+  result.Set("opaque", static_cast<bool>(native.opaque));
+  result.Set("palette_panel", static_cast<double>(popup->GetColorProvider()->GetColor(kColorArciumPanel)));
+  result.Set("palette_background", static_cast<double>(popup->GetColorProvider()->GetColor(kColorArciumPanelBackground)));
+  base::ListValue native_views;
+  std::string backend = "solid";
+  for (NSView* view in native.contentView.subviews) {
+    auto item = base::DictValue().Set("class", std::string(NSStringFromClass(view.class).UTF8String))
+        .Set("hidden", static_cast<bool>(view.hidden)).Set("alpha", static_cast<double>(view.alphaValue))
+        .Set("frame", std::string(NSStringFromRect(view.frame).UTF8String));
+    base::ListValue children;
+    for (NSView* child in view.subviews) {
+      const std::string name = NSStringFromClass(child.class).UTF8String;
+      children.Append(name);
+      if (name.find("PublicPanelGlassHostingView") != std::string::npos) backend = "public-liquid";
+      else if (name == "NSGlassEffectView") backend = "native-clear";
+      else if (name == "NSVisualEffectView") backend = "blur";
+    }
+    item.Set("children", std::move(children)); native_views.Append(std::move(item));
+  }
+  result.Set("native_views", std::move(native_views));
+  result.Set("material_backend", backend);
+  const bool dark = popup->GetColorProviderKeyForTesting().color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  result.Set("backdrop_rgb", dark ? base::ListValue().Append(43).Append(51).Append(69)
+                                  : base::ListValue().Append(219).Append(230).Append(247));
+  result.Set("width", bounds.width()); result.Set("height", bounds.height());
+  result.Set("rows", static_cast<int>(panel->row_count_for_testing()));
+  result.Set("scope", panel->scope_for_testing());
+  result.Set("input", panel->input_for_testing()->bounds().ToString());
+  result.Set("body", panel->body_bounds_for_testing().ToString());
+  base::ListValue scopes;
+  for (size_t i = 0; i < panel->scope_count_for_testing(); ++i)
+    scopes.Append(panel->scope_button_for_testing(i)->bounds().ToString());
+  result.Set("scopes", std::move(scopes));
+  return result;
+}
