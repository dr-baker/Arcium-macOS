+namespace arcium::workshop {
+class ArciumCommandWorkshopBrowserTest : public InProcessBrowserTest {
+ protected:
+  void Wait(int milliseconds) {
+    base::RunLoop loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(FROM_HERE,
+        loop.QuitClosure(), base::Milliseconds(milliseconds)); loop.Run();
+  }
+  void Apply(const base::DictValue& document) {
+    ApplyAccessibilityContext(document);
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+    auto* prefs = browser()->GetProfile()->GetPrefs();
+    const auto& context = *document.FindDict("context");
+    prefs->SetDict(kCommandPanelLayoutPref, document.FindDict("layout")->Clone());
+    prefs->SetInteger(arcium::kChromeUIScalePref, static_cast<int>(ContextScale(document) * 100 + .5));
+    for (const auto [name, value] : ContextPreferences(document)) prefs->Set(name, value);
+    helium::HeliumSpaceServiceFactory::GetForProfile(browser()->GetProfile())->SetThemePreviewForBrowser(browser(), ContextTheme(document));
+    const auto mode = context.FindString("mode");
+    view->GetWidget()->SetColorModeOverride(mode && *mode == "light"
+        ? ui::ColorProviderKey::ColorMode::kLight : ui::ColorProviderKey::ColorMode::kDark);
+    NSWindow* window = view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+    window.appearance = [NSAppearance appearanceNamed:mode && *mode == "light" ? NSAppearanceNameAqua : NSAppearanceNameDarkAqua];
+    view->GetWidget()->ThemeChanged();
+    // Match the actual BrowserView viewport, excluding the native frame.
+    auto bounds = view->GetWidget()->GetWindowBoundsInScreen();
+    bounds.set_size(gfx::Size(bounds.width() + *context.FindInt("viewport_width") - view->width(),
+                             bounds.height() + *context.FindInt("viewport_height") - view->height()));
+    view->GetWidget()->SetBounds(bounds); Wait(80);
+    InstallBackdrop(view->GetWidget());
+    CommandPanelPresentation::SetSessionFactoryForTesting(view, base::BindRepeating(
+        [](const base::DictValue* scenario) { return CreateSession(*scenario); }, &document));
+    ASSERT_TRUE(view->ShowArciumCommandBar(true));
+    auto* popup = CommandPanelPresentation::Get(view); ASSERT_TRUE(popup); ASSERT_TRUE(popup->panel());
+    ApplyState(popup->panel(), document);
+  }
+};
+IN_PROC_BROWSER_TEST_F(ArciumCommandWorkshopBrowserTest, ParentDestructionCancelsPendingPublications) {
+  auto* other = CreateBrowser(browser()->GetProfile()); chrome::NewTab(other, NewTabTypes::kNoUserAction);
+  auto* view = BrowserView::GetBrowserViewForBrowser(other);
+  CommandPanelPresentation::SetSessionFactoryForTesting(view, base::BindRepeating([] {
+    return CreateSession(DefaultScenario("streaming"));
+  }));
+  ASSERT_TRUE(view->ShowArciumCommandBar(true)); CloseBrowserSynchronously(other); Wait(350);
+}
+IN_PROC_BROWSER_TEST_F(ArciumCommandWorkshopBrowserTest, ProductionSettingsDesignRoundTrip) {
+  arcium_settings::ArciumSettingsModel model(browser()->GetProfile(), base::DoNothing(), base::DoNothing());
+  for (const auto& document : VisualCases()) {
+    const auto& layout = *document.FindDict("layout");
+    ASSERT_TRUE(model.SetCommandPanelLayout(layout)); EXPECT_EQ(model.GetCommandPanelLayout(), layout);
+    auto legacy = layout.Clone(); legacy.Remove("result_count");
+    ASSERT_TRUE(model.SetCommandPanelLayout(legacy)); EXPECT_EQ(model.GetCommandPanelLayout(), legacy);
+    auto canonical = model.GetCommandPanelLayout(); canonical.Set("result_count", 8);
+    ASSERT_TRUE(model.SetCommandPanelLayout(canonical)); EXPECT_EQ(model.GetCommandPanelLayout(), layout);
+  }
+}
+IN_PROC_BROWSER_TEST_F(ArciumCommandWorkshopBrowserTest, ScriptedPublicationsCancelAndPreserveKeys) {
+  auto document = DefaultScenario("streaming"); auto session = CreateSession(document);
+  std::vector<std::shared_ptr<const CommandPublication>> publications;
+  auto collect = base::BindRepeating([](std::vector<std::shared_ptr<const CommandPublication>>* target,
+      std::shared_ptr<const CommandPublication> value) { target->push_back(std::move(value)); }, &publications);
+  session->Search(kOmniScope, u"old", collect); Wait(70);
+  ASSERT_EQ(publications.size(), 2u); EXPECT_EQ(publications[0]->rows.size(), 4u);
+  EXPECT_EQ(publications[1]->rows.size(), 8u);
+  const auto old_epoch = publications.back()->query_epoch;
+  publications.clear(); session->Search(kOmniScope, u"new", collect); Wait(310);
+  ASSERT_EQ(publications.size(), 5u);
+  for (size_t index = 0; index < publications.size(); ++index) {
+    EXPECT_EQ(publications[index]->query, u"new"); EXPECT_GT(publications[index]->query_epoch, old_epoch);
+    if (index) EXPECT_NE(publications[index]->revision, publications[index-1]->revision);
+  }
+  ASSERT_GT(publications[1]->rows.size(), 1u); ASSERT_FALSE(publications[3]->rows.empty());
+  EXPECT_EQ(publications[1]->rows[1].selection_key, publications[3]->rows[0].selection_key);
+  EXPECT_TRUE(publications.back()->done);
+  session->Search(kOmniScope, u"cancel", collect); session->Cancel();
+  const auto count = publications.size(); Wait(300); EXPECT_EQ(publications.size(), count);
+  ASSERT_GT(publications[1]->rows.size(), 5u);
+  auto desired = publications[1]->rows[5].selection_key;
+  auto restored = VisualCases().front().Clone(); restored.Set("fixture", "streaming");
+  restored.Set("selected_key", desired); Apply(restored); Wait(70);
+  auto* owner = CommandPanelPresentation::Get(BrowserView::GetBrowserViewForBrowser(browser()));
+  EXPECT_EQ(owner->panel()->CaptureSelectionKey(), desired);
+  Wait(90); EXPECT_EQ(owner->panel()->CaptureSelectionKey(), desired);
+  Wait(150); EXPECT_EQ(owner->panel()->CaptureSelectionKey(), desired);
+  auto invalid = document.Clone(); invalid.EnsureDict("context")->Set("scale", 4.);
+  std::string error; EXPECT_FALSE(ValidateScenario(invalid, &error));
+}
+IN_PROC_BROWSER_TEST_F(ArciumCommandWorkshopBrowserTest, ProductionPopupScenariosAndReinvocation) {
+  auto directory = base::CommandLine::ForCurrentProcess()->GetSwitchValuePath("workshop-check-dir");
+  if (directory.empty()) { ASSERT_TRUE(base::GetTempDir(&directory)); directory = directory.AppendASCII("arcium-workshop-browser"); }
+  ASSERT_TRUE(base::CreateDirectory(directory));
+  base::ListValue results;
+  auto cases = VisualCases();
+  for (const auto& document : cases) {
+    SCOPED_TRACE(*document.FindString("name")); Apply(document); Wait(650);
+    auto* popup = CommandPanelPresentation::Get(BrowserView::GetBrowserViewForBrowser(browser()));
+    ASSERT_TRUE(popup && popup->is_open());
+    auto metadata = DescribePanel(popup->widget(), popup->panel());
+    EXPECT_EQ(metadata.FindString("material_backend") ? *metadata.FindString("material_backend") : "missing",
+              *document.FindString("expected_backend"));
+    const auto& name = *document.FindString("name"); metadata.Set("name", name);
+    const bool captured = CapturePopup(popup->widget(), directory.AppendASCII(name + ".png"));
+    metadata.Set("captured", captured); EXPECT_TRUE(captured);
+    Wait(90); EXPECT_TRUE(CapturePopup(popup->widget(), directory.AppendASCII(name + "-repeat.png")));
+    results.Append(std::move(metadata)); popup->Destroy(true);
+  }
+  const auto& document = cases.front(); Apply(document);
+  for (int cycle = 0; cycle < 20; ++cycle) {
+    auto* popup = CommandPanelPresentation::Get(BrowserView::GetBrowserViewForBrowser(browser()));
+    popup->Close(false); ASSERT_TRUE(popup->Show(cycle % 2)); Wait(80);
+    ASSERT_TRUE(popup->is_open()); EXPECT_EQ(popup->new_tab(), static_cast<bool>(cycle % 2));
+  }
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* popup = CommandPanelPresentation::Get(view);
+  // An old posted close must not close a synchronously replaced generation.
+  popup->Close(false); popup->Destroy(true); ASSERT_TRUE(popup->Show(true)); Wait(80);
+  EXPECT_TRUE(popup->is_open());
+  popup->panel()->HandleKeyEvent(nullptr, ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_ESCAPE, 0));
+  Wait(80); EXPECT_FALSE(popup->is_open());
+  popup->Show(true);
+  auto moved = view->GetWidget()->GetWindowBoundsInScreen(); moved.Offset(8, 0);
+  view->GetWidget()->SetBounds(moved); Wait(80); EXPECT_FALSE(popup->is_open());
+  popup->Show(true); moved.set_width(moved.width() + 12);
+  view->GetWidget()->SetBounds(moved); Wait(80); EXPECT_FALSE(popup->is_open());
+  auto streaming = document.Clone(); streaming.Set("fixture", "streaming"); Apply(streaming);
+  base::RunLoop trace_loop;
+  RecordHeightTrace(base::BindRepeating([](BrowserView* owner) { return CommandPanelPresentation::Get(owner); }, base::Unretained(view)),
+                    directory.AppendASCII("height-trace.json"), trace_loop.QuitClosure()); trace_loop.Run();
+  CommandPanelPresentation::SetSessionFactoryForTesting(view, {});
+  base::DictValue report; report.Set("cases", std::move(results)); report.Set("cycles", 20);
+  std::string json; base::JSONWriter::WriteWithOptions(report, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json);
+  ASSERT_TRUE(base::WriteFile(directory.AppendASCII("report.json"), json));
+}
