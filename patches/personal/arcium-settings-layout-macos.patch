+/// These controls apply live through the existing profile-bound settings store.
+/// Dismissal closes the editor; it does not promise to roll back saved changes.
+private struct ArciumLiveSettingsSheet<Content: View>: View {
+    let title: String
+    @ViewBuilder let content: Content
+    @Environment(\.dismiss) private var dismiss
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Text(title).settingsFont(\.section)
+                    .foregroundStyle(theme.textPrimary)
+                    .accessibilityAddTraits(.isHeader)
+                Spacer()
             }
-            .padding(SettingsSpacing.xl)
-            .frame(maxWidth: .infinity, alignment: .leading)
+            .padding(.horizontal, 24).padding(.vertical, 16)
+            ScrollView {
+                VStack(alignment: .leading, spacing: 20) { content }
+                    .frame(maxWidth: .infinity, alignment: .leading)
+                    .padding(.horizontal, 24).padding(.vertical, 8)
+            }
+            HStack {
+                Spacer()
+                Button("Done") { dismiss() }
+                    .buttonStyle(ArciumAccentButtonStyle())
+                    .keyboardShortcut(.defaultAction)
+            }
+            .padding(.horizontal, 24).padding(.vertical, 16)
         }
-        .scrollIndicators(.automatic)
+        .settingsSheetSurface()
+        .frame(minWidth: 520, idealWidth: 680, minHeight: 400, idealHeight: 620)
+        .onExitCommand { dismiss() }
     }
 }
 
