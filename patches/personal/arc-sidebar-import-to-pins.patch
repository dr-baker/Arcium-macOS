+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/importer/helium_arc_sidebar_import.h"
+
+#include "chrome/browser/ui/startup/startup_tab.h"
+#include "chrome/browser/ui/tabs/pin_tab_codec.h"
+#include "chrome/browser/ui/tabs/pinned_tab_codec.h"
+#include "chrome/test/base/testing_profile.h"
+#include "components/user_data_importer/common/imported_bookmark_entry.h"
+#include "content/public/test/browser_task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace {
+
+user_data_importer::ImportedBookmarkEntry MakeEntry(
+    const GURL& url,
+    const std::u16string& title,
+    bool in_toolbar,
+    std::vector<std::u16string> path = {}) {
+  user_data_importer::ImportedBookmarkEntry entry;
+  entry.url = url;
+  entry.title = title;
+  entry.in_toolbar = in_toolbar;
+  entry.is_folder = false;
+  entry.path = std::move(path);
+  return entry;
+}
+
+}  // namespace
+
+class HeliumArcSidebarImportTest : public testing::Test {
+ protected:
+  content::BrowserTaskEnvironment task_environment_;
+  TestingProfile profile_;
+};
+
+TEST_F(HeliumArcSidebarImportTest, RoutesToolbarToFavoritesAndRestToPins) {
+  std::vector<user_data_importer::ImportedBookmarkEntry> entries;
+  entries.push_back(
+      MakeEntry(GURL("https://fav.example/"), u"Fav", /*in_toolbar=*/true));
+  entries.push_back(MakeEntry(GURL("https://pin.example/"), u"Pin",
+                              /*in_toolbar=*/false, {u"Space"}));
+
+  helium::ImportArcSidebarEntriesAsPinsAndFavorites(&profile_, entries,
+                                                    u"Imported from Arc");
+
+  StartupTabs favorites = PinnedTabCodec::ReadPinnedTabs(&profile_);
+  ASSERT_EQ(1u, favorites.size());
+  EXPECT_EQ(StartupTab::Type::kPinned, favorites[0].type);
+  EXPECT_EQ(GURL("https://fav.example/"), favorites[0].url);
+  EXPECT_TRUE(favorites[0].helium_has_home);
+  EXPECT_EQ(u"Fav", favorites[0].helium_home_title);
+
+  StartupTabs pins = PinTabCodec::ReadPins(&profile_);
+  ASSERT_EQ(1u, pins.size());
+  EXPECT_EQ(StartupTab::Type::kPin, pins[0].type);
+  EXPECT_EQ(GURL("https://pin.example/"), pins[0].url);
+  ASSERT_EQ(2u, pins[0].helium_folder_path.size());
+  EXPECT_EQ(u"Imported from Arc", pins[0].helium_folder_path[0].title);
+  EXPECT_EQ(u"Space", pins[0].helium_folder_path[1].title);
+}
+
+TEST_F(HeliumArcSidebarImportTest, MergesWithExistingPins) {
+  StartupTabs existing;
+  existing.emplace_back(GURL("https://existing.example/"),
+                        StartupTab::Type::kPin);
+  existing.back().helium_has_home = true;
+  existing.back().helium_home_title = u"Existing";
+  PinTabCodec::WritePins(&profile_, existing);
+
+  std::vector<user_data_importer::ImportedBookmarkEntry> entries;
+  entries.push_back(MakeEntry(GURL("https://new.example/"), u"New",
+                              /*in_toolbar=*/false));
+
+  helium::ImportArcSidebarEntriesAsPinsAndFavorites(&profile_, entries,
+                                                    u"Imported from Arc");
+
+  StartupTabs pins = PinTabCodec::ReadPins(&profile_);
+  ASSERT_EQ(2u, pins.size());
+  EXPECT_EQ(GURL("https://existing.example/"), pins[0].url);
+  EXPECT_EQ(GURL("https://new.example/"), pins[1].url);
+}
