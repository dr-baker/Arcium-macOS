+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/importer/helium_arc_sidebar_import.h"
+
+#include <utility>
+
+#include "chrome/browser/ui/startup/startup_tab.h"
+#include "chrome/browser/ui/tabs/pin_tab_codec.h"
+#include "chrome/browser/ui/tabs/pinned_tab_codec.h"
+#include "components/user_data_importer/common/imported_bookmark_entry.h"
+
+namespace helium {
+
+namespace {
+
+StartupTabs ConvertToolbarEntriesToFavorites(
+    const std::vector<user_data_importer::ImportedBookmarkEntry>& entries) {
+  StartupTabs favorites;
+  for (const auto& entry : entries) {
+    if (!entry.in_toolbar || entry.is_folder || !entry.url.is_valid()) {
+      continue;
+    }
+    StartupTab tab(entry.url, StartupTab::Type::kPinned);
+    tab.helium_has_home = true;
+    tab.helium_home_title = entry.title;
+    favorites.push_back(std::move(tab));
+  }
+  return favorites;
+}
+
+StartupTabs ConvertEntriesToPins(
+    const std::vector<user_data_importer::ImportedBookmarkEntry>& entries,
+    const std::u16string& top_level_folder_name) {
+  StartupTabs pins;
+  for (const auto& entry : entries) {
+    if (entry.in_toolbar || entry.is_folder || !entry.url.is_valid()) {
+      continue;
+    }
+    StartupTab tab(entry.url, StartupTab::Type::kPin);
+    tab.helium_has_home = true;
+    tab.helium_home_title = entry.title;
+    tab.helium_folder_path.push_back(StartupTab::FolderPathSegment{
+        .title = top_level_folder_name,
+        .collapsed = false,
+    });
+    for (const auto& segment : entry.path) {
+      tab.helium_folder_path.push_back(StartupTab::FolderPathSegment{
+          .title = segment,
+          .collapsed = false,
+      });
+    }
+    pins.push_back(std::move(tab));
+  }
+  return pins;
+}
+
+}  // namespace
+
+void ImportArcSidebarEntriesAsPinsAndFavorites(
+    Profile* profile,
+    const std::vector<user_data_importer::ImportedBookmarkEntry>& entries,
+    const std::u16string& top_level_folder_name) {
+  StartupTabs imported_favorites = ConvertToolbarEntriesToFavorites(entries);
+  if (!imported_favorites.empty()) {
+    StartupTabs merged = PinnedTabCodec::ReadPinnedTabs(profile);
+    // Drop any legacy pin-typed rows that may have landed in the favorites
+    // pref; keep only Chromium favorites.
+    StartupTabs favorites_only;
+    for (auto& tab : merged) {
+      if (tab.type == StartupTab::Type::kPinned) {
+        favorites_only.push_back(std::move(tab));
+      }
+    }
+    favorites_only.insert(favorites_only.end(), imported_favorites.begin(),
+                          imported_favorites.end());
+    PinnedTabCodec::WritePinnedTabs(profile, favorites_only);
+  }
+
+  StartupTabs imported_pins =
+      ConvertEntriesToPins(entries, top_level_folder_name);
+  if (!imported_pins.empty()) {
+    StartupTabs merged = PinTabCodec::ReadPins(profile);
+    merged.insert(merged.end(), imported_pins.begin(), imported_pins.end());
+    PinTabCodec::WritePins(profile, merged);
+  }
+}
+
+}  // namespace helium
