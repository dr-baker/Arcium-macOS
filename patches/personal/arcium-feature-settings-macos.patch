+    @MainActor
+    func testNativeFeatureSettingsReadWriteAndRefreshUseStableKeys() {
+        let delegate = TestDelegate()
+        let store = ArciumSettingsStore(
+            snapshot: NSDictionary(dictionary: [
+                "available": true,
+                "general": [
+                    "availableSection": true,
+                    "peekEnabled": true,
+                    "persistentItemsEnabled": true,
+                    "autoPictureInPictureEnabled": true,
+                    "showSpacesInDockMenu": true,
+                    "available": [
+                        "peek_enabled": true,
+                        "persistent_items_enabled": true,
+                        "auto_picture_in_picture_enabled": true,
+                        "show_spaces_in_dock_menu": true
+                    ]
+                ],
+                "tabs": ["availableSection": true, "tabCyclingMRU": true]
+            ]),
+            delegate: delegate
+        )
+
+        XCTAssertTrue(store.snapshot.general.peekEnabled)
+        XCTAssertTrue(store.snapshot.general.persistentItemsEnabled)
+        XCTAssertTrue(store.snapshot.general.autoPictureInPictureEnabled)
+        XCTAssertTrue(store.snapshot.general.showSpacesInDockMenu)
+
+        store.setGeneralBoolean("peek_enabled", value: false)
+        store.setGeneralBoolean("persistent_items_enabled", value: false)
+        store.setGeneralBoolean("auto_picture_in_picture_enabled", value: false)
+        store.setGeneralBoolean("show_spaces_in_dock_menu", value: false)
+        store.setGeneralBoolean("unknown_setting", value: false)
+
+        XCTAssertEqual(delegate.settings.map(\.key), [
+            "peek_enabled", "persistent_items_enabled",
+            "auto_picture_in_picture_enabled", "show_spaces_in_dock_menu"
+        ])
+        XCTAssertEqual(delegate.settings.map { $0.value as? Bool },
+                       [false, false, false, false])
+
+        store.updateSnapshot(NSDictionary(dictionary: [
+            "available": true,
+            "general": [
+                "availableSection": true,
+                "peekEnabled": false,
+                "persistentItemsEnabled": false,
+                "autoPictureInPictureEnabled": false,
+                "showSpacesInDockMenu": false
+            ],
+            "tabs": ["availableSection": true, "tabCyclingMRU": false]
+        ]))
+        XCTAssertFalse(store.snapshot.general.peekEnabled)
+        XCTAssertFalse(store.snapshot.general.persistentItemsEnabled)
+        XCTAssertFalse(store.snapshot.general.autoPictureInPictureEnabled)
+        XCTAssertFalse(store.snapshot.general.showSpacesInDockMenu)
+        XCTAssertFalse(store.snapshot.tabs.tabCyclingMRU)
+    }
+
+    @MainActor
+    func testUnavailableAutoPiPPrefRetainsStoredValueAndManagedState() {
+        let general = ArciumGeneralSnapshot([
+            "autoPictureInPictureEnabled": true,
+            "available": ["auto_picture_in_picture_enabled": false],
+            "managed": ["auto_picture_in_picture_enabled": true]
+        ])
+
+        XCTAssertTrue(general.autoPictureInPictureEnabled)
+        XCTAssertFalse(general.hasValue("auto_picture_in_picture_enabled"))
+        XCTAssertTrue(general.isManaged("auto_picture_in_picture_enabled"))
+    }
+
+    @MainActor
+    func testLayoutSpecificToolbarSettingsRespectEffectiveLayoutAndAvailability() {
+        func snapshot(
+            layout: Int,
+            verticalTabsFeatureEnabled: Bool = true,
+            collapseAvailable: Bool = true,
+            newTabAvailable: Bool = true,
+            managedCollapse: Bool = false,
+            managedNewTab: Bool = false
+        ) -> ArciumSettingsSnapshot {
+            ArciumSettingsSnapshot(dictionary: NSDictionary(dictionary: [
+                "available": true,
+                "tabs": [
+                    "availableSection": true,
+                    "layout": layout,
+                    "verticalTabsFeatureEnabled": verticalTabsFeatureEnabled
+                ],
+                "appearance": [
+                    "availableSection": true,
+                    "showVerticalTabsCollapseButton": true,
+                    "showDynamicNewTabButton": true,
+                    "available": [
+                        "show_vertical_tabs_collapse_button": collapseAvailable,
+                        "show_dynamic_new_tab_button": newTabAvailable
+                    ],
+                    "managed": [
+                        "show_vertical_tabs_collapse_button": managedCollapse,
+                        "show_dynamic_new_tab_button": managedNewTab
+                    ]
+                ]
+            ]))
+        }
+
+        let vertical = snapshot(layout: ArciumTabsSnapshot.verticalLayoutValue)
+        XCTAssertTrue(vertical.canEditShowVerticalTabsCollapseButton)
+        XCTAssertFalse(vertical.canEditShowDynamicNewTabButton)
+        XCTAssertTrue(vertical.appearance.showVerticalTabsCollapseButton)
+
+        let persistedVerticalWithFeatureDisabled = snapshot(
+            layout: ArciumTabsSnapshot.verticalLayoutValue,
+            verticalTabsFeatureEnabled: false
+        )
+        XCTAssertEqual(
+            persistedVerticalWithFeatureDisabled.tabs.layout,
+            ArciumTabsSnapshot.verticalLayoutValue
+        )
+        XCTAssertTrue(
+            persistedVerticalWithFeatureDisabled.appearance.showVerticalTabsCollapseButton
+        )
+        XCTAssertFalse(
+            persistedVerticalWithFeatureDisabled.canEditShowVerticalTabsCollapseButton
+        )
+
+        let verticalManaged = snapshot(
+            layout: ArciumTabsSnapshot.verticalLayoutValue,
+            managedCollapse: true
+        )
+        XCTAssertTrue(verticalManaged.appearance.showVerticalTabsCollapseButton)
+        XCTAssertFalse(verticalManaged.canEditShowVerticalTabsCollapseButton)
+
+        let dynamic = snapshot(
+            layout: ArciumTabsSnapshot.dynamicLayoutValue
+        )
+        XCTAssertFalse(dynamic.canEditShowVerticalTabsCollapseButton)
+        XCTAssertTrue(dynamic.canEditShowDynamicNewTabButton)
+        XCTAssertTrue(dynamic.appearance.showDynamicNewTabButton)
+
+        let dynamicManaged = snapshot(
+            layout: ArciumTabsSnapshot.dynamicLayoutValue,
+            managedNewTab: true
+        )
+        XCTAssertTrue(dynamicManaged.appearance.showDynamicNewTabButton)
+        XCTAssertFalse(dynamicManaged.canEditShowDynamicNewTabButton)
+
+        let missingCollapsePref = snapshot(
+            layout: ArciumTabsSnapshot.verticalLayoutValue,
+            collapseAvailable: false
+        )
+        XCTAssertFalse(missingCollapsePref.canEditShowVerticalTabsCollapseButton)
+
+        let missingNewTabPref = snapshot(
+            layout: ArciumTabsSnapshot.dynamicLayoutValue,
+            newTabAvailable: false
+        )
+        XCTAssertFalse(missingNewTabPref.canEditShowDynamicNewTabButton)
+    }
+
 
