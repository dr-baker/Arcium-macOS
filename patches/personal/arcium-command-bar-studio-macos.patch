+std::vector<arcium::CommandScopeDescriptor> ExampleScopes() {
+  using namespace arcium;
+  std::vector<CommandScopeDescriptor> scopes;
+  const struct { const char* id; const char16_t* label; SkColor color; const char* symbol; } fixtures[] = {
+      {"omni", u"Omni", SkColorSetRGB(174, 112, 245), "sparkles"},
+      {"web", u"Web", SkColorSetRGB(100, 159, 255), "globe"},
+      {"saved", u"Saved", SkColorSetRGB(205, 182, 112), "pin.fill"},
+      {"youtube", u"YouTube", SkColorSetRGB(240, 75, 70), "play.rectangle.fill"},
+      {"x", u"X", SkColorSetRGB(210, 215, 220), "xmark"},
+      {"chatgpt", u"ChatGPT", SkColorSetRGB(89, 206, 157), "bubble.left.and.text.bubble.right.fill"}};
+  for (const auto& fixture : fixtures) {
+    CommandScopeDescriptor scope;
+    scope.id = fixture.id; scope.label = fixture.label; scope.tint = fixture.color;
+    NSImage* icon = [NSImage imageWithSystemSymbolName:[NSString stringWithUTF8String:fixture.symbol]
+                             accessibilityDescription:nil];
+    NSColor* tint = [NSColor colorWithSRGBRed:SkColorGetR(fixture.color) / 255.0
+                                      green:SkColorGetG(fixture.color) / 255.0
+                                       blue:SkColorGetB(fixture.color) / 255.0 alpha:1];
+    icon = [icon imageWithSymbolConfiguration:
+        [NSImageSymbolConfiguration configurationWithPaletteColors:@[tint]]];
+    scope.icon = gfx::ImageSkiaFromNSImage(icon);
+    scope.provider_id = (scope.id == "omni" || scope.id == "web") ? "native" : "arcium";
+    scope.placeholder = u"Search " + scope.label;
+    scope.search_verb = u"Search " + scope.label;
+    scope.accessibility_description = scope.placeholder;
+    if (scope.id == "omni") {
+      scope.placeholder = u"Search tabs, Pins, Favorites and the web";
+      scope.accessibility_description = u"Search all browser results";
+    } else if (scope.id == "saved") {
+      scope.placeholder = u"Search Pins, Favorites and folders";
+      scope.accessibility_description = u"Search saved Pins, Favorites and folders";
+    }
+    scopes.push_back(std::move(scope));
+  }
+  return scopes;
+}
