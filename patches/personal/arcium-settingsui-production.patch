@@ -0,0 +1,19 @@
+import Foundation
+
+/// The control-accent role selected from the authoritative backdrop glows.
+///
+/// A nil ``colorID`` keeps the palette's existing explicit accent. When an ID
+/// is present, hosts resolve it against the current glow IDs and may fall back
+/// to the first glow if an imported preset no longer contains that ID.
+public struct SettingsControlAccent: Codable, Equatable, Sendable {
+    public var colorID: String?
+    public var customColor: SettingsRGB
+
+    public init(
+        colorID: String? = nil,
+        customColor: SettingsRGB = SettingsOKLCH(lightness: 0.65, chroma: 0.14, hue: 245).rgb
+    ) {
+        self.colorID = colorID
+        self.customColor = customColor
