+    @MainActor
+    func testAdapterEnforcesNativePointAndGrainConstraints() throws {
+        let glows = (0..<5).map { index in
+            let id = index == 4 ? "point-1" : "point-\(index + 1)"
+            return SettingsStyleGlow(
+                id: id,
+                color: SettingsRGB(red: 0.1 + Double(index) * 0.1, green: 0.4, blue: 0.8),
+                x: -0.2 + Double(index) * 0.3,
+                y: 1.2 - Double(index) * 0.1,
+                radius: 0.01,
+                intensity: 1.4
+            )
+        }
+        let configuration = SettingsBackdropConfiguration(
+            grain: 0.9,
+            glows: glows,
+            radiusReference: .shortestEdge
+        )
+        let dictionary = ArciumChromeAppearanceAdapter.dictionaryRepresentation(for: configuration)
+        let points = try XCTUnwrap(dictionary["points"] as? [[String: Any]])
+
+        XCTAssertEqual(points.count, 4)
+        XCTAssertEqual(try XCTUnwrap(dictionary["grain"] as? Double), 0.3, accuracy: 0.0001)
+        XCTAssertTrue(points.allSatisfy { point in
+            guard let radius = point["radius"] as? Double,
+                  let opacity = point["opacity"] as? Double,
+                  let x = point["x"] as? Double,
+                  let y = point["y"] as? Double else { return false }
+            return (0.1...1.5).contains(radius)
+                && (0...1).contains(opacity)
+                && (0...1).contains(x)
+                && (0...1).contains(y)
+        })
+        XCTAssertTrue(ArciumChromeAppearanceSnapshot.Configuration(dictionary).isValid)
+    }
