+/// Renders only the native material and its tint. Hosts can compose their own
+/// animated glow layers beneath and above it, followed by one grain overlay.
+/// This view does not change window properties.
+public struct SettingsGlassSurface: View {
+    public let configuration: SettingsBackdropConfiguration
+    public let colorScheme: ColorScheme
+    public let activeMaterial: SettingsBackdropMaterial?
+    public let effectsAvailable: Bool
+    public let glowsBehindGlass: Bool
+
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+
+    public init(
+        configuration: SettingsBackdropConfiguration,
+        colorScheme: ColorScheme,
+        activeMaterial: SettingsBackdropMaterial? = nil,
+        effectsAvailable: Bool = true,
+        glowsBehindGlass: Bool = false
+    ) {
+        self.configuration = configuration.normalized()
+        self.colorScheme = colorScheme
+        self.activeMaterial = activeMaterial
+        self.effectsAvailable = effectsAvailable
+        self.glowsBehindGlass = glowsBehindGlass
+    }
+
+    public var body: some View {
+        ZStack {
+            if resolvedMaterial == .liquidGlass {
+                // Keep the glass in SwiftUI's compositor. An AppKit glass sibling
+                // behind an NSHostingView can sample hover-driven control redraws.
+                Color.clear
+                    .glassEffect(
+                        configuration.glassStyle == .clear ? .clear : .regular,
+                        in: Rectangle()
+                    )
+                    .opacity(surfaceOpacity)
+            } else {
+                SettingsNativeBackdrop(
+                    material: resolvedMaterial,
+                    frostedStyle: configuration.frostedStyle,
+                    opacity: surfaceOpacity,
+                    baseColor: NSColor(theme.windowCanvas),
+                    glowsBehindGlass: glowsBehindGlass
+                )
+            }
+            tintOverlay
+        }
+        .environment(\.colorScheme, colorScheme)
+        .allowsHitTesting(false)
+        .accessibilityHidden(true)
+        .ignoresSafeArea()
+    }
+
+    private var customizationActive: Bool {
+        configuration.enabled && effectsAvailable && !reduceTransparency
+    }
+
+    private var resolvedMaterial: SettingsBackdropMaterial {
+        guard customizationActive else { return .solid }
+        let requested = activeMaterial ?? configuration.material
+        return requested == .auto ? .liquidGlass : requested
+    }
+
+    private var surfaceOpacity: Double {
+        customizationActive ? bounded(configuration.materialOpacity, in: 0...1) : 1
+    }
+
+    @ViewBuilder private var tintOverlay: some View {
+        switch resolvedMaterial {
+        case .liquidGlass:
+            theme.windowCanvas
+                .opacity(customizationActive ? bounded(configuration.glassTintOpacity, in: 0...1) : 0)
+        case .frosted:
+            theme.windowCanvas
+                .opacity(customizationActive ? bounded(0.12 * configuration.frostedTintStrength, in: 0...1) : 0)
+        case .auto, .solid:
+            EmptyView()
+        }
+    }
+
+    private func bounded(_ value: Double, in range: ClosedRange<Double>) -> Double {
+        value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : range.lowerBound
+    }
+}
+
+private struct SettingsNativeBackdrop: NSViewRepresentable {
+    let material: SettingsBackdropMaterial
+    let frostedStyle: SettingsBackdropFrostedStyle
+    let opacity: Double
+    let baseColor: NSColor
+    let glowsBehindGlass: Bool
+
+    func makeNSView(context: Context) -> SettingsNativeBackdropView {
+        SettingsNativeBackdropView()
+    }
+
+    func updateNSView(_ view: SettingsNativeBackdropView, context: Context) {
+        view.update(
+            material: material,
+            frostedStyle: frostedStyle,
+            opacity: opacity,
+            baseColor: baseColor,
+            glowsBehindGlass: glowsBehindGlass
+        )
+    }
+
+    static func dismantleNSView(_ view: SettingsNativeBackdropView, coordinator: ()) {
+        view.removeSurface()
+    }
+}
+
+private final class SettingsNativeBackdropView: NSView {
+    private var surface: NSView?
+    private var material: SettingsBackdropMaterial?
+    private var appliedFrostedStyle: SettingsBackdropFrostedStyle?
+    private var appliedGlowsBehindGlass: Bool?
+    private var appliedOpacity: CGFloat?
+
+    override init(frame frameRect: NSRect) {
+        super.init(frame: frameRect)
+        wantsLayer = true
+    }
+
+    required init?(coder: NSCoder) { nil }
+
+    func update(
+        material: SettingsBackdropMaterial,
+        frostedStyle: SettingsBackdropFrostedStyle,
+        opacity: Double,
+        baseColor: NSColor,
+        glowsBehindGlass: Bool
+    ) {
+        if self.material != material {
+            surface?.removeFromSuperview()
+            let nextSurface = makeSurface(material: material, frostedStyle: frostedStyle)
+            addSubview(nextSurface)
+            nextSurface.autoresizingMask = [.width, .height]
+            surface = nextSurface
+            self.material = material
+            appliedFrostedStyle = nil
+            appliedGlowsBehindGlass = nil
+            appliedOpacity = nil
+        }
+
+        updateSurface(
+            material: material,
+            frostedStyle: frostedStyle,
+            baseColor: baseColor,
+            glowsBehindGlass: glowsBehindGlass
+        )
+        if surface?.frame != bounds {
+            surface?.frame = bounds
+        }
+        // A solid fallback is the opaque canvas itself. The configurable
+        // opacity belongs to native material surfaces and must not fade the
+        // window's base color.
+        let nextOpacity = CGFloat(material == .solid
+            ? 1
+            : (opacity.isFinite ? min(max(opacity, 0), 1) : 1))
+        if appliedOpacity != nextOpacity {
+            surface?.alphaValue = nextOpacity
+            appliedOpacity = nextOpacity
+        }
+    }
+
+    func removeSurface() {
+        surface?.removeFromSuperview()
+        surface = nil
+        material = nil
+        appliedFrostedStyle = nil
+        appliedGlowsBehindGlass = nil
+        appliedOpacity = nil
+    }
+
+    override func layout() {
+        super.layout()
+        if surface?.frame != bounds {
+            surface?.frame = bounds
+        }
+    }
+
+    override func hitTest(_ point: NSPoint) -> NSView? { nil }
+
+    private func makeSurface(
+        material: SettingsBackdropMaterial,
+        frostedStyle: SettingsBackdropFrostedStyle
+    ) -> NSView {
+        if material == .solid {
+            return SettingsPlainSurfaceView()
+        }
+
+        let view = SettingsVisualEffectSurfaceView()
+        view.material = material == .frosted ? visualMaterial(for: frostedStyle) : .underWindowBackground
+        view.blendingMode = .behindWindow
+        view.state = .active
+        view.isEmphasized = false
+        return view
+    }
+
+    private func updateSurface(
+        material: SettingsBackdropMaterial,
+        frostedStyle: SettingsBackdropFrostedStyle,
+        baseColor: NSColor,
+        glowsBehindGlass: Bool
+    ) {
+        if let plain = surface as? SettingsPlainSurfaceView {
+            plain.setBackgroundColor(baseColor)
+        }
+
+        if let visual = surface as? SettingsVisualEffectSurfaceView {
+            if material == .frosted, appliedFrostedStyle != frostedStyle {
+                visual.material = visualMaterial(for: frostedStyle)
+                appliedFrostedStyle = frostedStyle
+            }
+            if appliedGlowsBehindGlass != glowsBehindGlass {
+                visual.blendingMode = glowsBehindGlass ? .withinWindow : .behindWindow
+                appliedGlowsBehindGlass = glowsBehindGlass
+            }
+        }
+    }
+
+    private func visualMaterial(
+        for style: SettingsBackdropFrostedStyle
+    ) -> NSVisualEffectView.Material {
+        switch style {
+        case .automatic: .underWindowBackground
+        case .sidebar: .sidebar
+        case .menu: .menu
+        case .popover: .popover
+        case .hud: .hudWindow
+        }
+    }
+}
+
+private final class SettingsPlainSurfaceView: NSView {
+    private var appliedBackgroundColor: NSColor?
+
+    override init(frame frameRect: NSRect) {
+        super.init(frame: frameRect)
+        wantsLayer = true
+    }
+
+    required init?(coder: NSCoder) { nil }
+
+    func setBackgroundColor(_ color: NSColor) {
+        guard appliedBackgroundColor?.isEqual(color) != true else { return }
+        appliedBackgroundColor = color
+        layer?.backgroundColor = (color.usingColorSpace(.deviceRGB) ?? color).cgColor
+    }
+
+    override func hitTest(_ point: NSPoint) -> NSView? { nil }
+}
+
+private final class SettingsVisualEffectSurfaceView: NSVisualEffectView {
+    override func hitTest(_ point: NSPoint) -> NSView? { nil }
+}
+
+/// Opt-in attachment that makes the containing window transparent and uses a
+/// full-size content view, restoring the original window state on removal.
+public struct SettingsGlassWindowAttachment: View {
+    public init() {}
+
+    public var body: some View {
+        SettingsGlassWindowAttachmentRepresentable()
+            .allowsHitTesting(false)
+            .accessibilityHidden(true)
+    }
+}
+
+private struct SettingsGlassWindowAttachmentRepresentable: NSViewRepresentable {
+    func makeNSView(context: Context) -> SettingsGlassWindowAttachmentView {
+        SettingsGlassWindowAttachmentView()
+    }
+
+    func updateNSView(_ view: SettingsGlassWindowAttachmentView, context: Context) {
+        view.configureWindowIfNeeded()
+    }
+
+    static func dismantleNSView(_ view: SettingsGlassWindowAttachmentView, coordinator: ()) {
+        view.restoreWindow()
+    }
+}
+
+private final class SettingsGlassWindowAttachmentView: NSView {
+    private weak var configuredWindow: NSWindow?
+    private var originalBackground: NSColor?
+    private var originalOpaque = true
+    private var originalStyleMask: NSWindow.StyleMask = []
+    private var originalTitlebarTransparent = false
+
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        configureWindowIfNeeded()
+    }
+
+    func configureWindowIfNeeded() {
+        guard let window else {
+            restoreWindow()
+            return
+        }
+        if configuredWindow !== window {
+            restoreWindow()
+            configuredWindow = window
+            originalBackground = window.backgroundColor
+            originalOpaque = window.isOpaque
+            originalStyleMask = window.styleMask
+            originalTitlebarTransparent = window.titlebarAppearsTransparent
+        }
+        if window.isOpaque {
+            window.isOpaque = false
+        }
+        if window.backgroundColor?.isEqual(NSColor.clear) != true {
+            window.backgroundColor = .clear
+        }
+        if !window.titlebarAppearsTransparent {
+            window.titlebarAppearsTransparent = true
+        }
+        if !window.styleMask.contains(.fullSizeContentView) {
+            window.styleMask.insert(.fullSizeContentView)
+        }
+    }
+
+    func restoreWindow() {
+        guard let window = configuredWindow else { return }
+        window.isOpaque = originalOpaque
+        window.backgroundColor = originalBackground
+        window.styleMask = originalStyleMask
+        window.titlebarAppearsTransparent = originalTitlebarTransparent
+        configuredWindow = nil
+    }
+
+    override func hitTest(_ point: NSPoint) -> NSView? { nil }
+}
