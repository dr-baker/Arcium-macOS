+    @MainActor
+    func testLinkedControlAccentTracksGlowColorAndFallsBackWhenGlowRemoved() throws {
+        let delegate = TestDelegate()
+        let original = makeConfiguration()
+        let store = ArciumSettingsStore(
+            snapshot: snapshot(
+                chrome: original,
+                managed: false,
+                available: true,
+                paletteAvailable: true
+            ),
+            delegate: delegate
+        )
+
+        var linkedPalette = SettingsPaletteConfiguration()
+        linkedPalette.controlColorID = "yellow"
+        store.applyControlAccent(linkedPalette.controlAccent)
+        delegate.settings.removeAll()
+
+        var recolored = original
+        recolored.glows[0].color = SettingsRGB(hex: "#FF00AA")!
+        store.setChromeAppearance(recolored)
+
+        XCTAssertEqual(delegate.settings.map(\.key), ["chrome_appearance", "shared_palette"])
+        let linkedPayload = try XCTUnwrap(delegate.settings.last?.value as? [String: Any])
+        let linkedConfiguration = try XCTUnwrap(linkedPayload["configuration"] as? [String: Any])
+        XCTAssertEqual(linkedConfiguration["controlColorID"] as? String, "yellow")
+        let linkedData = try JSONSerialization.data(withJSONObject: linkedConfiguration)
+        let resolvedLinked = try JSONDecoder().decode(
+            SettingsPaletteConfiguration.self,
+            from: linkedData
+        )
+        XCTAssertEqual(resolvedLinked.customAccent, recolored.glows[0].color.oklch)
+
+        var removed = recolored
+        removed.glows.removeFirst()
+        store.setChromeAppearance(removed)
+
+        let fallbackPayload = try XCTUnwrap(delegate.settings.last?.value as? [String: Any])
+        let fallbackConfiguration = try XCTUnwrap(fallbackPayload["configuration"] as? [String: Any])
+        XCTAssertEqual(fallbackConfiguration["controlColorID"] as? String, "blue")
+    }
