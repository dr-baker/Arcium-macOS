+
+  base::DictValue changed_payload = MakeSharedPalettePayloadForTesting();
+  base::DictValue* changed_configuration =
+      changed_payload.FindDict("configuration");
+  ASSERT_TRUE(changed_configuration);
+  changed_configuration->Set("hue", 310.0);
+  changed_payload.Set("accent", "#7B40D2");
+  ASSERT_TRUE(settings.SetSharedPalette(changed_payload));
+  ASSERT_TRUE(settings.SetSharedPalette(payload));
+
+  const base::DictValue saved_palette =
+      profile->GetPrefs()->GetDict(arcium_settings::kSharedPalettePref).Clone();
+  {
+    test::ThemeServiceChangedWaiter waiter(theme_service);
+    InstallExtension(test_data_dir_.AppendASCII("theme_minimal/"), 1);
+    waiter.WaitForThemeChanged();
+  }
+  ASSERT_TRUE(theme_service->UsingExtensionTheme());
+
+  const std::string extension_theme_id = theme_service->GetThemeID();
+  const SkColor extension_toolbar_color =
+      GetColorProviderFor(browser())->GetColor(kColorToolbar);
+  ASSERT_EQ(SkColorSetRGB(207, 221, 192), extension_toolbar_color);
+  ASSERT_EQ(extension_toolbar_color,
+            theme_service->GetColorProvider()->GetColor(kColorToolbar));
+
+  const base::DictValue snapshot = settings.GetSharedPalette();
+  ASSERT_TRUE(snapshot.FindBool("available").value_or(false));
+  EXPECT_FALSE(snapshot.FindBool("managed").value_or(true));
+  EXPECT_FALSE(snapshot.FindBool("editable").value_or(true));
+  ASSERT_TRUE(snapshot.FindString("editabilityReason"));
+  EXPECT_EQ("extension_theme", *snapshot.FindString("editabilityReason"));
+  ASSERT_TRUE(snapshot.FindString("accent"));
+  EXPECT_EQ(ColorToHexForTesting(extension_toolbar_color),
+            *snapshot.FindString("accent"));
+  EXPECT_FALSE(snapshot.FindBool("overrideActive").value_or(true));
+
+  EXPECT_FALSE(settings.SetSharedPalette(changed_payload));
+  EXPECT_FALSE(settings.ResetSharedPalette());
+  EXPECT_EQ(saved_palette,
+            profile->GetPrefs()->GetDict(arcium_settings::kSharedPalettePref));
+  EXPECT_TRUE(theme_service->UsingExtensionTheme());
+  EXPECT_EQ(extension_theme_id, theme_service->GetThemeID());
+  EXPECT_EQ(extension_toolbar_color,
+            GetColorProviderFor(browser())->GetColor(kColorToolbar));
