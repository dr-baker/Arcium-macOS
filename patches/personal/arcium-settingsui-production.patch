+        if customizationActive {
+            GeometryReader { geometry in
+                ForEach(configuration.glows) { glow in
+                    RadialGradient(
+                        colors: [
+                            glow.color.color.opacity(
+                                bounded(
+                                    glow.intensity * bounded(intensity, in: 0...1),
+                                    in: 0...1
+                                )
+                            ),
+                            .clear
+                        ],
+                        center: UnitPoint(x: glow.x, y: glow.y),
+                        startRadius: 0,
+                        endRadius: configuration.radiusReference.length(in: geometry.size)
+                            * CGFloat(glow.radius)
+                            * CGFloat(bounded(sizeMultiplier, in: 0.5...2))
+                    )
+                }
+            }
+        }
+    }
+
+    @ViewBuilder private var grainLayer: some View {
+        if customizationActive {
+            SettingsBackdropGrainOverlay(
+                finish: SettingsBackdropFinish(grain: configuration.grain, grainBlendMode: .normal),
+                grainScale: configuration.grainScale
+            )
+        }
+    }
+
+    private func bounded(_ value: Double, in range: ClosedRange<Double>) -> Double {
+        value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : range.lowerBound
+    }
+}
