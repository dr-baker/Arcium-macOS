+/// Renders the configurable glass backdrop without changing the
+/// hosting window. Add ``SettingsGlassWindowAttachment`` separately when a
+/// host opts into transparent, full-size window chrome.
+public struct SettingsGlassBackdrop: View {
+    public let configuration: SettingsBackdropConfiguration
+    public let colorScheme: ColorScheme
+    public let activeMaterial: SettingsBackdropMaterial?
+    public let effectsAvailable: Bool
+    public let glowsBehindGlass: Bool
+
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+
+    public init(
+        configuration: SettingsBackdropConfiguration,
+        colorScheme: ColorScheme,
+        activeMaterial: SettingsBackdropMaterial? = nil,
+        effectsAvailable: Bool = true,
+        glowsBehindGlass: Bool = false
+    ) {
+        self.configuration = configuration.normalized()
+        self.colorScheme = colorScheme
+        self.activeMaterial = activeMaterial
+        self.effectsAvailable = effectsAvailable
+        self.glowsBehindGlass = glowsBehindGlass
+    }
+
+    public var body: some View {
+        ZStack {
+            if glowsBehindGlass {
+                glowLayer(
+                    intensity: configuration.tintStrength * 0.5,
+                    sizeMultiplier: 1
+                )
+            }
+            SettingsGlassSurface(
+                configuration: configuration,
+                colorScheme: colorScheme,
+                activeMaterial: activeMaterial,
+                effectsAvailable: effectsAvailable,
+                glowsBehindGlass: glowsBehindGlass
+            )
+            glowLayer(intensity: configuration.tintStrength, sizeMultiplier: 1)
+            grainLayer
+        }
+        .environment(\.colorScheme, colorScheme)
+        .allowsHitTesting(false)
+        .accessibilityHidden(true)
+        .ignoresSafeArea()
+    }
+
