+import Foundation
+import SettingsUI
+
+/// Bridges Arcium's PrefService dictionary to SettingsUI's typed backdrop
+/// configuration. The native browser renderer remains the owner of the
+/// dictionary and applies the values after the delegate callback.
+enum ArciumChromeAppearanceAdapter {
+    static let grainMaximumOpacity = 0.3
+
+    static let opacityCurve: SettingsGlassOpacityCurve = {
+        (try? SettingsGlassOpacityCurve.quadratic(
+            intercept: 0.70,
+            linear: 0.26235294117647084,
+            quadratic: 0.03764705882352913
+        )) ?? .identity
+    }()
+
+    static func configuration(
+        from snapshot: ArciumChromeAppearanceSnapshot.Configuration
+    ) -> SettingsBackdropConfiguration? {
+        guard snapshot.isValid,
+              let material = SettingsBackdropMaterial(rawValue: snapshot.material),
+              let glassStyle = SettingsBackdropGlassStyle(rawValue: snapshot.glassStyle),
+              let frostedStyle = SettingsBackdropFrostedStyle(rawValue: snapshot.frostedStyle) else {
+            return nil
+        }
+
+        let glows = snapshot.points.compactMap { point -> SettingsStyleGlow? in
+            guard let color = SettingsRGB(hex: point.color) else { return nil }
+            return SettingsStyleGlow(
+                id: point.id,
+                color: color,
+                x: point.x,
+                y: point.y,
+                radius: point.radius,
+                intensity: point.opacity
+            )
+        }
+        guard glows.count == snapshot.points.count else { return nil }
+
+        return SettingsBackdropConfiguration(
+            enabled: snapshot.enabled,
+            material: material,
+            materialOpacity: snapshot.materialOpacity,
+            glassTintOpacity: snapshot.glassTintOpacity,
+            glassStyle: glassStyle,
+            frostedStyle: frostedStyle,
+            frostedTintStrength: snapshot.frostedTintStrength,
+            tintStrength: snapshot.tintStrength,
+            grain: snapshot.grain,
+            grainScale: snapshot.grainScale,
+            matchColorAdjustments: snapshot.matchColorAdjustments,
+            colorHarmony: snapshot.colorHarmony,
+            glows: glows,
+            radiusReference: .shortestEdge
+        )
+    }
+
+    /// Converts typed editor state back to the native dictionary shape. The
+    /// bridge owns native limits because the shared editor intentionally uses
+    /// broader reusable ranges.
+    static func dictionaryRepresentation(
+        for configuration: SettingsBackdropConfiguration
+    ) -> [String: Any] {
+        let configuration = configuration.normalized()
+        return [
+            "enabled": configuration.enabled,
+            "material": configuration.material.rawValue,
+            "materialOpacity": bounded(configuration.materialOpacity, to: 0...1),
+            "glassTintOpacity": bounded(configuration.glassTintOpacity, to: 0...1),
+            "glassStyle": configuration.glassStyle.rawValue,
+            "frostedStyle": configuration.frostedStyle.rawValue,
+            "frostedTintStrength": bounded(configuration.frostedTintStrength, to: 0...2),
+            "tintStrength": bounded(configuration.tintStrength, to: 0...1),
+            "grain": bounded(configuration.grain, to: 0...grainMaximumOpacity),
+            "grainScale": bounded(configuration.grainScale, to: 0.5...2),
+            "matchColorAdjustments": configuration.matchColorAdjustments,
+            "colorHarmony": configuration.colorHarmony.rawValue,
+            "points": nativePoints(configuration.glows)
+        ]
+    }
+
+    private static func nativePoints(_ glows: [SettingsStyleGlow]) -> [[String: Any]] {
+        var seen = Set<String>()
+        return glows.prefix(4).enumerated().map { index, glow in
+            let fallbackID = "point-\(index + 1)"
+            var id = glow.id.isEmpty ? fallbackID : glow.id
+            if seen.contains(id) {
+                id = fallbackID
+                var suffix = 2
+                while seen.contains(id) {
+                    id = "\(fallbackID)-\(suffix)"
+                    suffix += 1
+                }
+            }
+            seen.insert(id)
+            return [
+                "id": id,
+                "color": glow.color.hex,
+                "x": bounded(glow.x, to: 0...1),
+                "y": bounded(glow.y, to: 0...1),
+                "radius": bounded(glow.radius, to: 0.1...1.5),
+                "opacity": bounded(glow.intensity, to: 0...1)
+            ]
+        }
+    }
+
+    private static func bounded(_ value: Double, to range: ClosedRange<Double>) -> Double {
+        value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : range.lowerBound
+    }
+}
+
+extension ArciumChromeAppearanceSnapshot.Configuration {
+    var backdropConfiguration: SettingsBackdropConfiguration? {
+        ArciumChromeAppearanceAdapter.configuration(from: self)
+    }
+}
