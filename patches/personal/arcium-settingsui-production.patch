@@ -0,0 +1,75 @@
+import SwiftUI
+
+/// A compact selectable tile backed by a native ``Toggle``.
+///
+/// The icon and label stay visible in compact grids while the underlying
+/// control retains Toggle's on/off semantics and keyboard behavior.
+public struct SIconToggle: View {
+    private let label: String
+    private let systemImage: String
+    private let help: String?
+    @Binding private var isOn: Bool
+    @Environment(\.settingsTheme) private var theme
+
+    public init(
+        _ label: String,
+        systemImage: String,
+        isOn: Binding<Bool>,
+        help: String? = nil
+    ) {
+        self.label = label
+        self.systemImage = systemImage
+        _isOn = isOn
+        self.help = help
+    }
+
+    public var body: some View {
+        Toggle(isOn: $isOn) {
+            HStack(alignment: .center, spacing: SettingsSpacing.xs) {
+                Image(systemName: systemImage)
+                    .settingsSymbol()
+                    .foregroundStyle(isOn ? theme.selectionStrong : theme.textSecondary)
+                    .accessibilityHidden(true)
+
+                Text(label)
+                    .settingsFont(\.label)
+                    .foregroundStyle(theme.textPrimary)
+                    .lineLimit(2)
+                    .multilineTextAlignment(.leading)
+
+                Spacer(minLength: 0)
+            }
+            .frame(maxWidth: .infinity, minHeight: 40, alignment: .leading)
+            .padding(.horizontal, SettingsSpacing.sm)
+            .padding(.vertical, SettingsSpacing.xs)
+            .background(
+                theme.controlSelectionFill.opacity(isOn ? 0.34 : 0.12),
+                in: .rect(cornerRadius: SettingsRadius.control)
+            )
+            .overlay {
+                RoundedRectangle(cornerRadius: SettingsRadius.control)
+                    .stroke(
+                        isOn ? theme.selectionStrong.opacity(0.72) : theme.borderControl.opacity(0.42),
+                        lineWidth: isOn ? 1 : theme.borderWidth
+                    )
+            }
+            .contentShape(.rect)
+        }
+        .toggleStyle(.button)
+        .buttonStyle(.plain)
+        .accessibilityLabel(label)
+        .accessibilityValue(isOn ? "On" : "Off")
+        .applyOptionalHelp(help)
+    }
+}
+
+private extension View {
+    @ViewBuilder
+    func applyOptionalHelp(_ help: String?) -> some View {
+        if let help, !help.isEmpty {
+            self.help(help)
+        } else {
+            self
+        }
+    }
+}
