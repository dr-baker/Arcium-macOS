--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_settings_swift/Tests/ArciumSettingsUITests/ArciumAppearanceDeepLinkTests.swift
@@ -0,0 +1,63 @@
+// Copyright 2026 The Helium Authors
+// SPDX-License-Identifier: GPL-3.0-only
+import AppKit
+import Foundation
+import XCTest
+@testable import ArciumSettingsUI
+
+@MainActor
+final class ArciumAppearanceDeepLinkTests: XCTestCase {
+    func testFacadeExposesExplicitAppearanceSelectionWithoutPreferenceWrites() {
+        let delegate = Delegate()
+        let controller = ArciumSettingsUIController(snapshot: snapshot(), delegate: delegate)
+        XCTAssertTrue(controller.responds(to: NSSelectorFromString("selectAppearanceCategory")))
+        XCTAssertTrue(controller.selectAppearanceCategory())
+        XCTAssertEqual(delegate.actions, ["cancel_recording"])
+        XCTAssertTrue(delegate.settings.isEmpty)
+    }
+
+    func testOrdinarySnapshotKeepsExplicitAppearanceSelection() {
+        let delegate = Delegate()
+        let controller = ArciumSettingsUIController(snapshot: snapshot(), delegate: delegate)
+        XCTAssertTrue(controller.selectAppearanceCategory())
+        controller.updateSnapshot(snapshot(spaceID: "space-b"))
+        XCTAssertTrue(controller.selectAppearanceCategory())
+        // A reset to General during update would require another navigation
+        // and send another cancel_recording action here.
+        XCTAssertEqual(delegate.actions, ["cancel_recording"])
+        XCTAssertTrue(delegate.settings.isEmpty)
+    }
+
+    func testStoreUpdatesPreserveOrdinaryCategoryAndCapturedSpace() {
+        let delegate = Delegate()
+        let store = ArciumSettingsStore(snapshot: snapshot(), delegate: delegate,
+                                        presetBundleURL: nil)
+        store.selectCategory(.shortcuts)
+        store.updateSnapshot(snapshot(spaceID: "space-b"))
+        XCTAssertEqual(store.selectedCategory, .shortcuts)
+        XCTAssertEqual(store.snapshot.appearance.spacePalette.id, "space-b")
+        XCTAssertEqual(delegate.actions, ["cancel_recording"])
+        XCTAssertTrue(delegate.settings.isEmpty)
+    }
+
+    private func snapshot(spaceID: String = "space-a") -> NSDictionary {
+        ["available": true, "appearance": [
+            "availableSection": true,
+            "spacePalette": ["id": spaceID, "name": "Example", "available": true]
+        ]]
+    }
+
+    @MainActor
+    private final class Delegate: NSObject, ArciumSettingsUIDelegate {
+        var actions: [String] = []
+        var settings: [String] = []
+
+        func settingChanged(key: String, value: Any) {
+            settings.append(key)
+        }
+
+        func actionInvoked(name: String, payload: NSDictionary) {
+            actions.append(name)
+        }
+    }
+}
