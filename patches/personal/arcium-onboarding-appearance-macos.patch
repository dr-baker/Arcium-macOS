+bool ShowAppearanceForBrowser(BrowserWindowInterface* browser) {
+  if (!browser) {
+    return false;
+  }
+  Profile* profile = browser->GetProfile()->GetOriginalProfile();
+  auto* spaces = helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  if (!spaces) {
+    return false;
+  }
+  const auto id =
+      spaces->GetSpaceIdForBrowser(browser->GetBrowserForMigrationOnly());
+  // Never fall back to the model's previous Space for an explicit deep link.
+  return !id.empty() && ShowForSpace(profile, id, true);
+}
