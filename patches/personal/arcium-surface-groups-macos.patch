+class EmbeddedSurfaceMaterialMac : public EmbeddedSurfaceMaterial {
+ public:
+  explicit EmbeddedSurfaceMaterialMac(
+      base::RepeatingClosure appearance_changed) {
+    host_ = [[ArciumEmbeddedMaterialHost alloc] initWithFrame:NSZeroRect];
+    host_.wantsLayer = YES;
+    material_ = [[ArciumPanelMaterialView alloc] initWithFrame:NSZeroRect];
+    material_.embedded = YES;
+    material_.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    material_.wantsLayer = YES;
+    material_.layer.masksToBounds = YES;
+    material_.layer.cornerCurve = kCACornerCurveContinuous;
+    [host_ addSubview:material_];
+    accessibility_observer_ = [NSWorkspace.sharedWorkspace.notificationCenter
+        addObserverForName:
+            NSWorkspaceAccessibilityDisplayOptionsDidChangeNotification
+                    object:nil
+                     queue:NSOperationQueue.mainQueue
+                usingBlock:^(NSNotification*) {
+                  appearance_changed.Run();
+                }];
+  }
+
+  ~EmbeddedSurfaceMaterialMac() override {
+    [NSWorkspace.sharedWorkspace.notificationCenter
+        removeObserver:accessibility_observer_];
+    [host_ removeFromSuperview];
+  }
+
+  gfx::NativeView native_view() const override {
+    return gfx::NativeView(host_);
+  }
+
+  bool Update(const helium::SurfaceStyle& style, float radius) override {
+    const auto availability = helium::GetNativeFrameGlassAvailability();
+    const auto configuration = helium::PanelGlassConfiguration(
+        helium::DefaultGlassSurfaceConfiguration(), style);
+    const auto resolution = helium::ResolveGlassSurfaceConfiguration(
+        configuration, helium::GetRequestedGlassBackend(),
+        availability.native_liquid_glass, availability.native_material,
+        availability.reduce_transparency);
+    if (!style.panel_glass ||
+        style.panel_material == helium::PanelMaterial::kGlassmorphic ||
+        !resolution.uses_translucent_native_base) {
+      host_.hidden = YES;
+      return false;
+    }
+    host_.hidden = NO;
+    const auto material =
+        resolution.active == helium::GlassSurfaceMaterial::kLiquidGlass
+            ? style.panel_material
+            : helium::PanelMaterial::kFast;
+    const SkColor neutral = style.neutral_base;
+    [host_ configureRadius:radius shadow:style.panel_shadow];
+    material_.layer.cornerRadius = radius;
+    host_.appearance = [NSAppearance
+        appearanceNamed:SkColorGetR(neutral) < 128 ? NSAppearanceNameDarkAqua
+                                                   : NSAppearanceNameAqua];
+    const SkColor tint = style.panel_tint_color.value_or(neutral);
+    [material_ applyMaterial:material
+                        tint:[NSColor colorWithSRGBRed:SkColorGetR(tint) / 255.0
+                                                 green:SkColorGetG(tint) / 255.0
+                                                  blue:SkColorGetB(tint) / 255.0
+                                                 alpha:style.panel_tint]
+                cornerRadius:radius];
+    [material_
+        applyNeutralColor:[NSColor colorWithSRGBRed:SkColorGetR(neutral) / 255.0
+                                              green:SkColorGetG(neutral) / 255.0
+                                               blue:SkColorGetB(neutral) / 255.0
+                                              alpha:1]
+                  opacity:style.panel_opacity
+             cornerRadius:radius];
+    return true;
+  }
+
+  void SetOpacity(float opacity, float duration_seconds) override {
+    if (duration_seconds <= 0) {
+      host_.alphaValue = opacity;
+    } else {
+      [NSAnimationContext
+          runAnimationGroup:^(NSAnimationContext* context) {
+            context.duration = duration_seconds;
+            [[host_ animator] setAlphaValue:opacity];
+          }
+          completionHandler:nil];
+    }
+  }
+
+ private:
+  ArciumEmbeddedMaterialHost* __strong host_;
+  ArciumPanelMaterialView* __strong material_;
+  id __strong accessibility_observer_;
+};
