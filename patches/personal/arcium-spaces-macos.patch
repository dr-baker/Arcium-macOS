+// Dock Space commands belong to their represented profile, even while the
+// profile picker is open or no browser window exists.
+- (BOOL)canOpenSpaceFromDock:(NSMenuItem*)item {
+  if (!item || item.action != @selector(openSpaceFromDock:) ||
+      item.target != self || _isShuttingDown || !g_browser_process ||
+      g_browser_process->IsShuttingDown() ||
+      browser_shutdown::IsTryingToQuit()) {
+    return NO;
+  }
+  NSDictionary* identity = item.representedObject;
+  if (![identity isKindOfClass:[NSDictionary class]]) {
+    return NO;
+  }
+  NSString* pathString = identity[@"profilePath"];
+  NSString* spaceID = identity[@"spaceID"];
+  if (![pathString isKindOfClass:[NSString class]] || pathString.length == 0 ||
+      ![spaceID isKindOfClass:[NSString class]] || spaceID.length == 0) {
+    return NO;
+  }
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return NO;
+  }
+  const base::FilePath profile_path(base::SysNSStringToUTF8(pathString));
+  ProfileAttributesEntry* entry =
+      profile_manager->GetProfileAttributesStorage()
+          .GetProfileAttributesWithPath(profile_path);
+  if (!entry || entry->IsOmitted() || entry->IsSigninRequired()) {
+    return NO;
+  }
+  Profile* profile = profile_manager->GetProfileByPath(profile_path);
+  if (!profile) {
+    // A retained Dock item can load its known profile when selected.
+    return YES;
+  }
+  if (Browser::GetCreationStatusForProfile(profile) !=
+      Browser::CreationStatus::kOk) {
+    return NO;
+  }
+  auto* space_service =
+      helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+  return space_service &&
+         space_service->GetSpaceById(base::SysNSStringToUTF8(spaceID));
+}
