+- (IBAction)openSpaceFromDock:(id)sender {
+  NSMenuItem* item = base::apple::ObjCCast<NSMenuItem>(sender);
+  if (![self canOpenSpaceFromDock:item]) {
+    return;
+  }
+  [NSApp activateIgnoringOtherApps:YES];
+  NSDictionary* identity = item.representedObject;
+  NSString* pathString = identity[@"profilePath"];
+  NSString* spaceID = identity[@"spaceID"];
+  const base::FilePath profile_path(base::SysNSStringToUTF8(pathString));
+  const std::string space_id = base::SysNSStringToUTF8(spaceID);
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  Profile* profile = profile_manager->GetProfileByPath(profile_path);
+  auto activate_space = [](std::string space_id, Profile* profile) {
+    if (!profile || !g_browser_process || g_browser_process->IsShuttingDown() ||
+        browser_shutdown::IsTryingToQuit() ||
+        !g_browser_process->profile_manager() ||
+        Browser::GetCreationStatusForProfile(profile) !=
+            Browser::CreationStatus::kOk) {
+      return;
+    }
+    ProfileAttributesEntry* entry =
+        g_browser_process->profile_manager()
+            ->GetProfileAttributesStorage()
+            .GetProfileAttributesWithPath(profile->GetPath());
+    if (!entry || entry->IsOmitted() || entry->IsSigninRequired()) {
+      return;
+    }
+
+    if (auto* space_service =
+            helium::HeliumSpaceServiceFactory::GetForProfile(profile)) {
+      if (helium::HeliumSpace* space =
+              space_service->GetSpaceById(space_id)) {
+        space_service->SetActiveSpace(space_id);
+        space->ActivateOrCreatePrimaryWindow();
+      }
+    }
+  };
+  if (profile) {
+    activate_space(space_id, profile);
+    return;
+  }
+  profile_manager->LoadProfileByPath(
+      profile_path, /*incognito=*/false,
+      base::BindOnce(activate_space, space_id));
+}
