 }
 
+- (IBAction)openSpaceFromDock:(id)sender {
+  [NSApp activateIgnoringOtherApps:YES];
+  NSDictionary* identity = [sender representedObject];
+  if (![identity isKindOfClass:[NSDictionary class]]) {
+    return;
+  }
+  NSString* pathString = identity[@"profilePath"];
+  NSString* spaceID = identity[@"spaceID"];
+  if (![pathString isKindOfClass:[NSString class]] || pathString.length == 0 ||
+      ![spaceID isKindOfClass:[NSString class]] || spaceID.length == 0) {
+    return;
+  }
+  const base::FilePath profile_path(
+      base::SysNSStringToUTF8(pathString));
+  const std::string space_id = base::SysNSStringToUTF8(spaceID);
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  Profile* profile = profile_manager->GetProfileByPath(profile_path);
+  auto activate_space = [](std::string space_id, Profile* profile) {
+    if (!profile) {
+      return;
+    }
+    if (auto* space_service =
+            helium::HeliumSpaceServiceFactory::GetForProfile(profile)) {
+      if (helium::HeliumSpace* space =
+              space_service->GetSpaceById(space_id)) {
+        space_service->SetActiveSpace(space_id);
+        space->ActivateOrCreatePrimaryWindow();
+      }
+    }
+  };
+  if (profile) {
+    activate_space(space_id, profile);
+    return;
+  }
+  profile_manager->LoadProfileByPath(
+      profile_path, /*incognito=*/false,
+      base::BindOnce(activate_space, space_id));
+}
+
 - (NSMenu*)applicationDockMenu:(NSApplication*)sender {
   NSMenu* dockMenu = [[NSMenu alloc] initWithTitle:@""];
 
-  BOOL profilesAdded = [_profileMenuController insertItemsIntoMenu:dockMenu
-                                                          atOffset:0
-                                                          fromDock:YES];
-  if (profilesAdded) {
-    [dockMenu addItem:[NSMenuItem separatorItem]];
+  // Helium Spaces: always list Spaces so dock can open the Space window.
+  if (g_browser_process->profile_manager()) {
+    ProfileAttributesStorage& storage =
+        g_browser_process->profile_manager()->GetProfileAttributesStorage();
+    std::vector<ProfileAttributesEntry*> entries =
+        storage.GetAllProfilesAttributesSortedByNameWithCheck();
+    if (!entries.empty()) {
+      NSMenuItem* header;
+      if (@available(macOS 14, *)) {
+        header = [NSMenuItem sectionHeaderWithTitle:@"Spaces"];
+      } else {
+        header = [[NSMenuItem alloc] initWithTitle:@"Spaces"
+                                            action:nil
+                                     keyEquivalent:@""];
+        header.enabled = NO;
+      }
+      [dockMenu addItem:header];
+
+      for (ProfileAttributesEntry* entry : entries) {
+        if (!entry || entry->IsOmitted()) {
+          continue;
+        }
+        Profile* profile = g_browser_process->profile_manager()->GetProfileByPath(
+            entry->GetPath());
+        if (!profile) {
+          continue;
+        }
+        auto* space_service =
+            helium::HeliumSpaceServiceFactory::GetForProfile(profile);
+        if (!space_service) {
+          continue;
+        }
+        for (helium::HeliumSpace* space : space_service->GetSpaces()) {
+          NSString* spaceName = base::SysUTF16ToNSString(space->name());
+          if (spaceName.length == 0) {
+            spaceName = @"Space";
+          }
+          NSMenuItem* spaceItem =
+              [[NSMenuItem alloc] initWithTitle:spaceName
+                                         action:@selector(openSpaceFromDock:)
+                                  keyEquivalent:@""];
+          spaceItem.target = self;
+          spaceItem.representedObject = @{
+            @"profilePath" : base::SysUTF8ToNSString(
+                entry->GetPath().AsUTF8Unsafe()),
+            @"spaceID" : base::SysUTF8ToNSString(space->id())
+          };
+          [dockMenu addItem:spaceItem];
+        }
+      }
+      [dockMenu addItem:[NSMenuItem separatorItem]];
+    }
   }
 
   NSString* titleStr = l10n_util::GetNSStringWithFixup(IDS_NEW_WINDOW_MAC);
