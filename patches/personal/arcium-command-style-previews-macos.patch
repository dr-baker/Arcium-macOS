Index: src/chrome/browser/ui/cocoa/arcium_settings_swift/Tests/ArciumSettingsUITests/ArciumCommandStyleArtworkTests.swift
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_settings_swift/Tests/ArciumSettingsUITests/ArciumCommandStyleArtworkTests.swift
@@ -0,0 +1,37 @@
+import AppKit
+import XCTest
+@testable import ArciumSettingsUI
+
+final class ArciumCommandStyleArtworkTests: XCTestCase {
+    func testPackagedArtworkRendersEveryStyleInBothAppearances() async throws {
+        try await MainActor.run {
+            let images = ArciumCommandStyleArtwork.load(from: Bundle.module)
+            var renders = Set<Data>()
+            for style in ArciumCommandPanelLayout.Style.allCases {
+                for isDark in [false, true] {
+                    let image = try XCTUnwrap(images[
+                        ArciumCommandStyleArtwork.name(for: style, isDark: isDark)])
+                    XCTAssertEqual(image.size.width / image.size.height, 452.0 / 232.0, accuracy: 0.001)
+                    XCTAssertFalse(image.isTemplate)
+                    let bitmap = try XCTUnwrap(NSBitmapImageRep(
+                        bitmapDataPlanes: nil, pixelsWide: 452, pixelsHigh: 232,
+                        bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true,
+                        isPlanar: false, colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0))
+                    let context = try XCTUnwrap(NSGraphicsContext(bitmapImageRep: bitmap))
+                    NSGraphicsContext.saveGraphicsState()
+                    NSGraphicsContext.current = context
+                    image.draw(in: NSRect(x: 0, y: 0, width: 452, height: 232))
+                    NSGraphicsContext.restoreGraphicsState()
+                    let pixels = try XCTUnwrap(bitmap.representation(using: .png, properties: [:]))
+                    renders.insert(pixels)
+                    XCTAssertGreaterThan(bitmap.colorAt(x: 80, y: 100)?.alphaComponent ?? 0, 0.9)
+                    // Detached tabs meet the foreground body. Stacked exposes full caps;
+                    // Peek exposes only their top edges in this resting-state artwork.
+                    let capAlpha = bitmap.colorAt(x: 80, y: 20)?.alphaComponent ?? 0
+                    XCTAssertEqual(capAlpha > 0.9, style == .stacked)
+                }
+            }
+            XCTAssertEqual(renders.count, 8, "Styles and appearances must stay visually distinct")
+        }
+    }
+}
