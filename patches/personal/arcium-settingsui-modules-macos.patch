+import SwiftUI
+
+public struct SettingsScrollFade: Codable, Equatable, Sendable {
+    public static let maximumDistance = 96.0
+    public var isEnabled: Bool
+    public var distance: Double
+    public var intensity: Double
+    public var curve: Curve
+
+    public init(isEnabled: Bool = true, distance: Double = 36, intensity: Double = 0.86, curve: Curve = Curve()) {
+        self.isEnabled = isEnabled
+        self.distance = distance
+        self.intensity = intensity
+        self.curve = curve
+    }
+
+    public struct Curve: Codable, Equatable, Sendable {
+        public var first: CGPoint
+        public var second: CGPoint
+
+        public init(first: CGPoint = CGPoint(x: 0.42, y: 0.87), second: CGPoint = CGPoint(x: 0.57, y: 0)) {
+            self.first = first
+            self.second = second
+        }
+
+        public func point(at progress: Double) -> CGPoint {
+            let t = unit(progress)
+            let u = 1 - t
+            return CGPoint(x: 3 * u * u * t * unit(first.x) + 3 * u * t * t * unit(second.x) + t * t * t,
+                           y: u * u * u + 3 * u * u * t * unit(first.y) + 3 * u * t * t * unit(second.y))
+        }
+    }
+}
+
+public struct SettingsEdgeShadow: Codable, Equatable, Sendable {
+    public enum Placement: String, Codable, CaseIterable, Sendable {
+        case inside, outside, off
+
+        public var title: String {
+            switch self {
+            case .inside: "In"
+            case .outside: "Out"
+            case .off: "Off"
+            }
+        }
+    }
+
+    public var placement: Placement
+    public var strength: Double
+    public var softness: Double
+
+    public init(placement: Placement = .inside, strength: Double = 0.07, softness: Double = 7) {
+        self.placement = placement
+        self.strength = strength
+        self.softness = softness
+    }
+}
+
+public extension EnvironmentValues {
+    @Entry var settingsScrollFade = SettingsScrollFade()
+    @Entry var settingsEdgeShadow = SettingsEdgeShadow()
+    @Entry var settingsContentPanelOpacity = 0.72
+}
+
+private func unit(_ value: Double) -> Double {
+    value.isFinite ? min(1, max(0, value)) : 0
+}
+
+/// One observer and a gradient mask. The inset shadow never copies or blurs content.
+struct SettingsScrollBoundaryEffects: ViewModifier {
+    @Environment(\.settingsScrollFade) private var fade
+    @Environment(\.settingsEdgeShadow) private var shadow
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+    @Environment(\.colorSchemeContrast) private var contrast
+    @State private var edges = SettingsScrollEdgeAmounts()
+
+    func body(content: Content) -> some View {
+        content
+            .onScrollGeometryChange(for: SettingsScrollEdgeAmounts.self) { geometry in
+                SettingsScrollEdgeAmounts(contentHeight: geometry.contentSize.height,
+                    viewportHeight: geometry.containerSize.height, offset: geometry.contentOffset.y,
+                    topInset: geometry.contentInsets.top, bottomInset: geometry.contentInsets.bottom)
+            } action: { _, value in edges = value }
+            .mask {
+                GeometryReader { geometry in
+                    LinearGradient(stops: stops(height: geometry.size.height), startPoint: .top, endPoint: .bottom)
+                }
+                .allowsHitTesting(false).accessibilityHidden(true)
+            }
+            .overlay {
+                if shadow.placement == .inside && contrast != .increased {
+                    SettingsInsetShadow(shadow: shadow).allowsHitTesting(false).accessibilityHidden(true)
+                }
+            }
+    }
+
+    private func stops(height: CGFloat) -> [Gradient.Stop] {
+        let enabled = fade.isEnabled && !reduceTransparency && contrast != .increased
+        let length = fade.distance.isFinite ? min(96, max(1, fade.distance)) : 36
+        let fraction = min(0.5, length / max(1, height))
+        let topAmount = enabled ? min(1, edges.top / length) : 0
+        let bottomAmount = enabled ? min(1, edges.bottom / length) : 0
+        let samples = (0...64).map { fade.curve.point(at: Double($0) / 64) }
+        return samples.map {
+            Gradient.Stop(color: .white.opacity(1 - topAmount * unit(fade.intensity) * $0.y), location: fraction * $0.x)
+        } + samples.reversed().map {
+            Gradient.Stop(color: .white.opacity(1 - bottomAmount * unit(fade.intensity) * $0.y), location: 1 - fraction * $0.x)
+        }
+    }
+}
+
+struct SettingsScrollEdgeAmounts: Equatable {
+    var top: CGFloat = 0
+    var bottom: CGFloat = 0
+
+    init() {}
+
+    init(contentHeight: CGFloat, viewportHeight: CGFloat, offset: CGFloat, topInset: CGFloat, bottomInset: CGFloat) {
+        let range = contentHeight + topInset + bottomInset - viewportHeight
+        guard range > 0 else { return }
+        top = min(96, max(0, offset + topInset))
+        bottom = min(96, max(0, range - offset - topInset))
+    }
+}
+
+private struct SettingsInsetShadow: View {
+    let shadow: SettingsEdgeShadow
+
+    var body: some View {
+        GeometryReader { geometry in
+            let softness = shadow.softness.isFinite ? min(24, max(0, shadow.softness)) : 7
+            let vertical = min(softness * 3, max(1, geometry.size.height / 2))
+            let horizontal = min(softness * 3, max(1, geometry.size.width / 2))
+            ZStack {
+                VStack(spacing: 0) {
+                    edge(from: .top, to: .bottom).frame(height: vertical)
+                    Spacer(minLength: 0)
+                    edge(from: .bottom, to: .top).frame(height: vertical)
+                }
+                HStack(spacing: 0) {
+                    edge(from: .leading, to: .trailing).frame(width: horizontal)
+                    Spacer(minLength: 0)
+                    edge(from: .trailing, to: .leading).frame(width: horizontal)
+                }
+            }
+        }
+    }
+
+    private func edge(from start: UnitPoint, to end: UnitPoint) -> some View {
+        LinearGradient(stops: (0...12).map { index in
+            let progress = Double(index) / 12
+            return .init(color: .black.opacity(min(0.3, unit(shadow.strength)) * pow(1 - progress, 2)), location: progress)
+        }, startPoint: start, endPoint: end)
+    }
+}
