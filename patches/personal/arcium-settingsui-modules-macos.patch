+import SwiftUI
+
+/// A two-axis control. Both coordinates are normalized to 0...1; y increases upward.
+/// The host owns units, value formatting, persistence, and any expensive side effects.
+public struct SXYControl<Surface: View>: View {
+    private let title: String
+    @Binding private var value: CGPoint
+    private let xLabel: String
+    private let yLabel: String
+    private let xReadout: String
+    private let yReadout: String
+    private let help: SHelp?
+    private let surface: Surface
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.isEnabled) private var isEnabled
+    @State private var isDragging = false
+    @State private var lastWriteTime = 0.0
+    @State private var localDragValue: CGPoint?
+    @FocusState private var isFocused: Bool
+    private let inset: CGFloat = 14
+
+    public init(
+        _ title: String,
+        value: Binding<CGPoint>,
+        xLabel: String,
+        yLabel: String,
+        xReadout: String,
+        yReadout: String,
+        help: SHelp? = nil,
+        @ViewBuilder surface: () -> Surface
+    ) {
+        self.title = title
+        _value = value
+        self.xLabel = xLabel
+        self.yLabel = yLabel
+        self.xReadout = xReadout
+        self.yReadout = yReadout
+        self.help = help
+        self.surface = surface()
+    }
+
+    public var body: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.sm) {
+            HStack(spacing: SettingsSpacing.xs) {
+                Text(title).settingsFont(\.label)
+                if let help { SInfo(help: help, title: "About \(title)") }
+                Spacer(minLength: SettingsSpacing.sm)
+                readout(xLabel, value: xReadout)
+                readout(yLabel, value: yReadout)
+            }
+            GeometryReader { geometry in
+                let position = SXYGeometry.position(localDragValue ?? value, in: geometry.size, inset: inset)
+                ZStack {
+                    surface.allowsHitTesting(false)
+                    Path { path in
+                        path.move(to: CGPoint(x: position.x, y: inset))
+                        path.addLine(to: CGPoint(x: position.x, y: geometry.size.height - inset))
+                        path.move(to: CGPoint(x: inset, y: position.y))
+                        path.addLine(to: CGPoint(x: geometry.size.width - inset, y: position.y))
+                    }
+                    .stroke(theme.textPrimary.opacity(isDragging ? 0.25 : 0.12), style: StrokeStyle(lineWidth: 1, dash: [3, 4]))
+                    Circle()
+                        .fill(theme.accent.opacity(0.30))
+                        .overlay { Circle().strokeBorder(.white, lineWidth: 2) }
+                        .shadow(color: .black.opacity(0.35), radius: 3, y: 1)
+                        .frame(width: isDragging ? 24 : 20, height: isDragging ? 24 : 20)
+                        .position(position)
+                }
+                .clipShape(.rect(cornerRadius: theme.radius(SettingsRadius.control)))
+                .overlay {
+                    RoundedRectangle(cornerRadius: theme.radius(SettingsRadius.control))
+                        .strokeBorder(isFocused ? theme.accent : theme.textSecondary.opacity(0.2), lineWidth: isFocused ? 2 : 1)
+                        .allowsHitTesting(false)
+                }
+                .contentShape(Rectangle())
+                .highPriorityGesture(DragGesture(minimumDistance: 0)
+                    .onChanged { event in
+                        guard isEnabled else { return }
+                        isDragging = true
+                        isFocused = true
+                        write(event.location, size: geometry.size)
+                    }
+                    .onEnded { event in
+                        if isEnabled { write(event.location, size: geometry.size, force: true) }
+                        isDragging = false
+                        localDragValue = nil
+                        lastWriteTime = 0
+                    })
+                .focusable(isEnabled)
+                .focused($isFocused)
+                .focusEffectDisabled()
+                .onKeyPress(.leftArrow) { adjust(dx: -0.02, dy: 0) }
+                .onKeyPress(.rightArrow) { adjust(dx: 0.02, dy: 0) }
+                .onKeyPress(.upArrow) { adjust(dx: 0, dy: 0.02) }
+                .onKeyPress(.downArrow) { adjust(dx: 0, dy: -0.02) }
+                .accessibilityElement(children: .ignore)
+                .accessibilityLabel(title)
+                .accessibilityValue("\(xLabel) \(xReadout), \(yLabel) \(yReadout)")
+                .accessibilityHint("Arrow keys adjust \(xLabel) horizontally and \(yLabel) vertically.")
+                .accessibilityAction(named: "Increase \(xLabel)") { _ = adjust(dx: 0.02, dy: 0) }
+                .accessibilityAction(named: "Decrease \(xLabel)") { _ = adjust(dx: -0.02, dy: 0) }
+                .accessibilityAction(named: "Increase \(yLabel)") { _ = adjust(dx: 0, dy: 0.02) }
+                .accessibilityAction(named: "Decrease \(yLabel)") { _ = adjust(dx: 0, dy: -0.02) }
+            }
+            .frame(height: 174)
+        }
+        .opacity(isEnabled ? 1 : SettingsEffects.disabledOpacity)
+        .onChange(of: isEnabled) { _, enabled in
+            if !enabled { isDragging = false; localDragValue = nil; lastWriteTime = 0 }
+        }
+        .onDisappear { isDragging = false; localDragValue = nil; lastWriteTime = 0 }
+    }
+
+    private func readout(_ label: String, value: String) -> some View {
+        HStack(spacing: 4) {
+            Text(label).foregroundStyle(theme.textSecondary)
+            Text(value).foregroundStyle(theme.textPrimary).monospacedDigit()
+        }
+        .settingsFont(\.smallCaption)
+        .padding(.horizontal, 8)
+        .padding(.vertical, 5)
+        .background(theme.insetFill, in: Capsule())
+    }
+
+    private func adjust(dx: CGFloat, dy: CGFloat) -> KeyPress.Result {
+        guard isEnabled else { return .ignored }
+        let current = SXYGeometry.clamp(value)
+        value = SXYGeometry.clamp(CGPoint(x: current.x + dx, y: current.y + dy))
+        return .handled
+    }
+
+    private func write(_ location: CGPoint, size: CGSize, force: Bool = false) {
+        let next = SXYGeometry.value(at: location, in: size, inset: inset)
+        localDragValue = next
+        let now = ProcessInfo.processInfo.systemUptime
+        guard force || now - lastWriteTime >= 1.0 / 30 else { return }
+        value = next
+        lastWriteTime = now
+    }
+}
+
+// One coordinate transform for drawing and interaction, including the literal edges.
+enum SXYGeometry {
+    static func clamp(_ point: CGPoint) -> CGPoint {
+        CGPoint(x: point.x.isFinite ? min(max(point.x, 0), 1) : 0,
+                y: point.y.isFinite ? min(max(point.y, 0), 1) : 0)
+    }
+
+    static func position(_ value: CGPoint, in size: CGSize, inset: CGFloat) -> CGPoint {
+        let value = clamp(value)
+        return CGPoint(x: inset + value.x * max(1, size.width - 2 * inset),
+                       y: inset + (1 - value.y) * max(1, size.height - 2 * inset))
+    }
+
+    static func value(at point: CGPoint, in size: CGSize, inset: CGFloat) -> CGPoint {
+        clamp(CGPoint(x: (point.x - inset) / max(1, size.width - 2 * inset),
+                      y: 1 - (point.y - inset) / max(1, size.height - 2 * inset)))
+    }
+}
