+    func body(content: Content) -> some View {
+        let shape = RoundedRectangle(cornerRadius: SettingsPixelGrid.aligned(theme.radius(cornerRadius), scale: displayScale), style: .continuous)
+        content
+            .background {
+                ZStack {
+                    if isSelected || isHovered {
+                        shape.fill(reduceTransparency ? AnyShapeStyle(theme.windowCanvas) : AnyShapeStyle(.ultraThinMaterial))
+                    }
+                    shape.fill(fill)
+                }
+            }
+            .overlay { shape.strokeBorder(stroke, lineWidth: SettingsPixelGrid.aligned(theme.borderWidth, scale: displayScale)) }
+    }
+
+    private var fill: Color {
+        if isSelected { return theme.selectionStrong.opacity(0.16) }
+        if isHovered { return theme.hoverFill }
+        return .clear
+    }
+
+    private var stroke: Color {
+        if isSelected { return theme.controlSelectionBorder }
+        if isHovered { return theme.controlHoverBorder }
+        return .clear
+    }
+}
