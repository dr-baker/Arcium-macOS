+import SwiftUI
+
+public enum SNoticeTone: Sendable {
+    case info
+    case success
+    case warning
+    case danger
+}
+
+/// A compact, persistent notice with optional actions. Meaning is carried by
+/// the symbol and wording as well as color.
+public struct SNoticeBanner<Actions: View>: View {
+    public let title: String
+    public let message: String?
+    public let tone: SNoticeTone
+    private let systemImage: String?
+    private let actions: Actions
+    @Environment(\.settingsTheme) private var theme
+
+    public init(
+        _ title: String,
+        message: String? = nil,
+        tone: SNoticeTone = .warning,
+        systemImage: String? = nil,
+        @ViewBuilder actions: () -> Actions
+    ) {
+        self.title = title
+        self.message = message
+        self.tone = tone
+        self.systemImage = systemImage
+        self.actions = actions()
+    }
+
+    public var body: some View {
+        let shape = RoundedRectangle(cornerRadius: theme.radius(SettingsRadius.control), style: .continuous)
+        ViewThatFits(in: .horizontal) {
+            HStack(alignment: .center, spacing: SettingsSpacing.sm) {
+                text
+                Spacer(minLength: SettingsSpacing.xs)
+                HStack(spacing: SettingsSpacing.xs) { actions }.fixedSize()
+            }
+            .frame(maxWidth: .infinity, alignment: .leading)
+            VStack(alignment: .leading, spacing: SettingsSpacing.sm) {
+                text
+                SFlowLayout { actions }
+                    .padding(.leading, 28)
+            }
+            .frame(maxWidth: .infinity, alignment: .leading)
+        }
+        .padding(.vertical, SettingsSpacing.sm)
+        .padding(.leading, SettingsSpacing.sm + 3)
+        .padding(.trailing, SettingsSpacing.sm)
+        .background(surface)
+        .overlay(alignment: .leading) {
+            Rectangle().fill(color).frame(width: 3)
+        }
+        .clipShape(shape)
+        .overlay { shape.strokeBorder(color.opacity(0.35), lineWidth: 1) }
+        .accessibilityElement(children: .contain)
+    }
+
+    private var text: some View {
+        HStack(alignment: .firstTextBaseline, spacing: SettingsSpacing.xs) {
+            Image(systemName: systemImage ?? defaultSymbol)
+                .foregroundStyle(color)
+                .frame(width: 20)
+                .accessibilityHidden(true)
+            VStack(alignment: .leading, spacing: 2) {
+                Text(title)
+                    .settingsFont(\.label)
+                    .foregroundStyle(theme.textPrimary)
+                if let message {
+                    Text(message)
+                        .settingsFont(\.caption)
+                        .foregroundStyle(theme.textSecondary)
+                }
+            }
+            .fixedSize(horizontal: false, vertical: true)
+        }
+        .accessibilityElement(children: .combine)
+        .accessibilityLabel([toneLabel, title, message].compactMap(\.self).joined(separator: ". "))
+    }
+
+    private var color: Color {
+        switch tone {
+        case .info: theme.accent
+        case .success: theme.success
+        case .warning: theme.warning
+        case .danger: theme.error
+        }
+    }
+
+    private var surface: Color {
+        switch tone {
+        case .info: theme.accent.opacity(0.10)
+        case .success: theme.successSurface
+        case .warning: theme.warningSurface
+        case .danger: theme.errorSurface
+        }
+    }
+
+    private var defaultSymbol: String {
+        switch tone {
+        case .info: "info.circle.fill"
+        case .success: "checkmark.circle.fill"
+        case .warning: "exclamationmark.triangle.fill"
+        case .danger: "xmark.octagon.fill"
+        }
+    }
+
+    private var toneLabel: String? {
+        switch tone {
+        case .info: nil
+        case .success: "Success"
+        case .warning: "Warning"
+        case .danger: "Error"
+        }
+    }
+}
+
+public extension SNoticeBanner where Actions == EmptyView {
+    init(_ title: String, message: String? = nil, tone: SNoticeTone = .warning, systemImage: String? = nil) {
+        self.init(title, message: message, tone: tone, systemImage: systemImage) { EmptyView() }
+    }
+}
