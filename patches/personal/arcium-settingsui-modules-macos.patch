+import SwiftUI
+
+/// Icon-based appearance selection with explicit system-following semantics.
+public struct SettingsAppearancePicker: View {
+    @Binding private var selection: SettingsAppearance
+    private let isCompact: Bool
+    private let showsLabels: Bool
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var showsAppearanceChoices = false
+    @Namespace private var selectionNamespace
+
+    public init(
+        selection: Binding<SettingsAppearance>,
+        isCompact: Bool = false,
+        showsLabels: Bool = false
+    ) {
+        _selection = selection
+        self.isCompact = isCompact
+        self.showsLabels = showsLabels
+    }
+
+    public var body: some View {
+        if isCompact {
+            Button {
+                showsAppearanceChoices.toggle()
+            } label: {
+                HStack(spacing: SettingsSpacing.xs) {
+                    Image(systemName: selection.symbolName)
+                        .contentTransition(reduceMotion ? .identity : .symbolEffect(.replace))
+                        .animation(reduceMotion ? nil : SettingsMotion.selectionTravel, value: selection)
+                        .settingsSymbol()
+                    if showsLabels {
+                        Text(displayName(for: selection))
+                            .settingsFont(\.smallCaption)
+                            .foregroundStyle(theme.textPrimary)
+                    }
+                }
+                .frame(maxWidth: .infinity, minHeight: showsLabels ? 40 : 32)
+                .padding(3)
+                .contentShape(.rect)
+            }
+            .buttonStyle(.plain)
+            .accessibilityLabel("Appearance")
+            .accessibilityValue(selection.rawValue)
+            .help("Appearance: \(selection.rawValue)")
+            .popover(isPresented: $showsAppearanceChoices, arrowEdge: .trailing) {
+                VStack(spacing: 4) {
+                    ForEach(SettingsAppearance.allCases, id: \.self) { mode in
+                        Button {
+                            selection = mode
+                            showsAppearanceChoices = false
+                        } label: {
+                            HStack(spacing: SettingsSpacing.xs) {
+                                Image(systemName: mode.symbolName).settingsSymbol()
+                                Text(mode == .system ? "Follow macOS" : mode.rawValue)
+                                Spacer()
+                                Image(systemName: "checkmark")
+                                    .opacity(selection == mode ? 1 : 0)
+                                    .accessibilityHidden(true)
+                            }
+                            .settingsFont(\.body)
+                            .padding(.horizontal, SettingsSpacing.xs)
+                            .padding(.vertical, 6)
+                            .contentShape(.rect)
+                        }
+                        .buttonStyle(.plain)
+                        .settingsInteractiveControlSurface(isSelected: selection == mode)
+                        .accessibilityAddTraits(selection == mode ? .isSelected : [])
+                    }
+                }
+                .padding(8)
+                .frame(width: 210)
+            }
+        } else {
+            HStack(spacing: 4) {
+                ForEach(SettingsAppearance.allCases, id: \.self) { mode in
+                    Button { selection = mode } label: {
+                        Group {
+                            if showsLabels {
+                                VStack(spacing: SettingsSpacing.xxs) {
+                                    Image(systemName: mode.symbolName).settingsSymbol()
+                                    Text(displayName(for: mode))
+                                        .settingsFont(\.smallCaption)
+                                }
+                            } else {
+                                Image(systemName: mode.symbolName).settingsSymbol()
+                            }
+                        }
+                        .foregroundStyle(selection == mode ? theme.textPrimary : theme.textSecondary)
+                        .frame(maxWidth: .infinity, minHeight: showsLabels ? 48 : 32)
+                        .background {
+                            Group {
+                                if selection == mode {
+                                    RoundedRectangle(cornerRadius: 6)
+                                        .fill(theme.raisedFill)
+                                        .matchedGeometryEffect(id: "appearance", in: selectionNamespace)
+                                }
+                            }
+                            .animation(reduceMotion ? nil : SettingsMotion.selectionTravel, value: selection)
+                        }
+                        .contentShape(.rect)
+                    }
+                    .buttonStyle(.plain)
+                    .accessibilityLabel(mode == .system ? "Follow macOS" : mode.rawValue)
+                    .accessibilityAddTraits(selection == mode ? .isSelected : [])
+                    .help(mode == .system ? "Follow macOS appearance" : "Use \(mode.rawValue.lowercased()) appearance")
+                }
+            }
+            .padding(3)
+            .background(theme.insetFill, in: .rect(cornerRadius: 9))
+            .accessibilityElement(children: .contain)
+            .accessibilityLabel("Appearance")
+        }
+    }
