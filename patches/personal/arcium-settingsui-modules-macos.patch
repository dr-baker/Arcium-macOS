+import SettingsUI
+import SettingsUIStyle
+import SwiftUI
+
+/// Shared value used by ``SGrainControl`` so grain size and opacity are
+/// written as one setting update.
+public struct SettingsGrainValue: Equatable, Sendable {
+    public var grain: Double
+    public var grainScale: Double
+
+    public init(grain: Double = 0, grainScale: Double = 1) {
+        self.grain = grain
+        self.grainScale = grainScale
+    }
+}
+
+/// Shared mapping between the user-facing production dials and a backdrop
+/// configuration's stored values.
+public enum SettingsBackgroundEffectsMapping {
+    public static func tintOpacity(
+        for value: Double,
+        style: SettingsBackdropGlassStyle,
+        curve: SettingsGlassOpacityCurve = .identity
+    ) -> Double {
+        let normalized = bounded(value, in: 0...1)
+        switch style {
+        case .regular:
+            return normalized
+        case .clear:
+            return curve.clearOpacity(for: normalized)
+        }
+    }
+
+    public static func opacity(
+        from value: Double,
+        style: SettingsBackdropGlassStyle,
+        curve: SettingsGlassOpacityCurve = .identity
+    ) -> Double {
+        let normalized = bounded(value, in: 0...1)
+        switch style {
+        case .regular:
+            return normalized
+        case .clear:
+            return curve.regularOpacity(for: normalized)
+        }
+    }
+
+    public static func saturation(for configuration: SettingsBackdropConfiguration) -> Double {
+        bounded(configuration.tintStrength, in: 0...1)
+    }
+
+    public static func applyingSaturation(
+        _ value: Double,
+        to configuration: SettingsBackdropConfiguration
+    ) -> SettingsBackdropConfiguration {
+        let strength = bounded(value, in: 0...1)
+        var next = configuration
+        next.tintStrength = strength
+        let glowIntensity = 0.30 + (0.50 * strength)
+        for index in next.glows.indices {
+            next.glows[index].intensity = glowIntensity
+        }
+        return next.normalized()
+    }
+
+    private static func bounded(_ value: Double, in range: ClosedRange<Double>) -> Double {
+        value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : range.lowerBound
+    }
+}
+
+/// The shared Background Effects controls. Persistence and runtime ownership
+/// remain with the host through the injected configuration binding.
+public struct SBackgroundEffects: View {
+    @Binding private var configuration: SettingsBackdropConfiguration
+    private let available: Bool
+    private let opacityCurve: SettingsGlassOpacityCurve
+    private let grainMaximumOpacity: Double
+
+    public init(
+        configuration: Binding<SettingsBackdropConfiguration>,
+        available: Bool,
+        opacityCurve: SettingsGlassOpacityCurve,
+        grainMaximumOpacity: Double = 1
+    ) {
+        _configuration = configuration
+        self.available = available
+        self.opacityCurve = opacityCurve
+        self.grainMaximumOpacity = grainMaximumOpacity
+    }
+
+    public var body: some View {
+        SSectionCard(title: "Background Effects") {
+            SToggle(
+                "Reflective Glass",
+                isOn: reflectionBinding,
+                help: SHelp(description: "Reflects adjacent materials, not just refracting what's behind."),
+                style: .compact
+            )
+            SSlider(
+                "Opacity",
+                value: glassOpacityBinding,
+                range: 0...1,
+                step: 0.01,
+                format: percent,
+                help: SHelp(description: "Overlay tint opacity, calibrated across Regular and Clear glass."),
+                commitMode: .onDragEnd,
+                style: .compact,
+                onPreviewChange: { glassOpacityBinding.wrappedValue = $0 }
+            )
+            SSlider(
+                "Saturation",
+                value: saturationBinding,
+                range: 0...1,
+                step: 0.01,
+                format: percent,
+                help: SHelp(description: "Combines color strength (0–100%) with glow intensity (30–80%)."),
+                commitMode: .onDragEnd,
+                style: .compact,
+                onPreviewChange: { saturationBinding.wrappedValue = $0 }
+            )
+
+            SGrainControl(
+                value: grainBinding,
+                isEnabled: available,
+                maximumOpacity: grainMaximumOpacity
+            )
+        }
+        .disabled(!available)
+    }
+
+    private var reflectionBinding: Binding<Bool> {
+        Binding(
+            get: { configuration.glassStyle == .regular },
+            set: { reflectsColors in
+                let wrapperOpacity = SettingsBackgroundEffectsMapping.opacity(
+                    from: configuration.glassTintOpacity,
+                    style: configuration.glassStyle,
+                    curve: opacityCurve
+                )
+                var next = configuration
+                let nextStyle: SettingsBackdropGlassStyle = reflectsColors ? .regular : .clear
+                next.glassStyle = nextStyle
+                next.glassTintOpacity = SettingsBackgroundEffectsMapping.tintOpacity(
+                    for: wrapperOpacity,
+                    style: nextStyle,
+                    curve: opacityCurve
+                )
+                configuration = next.normalized()
+            }
+        )
+    }
+
+    private var glassOpacityBinding: Binding<Double> {
+        Binding(
+            get: {
+                SettingsBackgroundEffectsMapping.opacity(
+                    from: configuration.glassTintOpacity,
+                    style: configuration.glassStyle,
+                    curve: opacityCurve
+                )
+            },
+            set: { value in
+                var next = configuration
+                next.glassTintOpacity = SettingsBackgroundEffectsMapping.tintOpacity(
+                    for: value,
+                    style: configuration.glassStyle,
+                    curve: opacityCurve
+                )
+                configuration = next.normalized()
+            }
+        )
+    }
+
+    private var saturationBinding: Binding<Double> {
+        Binding(
+            get: { SettingsBackgroundEffectsMapping.saturation(for: configuration) },
+            set: { value in
+                configuration = SettingsBackgroundEffectsMapping.applyingSaturation(
+                    value,
+                    to: configuration
+                )
+            }
+        )
+    }
+
+    private var grainBinding: Binding<SettingsGrainValue> {
+        Binding(
+            get: {
+                SettingsGrainValue(
+                    grain: configuration.grain,
+                    grainScale: configuration.grainScale
+                )
+            },
+            set: { value in
+                var next = configuration
+                next.grain = value.grain
+                next.grainScale = value.grainScale
+                configuration = next.normalized()
+            }
+        )
+    }
+
+    private func percent(_ value: Double) -> String {
+        "\(Int((value * 100).rounded()))%"
+    }
+}
+
+/// A two-axis grain control. The value binding is the preferred initializer:
+/// dragging either axis writes both grain fields in one host update.
+public struct SGrainControl: View {
+    @Binding private var value: SettingsGrainValue
+    private let isEnabled: Bool
+    private let maximumOpacity: Double
+    @State private var observedMaximumOpacity: Double
+
+    public init(
+        value: Binding<SettingsGrainValue>,
+        isEnabled: Bool = true,
+        maximumOpacity: Double = 1
+    ) {
+        _value = value
+        self.isEnabled = isEnabled
+        self.maximumOpacity = maximumOpacity
+        let configuredMaximum = maximumOpacity.isFinite ? max(maximumOpacity, 0.0001) : 1
+        let initialOpacity = value.wrappedValue.grain.isFinite
+            ? max(value.wrappedValue.grain, 0)
+            : 0
+        _observedMaximumOpacity = State(
+            initialValue: max(configuredMaximum, initialOpacity)
+        )
+    }
+
+    public init(
+        grain: Binding<Double>,
+        grainScale: Binding<Double>,
+        isEnabled: Bool = true,
+        maximumOpacity: Double = 1
+    ) {
+        self.init(
+            value: Binding(
+                get: {
+                    SettingsGrainValue(
+                        grain: grain.wrappedValue,
+                        grainScale: grainScale.wrappedValue
+                    )
+                },
+                set: { next in
+                    grain.wrappedValue = next.grain
+                    grainScale.wrappedValue = next.grainScale
+                }
+            ),
+            isEnabled: isEnabled,
+            maximumOpacity: maximumOpacity
+        )
+    }
+
+    public var body: some View {
+        SXYControl(
+            "Grain",
+            value: position,
+            xLabel: "Size", yLabel: "Opacity",
+            xReadout: "\(Int((bounded(value.grainScale, in: 0.5...2) * 100).rounded()))%",
+            yReadout: "\(Int((bounded(value.grain, in: 0...effectiveMaximumOpacity) / effectiveMaximumOpacity * 100).rounded()))%",
+            help: SHelp(description: "Drag horizontally for finer or coarser grain, and vertically for opacity. The corners show the extremes. Arrow keys make small adjustments.")
+        ) {
+            ZStack {
+                VStack(spacing: 1) {
+                    HStack(spacing: 1) {
+                        grainExample(grain: effectiveMaximumOpacity, scale: 0.5)
+                        grainExample(grain: effectiveMaximumOpacity, scale: 2)
+                    }
+                    HStack(spacing: 1) {
+                        grainExample(grain: min(0.02, effectiveMaximumOpacity), scale: 0.5)
+                        grainExample(grain: min(0.02, effectiveMaximumOpacity), scale: 2)
+                    }
+                }
+                VStack {
+                    HStack { label("Strong · fine"); Spacer(); label("Strong · coarse") }
+                    Spacer()
+                    HStack { label("Faint · fine"); Spacer(); label("Faint · coarse") }
+                }
+                .padding(10)
+            }
+        }
+        .disabled(!isEnabled)
+        .padding(.top, 6)
+        .onChange(of: value.grain) { _, _ in observeMaximumOpacity() }
+        .onChange(of: maximumOpacity) { _, _ in observeMaximumOpacity() }
+    }
+
+    private var effectiveMaximumOpacity: Double {
+        let configured = maximumOpacity.isFinite ? max(maximumOpacity, 0.0001) : 1
+        let current = value.grain.isFinite ? max(value.grain, 0) : 0
+        return max(configured, observedMaximumOpacity, current)
+    }
+
+    private func observeMaximumOpacity() {
+        let configured = maximumOpacity.isFinite ? max(maximumOpacity, 0.0001) : 1
+        let current = value.grain.isFinite ? max(value.grain, 0) : 0
+        observedMaximumOpacity = max(observedMaximumOpacity, configured, current)
+    }
+
+    private var position: Binding<CGPoint> {
+        Binding(
+            get: {
+                CGPoint(
+                    x: (bounded(value.grainScale, in: 0.5...2) - 0.5) / 1.5,
+                    y: bounded(value.grain, in: 0...effectiveMaximumOpacity) / effectiveMaximumOpacity
+                )
+            },
+            set: { point in
+                var next = value
+                next.grainScale = 0.5 + Double(point.x) * 1.5
+                next.grain = Double(point.y) * effectiveMaximumOpacity
+                value = next
+            }
+        )
+    }
+
+    @Environment(\.settingsTheme) private var theme
+
+    private func label(_ value: String) -> some View {
+        Text(value)
+            .settingsFont(\.smallCaption)
+            .foregroundStyle(theme.textPrimary.opacity(0.85))
+            .padding(.horizontal, 6)
+            .padding(.vertical, 3)
+            .background(theme.windowCanvas.opacity(0.65), in: Capsule())
+    }
+
+    private func grainExample(grain: Double, scale: Double) -> some View {
+        GeometryReader { _ in
+            ZStack {
+                theme.windowCanvas
+                SettingsBackdropGrainOverlay(
+                    finish: SettingsBackdropFinish(grain: grain, grainBlendMode: .normal),
+                    grainScale: scale
+                )
+            }
+            .clipped()
+        }
+    }
+
+    private func bounded(_ value: Double, in range: ClosedRange<Double>) -> Double {
+        value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : range.lowerBound
+    }
+}
