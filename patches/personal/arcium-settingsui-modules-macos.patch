+import SwiftUI
+
+private struct SEmbeddedCardKey: EnvironmentKey {
+    static let defaultValue = false
+}
+
+extension EnvironmentValues {
+    var settingsEmbeddedCard: Bool {
+        get { self[SEmbeddedCardKey.self] }
+        set { self[SEmbeddedCardKey.self] = newValue }
+    }
+}
+
+public struct SSectionCard<Content: View>: View {
+    public let title: String
+    public let tone: SSectionCardTone
+    public let showsHeader: Bool
+    public let showsDivider: Bool
+    private let summary: String?
+    private let isExpanded: Binding<Bool>?
+    private let content: Content
+    @Environment(\.settingsLayout) private var layout
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.settingsEmbeddedCard) private var embedded
+
+    /// Pass `isExpanded` to make the entire padded heading a disclosure button.
+    /// The host owns expansion, including restoration and search-driven reveals.
+    public init(title: String, tone: SSectionCardTone = .normal,
+                showsHeader: Bool = true, showsDivider: Bool = true,
+                isExpanded: Binding<Bool>? = nil, summary: String? = nil,
+                @ViewBuilder content: () -> Content) {
+        self.title = title
+        self.tone = tone
+        self.showsHeader = showsHeader
+        self.showsDivider = showsDivider
+        self.isExpanded = isExpanded
+        self.summary = summary
+        self.content = content()
+    }
+
+    public var body: some View {
+        Group {
+            if let isExpanded {
+                DisclosureGroup(isExpanded: isExpanded) {
+                    cardContent
+                } label: {
+                    heading
+                }
+                .disclosureGroupStyle(SCardDisclosureStyle(showsDivider: showsDivider))
+            } else {
+                VStack(alignment: .leading, spacing: 0) {
+                    if showsHeader {
+                        heading.padding(.bottom, SettingsSpacing.sm)
+                    }
+                    if showsDivider {
+                        Divider().padding(.bottom, SettingsSpacing.sm)
+                    }
+                    cardContent
+                }
+                .padding(embedded ? 0 : layout.cardPadding)
+            }
+        }
+        .background {
+            if !embedded { Color.clear.settingsCardSurface(tone: tone) }
+        }
+        .accessibilityElement(children: .contain)
+        .accessibilityLabel(title)
+    }
+
+    private var heading: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.xxs) {
+            Text(title).settingsFont(\.section).foregroundStyle(tone.header(in: theme))
+            if let summary {
+                Text(summary).settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+            }
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+    }
+
+    private var cardContent: some View {
+        VStack(alignment: .leading, spacing: layout.rowSpacing) { content }
+    }
+}
+
+private struct SCardDisclosureStyle: DisclosureGroupStyle {
+    let showsDivider: Bool
+
+    func makeBody(configuration: Configuration) -> some View {
+        SCardDisclosureBody(configuration: configuration, showsDivider: showsDivider)
+    }
+}
+
+/// Focus belongs to a mounted view rather than the transient style value.
+private struct SCardDisclosureBody: View {
+    let configuration: DisclosureGroupStyleConfiguration
+    let showsDivider: Bool
+    @Environment(\.settingsLayout) private var layout
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            SCardHeadingButton(isExpanded: Binding(get: { configuration.isExpanded },
+                                                  set: { configuration.isExpanded = $0 }),
+                               padding: layout.cardPadding) {
+                configuration.label
+            }
+            if configuration.isExpanded {
+                VStack(alignment: .leading, spacing: layout.rowSpacing) {
+                    if showsDivider { Divider() }
+                    configuration.content
+                }
+                .padding(.horizontal, layout.cardPadding)
+                .padding(.bottom, layout.cardPadding)
+                .transition(.opacity)
+            }
+        }
+    }
+}
+
+/// Keep disclosure separate from editing actions so Save and Cancel never
+/// become nested buttons or toggle expansion. The mounted heading owns focus.
+struct SCardHeadingButton<Label: View>: View {
+    let isExpanded: Binding<Bool>?
+    var padding: CGFloat = 0
+    @ViewBuilder let label: () -> Label
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @Environment(\.settingsLayout) private var layout
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.isEnabled) private var isEnabled
+    @FocusState private var headerFocused: Bool
+
+    private func toggle(_ isExpanded: Binding<Bool>) {
+        headerFocused = true
+        withAnimation(reduceMotion ? nil : .easeInOut(duration: 0.25)) {
+            isExpanded.wrappedValue.toggle()
+        }
+    }
+
+    var body: some View {
+        if let isExpanded {
+            Button {
+                toggle(isExpanded)
+            } label: {
+                HStack(alignment: .firstTextBaseline, spacing: layout.rowSpacing) {
+                    Image(systemName: isExpanded.wrappedValue ? "chevron.down" : "chevron.right")
+                        .foregroundStyle(theme.textSecondary)
+                        .accessibilityHidden(true)
+                    label()
+                }
+                .padding(padding)
+                .contentShape(Rectangle())
+            }
+            .buttonStyle(.plain)
+            .focusable(isEnabled)
+            .focused($headerFocused)
+            .onKeyPress(keys: [.return, .space], phases: .down) { _ in
+                guard isEnabled else { return .ignored }
+                toggle(isExpanded)
+                return .handled
+            }
+            .overlay {
+                RoundedRectangle(cornerRadius: SettingsRadius.control)
+                    .stroke(headerFocused ? theme.accent : .clear, lineWidth: 2)
+                    .padding(3)
+                    .allowsHitTesting(false)
+            }
+            .accessibilityValue(isExpanded.wrappedValue ? "Expanded" : "Collapsed")
+        } else {
+            label()
+        }
+    }
+}
