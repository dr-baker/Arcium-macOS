+import SettingsUI
+import SwiftUI
+
+/// Grain that can sit above native glass while glows render behind the window.
+/// Place below content, and set the backdrop finish's grain to zero to avoid duplication.
+/// Use `grainScale` (0.5...2) to resize the texture before blending; do not scale
+/// the completed overlay, which can change compositing at integer magnifications.
+public struct SettingsBackdropGrainOverlay: View {
+    private let finish: SettingsBackdropFinish
+    private let grainScale: Double
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+
+    public init(finish: SettingsBackdropFinish, grainScale: Double = 1) {
+        self.finish = finish
+        self.grainScale = grainScale
+    }
+
+    public var body: some View {
+        grainContent
+            .allowsHitTesting(false)
+            .accessibilityHidden(true)
+    }
+
+    // Avoid a MainActor-inheriting Group closure during background rendering.
+    @ViewBuilder
+    private var grainContent: some View {
+        if !reduceTransparency, finish.grain.isFinite, finish.grain > 0 {
+            SettingsBackdropGrain(colors: finish.grainColors, grainScale: grainScale)
+                .blendMode(finish.grainBlendMode.blendMode)
+                .opacity(min(finish.grain, 1) * 0.45)
+        }
+    }
+}
