+import CoreGraphics
+import Foundation
+import SettingsUI
+
+/// The material selected by ``SBackdropEditor``.
+public enum SettingsBackdropMaterial: String, CaseIterable, Codable, Hashable, Identifiable, Sendable {
+    case auto
+    case liquidGlass
+    case frosted
+    case solid
+
+    public var id: String { rawValue }
+
+    public var title: String {
+        switch self {
+        case .auto: "Auto"
+        case .liquidGlass: "Liquid Glass"
+        case .frosted: "Flat"
+        case .solid: "Solid"
+        }
+    }
+
+    public var help: String {
+        switch self {
+        case .auto: "Follow the current window appearance."
+        case .liquidGlass: "Use macOS Liquid Glass."
+        case .frosted: "Use a softly blurred window surface."
+        case .solid: "Use an opaque window surface."
+        }
+    }
+}
+
+/// The native Liquid Glass style exposed by the editor.
+public enum SettingsBackdropGlassStyle: String, CaseIterable, Codable, Hashable, Identifiable, Sendable {
+    case regular
+    case clear
+
+    public var id: String { rawValue }
+
+    public var title: String {
+        switch self {
+        case .regular: "Regular"
+        case .clear: "Clear"
+        }
+    }
+
+    public var help: String {
+        switch self {
+        case .regular: "Use the standard Liquid Glass surface."
+        case .clear: "Use the clearer Liquid Glass surface."
+        }
+    }
+}
+
+/// The semantic native material styles available for frosted window chrome.
+public enum SettingsBackdropFrostedStyle: String, CaseIterable, Codable, Hashable, Identifiable, Sendable {
+    case automatic
+    case sidebar
+    case menu
+    case popover
+    case hud
+
+    public var id: String { rawValue }
+
+    public var title: String {
+        switch self {
+        case .automatic: "Automatic"
+        case .sidebar: "Sidebar"
+        case .menu: "Menu"
+        case .popover: "Popover"
+        case .hud: "Floating panel"
+        }
+    }
+
+    public var help: String {
+        switch self {
+        case .automatic: "Let macOS choose the flat surface style."
+        case .sidebar: "Use the sidebar flat surface style."
+        case .menu: "Use the menu flat surface style."
+        case .popover: "Use the popover flat surface style."
+        case .hud: "Use the floating panel flat surface style."
+        }
+    }
+}
+
+/// The edge used as the denominator for a normalized glow radius.
+///
+/// The studio editor historically drew radii against the shortest preview
+/// edge. ``SettingsBackdrop`` draws style preset glows against the longest
+/// edge. Keeping the reference on the editor configuration makes that
+/// adapter decision explicit instead of silently changing the appearance.
+public enum SettingsGlowRadiusReference: String, Codable, Equatable, Sendable {
+    case shortestEdge
+    case longestEdge
+
+    public func length(in size: CGSize) -> CGFloat {
+        let width = size.width.isFinite ? max(size.width, 0) : 0
+        let height = size.height.isFinite ? max(size.height, 0) : 0
+        switch self {
+        case .shortestEdge: return min(width, height)
+        case .longestEdge: return max(width, height)
+        }
+    }
+}
+
+public enum SettingsBackdropConfigurationError: Error, Equatable, Sendable {
+    case invalidViewportSize
+}
+
+/// A typed, host-owned configuration for ``SBackdropEditor``.
+///
+/// This type is presentation state. Hosts own persistence and can write the
+/// binding to their existing settings store. Values are normalized at the
+/// binding boundary, while glow count and radius are intentionally preserved.
+public struct SettingsBackdropConfiguration: Codable, Equatable, Sendable {
+    public var enabled: Bool
+    public var material: SettingsBackdropMaterial
+    public var materialOpacity: Double
+    public var glassTintOpacity: Double
+    public var glassStyle: SettingsBackdropGlassStyle
+    public var frostedStyle: SettingsBackdropFrostedStyle
+    public var frostedTintStrength: Double
+    public var tintStrength: Double
+    public var grain: Double
+    public var grainScale: Double
+    public var matchColorAdjustments: Bool
+    public var colorHarmony: SettingsColorHarmony
+    public var glows: [SettingsStyleGlow]
+    public var radiusReference: SettingsGlowRadiusReference
+
+    public static let defaultGlows = [
+        SettingsStyleGlow(
+            id: "point-1",
+            color: SettingsRGB(red: 0.9372549019607843, green: 0.7803921568627451, blue: 0.4),
+            x: 0.18,
+            y: 0.20,
+            radius: 0.8,
+            intensity: 0.5
+        ),
+        SettingsStyleGlow(
+            id: "point-2",
+            color: SettingsRGB(red: 0.4117647058823529, green: 0.5764705882352941, blue: 0.9294117647058824),
+            x: 0.80,
+            y: 0.65,
+            radius: 0.8,
+            intensity: 0.5
+        )
+    ]
+
+    public init(
+        enabled: Bool = true,
+        material: SettingsBackdropMaterial = .liquidGlass,
+        materialOpacity: Double = 0.95,
+        glassTintOpacity: Double = 0.70,
+        glassStyle: SettingsBackdropGlassStyle = .regular,
+        frostedStyle: SettingsBackdropFrostedStyle = .automatic,
+        frostedTintStrength: Double = 1,
+        tintStrength: Double = 0.4,
+        grain: Double = 0.06,
+        grainScale: Double = 0.5,
+        matchColorAdjustments: Bool = true,
+        colorHarmony: SettingsColorHarmony = .custom,
+        glows: [SettingsStyleGlow] = SettingsBackdropConfiguration.defaultGlows,
+        radiusReference: SettingsGlowRadiusReference = .shortestEdge
+    ) {
+        self.enabled = enabled
+        self.material = material
+        self.materialOpacity = Self.bounded(materialOpacity, to: 0...1)
+        self.glassTintOpacity = Self.bounded(glassTintOpacity, to: 0...1)
+        self.glassStyle = glassStyle
+        self.frostedStyle = frostedStyle
+        self.frostedTintStrength = Self.bounded(frostedTintStrength, to: 0...2)
+        self.tintStrength = Self.bounded(tintStrength, to: 0...1)
+        self.grain = Self.bounded(grain, to: 0...1)
+        self.grainScale = Self.bounded(grainScale, to: 0.5...2)
+        self.matchColorAdjustments = matchColorAdjustments
+        self.colorHarmony = colorHarmony
+        self.glows = Self.normalizedGlows(glows)
+        self.radiusReference = radiusReference
+    }
+
+    /// Builds editor state from a style preset without dropping preset glows.
+    /// Style preset radii use the renderer's longest-edge convention.
+    public init(
+        styleBackdrop: SettingsStyleBackdrop,
+        enabled: Bool? = nil,
+        material: SettingsBackdropMaterial? = nil,
+        materialOpacity: Double? = nil,
+        glassTintOpacity: Double? = nil,
+        glassStyle: SettingsBackdropGlassStyle? = nil,
+        frostedStyle: SettingsBackdropFrostedStyle? = nil,
+        frostedTintStrength: Double? = nil,
+        tintStrength: Double? = nil,
+        grainScale: Double? = nil,
+        matchColorAdjustments: Bool? = nil,
+        colorHarmony: SettingsColorHarmony? = nil
+    ) {
+        let storedEffects = styleBackdrop.effects?.normalized()
+        self.init(
+            enabled: enabled ?? storedEffects?.enabled ?? true,
+            material: material ?? storedEffects?.material ?? .liquidGlass,
+            materialOpacity: materialOpacity ?? storedEffects?.materialOpacity ?? 0.95,
+            glassTintOpacity: glassTintOpacity ?? storedEffects?.glassTintOpacity ?? 0.70,
+            glassStyle: glassStyle ?? storedEffects?.glassStyle ?? .regular,
+            frostedStyle: frostedStyle ?? storedEffects?.frostedStyle ?? .automatic,
+            frostedTintStrength: frostedTintStrength ?? storedEffects?.frostedTintStrength ?? 1,
+            tintStrength: tintStrength ?? storedEffects?.tintStrength ?? 0.4,
+            grain: styleBackdrop.finish.grain,
+            grainScale: grainScale ?? storedEffects?.grainScale ?? 0.5,
+            matchColorAdjustments: matchColorAdjustments ?? storedEffects?.matchColorAdjustments ?? true,
+            colorHarmony: colorHarmony ?? storedEffects?.colorHarmony ?? .custom,
+            glows: styleBackdrop.glows,
+            radiusReference: .longestEdge
+        )
+    }
+
+    /// The edge length used by the preview's normalized radius.
+    public func radiusScale(in size: CGSize) -> CGFloat {
+        radiusReference.length(in: size)
+    }
+
+    /// Updates the supported style-preset fields while preserving all other
+    /// preset metadata and finish settings. The viewport is required because
+    /// the legacy style schema uses the longest edge and the editor may use
+    /// the shortest edge.
+    public func updating(_ original: SettingsStyleBackdrop, viewportSize: CGSize) throws -> SettingsStyleBackdrop {
+        guard viewportSize.width.isFinite, viewportSize.height.isFinite,
+              viewportSize.width > 0, viewportSize.height > 0 else {
+            throw SettingsBackdropConfigurationError.invalidViewportSize
+        }
+        var result = original
+        let sourceScale = radiusReference.length(in: viewportSize)
+        let destinationScale = SettingsGlowRadiusReference.longestEdge.length(in: viewportSize)
+        let conversion: Double = if radiusReference == .shortestEdge, destinationScale > 0 {
+            Double(sourceScale / destinationScale)
+        } else {
+            1
+        }
+
+        result.glows = glows.map { glow in
+            var updated = glow
+            updated.radius = finiteNonnegative(glow.radius) * conversion
+            return updated
+        }
+        result.finish.grain = grain
+        result.effects = SettingsStyleBackdropEffects(
+            enabled: enabled,
+            material: material,
+            materialOpacity: materialOpacity,
+            glassTintOpacity: glassTintOpacity,
+            glassStyle: glassStyle,
+            frostedStyle: frostedStyle,
+            frostedTintStrength: frostedTintStrength,
+            tintStrength: tintStrength,
+            grainScale: grainScale,
+            matchColorAdjustments: matchColorAdjustments,
+            colorHarmony: colorHarmony
+        )
+        return result
+    }
+
+    /// Recolors existing glows without changing their geometry or identities.
+    public func applyingColorPalette(_ colors: [String], harmony: SettingsColorHarmony) -> Self {
+        guard colors.count == glows.count else { return self }
+        var next = self
+        next.colorHarmony = harmony
+        for index in next.glows.indices {
+            if let color = SettingsRGB(hex: colors[index]) {
+                next.glows[index].color = color
+            }
+        }
+        return next.normalized()
+    }
+
+    public func matchingColorAdjustments(_ enabled: Bool, selectedID: String?) -> Self {
+        var next = self
+        next.matchColorAdjustments = enabled
+        if enabled, let source = glows.first(where: { $0.id == selectedID }) ?? glows.first {
+            for index in next.glows.indices {
+                next.glows[index].radius = source.radius
+                next.glows[index].intensity = source.intensity
+            }
+        }
+        return next.normalized()
+    }
+
+    public func normalized() -> Self {
+        Self(
+            enabled: enabled,
+            material: material,
+            materialOpacity: materialOpacity,
+            glassTintOpacity: glassTintOpacity,
+            glassStyle: glassStyle,
+            frostedStyle: frostedStyle,
+            frostedTintStrength: frostedTintStrength,
+            tintStrength: tintStrength,
+            grain: grain,
+            grainScale: grainScale,
+            matchColorAdjustments: matchColorAdjustments,
+            colorHarmony: colorHarmony,
+            glows: glows,
+            radiusReference: radiusReference
+        )
+    }
+
+    private static func normalizedGlows(_ values: [SettingsStyleGlow]) -> [SettingsStyleGlow] {
+        values.enumerated().map { index, glow in
+            var result = glow
+            if result.id.isEmpty { result.id = "glow-\(index + 1)" }
+            result.x = bounded(result.x, to: 0...1)
+            result.y = bounded(result.y, to: 0...1)
+            result.radius = finiteNonnegative(result.radius)
+            result.intensity = bounded(result.intensity, to: 0...1)
+            return result
+        }
+    }
+
+    private static func bounded(_ value: Double, to range: ClosedRange<Double>) -> Double {
+        value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : range.lowerBound
+    }
+
+    private static func finiteNonnegative(_ value: Double) -> Double {
+        value.isFinite ? max(value, 0) : 0
+    }
+
+    private func finiteNonnegative(_ value: Double) -> Double {
+        Self.finiteNonnegative(value)
+    }
+}
+
+public extension SettingsStyleGlow {
+    /// The canonical six-digit representation used by the color editor.
+    var colorHex: String { color.hex }
+}
