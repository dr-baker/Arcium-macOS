+import Foundation
+import SettingsUI
+
+public enum SettingsStylePresetError: Error, Equatable, LocalizedError, Sendable {
+    case invalidValue(String)
+    case missingName
+    case unsupportedSchemaVersion(Int)
+
+    public var errorDescription: String? {
+        switch self {
+        case .invalidValue(let message):
+            message
+        case .missingName:
+            "The preset needs a name."
+        case .unsupportedSchemaVersion(let version):
+            "This preset uses schema version \(version). SettingsUI supports version \(SettingsStylePreset.currentSchemaVersion)."
+        }
+    }
+}
