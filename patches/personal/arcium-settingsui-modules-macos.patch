@@ -0,0 +1,111 @@
+import SwiftUI
+
+/// Keeps an inventory and its editor mounted while changing column arrangement.
+/// The application owns selection, persistence, and the decision to stack.
+public struct SettingsWorkspace<PageID: Hashable, Inventory: View, Detail: View>: View {
+    private let pageID: PageID
+    private let inventoryTitle: String
+    private let isInventoryVisible: Bool
+    private let isStacked: Bool
+    @Binding private var columnWidth: Double
+    private let widthRange: ClosedRange<CGFloat>
+    private let contentOffset: CGFloat
+    private let inventoryOffset: CGFloat
+    private let inventory: Inventory
+    private let detail: (CGSize) -> Detail
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var isDrawerExpanded = false
+
+    public init(
+        pageID: PageID,
+        inventoryTitle: String,
+        isInventoryVisible: Bool = true,
+        isStacked: Bool,
+        columnWidth: Binding<Double>,
+        widthRange: ClosedRange<CGFloat> = 240...380,
+        contentOffset: CGFloat = 0,
+        inventoryOffset: CGFloat = 0,
+        @ViewBuilder inventory: () -> Inventory,
+        @ViewBuilder detail: @escaping (CGSize) -> Detail
+    ) {
+        self.pageID = pageID
+        self.inventoryTitle = inventoryTitle
+        self.isInventoryVisible = isInventoryVisible
+        self.isStacked = isStacked
+        _columnWidth = columnWidth
+        self.widthRange = widthRange
+        self.contentOffset = contentOffset
+        self.inventoryOffset = inventoryOffset
+        self.inventory = inventory()
+        self.detail = detail
+    }
+
+    private var resolvedWidth: CGFloat {
+        let width = CGFloat(columnWidth)
+        return width.isFinite ? min(max(width, widthRange.lowerBound), widthRange.upperBound) : widthRange.lowerBound
+    }
+
+    private var showsInventory: Bool {
+        isInventoryVisible && (!isStacked || isDrawerExpanded)
+    }
+
+    private var layout: AnyLayout {
+        isStacked ? AnyLayout(VStackLayout(alignment: .leading, spacing: 0))
+            : AnyLayout(HStackLayout(alignment: .top, spacing: 0))
+    }
+
+    public var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            if isStacked && isInventoryVisible {
+                Button {
+                    isDrawerExpanded.toggle()
+                } label: {
+                    HStack {
+                        Label(inventoryTitle, systemImage: "list.bullet")
+                            .labelStyle(SettingsIconLabelStyle())
+                        Spacer()
+                        Image(systemName: "chevron.down")
+                            .settingsSymbol()
+                            .rotationEffect(.degrees(isDrawerExpanded ? 180 : 0))
+                    }
+                    .settingsFont(\.label)
+                    .padding(SettingsSpacing.sm)
+                    .contentShape(Rectangle())
+                }
+                .buttonStyle(.plain)
+                .accessibilityValue(isDrawerExpanded ? "Expanded" : "Collapsed")
+                Divider()
+            }
+            layout {
+                inventory
+                    .id(pageID)
+                    .frame(width: isStacked ? nil : resolvedWidth, alignment: .topLeading)
+                    .frame(maxHeight: isStacked ? 240 : .infinity, alignment: .topLeading)
+                    .offset(x: isStacked ? 0 : inventoryOffset, y: contentOffset)
+                    .frame(width: isStacked ? nil : (showsInventory ? resolvedWidth : 0),
+                           height: isStacked ? (showsInventory ? 240 : 0) : nil,
+                           alignment: .topLeading)
+                    .clipped()
+                    .opacity(showsInventory ? 1 : 0)
+                    .allowsHitTesting(showsInventory)
+                    .disabled(!showsInventory)
+                    .accessibilityHidden(!showsInventory)
+
+                SettingsColumnResizeHandle(width: $columnWidth, range: widthRange, label: "\(inventoryTitle) width")
+                    .frame(width: !isStacked && showsInventory ? 8 : 0, height: isStacked ? 0 : nil)
+                    .clipped()
+                    .allowsHitTesting(!isStacked && showsInventory)
+                    .accessibilityHidden(isStacked || !showsInventory)
+                    .disabled(isStacked || !showsInventory)
+
+                GeometryReader { geometry in detail(geometry.size) }
+                    .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+                    .offset(y: contentOffset)
+            }
+        }
+        .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+        .clipped()
+        .animation(reduceMotion ? nil : SettingsMotion.columnDrawer, value: isStacked)
+        .animation(reduceMotion ? nil : SettingsMotion.columnDrawer, value: isDrawerExpanded)
+    }
+}
