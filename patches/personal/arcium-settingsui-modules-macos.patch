-    /// Returns a point in the hue/saturation wheel. Hue zero is at the top
-    /// and hue increases clockwise.
-    public static func wheelPoint(hue: Double, saturation: Double, in size: CGSize) -> CGPoint {
-        let width = size.width.isFinite ? max(size.width, 0) : 0
-        let height = size.height.isFinite ? max(size.height, 0) : 0
-        let center = CGPoint(x: width / 2, y: height / 2)
-        let radius = min(width, height) / 2
-        guard radius > 0 else { return center }
-        let boundedSaturation = saturation.isFinite ? min(max(saturation, 0), 1) : 0
-        let angle = SettingsHarmonyColorHSV.wrapped(hue) * 2 * .pi - .pi / 2
-        return CGPoint(
-            x: center.x + cos(angle) * radius * boundedSaturation,
-            y: center.y + sin(angle) * radius * boundedSaturation
-        )
-    }
-
-    /// Converts a wheel point to hue and radial saturation, clamping outside
-    /// points to the wheel edge.
-    public static func wheelValue(
-        at location: CGPoint,
-        in size: CGSize,
-        fallbackHue: Double = 0
-    ) -> SettingsHarmonyWheelValue? {
-        let width = size.width.isFinite ? max(size.width, 0) : 0
-        let height = size.height.isFinite ? max(size.height, 0) : 0
-        let radius = min(width, height) / 2
-        guard radius > 0, location.x.isFinite, location.y.isFinite else { return nil }
-
-        let center = CGPoint(x: width / 2, y: height / 2)
-        let deltaX = location.x - center.x
-        let deltaY = location.y - center.y
-        let distance = hypot(deltaX, deltaY)
-        let saturation = min(max(distance / radius, 0), 1)
-        guard distance > 0.000001 else {
-            return SettingsHarmonyWheelValue(hue: fallbackHue, saturation: saturation)
-        }
-        let angle = atan2(deltaY, deltaX)
-        return SettingsHarmonyWheelValue(hue: (angle + .pi / 2) / (2 * .pi), saturation: saturation)
-    }
