+        isDragging = false
+        wheelDrag = nil
+        if let deferredExternalColors {
+            draftColors = deferredExternalColors
+            self.deferredExternalColors = nil
+            lastObservedColors = draftColors
+            syncTransientState()
+            return
+        }
+        guard draftColors != lastObservedColors else { return }
+        lastObservedColors = draftColors
+        colors = draftColors
+    }
+
+    private func commitHex() {
+        guard let selected = SettingsHarmonyColorHSV(hex: hexText, fallbackHue: hueFallback) else {
+            invalidHex = true
+            return
+        }
+        applySelected(selected, commit: true)
+    }
+
+    private func syncTransientState() {
+        guard let selectedHSV else {
+            brightness = 1
+            hueFallback = 0
+            hexText = "#FFFFFF"
+            invalidHex = false
+            return
+        }
+        brightness = selectedHSV.brightness
+        hexText = selectedHSV.hex
+        if selectedHSV.saturation > 0.000001 { hueFallback = selectedHSV.hue }
+        invalidHex = false
+    }
+
+    private func receiveExternalColors(_ values: [String]) {
+        let next = Self.normalizedColors(values)
+        if isDragging {
+            deferredExternalColors = next == draftColors ? nil : next
+            lastObservedColors = next
+            return
+        }
+        lastObservedColors = next
+        guard next != draftColors else { return }
+        draftColors = next
+        deferredExternalColors = nil
+        syncTransientState()
+    }
+
+    private static func activeIndex(_ index: Int, count: Int) -> Int? {
+        guard count > 0 else { return nil }
+        return min(max(index, 0), count - 1)
+    }
+
+    private static func normalizedColors(_ values: [String]) -> [String] {
+        values.map { SettingsRGB(hex: $0)?.hex ?? "#FFFFFF" }
+    }
+
+    private func percent(_ value: Double) -> String { "\(Int((value * 100).rounded()))%" }
+
+    private struct HarmonyMarker: Identifiable {
+        let index: Int
+        let color: SettingsHarmonyColorHSV
+        let isSelected: Bool
+        var id: Int { index }
+        var hue: Double { color.hue }
+        var saturation: Double { color.saturation }
+    }
+}
+
+private extension SettingsColorHarmony {
+    var shortTitle: String {
+        switch self {
+        case .custom: "Free"
+        case .close: "Close"
+        case .analogous: "Related"
+        case .complementary: "Opposite"
+        case .splitComplementary: "Split"
+        case .triadic: "Triad"
+        case .tetradic: "Square"
+        }
+    }
+}
