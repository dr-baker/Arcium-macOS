+import AppKit
+import SwiftUI
+
+public extension EnvironmentValues {
+    /// The macOS color scheme, unaffected by the window's own appearance.
+    /// Provided by ``SwiftUI/View/settingsWindowAppearance(_:)``.
+    @Entry var settingsSystemColorScheme: ColorScheme = .light
+}
+
+public extension View {
+    /// Sets the hosting window's appearance. `.system` removes the override so
+    /// the window follows macOS again. Use this instead of
+    /// `preferredColorScheme`, which does not return a macOS window to the
+    /// system appearance after forcing Light or Dark.
+    func settingsWindowAppearance(_ appearance: SettingsAppearance) -> some View {
+        modifier(SettingsWindowAppearanceModifier(appearance: appearance))
+    }
+}
+
+private struct SettingsWindowAppearanceModifier: ViewModifier {
+    let appearance: SettingsAppearance
+    @State private var systemColorScheme = Self.colorScheme(for: NSApplication.shared.effectiveAppearance)
+
+    func body(content: Content) -> some View {
+        content
+            .background(WindowAppearanceApplier(appearance: appearance).frame(width: 0, height: 0))
+            .environment(\.settingsSystemColorScheme, systemColorScheme)
+            .onReceive(NSApplication.shared.publisher(for: \.effectiveAppearance)) {
+                systemColorScheme = Self.colorScheme(for: $0)
+            }
+    }
+
+    static func colorScheme(for appearance: NSAppearance) -> ColorScheme {
+        appearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua ? .dark : .light
+    }
+}
+
+private struct WindowAppearanceApplier: NSViewRepresentable {
+    let appearance: SettingsAppearance
+
+    func makeNSView(context: Context) -> WindowAppearanceView { WindowAppearanceView() }
+
+    func updateNSView(_ view: WindowAppearanceView, context: Context) {
+        view.requested = appearance.colorScheme.map { $0 == .dark ? .darkAqua : .aqua }
+    }
+
+    static func dismantleNSView(_ view: WindowAppearanceView, coordinator: ()) {
+        view.restore()
+    }
+}
+
+private final class WindowAppearanceView: NSView {
+    private weak var configuredWindow: NSWindow?
+    private var originalAppearance: NSAppearance?
+    var requested: NSAppearance.Name? {
+        didSet { apply() }
+    }
+
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        guard window !== configuredWindow else { return }
+        restore()
+        configuredWindow = window
+        originalAppearance = window?.appearance
+        apply()
+    }
+
+    override func hitTest(_ point: NSPoint) -> NSView? { nil }
+
+    func restore() {
+        configuredWindow?.appearance = originalAppearance
+        configuredWindow = nil
+    }
+
+    private func apply() {
+        guard let window = configuredWindow, window.appearance?.name != requested else { return }
+        window.appearance = requested.flatMap(NSAppearance.init(named:))
+    }
+}
