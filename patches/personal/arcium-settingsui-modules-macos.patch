+import SwiftUI
+
+public nonisolated enum SControlRowStyle: Equatable, Sendable {
+    /// Bounded, aligned input columns that stack when the content cannot fit.
+    case standard
+    case compact
+}
+
+public nonisolated enum SControlRowAlignment: Equatable, Sendable {
+    /// Expanding inputs share a bounded width and align to the trailing edge.
+    case input
+    /// Compact controls, such as switches, remain on the trailing edge.
+    case trailing
+}
+
+/// A stable layout: changing the proposed width never replaces an editor.
+struct SAdaptiveControlLayout: Layout {
+    static let inputColumnWidth: CGFloat = 260
+    var inputWidth: CGFloat = Self.inputColumnWidth
+    let horizontalSpacing: CGFloat
+    let verticalSpacing: CGFloat
+    var alignment: SControlRowAlignment = .input
+
+    func sizeThatFits(proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) -> CGSize {
+        measure(proposal: proposal, subviews: subviews).size
+    }
+
+    func placeSubviews(in bounds: CGRect, proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) {
+        guard subviews.count == 3 else { return }
+        let result = measure(proposal: ProposedViewSize(width: bounds.width, height: nil), subviews: subviews)
+        subviews[0].place(at: CGPoint(x: bounds.minX, y: bounds.minY + result.labelY), proposal: ProposedViewSize(result.title))
+        subviews[1].place(at: CGPoint(x: bounds.minX, y: bounds.minY + result.labelY + result.title.height + result.descriptionGap),
+                          proposal: ProposedViewSize(result.description))
+        subviews[2].place(
+            at: CGPoint(x: bounds.maxX,
+                        y: bounds.minY + result.controlY),
+            anchor: .topTrailing,
+            proposal: ProposedViewSize(width: result.controlWidth, height: result.control.height)
+        )
+    }
+
+    private func measure(proposal: ProposedViewSize, subviews: Subviews) -> Measurement {
+        guard subviews.count == 3 else { return Measurement() }
+        let titleIdeal = subviews[0].sizeThatFits(.unspecified)
+        // Never offer infinity to native pickers or sliders. Flexible controls
+        // get a finite column; intrinsic controls can report a larger fit need.
+        let controlIdeal = subviews[2].sizeThatFits(.unspecified)
+        let controlMinimum = subviews[2].sizeThatFits(ProposedViewSize(width: 0, height: nil))
+        let width = max(0, proposal.width.flatMap { $0.isFinite ? $0 : nil }
+                        ?? (min(titleIdeal.width, 360) + horizontalSpacing + inputWidth))
+        let column = alignment == .trailing ? min(width, controlIdeal.width) : min(inputWidth, width)
+        let labelWidth = max(0, width - horizontalSpacing - column)
+        let horizontal = titleIdeal.width <= labelWidth && controlMinimum.width <= column
+        let readingWidth = min(horizontal ? labelWidth : width, 360)
+        let title = subviews[0].sizeThatFits(ProposedViewSize(width: readingWidth, height: nil))
+        let description = subviews[1].sizeThatFits(ProposedViewSize(width: readingWidth, height: nil))
+        let descriptionGap = description.height > 0 ? verticalSpacing : 0
+        let labelHeight = title.height + descriptionGap + description.height
+        let controlWidth = horizontal ? column : min(width, alignment == .trailing
+            ? controlIdeal.width : max(inputWidth, controlMinimum.width))
+        let control = subviews[2].sizeThatFits(ProposedViewSize(width: controlWidth, height: nil))
+        let controlY = horizontal ? max(0, (title.height - control.height) / 2) : labelHeight + verticalSpacing
+        let labelY = horizontal ? max(0, (control.height - title.height) / 2) : 0
+        return Measurement(size: CGSize(width: width, height: max(labelY + labelHeight, controlY + control.height)),
+                           title: title, description: description, descriptionGap: descriptionGap,
+                           control: control, controlWidth: controlWidth,
+                           controlY: controlY, labelY: labelY)
+    }
+
+    private struct Measurement {
+        var size: CGSize = .zero
+        var title: CGSize = .zero
+        var description: CGSize = .zero
+        var descriptionGap: CGFloat = 0
+        var control: CGSize = .zero
+        var controlWidth: CGFloat = 0
+        var controlY: CGFloat = 0
+        var labelY: CGFloat = 0
+    }
+}
+
+/// Use for native custom inputs that should align with the built-in controls.
+public struct SControlRow<Label: View, Control: View>: View {
+    let description: String?
+    let style: SControlRowStyle
+    let alignment: SControlRowAlignment
+    let label: Label
+    let control: Control
+    @Environment(\.settingsLayout) private var layout
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.isEnabled) private var isEnabled
+
+    public init(
+        description: String? = nil,
+        style: SControlRowStyle = .standard,
+        alignment: SControlRowAlignment = .input,
+        @ViewBuilder label: () -> Label,
+        @ViewBuilder control: () -> Control
+    ) {
+        self.description = description
+        self.style = style
+        self.alignment = alignment
+        self.label = label()
+        self.control = control()
+    }
+
+    public var body: some View {
+        Group {
+            if style == .standard {
+                SAdaptiveControlLayout(inputWidth: layout.inputWidth, horizontalSpacing: SettingsSpacing.md, verticalSpacing: SettingsSpacing.xs,
+                                       alignment: alignment) {
+                    label
+                    descriptionView
+                    control
+                }
+            } else {
+                VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+                    HStack(spacing: SettingsSpacing.sm) {
+                        label
+                        Spacer(minLength: SettingsSpacing.sm)
+                        control
+                    }
+                    descriptionView
+                }
+            }
+        }
+        .opacity(isEnabled ? 1 : SettingsEffects.disabledOpacity)
+        .padding(.vertical, style == .standard ? SettingsSpacing.xxs : 0)
+    }
+
+    @ViewBuilder private var descriptionView: some View {
+        if let description {
+            Text(description)
+                .settingsFont(\.caption)
+                .foregroundStyle(theme.textSecondary)
+                .fixedSize(horizontal: false, vertical: true)
+        } else {
+            Color.clear.frame(width: 0, height: 0).accessibilityHidden(true)
+        }
+    }
+}
+
+struct SControlRowLabel: View {
+    let title: String
+    let help: SHelp?
+
+    var body: some View {
+        HStack(spacing: SettingsSpacing.xs) {
+            Text(title).settingsFont(\.label)
+            if let help { SInfo(help: help, title: "About \(title)") }
+        }
+    }
+}
