+import Foundation
+import SettingsUI
+
+/// Bounded motion and intensity controls for a settings backdrop.
+public nonisolated struct SettingsBackdropMotion: Sendable, Equatable, Codable {
+    /// Peak-to-peak travel in normalized backdrop coordinates.
+    public let travel: Double
+    /// Maximum fractional opacity variation around the base intensity.
+    public let pulse: Double
+    /// Global multiplier applied to glow opacity.
+    public let strength: Double
+
+    public init(
+        travel: Double = 0.10,
+        pulse: Double = 0.15,
+        strength: Double = 1
+    ) {
+        self.travel = Self.bounded(travel, range: 0...1, fallback: 0.10)
+        self.pulse = Self.bounded(pulse, range: 0...1, fallback: 0.15)
+        self.strength = Self.bounded(strength, range: 0...3, fallback: 1)
+    }
+
+    public init(from decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.init(
+            travel: try container.decode(Double.self, forKey: .travel),
+            pulse: try container.decode(Double.self, forKey: .pulse),
+            strength: try container.decode(Double.self, forKey: .strength)
+        )
+    }
+
+    /// Returns a deterministic orbital offset and opacity multiplier for one glow.
+    public func sample(
+        phase: Double,
+        index: Int,
+        isAnimated: Bool = true
+    ) -> SettingsBackdropMotionSample {
+        guard isAnimated else {
+            return SettingsBackdropMotionSample(xOffset: 0, yOffset: 0, opacityMultiplier: strength)
+        }
+
+        let safePhase = phase.isFinite ? phase : 0
+        let stableIndex = Double(index % 97)
+        let indexPhase = stableIndex * 2.399_963_229_728_653
+        let orbit = safePhase / (20 + Double(index % 5) * 2.75)
+        let travelRadius = travel / 2
+        let xOffset = cos(orbit + indexPhase) * travelRadius
+        let yOffset = sin(orbit * 0.83 + indexPhase * 1.37) * travelRadius
+        let opacityMultiplier = strength * (1 + sin(orbit * 1.31 + indexPhase * 0.71) * pulse)
+
+        return SettingsBackdropMotionSample(
+            xOffset: Self.bounded(xOffset, range: -travelRadius...travelRadius, fallback: 0),
+            yOffset: Self.bounded(yOffset, range: -travelRadius...travelRadius, fallback: 0),
+            opacityMultiplier: Self.bounded(
+                opacityMultiplier,
+                range: 0...(strength * (1 + pulse)),
+                fallback: strength
+            )
+        )
+    }
+
+    private static func bounded(
+        _ value: Double,
+        range: ClosedRange<Double>,
+        fallback: Double
+    ) -> Double {
+        value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : fallback
+    }
+}
