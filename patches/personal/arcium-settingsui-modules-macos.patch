+import Foundation
+import SettingsUI
+
+/// Optional decorative artwork rendered on both sides of a glass surface.
+public nonisolated struct SettingsGlassReflectionConfiguration: Codable, Equatable, Sendable {
+    public enum Blend: String, Codable, CaseIterable, Sendable {
+        case normal
+        case plusLighter
+
+        public var title: String {
+            switch self {
+            case .normal: "Normal"
+            case .plusLighter: "Additive light"
+            }
+        }
+    }
+
+    public var enabled: Bool
+    /// Rear artwork gain, multiplied by `behindOpacity` before opacity is bounded to 1.
+    public var intensity: Double
+    public var behindOpacity: Double
+    public var blurRadius: Double
+    public var blend: Blend
+    public var aboveCurve: SettingsGlassReflectionCurve
+    public var behindCurve: SettingsGlassReflectionCurve
+
+    public init(
+        enabled: Bool = false,
+        intensity: Double = 0.8,
+        behindOpacity: Double = 0.3,
+        blurRadius: Double = 10,
+        blend: Blend = .normal,
+        aboveCurve: SettingsGlassReflectionCurve = .aboveDefault,
+        behindCurve: SettingsGlassReflectionCurve = .behindDefault
+    ) {
+        self.enabled = enabled
+        self.intensity = intensity
+        self.behindOpacity = behindOpacity
+        self.blurRadius = blurRadius
+        self.blend = blend
+        self.aboveCurve = aboveCurve
+        self.behindCurve = behindCurve
+    }
+
+    public var normalized: Self {
+        Self(
+            enabled: enabled,
+            intensity: bounded(intensity, to: 0...2, fallback: 0.8),
+            behindOpacity: bounded(behindOpacity, to: 0...1, fallback: 0.3),
+            blurRadius: bounded(blurRadius, to: 0...40, fallback: 10),
+            blend: blend,
+            aboveCurve: aboveCurve.normalized(fallback: .aboveDefault),
+            behindCurve: behindCurve.normalized(fallback: .behindDefault)
+        )
+    }
+
+    public func validate() throws {
+        guard intensity.isFinite && (0...2).contains(intensity) else {
+            throw SettingsStylePresetError.invalidValue("Glass reflection intensity must be finite and between 0 and 2.")
+        }
+        guard behindOpacity.isFinite && (0...1).contains(behindOpacity) else {
+            throw SettingsStylePresetError.invalidValue("Glass reflection rear opacity must be finite and between 0 and 1.")
+        }
+        guard blurRadius.isFinite && (0...40).contains(blurRadius) else {
+            throw SettingsStylePresetError.invalidValue("Glass reflection blur radius must be finite and between 0 and 40.")
+        }
+        try aboveCurve.validate()
+        try behindCurve.validate()
+    }
+
+    var rearOpacity: Double {
+        let gain = bounded(intensity, to: 0...2, fallback: 0.8)
+        let opacity = bounded(behindOpacity, to: 0...1, fallback: 0.3)
+        return min(1, gain * opacity)
+    }
+
+    func renderedOpacities(surfaceOpacity: Double, reduceTransparency: Bool) -> (above: Double, behind: Double) {
+        guard enabled && !reduceTransparency else { return (0, 0) }
+        let above = bounded(surfaceOpacity, to: 0...1, fallback: 1)
+        return (above, above * rearOpacity)
+    }
+
+    private func bounded(_ value: Double, to range: ClosedRange<Double>, fallback: Double) -> Double {
+        value.isFinite ? max(range.lowerBound, min(range.upperBound, value)) : fallback
+    }
+}
