+import CoreGraphics
+import Foundation
+import SettingsUI
+
+public enum SettingsColorField: String, CaseIterable, Codable, Sendable {
+    case window = "Window"
+    case display = "Display"
+}
+
+/// Deterministic best-candidate sampling: each color gets its own even, irregular
+/// coverage. No lattice, no regeneration when a window moves.
+enum SettingsDisplayFieldLayout {
+    private struct CacheKey: Equatable {
+        let size: CGSize
+        let colorCount: Int
+    }
+    private static var cache: [(key: CacheKey, points: [(color: Int, point: CGPoint)])] = []
+
+    static func points(size: CGSize, colorCount: Int) -> [(color: Int, point: CGPoint)] {
+        guard size.width > 0, size.height > 0, colorCount > 0 else { return [] }
+        let key = CacheKey(size: size, colorCount: colorCount)
+        if let existing = cache.first(where: { $0.key == key }) { return existing.points }
+        let count = max(4, min(24, Int(ceil(size.width * size.height / 250_000))))
+        var seed: UInt64 = 0xD15A1A7
+        func random() -> Double {
+            seed = seed &* 6364136223846793005 &+ 1442695040888963407
+            return Double(seed >> 11) / Double(UInt64.max >> 11)
+        }
+        var result: [(color: Int, point: CGPoint)] = []
+        for color in 0..<colorCount {
+            var own: [CGPoint] = []
+            for _ in 0..<count {
+                var best = CGPoint.zero
+                var bestDistance = -Double.infinity
+                for _ in 0..<48 {
+                    let p = CGPoint(x: random() * size.width, y: random() * size.height)
+                    let distance = own.map { hypot(p.x - $0.x, p.y - $0.y) }.min() ?? 1
+                    if distance > bestDistance { best = p; bestDistance = distance }
+                }
+                own.append(best)
+                result.append((color, best))
+            }
+        }
+        cache.append((key, result))
+        if cache.count > 8 { cache.removeFirst() }
+        return result
+    }
+
+    /// A seed moves its color's display-anchored pattern, with wrapping to retain coverage.
+    static func position(_ point: CGPoint, seed: CGPoint, size: CGSize) -> CGPoint {
+        func wrap(_ value: CGFloat, extent: CGFloat) -> CGFloat {
+            guard extent > 0 else { return 0 }
+            let remainder = value.truncatingRemainder(dividingBy: extent)
+            return remainder < 0 ? remainder + extent : remainder
+        }
+        let x = seed.x.isFinite ? min(max(seed.x, 0), 1) : 0.5
+        let y = seed.y.isFinite ? min(max(seed.y, 0), 1) : 0.5
+        return CGPoint(x: wrap(point.x + (x - 0.5) * size.width, extent: size.width),
+                       y: wrap(point.y + (y - 0.5) * size.height, extent: size.height))
+    }
+}
