+
+struct SettingsBackdropFinishModifier: ViewModifier {
+    let finish: SettingsBackdropFinish
+    let colorScheme: ColorScheme
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+
+    func body(content: Content) -> some View {
+        content
+            .saturation(bounded(finish.saturation, maximum: 2))
+            .opacity(bounded(finish.opacity, maximum: 1))
+            .overlay(SettingsBackdropGrainOverlay(finish: finish))
+            .overlay(vignette)
+    }
+
+    @ViewBuilder
+    private var vignette: some View {
+        if !reduceTransparency, finish.vignette > 0 {
+            let color = (colorScheme == .dark ? Color.black : Color.white)
+                .opacity(bounded(finish.vignette, maximum: 1))
+            GeometryReader { @Sendable geometry in
+                RadialGradient(colors: [.clear, color], center: .center, startRadius: 0,
+                               endRadius: max(geometry.size.width, geometry.size.height) * 0.65)
+            }
+        }
+    }
+
+    private func bounded(_ value: Double, maximum: Double) -> Double {
+        value.isFinite ? min(max(value, 0), maximum) : 0
+    }
+
+}
