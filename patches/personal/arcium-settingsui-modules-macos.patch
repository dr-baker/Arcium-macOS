+        self.windowChromeLightOpacity = Self.opacity(windowChromeLightOpacity)
+        self.sidebarRailDarkOpacity = Self.opacity(sidebarRailDarkOpacity)
+        self.sidebarRailLightOpacity = Self.opacity(sidebarRailLightOpacity)
+        self.windowFrameTintOpacity = Self.opacity(windowFrameTintOpacity)
+        self.panelTintOpacity = Self.opacity(panelTintOpacity)
+        self.cardOpacity = Self.opacity(cardOpacity)
+        self.controlOpacity = Self.opacity(controlOpacity)
+        self.cardTintOpacity = Self.opacity(cardTintOpacity)
+        self.controlTintOpacity = Self.opacity(controlTintOpacity)
+        self.navRailTintOpacity = Self.opacity(navRailTintOpacity)
+        self.compactNavTintOpacity = Self.opacity(compactNavTintOpacity)
+        self.inactiveTrackOpacity = Self.opacity(inactiveTrackOpacity)
+        self.problematicTrackOpacity = Self.opacity(problematicTrackOpacity)
+        self.radiusScale = min(max(radiusScale.isFinite ? radiusScale : 1, 0.5), 2)
+    }
+
+    public var accent: Color { selectionStrong }
+    public var accentFill: Color { controlSelectionFill }
+    public var navSelectionFill: Color { selectionStrong }
+    public var background: Color { windowCanvas }
+    public var backgroundWash: Color { windowCanvasWash }
+    public var surface: Color { panel }
+    public var surfaceRaised: Color { panelRaised }
+    public var surfaceInset: Color { panelInset }
+    public var windowFrameBackground: Color { windowFrame }
+    public var shadow: Color { shadowAmbient }
+    public var border: Color { borderSubtle }
+
+    // Nested fills and hairlines derive from the primary text color, so each
+    // step reads the same over any card, material, or appearance.
+    /// Pointer hover behind a row or small control.
+    public var hoverFill: Color { textPrimary.opacity(0.06) }
+    /// Recessed backgrounds: segmented tracks, wells, and input groups.
+    public var insetFill: Color { textPrimary.opacity(0.07) }
+    /// Raised content inside a card: keycaps, chips, and selected segments.
+    public var raisedFill: Color { textPrimary.opacity(0.12) }
+    /// A pressed or actively edited control.
+    public var pressedFill: Color { textPrimary.opacity(0.18) }
+    /// Hairline between or around nested content.
+    public var separator: Color { textPrimary.opacity(0.14) }
+
+    public var panelSurfaceBorder: Color { textPrimary.opacity(0.08) }
+    public var cardSurfaceBorder: Color { textPrimary.opacity(0.10) }
+    public var controlSurfaceBorder: Color { textPrimary.opacity(0.12) }
+    public var controlHoverBorder: Color { textPrimary.opacity(0.22) }
+    public var controlSelectionBorder: Color { selection.opacity(0.55) }
+
+    public func radius(_ value: CGFloat) -> CGFloat { value * radiusScale }
+
+    public func windowChromeOpacity(for colorScheme: ColorScheme) -> CGFloat {
+        colorScheme == .light ? windowChromeLightOpacity : windowChromeDarkOpacity
+    }
+
+    public func sidebarRailOpacity(for colorScheme: ColorScheme) -> CGFloat {
+        colorScheme == .light ? sidebarRailLightOpacity : sidebarRailDarkOpacity
+    }
+
+    private static func opacity(_ value: CGFloat) -> CGFloat {
+        min(max(value.isFinite ? value : 0, 0), 1)
+    }
+
+    private static func nonnegative(_ value: CGFloat) -> CGFloat {
+        max(value.isFinite ? value : 0, 0)
+    }
+}
+
+public extension EnvironmentValues {
+    @Entry var settingsTheme: SettingsTheme = .standard
+    @Entry var settingsFontScale: CGFloat = 1
+}
+
+public extension View {
+    func settingsTheme(_ theme: SettingsTheme) -> some View {
+        environment(\.settingsTheme, theme)
+    }
+}
