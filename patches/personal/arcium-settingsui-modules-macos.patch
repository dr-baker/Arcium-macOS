-        public mutating func location(at pointer: CGPoint) -> CGPoint? {
-            guard let marker else { return pointer }
-            let delta = CGSize(width: pointer.x - start.x, height: pointer.y - start.y)
-            // A click selects a marker without rounding or changing its color.
-            guard hasMoved || hypot(delta.width, delta.height) > 1 else { return nil }
-            hasMoved = true
-            return CGPoint(x: marker.x + delta.width, y: marker.y + delta.height)
-        }
