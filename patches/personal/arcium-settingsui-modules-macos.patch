+    public struct WheelDrag: Equatable {
+        public let selectedIndex: Int
+        private let start: CGPoint
+        private let marker: CGPoint?
+        private var hasMoved = false
+
+        fileprivate init(selectedIndex: Int, start: CGPoint, marker: CGPoint?) {
+            self.selectedIndex = selectedIndex
+            self.start = start
+            self.marker = marker
+        }
+
+        public mutating func location(at pointer: CGPoint) -> CGPoint? {
+            guard let marker else { return pointer }
+            let delta = CGSize(width: pointer.x - start.x, height: pointer.y - start.y)
+            // A click selects a marker without rounding or changing its color.
+            guard hasMoved || hypot(delta.width, delta.height) > 1 else { return nil }
+            hasMoved = true
+            return CGPoint(x: marker.x + delta.width, y: marker.y + delta.height)
+        }
+    }
+
+    public static func beginWheelDrag(
+        colors: [String], selectedIndex: Int, at start: CGPoint, in size: CGSize,
+        fallbackHue: Double = 0, hitRadius: Double = 18
+    ) -> WheelDrag? {
+        guard let selected = activeIndex(selectedIndex, count: colors.count) else { return nil }
+        let hits = colors.indices.compactMap { index -> (Int, CGPoint, Double)? in
+            guard let hsv = SettingsHarmonyColorHSV(hex: colors[index], fallbackHue: fallbackHue) else { return nil }
+            let point = wheelPoint(hue: hsv.hue, saturation: hsv.saturation, in: size)
+            let distance = Double(hypot(point.x - start.x, point.y - start.y))
+            return distance <= hitRadius ? (index, point, distance) : nil
+        }
+        let hit = hits.min { a, b in
+            if abs(a.2 - b.2) < 0.001 { return a.0 == selected && b.0 != selected }
+            return a.2 < b.2
+        }
+        return WheelDrag(selectedIndex: hit?.0 ?? selected, start: start, marker: hit?.1)
+    }
