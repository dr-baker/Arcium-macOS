+import SwiftUI
+
+public struct SSegmentedControl<OptionValue: Hashable>: View {
+    public let title: String
+    public let options: [(value: OptionValue, label: String)]
+    @Binding private var selection: OptionValue
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.isEnabled) private var isEnabled
+    @Environment(\.layoutDirection) private var layoutDirection
+    @FocusState private var focusedOption: OptionValue?
+
+    public init(_ title: String, options: [(value: OptionValue, label: String)], selection: Binding<OptionValue>) {
+        self.title = title
+        self.options = options
+        _selection = selection
+    }
+
+    public var body: some View {
+        HStack(spacing: 0) {
+            ForEach(options, id: \.value) { option in
+                let selected = selection == option.value
+                Button { selection = option.value } label: {
+                    Text(option.label)
+                        .settingsFont(\.caption)
+                        .foregroundStyle(selected ? theme.selectionText : theme.textPrimary)
+                        .padding(.horizontal, SettingsSpacing.sm)
+                        .padding(.vertical, SettingsSpacing.xs)
+                        .background {
+                            if selected {
+                                RoundedRectangle(cornerRadius: max(2, SettingsRadius.control - 2))
+                                    .fill(theme.selectionStrong)
+                            }
+                        }
+                        .contentShape(Rectangle())
+                }
+                .buttonStyle(.plain)
+                .focused($focusedOption, equals: option.value)
+                .accessibilityLabel(option.label)
+                .accessibilityAddTraits(selected ? .isSelected : [])
+            }
+        }
+        .padding(2)
+        .opacity(isEnabled ? 1 : 0.5)
+        .onMoveCommand(perform: moveSelection)
+        .accessibilityElement(children: .contain)
+        .accessibilityLabel(title)
+        .settingsMaterialSurface(
+            material: .ultraThinMaterial,
+            tint: theme.control,
+            tintOpacity: 0.18,
+            cornerRadius: SettingsRadius.control,
+            border: theme.controlSurfaceBorder
+        )
+        .fixedSize(horizontal: true, vertical: false)
+    }
+
+    private func moveSelection(_ direction: MoveCommandDirection) {
+        guard isEnabled, let index = options.firstIndex(where: {
+            $0.value == (focusedOption ?? selection)
+        }) else { return }
+        let delta: Int
+        switch direction {
+        case .left: delta = layoutDirection == .rightToLeft ? 1 : -1
+        case .right: delta = layoutDirection == .rightToLeft ? -1 : 1
+        default: return
+        }
+        let next = min(max(index + delta, 0), options.count - 1)
+        selection = options[next].value
+        focusedOption = selection
+    }
+}
