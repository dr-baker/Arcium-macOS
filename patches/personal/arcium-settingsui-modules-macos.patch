--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_settings_swift/Vendor/SettingsUI/Sources/SettingsUIAuthoring/SettingsGlassOpacityCurve.swift
@@ -0,0 +1,219 @@
+import Foundation
+import SettingsUI
+import SettingsUIStyle
+
+/// Maps the opacity exposed by a Regular glass control to the opacity used by
+/// Clear glass, and provides the inverse mapping for a shared control.
+///
+/// A curve starts with the identity mapping. Hosts that have measured a
+/// different relationship can create a validated quadratic or edit the five
+/// regular opacity knots with ``setClearOpacity(_:at:)``. The curve is a value
+/// owned by the host; SettingsUI does not persist it.
+public struct SettingsGlassOpacityCurve: Equatable, Sendable {
+    public enum ValidationError: Error, Equatable, Sendable {
+        case nonFiniteCoefficient
+        case interceptOutOfRange
+        case endpointIsNotOpaque(Double)
+        case nonMonotonic
+        case invalidControlPointCount
+        case nonFiniteControlPoint
+        case nonMonotonicControlPoints
+        case controlPointEndpointIsNotOpaque(Double)
+    }
+
+    public static let regularLevels: [Double] = [0, 0.25, 0.5, 0.75, 1]
+
+    /// The neutral mapping used by reusable controls.
+    public static let identity = SettingsGlassOpacityCurve(
+        representation: .quadratic(intercept: 0, linear: 1, quadratic: 0)
+    )
+
+    private enum Representation: Equatable, Sendable {
+        case quadratic(intercept: Double, linear: Double, quadratic: Double)
+        case controlPoints([Double])
+    }
+
+    private var representation: Representation
+
+    private init(representation: Representation) {
+        self.representation = representation
+    }
+
+    /// Creates an exact quadratic curve over the normalized interval.
+    ///
+    /// The curve must be finite, monotonic on `[0, 1]`, start in the opacity
+    /// range, and end at exactly opaque. A zero derivative at either endpoint
+    /// is valid, which allows curves such as `x²` and `2x - x²`.
+    public static func quadratic(
+        intercept: Double,
+        linear: Double,
+        quadratic: Double
+    ) throws -> Self {
+        guard intercept.isFinite, linear.isFinite, quadratic.isFinite else {
+            throw ValidationError.nonFiniteCoefficient
+        }
+        guard intercept >= 0, intercept <= 1 else {
+            throw ValidationError.interceptOutOfRange
+        }
+
+        let endpoint = intercept + linear + quadratic
+        guard endpoint.isFinite else {
+            throw ValidationError.nonFiniteCoefficient
+        }
+        guard abs(endpoint - 1) <= 1e-9 else {
+            throw ValidationError.endpointIsNotOpaque(endpoint)
+        }
+
+        // The derivative is linear. Checking both endpoints proves it is
+        // nonnegative across the whole interval, while retaining zero-slope
+        // endpoints for common easing curves.
+        let derivativeAtZero = linear
+        let derivativeAtOne = linear + 2 * quadratic
+        guard derivativeAtZero >= -1e-12, derivativeAtOne >= -1e-12 else {
+            throw ValidationError.nonMonotonic
+        }
+        guard derivativeAtZero > 1e-12 || derivativeAtOne > 1e-12 else {
+            // A constant curve is monotonic in the weak mathematical sense,
+            // but it has no inverse and cannot represent an opacity control.
+            throw ValidationError.nonMonotonic
+        }
+
+        return Self(representation: .quadratic(
+            intercept: intercept,
+            linear: linear,
+            quadratic: quadratic
+        ))
+    }
+
+    /// Creates a monotonic curve from values at ``regularLevels``.
+    public init(clearValues: [Double]) throws {
+        guard clearValues.count == Self.regularLevels.count else {
+            throw ValidationError.invalidControlPointCount
+        }
+        guard clearValues.allSatisfy({ $0.isFinite }) else {
+            throw ValidationError.nonFiniteControlPoint
+        }
+        guard clearValues.allSatisfy({ $0 >= 0 && $0 <= 1 }) else {
+            throw ValidationError.nonMonotonicControlPoints
+        }
+        guard zip(clearValues, clearValues.dropFirst()).allSatisfy({ $0.0 < $0.1 }) else {
+            throw ValidationError.nonMonotonicControlPoints
+        }
+        guard abs(clearValues[4] - 1) <= 1e-9 else {
+            throw ValidationError.controlPointEndpointIsNotOpaque(clearValues[4])
+        }
+        self.representation = .controlPoints(clearValues)
+    }
+
+    /// Clear-glass opacity for a normalized Regular opacity value.
+    public func clearOpacity(for regular: Double) -> Double {
+        let x = bounded(regular, in: 0...1)
+        switch representation {
+        case let .quadratic(intercept, linear, quadratic):
+            return bounded(intercept + linear * x + quadratic * x * x, in: 0...1)
+        case let .controlPoints(values):
+            let index = min(Int(x * 4), 3)
+            let fraction = (x - Self.regularLevels[index]) * 4
+            return values[index] + fraction * (values[index + 1] - values[index])
+        }
+    }
+
+    /// Regular-glass opacity for a normalized Clear opacity value.
+    public func regularOpacity(for clear: Double) -> Double {
+        let values = clearValues
+        let y = bounded(clear, in: values[0]...1)
+        switch representation {
+        case let .quadratic(intercept, linear, quadratic):
+            return invertQuadratic(
+                y: y,
+                intercept: intercept,
+                linear: linear,
+                quadratic: quadratic
+            )
+        case let .controlPoints(values):
+            let index = (0..<4).first { y <= values[$0 + 1] } ?? 3
+            let span = values[index + 1] - values[index]
+            guard span > 0 else { return Self.regularLevels[index] }
+            let fraction = (y - values[index]) / span
+            return bounded(Self.regularLevels[index] + fraction * 0.25, in: 0...1)
+        }
+    }
+
+    /// The five current Clear opacity values at ``regularLevels``.
+    public var clearValues: [Double] {
+        switch representation {
+        case let .quadratic(intercept, linear, quadratic):
+            return Self.regularLevels.map { level in
+                bounded(intercept + linear * level + quadratic * level * level, in: 0...1)
+            }
+        case let .controlPoints(values):
+            return values
+        }
+    }
+
+    /// Updates one editable control point while retaining monotonicity.
+    /// The opaque endpoint at index `4` is intentionally fixed.
+    public mutating func setClearOpacity(_ value: Double, at index: Int) {
+        guard Self.regularLevels.indices.contains(index), index < Self.regularLevels.count - 1,
+              value.isFinite else { return }
+
+        var values = clearValues
+        let lower = index == 0 ? 0 : values[index - 1] + 0.001
+        let upper = values[index + 1] - 0.001
+        guard upper >= lower else { return }
+        let next = min(max(value, lower), upper)
+        guard next != values[index] else { return }
+        values[index] = next
+        representation = .controlPoints(values)
+    }
+
+    private func invertQuadratic(
+        y: Double,
+        intercept: Double,
+        linear: Double,
+        quadratic: Double
+    ) -> Double {
+        let delta = y - intercept
+        if abs(delta) <= 1e-14 { return 0 }
+
+        // Degenerate quadratics are linear. The guard also keeps the inverse
+        // defined for a valid curve whose endpoint slope is zero elsewhere.
+        if abs(quadratic) <= 1e-14 {
+            guard abs(linear) > 1e-14 else { return 0 }
+            return bounded(delta / linear, in: 0...1)
+        }
+
+        let discriminant = max(0, linear * linear + 4 * quadratic * delta)
+        let squareRoot = sqrt(discriminant)
+
+        // Evaluate both mathematically valid roots and select the one in the
+        // normalized interval. This remains stable when the discriminant is
+        // zero and when one endpoint has a zero derivative.
+        let denominator = 2 * quadratic
+        var candidates: [Double] = []
+        let signedRoot = linear >= 0 ? squareRoot : -squareRoot
+        let stableTerm = -0.5 * (linear + signedRoot)
+        let stableRoot = abs(stableTerm) > 1e-14 ? -delta / stableTerm : .nan
+        let otherRoot = (-linear - signedRoot) / denominator
+        for candidate in [stableRoot, otherRoot] where candidate.isFinite && candidate >= -1e-10 && candidate <= 1 + 1e-10 {
+            candidates.append(bounded(candidate, in: 0...1))
+        }
+
+        if let candidate = candidates.min(by: { lhs, rhs in
+            let leftError = abs(intercept + linear * lhs + quadratic * lhs * lhs - y)
+            let rightError = abs(intercept + linear * rhs + quadratic * rhs * rhs - y)
+            return leftError < rightError
+        }) {
+            return candidate
+        }
+
+        // A validated curve should always produce a candidate. Keep a finite,
+        // clamped result if roundoff at an endpoint defeats the interval test.
+        return bounded(stableRoot.isFinite ? stableRoot : otherRoot, in: 0...1)
+    }
+
+    private func bounded(_ value: Double, in range: ClosedRange<Double>) -> Double {
+        guard value.isFinite else { return range.lowerBound }
+        return min(max(value, range.lowerBound), range.upperBound)
+    }
+}
