@@ -0,0 +1,101 @@
+import Foundation
+import SettingsUI
+
+/// Optional material and editor controls stored alongside a style backdrop.
+///
+/// Glows remain on ``SettingsStyleBackdrop.glows`` and grain remains on
+/// ``SettingsStyleBackdrop.finish`` so existing presets keep one authoritative
+/// copy of those visual values. This payload only records the controls that
+/// have no representation in the original style-preset schema.
+public struct SettingsStyleBackdropEffects: Codable, Equatable, Sendable {
+    public var enabled: Bool
+    public var material: SettingsBackdropMaterial
+    public var materialOpacity: Double
+    public var glassTintOpacity: Double
+    public var glassStyle: SettingsBackdropGlassStyle
+    public var frostedStyle: SettingsBackdropFrostedStyle
+    public var frostedTintStrength: Double
+    public var tintStrength: Double
+    public var grainScale: Double
+    public var matchColorAdjustments: Bool
+    public var colorHarmony: SettingsColorHarmony
+
+    public init(
+        enabled: Bool = true,
+        material: SettingsBackdropMaterial = .liquidGlass,
+        materialOpacity: Double = 0.95,
+        glassTintOpacity: Double = 0.70,
+        glassStyle: SettingsBackdropGlassStyle = .regular,
+        frostedStyle: SettingsBackdropFrostedStyle = .automatic,
+        frostedTintStrength: Double = 1,
+        tintStrength: Double = 0.4,
+        grainScale: Double = 0.5,
+        matchColorAdjustments: Bool = true,
+        colorHarmony: SettingsColorHarmony = .custom
+    ) {
+        self.enabled = enabled
+        self.material = material
+        self.materialOpacity = Self.bounded(materialOpacity, in: 0...1)
+        self.glassTintOpacity = Self.bounded(glassTintOpacity, in: 0...1)
+        self.glassStyle = glassStyle
+        self.frostedStyle = frostedStyle
+        self.frostedTintStrength = Self.bounded(frostedTintStrength, in: 0...2)
+        self.tintStrength = Self.bounded(tintStrength, in: 0...1)
+        self.grainScale = Self.bounded(grainScale, in: 0.5...2)
+        self.matchColorAdjustments = matchColorAdjustments
+        self.colorHarmony = colorHarmony
+    }
+
+    public func normalized() -> Self {
+        Self(
+            enabled: enabled,
+            material: material,
+            materialOpacity: materialOpacity,
+            glassTintOpacity: glassTintOpacity,
+            glassStyle: glassStyle,
+            frostedStyle: frostedStyle,
+            frostedTintStrength: frostedTintStrength,
+            tintStrength: tintStrength,
+            grainScale: grainScale,
+            matchColorAdjustments: matchColorAdjustments,
+            colorHarmony: colorHarmony
+        )
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case enabled
+        case material
+        case materialOpacity
+        case glassTintOpacity
+        case glassStyle
+        case frostedStyle
+        case frostedTintStrength
+        case tintStrength
+        case grainScale
+        case matchColorAdjustments
+        case colorHarmony
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        // Preserve decoded numbers for SettingsStylePreset.validate(). The
+        // typed initializer normalizes host-created values, while preset JSON
+        // must report malformed stored values instead of hiding them by
+        // clamping during decoding.
+        self.enabled = try container.decodeIfPresent(Bool.self, forKey: .enabled) ?? true
+        self.material = try container.decodeIfPresent(SettingsBackdropMaterial.self, forKey: .material) ?? .liquidGlass
+        self.materialOpacity = try container.decodeIfPresent(Double.self, forKey: .materialOpacity) ?? 0.95
+        self.glassTintOpacity = try container.decodeIfPresent(Double.self, forKey: .glassTintOpacity) ?? 0.70
+        self.glassStyle = try container.decodeIfPresent(SettingsBackdropGlassStyle.self, forKey: .glassStyle) ?? .regular
+        self.frostedStyle = try container.decodeIfPresent(SettingsBackdropFrostedStyle.self, forKey: .frostedStyle) ?? .automatic
+        self.frostedTintStrength = try container.decodeIfPresent(Double.self, forKey: .frostedTintStrength) ?? 1
+        self.tintStrength = try container.decodeIfPresent(Double.self, forKey: .tintStrength) ?? 0.4
+        self.grainScale = try container.decodeIfPresent(Double.self, forKey: .grainScale) ?? 0.5
+        self.matchColorAdjustments = try container.decodeIfPresent(Bool.self, forKey: .matchColorAdjustments) ?? true
+        self.colorHarmony = try container.decodeIfPresent(SettingsColorHarmony.self, forKey: .colorHarmony) ?? .custom
+    }
+
+    private static func bounded(_ value: Double, in range: ClosedRange<Double>) -> Double {
+        value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : range.lowerBound
+    }
+}
