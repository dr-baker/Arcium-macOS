+import SwiftUI
+
+struct SettingsCardScrollViewport: Equatable {
+    let coordinateSpace: UUID
+    let topInset: CGFloat
+}
+
+extension EnvironmentValues {
+    @Entry var settingsCardScrollViewport: SettingsCardScrollViewport?
+}
+
+extension View {
+    /// Enables card-scoped sticky editing headers in this scroll view.
+    /// Apply to the owning vertical ScrollView, not its content. `topInset`
+    /// reserves space for chrome that overlaps the scroll viewport. The header's
+    /// background pins to that edge, with its normal card padding inside it.
+    /// This does not add scrolling, move editors, or own application state.
+    public func settingsCardScrollViewport(topInset: CGFloat = 0) -> some View {
+        modifier(SettingsCardScrollViewportModifier(topInset: topInset))
+    }
+}
+
+private struct SettingsCardScrollViewportModifier: ViewModifier {
+    let topInset: CGFloat
+    @State private var coordinateSpace = UUID()
+
+    func body(content: Content) -> some View {
+        content
+            .coordinateSpace(name: coordinateSpace)
+            .environment(\.settingsCardScrollViewport, SettingsCardScrollViewport(
+                coordinateSpace: coordinateSpace, topInset: max(0, topInset)))
+    }
+}
+
+struct SettingsCardFrameReader: ViewModifier {
+    @Binding var frame: CGRect
+    @Environment(\.settingsCardScrollViewport) private var viewport
+
+    func body(content: Content) -> some View {
+        let coordinateSpace = viewport?.coordinateSpace
+        return content.onGeometryChange(for: CGRect.self) {
+            $0.frame(in: coordinateSpace.map { .named($0) } ?? .local)
+        } action: { frame = $0 }
+    }
+}
+
+/// Shared positioning for card headers. Keep the same header and editor in
+/// their original layout slots while their rendered positions follow scroll.
+struct SettingsStickyCardHeader<Content: View>: View {
+    let cardFrame: CGRect
+    let isActive: Bool
+    let padding: CGFloat
+    @ViewBuilder let content: () -> Content
+    @State private var height: CGFloat = 0
+    @Environment(\.settingsCardScrollViewport) private var viewport
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+
+    private var offset: CGFloat {
+        guard isActive, let viewport else { return 0 }
+        return SettingsStickyCardGeometry.offset(card: cardFrame, headerHeight: height,
+                                                padding: padding, topInset: viewport.topInset)
+    }
+
+    var body: some View {
+        content()
+            .onGeometryChange(for: CGFloat.self) { $0.size.height } action: { height = $0 }
+            .background {
+                if offset > 0 {
+                    // Use the card's material and tint, without adding another
+                    // rounded panel, border, or shadow. Keep the material present
+                    // even for transparent cards so scrolled text stays obscured.
+                    // The divider is its cutoff.
+                    ZStack {
+                        Rectangle().fill(reduceTransparency
+                            ? AnyShapeStyle(theme.windowCanvas) : AnyShapeStyle(.thinMaterial))
+                        theme.card.opacity(reduceTransparency ? 1 : theme.cardTintOpacity)
+                    }
+                    .padding(.horizontal, -padding)
+                    .padding(.top, -padding)
+                }
+            }
+            .offset(y: offset)
+            .animation(nil, value: offset)
+    }
+}
+
+/// The header's original layout slot remains in the card. Only its rendering
+/// moves, bounded by the card's padded bottom, so it leaves with that card.
+nonisolated enum SettingsStickyCardGeometry {
+    static func offset(card: CGRect, headerHeight: CGFloat, padding: CGFloat, topInset: CGFloat) -> CGFloat {
+        guard card.minY.isFinite, card.height.isFinite, headerHeight.isFinite,
+              padding.isFinite, topInset.isFinite, headerHeight > 0 else { return 0 }
+        let available = max(0, card.height - 2 * padding - headerHeight)
+        return min(max(0, topInset - card.minY), available)
+    }
+}
