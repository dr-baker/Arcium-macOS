+import Foundation
+import SettingsUI
+
+public struct SettingsStyleAppearance: Codable, Equatable, Sendable {
+    public var scrollFade: SettingsScrollFade
+    public var edgeShadow: SettingsEdgeShadow
+    public var surface: SettingsStyleSurface
+    public var backdrop: SettingsStyleBackdrop
+    public var motion: SettingsStyleMotion
+    public var glass: SettingsGlassConfiguration
+
+    public init(
+        surface: SettingsStyleSurface = SettingsStyleSurface(),
+        scrollFade: SettingsScrollFade = .init(),
+        edgeShadow: SettingsEdgeShadow = .init(),
+        backdrop: SettingsStyleBackdrop = SettingsStyleBackdrop(),
+        motion: SettingsStyleMotion = SettingsStyleMotion(),
+        glass: SettingsGlassConfiguration = SettingsGlassConfiguration()
+    ) {
+        self.surface = surface
+        self.scrollFade = scrollFade
+        self.edgeShadow = edgeShadow
+        self.backdrop = backdrop
+        self.motion = motion
+        self.glass = glass
+    }
+
+    private enum CodingKeys: String, CodingKey { case surface, scrollFade, edgeShadow, backdrop, motion, glass }
+
+    public init(from decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.init(
+            surface: try container.decode(SettingsStyleSurface.self, forKey: .surface),
+            scrollFade: try container.decodeIfPresent(SettingsScrollFade.self, forKey: .scrollFade) ?? .init(),
+            edgeShadow: try container.decodeIfPresent(SettingsEdgeShadow.self, forKey: .edgeShadow) ?? .init(),
+            backdrop: try container.decode(SettingsStyleBackdrop.self, forKey: .backdrop),
+            motion: try container.decode(SettingsStyleMotion.self, forKey: .motion),
+            glass: try container.decodeIfPresent(SettingsGlassConfiguration.self, forKey: .glass) ?? .init()
+        )
+    }
+
+    public func theme(brand: SettingsStyleBrand) -> SettingsTheme {
+        var brand = brand
+        brand.palette = brand.palette.resolvingColors(from: backdrop.glows)
+        if brand.colorSource == .source, brand.palette.controlColorID != nil {
+            brand.sourceAccent = brand.palette.controlAccent.customColor
+        }
+        if brand.colorSource == .brand {
+            return brand.palette.theme(
+                borderWidth: surface.showsBorders ? 0.5 : 0,
+                cardOpacity: surface.cardOpacity,
+                panelOpacity: surface.contentPanelOpacity
+            )
+        } else {
+            return SettingsTheme(
+                accent: brand.sourceAccent?.color ?? SettingsTheme.standard.accent,
+                borderWidth: surface.showsBorders ? 0.5 : 0,
+                increasedContrastBorderWidth: surface.showsBorders ? 1 : 0,
+                cardOpacity: surface.cardOpacity
+            )
+        }
+    }
+}
