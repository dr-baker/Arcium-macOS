+    public func validate() throws { try validate(named: "Glass") }
+
+    func validate(named name: String) throws {
+        guard (0...19).contains(customVariant) else {
+            throw SettingsStylePresetError.invalidValue("\(name) custom variant must be between 0 and 19.")
+        }
+        if let tint {
+            try SettingsGlassValue.require(tint.red, in: 0...1, named: "\(name) tint red")
+            try SettingsGlassValue.require(tint.green, in: 0...1, named: "\(name) tint green")
+            try SettingsGlassValue.require(tint.blue, in: 0...1, named: "\(name) tint blue")
+        }
+        try SettingsGlassValue.require(tintOpacity, in: 0...1, named: "\(name) tint opacity")
+        try SettingsGlassValue.require(opacity, in: 0...1, named: "\(name) opacity")
+        try SettingsGlassValue.require(cornerRadius, in: 0...200, named: "\(name) corner radius")
+        try SettingsGlassValue.require(fallbackOutlineOpacity, in: 0...1, named: "\(name) fallback outline opacity")
+        try effects.validate(named: "\(name) effects")
+        try reflections.validate()
+        try shadow.validate(named: "\(name) shadow")
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case mode, finish, activity, customVariant, usesCustomVariant, tint, tintOpacity, opacity, cornerRadius
+        case systemInteractive, fallbackMaterial, fallbackBlending, fallbackOutlineOpacity, effects, reflections, shadow
+    }
+
+    public init(from decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.init(
+            mode: try container.decode(SettingsGlassMode.self, forKey: .mode),
+            finish: try container.decode(SettingsGlassFinish.self, forKey: .finish),
+            activity: try container.decode(SettingsGlassActivity.self, forKey: .activity),
+            customVariant: try container.decode(Int.self, forKey: .customVariant),
+            usesCustomVariant: try container.decode(Bool.self, forKey: .usesCustomVariant),
+            tint: try container.decodeIfPresent(SettingsRGB.self, forKey: .tint),
+            tintOpacity: try container.decode(Double.self, forKey: .tintOpacity),
+            opacity: try container.decode(Double.self, forKey: .opacity),
+            cornerRadius: try container.decode(Double.self, forKey: .cornerRadius),
+            systemInteractive: try container.decode(Bool.self, forKey: .systemInteractive),
+            fallbackMaterial: try container.decode(SettingsGlassMaterial.self, forKey: .fallbackMaterial),
+            fallbackBlending: try container.decode(SettingsGlassBlending.self, forKey: .fallbackBlending),
+            fallbackOutlineOpacity: try container.decode(Double.self, forKey: .fallbackOutlineOpacity),
+            effects: try container.decode(SettingsGlassEffects.self, forKey: .effects),
+            reflections: try container.decode(SettingsGlassReflectionConfiguration.self, forKey: .reflections),
+            shadow: try container.decode(SettingsGlassShadow.self, forKey: .shadow)
+        )
+        try validate()
+    }
+
+    public func encode(to encoder: any Encoder) throws {
+        try validate()
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(mode, forKey: .mode)
+        try container.encode(finish, forKey: .finish)
+        try container.encode(activity, forKey: .activity)
+        try container.encode(customVariant, forKey: .customVariant)
+        try container.encode(usesCustomVariant, forKey: .usesCustomVariant)
+        try container.encodeIfPresent(tint, forKey: .tint)
+        try container.encode(tintOpacity, forKey: .tintOpacity)
+        try container.encode(opacity, forKey: .opacity)
+        try container.encode(cornerRadius, forKey: .cornerRadius)
+        try container.encode(systemInteractive, forKey: .systemInteractive)
+        try container.encode(fallbackMaterial, forKey: .fallbackMaterial)
+        try container.encode(fallbackBlending, forKey: .fallbackBlending)
+        try container.encode(fallbackOutlineOpacity, forKey: .fallbackOutlineOpacity)
+        try container.encode(effects, forKey: .effects)
+        try container.encode(reflections, forKey: .reflections)
+        try container.encode(shadow, forKey: .shadow)
+    }
+}
