+import AppKit
+import SwiftUI
+
+/// Place once at the back of a window's root ZStack. Owns the window's clear
+/// canvas while mounted, restoring its original canvas when detached.
+public struct SettingsWindowChrome: View {
+    private let managesAppearance: Bool
+    private let appearance: NSAppearance.Name?
+    private let glassEnabled: Bool
+    private let tintOpacity: Double
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+
+    /// Set the window's appearance separately with
+    /// ``SwiftUI/View/settingsWindowAppearance(_:)``.
+    public init(glassEnabled: Bool = true, tintOpacity: Double = 0.2) {
+        managesAppearance = false
+        appearance = nil
+        self.glassEnabled = glassEnabled
+        self.tintOpacity = tintOpacity.isFinite ? min(max(tintOpacity, 0), 1) : 0.2
+    }
+
+    @available(*, deprecated, message: "Use init(glassEnabled:tintOpacity:) with .settingsWindowAppearance(_:) on the window root.")
+    public init(glassEnabled: Bool = true, tintOpacity: Double = 0.2, colorScheme: ColorScheme?) {
+        managesAppearance = true
+        appearance = colorScheme.map { $0 == .dark ? .darkAqua : .aqua }
+        self.glassEnabled = glassEnabled
+        self.tintOpacity = tintOpacity.isFinite ? min(max(tintOpacity, 0), 1) : 0.2
+    }
+
+    public var body: some View {
+        let usesGlass = glassEnabled && !reduceTransparency
+        // Compose value views directly. SwiftUI can evaluate this decoration
+        // on its background accessibility/render queue after focus changes.
+        theme.background.opacity(usesGlass ? tintOpacity : 1)
+            .background(WindowChromeMaterial(enabled: usesGlass, managesAppearance: managesAppearance, appearance: appearance))
+            .allowsHitTesting(false)
+            .accessibilityHidden(true)
+    }
+}
+
+private struct WindowChromeMaterial: NSViewRepresentable {
+    let enabled: Bool
+    let managesAppearance: Bool
+    let appearance: NSAppearance.Name?
+
+    func makeNSView(context: Context) -> WindowChromeMaterialView {
+        WindowChromeMaterialView()
+    }
+
+    func updateNSView(_ view: WindowChromeMaterialView, context: Context) {
+        view.managesAppearance = managesAppearance
+        view.requestedAppearance = appearance
+        view.applyAppearance()
+        view.material = .underWindowBackground
+        view.blendingMode = .behindWindow
+        view.state = .followsWindowActiveState
+        view.isEmphasized = false
+        view.alphaValue = enabled ? 1 : 0
+    }
+
+    static func dismantleNSView(_ view: WindowChromeMaterialView, coordinator: ()) {
+        view.restoreWindow()
+    }
+}
+
+private final class WindowChromeMaterialView: NSVisualEffectView {
+    private weak var configuredWindow: NSWindow?
+    private var originalBackground: NSColor?
+    private var originalOpaque = true
+    private var originalAppearance: NSAppearance?
+    var managesAppearance = false
+    var requestedAppearance: NSAppearance.Name?
+
+    func applyAppearance() {
+        guard managesAppearance, let window, window.appearance?.name != requestedAppearance else { return }
+        window.appearance = requestedAppearance.flatMap(NSAppearance.init(named:))
+    }
+
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        guard window !== configuredWindow else { return }
+        restoreWindow()
+        guard let window else { return }
+        configuredWindow = window
+        originalBackground = window.backgroundColor
+        originalOpaque = window.isOpaque
+        originalAppearance = window.appearance
+        window.isOpaque = false
+        window.backgroundColor = .clear
+        applyAppearance()
+    }
+
