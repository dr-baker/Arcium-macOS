+import SwiftUI
+
+public struct SInventoryRow<Label: View>: View {
+    public let isSelected: Bool
+    public let selectionNamespace: Namespace.ID
+    public let action: () -> Void
+    private let label: Label
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+    @Environment(\.isEnabled) private var isEnabled
+    @Environment(\.settingsFontScale) private var fontScale
+    @State private var isHovered = false
+
+    public init(
+        isSelected: Bool,
+        selectionNamespace: Namespace.ID,
+        action: @escaping () -> Void,
+        @ViewBuilder label: () -> Label
+    ) {
+        self.isSelected = isSelected
+        self.selectionNamespace = selectionNamespace
+        self.action = action
+        self.label = label()
+    }
+
+    public var body: some View {
+        Button(action: action) {
+            label
+                .labelStyle(SettingsIconLabelStyle())
+                .settingsFont(\.sidebar)
+                .frame(maxWidth: .infinity, alignment: .leading)
+                .padding(.horizontal, SettingsSpacing.xs)
+                .padding(.vertical, SettingsSizing.inventoryRowVerticalPadding * SettingsTypography.clampedScale(fontScale))
+                .contentShape(.rect(cornerRadius: theme.radius(SettingsRadius.row)))
+        }
+        .buttonStyle(.plain)
+        .opacity(isEnabled ? 1 : SettingsEffects.disabledOpacity)
+        .background {
+            let active = isEnabled && isHovered && !isSelected
+            Group {
+                if active {
+                    let shape = RoundedRectangle(cornerRadius: theme.radius(SettingsRadius.row), style: .continuous)
+                    ZStack {
+                        shape.fill(reduceTransparency ? AnyShapeStyle(theme.windowCanvas) : AnyShapeStyle(.ultraThinMaterial))
+                        shape.fill(theme.hoverFill)
+                    }
+                    .overlay { shape.stroke(theme.controlHoverBorder, lineWidth: theme.borderWidth) }
+                    .transition(.opacity)
+                }
+            }
+            .animation(reduceMotion ? nil : SettingsMotion.hover, value: active)
+        }
+        .background {
+            Group {
+                if isSelected {
+                    RoundedRectangle(cornerRadius: theme.radius(SettingsRadius.row), style: .continuous)
+                        .fill(theme.selectionStrong.opacity(0.16))
+                        .overlay {
+                            RoundedRectangle(cornerRadius: theme.radius(SettingsRadius.row), style: .continuous)
+                                .stroke(theme.controlSelectionBorder, lineWidth: theme.borderWidth)
+                        }
+                        .matchedGeometryEffect(id: "inventory-selection", in: selectionNamespace)
+                }
+            }
+            .animation(reduceMotion ? nil : SettingsMotion.selectionTravel, value: isSelected)
+        }
+        .accessibilityAddTraits(isSelected ? .isSelected : [])
+        .onHover { isHovered = isEnabled && $0 }
+    }
+}
