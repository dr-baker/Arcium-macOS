+
+public extension View {
+    /// Installs a decorative window background and carries it into settings sheets.
+    /// Theme, appearance, and font scale continue to come from the environment.
+    func settingsWindowBackground(
+        contentPanelOpacity: Double = 1,
+        @ViewBuilder _ background: () -> some View
+    ) -> some View {
+        let background = AnyView(background())
+        return self
+            .background { background.ignoresSafeArea().allowsHitTesting(false).accessibilityHidden(true) }
+            .environment(\.settingsSheetBackground, background)
+            .environment(\.settingsSheetPanelOpacity,
+                contentPanelOpacity.isFinite ? min(max(contentPanelOpacity, 0), 1) : 1)
+    }
+
+    /// Uses the window's background around one inset content surface.
+    /// `SSettingsSheet` applies this automatically. Use it for custom sheets too.
+    func settingsSheetSurface() -> some View {
+        modifier(SettingsSheetSurface())
+    }
+}
+
+private struct SettingsSheetSurface: ViewModifier {
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.settingsSheetBackground) private var background
+    @Environment(\.settingsSheetPanelOpacity) private var panelOpacity
+    @Environment(\.colorSchemeContrast) private var contrast
+
+    func body(content: Content) -> some View {
+        content
+            .foregroundStyle(theme.textPrimary)
+            .tint(theme.accent)
+            .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+            .background {
+                RoundedRectangle(cornerRadius: theme.radius(20))
+                    .fill(theme.panel)
+                    .overlay {
+                        if theme.borderWidth > 0 || contrast == .increased {
+                            RoundedRectangle(cornerRadius: theme.radius(20))
+                                .strokeBorder(theme.panelSurfaceBorder,
+                                    lineWidth: contrast == .increased ? max(1, theme.increasedContrastBorderWidth) : theme.borderWidth)
+                                .allowsHitTesting(false)
+                        }
+                    }
+                    .opacity(panelOpacity)
+            }
+            .clipShape(.rect(cornerRadius: theme.radius(20)))
+            .padding(8)
+            .background {
+                if let background {
+                    background.ignoresSafeArea().allowsHitTesting(false).accessibilityHidden(true)
+                } else {
+                    SettingsWindowChrome().ignoresSafeArea()
+                }
+            }
+            .presentationBackground(.clear)
+    }
+}
