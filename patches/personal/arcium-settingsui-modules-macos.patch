+import SwiftUI
+
+/// Places views in rows, wrapping whole views to the next row when the
+/// proposed width runs out. Use for chips, pills, and groups of buttons.
+public struct SFlowLayout: Layout {
+    public enum Alignment: Sendable { case leading, trailing }
+
+    public let spacing: CGFloat
+    public let lineSpacing: CGFloat
+    public let alignment: Alignment
+
+    public init(spacing: CGFloat = 8, lineSpacing: CGFloat = 6, alignment: Alignment = .leading) {
+        self.spacing = spacing
+        self.lineSpacing = lineSpacing
+        self.alignment = alignment
+    }
+
+    public func sizeThatFits(proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) -> CGSize {
+        let sizes = subviews.map { $0.sizeThatFits(.unspecified) }
+        let ideal = sizes.map(\.width).reduce(0, +) + spacing * CGFloat(max(0, sizes.count - 1))
+        let width = min(proposal.width ?? ideal, ideal)
+        let rows = rows(for: sizes, width: width)
+        let height = rows.map(\.height).reduce(0, +) + lineSpacing * CGFloat(max(0, rows.count - 1))
+        return CGSize(width: rows.map(\.width).max() ?? 0, height: height)
+    }
+
+    public func placeSubviews(in bounds: CGRect, proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) {
+        let sizes = subviews.map { $0.sizeThatFits(.unspecified) }
+        var y = bounds.minY
+        for row in rows(for: sizes, width: bounds.width) {
+            var x = alignment == .trailing ? bounds.maxX - row.width : bounds.minX
+            for index in row.indices {
+                subviews[index].place(at: CGPoint(x: x, y: y + row.height / 2), anchor: .leading, proposal: ProposedViewSize(sizes[index]))
+                x += sizes[index].width + spacing
+            }
+            y += row.height + lineSpacing
+        }
+    }
+
+    private func rows(for sizes: [CGSize], width: CGFloat) -> [Row] {
+        var rows: [Row] = []
+        var row = Row()
+        for (index, size) in sizes.enumerated() {
+            if !row.indices.isEmpty, row.width + spacing + size.width > width {
+                rows.append(row)
+                row = Row()
+            }
+            row.width += (row.indices.isEmpty ? 0 : spacing) + size.width
+            row.height = max(row.height, size.height)
+            row.indices.append(index)
+        }
+        if !row.indices.isEmpty { rows.append(row) }
+        return rows
+    }
+
+    private struct Row {
+        var indices: [Int] = []
+        var width: CGFloat = 0
+        var height: CGFloat = 0
+    }
+}
