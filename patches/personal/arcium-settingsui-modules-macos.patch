-    /// Applies the selected color's hue to a palette while preserving order,
-    /// count, and each harmony mode's offset from index zero.
-    public static func applyingHarmony(
-        to colors: [String],
-        selectedIndex: Int,
-        mode: SettingsColorHarmony,
-        fallbackHue: Double = 0
-    ) -> [String] {
-        guard let index = activeIndex(selectedIndex, count: colors.count),
-              let rgb = SettingsRGB(hex: colors[index]),
-              mode != .custom else { return colors }
-        let selected = rgb.oklch
-        let offsets = mode.offsets(for: colors.count)
-        let selectedHue = selected.chroma < 0.00001 ? fallbackHue * 360 : selected.hue
-        let baseHue = selectedHue - offsets[index] * 360
-        return colors.indices.map { i in
-            if i == index { return rgb.hex }
-            return SettingsOKLCH(
-                lightness: selected.lightness, chroma: selected.chroma,
-                hue: baseHue + offsets[i] * 360
-            ).rgb.hex
-        }
-
-    }
