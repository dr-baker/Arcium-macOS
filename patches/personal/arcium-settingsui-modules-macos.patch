+private struct SettingsMaterialBackdropModifier: ViewModifier {
+    let tint: Color?
+    let tintOpacity: CGFloat?
+    let cornerRadius: CGFloat?
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+
+    func body(content: Content) -> some View {
+        let resolvedTint = tint ?? theme.windowFrameBackground
+        let resolvedOpacity = tintOpacity ?? theme.windowFrameTintOpacity
+        content.background {
+            if let cornerRadius {
+                let shape = RoundedRectangle(cornerRadius: theme.radius(cornerRadius), style: .continuous)
+                ZStack {
+                    shape.fill(reduceTransparency ? AnyShapeStyle(theme.windowCanvas) : AnyShapeStyle(.ultraThinMaterial))
+                    shape.fill(resolvedTint.opacity(reduceTransparency ? 1 : resolvedOpacity))
+                }
+            } else {
+                ZStack {
+                    Rectangle().fill(reduceTransparency ? AnyShapeStyle(theme.windowCanvas) : AnyShapeStyle(.ultraThinMaterial))
+                    Rectangle().fill(resolvedTint.opacity(reduceTransparency ? 1 : resolvedOpacity))
+                }
+            }
+        }
+    }
+}
+
+enum SettingsPixelGrid {
+    static func aligned(_ value: CGFloat, scale: CGFloat) -> CGFloat {
+        guard value.isFinite, value > 0 else { return 0 }
+        let scale = scale.isFinite && scale > 0 ? scale : 1
+        return max(1, (value * scale).rounded()) / scale
+    }
+}
+
+private struct SettingsRoundedSurfaceModifier: ViewModifier {
+    var surfaceOpacity: CGFloat = 1
+    var borderWidth: CGFloat? = nil
+    let material: Material
+    let fill: Color
+    let fillOpacity: CGFloat
+    let border: Color?
+    let shadowColor: Color
+    let shadowRadius: CGFloat
+    let shadowYOffset: CGFloat
+    let cornerRadius: CGFloat
+    @Environment(\.displayScale) private var displayScale
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+    @Environment(\.colorSchemeContrast) private var contrast
+
+    func body(content: Content) -> some View {
+        let shape = RoundedRectangle(cornerRadius: SettingsPixelGrid.aligned(theme.radius(cornerRadius), scale: displayScale), style: .continuous)
+        content
+            .background {
+                ZStack {
+                    shape.fill(reduceTransparency ? AnyShapeStyle(theme.windowCanvas) : AnyShapeStyle(material))
+                    shape.fill(reduceTransparency ? fill : fill.opacity(fillOpacity))
+                }
+                .clipShape(shape)
+                .overlay {
+                    if let border {
+                        shape.strokeBorder(border,
+                            lineWidth: SettingsPixelGrid.aligned(max(borderWidth ?? 0, contrast == .increased
+                                ? theme.increasedContrastBorderWidth : theme.borderWidth), scale: displayScale))
+                    }
+                }
+                .shadow(color: shadowColor, radius: shadowRadius, y: shadowYOffset)
+                .opacity(reduceTransparency ? 1 : surfaceOpacity)
+            }
+    }
+}
