+                ),
+                mode: harmonyBinding,
+                onAddColor: addGlow,
+                onRemoveColor: { if draft.glows.count > 1 { removeSelectedGlow() } }
+            )
+            .id(draft.glows.map(\.id))
+            .disabled(!isDecorativeEditingEnabled)
+        }
+    }
+
+    private func colorPickerPresentation(for anchor: ColorPickerAnchor) -> Binding<Bool> {
+        Binding(
+            get: { colorPickerPresented && colorPickerAnchor == anchor },
+            set: { presented in
+                guard colorPickerAnchor == anchor else { return }
+                colorPickerPresented = presented
+            }
+        )
+    }
+
+    private func openColorPicker(_ id: String, anchor: ColorPickerAnchor = .swatches) {
+        guard isDecorativeEditingEnabled, draft.glows.contains(where: { $0.id == id }) else { return }
+        selectedGlowID = id
+        colorPickerAnchor = anchor
+        colorPickerPresented = true
+    }
+
+    private func resetAppearance() {
+        if let onReset {
+            onReset()
+        } else {
+            configuration = SettingsBackdropConfiguration()
+        }
+    }
+
+    private var isCustomEditingEnabled: Bool { editable && (colorsOnly || draft.enabled) }
+    private var isDecorativeEditingEnabled: Bool {
+        Self.allowsColorEditing(editable: editable, colorsOnly: colorsOnly,
+                                enabled: draft.enabled, effectsAvailable: effectsAvailable)
+    }
+
+    internal static func allowsColorEditing(
+        editable: Bool, colorsOnly: Bool, enabled: Bool, effectsAvailable: Bool
+    ) -> Bool {
+        editable && (colorsOnly || (enabled && effectsAvailable))
+    }
+    private var isSurfaceEditingEnabled: Bool { isCustomEditingEnabled && effectsAvailable }
+    private var resolvedActiveMaterial: SettingsBackdropMaterial {
+        let material = activeMaterial ?? draft.material
+        return material == .auto ? .liquidGlass : material
+    }
+    private var isLiquidGlassEditingEnabled: Bool { isSurfaceEditingEnabled && resolvedActiveMaterial == .liquidGlass }
+    private var isFrostedEditingEnabled: Bool { isSurfaceEditingEnabled && resolvedActiveMaterial == .frosted }
+    private var grainRange: ClosedRange<Double> { 0...max(maxObservedGrain, draft.grain) }
+
+    private var glowAdjustmentLockLabel: String {
+        if showsIntensity {
+            return draft.matchColorAdjustments
+                ? "Unlock per-glow size and intensity"
+                : "Lock all glow size and intensity"
+        }
+        return draft.matchColorAdjustments
+            ? "Unlock per-glow size"
+            : "Lock all glow size"
+    }
+
+    private var glowAdjustmentLockHelp: String {
+        if showsIntensity {
+            return draft.matchColorAdjustments
+                ? "Unlock per-glow size and intensity."
+                : "Lock all glow size and intensity to the selected glow."
+        }
+        return draft.matchColorAdjustments
+            ? "Unlock per-glow size."
+            : "Lock all glow size to the selected glow."
+    }
+
+    private var isForcedFallback: Bool {
+        guard draft.enabled else { return false }
+        if draft.material != .auto, let activeMaterial, activeMaterial != draft.material { return true }
+        return hasFallbackReason
+    }
+
+    private var normalizedFallbackReason: String {
+        fallbackReason?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+    }
+
+    private var hasFallbackReason: Bool {
+        let reason = normalizedFallbackReason.lowercased()
+        return !reason.isEmpty && reason != "none" && reason != "disabled"
+    }
+
+    private var fallbackStatus: String? {
+        guard draft.enabled else { return nil }
+        let active = activeMaterial
+        let reason = userFacingFallbackReason
+        if let active, let reason { return "Using \(active.title). \(reason)" }
+        if draft.material != .auto, let active, active != draft.material {
+            return "Using \(active.title). The selected material is unavailable."
+        }
+        if let reason { return reason }
+        if let active { return "Using \(active.title)." }
+        return nil
+    }
+
+    private var userFacingFallbackReason: String? {
+        guard hasFallbackReason else { return nil }
+        return normalizedFallbackReason
+    }
+
+    private var selectedGlow: SettingsStyleGlow? {
+        guard let selectedGlowID else { return nil }
+        return draft.glows.first { $0.id == selectedGlowID }
+    }
+
+    private var enabledBinding: Binding<Bool> {
+        Binding(get: { draft.enabled }, set: { value in
+            guard editable else { return }
+            updateDraft { $0.enabled = value }
+        })
+    }
+
+    private var materialBinding: Binding<SettingsBackdropMaterial> {
+        Binding(get: { draft.material }, set: { value in
+            guard isCustomEditingEnabled else { return }
+            updateDraft { $0.material = value }
+        })
+    }
+
+    private var materialOpacityBinding: Binding<Double> {
+        Binding(get: { draft.materialOpacity }, set: { value in
+            guard isSurfaceEditingEnabled else { cancelSliderPreview(); return }
+            commitSlider { $0.materialOpacity = value }
+        })
+    }
+
+    private var tintBinding: Binding<Double> {
+        Binding(get: { draft.tintStrength }, set: { value in
+            guard isDecorativeEditingEnabled else { cancelSliderPreview(); return }
+            commitSlider { $0.tintStrength = value }
+        })
+    }
+
+    private var glassTintOpacityBinding: Binding<Double> {
+        Binding(get: { draft.glassTintOpacity }, set: { value in
+            guard isLiquidGlassEditingEnabled else { cancelSliderPreview(); return }
+            commitSlider { $0.glassTintOpacity = value }
+        })
+    }
+
+    private var glassStyleBinding: Binding<SettingsBackdropGlassStyle> {
+        Binding(get: { draft.glassStyle }, set: { value in
+            guard isLiquidGlassEditingEnabled else { return }
+            updateDraft { $0.glassStyle = value }
+        })
+    }
+
+    private var frostedStyleBinding: Binding<SettingsBackdropFrostedStyle> {
+        Binding(get: { draft.frostedStyle }, set: { value in
+            guard isFrostedEditingEnabled else { return }
+            updateDraft { $0.frostedStyle = value }
+        })
+    }
+
+    private var frostedTintStrengthBinding: Binding<Double> {
+        Binding(get: { draft.frostedTintStrength }, set: { value in
+            guard isFrostedEditingEnabled else { cancelSliderPreview(); return }
+            commitSlider { $0.frostedTintStrength = value }
+        })
+    }
+
+    private var grainBinding: Binding<Double> {
+        Binding(get: { draft.grain }, set: { value in
+            guard isDecorativeEditingEnabled else { cancelSliderPreview(); return }
+            commitSlider { $0.grain = value }
+        })
+    }
+
+    private var grainScaleBinding: Binding<Double> {
+        Binding(get: { draft.grainScale }, set: { value in
+            guard isDecorativeEditingEnabled else { cancelSliderPreview(); return }
+            commitSlider { $0.grainScale = value }
+        })
+    }
+
+    private var matchColorAdjustmentsBinding: Binding<Bool> {
+        Binding(get: { draft.matchColorAdjustments }, set: { enabled in
+            guard isDecorativeEditingEnabled else { return }
+            commit(draft.matchingColorAdjustments(enabled, selectedID: selectedGlowID))
+        })
+    }
+
+    private func glowValueBinding(
+        for id: String,
+        get: @escaping (SettingsStyleGlow) -> Double,
+        set: @escaping (inout SettingsStyleGlow, Double) -> Void
+    ) -> Binding<Double> {
+        Binding(get: {
+            guard let glow = draft.glows.first(where: { $0.id == id }) else { return 0 }
+            return get(glow)
+        }, set: { value in
+            guard isDecorativeEditingEnabled else { cancelSliderPreview(); return }
+            commitSlider { next in applyGlowValue(to: &next, id: id, value: value, set: set) }
+        })
+    }
+
+    private func previewGlowValue(
+        for id: String,
+        value: Double,
+        set: @escaping (inout SettingsStyleGlow, Double) -> Void
+    ) {
+        guard isDecorativeEditingEnabled else { return }
+        previewSlider { next in applyGlowValue(to: &next, id: id, value: value, set: set) }
+    }
+
+    private func applyGlowValue(
+        to configuration: inout SettingsBackdropConfiguration,
+        id: String,
+        value: Double,
+        set: (inout SettingsStyleGlow, Double) -> Void
+    ) {
+        for index in configuration.glows.indices
+        where configuration.matchColorAdjustments || configuration.glows[index].id == id {
+            set(&configuration.glows[index], value)
+        }
+    }
+
+    private var harmonyBinding: Binding<SettingsColorHarmony> {
+        Binding(get: { draft.colorHarmony }, set: { mode in
+            guard isDecorativeEditingEnabled else { return }
+            draft.colorHarmony = mode
+        })
+    }
+
+    private func applyHarmonyColors(_ colors: [String]) {
+        guard isDecorativeEditingEnabled, colors.count == draft.glows.count else { return }
+        commit(draft.applyingColorPalette(colors, harmony: draft.colorHarmony), force: true)
+    }
+
+    private func previewSlider(when enabled: Bool = true, _ mutation: (inout SettingsBackdropConfiguration) -> Void) {
+        guard enabled else { cancelSliderPreview(); return }
+        sliderPreviewActive = true
+        var next = deferredSliderConfiguration ?? draft
+        mutation(&next)
+        draft = next.normalized()
+        normalizeSelectedGlow()
+        publishPreview(draft)
+    }
+
+    private func commitSlider(_ mutation: (inout SettingsBackdropConfiguration) -> Void) {
+        guard colorsOnly || (deferredSliderConfiguration?.enabled ?? draft.enabled) else { cancelSliderPreview(); return }
+        var next = deferredSliderConfiguration ?? draft
+        mutation(&next)
+        sliderPreviewActive = false
+        deferredSliderConfiguration = nil
+        commit(next, force: true)
+    }
+
+    private func handleSliderEditing(_ editing: Bool) {
+        if editing { sliderPreviewActive = true }
+        else if sliderPreviewActive { cancelSliderPreview() }
+    }
+
+    private func cancelSliderPreview() {
+        previewPublisher.cancel()
+        guard sliderPreviewActive || deferredSliderConfiguration != nil else { return }
+        let authoritative = (deferredSliderConfiguration ?? configuration).normalized()
+        sliderPreviewActive = false
+        deferredSliderConfiguration = nil
+        draft = authoritative
+        normalizeSelectedGlow()
+    }
+
+    private func updateDraft(_ mutation: (inout SettingsBackdropConfiguration) -> Void) {
+        var next = draft
+        mutation(&next)
+        commit(next)
+    }
+
+    private func commit(_ value: SettingsBackdropConfiguration, force: Bool = false) {
+        previewPublisher.cancel()
+        previewEcho = nil
+        let next = value.normalized()
+        guard force || next != draft else { return }
+        draft = next
+        normalizeSelectedGlow()
+        configuration = next
+    }
+
+    private func publishPreview(_ value: SettingsBackdropConfiguration) {
+        previewPublisher.submit(value) { next in
+            guard isDecorativeEditingEnabled || isSurfaceEditingEnabled else { return }
+            configuration = next
+            if draggingGlowID != nil { hasPublishedDragPreview = true }
+            // The host can normalize its binding. Recognize its echo rather than
+            // treating our own preview as a conflicting external edit.
+            previewEcho = configuration.normalized()
+        }
+    }
+
+    private func reconcile(_ value: SettingsBackdropConfiguration) {
+        let next = value.normalized()
+        if next == previewEcho { previewEcho = nil; return }
+        guard next != draft else { return }
+        previewPublisher.cancel()
+        if draggingGlowID != nil {
+            deferredConfiguration = next
+            return
+        }
+        if sliderPreviewActive {
+            deferredSliderConfiguration = next
+            return
+        }
+        draft = next
+        normalizeSelectedGlow()
+    }
+
+    private func normalizeSelectedGlow() {
+        guard let selectedGlowID, draft.glows.contains(where: { $0.id == selectedGlowID }) else {
+            self.selectedGlowID = draft.glows.first?.id
+            return
+        }
+    }
+
+    private func observeEditorRanges() {
+        maxObservedGrain = max(maxObservedGrain, draft.grain)
+        maxObservedGlowRadius = max(maxObservedGlowRadius, draft.glows.map(\.radius).max() ?? 0)
+    }
+
+    private func addGlow() {
+        guard isDecorativeEditingEnabled, draft.glows.count < 4 else { return }
+        let usedIDs = Set(draft.glows.map(\.id))
+        let id = (1...4).map { "point-\($0)" }.first { !usedIDs.contains($0) } ?? "point-\(draft.glows.count + 1)"
+        let offset = Double(draft.glows.count)
+        let source = selectedGlow ?? draft.glows.first
+        let glow = SettingsStyleGlow(
+            id: id,
+            color: SettingsRGB(hex: defaultGlowColors[draft.glows.count % defaultGlowColors.count]) ?? SettingsRGB(red: 1, green: 1, blue: 1),
+            x: min(0.82, 0.22 + offset * 0.18),
+            y: min(0.82, 0.24 + offset * 0.15),
+            radius: draft.matchColorAdjustments ? source?.radius ?? 0.45 : 0.45,
+            intensity: draft.matchColorAdjustments ? source?.intensity ?? 0.15 : 0.15
+        )
+        var next = draft
+        next.glows.append(glow)
+        next.colorHarmony = .automatic(for: next.glows.count)
+        next = next.applyingColorPalette(
+            SColorHarmonyPicker.applyingHarmony(to: next.glows.map(\.colorHex), selectedIndex: 0, mode: next.colorHarmony),
+            harmony: next.colorHarmony
+        )
+        selectedGlowID = glow.id
+        commit(next)
+    }
+
+    private func removeSelectedGlow() {
+        guard isDecorativeEditingEnabled, draft.glows.count > 1, let selectedGlowID else { return }
+        var next = draft
+        next.glows.removeAll { $0.id == selectedGlowID }
+        if next.colorHarmony != .custom {
+            next.colorHarmony = .automatic(for: next.glows.count)
+            next = next.applyingColorPalette(
+                SColorHarmonyPicker.applyingHarmony(to: next.glows.map(\.colorHex), selectedIndex: 0, mode: next.colorHarmony),
+                harmony: next.colorHarmony
+            )
+        }
+        colorPickerPresented = colorPickerPresented && !next.glows.isEmpty
+        self.selectedGlowID = next.glows.first?.id
+        commit(next)
+    }
+
+    private func randomizeGlowPositions() {
+        guard isDecorativeEditingEnabled, !draft.glows.isEmpty else { return }
+        let randomValues = (0..<(draft.glows.count * 2)).map { _ in Double.random(in: 0...1) }
+        var next = draft
+        next.glows = Self.randomizedGlowPositions(draft.glows, randomValues: randomValues)
+        commit(next, force: true)
+    }
+
+    internal static func randomizedGlowPositions(
+        _ glows: [SettingsStyleGlow],
+        randomValues: [Double]
+    ) -> [SettingsStyleGlow] {
+        guard !glows.isEmpty else { return [] }
+        let margin = 0.14
+        let jitter: Double = glows.count == 1 ? 0.24 : glows.count <= 4 ? 0.08 : 0.05
+        let anchors: [(x: Double, y: Double)] = switch glows.count {
+        case 1: [(0.50, 0.50)]
+        case 2: [(0.28, 0.30), (0.72, 0.70)]
+        case 3: [(0.25, 0.25), (0.75, 0.30), (0.50, 0.75)]
+        case 4: [(0.25, 0.25), (0.75, 0.25), (0.25, 0.75), (0.75, 0.75)]
+        default:
+            glows.indices.map { index in
+                let angle = (Double(index) / Double(glows.count)) * 2 * .pi - .pi / 2
+                return (0.5 + 0.28 * cos(angle), 0.5 + 0.28 * sin(angle))
+            }
+        }
+        func sample(_ index: Int) -> Double {
+            guard randomValues.indices.contains(index), randomValues[index].isFinite else { return 0.5 }
+            return min(max(randomValues[index], 0), 1)
+        }
+        let rotationSteps = min(Int(sample(0) * 4), 3)
+        let reflected = sample(1) >= 0.5
+        func transformed(_ anchor: (x: Double, y: Double)) -> (x: Double, y: Double) {
+            var dx = anchor.x - 0.5
+            var dy = anchor.y - 0.5
+            for _ in 0..<rotationSteps { (dx, dy) = (-dy, dx) }
+            if reflected { dx = -dx }
+            return (0.5 + dx, 0.5 + dy)
+        }
+        return glows.enumerated().map { index, glow in
+            let anchor = transformed(anchors[index % anchors.count])
+            var result = glow
+            result.x = min(max(anchor.x + (sample(index * 2) - 0.5) * 2 * jitter, margin), 1 - margin)
+            result.y = min(max(anchor.y + (sample(index * 2 + 1) - 0.5) * 2 * jitter, margin), 1 - margin)
+            return result
+        }
+    }
+
+    private func beginMovingGlow(_ id: String) {
+        selectedGlowID = id
+        if draggingGlowID == nil {
+            draggingGlowID = id
+            dragStartGlow = draft.glows.first { $0.id == id }
+            hasPublishedDragPreview = false
+        }
+    }
+
+    private func moveGlow(_ id: String, location: CGPoint, size: CGSize, isEnding: Bool) {
+        guard isDecorativeEditingEnabled else { return }
+        beginMovingGlow(id)
+        var next = draft
+        guard let index = next.glows.firstIndex(where: { $0.id == id }) else { return }
+        next.glows[index].x = min(max(Double(location.x / max(size.width, 1)), 0), 1)
+        next.glows[index].y = min(max(Double(location.y / max(size.height, 1)), 0), 1)
+        draft = next.normalized()
+        if isEnding {
+            finishMovingGlow(id)
+        } else {
+            let resolution = Self.resolveDrag(glowID: id, startGlow: dragStartGlow,
+                localConfiguration: draft, deferredConfiguration: deferredConfiguration,
+                allowsDisabledColors: colorsOnly)
+            if resolution.shouldCommit { publishPreview(resolution.configuration) }
+        }
+    }
+
+    private func finishMovingGlow(_ id: String) {
+        guard draggingGlowID == id else { return }
+        previewPublisher.cancel()
+        let resolution = Self.resolveDrag(
+            glowID: id,
+            startGlow: dragStartGlow,
+            localConfiguration: draft,
+            deferredConfiguration: deferredConfiguration,
+            allowsDisabledColors: colorsOnly,
+            didPublishPreview: hasPublishedDragPreview
+        )
+        draggingGlowID = nil
+        dragStartGlow = nil
+        hasPublishedDragPreview = false
+        deferredConfiguration = nil
+        if resolution.shouldCommit {
+            commit(resolution.configuration, force: true)
+        } else {
+            draft = resolution.configuration
+            normalizeSelectedGlow()
+        }
+    }
+
+    internal static func resolveDrag(
+        glowID: String,
+        startGlow: SettingsStyleGlow?,
+        localConfiguration: SettingsBackdropConfiguration,
+        deferredConfiguration: SettingsBackdropConfiguration?,
+        allowsDisabledColors: Bool = false,
+        didPublishPreview: Bool = false
+    ) -> (configuration: SettingsBackdropConfiguration, shouldCommit: Bool) {
+        let final = localConfiguration.normalized()
+        let localGlow = final.glows.first { $0.id == glowID }
+        let localDidMove: Bool = if let startGlow, let localGlow {
+            startGlow.x != localGlow.x || startGlow.y != localGlow.y
+        } else { false }
+
+        if let deferredConfiguration {
+            guard allowsDisabledColors || deferredConfiguration.enabled else {
+                return (deferredConfiguration.normalized(), false)
+            }
+            guard let localGlow,
+                  let index = deferredConfiguration.glows.firstIndex(where: { $0.id == glowID }) else {
+                return (deferredConfiguration.normalized(), false)
+            }
+            guard localDidMove else { return (deferredConfiguration.normalized(), didPublishPreview) }
+            var merged = deferredConfiguration.normalized()
+            merged.glows[index].x = localGlow.x
+            merged.glows[index].y = localGlow.y
+            return (merged.normalized(), true)
+        }
+        return (final, localDidMove || didPublishPreview)
+    }
+
+    private func cancelMovingGlow() {
+        previewPublisher.cancel()
+        guard draggingGlowID != nil else { return }
+        let authoritative = (deferredConfiguration ?? configuration).normalized()
+        draggingGlowID = nil
+        dragStartGlow = nil
+        hasPublishedDragPreview = false
+        deferredConfiguration = nil
+        draft = authoritative
+        normalizeSelectedGlow()
+    }
+
+    private func moveGlowByAccessibility(_ id: String, dx: Double, dy: Double) {
+        guard isDecorativeEditingEnabled else { return }
+        var next = draft
+        guard let index = next.glows.firstIndex(where: { $0.id == id }) else { return }
+        next.glows[index].x = min(max(next.glows[index].x + dx, 0), 1)
+        next.glows[index].y = min(max(next.glows[index].y + dy, 0), 1)
+        selectedGlowID = id
+        commit(next)
+    }
+
+    private func percent(_ value: Double) -> String { "\(Int((value * 100).rounded()))%" }
+    private func grainPercent(_ value: Double) -> String { "\(Int((value * 100).rounded()))%" }
+    private func scaleFormat(_ value: Double) -> String { "\(value.formatted(.number.precision(.fractionLength(2))))×" }
+    private func radiusFormat(_ value: Double) -> String { "\(value.formatted(.number.precision(.fractionLength(2))))×" }
+    private let defaultGlowColors = ["#F2C94C", "#3D8BFF", "#F2994A", "#56CCF2"]
+}
+
+private struct SettingsBackdropEditorPreview: View {
+    let configuration: SettingsBackdropConfiguration
+    let colorsOnly: Bool
+    let selectedGlowID: String?
+    let editable: Bool
+    let effectsAvailable: Bool
+    let selectGlow: (String) -> Void
+    let editGlow: (String) -> Void
+    let moveGlow: (String, CGPoint, CGSize, Bool) -> Void
+    let moveGlowByAccessibility: (String, Double, Double) -> Void
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        GeometryReader { geometry in
+            ZStack(alignment: .topLeading) {
+                theme.windowCanvas
+                ForEach(configuration.glows, id: \.id) { glow in
+                    RadialGradient(
+                        colors: [
+                            glow.color.color.opacity(colorsOnly || (configuration.enabled && effectsAvailable) ? glow.intensity * configuration.tintStrength : 0),
+                            .clear
+                        ],
+                        center: UnitPoint(x: glow.x, y: glow.y),
+                        startRadius: 0,
+                        endRadius: CGFloat(glow.radius) * configuration.radiusScale(in: geometry.size)
+                    )
+                    .allowsHitTesting(false)
+                }
+                if !colorsOnly {
+                    SettingsBackdropGrainOverlay(
+                        finish: SettingsBackdropFinish(
+                            opacity: 1,
+                            saturation: 1,
+                            grain: configuration.enabled && effectsAvailable ? configuration.grain : 0,
+                            vignette: 0,
+                            grainBlendMode: .normal,
+                            grainColors: []
+                        ),
+                        grainScale: configuration.grainScale
+                    )
+                }
+
+                ForEach(Array(configuration.glows.enumerated()), id: \.element.id) { index, glow in
+                    SettingsBackdropEditorGlowMarker(
+                        glow: glow,
+                        index: index,
+                        isSelected: glow.id == selectedGlowID || configuration.matchColorAdjustments,
+                        size: geometry.size,
+                        editable: editable,
+                        select: { selectGlow(glow.id) },
+                        edit: { editGlow(glow.id) },
+                        move: moveGlow,
+                        moveByAccessibility: moveGlowByAccessibility
+                    )
+                    .position(x: glow.x * geometry.size.width, y: glow.y * geometry.size.height)
+                }
+            }
+            .coordinateSpace(name: "settings-backdrop-editor-preview")
+            .clipShape(RoundedRectangle(cornerRadius: 13, style: .continuous))
+            .overlay {
+                RoundedRectangle(cornerRadius: 13, style: .continuous)
+                    .stroke(theme.borderSubtle, lineWidth: theme.borderWidth)
+            }
+        }
+        .frame(height: 190)
+        .accessibilityElement(children: .contain)
+        .accessibilityLabel("Window color placement")
+        .disabled(!editable)
+    }
+}
+
+private struct SettingsBackdropEditorGlowMarker: View {
+    let glow: SettingsStyleGlow
+    let index: Int
+    let isSelected: Bool
+    let size: CGSize
+    let editable: Bool
+    let select: () -> Void
+    let edit: () -> Void
+    let move: (String, CGPoint, CGSize, Bool) -> Void
+    let moveByAccessibility: (String, Double, Double) -> Void
+    @Environment(\.settingsTheme) private var theme
+
+    @ViewBuilder var body: some View {
+        if editable {
+            marker
+                .focusable(true)
+                .onKeyPress(.return) { select(); return .handled }
+                .onKeyPress(.space) { select(); return .handled }
+                .accessibilityHint("Drag to move this color point. Double-click to open the color picker.")
