+import SwiftUI
+
+/// A shared column divider with pointer and accessibility adjustment paths.
+public struct SettingsColumnResizeHandle: View {
+    @Binding private var width: Double
+    let range: ClosedRange<CGFloat>
+    let label: String
+    @State private var dragStart: CGFloat?
+
+    public init(width: Binding<Double>, range: ClosedRange<CGFloat>, label: String) {
+        _width = width
+        self.range = range
+        self.label = label
+    }
+
+    public static func clamped(_ width: Double, to range: ClosedRange<CGFloat>) -> Double {
+        guard width.isFinite else { return Double(range.lowerBound) }
+        return min(max(width, Double(range.lowerBound)), Double(range.upperBound))
+    }
+
+    private var boundedWidth: CGFloat {
+        CGFloat(Self.clamped(width, to: range))
+    }
+
+    public var body: some View {
+        Rectangle()
+            .fill(.clear)
+            .frame(width: 8)
+            .overlay { Divider() }
+            .contentShape(Rectangle())
+            .gesture(
+                DragGesture(minimumDistance: 0)
+                    .onChanged { value in
+                        let initial = dragStart ?? boundedWidth
+                        dragStart = initial
+                        updateWidth(initial + value.translation.width)
+                    }
+                    .onEnded { _ in dragStart = nil }
+            )
+            .accessibilityElement()
+            .accessibilityLabel(label)
+            .accessibilityValue("\(Int(boundedWidth)) points")
+            .accessibilityAdjustableAction { direction in
+                switch direction {
+                case .increment: updateWidth(boundedWidth + 20)
+                case .decrement: updateWidth(boundedWidth - 20)
+                @unknown default: break
+                }
+            }
+            .focusable()
+            .onKeyPress(.leftArrow) {
+                updateWidth(boundedWidth - 20)
+                return .handled
+            }
+            .onKeyPress(.rightArrow) {
+                updateWidth(boundedWidth + 20)
+                return .handled
+            }
+            .help("Drag to resize, or focus this divider and use the arrow keys.")
+    }
+
+    private func updateWidth(_ proposed: CGFloat) {
+        width = Self.clamped(Double(proposed), to: range)
+    }
+}
