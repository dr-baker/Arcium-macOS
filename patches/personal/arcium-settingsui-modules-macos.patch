+import AppKit
+import SettingsUI
+import SwiftUI
+
+/// Retained gradient layers; live geometry edits do not restart their motion.
+struct SettingsRetainedBackdrop: NSViewRepresentable {
+    let glows: [SettingsBackdropGlow]
+    let motion: SettingsBackdropMotion
+    let animated: Bool
+    let running: Bool
+    let speed: Double
+    let scheme: ColorScheme
+
+    func makeNSView(context: Context) -> RetainedBackdropView { RetainedBackdropView() }
+
+    func updateNSView(_ view: RetainedBackdropView, context: Context) {
+        let appearance = NSAppearance(named: scheme == .dark ? .darkAqua : .aqua)!
+        var colors: [CGColor] = []
+        appearance.performAsCurrentDrawingAppearance {
+            colors = glows.map { NSColor($0.color).cgColor }
+        }
+        view.configure(glows: glows, colors: colors, motion: motion, animated: animated, running: running, speed: speed)
+    }
+}
+
+final class RetainedBackdropView: NSView {
+    private var glows: [SettingsBackdropGlow] = []
+    private var colors: [CGColor] = []
+    private var motion = SettingsBackdropMotion()
+    private var animated = false
+    private var animationSpeed = 1.0
+    private var gradients: [CAGradientLayer] = []
+    private var animationEpoch: CFTimeInterval?
+    private var lastSize = CGSize.zero
+    private var running = true
+
+    override init(frame: NSRect) {
+        super.init(frame: frame)
+        wantsLayer = true
+        layer?.masksToBounds = true
+    }
+    required init?(coder: NSCoder) { nil }
+    override var isFlipped: Bool { true }
+    override func hitTest(_ point: NSPoint) -> NSView? { nil }
+
+    func configure(glows: [SettingsBackdropGlow], colors: [CGColor], motion: SettingsBackdropMotion,
+                   animated: Bool, running: Bool, speed: Double) {
+        let glows = glows.map(Self.bounded)
+        let previousGlows = self.glows
+        let positionMotionChanged = motion.travel != self.motion.travel
+            || animated != self.animated || speed != animationSpeed
+        let opacityMotionChanged = motion.strength != self.motion.strength
+            || motion.pulse != self.motion.pulse
+            || animated != self.animated || speed != animationSpeed
+        self.glows = glows
+        self.colors = colors
+        self.motion = motion
+        self.animated = animated
+        animationSpeed = speed
+        updateLayers(previousGlows: previousGlows, positionMotionChanged: positionMotionChanged,
+                     opacityMotionChanged: opacityMotionChanged)
+        setRunning(running)
+    }
+
+    override func layout() {
+        super.layout()
+        if bounds.size != lastSize {
+            updateLayers(previousGlows: glows, positionMotionChanged: true, opacityMotionChanged: false)
+        }
+    }
+
+    private static func bounded(_ glow: SettingsBackdropGlow) -> SettingsBackdropGlow {
+        func bound(_ value: Double, _ range: ClosedRange<Double>) -> Double {
+            value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : range.lowerBound
+        }
+        var glow = glow
+        glow.x = bound(glow.x, 0...1)
+        glow.y = bound(glow.y, 0...1)
+        glow.radius = bound(glow.radius, 0...1.5)
+        glow.intensity = bound(glow.intensity, 0...1)
+        return glow
+    }
+
+    private func setRunning(_ value: Bool) {
+        guard let layer, value != running else { return }
+        if value {
+            let paused = layer.timeOffset
+            layer.speed = 1
+            layer.timeOffset = 0
+            layer.beginTime = 0
+            layer.beginTime = layer.convertTime(CACurrentMediaTime(), from: nil) - paused
+        } else {
+            let paused = layer.convertTime(CACurrentMediaTime(), from: nil)
+            layer.speed = 0
+            layer.timeOffset = paused
+        }
+        running = value
+    }
+
+    private func updateLayers(previousGlows: [SettingsBackdropGlow], positionMotionChanged: Bool,
+                              opacityMotionChanged: Bool) {
+        guard let layer else { return }
+        let sizeChanged = bounds.size != lastSize
+        lastSize = bounds.size
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        defer { CATransaction.commit() }
+        while gradients.count > glows.count { gradients.removeLast().removeFromSuperlayer() }
+        let retainedCount = gradients.count
+        if animated, animationEpoch == nil {
+            animationEpoch = layer.convertTime(CACurrentMediaTime(), from: nil)
+        }
+        for (index, glow) in glows.enumerated() {
+            let isNew = index >= retainedCount
+            let gradient: CAGradientLayer
+            if isNew {
+                gradient = CAGradientLayer()
+                gradient.type = .radial
+                gradient.startPoint = CGPoint(x: 0.5, y: 0.5)
+                gradient.endPoint = CGPoint(x: 1, y: 1)
+                gradients.append(gradient)
+                layer.addSublayer(gradient)
+            } else {
+                gradient = gradients[index]
+            }
+            let radius = max(bounds.width, bounds.height) * glow.radius
+            let nextColors = [colors[index], colors[index].copy(alpha: 0)!]
+            if gradient.colors as? [CGColor] != nextColors { gradient.colors = nextColors }
+            let nextBounds = CGRect(x: 0, y: 0, width: radius * 2, height: radius * 2)
+            if gradient.bounds != nextBounds { gradient.bounds = nextBounds }
+            let center = CGPoint(x: glow.x * bounds.width, y: glow.y * bounds.height)
+            if gradient.position != center { gradient.position = center }
+            let opacity = Float(min(max(glow.intensity * motion.strength, 0), 1))
+            if gradient.opacity != opacity { gradient.opacity = opacity }
+            let updatePosition = isNew || sizeChanged || positionMotionChanged
+            let updateOpacity = isNew || opacityMotionChanged
+                || previousGlows[index].intensity != glow.intensity
+            guard animated else {
+                if updatePosition {
+                    gradient.removeAnimation(forKey: "position.x")
+                    gradient.removeAnimation(forKey: "position.y")
+                }
+                if updateOpacity { gradient.removeAnimation(forKey: "opacity") }
+                continue
+            }
+            let phase = Double(index) * 2.399_963_229_728_653
+            let period = 2 * Double.pi * (20 + Double(index % 5) * 2.75) / animationSpeed
+            if updatePosition {
+                addWave(to: gradient, key: "position.x", base: 0, amplitude: bounds.width * motion.travel / 2, phase: phase + .pi / 2, duration: period, additive: true)
+                addWave(to: gradient, key: "position.y", base: 0, amplitude: bounds.height * motion.travel / 2, phase: phase * 1.37, duration: period / 0.83, additive: true)
+            }
+            if updateOpacity {
+                addWave(to: gradient, key: "opacity", base: glow.intensity * motion.strength, amplitude: glow.intensity * motion.strength * motion.pulse, phase: phase * 0.71, duration: period / 1.31, clamp: true)
+            }
+        }
+    }
+
+    private func addWave(to layer: CALayer, key: String, base: Double, amplitude: Double, phase: Double,
+                         duration: Double, clamp: Bool = false, additive: Bool = false) {
+        let animation = CAKeyframeAnimation(keyPath: key)
+        animation.values = (0...180).map { step in
+            let value = base + sin(Double(step) / 180 * 2 * .pi + phase) * amplitude
+            return NSNumber(value: clamp ? min(max(value, 0), 1) : value)
+        }
+        animation.duration = duration
+        animation.repeatCount = .infinity
+        animation.calculationMode = .linear
+        animation.isAdditive = additive
+        animation.beginTime = animationEpoch ?? 0
+        layer.add(animation, forKey: key)
+    }
+}
