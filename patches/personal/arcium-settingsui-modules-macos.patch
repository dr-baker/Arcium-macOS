@@ -0,0 +1,226 @@
+import AppKit
+import Foundation
+import SettingsUI
+import SwiftUI
+
+public struct SettingsStylePreset: Codable, Equatable, Sendable {
+    public nonisolated static let currentSchemaVersion = 4
+    public static let standard: SettingsStylePreset = {
+        var preset = SettingsStylePreset(name: "SettingsUI Standard")
+        // New presets keep their glow colors as the source of truth. The
+        // palette generator remains available only to import the old linked
+        // representation below.
+        preset.brand.colorSource = .brand
+        preset.light.backdrop.linksToPalette = false
+        preset.dark.backdrop.linksToPalette = false
+        return preset
+    }()
+
+    public var schemaVersion: Int
+    public var name: String
+    public var brand: SettingsStyleBrand
+    public var font: SettingsFontConfiguration
+    public var layout: SettingsLayoutConfiguration
+    public var light: SettingsStyleAppearance
+    public var dark: SettingsStyleAppearance
+
+    public init(
+        schemaVersion: Int = currentSchemaVersion,
+        name: String,
+        brand: SettingsStyleBrand = SettingsStyleBrand(),
+        font: SettingsFontConfiguration = .init(),
+        layout: SettingsLayoutConfiguration = .init(),
+        light: SettingsStyleAppearance = SettingsStyleAppearance(),
+        dark: SettingsStyleAppearance = SettingsStyleAppearance()
+    ) {
+        var lightAppearance = light
+        var darkAppearance = dark
+        if schemaVersion >= 2 {
+            // Schema 2 stores actual glow colors. Callers creating a new
+            // preset cannot accidentally opt back into the schema-1 live
+            // palette recoloring behavior.
+            lightAppearance.backdrop.linksToPalette = false
+            darkAppearance.backdrop.linksToPalette = false
+        }
+        self.schemaVersion = schemaVersion
+        self.name = name
+        self.brand = brand
+        self.font = font
+        self.layout = layout
+        self.light = lightAppearance
+        self.dark = darkAppearance
+    }
+
+    private enum CodingKeys: String, CodingKey { case schemaVersion, name, brand, font, layout, light, dark }
+
+    public init(from decoder: any Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        schemaVersion = try values.decode(Int.self, forKey: .schemaVersion)
+        name = try values.decode(String.self, forKey: .name)
+        brand = try values.decode(SettingsStyleBrand.self, forKey: .brand)
+        font = try values.decodeIfPresent(SettingsFontConfiguration.self, forKey: .font) ?? .init()
+        layout = try values.decodeIfPresent(SettingsLayoutConfiguration.self, forKey: .layout) ?? .init()
+        light = try values.decode(SettingsStyleAppearance.self, forKey: .light)
+        dark = try values.decode(SettingsStyleAppearance.self, forKey: .dark)
+    }
+
+    public func validate() throws {
+        guard schemaVersion == Self.currentSchemaVersion else {
+            throw SettingsStylePresetError.unsupportedSchemaVersion(schemaVersion)
+        }
+        guard !name.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+            throw SettingsStylePresetError.missingName
+        }
+        try require(layout == layout.normalized, "Layout values are outside their supported ranges.")
+        if let name = font.name {
+            try require(!name.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty && name.count <= 256,
+                        "The custom font name must contain between 1 and 256 characters.")
+        }
+        try validate(light, named: "Light")
+        try validate(dark, named: "Dark")
+    }
+
+    public func jsonData() throws -> Data {
+        let canonical = canonicalizedCurrentSchema()
+        try canonical.validate()
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys, .withoutEscapingSlashes]
+        return try encoder.encode(canonical)
+    }
+
+    public static func decodeJSON(_ data: Data) throws -> Self {
+        var preset = try JSONDecoder().decode(Self.self, from: data)
+        if preset.schemaVersion == 1 {
+            preset = preset.migratedFromV1()
+        } else if preset.schemaVersion == 2 || preset.schemaVersion == 3 {
+            // Schema 2 already stores authoritative glow colors. Glass is
+            // added independently, retaining the old appearance and effects.
+            preset.schemaVersion = Self.currentSchemaVersion
+            preset = preset.canonicalizedCurrentSchema()
+        } else if preset.schemaVersion == Self.currentSchemaVersion {
+            // Schema 2 stores glow colors directly. A hand-authored payload
+            // may still carry the old link flag, but it is no longer live.
+            preset = preset.canonicalizedCurrentSchema()
+        }
+        try preset.validate()
+        return preset
+    }
+
+    private func canonicalizedCurrentSchema() -> Self {
+        guard schemaVersion == Self.currentSchemaVersion else { return self }
+        var canonical = self
+        canonical.light.backdrop.linksToPalette = false
+        canonical.dark.backdrop.linksToPalette = false
+        return canonical
+    }
+
+    /// Materializes the colors that a schema-1 brand host rendered from its
+    /// shared palette. Source-theme hosts already rendered their stored glow
+    /// colors, so migration only clears their obsolete link. Geometry, finish,
+    /// effects, and motion stay untouched. Once a preset has crossed this
+    /// boundary, its stored glows are authoritative.
+    private func migratedFromV1() -> Self {
+        var migrated = self
+        migrated.schemaVersion = Self.currentSchemaVersion
+        migrated.light.backdrop = Self.materializedBackdrop(
+            migrated.light.backdrop,
+            palette: migrated.brand.palette,
+            materializeColors: migrated.brand.colorSource == .brand
+        )
+        migrated.dark.backdrop = Self.materializedBackdrop(
+            migrated.dark.backdrop,
+            palette: migrated.brand.palette,
+            materializeColors: migrated.brand.colorSource == .brand
+        )
+        return migrated
+    }
+
+    private static func materializedBackdrop(
+        _ backdrop: SettingsStyleBackdrop,
+        palette: SettingsPaletteConfiguration,
+        materializeColors: Bool
+    ) -> SettingsStyleBackdrop {
+        guard backdrop.linksToPalette else { return backdrop }
+
+        var unlinked = backdrop
+        unlinked.linksToPalette = false
+        guard materializeColors else { return unlinked }
+
+        let renderedColors = palette.backdropColors.map(Self.rgb)
+        guard !renderedColors.isEmpty else {
+            return unlinked
+        }
+
+        var materialized = backdrop
+        materialized.linksToPalette = false
+        materialized.glows = backdrop.glows.enumerated().map { index, glow in
+            var stored = glow
+            stored.color = renderedColors[index % renderedColors.count]
+            return stored
+        }
+        return materialized
+    }
+
+    private static func rgb(_ color: Color) -> SettingsRGB {
+        let resolved = NSColor(color).usingColorSpace(.sRGB) ?? .black
+        return SettingsRGB(
+            red: resolved.redComponent,
+            green: resolved.greenComponent,
+            blue: resolved.blueComponent
+        )
+    }
+
+    private func validate(_ appearance: SettingsStyleAppearance, named name: String) throws {
+        let surface = appearance.surface
+        try require((0...1).contains(surface.chromeTintOpacity), "\(name) chrome tint must be between 0 and 1.")
+        try require((0...1).contains(surface.contentPanelOpacity), "\(name) panel opacity must be between 0 and 1.")
+        try require((0.9...1.3).contains(surface.fontScale), "\(name) font scale must be between 0.9 and 1.3.")
+        try require((0...1).contains(surface.cardOpacity), "\(name) card opacity must be between 0 and 1.")
+
+        let fade = appearance.scrollFade
+        try require(fade.distance.isFinite && (1...96).contains(fade.distance), "\(name) fade distance must be between 1 and 96.")
+        try require((0...1).contains(fade.intensity), "\(name) fade intensity must be between 0 and 1.")
+        for point in [fade.curve.first, fade.curve.second] {
+            try require((0...1).contains(point.x) && (0...1).contains(point.y), "\(name) fade handles must be inside the unit square.")
+        }
+        try require((0...0.3).contains(appearance.edgeShadow.strength), "\(name) shadow strength must be between 0 and 0.3.")
+        try require((0...24).contains(appearance.edgeShadow.softness), "\(name) shadow softness must be between 0 and 24.")
+
+        let backdrop = appearance.backdrop
+        try require(!backdrop.glows.isEmpty, "\(name) backdrop must contain at least one glow.")
+        try require(backdrop.glows.allSatisfy { !$0.id.isEmpty }, "\(name) glow names must not be empty.")
+        try require(Set(backdrop.glows.map(\.id)).count == backdrop.glows.count, "\(name) glow names must be unique.")
+        for glow in backdrop.glows {
+            try require((0...1).contains(glow.x) && (0...1).contains(glow.y), "\(name) glow \(glow.id) position must be between 0 and 1.")
+            try require(glow.radius.isFinite && glow.radius > 0 && glow.radius <= 1.5, "\(name) glow \(glow.id) radius must be finite and between 0 and 1.5.")
+            try require((0...1).contains(glow.intensity), "\(name) glow \(glow.id) intensity must be between 0 and 1.")
+        }
+
+        let finish = backdrop.finish
+        try require((0...1).contains(finish.opacity), "\(name) backdrop opacity must be between 0 and 1.")
+        try require((0...2).contains(finish.saturation), "\(name) backdrop saturation must be between 0 and 2.")
+        try require((0...1).contains(finish.grain), "\(name) backdrop grain must be between 0 and 1.")
+        try require((0...1).contains(finish.vignette), "\(name) backdrop vignette must be between 0 and 1.")
+
+        if let effects = backdrop.effects {
+            try require((0...1).contains(effects.materialOpacity), "\(name) background material opacity must be between 0 and 1.")
+            try require((0...1).contains(effects.glassTintOpacity), "\(name) background glass tint opacity must be between 0 and 1.")
+            try require((0...2).contains(effects.frostedTintStrength), "\(name) background frosted tint strength must be between 0 and 2.")
+            try require((0...1).contains(effects.tintStrength), "\(name) background tint strength must be between 0 and 1.")
+            try require((0.5...2).contains(effects.grainScale), "\(name) background grain scale must be between 0.5 and 2.")
+        }
+
+        let motion = appearance.motion
+        try require((0...1).contains(motion.travel), "\(name) motion travel must be between 0 and 1.")
+        try require((0...1).contains(motion.pulse), "\(name) motion pulse must be between 0 and 1.")
+        try require((0...3).contains(motion.strength), "\(name) motion strength must be between 0 and 3.")
+        try require((0.1...24).contains(motion.speed), "\(name) motion speed must be between 0.1 and 24.")
+        try require((6...60).contains(motion.framesPerSecond), "\(name) update limit must be between 6 and 60.")
+
+        try appearance.glass.validate(named: "\(name) glass")
+    }
+
+    private func require(_ condition: Bool, _ message: String) throws {
+        guard condition else { throw SettingsStylePresetError.invalidValue(message) }
+    }
+}
