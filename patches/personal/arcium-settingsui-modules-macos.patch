+import SwiftUI
+
+public enum SActionRole: Sendable {
+    /// The one main action in a sheet, card, or banner.
+    case primary
+    /// Other actions beside a primary action.
+    case secondary
+    /// An action that removes or discards something.
+    case destructive
+    /// Low-emphasis actions inside rows and banners.
+    case quiet
+}
+
+/// Text buttons that follow the theme. Keep one primary action per group.
+public struct SActionButtonStyle: ButtonStyle {
+    public let role: SActionRole
+
+    public init(_ role: SActionRole = .secondary) {
+        self.role = role
+    }
+
+    public func makeBody(configuration: Configuration) -> some View {
+        SActionButtonBody(configuration: configuration, role: role)
+    }
+}
+
+public extension ButtonStyle where Self == SActionButtonStyle {
+    static func settings(_ role: SActionRole) -> SActionButtonStyle { SActionButtonStyle(role) }
+}
+
+private struct SActionButtonBody: View {
+    let configuration: ButtonStyleConfiguration
+    let role: SActionRole
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.settingsFontScale) private var fontScale
+    @Environment(\.isEnabled) private var isEnabled
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @Environment(\.colorSchemeContrast) private var contrast
+    @Environment(\.isFocused) private var isFocused
+    @State private var isHovered = false
+
+    var body: some View {
+        let shape = RoundedRectangle(cornerRadius: theme.radius(SettingsRadius.control), style: .continuous)
+        configuration.label
+            .settingsFont(\.body)
+            .fontWeight(role == .primary ? .semibold : .medium)
+            .lineLimit(1)
+            .padding(.horizontal, SettingsSpacing.sm)
+            .frame(minHeight: 30 * SettingsTypography.clampedScale(fontScale))
+            .foregroundStyle(foreground)
+            .background(fill, in: shape)
+            .overlay {
+                if role != .primary && role != .quiet || contrast == .increased {
+                    shape.strokeBorder(border, lineWidth: contrast == .increased ? 1.5 : 1)
+                }
+            }
+            .overlay {
+                if isFocused {
+                    RoundedRectangle(cornerRadius: theme.radius(SettingsRadius.control) + 3, style: .continuous)
+                        .strokeBorder(theme.accent.opacity(0.7), lineWidth: 2)
+                        .padding(-3)
+                }
+            }
+            .contentShape(shape)
+            .opacity(isEnabled ? 1 : SettingsEffects.disabledOpacity)
+            .onHover { isHovered = isEnabled && $0 }
+            .animation(reduceMotion ? nil : SettingsMotion.hover, value: isHovered)
+    }
+
+    private var foreground: Color {
+        switch role {
+        case .primary: theme.selectionText
+        case .destructive: theme.errorText
+        case .secondary, .quiet: theme.textPrimary
+        }
+    }
+
+    private var fill: Color {
+        let pressed = configuration.isPressed
+        switch role {
+        case .primary: return theme.accent.opacity(pressed ? 0.8 : (isHovered ? 0.92 : 1))
+        case .secondary, .destructive: return pressed ? theme.pressedFill : (isHovered ? theme.raisedFill : theme.insetFill)
+        case .quiet: return pressed ? theme.pressedFill : (isHovered ? theme.hoverFill : .clear)
+        }
+    }
+
+    private var border: Color {
+        role == .destructive ? theme.error.opacity(0.45) : theme.separator
+    }
+}
