-    public let c: CGFloat // 0..128. Chroma
-    public let h: CGFloat // 0..360. Hue
-    public let alpha: CGFloat // 0..1
-
-    public func hash(into hasher: inout Hasher) {
-        hasher.combine(l)
-        hasher.combine(c)
-        hasher.combine(h)
-    }
-
-    public static func == (lhs: LCHColor, rhs: LCHColor) -> Bool {
-        return lhs.l == rhs.l &&
-            lhs.c == rhs.c &&
-            lhs.h == rhs.h
-    }
-
-    public init(
-        l: CGFloat = 0,
-        c: CGFloat = 0,
-        h: CGFloat = 0,
-        alpha: CGFloat = 1.0
