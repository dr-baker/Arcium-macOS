+/// Delivers a leading value and the latest trailing value without delaying local input.
+/// Shared by continuous controls and authoring previews; side effects stay with the host.
+package final class SettingsValueThrottle<Value> {
+    private var lastDelivery: ContinuousClock.Instant?
+    private var pending: (value: Value, receive: (Value) -> Void)?
+    private var task: Task<Void, Never>?
+
+    package init() {}
+
+    package func submit(_ value: Value, interval: Duration = .milliseconds(34), receive: @escaping (Value) -> Void) {
+        pending = (value, receive)
+        let interval = max(.zero, interval)
+        let now = ContinuousClock.now
+        if let lastDelivery, now - lastDelivery < interval {
+            guard task == nil else { return }
+            let remaining = interval - (now - lastDelivery)
+            task = Task { [weak self] in
+                do { try await Task.sleep(for: remaining) }
+                catch { return }
+                guard !Task.isCancelled, let self else { return }
+                self.task = nil
+                self.deliver()
+            }
+        } else {
+            task?.cancel()
+            task = nil
+            deliver()
+        }
+    }
+
+    package func cancel() {
+        task?.cancel()
+        task = nil
+        pending = nil
+        lastDelivery = nil
+    }
+
+    private func deliver() {
+        guard let pending else { return }
+        self.pending = nil
+        lastDelivery = .now
+        pending.receive(pending.value)
+    }
+
+    deinit { task?.cancel() }
+}
