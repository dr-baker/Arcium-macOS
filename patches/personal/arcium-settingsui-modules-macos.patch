+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.isEnabled) private var isEnabled
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var isHovered = false
+
+    func body(content: Content) -> some View {
+        let active = isEnabled && isHovered
+        let shape = RoundedRectangle(cornerRadius: SettingsPixelGrid.aligned(theme.radius(cornerRadius), scale: displayScale), style: .continuous)
+        content
+            .overlay {
+                shape.strokeBorder(active ? theme.controlHoverBorder : .clear,
+                                   lineWidth: SettingsPixelGrid.aligned(theme.borderWidth, scale: displayScale))
+                    .shadow(
+                        color: theme.shadowAmbient.opacity(active ? 0.12 : 0),
+                        radius: SettingsEffects.controlHoverShadowRadius,
+                        y: SettingsEffects.controlHoverShadowYOffset
+                    )
+                    .animation(reduceMotion ? nil : SettingsMotion.hover, value: active)
+                    .allowsHitTesting(false)
+            }
+            .contentShape(shape)
+            .onHover { isHovered = $0 }
+    }
+}
+
+private struct SettingsIconPulseModifier<Trigger: Equatable>: ViewModifier {
+    let trigger: Trigger
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var pulseGeneration = 0
+
+    func body(content: Content) -> some View {
+        Group {
+            if reduceMotion {
+                content
+            } else {
+                PhaseAnimator([1.0, SettingsEffects.iconPulseScale, 1.0], trigger: pulseGeneration) { phase in
+                    content.scaleEffect(phase)
+                } animation: { _ in
+                    SettingsMotion.iconPulse
+                }
+            }
+        }
+        .onChange(of: trigger) {
+            guard !reduceMotion else { return }
+            pulseGeneration += 1
+        }
+    }
+}
