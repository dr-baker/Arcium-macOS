+import SettingsUI
+import SettingsUIStyle
+import SwiftUI
+
+/// Chooses which existing backdrop glow supplies the control accent.
+///
+/// The picker only writes the accent role. Glow colors, positions, radii,
+/// intensities, and harmony remain owned by ``SBackdropEditor``.
+public struct SControlAccentPicker: View {
+    @Binding private var controlAccent: SettingsControlAccent
+    public let glows: [SettingsStyleGlow]
+    public let editable: Bool
+
+    @Environment(\.settingsTheme) private var theme
+    @State private var customColorPopoverPresented = false
+
+    public init(
+        controlAccent: Binding<SettingsControlAccent>,
+        glows: [SettingsStyleGlow],
+        editable: Bool = true
+    ) {
+        _controlAccent = controlAccent
+        self.glows = glows
+        self.editable = editable
+    }
+
+    public var body: some View {
+        ViewThatFits(in: .horizontal) {
+            compactRow
+            VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+                Text("Controls accent")
+                    .settingsFont(\.label)
+                    .foregroundStyle(theme.textPrimary)
+                HStack(spacing: SettingsSpacing.sm) {
+                    glowSwatches
+                    customColorPicker
+                }
+            }
+        }
+        .disabled(!editable)
+    }
+
+    private var compactRow: some View {
+        HStack(alignment: .center, spacing: SettingsSpacing.sm) {
+            Text("Controls accent")
+                .settingsFont(\.label)
+                .foregroundStyle(theme.textPrimary)
+            Spacer(minLength: SettingsSpacing.xs)
+            glowSwatches
+            customColorPicker
+        }
+    }
+
+    private var customColorPicker: some View {
+        Button {
+            customColorPopoverPresented = true
+        } label: {
+            ZStack {
+                Circle()
+                    .fill(controlAccent.customColor.color)
+                Image(systemName: "paintpalette.fill")
+                    .font(.system(size: 11, weight: .semibold))
+                    .foregroundStyle(controlAccent.customColor.luminance > 0.42 ? .black : .white)
+            }
+            .frame(width: 24, height: 24)
+            .overlay {
+                Circle()
+                    .strokeBorder(
+                        controlAccent.colorID == nil
+                            ? theme.textPrimary
+                            : theme.borderControl.opacity(0.45),
+                        lineWidth: controlAccent.colorID == nil ? 2 : 1
+                    )
+                    .allowsHitTesting(false)
+            }
+            .contentShape(.circle)
+        }
+        .buttonStyle(.plain)
+        .accessibilityLabel("Custom control accent")
+        .accessibilityValue(controlAccent.colorID == nil ? "Selected" : "Not selected")
+        .accessibilityAddTraits(controlAccent.colorID == nil ? .isSelected : [])
+        .help("Choose a custom control accent.")
+        .popover(isPresented: $customColorPopoverPresented, arrowEdge: .bottom) {
+            SColorHarmonyPicker(
+                colors: customColorHexBinding,
+                selectedIndex: .constant(0),
+                mode: .constant(.custom),
+                title: "Controls accent"
+            )
+            .settingsTheme(theme)
+        }
+    }
+
+    @ViewBuilder
+    private var glowSwatches: some View {
+        ForEach(Array(glows.enumerated()), id: \.element.id) { index, glow in
+            Button {
+                controlAccent.colorID = glow.id
+            } label: {
+                Circle()
+                    .fill(glow.color.color)
+                    .frame(width: 24, height: 24)
+                    .overlay {
+                        Text("\(index + 1)")
+                            .settingsFont(\.smallCaption)
+                            .foregroundStyle(.white)
+                            .shadow(color: .black.opacity(0.7), radius: 2)
+                    }
+                    .overlay {
+                        Circle().strokeBorder(
+                            isSelected(glow) ? theme.textPrimary : theme.borderControl.opacity(0.45),
+                            lineWidth: isSelected(glow) ? 2 : 1
+                        )
+                    }
+                    .contentShape(.rect)
+            }
+            .buttonStyle(.plain)
+            .accessibilityLabel("Glow \(index + 1)")
+            .accessibilityValue(isSelected(glow) ? "Selected, \(glow.colorHex)" : glow.colorHex)
+            .accessibilityAddTraits(isSelected(glow) ? .isSelected : [])
+            .help("Use glow \(index + 1) as the control accent.")
+        }
+    }
+
+    private var customColorHexBinding: Binding<[String]> {
+        Binding(
+            get: { [controlAccent.customColor.hex] },
+            set: { values in
+                guard values.count == 1, let rgb = SettingsRGB(hex: values[0]) else { return }
+                controlAccent = SettingsControlAccent(colorID: nil, customColor: rgb)
+            }
+        )
+    }
+
+    private func isSelected(_ glow: SettingsStyleGlow) -> Bool {
+        if controlAccent.colorID == glow.id { return true }
+        guard controlAccent.colorID != nil, let first = glows.first else { return false }
+        return first.id == glow.id && !glows.contains { $0.id == controlAccent.colorID }
+    }
+
+}
