+            customAccent = newValue.customColor.oklch
+            accentSource = .custom
+        }
+    }
+
+    /// Resolves only the control-accent role against the stored glow IDs.
+    ///
+    /// Unlike ``resolvingColors(from:)``, this leaves all palette seeds,
+    /// harmony, and chrome fields unchanged. Hosts should use this method for
+    /// a control-accent write so a legacy palette does not change its window
+    /// tint merely because the selected control color changed.
+    public func resolvingControlAccent(from glows: [SettingsStyleGlow]) -> Self {
+        resolvingControlAccent(from: glows, preservingAccent: resolvedAccent)
+    }
+
+    /// Resolves the palette from the actual stored glow colors.
+    ///
+    /// The first glow is the primary seed and the second is the companion
+    /// seed. The relationship is recorded as custom because the glow list and
+    /// ``SettingsPaletteHarmony`` are the only source of decorative color
+    /// relationships. This method returns a value and never mutates the glow
+    /// list or writes colors back to a host.
+    public func resolvingColors(from glows: [SettingsStyleGlow]) -> Self {
+        let previousAccent = resolvedAccent
+        var next = self
+
+        if let first = glows.first {
+            next.brand = first.color.oklch
+            next.companion = (glows.dropFirst().first ?? first).color.oklch
+            next.harmony = .custom
+        }
+
+        // The old accent must be captured before the seed derivation above;
+        // an unlinked role deliberately keeps that legacy resolved value.
+        return next.resolvingControlAccent(from: glows, preservingAccent: previousAccent)
+    }
+
+    private func resolvingControlAccent(
+        from glows: [SettingsStyleGlow],
+        preservingAccent previousAccent: SettingsOKLCH
+    ) -> Self {
+        var next = self
+        guard let first = glows.first else {
+            next.controlColorID = nil
+            next.customAccent = previousAccent
+            next.accentSource = .custom
+            return next
+        }
+
+        let selected: SettingsStyleGlow
+        if let controlColorID {
+            selected = glows.first(where: { $0.id == controlColorID }) ?? first
+            next.controlColorID = selected.id
+            next.customAccent = selected.color.oklch
+        } else {
+            next.controlColorID = nil
+            next.customAccent = previousAccent
+        }
+        next.accentSource = .custom
+        return next
+    }
+
+    public nonisolated var resolvedCompanion: SettingsOKLCH {
+        if harmony == .custom { return companion }
+        let offset: Double = switch harmony {
+        case .monochromatic: 0
+        case .analogous: 35
+        case .complementary: 180
+        case .splitComplementary: 150
+        case .custom: 0
+        }
+        return SettingsOKLCH(lightness: brandLightness, chroma: chroma * 0.8, hue: wrapped(hue + offset))
+    }
+
+    public nonisolated var resolvedNeutralHue: Double {
+        switch chromeSource {
+        case .brand: wrapped(hue)
+        case .companion: wrapped(resolvedCompanion.hue)
+        case .neutral: 0
+        case .custom: wrapped(neutralHue)
+        }
+    }
+
+    public nonisolated var resolvedNeutralChroma: Double { chromeSource == .neutral ? 0 : neutralChroma }
+
+    /// Legacy generated decorative colors.
+    ///
+    /// Deprecated for product UI. New hosts should keep decorative colors in
+    /// ``SettingsStyleBackdrop.glows`` and call ``resolvingColors(from:)``.
+    public var backdropColors: [Color] {
+        let thirdHue = switch harmony {
+        case .analogous: wrapped(hue - 35)
+        case .splitComplementary: wrapped(hue + 210)
+        default: wrapped(resolvedCompanion.hue)
+        }
+        let seeds = [brand, resolvedCompanion,
+                     SettingsOKLCH(lightness: brandLightness, chroma: resolvedCompanion.chroma * 0.7, hue: thirdHue)]
+        // Decorative lightness is lifted so very dark brand inputs still produce a glow.
+        return seeds.map { SettingsOKLCH(lightness: 0.72, chroma: $0.chroma, hue: $0.hue).rgb.color }
+    }
+
+    private nonisolated func wrapped(_ value: Double) -> Double {
+        guard value.isFinite else { return 0 }
+        return (value.truncatingRemainder(dividingBy: 360) + 360).truncatingRemainder(dividingBy: 360)
+    }
+}
