@@ -0,0 +1,155 @@
+import AppKit
+import CoreImage
+import CoreImage.CIFilterBuiltins
+import SettingsUI
+import SwiftUI
+
+/// Retains one full-area image per backdrop. Shrinking only crops it; growing
+/// allocates in buckets so live resize does not render every frame.
+struct SettingsBackdropGrain: View {
+    var colors: [Color] = []
+    var grainScale: Double = 1
+
+    @Environment(\.colorScheme) private var colorScheme
+    @State private var texture: Texture?
+
+    private struct RenderInput: Equatable {
+        let request: SettingsBackdropGrainRequest?
+        let colors: [Color]
+        let colorScheme: ColorScheme
+    }
+
+    private struct Texture {
+        let image: CGImage
+        let request: SettingsBackdropGrainRequest
+    }
+
+    var body: some View {
+        let texture = texture?.image
+        let scale = SettingsBackdropGrainRequest.scale(grainScale)
+        let grainScale = grainScale
+        let colors = colors
+        let colorScheme = colorScheme
+        let render = renderTexture
+        // Body and geometry evaluation can run on SwiftUI's render queue.
+        // Defer AppKit color resolution to the main-actor task below.
+        return GeometryReader { @Sendable geometry in
+            let size = geometry.size
+            let request = SettingsBackdropGrainRequest(size: size, grainScale: grainScale,
+                retainedWidth: texture?.width ?? 0, retainedHeight: texture?.height ?? 0)
+            let input = RenderInput(request: request, colors: colors, colorScheme: colorScheme)
+            ZStack(alignment: .topLeading) { @Sendable in
+                Color.clear
+                if let texture {
+                    Image(decorative: texture, scale: 1)
+                        .interpolation(.none)
+                        // Transform the texture before blending; scaling the
+                        // finished overlay changes integer-scale compositing.
+                        .scaleEffect(scale, anchor: .topLeading)
+                }
+            }
+            .frame(width: size.width, height: size.height, alignment: .topLeading)
+            .clipped()
+            .task(id: input) { await render(input) }
+        }
+        .allowsHitTesting(false)
+        .accessibilityHidden(true)
+    }
+
+    @MainActor
+    private func renderTexture(_ input: RenderInput) async {
+        guard var request = input.request, !Task.isCancelled else { return }
+        request.tint = SettingsBackdropGrainTint.resolve(input.colors, colorScheme: input.colorScheme)
+        guard request != texture?.request, !Task.isCancelled,
+              let rendered = await SettingsBackdropGrainRenderer.shared.render(request) else { return }
+        // A synchronous CI render can finish after its SwiftUI task was replaced.
+        // Keep the previous texture until the current request succeeds.
+        guard !Task.isCancelled else { return }
+        texture = Texture(image: rendered, request: request)
+    }
+}
+
+nonisolated struct SettingsBackdropGrainRGBA: Equatable, Sendable {
+    let red: Double
+    let green: Double
+    let blue: Double
+    let alpha: Double
+}
+
+nonisolated struct SettingsBackdropGrainTint: Equatable, Sendable {
+    let first: SettingsBackdropGrainRGBA
+    let last: SettingsBackdropGrainRGBA
+
+    @MainActor
+    static func resolve(_ colors: [Color], colorScheme: ColorScheme) -> Self? {
+        guard let first = colors.first, let last = colors.last,
+              let appearance = NSAppearance(named: colorScheme == .dark ? .darkAqua : .aqua) else { return nil }
+        var result: Self?
+        appearance.performAsCurrentDrawingAppearance {
+            func rgba(_ color: Color) -> SettingsBackdropGrainRGBA? {
+                guard let rgb = NSColor(color).usingColorSpace(.sRGB) else { return nil }
+                return .init(red: rgb.redComponent, green: rgb.greenComponent,
+                             blue: rgb.blueComponent, alpha: rgb.alphaComponent)
+            }
+            if let first = rgba(first), let last = rgba(last) {
+                result = Self(first: first, last: last)
+            }
+        }
+        return result
+    }
+}
+
+nonisolated struct SettingsBackdropGrainRequest: Equatable, Sendable {
+    let width: Int
+    let height: Int
+    var tint: SettingsBackdropGrainTint?
+
+    init?(size: CGSize, grainScale: Double, retainedWidth: Int = 0, retainedHeight: Int = 0,
+          tint: SettingsBackdropGrainTint? = nil) {
+        guard size.width.isFinite, size.height.isFinite, size.width > 0, size.height > 0 else { return nil }
+        let coverage = 1 / min(Self.scale(grainScale), 1)
+        guard let requiredWidth = Int(exactly: ceil(size.width * coverage / 256) * 256),
+              let requiredHeight = Int(exactly: ceil(size.height * coverage / 256) * 256) else { return nil }
+        width = max(retainedWidth, requiredWidth)
+        height = max(retainedHeight, requiredHeight)
+        self.tint = tint
+    }
+
+    static func scale(_ grainScale: Double) -> CGFloat {
+        CGFloat(grainScale.isFinite ? min(max(grainScale, 0.5), 2) : 1)
+    }
+}
+
+actor SettingsBackdropGrainRenderer {
+    nonisolated static let shared = SettingsBackdropGrainRenderer()
+    private lazy var context = CIContext(options: [.cacheIntermediates: false])
+
+    func render(_ request: SettingsBackdropGrainRequest) -> CGImage? {
+        // Requests cancelled while waiting for this actor never start CI work.
+        guard !Task.isCancelled else { return nil }
+        let noise = CIFilter.randomGenerator()
+        let monochrome = CIFilter.colorControls()
+        monochrome.inputImage = noise.outputImage
+        monochrome.saturation = 0
+        // Expand the luminance range so grain remains visible on quiet surfaces.
+        monochrome.contrast = 2.5
+        guard var output = monochrome.outputImage else { return nil }
+        if let colors = request.tint {
+            let tint = CIFilter.falseColor()
+            tint.inputImage = output.applyingFilter("CIColorClamp", parameters: [
+                "inputMinComponents": CIVector(x: 0, y: 0, z: 0, w: 1),
+                "inputMaxComponents": CIVector(x: 1, y: 1, z: 1, w: 1)
+            ])
+            tint.color0 = ciColor(colors.first)
+            tint.color1 = ciColor(colors.last)
+            output = tint.outputImage ?? output
+        }
+        guard !Task.isCancelled else { return nil }
+        return context.createCGImage(output,
+            from: CGRect(x: 0, y: 0, width: request.width, height: request.height))
+    }
+
+    private func ciColor(_ rgba: SettingsBackdropGrainRGBA) -> CIColor {
+        CIColor(red: rgba.red, green: rgba.green, blue: rgba.blue, alpha: rgba.alpha)
+    }
+}
