+import SwiftUI
+
+private struct SSectionSurfaceKey: ContainerValueKey {
+    static let defaultValue = true
+}
+
+extension ContainerValues {
+    fileprivate var settingsGroupedSectionSurface: Bool {
+        get { self[SSectionSurfaceKey.self] }
+        set { self[SSectionSurfaceKey.self] = newValue }
+    }
+}
+
+extension View {
+    /// Apply to a native Section to leave its rows unboxed.
+    public func settingsSectionSurface(_ visible: Bool) -> some View {
+        containerValue(\.settingsGroupedSectionSurface, visible)
+    }
+}
+
+/// Renders native Section declarations with outside headings, optional surfaces,
+/// and subtle row dividers. Owns no scrolling; place inside the host's ScrollView.
+/// Uses public section/subview introspection available on macOS 26.
+public struct SGroupedSections<Content: View>: View {
+    private let showsSurfaces: Bool
+    private let showsDividers: Bool
+    private let content: Content
+    @Environment(\.settingsLayout) private var layout
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.colorSchemeContrast) private var contrast
+
+    public init(showsSurfaces: Bool = true, showsDividers: Bool = true,
+                @ViewBuilder content: () -> Content) {
+        self.showsSurfaces = showsSurfaces
+        self.showsDividers = showsDividers
+        self.content = content()
+    }
+
+    public var body: some View {
+        VStack(alignment: .leading, spacing: layout.sectionSpacing) {
+            ForEach(sections: content) { section in
+                let boxed = showsSurfaces && section.containerValues.settingsGroupedSectionSurface
+                VStack(alignment: .leading, spacing: layout.rowSpacing) {
+                    section.header
+                        .settingsFont(\.label)
+                        .fontWeight(.semibold)
+                        .foregroundStyle(theme.textPrimary)
+                        .padding(.horizontal, boxed ? layout.cardPadding : 0)
+                    rows(section.content)
+                        .padding(boxed ? layout.cardPadding : 0)
+                        .background {
+                            if boxed { Color.clear.settingsCardSurface() }
+                        }
+                    section.footer
+                        .settingsFont(\.caption)
+                        .foregroundStyle(theme.textSecondary)
+                        .padding(.horizontal, boxed ? layout.cardPadding : 0)
+                }
+                .frame(maxWidth: .infinity, alignment: .leading)
+                .accessibilityElement(children: .contain)
+            }
+        }
+    }
+
+    private func rows<Rows: View>(_ content: Rows) -> some View {
+        VStack(alignment: .leading, spacing: layout.rowSpacing) {
+            Group(subviews: content) { rows in
+                ForEach(rows) { row in
+                    if showsDividers, row.id != rows.first?.id {
+                        Rectangle()
+                            .fill(theme.textSecondary.opacity(contrast == .increased ? 0.3 : 0.12))
+                            .frame(height: max(contrast == .increased ? 1 : 0.5, theme.borderWidth))
+                            .accessibilityHidden(true)
+                    }
+                    row
+                }
+            }
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+    }
+}
