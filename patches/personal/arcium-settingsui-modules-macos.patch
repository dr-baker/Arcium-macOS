+
+/// The base material and optional lighting shared by every glass renderer.
+public nonisolated struct SettingsGlassConfiguration: Codable, Equatable, Sendable {
+    public var mode: SettingsGlassMode
+    public var finish: SettingsGlassFinish
+    public var activity: SettingsGlassActivity
+    public var customVariant: Int
+    public var usesCustomVariant: Bool
+    public var tint: SettingsRGB?
+    public var tintOpacity: Double
+    public var opacity: Double
+    public var cornerRadius: Double
+    public var systemInteractive: Bool
+    public var fallbackMaterial: SettingsGlassMaterial
+    public var fallbackBlending: SettingsGlassBlending
+    public var fallbackOutlineOpacity: Double
+    public var effects: SettingsGlassEffects
+    public var reflections: SettingsGlassReflectionConfiguration
+    public var shadow: SettingsGlassShadow
+
+    public init(
+        mode: SettingsGlassMode = .system,
+        finish: SettingsGlassFinish = .regular,
+        activity: SettingsGlassActivity = .followsWindow,
+        customVariant: Int = 9,
+        usesCustomVariant: Bool = true,
+        tint: SettingsRGB? = nil,
+        tintOpacity: Double = 0.12,
+        opacity: Double = 1,
+        cornerRadius: Double = 24,
+        systemInteractive: Bool = false,
+        fallbackMaterial: SettingsGlassMaterial = .underWindowBackground,
+        fallbackBlending: SettingsGlassBlending = .withinWindow,
+        fallbackOutlineOpacity: Double = 0.06,
+        effects: SettingsGlassEffects = .init(),
+        reflections: SettingsGlassReflectionConfiguration = .init(),
+        shadow: SettingsGlassShadow = .init()
+    ) {
+        self.mode = mode
+        self.finish = finish
+        self.activity = activity
+        self.customVariant = customVariant
+        self.usesCustomVariant = usesCustomVariant
+        self.tint = tint
+        self.tintOpacity = tintOpacity
+        self.opacity = opacity
+        self.cornerRadius = cornerRadius
+        self.systemInteractive = systemInteractive
+        self.fallbackMaterial = fallbackMaterial
+        self.fallbackBlending = fallbackBlending
+        self.fallbackOutlineOpacity = fallbackOutlineOpacity
+        self.effects = effects
+        self.reflections = reflections
+        self.shadow = shadow
+    }
+
+    /// A bounded copy for rendering. Zero opacity remains fully transparent.
+    public var normalized: Self {
+        let defaults = Self()
+        var result = self
+        result.customVariant = min(max(customVariant, 0), 19)
+        result.tint = tint.map { SettingsRGB(red: $0.red, green: $0.green, blue: $0.blue) }
+        result.tintOpacity = SettingsGlassValue.bounded(tintOpacity, to: 0...1, fallback: defaults.tintOpacity)
+        result.opacity = SettingsGlassValue.bounded(opacity, to: 0...1, fallback: defaults.opacity)
+        result.cornerRadius = SettingsGlassValue.bounded(cornerRadius, to: 0...200, fallback: defaults.cornerRadius)
+        result.fallbackOutlineOpacity = SettingsGlassValue.bounded(
+            fallbackOutlineOpacity, to: 0...1, fallback: defaults.fallbackOutlineOpacity
+        )
+        result.effects = effects.normalized
+        result.reflections = reflections.normalized
+        result.shadow = shadow.normalized
+        return result
+    }
