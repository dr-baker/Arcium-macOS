+#ifndef CHROME_BROWSER_MAC_INITIAL_PREFS_PATHS_H_
+#define CHROME_BROWSER_MAC_INITIAL_PREFS_PATHS_H_
+
+#include "base/files/file_path.h"
+
+namespace initial_prefs {
+
+// Existing user and system templates take precedence over bundled defaults.
+// Bundled defaults are used only before the effective profile has saved state.
+// Empty directories are ignored. Returns an empty path if no template exists.
+base::FilePath FindInitialPrefsInDirectories(
+    const base::FilePath& user_data_directory,
+    const base::FilePath& system_preferences_directory,
+    const base::FilePath& app_bundle,
+    const base::FilePath& effective_user_data_directory);
+
+}  // namespace initial_prefs
+
+#endif  // CHROME_BROWSER_MAC_INITIAL_PREFS_PATHS_H_
