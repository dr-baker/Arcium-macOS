@@ -0,0 +1,124 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/mac/initial_prefs_paths.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "build/branding_buildflags.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace initial_prefs {
+namespace {
+
+#if BUILDFLAG(GOOGLE_CHROME_BRANDING)
+constexpr char kPreferences[] = "Google Chrome Initial Preferences";
+constexpr char kLegacyPreferences[] = "Google Chrome Master Preferences";
+#else
+constexpr char kPreferences[] = "Chromium Initial Preferences";
+constexpr char kLegacyPreferences[] = "Chromium Master Preferences";
+#endif
+
+class ArciumInitialPrefsTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temporary_.CreateUniqueTempDir());
+    user_ = temporary_.GetPath().Append("user");
+    system_ = temporary_.GetPath().Append("system");
+    bundle_ = temporary_.GetPath().Append("Arcium.app");
+    effective_ = user_;
+  }
+
+  void Write(const base::FilePath& path) {
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, "{}"));
+  }
+
+  base::FilePath Find() {
+    return FindInitialPrefsInDirectories(user_, system_, bundle_, effective_);
+  }
+
+  base::FilePath Bundled() {
+    return bundle_.Append("Contents/Resources/initial_preferences");
+  }
+
+  base::ScopedTempDir temporary_;
+  base::FilePath user_;
+  base::FilePath system_;
+  base::FilePath bundle_;
+  base::FilePath effective_;
+};
+
+TEST_F(ArciumInitialPrefsTest, BundledDefaultsDoNotCreateAUserProfile) {
+  Write(Bundled());
+  EXPECT_EQ(Bundled(), Find());
+  EXPECT_FALSE(base::PathExists(user_));
+}
+
+TEST_F(ArciumInitialPrefsTest, UserAndSystemTemplatesKeepTheirPrecedence) {
+  Write(Bundled());
+  EXPECT_EQ(Bundled(), Find());
+  const auto system_legacy = system_.Append(kLegacyPreferences);
+  Write(system_legacy);
+  EXPECT_EQ(system_legacy, Find());
+  const auto system_current = system_.Append(kPreferences);
+  Write(system_current);
+  EXPECT_EQ(system_current, Find());
+  const auto user_legacy = user_.Append(kLegacyPreferences);
+  Write(user_legacy);
+  EXPECT_EQ(user_legacy, Find());
+  const auto user_current = user_.Append(kPreferences);
+  Write(user_current);
+  EXPECT_EQ(user_current, Find());
+}
+
+TEST_F(ArciumInitialPrefsTest, MissingTemplatesReturnAnEmptyPath) {
+  EXPECT_TRUE(Find().empty());
+  EXPECT_TRUE(FindInitialPrefsInDirectories({}, {}, {}, {}).empty());
+}
+
+TEST_F(ArciumInitialPrefsTest, BundleFallbackWorksWithoutSystemDirectories) {
+  Write(Bundled());
+  EXPECT_EQ(Bundled(),
+            FindInitialPrefsInDirectories({}, {}, bundle_, effective_));
+}
+
+TEST_F(ArciumInitialPrefsTest, ExistingPreferencesWithoutSentinelArePreserved) {
+  Write(Bundled());
+  const auto preferences = user_.Append("Default/Preferences");
+  Write(preferences);
+  EXPECT_FALSE(base::PathExists(user_.Append("First Run")));
+  EXPECT_TRUE(Find().empty());
+  EXPECT_TRUE(base::PathExists(preferences));
+}
+
+TEST_F(ArciumInitialPrefsTest,
+       ExistingLocalStateDoesNotReceiveBundledDefaults) {
+  Write(Bundled());
+  Write(user_.Append("Local State"));
+  EXPECT_TRUE(Find().empty());
+  // Explicit user and system templates retain Chromium's existing behavior.
+  const auto system_current = system_.Append(kPreferences);
+  Write(system_current);
+  EXPECT_EQ(system_current, Find());
+}
+
+TEST_F(ArciumInitialPrefsTest, ExistingOverrideProfileDoesNotReceiveDefaults) {
+  Write(Bundled());
+  effective_ = temporary_.GetPath().Append("overridden-user-data-dir");
+  Write(effective_.Append("Default/Preferences"));
+  EXPECT_TRUE(Find().empty());
+  EXPECT_FALSE(base::PathExists(user_));
+}
+
+TEST_F(ArciumInitialPrefsTest, FreshOverrideIgnoresDefaultProfileState) {
+  Write(Bundled());
+  Write(user_.Append("Local State"));
+  effective_ = temporary_.GetPath().Append("fresh-user-data-dir");
+  EXPECT_EQ(Bundled(), Find());
+  EXPECT_FALSE(base::PathExists(effective_));
+}
+
+}  // namespace
+}  // namespace initial_prefs
