+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/mac/initial_prefs_paths.h"
+
+#include <array>
+
+#include "base/files/file_util.h"
+#include "build/branding_buildflags.h"
+#include "chrome/common/chrome_constants.h"
+
+namespace initial_prefs {
+
+base::FilePath FindInitialPrefsInDirectories(
+    const base::FilePath& user_data_directory,
+    const base::FilePath& system_preferences_directory,
+    const base::FilePath& app_bundle,
+    const base::FilePath& effective_user_data_directory) {
+#if BUILDFLAG(GOOGLE_CHROME_BRANDING)
+  constexpr char kPreferences[] = "Google Chrome Initial Preferences";
+  constexpr char kLegacyPreferences[] = "Google Chrome Master Preferences";
+#else
+  constexpr char kPreferences[] = "Chromium Initial Preferences";
+  constexpr char kLegacyPreferences[] = "Chromium Master Preferences";
+#endif
+  const auto in_directory = [](const base::FilePath& directory,
+                               const char* name) {
+    return directory.empty() ? base::FilePath() : directory.Append(name);
+  };
+  const std::array candidates = {
+      in_directory(user_data_directory, kPreferences),
+      in_directory(user_data_directory, kLegacyPreferences),
+      in_directory(system_preferences_directory, kPreferences),
+      in_directory(system_preferences_directory, kLegacyPreferences),
+  };
+  for (const auto& path : candidates) {
+    if (!path.empty() && base::PathExists(path)) {
+      return path;
+    }
+  }
+  // A profile launched with --no-first-run may have preferences but no
+  // first-run sentinel. Never let the distribution template reset that existing
+  // profile. DIR_USER_DATA honors --user-data-dir; the default directory above
+  // does not.
+  if (app_bundle.empty() || effective_user_data_directory.empty() ||
+      base::PathExists(
+          effective_user_data_directory.Append(chrome::kLocalStateFilename)) ||
+      base::PathExists(
+          effective_user_data_directory.Append(chrome::kInitialProfile)
+              .Append(chrome::kPreferencesFilename))) {
+    return base::FilePath();
+  }
+  const auto bundled = app_bundle.Append("Contents")
+                           .Append("Resources")
+                           .Append("initial_preferences");
+  return base::PathExists(bundled) ? bundled : base::FilePath();
+}
+
+}  // namespace initial_prefs
