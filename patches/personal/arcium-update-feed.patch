+#!/usr/bin/env python3
+
+# Copyright 2026 The Arcium Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import base64
+import contextlib
+import io
+import plistlib
+import tempfile
+import unittest
+from pathlib import Path
+
+import tweak_info_plist
+
+
+PUBLIC_KEY = base64.b64encode(bytes(range(32))).decode('ascii')
+
+
+class SparkleInfoPlistTest(unittest.TestCase):
+  def run_tweak(self, source_plist, *sparkle_args):
+    with tempfile.TemporaryDirectory() as temp_dir:
+      input_path = Path(temp_dir) / 'input.plist'
+      output_path = Path(temp_dir) / 'output.plist'
+      with input_path.open('wb') as output:
+        plistlib.dump(source_plist, output)
+
+      stderr = io.StringIO()
+      with contextlib.redirect_stderr(stderr):
+        result = tweak_info_plist.Main([
+            '--plist=%s' % input_path,
+            '--output=%s' % output_path,
+            '--version=1.2.3.4',
+            '--scm=0',
+            '--bundle_id=net.imput.arcium',
+            *sparkle_args,
+        ])
+
+      result_plist = None
+      if output_path.exists():
+        with output_path.open('rb') as output:
+          result_plist = plistlib.load(output)
+      return result, result_plist, stderr.getvalue()
+
+  def test_sparkle_feed_url_is_written_to_info_plist(self):
+    result, plist, _ = self.run_tweak(
+        {},
+        '--sparkle=1',
+        '--sparkle_ed_key=%s' % PUBLIC_KEY,
+        '--sparkle_feed_url=https://updates.example.invalid/mac/appcast-arm64.xml',
+        '--sparkle_check_interval=3600',
+    )
+
+    self.assertIsNone(result)
+    self.assertEqual(
+        'https://updates.example.invalid/mac/appcast-arm64.xml',
+        plist['SUFeedURL'])
+    self.assertEqual(PUBLIC_KEY, plist['SUPublicEDKey'])
+    self.assertEqual('NO', plist['SUEnableAutomaticChecks'])
+    self.assertEqual(3600, plist['SUScheduledCheckInterval'])
+
+  def test_sparkle_requires_a_configured_feed_url(self):
+    result, plist, stderr = self.run_tweak(
+        {},
+        '--sparkle=1',
+        '--sparkle_ed_key=%s' % PUBLIC_KEY,
+        '--sparkle_check_interval=3600',
+    )
+
+    self.assertEqual(1, result)
+    self.assertIsNone(plist)
+    self.assertIn('valid HTTPS feed URL', stderr)
+
+  def test_sparkle_rejects_non_https_feed_urls(self):
+    result, plist, stderr = self.run_tweak(
+        {},
+        '--sparkle=1',
+        '--sparkle_ed_key=%s' % PUBLIC_KEY,
+        '--sparkle_feed_url=http://updates.example.invalid/appcast.xml',
+        '--sparkle_check_interval=3600',
+    )
+
+    self.assertEqual(1, result)
+    self.assertIsNone(plist)
+    self.assertIn('valid HTTPS feed URL', stderr)
+
+  def test_sparkle_accepts_feed_paths_and_query_strings(self):
+    feed_url = 'https://updates.example.invalid/feed/current?channel=beta'
+    result, plist, _ = self.run_tweak(
+        {},
+        '--sparkle=1',
+        '--sparkle_ed_key=%s' % PUBLIC_KEY,
+        '--sparkle_feed_url=%s' % feed_url,
+        '--sparkle_check_interval=3600',
+    )
+
+    self.assertIsNone(result)
+    self.assertEqual(feed_url, plist['SUFeedURL'])
+
+  def test_sparkle_rejects_public_keys_with_wrong_decoded_length(self):
+    short_key = base64.b64encode(bytes(31)).decode('ascii')
+    result, plist, stderr = self.run_tweak(
+        {},
+        '--sparkle=1',
+        '--sparkle_ed_key=%s' % short_key,
+        '--sparkle_feed_url=https://updates.example.invalid/appcast',
+        '--sparkle_check_interval=3600',
+    )
+
+    self.assertEqual(1, result)
+    self.assertIsNone(plist)
+    self.assertIn('base64-encoded 32-byte EdDSA public key', stderr)
+
+  def test_sparkle_rejects_invalid_base64_public_keys(self):
+    result, plist, stderr = self.run_tweak(
+        {},
+        '--sparkle=1',
+        '--sparkle_ed_key=invalid!',
+        '--sparkle_feed_url=https://updates.example.invalid/appcast',
+        '--sparkle_check_interval=3600',
+    )
+
+    self.assertEqual(1, result)
+    self.assertIsNone(plist)
+    self.assertIn('base64-encoded 32-byte EdDSA public key', stderr)
+
+  def test_disabled_sparkle_removes_feed_and_signing_keys(self):
+    result, plist, _ = self.run_tweak({
+        'SUFeedURL': 'https://updates.example.invalid/old.xml',
+        'SUPublicEDKey': 'old-key',
+        'SUEnableAutomaticChecks': 'YES',
+        'SUScheduledCheckInterval': 3600,
+    })
+
+    self.assertIsNone(result)
+    self.assertNotIn('SUFeedURL', plist)
+    self.assertNotIn('SUPublicEDKey', plist)
+    self.assertNotIn('SUEnableAutomaticChecks', plist)
+    self.assertNotIn('SUScheduledCheckInterval', plist)
+
+
+if __name__ == '__main__':
+  unittest.main()
