+def _IsValidSparkleFeedURL(feed_url):
+  if not feed_url or any(character.isspace() or ord(character) < 0x20
+                         for character in feed_url):
+    return False
+
+  try:
+    parsed_url = urlsplit(feed_url)
+    # Accessing .port validates any explicit port syntax.
+    _ = parsed_url.port
+  except ValueError:
+    return False
+
+  return (parsed_url.scheme == 'https' and parsed_url.hostname is not None and
+          parsed_url.username is None and parsed_url.password is None and
+          not parsed_url.fragment)
+
