+TEST(CommandPanelLayoutMacTest, NormalizesDetachedFlushAndValidatesResultCount) {
+  auto layout = Layout();
+  layout[@"connected"] = @NO;
+  layout[@"result_count"] = @20;
+  auto converted = CommandPanelLayoutFromNSObject(layout);
+  ASSERT_TRUE(converted);
+  EXPECT_EQ(2, converted->FindInt("scope_width"));
+  EXPECT_EQ(20, converted->FindInt("result_count"));
+  for (id invalid in @[@YES, @0, @21, @1.5, @"8", [NSNull null]]) {
+    layout[@"result_count"] = invalid;
+    EXPECT_FALSE(CommandPanelLayoutFromNSObject(layout));
+  }
+}
