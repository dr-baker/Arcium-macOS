+- (IBAction)openSpaceFromDock:(id)sender {
+  [NSApp activateIgnoringOtherApps:YES];
+  NSString* pathString = [sender representedObject];
+  if (![pathString isKindOfClass:[NSString class]] || pathString.length == 0) {
+    return;
+  }
+  const base::FilePath profile_path(base::SysNSStringToUTF8(pathString));
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  Profile* profile = profile_manager->GetProfileByPath(profile_path);
+  auto activate_space = [](Profile* profile) {
+    if (!profile || !helium::IsHeliumFavoritesAndPinsEnabled()) {
+      return;
+    }
+    if (auto* space_service =
+            helium::HeliumSpaceServiceFactory::GetForProfile(profile)) {
+      if (helium::HeliumSpace* space = space_service->GetDefaultSpace()) {
+        space->SyncNameFromProfile();
+        space->ActivateOrCreatePrimaryWindow();
+      }
+    }
+  };
+  if (profile) {
+    activate_space(profile);
+    return;
+  }
+  profile_manager->LoadProfileByPath(profile_path, /*incognito=*/false,
+                                     base::BindOnce(activate_space));
+}
