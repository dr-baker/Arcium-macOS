+// These controls edit the same profile dictionary consumed by CommandPanelView.
+// The shared schema generates the descriptors and C++ defaults together.
+private struct ArciumCommandDesignSlider: View {
+    @ObservedObject var store: ArciumSettingsStore
+    let token: ArciumCommandDesign.Token
+    // Preserve the existing serialized boost while presenting its full factor.
+    private var displayOffset: Double { token.id == "selected_scope_boost" ? 1 : 0 }
+    private var value: Binding<Double> {
+        Binding(get: { store.snapshot.appearance.commandPanelLayout.design.number(token) + displayOffset },
+                set: { value in
+                    var layout = store.snapshot.appearance.commandPanelLayout
+                    layout.design.setNumber(value - displayOffset, for: token)
+                    store.setCommandPanelLayout(layout)
+                })
+    }
+    var body: some View {
+        SSlider(token.label, value: value,
+                range: (token.range.lowerBound + displayOffset)...(token.range.upperBound + displayOffset),
+                step: token.step,
+                format: { value in
+                    token.id.hasSuffix("_ms") ? "\(Int(value.rounded())) ms" :
+                    (token.integer || token.id == "glow_softness" ? "\(Int(value.rounded())) pt" : "\(Int((value * 100).rounded()))%")
+                })
+            .accessibilityIdentifier("command-design-" + token.id)
+    }
+}
+
+private struct ArciumCommandDesignControls: View {
+    @ObservedObject var store: ArciumSettingsStore
+    private static let groups = ["Geometry", "Typography", "Motion", "Colors"]
+    private var design: ArciumCommandDesign { store.snapshot.appearance.commandPanelLayout.design }
+    private func change(_ edit: (inout ArciumCommandDesign) -> Void) {
+        var layout = store.snapshot.appearance.commandPanelLayout
+        edit(&layout.design)
+        store.setCommandPanelLayout(layout)
+    }
+    private func color(_ token: ArciumCommandDesign.Token) -> Binding<Color> {
+        Binding(get: {
+            let hex = design.color(token)
+            let value = UInt32(hex.dropFirst(), radix: 16) ?? 0xF2F2F0
+            return Color(.sRGB, red: Double((value >> 16) & 255) / 255,
+                         green: Double((value >> 8) & 255) / 255, blue: Double(value & 255) / 255)
+        }, set: { color in
+            guard let rgb = NSColor(color).usingColorSpace(.sRGB) else { return }
+            func byte(_ value: CGFloat) -> Int { Int((min(1, max(0, value)) * 255).rounded()) }
+            let hex = String(format: "#%02X%02X%02X", byte(rgb.redComponent), byte(rgb.greenComponent), byte(rgb.blueComponent))
+            change { $0.setColor(hex, for: token) }
+        })
+    }
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            ForEach(Self.groups, id: \.self) { group in
+                DisclosureGroup(group) {
+                    VStack(spacing: 12) {
+                        ForEach(ArciumCommandDesign.tokens.filter { $0.group == group }) { token in
+                            if token.color {
+                                HStack {
+                                    ColorPicker(token.label, selection: color(token), supportsOpacity: false)
+                                        .accessibilityIdentifier("command-design-" + token.id)
+                                    Button("Theme") { change { $0.setColor("", for: token) } }
+                                        .disabled(design.color(token).isEmpty)
+                                        .accessibilityIdentifier("command-design-reset-" + token.id)
+                                }
+                            } else {
+                                ArciumCommandDesignSlider(store: store, token: token)
+                            }
+                        }
+                    }.padding(.top, 8)
+                }
+            }
+            Button("Reset design values") { change { $0 = ArciumCommandDesign() } }
+                .disabled(design.isDefault)
+                .accessibilityIdentifier("command-design-reset")
+        }
+    }
+}
