   EXPECT_FALSE(model.SetCommandPanelLayout(malformed));
 }
 }  // namespace arcium_settings
+
+namespace arcium_settings {
+TEST(CommandPanelLayoutMacTest, ValidatesAndPreservesLiveDesignOverrides) {
+  auto layout = Layout();
+  layout[@"design"] = @{@"row_height": @52, @"glow_softness": @12.5, @"text_color": @"#aBcDeF"};
+  auto converted = CommandPanelLayoutFromNSObject(layout);
+  ASSERT_TRUE(converted);
+  ASSERT_TRUE(converted->FindDict("design"));
+  EXPECT_EQ(52, converted->FindDict("design")->FindDouble("row_height"));
+  EXPECT_EQ("#aBcDeF", *converted->FindDict("design")->FindString("text_color"));
+  for (id invalid in @[@YES, @[], @{@"row_height": @YES}, @{@"row_height": @1000},
+                       @{@"row_height": @43.5}, @{@"text_color": @"#0xFFFF"},
+                       @{@"unknown": @3}, @{@"selection_ms": @(INFINITY)},
+                       @{@"selection_ms": @(-INFINITY)}, @{@"selection_ms": @(NAN)}]) {
+    layout[@"design"] = invalid;
+    EXPECT_FALSE(CommandPanelLayoutFromNSObject(layout));
+  }
+}
+
+TEST_F(CommandPanelLayoutModelTest, LiveDesignSavesThroughProfileOwner) {
+  ArciumSettingsModel model(browser()->profile(), base::DoNothing(),
+                           base::DoNothing());
+  auto layout = Layout();
+  layout[@"result_count"] = @12;
+  layout[@"design"] = @{@"row_height": @52, @"glow_softness": @12.5,
+                        @"text_color": @"#aBcDeF", @"selection_ms": @120};
+  auto converted = CommandPanelLayoutFromNSObject(layout);
+  ASSERT_TRUE(converted);
+  ASSERT_TRUE(model.SetCommandPanelLayout(*converted));
+  EXPECT_EQ(*converted, model.GetCommandPanelLayout());
+  EXPECT_EQ(*converted, browser()->profile()->GetPrefs()->GetDict(
+                            arcium::kCommandPanelLayoutPref));
+  auto legacy = converted->Clone();
+  legacy.Remove("result_count");
+  ASSERT_TRUE(model.SetCommandPanelLayout(legacy));
+  EXPECT_EQ(legacy, model.GetCommandPanelLayout());
+  auto invalid = legacy.Clone();
+  invalid.Set("design", true);
+  EXPECT_FALSE(model.SetCommandPanelLayout(invalid));
+  invalid = legacy.Clone();
+  invalid.Set("design", base::DictValue().Set("row_height", 10000));
+  EXPECT_FALSE(model.SetCommandPanelLayout(invalid));
+  invalid = legacy.Clone();
+  invalid.Set("design", base::DictValue().Set("unknown", 1));
+  EXPECT_FALSE(model.SetCommandPanelLayout(invalid));
+  EXPECT_EQ(legacy, model.GetCommandPanelLayout());
+}
+
+}  // namespace arcium_settings
