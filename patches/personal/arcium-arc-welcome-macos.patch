+@interface ArciumWelcomeWindowController
+    : NSWindowController <NSWindowDelegate, ArciumWelcomeDelegate>
+- (instancetype)initWithProfile:(Profile*)profile;
+- (void)publish;
+- (void)jobFinished:(NSDictionary*)job;
+- (void)defaultBrowserState:(shell_integration::DefaultWebClientState)state;
+- (void)installFinished:(const std::string&)extensionID success:(bool)success;
+- (void)closeWindow;
+@end
+
+void WelcomeBridge::OnProfileWillBeDestroyed(Profile* profile) {
+  profile_observation_.Reset();
+  // Closing invalidates this bridge. Retain the controller while it tears down
+  // its profile references, and do not access bridge members afterwards.
+  ArciumWelcomeWindowController* __attribute__((objc_precise_lifetime)) controller =
+      controller_;
+  [controller closeWindow];
+}
+
+void WelcomeBridge::ArcChanged() {
+  [controller_ publish];
+}
+void WelcomeBridge::JobFinished(const base::DictValue& job) {
+  [controller_ jobFinished:NSDictionaryFromDict(job)];
+}
+void WelcomeBridge::SheetClosed() {
+  [controller_ publish];
+}
+void WelcomeBridge::DefaultBrowserState(
+    shell_integration::DefaultWebClientState state) {
+  [controller_ defaultBrowserState:state];
+}
+void WelcomeBridge::InstallFinished(
+    std::string id,
+    bool success,
+    const std::string& error,
+    extensions::webstore_install::Result result) {
+  [controller_ installFinished:id success:success];
+}
