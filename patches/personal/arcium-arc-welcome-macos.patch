+            job("failed", failure: "sidebar_unreadable"), job("failed", failure: "sidebar_not_saved"),
+            job("failed", failure: "history_incomplete"), job("failed", failure: "destination_closed"),
+        ]
+        for fields in outcomes {
+            let job = ArciumArcImportJob(fields)
+            let text = [ArciumArcImportCopy.title(job), ArciumArcImportCopy.body(job) ?? ""]
+                .joined(separator: " ").lowercased()
