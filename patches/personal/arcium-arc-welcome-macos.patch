+@MainActor
+private final class ImportRecorder: NSObject, ArciumArcImportDelegate, ArciumWelcomeDelegate {
+    var actions: [(String, [String: Any])] = []
+    func arcImportActionInvoked(name: String, payload: NSDictionary) {
+        actions.append((name, payload as? [String: Any] ?? [:]))
+    }
+    func welcomeActionInvoked(name: String, payload: NSDictionary) {
+        actions.append((name, payload as? [String: Any] ?? [:]))
+    }
+    var names: [String] { actions.map(\.0) }
+}
+
+private func source(_ token: String, _ title: String, sidebar: Bool = true, imported: Bool = false) -> [String: Any] {
+    ["token": token, "title": title, "detail": "", "canImportSidebar": sidebar,
+     "canImportHistory": true, "previouslyImported": imported]
+}
+
+private func snapshot(phase: String = "ready", sources: [[String: Any]], job: [String: Any]? = nil,
+                      startError: String? = nil) -> NSDictionary {
+    var fields: [String: Any] = ["phase": phase, "destinationAvailable": true, "destinationName": "Personal",
+                                 "sidebarAllowed": true, "historyAllowed": true, "sources": sources,
+                                 "finishedJobs": []]
+    fields["job"] = job
+    fields["startError"] = startError
+    return fields as NSDictionary
+}
+
+private func job(_ outcome: String, failure: String = "none", partial: Bool = false,
+                 step: String = "none") -> [String: Any] {
+    ["id": 3, "token": "g1-0", "sourceTitle": "Work", "destinationName": "Personal", "includesSidebar": true,
+     "includesHistory": false, "refresh": false, "step": step, "outcome": outcome, "failure": failure,
+     "partial": partial, "historyFinished": false, "spaces": 4, "pins": 123, "folders": 10,
+     "favorites": 7, "firstSpaceID": "arc:Default:space"]
+}
