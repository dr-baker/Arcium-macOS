+// MARK: - Sheet
+
+struct ArciumArcImportView: View {
+    @ObservedObject var store: ArciumArcImportStore
+
+    var body: some View {
+        ArciumPresetSurface(preset: store.preset, palette: store.snapshot.palette) {
+            ArciumArcImportSheetBody(store: store)
+        }
+    }
+}
+
+private struct ArciumArcImportSheetBody: View {
+    @ObservedObject var store: ArciumArcImportStore
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack(spacing: SettingsSpacing.xs) {
+                Image(systemName: "square.stack.3d.down.right")
+                    .settingsSymbol()
+                    .foregroundStyle(theme.accent)
+                    .accessibilityHidden(true)
+                Text("Import from Arc")
+                    .settingsFont(\.section)
+                    .accessibilityAddTraits(.isHeader)
+                Spacer()
+            }
+            .padding(.horizontal, SettingsSpacing.xl)
+            .padding(.top, SettingsSpacing.xl)
+            .padding(.bottom, SettingsSpacing.sm)
+
+            ScrollView {
+                content
+                    .frame(maxWidth: .infinity, alignment: .leading)
+                    .padding(.horizontal, SettingsSpacing.xl)
+                    .padding(.vertical, SettingsSpacing.xs)
+                    .animation(reduceMotion ? nil : .smooth(duration: 0.2), value: store.snapshot.phase)
+            }
+
+            footer
+                .padding(.horizontal, SettingsSpacing.xl)
+                .padding(.vertical, SettingsSpacing.md)
+        }
+        .settingsSheetSurface()
+        .frame(minWidth: 500, idealWidth: 560, minHeight: 480, idealHeight: 600)
+        .onExitCommand { store.close() }
+    }
+
+    @ViewBuilder private var content: some View {
+        switch store.snapshot.phase {
+        case .discovering:
+            HStack(spacing: SettingsSpacing.sm) {
+                ProgressView().controlSize(.small)
+                Text("Looking for Arc…").foregroundStyle(theme.textSecondary)
+            }
+            .frame(maxWidth: .infinity, minHeight: 240)
+        case .ready where store.snapshot.sources.isEmpty:
+            ArciumArcImportEmptyState(store: store)
+        case .ready:
+            ArciumArcImportSelection(store: store)
+        case .running:
+            if let job = store.snapshot.job { ArciumArcImportProgress(job: job) }
+        case .finished:
+            if let job = store.snapshot.job { ArciumArcImportResult(job: job) }
+        }
+    }
+
+    @ViewBuilder private var footer: some View {
+        HStack(spacing: SettingsSpacing.xs) {
+            switch store.snapshot.phase {
+            case .running:
+                Spacer()
+                Button("Stop import") { store.cancel() }
+                    .buttonStyle(.settings(.destructive))
+                    .accessibilityHint("Stopping doesn't remove anything already added.")
+            case .finished:
+                if let job = store.snapshot.job {
+                    finishedButtons(job)
+                }
+            case .ready, .discovering:
+                Button("Other browsers…") { store.otherBrowsers() }
+                    .buttonStyle(.settings(.quiet))
+                    .help("Import from another browser in browser settings")
+                Spacer()
+                Button("Cancel") { store.close() }
+                    .buttonStyle(.settings(.secondary))
+                    .keyboardShortcut(.cancelAction)
+                if !store.snapshot.sources.isEmpty {
+                    Button(store.primaryTitle) { store.start() }
+                        .buttonStyle(.settings(.primary))
+                        .keyboardShortcut(.defaultAction)
+                        .disabled(!store.canStart)
+                }
+            }
+        }
+    }
+
+    @ViewBuilder private func finishedButtons(_ job: ArciumArcImportJob) -> some View {
+        switch job.outcome {
+        case .succeeded:
+            Button("Import another profile") { store.reset() }.buttonStyle(.settings(.quiet))
+            Spacer()
+            if !job.firstSpaceID.isEmpty {
+                Button("Open Space") { store.openSpace(job) }.buttonStyle(.settings(.secondary))
+            }
+        case .empty:
+            Button("Choose another") { store.reset() }.buttonStyle(.settings(.quiet))
+            Spacer()
+        case .failed, .cancelled:
+            Button("Choose another") { store.reset() }.buttonStyle(.settings(.quiet))
+            Spacer()
+            if job.failure != "destination_closed" {
+                Button(job.outcome == .cancelled ? "Import again" : "Try again") { store.retry(job) }
+                    .buttonStyle(.settings(.secondary))
+            }
+        case .none:
+            Spacer()
+        }
+        Button("Done") { store.close() }
+            .buttonStyle(.settings(.primary))
+            .keyboardShortcut(.defaultAction)
+    }
+}
