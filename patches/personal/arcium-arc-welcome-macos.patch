+// Delivers asynchronous browser callbacks only while the window is alive.
+class WelcomeBridge : public ProfileObserver {
+ public:
+  WelcomeBridge(ArciumWelcomeWindowController* controller, Profile* profile)
+      : controller_(controller) {
+    profile_observation_.Observe(profile);
+  }
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+  void ArcChanged();
+  void JobFinished(const base::DictValue& job);
+  void SheetClosed();
+  void DefaultBrowserState(shell_integration::DefaultWebClientState state);
+  void InstallFinished(std::string id,
+                       bool success,
+                       const std::string& error,
+                       extensions::webstore_install::Result result);
+  base::WeakPtr<WelcomeBridge> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  __weak ArciumWelcomeWindowController* controller_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::WeakPtrFactory<WelcomeBridge> weak_factory_{this};
+};
