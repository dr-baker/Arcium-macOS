+// MARK: - Shared theming
+
+/// Applies the packaged preset, and the Settings Space palette when present,
+/// so native sheets match the Settings window.
+struct ArciumPresetSurface<Content: View>: View {
+    let preset: SettingsStylePreset?
+    var palette = ArciumSpacePaletteSnapshot()
+    @ViewBuilder let content: Content
+    @Environment(\.colorScheme) private var colorScheme
+
+    var body: some View {
+        if let preset {
+            let style = colorScheme == .dark ? preset.dark : preset.light
+            content
+                .settingsTheme(palette.theme(fallback: style.theme(brand: preset.brand), colorScheme: colorScheme))
+                .settingsFont(preset.font)
+                .settingsFontScale(CGFloat(style.surface.fontScale))
+                .settingsLayout(SettingsLayoutConfiguration(
+                    pageGutter: 24, compactPageGutter: 16, maximumPageWidth: 960,
+                    cardPadding: 14, sectionSpacing: 20, rowSpacing: 7, inputWidth: 260))
+                .labelStyle(SettingsIconLabelStyle())
+        } else {
+            content
+        }
+    }
+}
+
+func loadArciumPackagedPreset() -> SettingsStylePreset? {
+    try? loadArciumSettingsStylePreset(from:
+        Bundle.main.resourceURL?.appendingPathComponent("ArciumSettingsUI_ArciumSettingsUI.bundle"))
+}
+
+/// Round initial badge used for Arc and Arcium profiles.
+struct ArciumProfileBadge: View {
+    let title: String
+    var emphasized = false
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        Text(String(title.trimmingCharacters(in: .whitespaces).prefix(1)).uppercased())
+            .settingsFont(\.label)
+            .foregroundStyle(emphasized ? theme.selectionText : theme.textPrimary)
+            .frame(width: 30, height: 30)
+            .background(emphasized ? theme.accent : theme.insetFill, in: Circle())
+            .accessibilityHidden(true)
+    }
+}
+
+/// One finished job, used by the sheet history and the setup Arc step.
+struct ArciumImportJobRow: View {
+    let job: ArciumArcImportJob
+    var retry: (() -> Void)?
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        HStack(alignment: .firstTextBaseline, spacing: SettingsSpacing.sm) {
+            Image(systemName: symbol)
+                .foregroundStyle(tint)
+                .frame(width: 18)
+                .accessibilityHidden(true)
+            VStack(alignment: .leading, spacing: 2) {
+                Text("\(job.sourceTitle) → \(job.destinationName)")
+                    .settingsFont(\.label)
+                Text(ArciumArcImportCopy.body(job) ?? ArciumArcImportCopy.title(job))
+                    .settingsFont(\.caption)
+                    .foregroundStyle(theme.textSecondary)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+            Spacer(minLength: 0)
+            if let retry, job.outcome == .failed || job.outcome == .cancelled {
+                Button("Try again", action: retry).buttonStyle(.settings(.quiet))
+            }
+        }
+        .accessibilityElement(children: .combine)
+        .accessibilityLabel("\(ArciumArcImportCopy.title(job)). \(ArciumArcImportCopy.body(job) ?? "")")
+    }
+
+    private var symbol: String {
+        switch job.outcome {
+        case .succeeded: "checkmark.circle.fill"
+        case .empty: "circle.dashed"
+        case .cancelled: "stop.circle"
+        case .failed: "exclamationmark.triangle.fill"
+        case .none: "circle"
+        }
+    }
+
+    private var tint: Color {
+        switch job.outcome {
+        case .succeeded: theme.success
+        case .failed: theme.error
+        case .cancelled, .empty: theme.warning
+        case .none: theme.textSecondary
+        }
+    }
+}
