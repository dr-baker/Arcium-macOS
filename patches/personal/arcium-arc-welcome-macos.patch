+        XCTAssertEqual(store.snapshot.startError, "busy")
+        XCTAssertFalse(store.isRunning)
+        XCTAssertEqual(ArciumArcImportCopy.startError("busy"), "Another import into this profile is running.")
+    }
+
+    func testRetryReturnsToSelectionWithoutReplayingHistory() {
+        let recorder = ImportRecorder()
+        var failed = job("failed", failure: "history_incomplete", partial: true)
+        failed["includesHistory"] = true
+        failed["historyFinished"] = true
+        let sources = [source("g1-0", "Work")]
+        let store = ArciumArcImportStore(
+            snapshot: snapshot(phase: "finished", sources: sources, job: failed), delegate: recorder)
+        store.includeHistory = true
+        store.retry(store.snapshot.job!)
+        XCTAssertEqual(recorder.names, ["reset"])
+        XCTAssertEqual(store.selectedToken, "g1-0")
+        XCTAssertTrue(store.includeSidebar)
+        XCTAssertFalse(store.includeHistory)
+        store.updateSnapshot(snapshot(sources: sources))
+        store.start()
+        XCTAssertEqual(recorder.names, ["reset", "start"])
+        XCTAssertEqual(recorder.actions[1].1["history"] as? Bool, false)
+        store.includeHistory = true
+        store.start()
+        XCTAssertEqual(recorder.actions.last?.1["history"] as? Bool, true)
+    }
