+private struct ArciumArcImportResult: View {
+    let job: ArciumArcImportJob
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.md) {
+            Image(systemName: symbol)
+                .font(.system(size: 32, weight: .semibold))
+                .foregroundStyle(tint)
+                .accessibilityHidden(true)
+            Text(ArciumArcImportCopy.title(job))
+                .settingsFont(\.title)
+                .accessibilityAddTraits(.isHeader)
+            if job.outcome == .succeeded, job.includesSidebar {
+                HStack(spacing: SettingsSpacing.sm) {
+                    metric(job.spaces, "Space")
+                    metric(job.pins, "Pin")
+                    metric(job.folders, "folder")
+                    metric(job.favorites, "Favorite")
+                }
+                if job.includesHistory, job.historyFinished {
+                    Text(ArciumArcImportCopy.historyFinishedCaption).foregroundStyle(theme.textSecondary)
+                }
+            } else if let body = ArciumArcImportCopy.body(job) {
+                Text(body)
+                    .foregroundStyle(theme.textSecondary)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+        }
+        .frame(maxWidth: .infinity, minHeight: 280, alignment: .leading)
+        .accessibilityElement(children: .combine)
+    }
+
+    private func metric(_ value: Int, _ noun: String) -> some View {
+        VStack(alignment: .leading, spacing: 2) {
+            Text("\(value)").settingsFont(\.metricValue)
+            Text(noun + (value == 1 ? "" : "s"))
+                .settingsFont(\.caption)
+                .foregroundStyle(theme.textSecondary)
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .padding(SettingsSpacing.sm)
+        .background(theme.insetFill, in: RoundedRectangle(cornerRadius: SettingsRadius.card, style: .continuous))
+    }
+
+    private var symbol: String {
+        switch job.outcome {
+        case .succeeded: "checkmark.circle.fill"
+        case .empty: "tray"
+        case .cancelled: "stop.circle"
+        case .failed, .none: "exclamationmark.triangle.fill"
+        }
+    }
+
+    private var tint: Color {
+        switch job.outcome {
+        case .succeeded: theme.success
+        case .failed, .none: theme.error
+        case .empty, .cancelled: theme.warning
+        }
+    }
+}
