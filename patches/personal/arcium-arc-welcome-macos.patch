+- (instancetype)initWithProfile:(Profile*)profile {
+  NSWindow* window = [[NSWindow alloc]
+      initWithContentRect:NSMakeRect(0, 0, 720, 560)
+                styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                          NSWindowStyleMaskResizable |
+                          NSWindowStyleMaskMiniaturizable |
+                          NSWindowStyleMaskFullSizeContentView
+                  backing:NSBackingStoreBuffered
+                    defer:NO];
+  self = [super initWithWindow:window];
+  if (!self) {
+    return nil;
+  }
+  keep_alive_ = ScopedProfileKeepAlive::TryAcquire(
+      profile, ProfileKeepAliveOrigin::kArciumSettingsWindow);
+  if (!keep_alive_ || !arcium_settings::LoadSettingsUI()) {
+    return nil;
+  }
+  profile_ = profile;
+  key_ = KeyForProfile(profile);
+  imports_ = [NSMutableArray array];
+  bridge_ = std::make_unique<WelcomeBridge>(self, profile);
+  PrefService* prefs = profile_->GetPrefs();
+  for (const ServicePref& service : kServicePrefs) {
+    staged_services_[service.key] = prefs->GetBoolean(service.pref);
+  }
+  can_set_default_ = shell_integration::CanSetAsDefaultBrowser();
+  detector_ = std::make_unique<arcium::ArcImportCoordinator>(
+      profile_,
+      base::BindRepeating(&WelcomeBridge::ArcChanged, bridge_->GetWeakPtr()));
+
+  window.releasedWhenClosed = NO;
+  window.title = @"Welcome to Arcium";
+  window.titleVisibility = NSWindowTitleHidden;
+  window.titlebarAppearsTransparent = YES;
+  window.titlebarSeparatorStyle = NSTitlebarSeparatorStyleNone;
+  window.restorable = NO;
+  window.delegate = self;
+  window.minSize = NSMakeSize(620, 500);
+
+  Class facade_class = NSClassFromString(@"ArciumWelcomeController");
+  SEL initializer = NSSelectorFromString(kArciumSettingsUIInitializerSelector);
+  if (!facade_class || ![facade_class instancesRespondToSelector:initializer]) {
+    return nil;
+  }
+  using Initializer = id (*)(id, SEL, NSDictionary*, id);
+  id facade = reinterpret_cast<Initializer>(objc_msgSend)(
+      [facade_class alloc], initializer, [self snapshot], self);
+  if (![facade isKindOfClass:[NSViewController class]]) {
+    return nil;
+  }
+  facade_ = facade;
+  window.contentViewController = facade_;
+  [window center];
+
+  detector_->Discover();
+  if (can_set_default_) {
+    default_worker_ = base::MakeRefCounted<shell_integration::DefaultBrowserWorker>();
+    default_worker_->StartCheckIsDefault(base::BindOnce(
+        &WelcomeBridge::DefaultBrowserState, bridge_->GetWeakPtr()));
+  }
+  return self;
+}
+
+- (NSDictionary*)snapshot {
+  PrefService* prefs = profile_ ? profile_->GetPrefs() : nullptr;
+  NSMutableDictionary* services = [NSMutableDictionary dictionary];
+  NSMutableDictionary* managed = [NSMutableDictionary dictionary];
+  for (const ServicePref& service : kServicePrefs) {
+    NSString* key = @(service.key);
+    const PrefService::Preference* pref =
+        prefs ? prefs->FindPreference(service.pref) : nullptr;
+    const bool is_managed = pref && pref->IsManaged();
+    services[key] = @(is_managed ? pref->GetValue()->GetBool()
+                                 : staged_services_[service.key]);
+    managed[key] = @(is_managed);
+  }
+
+  NSMutableArray* managers = [NSMutableArray array];
+  auto* registry = profile_ ? extensions::ExtensionRegistry::Get(profile_)
+                            : nullptr;
+  for (const PasswordManager& manager : kPasswordManagers) {
+    const bool installed =
+        registry && registry->enabled_extensions().Contains(manager.id);
+    [managers addObject:@{
+      @"id" : @(manager.id),
+      @"name" : @(manager.name),
+      @"installed" : @(installed),
+      @"installing" : @(installing_.contains(manager.id)),
+      @"failed" : @(install_failed_.contains(manager.id)),
+    }];
+  }
+
+  NSDictionary* arc = NSDictionaryFromDict(
+      detector_ ? detector_->Snapshot() : base::DictValue());
+  return @{
+    @"arc" : arc,
+    @"imports" : [imports_ copy],
+    @"services" : services,
+    @"servicesManaged" : managed,
+    @"servicesCommitted" : @(services_committed_),
+    @"extensionServiceAvailable" :
+        @(prefs && helium::ShouldAccessExtensionService(*prefs)),
+    @"passwordManagers" : managers,
+    @"defaultBrowser" : @{
+      @"canSet" : @(can_set_default_),
+      @"isDefault" : @(is_default_),
+      @"requested" : @(default_requested_),
+    },
+  };
+}
+
+- (void)publish {
+  if (closed_ || !facade_) {
+    return;
+  }
+  using Update = void (*)(id, SEL, NSDictionary*);
+  reinterpret_cast<Update>(objc_msgSend)(
+      facade_, NSSelectorFromString(kArciumSettingsUIUpdateSnapshotSelector),
+      [self snapshot]);
+}
+
+- (void)jobFinished:(NSDictionary*)job {
+  [imports_ addObject:job];
+  // Refresh Imported badges in the summary without touching the sheet.
+  if (detector_ && detector_->phase() != arcium::ArcImportCoordinator::Phase::kRunning) {
+    detector_->Discover();
+  }
+  [self publish];
+}
+
+- (void)defaultBrowserState:(shell_integration::DefaultWebClientState)state {
+  is_default_ = state == shell_integration::IS_DEFAULT;
+  [self publish];
+}
+
+- (void)installFinished:(const std::string&)extensionID success:(bool)success {
+  installing_.erase(extensionID);
+  if (success) {
+    install_failed_.erase(extensionID);
+  } else {
+    install_failed_.insert(extensionID);
+  }
+  [self publish];
+}
+
+- (void)welcomeActionInvokedWithName:(NSString*)name
+                             payload:(NSDictionary*)payload {
+  if (closed_ || !profile_ || !name.length) {
+    return;
+  }
+  PrefService* prefs = profile_->GetPrefs();
+  if ([name isEqualToString:@"open_arc_import"]) {
+    arcium_import::SheetCallbacks callbacks;
+    callbacks.job_finished = base::BindRepeating(&WelcomeBridge::JobFinished,
+                                                 bridge_->GetWeakPtr());
+    callbacks.closed =
+        base::BindOnce(&WelcomeBridge::SheetClosed, bridge_->GetWeakPtr());
+    arcium_import::ShowArcImportSheet(gfx::NativeWindow(self.window), profile_,
+                                      base::DictValue(), std::move(callbacks));
+  } else if ([name isEqualToString:@"set_service"]) {
+    // Staged only. Nothing reaches prefs until commit_services.
+    NSString* key = [payload[@"key"] isKindOfClass:[NSString class]]
+                        ? payload[@"key"]
+                        : @"";
+    const std::string service = base::SysNSStringToUTF8(key);
+    if (staged_services_.contains(service)) {
+      staged_services_[service] = BoolValue(payload[@"value"]);
+    }
+    [self publish];
+  } else if ([name isEqualToString:@"commit_services"]) {
+    for (const ServicePref& service : kServicePrefs) {
+      const PrefService::Preference* pref = prefs->FindPreference(service.pref);
+      if (pref && pref->IsUserModifiable()) {
+        prefs->SetBoolean(service.pref, staged_services_[service.key]);
+      }
+    }
+    // Pressing Continue on this step is the consent, as in chrome://setup.
+    prefs->SetBoolean(prefs::kHeliumServicesConsented, true);
+    helium::AcceptCurrentSchema(*prefs);
+    services_committed_ = YES;
+    [self publish];
+  } else if ([name isEqualToString:@"install_password_manager"]) {
+    [self installPasswordManager:payload[@"id"]];
+  } else if ([name isEqualToString:@"make_default_browser"]) {
+    if (can_set_default_ && !default_requested_) {
+      default_requested_ = YES;
+      default_worker_ =
+          base::MakeRefCounted<shell_integration::DefaultBrowserWorker>();
+      default_worker_->StartSetAsDefault(base::BindOnce(
+          &WelcomeBridge::DefaultBrowserState, bridge_->GetWeakPtr()));
+      [self publish];
+    }
+  } else if ([name isEqualToString:@"open_search_settings"]) {
+    chrome::ShowSettingsSubPageForProfile(profile_, "search");
+  } else if ([name isEqualToString:@"finish"]) {
+    prefs->SetBoolean(prefs::kHeliumDidOnboarding, true);
+    [self closeWindow];
+  } else if ([name isEqualToString:@"close"]) {
+    [self closeWindow];
+  }
+}
+
+- (void)installPasswordManager:(id)value {
+  if (![value isKindOfClass:[NSString class]]) {
+    return;
+  }
+  const std::string id = base::SysNSStringToUTF8(value);
+  const bool known = std::ranges::any_of(
+      kPasswordManagers, [&](const PasswordManager& m) { return id == m.id; });
+  if (!known || installing_.contains(id) ||
+      !helium::ShouldAccessExtensionService(*profile_->GetPrefs())) {
+    return;
+  }
+  auto* registry = extensions::ExtensionRegistry::Get(profile_);
+  if (registry->GetExtensionById(id,
+                                 extensions::ExtensionRegistry::EVERYTHING)) {
+    extensions::ExtensionRegistrar::Get(profile_)->EnableExtension(id);
+    [self publish];
+    return;
+  }
+  installing_.insert(id);
+  install_failed_.erase(id);
+  // Chrome's install prompt is the user's explicit confirmation.
+  auto installer = base::MakeRefCounted<extensions::WebstoreInstallWithPrompt>(
+      id, profile_, gfx::NativeWindow(self.window),
+      base::BindOnce(&WelcomeBridge::InstallFinished, bridge_->GetWeakPtr(),
+                     id));
+  installer->BeginInstall();
+  [self publish];
+}
+
+- (BOOL)windowShouldClose:(NSWindow*)sender {
+  [self closeWindow];
+  return NO;
+}
+
+- (void)closeWindow {
+  if (closed_) {
+    return;
+  }
+  closed_ = YES;
+  ArciumWelcomeWindowController* __attribute__((objc_precise_lifetime))
+  keep_self = self;
+  // The sheet cancels a running import as it closes. Delivered data stays.
+  arcium_import::CloseForParent(gfx::NativeWindow(self.window));
+  detector_.reset();
+  bridge_.reset();
+  default_worker_ = nullptr;
+  [self.window orderOut:nil];
+  [Windows() removeObjectForKey:key_];
+  keep_alive_.reset();
+  profile_ = nullptr;
+  (void)keep_self;
+}
+
+@end
+
+namespace arcium_welcome {
+
+bool IsAvailable() {
+  NSURL* library = [NSBundle.mainBundle.privateFrameworksURL
+      URLByAppendingPathComponent:@"libArciumSettingsUI.dylib"];
+  return library &&
+         [NSFileManager.defaultManager fileExistsAtPath:library.path];
+}
+
+bool ShowForBrowser(BrowserWindowInterface* browser) {
+  Profile* profile =
+      browser ? browser->GetProfile()->GetOriginalProfile() : nullptr;
+  if (!profile || profile->IsGuestSession()) {
+    return false;
+  }
+  ArciumWelcomeWindowController* controller = Windows()[KeyForProfile(profile)];
+  if (!controller) {
+    controller = [[ArciumWelcomeWindowController alloc] initWithProfile:profile];
+    if (!controller) {
+      return false;
+    }
+    Windows()[KeyForProfile(profile)] = controller;
+  }
+  // Order front after the startup browser window has been shown, so the
+  // first-run window is not covered by it.
+  __weak ArciumWelcomeWindowController* weak_controller = controller;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    [weak_controller showWindow:nil];
+    [weak_controller.window makeKeyAndOrderFront:nil];
+    [NSApp activateIgnoringOtherApps:YES];
+  });
+  return true;
+}
+
+void CloseAllForShutdown() {
+  for (ArciumWelcomeWindowController* controller in [Windows().allValues copy]) {
+    [controller closeWindow];
+  }
+}
+
+}  // namespace arcium_welcome
