+@implementation ArciumWelcomeWindowController {
+  Profile* profile_;
+  NSValue* key_;
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive_;
+  std::unique_ptr<WelcomeBridge> bridge_;
+  // Used only to detect Arc for the summary card. Jobs run in the sheet.
+  std::unique_ptr<arcium::ArcImportCoordinator> detector_;
+  NSViewController* facade_;
+  NSMutableArray<NSDictionary*>* imports_;
+  std::map<std::string, bool> staged_services_;
+  BOOL services_committed_;
+  BOOL can_set_default_;
+  BOOL is_default_;
+  BOOL default_requested_;
+  std::set<std::string> installing_;
+  std::set<std::string> install_failed_;
+  scoped_refptr<shell_integration::DefaultBrowserWorker> default_worker_;
+  BOOL closed_;
+}
