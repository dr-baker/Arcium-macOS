+import AppKit
+import Combine
+import Foundation
+import SettingsUI
+import SettingsUIStyle
+import SwiftUI
+
+@objc public protocol ArciumWelcomeDelegate: AnyObject {
+    @objc(welcomeActionInvokedWithName:payload:)
+    func welcomeActionInvoked(name: String, payload: NSDictionary)
+}
+
+// MARK: - Snapshot
+
+struct ArciumPasswordManagerOption: Equatable, Identifiable {
+    var id = ""
+    var name = ""
+    var installed = false
+    var installing = false
+    var failed = false
+
+    init(_ fields: [String: Any]) {
+        id = fields["id"] as? String ?? ""
+        name = fields["name"] as? String ?? ""
+        installed = fields["installed"] as? Bool ?? false
+        installing = fields["installing"] as? Bool ?? false
+        failed = fields["failed"] as? Bool ?? false
+    }
+}
+
+struct ArciumWelcomeSnapshot: Equatable {
+    var arc = ArciumArcImportSnapshot()
+    var imports: [ArciumArcImportJob] = []
+    var services: [String: Bool] = [:]
+    var servicesManaged: [String: Bool] = [:]
+    var servicesCommitted = false
+    var extensionServiceAvailable = false
+    var passwordManagers: [ArciumPasswordManagerOption] = []
+    var canSetDefault = false
+    var isDefault = false
+    var defaultRequested = false
+
+    init(_ fields: [String: Any] = [:]) {
+        arc = ArciumArcImportSnapshot(fields["arc"] as? [String: Any] ?? [:])
+        imports = (fields["imports"] as? [[String: Any]] ?? []).map(ArciumArcImportJob.init)
+        services = fields["services"] as? [String: Bool] ?? [:]
+        servicesManaged = fields["servicesManaged"] as? [String: Bool] ?? [:]
+        servicesCommitted = fields["servicesCommitted"] as? Bool ?? false
+        extensionServiceAvailable = fields["extensionServiceAvailable"] as? Bool ?? false
+        passwordManagers = (fields["passwordManagers"] as? [[String: Any]] ?? []).map(ArciumPasswordManagerOption.init)
+        let browser = fields["defaultBrowser"] as? [String: Any] ?? [:]
+        canSetDefault = browser["canSet"] as? Bool ?? false
+        isDefault = browser["isDefault"] as? Bool ?? false
+        defaultRequested = browser["requested"] as? Bool ?? false
+    }
+
+    var arcProfileCount: Int { arc.sources.count }
+    var succeededImports: [ArciumArcImportJob] { imports.filter { $0.outcome == .succeeded } }
+}
+
+enum ArciumWelcomeStep: String, CaseIterable, Identifiable {
+    case welcome, arc, services, passwords, defaultBrowser, done
+    var id: String { rawValue }
+
+    var title: String {
+        switch self {
+        case .welcome: "Welcome"
+        case .arc: "Arc"
+        case .services: "Services"
+        case .passwords: "Password manager"
+        case .defaultBrowser: "Default browser"
+        case .done: "Done"
+        }
+    }
+}
+
+// MARK: - Store
+
+@MainActor
+final class ArciumWelcomeStore: ObservableObject {
+    @Published private(set) var snapshot: ArciumWelcomeSnapshot
+    @Published private(set) var step = ArciumWelcomeStep.welcome
+    weak var delegate: ArciumWelcomeDelegate?
+    let preset: SettingsStylePreset?
+
+    init(snapshot: NSDictionary, delegate: ArciumWelcomeDelegate?, preset: SettingsStylePreset? = nil) {
+        self.delegate = delegate
+        self.preset = preset
+        self.snapshot = ArciumWelcomeSnapshot(snapshot as? [String: Any] ?? [:])
+    }
+
+    func updateSnapshot(_ dictionary: NSDictionary) {
+        snapshot = ArciumWelcomeSnapshot(dictionary as? [String: Any] ?? [:])
+        if !steps.contains(step), let currentIndex = ArciumWelcomeStep.allCases.firstIndex(of: step) {
+            step = ArciumWelcomeStep.allCases.dropFirst(currentIndex).first { steps.contains($0) } ?? .done
+        }
+    }
+
+    /// Optional steps follow the same rules as chrome://setup.
+    var steps: [ArciumWelcomeStep] {
+        ArciumWelcomeStep.allCases.filter { step in
+            switch step {
+            case .passwords:
+                return service("enabled") && service("ext_proxy")
+            case .defaultBrowser:
+                return snapshot.canSetDefault && (!snapshot.isDefault || snapshot.defaultRequested)
+            default:
+                return true
+            }
+        }
+    }
+
+    var stepIndex: Int { steps.firstIndex(of: step) ?? 0 }
+
+    func service(_ key: String) -> Bool { snapshot.services[key] ?? false }
+    func serviceManaged(_ key: String) -> Bool { snapshot.servicesManaged[key] ?? false }
+
+    func setService(_ key: String, _ value: Bool) {
+        guard !serviceManaged(key) else { return }
+        send("set_service", ["key": key, "value": value])
+    }
+
+    /// Moves forward. Leaving the services step is the consent boundary.
+    func next() {
+        if step == .services { send("commit_services") }
+        if step == .done { return finish() }
+        let all = steps
+        if let index = all.firstIndex(of: step), index + 1 < all.count {
+            step = all[index + 1]
+        }
+    }
+
+    func back() {
+        let all = steps
+        if let index = all.firstIndex(of: step), index > 0 { step = all[index - 1] }
+    }
+
+    func openArcImport() { send("open_arc_import") }
+    func install(_ manager: ArciumPasswordManagerOption) { send("install_password_manager", ["id": manager.id]) }
+    func openSearchSettings() { send("open_search_settings") }
+
+    func makeDefault() {
+        send("make_default_browser")
+        next()
+    }
+
+    /// The only action that writes helium.completed_onboarding.
+    func finish() {
+        guard step == .done else { return }
+        send("finish")
+    }
+
+    private func send(_ name: String, _ payload: [String: Any] = [:]) {
+        delegate?.welcomeActionInvoked(name: name, payload: payload as NSDictionary)
+    }
+}
+
+// MARK: - Views
+
+struct ArciumWelcomeView: View {
+    @ObservedObject var store: ArciumWelcomeStore
+
+    var body: some View {
+        ArciumPresetSurface(preset: store.preset) {
+            ArciumWelcomeBody(store: store)
+        }
+    }
+}
