+private struct ArciumWelcomeDoneStep: View {
+    @ObservedObject var store: ArciumWelcomeStore
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.md) {
+            ArciumWelcomeHeader(title: "You're set", subtitle: nil)
+            ForEach(store.snapshot.succeededImports) { job in
+                ArciumImportJobRow(job: job)
