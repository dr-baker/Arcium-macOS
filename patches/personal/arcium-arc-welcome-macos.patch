--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_arc_import_sheet_controller.mm
@@ -0,0 +1,387 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/cocoa/arcium_arc_import_sheet_controller.h"
+
+#import <AppKit/AppKit.h>
+#include <objc/message.h>
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/importer/arcium_arc_import_coordinator.h"
+#include "chrome/browser/profiles/keep_alive/profile_keep_alive_types.h"
+#include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "chrome/browser/ui/chrome_pages.h"
+#import "chrome/browser/ui/cocoa/arcium_settings_window_controller.h"
+#import "chrome/browser/ui/cocoa/arcium_settingsui_bridge.h"
+#include "chrome/browser/ui/helium/helium_space.h"
+#include "chrome/browser/ui/helium/helium_space_service.h"
+#include "chrome/browser/ui/helium/helium_space_service_factory.h"
+
+@class ArciumArcImportSheetController;
+
+namespace {
+
+using Coordinator = arcium::ArcImportCoordinator;
+
+NSDictionary* NSDictionaryFromDict(const base::DictValue& dict) {
+  std::string json;
+  if (!base::JSONWriter::Write(dict, &json)) {
+    return @{};
+  }
+  NSData* data = [NSData dataWithBytes:json.data() length:json.size()];
+  id object = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+  return [object isKindOfClass:[NSDictionary class]] ? object : @{};
+}
+
+NSMutableDictionary<NSValue*, ArciumArcImportSheetController*>* Sheets() {
+  static NSMutableDictionary* sheets = [NSMutableDictionary dictionary];
+  return sheets;
+}
+
+NSValue* KeyForProfile(Profile* profile) {
+  return [NSValue valueWithPointer:profile];
+}
+
+}  // namespace
+
+// Routes coordinator callbacks to the controller only while both are alive.
+class ArcImportSheetBridge : public ProfileObserver {
+ public:
+  ArcImportSheetBridge(ArciumArcImportSheetController* controller, Profile* profile)
+      : controller_(controller) {
+    profile_observation_.Observe(profile);
+  }
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+  void CoordinatorChanged();
+  base::WeakPtr<ArcImportSheetBridge> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  __weak ArciumArcImportSheetController* controller_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::WeakPtrFactory<ArcImportSheetBridge> weak_factory_{this};
+};
+
+@interface ArciumArcImportSheetController
+    : NSWindowController <NSWindowDelegate, ArciumArcImportDelegate>
+- (instancetype)initWithParent:(NSWindow*)parent
+                       profile:(Profile*)profile
+                       palette:(NSDictionary*)palette
+                     callbacks:(arcium_import::SheetCallbacks)callbacks;
+- (void)coordinatorChanged;
+- (void)focus;
+- (void)closeSheet;
+@end
+
+void ArcImportSheetBridge::OnProfileWillBeDestroyed(Profile* profile) {
+  profile_observation_.Reset();
+  // Closing invalidates this bridge. Retain the controller while it tears down
+  // its profile references, and do not access bridge members afterwards.
+  ArciumArcImportSheetController* __attribute__((objc_precise_lifetime)) controller =
+      controller_;
+  [controller closeSheet];
+}
+
+void ArcImportSheetBridge::CoordinatorChanged() {
+  [controller_ coordinatorChanged];
+}
+
+@implementation ArciumArcImportSheetController {
+  Profile* profile_;
+  NSValue* key_;
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive_;
+  std::unique_ptr<ArcImportSheetBridge> bridge_;
+  std::unique_ptr<Coordinator> coordinator_;
+  arcium_import::SheetCallbacks callbacks_;
+  NSViewController* facade_;
+  NSDictionary* palette_;
+  NSString* start_error_;
+  size_t reported_jobs_;
+  BOOL closed_;
+}
+
+- (instancetype)initWithParent:(NSWindow*)parent
+                       profile:(Profile*)profile
+                       palette:(NSDictionary*)palette
+                     callbacks:(arcium_import::SheetCallbacks)callbacks {
+  NSWindow* window = [[NSWindow alloc]
+      initWithContentRect:NSMakeRect(0, 0, 560, 600)
+                styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                          NSWindowStyleMaskResizable |
+                          NSWindowStyleMaskFullSizeContentView
+                  backing:NSBackingStoreBuffered
+                    defer:NO];
+  self = [super initWithWindow:window];
+  if (!self) {
+    return nil;
+  }
+  keep_alive_ = ScopedProfileKeepAlive::TryAcquire(
+      profile, ProfileKeepAliveOrigin::kArciumSettingsWindow);
+  if (!keep_alive_ || !arcium_settings::LoadSettingsUI()) {
+    return nil;
+  }
+  profile_ = profile;
+  key_ = KeyForProfile(profile);
+  palette_ = palette;
+  callbacks_ = std::move(callbacks);
+  bridge_ = std::make_unique<ArcImportSheetBridge>(self, profile);
+  coordinator_ = std::make_unique<Coordinator>(
+      profile, base::BindRepeating(&ArcImportSheetBridge::CoordinatorChanged,
+                                   bridge_->GetWeakPtr()));
+  coordinator_->set_parent_window(gfx::NativeWindow(window));
+
+  window.releasedWhenClosed = NO;
+  window.title = @"Import from Arc";
+  window.titleVisibility = NSWindowTitleHidden;
+  window.titlebarAppearsTransparent = YES;
+  window.delegate = self;
+  window.minSize = NSMakeSize(500, 480);
+  window.appearance = parent.appearance;
+
+  Class facade_class = NSClassFromString(@"ArciumArcImportController");
+  SEL initializer = NSSelectorFromString(kArciumSettingsUIInitializerSelector);
+  if (!facade_class || ![facade_class instancesRespondToSelector:initializer]) {
+    return nil;
+  }
+  using Initializer = id (*)(id, SEL, NSDictionary*, id);
+  id facade = reinterpret_cast<Initializer>(objc_msgSend)(
+      [facade_class alloc], initializer, [self snapshot], self);
+  if (![facade isKindOfClass:[NSViewController class]]) {
+    return nil;
+  }
+  facade_ = facade;
+  window.contentViewController = facade_;
+  Sheets()[key_] = self;
+  coordinator_->Discover();
+  [parent beginSheet:window completionHandler:nil];
+  [window makeKeyWindow];
+  return self;
+}
+
+- (NSDictionary*)snapshot {
+  NSMutableDictionary* snapshot = [NSDictionaryFromDict(
+      coordinator_ ? coordinator_->Snapshot() : base::DictValue())
+      mutableCopy];
+  if (palette_.count) {
+    snapshot[@"spacePalette"] = palette_;
+  }
+  if (start_error_) {
+    snapshot[@"startError"] = start_error_;
+  }
+  return snapshot;
+}
+
+- (void)publish {
+  if (closed_ || !facade_) {
+    return;
+  }
+  using Update = void (*)(id, SEL, NSDictionary*);
+  reinterpret_cast<Update>(objc_msgSend)(
+      facade_, NSSelectorFromString(kArciumSettingsUIUpdateSnapshotSelector),
+      [self snapshot]);
+}
+
+- (void)coordinatorChanged {
+  if (closed_ || !coordinator_) {
+    return;
+  }
+  ArciumArcImportSheetController* __attribute__((objc_precise_lifetime))
+      keep_self = self;
+  [self publish];
+  // Copy before callbacks: publishing or job_finished can close the sheet
+  // and destroy its coordinator.
+  if (closed_ || !coordinator_) {
+    return;
+  }
+  const auto finished = coordinator_->finished_jobs();
+  while (reported_jobs_ < finished.size()) {
+    const base::DictValue job = Coordinator::JobToDict(finished[reported_jobs_]);
+    ++reported_jobs_;
+    if (callbacks_.job_finished) {
+      // Copy: the opener may close this sheet from the callback.
+      auto job_finished = callbacks_.job_finished;
+      job_finished.Run(job);
+      if (closed_) {
+        return;
+      }
+    }
+  }
+  (void)keep_self;
+}
+
+- (void)arcImportActionInvokedWithName:(NSString*)name
+                               payload:(NSDictionary*)payload {
+  if (closed_ || !coordinator_ || !name.length) {
+    return;
+  }
+  if ([name isEqualToString:@"start"]) {
+    NSString* token = [payload[@"token"] isKindOfClass:[NSString class]]
+                          ? payload[@"token"]
+                          : @"";
+    const bool sidebar = [payload[@"sidebar"] respondsToSelector:@selector(boolValue)] &&
+                         [payload[@"sidebar"] boolValue];
+    const bool history = [payload[@"history"] respondsToSelector:@selector(boolValue)] &&
+                         [payload[@"history"] boolValue];
+    const Coordinator::Failure failure = coordinator_->Start(
+        base::SysNSStringToUTF8(token), sidebar, history);
+    start_error_ = failure == Coordinator::Failure::kNone
+                       ? nil
+                       : @(Coordinator::FailureToString(failure));
+    if (failure == Coordinator::Failure::kSourceChanged) {
+      coordinator_->Discover();
+    }
+    [self publish];
+  } else if ([name isEqualToString:@"cancel"]) {
+    coordinator_->Cancel();
+  } else if ([name isEqualToString:@"reset"]) {
+    start_error_ = nil;
+    coordinator_->Reset();
+  } else if ([name isEqualToString:@"rediscover"]) {
+    start_error_ = nil;
+    coordinator_->Discover();
+  } else if ([name isEqualToString:@"open_space"]) {
+    [self openSpaceForJob:payload[@"jobID"]];
+  } else if ([name isEqualToString:@"other_browsers"]) {
+    if (coordinator_->phase() != Coordinator::Phase::kRunning) {
+      ArciumArcImportSheetController* __attribute__((objc_precise_lifetime))
+          keep_self = self;
+      if (Profile* profile = coordinator_->destination()) {
+        chrome::ShowSettingsSubPageForProfile(profile, "importData");
+      }
+      [self closeSheet];
+      (void)keep_self;
+    }
+  } else if ([name isEqualToString:@"close"]) {
+    // A running job ends only through Stop import.
+    if (coordinator_->phase() != Coordinator::Phase::kRunning) {
+      [self closeSheet];
+    }
+  }
+}
+
+- (void)openSpaceForJob:(id)jobID {
+  if (![jobID respondsToSelector:@selector(intValue)] || !coordinator_->destination()) {
+    return;
+  }
+  const int id = [jobID intValue];
+  for (const Coordinator::Job& job : coordinator_->finished_jobs()) {
+    if (job.id != id || job.first_space_id.empty()) {
+      continue;
+    }
+    auto* service = helium::HeliumSpaceServiceFactory::GetForProfile(
+        coordinator_->destination());
+    helium::HeliumSpace* space =
+        service ? service->GetSpaceById(job.first_space_id) : nullptr;
+    if (!space) {
+      return;
+    }
+    ArciumArcImportSheetController* __attribute__((objc_precise_lifetime))
+        keep_self = self;
+    // Activation may reenter window handling. Use the Space while this sheet
+    // still owns the destination keepalive, before close callbacks can tear it
+    // down. Do not access the Space after activation.
+    space->ActivateOrCreatePrimaryWindow();
+    [self closeSheet];
+    (void)keep_self;
+    return;
+  }
+}
+
+- (BOOL)windowShouldClose:(NSWindow*)sender {
+  if (coordinator_ && coordinator_->phase() != Coordinator::Phase::kRunning) {
+    [self closeSheet];
+  }
+  return NO;
+}
+
+- (void)focus {
+  [self.window makeKeyAndOrderFront:nil];
+}
+
+- (void)closeSheet {
+  if (closed_) {
+    return;
+  }
+  closed_ = YES;
+  ArciumArcImportSheetController* __attribute__((objc_precise_lifetime))
+  keep_self = self;
+  // Destroying the coordinator detaches its observer, then cancels a running
+  // host. Delivered data stays; no rollback is attempted.
+  coordinator_.reset();
+  bridge_.reset();
+  [self.window.sheetParent endSheet:self.window];
+  [self.window orderOut:nil];
+  [Sheets() removeObjectForKey:key_];
+  keep_alive_.reset();
+  profile_ = nullptr;
+  callbacks_.job_finished.Reset();
+  if (callbacks_.closed) {
+    std::move(callbacks_.closed).Run();
+  }
+  (void)keep_self;
+}
+
+@end
+
+namespace arcium_import {
+
+SheetCallbacks::SheetCallbacks() = default;
+SheetCallbacks::SheetCallbacks(SheetCallbacks&&) = default;
+SheetCallbacks& SheetCallbacks::operator=(SheetCallbacks&&) = default;
+SheetCallbacks::~SheetCallbacks() = default;
+
+bool ShowArcImportSheet(gfx::NativeWindow parent,
+                        Profile* profile,
+                        base::DictValue space_palette,
+                        SheetCallbacks callbacks) {
+  Profile* original = profile ? profile->GetOriginalProfile() : nullptr;
+  NSWindow* parent_window = parent.GetNativeNSWindow();
+  if (!original || original->IsGuestSession() || !parent_window) {
+    return false;
+  }
+  if (ArciumArcImportSheetController* existing =
+          Sheets()[KeyForProfile(original)]) {
+    [existing focus];
+    return true;
+  }
+  if (parent_window.attachedSheet) {
+    return false;
+  }
+  return [[ArciumArcImportSheetController alloc]
+             initWithParent:parent_window
+                    profile:original
+                    palette:NSDictionaryFromDict(space_palette)
+                  callbacks:std::move(callbacks)] != nil;
+}
+
+void CloseForParent(gfx::NativeWindow parent) {
+  NSWindow* parent_window = parent.GetNativeNSWindow();
+  if (!parent_window) {
+    return;
+  }
+  for (ArciumArcImportSheetController* sheet in [Sheets().allValues copy]) {
+    if (sheet.window.sheetParent == parent_window) {
+      [sheet closeSheet];
+    }
+  }
+}
+
+void CloseAllForShutdown() {
+  for (ArciumArcImportSheetController* sheet in [Sheets().allValues copy]) {
+    [sheet closeSheet];
+  }
+}
+
+}  // namespace arcium_import
