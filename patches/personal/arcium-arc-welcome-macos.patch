+    func testFailureAfterAnyCategoryStartedNeverClaimsNoChange() {
+        for failure in ["sidebar_unreadable", "sidebar_not_saved", "history_incomplete", "destination_closed"] {
+            let body = ArciumArcImportCopy.body(ArciumArcImportJob(job("failed", failure: failure, partial: true))) ?? ""
+            XCTAssertTrue(body.contains(ArciumArcImportCopy.mayHaveAdded), failure)
+            XCTAssertFalse(body.lowercased().contains("nothing"), failure)
