+        store.otherBrowsers()
+        store.select("g1-1")
+        XCTAssertEqual(store.selectedToken, "g1-0")
+        store.cancel()
+        XCTAssertEqual(recorder.names, ["cancel"])
+        XCTAssertEqual(ArciumArcImportCopy.runningLabel(store.snapshot.job!), "Importing Spaces and Pins…")
+    }
