+            Text("Arc isn't on this Mac")
+                .settingsFont(\.cardTitle)
+            Text("Arcium looks for Arc's profiles in your user Library.")
+                .foregroundStyle(theme.textSecondary)
+            Button("Look again") { store.rediscover() }
