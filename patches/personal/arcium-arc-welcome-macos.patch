+            if store.snapshot.defaultRequested || store.snapshot.isDefault {
+                summary("Default browser", store.snapshot.isDefault ? "Arcium" : "Requested")
+            }
+            HStack(spacing: SettingsSpacing.sm) {
+                Button("Choose search engine…") { store.openSearchSettings() }
+                    .buttonStyle(.settings(.quiet))
+            }
+            .padding(.top, SettingsSpacing.xs)
+        }
+    }
+
+    private func summary(_ title: String, _ value: String) -> some View {
+        HStack {
+            Text(title)
+            Spacer()
+            Text(value).foregroundStyle(theme.textSecondary)
+        }
+        .accessibilityElement(children: .combine)
