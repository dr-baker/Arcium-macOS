+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_COCOA_ARCIUM_ARC_IMPORT_SHEET_CONTROLLER_H_
+#define CHROME_BROWSER_UI_COCOA_ARCIUM_ARC_IMPORT_SHEET_CONTROLLER_H_
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "ui/gfx/native_ui_types.h"
+
+class Profile;
+
+namespace arcium_import {
+
+struct SheetCallbacks {
+  SheetCallbacks();
+  SheetCallbacks(SheetCallbacks&&);
+  SheetCallbacks& operator=(SheetCallbacks&&);
+  ~SheetCallbacks();
+
+  // Runs once per finished job with ArcImportCoordinator::JobToDict().
+  base::RepeatingCallback<void(const base::DictValue& job)> job_finished;
+  // Runs once when the sheet closes for any reason.
+  base::OnceClosure closed;
+};
+
+// Attaches the Import from Arc sheet to `parent` for `profile`'s original
+// profile, which is always the destination. Focuses an existing sheet for the
+// same profile instead of opening a second one. `space_palette` is the
+// Settings palette dictionary, or empty for the bundled preset. Returns false
+// when the SettingsUI module or the profile is unavailable.
+bool ShowArcImportSheet(gfx::NativeWindow parent,
+                        Profile* profile,
+                        base::DictValue space_palette,
+                        SheetCallbacks callbacks);
+
+// Closes only the sheet attached to this window, cancelling its running job.
+// Already imported data stays in the profile.
+void CloseForParent(gfx::NativeWindow parent);
+
+// Called before profile and keyed-service shutdown begins.
+void CloseAllForShutdown();
+
+}  // namespace arcium_import
+
+#endif  // CHROME_BROWSER_UI_COCOA_ARCIUM_ARC_IMPORT_SHEET_CONTROLLER_H_
