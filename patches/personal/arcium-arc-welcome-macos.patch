+private struct ArciumArcSourceRow: View {
+    let source: ArciumArcImportSource
+    let isSelected: Bool
+    let select: () -> Void
+    @Environment(\.settingsTheme) private var theme
+    @State private var hovered = false
+
+    var body: some View {
+        Button(action: select) {
+            HStack(spacing: SettingsSpacing.sm) {
+                Image(systemName: isSelected ? "largecircle.fill.circle" : "circle")
+                    .foregroundStyle(isSelected ? theme.accent : theme.textTertiary)
+                    .accessibilityHidden(true)
+                ArciumProfileBadge(title: source.title)
+                VStack(alignment: .leading, spacing: 1) {
+                    Text(source.title).settingsFont(\.label)
+                    if !source.detail.isEmpty || !source.canImportSidebar {
+                        Text(subtitle)
+                            .settingsFont(\.caption)
+                            .foregroundStyle(theme.textSecondary)
+                    }
+                }
+                Spacer(minLength: 0)
+                if source.previouslyImported {
+                    Text("Imported")
+                        .settingsFont(\.caption)
+                        .foregroundStyle(theme.textSecondary)
+                        .padding(.horizontal, SettingsSpacing.xs)
+                        .padding(.vertical, 2)
+                        .background(theme.insetFill, in: Capsule())
+                }
+            }
+            .padding(.horizontal, SettingsSpacing.sm)
+            .padding(.vertical, SettingsSpacing.xs)
+            .contentShape(.rect)
+            .background {
+                RoundedRectangle(cornerRadius: SettingsRadius.row, style: .continuous)
+                    .fill(isSelected ? theme.accent.opacity(0.12) : (hovered ? theme.hoverFill : .clear))
+            }
+        }
+        .buttonStyle(.plain)
+        .disabled(!source.isSelectable)
+        .opacity(source.isSelectable ? 1 : SettingsEffects.disabledOpacity)
+        .onHover { hovered = $0 && source.isSelectable }
+        .accessibilityLabel([source.title, source.detail, source.previouslyImported ? "Imported" : ""]
+            .filter { !$0.isEmpty }.joined(separator: ", "))
+        .accessibilityAddTraits(isSelected ? [.isSelected] : [])
+    }
+
+    private var subtitle: String {
+        let detail = source.detail
+        guard !source.canImportSidebar else { return detail }
+        return detail.isEmpty ? "No saved sidebar" : "\(detail) · No saved sidebar"
+    }
+}
