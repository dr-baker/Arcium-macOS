+@MainActor
+final class ArciumWelcomeTests: XCTestCase {
+    private func welcome(services: [String: Bool] = ["enabled": true, "ext_proxy": true],
+                         canSetDefault: Bool = true, isDefault: Bool = false) -> NSDictionary {
+        let arc: [String: Any] = ["phase": "ready", "sources": [source("g1-0", "Work")]]
+        let browser: [String: Any] = ["canSet": canSetDefault, "isDefault": isDefault, "requested": false]
+        let fields: [String: Any] = [
+            "arc": arc, "imports": [[String: Any]](), "services": services,
+            "servicesManaged": [String: Bool](), "servicesCommitted": false,
+            "extensionServiceAvailable": false, "passwordManagers": [[String: Any]](),
+            "defaultBrowser": browser,
+        ]
+        return fields as NSDictionary
+    }
+
+    func testOptionalStepsFollowSetupRules() {
+        let store = ArciumWelcomeStore(snapshot: welcome(), delegate: nil)
+        XCTAssertEqual(store.steps, [.welcome, .arc, .services, .passwords, .defaultBrowser, .done])
+        store.updateSnapshot(welcome(services: ["enabled": false, "ext_proxy": true], isDefault: true))
+        XCTAssertEqual(store.steps, [.welcome, .arc, .services, .done])
+    }
+
+    func testServicesAreStagedUntilContinueAndFinishOnlyOnLastStep() {
+        let recorder = ImportRecorder()
+        let store = ArciumWelcomeStore(snapshot: welcome(services: ["enabled": false], canSetDefault: false),
+                                       delegate: recorder)
+        store.finish()
+        XCTAssertTrue(recorder.actions.isEmpty)
+        store.next()  // welcome -> arc
+        store.next()  // arc -> services
+        store.setService("bangs", true)
+        XCTAssertEqual(recorder.names, ["set_service"])
+        store.next()  // services -> done (no optional steps)
+        XCTAssertEqual(recorder.names, ["set_service", "commit_services"])
+        XCTAssertEqual(store.step, .done)
+        store.finish()
+        XCTAssertEqual(recorder.names.last, "finish")
+        XCTAssertEqual(recorder.names.filter { $0 == "finish" }.count, 1)
+    }
+
+    func testManagedServiceCannotBeStaged() {
+        let recorder = ImportRecorder()
+        let fields = NSMutableDictionary(dictionary: welcome())
+        fields["servicesManaged"] = ["enabled": true] as [String: Bool]
+        let store = ArciumWelcomeStore(snapshot: fields, delegate: recorder)
+        store.setService("enabled", false)
+        XCTAssertTrue(recorder.actions.isEmpty)
+    }
+
+    func testOptionalStepDisappearingKeepsNavigationUsable() {
+        let store = ArciumWelcomeStore(snapshot: welcome(), delegate: nil)
+        while store.step != .passwords { store.next() }
+        store.updateSnapshot(welcome(services: ["enabled": false]))
+        XCTAssertEqual(store.step, .defaultBrowser)
+        store.next()
+        XCTAssertEqual(store.step, .done)
+    }
+
+    func testDefaultBrowserIsRequestedOnlyByExplicitButton() {
+        let recorder = ImportRecorder()
+        let store = ArciumWelcomeStore(snapshot: welcome(services: ["enabled": false]), delegate: recorder)
+        while store.step != .defaultBrowser { store.next() }
+        XCTAssertFalse(recorder.names.contains("make_default_browser"))
+        store.next()  // Not now
+        XCTAssertEqual(store.step, .done)
+        XCTAssertFalse(recorder.names.contains("make_default_browser"))
+    }
+}
