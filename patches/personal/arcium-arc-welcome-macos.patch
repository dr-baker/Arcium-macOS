+// MARK: - Hosting
+
+@MainActor
+@objc(ArciumArcImportController)
+public final class ArciumArcImportController: NSHostingController<AnyView> {
+    private let store: ArciumArcImportStore
+
+    @objc(initWithSnapshot:delegate:)
+    public init(snapshot: NSDictionary, delegate: ArciumArcImportDelegate) {
+        let store = ArciumArcImportStore(snapshot: snapshot, delegate: delegate,
+                                         preset: loadArciumPackagedPreset())
+        self.store = store
+        super.init(rootView: AnyView(ArciumArcImportView(store: store)))
+    }
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+        fatalError("Import from Arc does not support storyboards")
+    }
+
+    @objc(updateSnapshot:)
+    public func updateSnapshot(_ snapshot: NSDictionary) {
+        store.updateSnapshot(snapshot)
