+}
+
+private struct ArciumArcImportSelection: View {
+    @ObservedObject var store: ArciumArcImportStore
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.lg) {
+            if let error = store.snapshot.startError {
+                SNoticeBanner(ArciumArcImportCopy.startError(error), tone: .warning)
+            }
+
+            VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+                sectionLabel("From Arc")
+                VStack(spacing: 2) {
+                    ForEach(store.snapshot.sources) { source in
+                        ArciumArcSourceRow(source: source,
+                                           isSelected: store.selectedToken == source.token) {
+                            store.select(source.token)
+                        }
+                    }
+                }
+                .accessibilityElement(children: .contain)
+                .accessibilityLabel("Arc profiles")
+            }
+
+            VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+                sectionLabel("Into Arcium")
+                HStack(spacing: SettingsSpacing.sm) {
+                    ArciumProfileBadge(title: store.snapshot.destinationName, emphasized: true)
+                    Text(store.snapshot.destinationName).settingsFont(\.label)
+                    Text("this profile").foregroundStyle(theme.textSecondary)
+                    Spacer()
+                }
+                .padding(.horizontal, SettingsSpacing.sm)
+                .padding(.vertical, SettingsSpacing.xs)
+                .background(theme.insetFill, in: RoundedRectangle(cornerRadius: SettingsRadius.row, style: .continuous))
+                .accessibilityElement(children: .combine)
+                .accessibilityLabel("Destination: \(store.snapshot.destinationName), this Arcium profile")
+
+                let shared = store.snapshot.sharedProfileTitles(excluding: store.selectedToken)
+                if store.selectedToken != nil, !shared.isEmpty {
+                    SNoticeBanner(
+                        "\(store.snapshot.destinationName) already has Spaces from \(ListFormatter.localizedString(byJoining: shared)).",
+                        message: "Both will share this profile's sign-ins.",
+                        tone: .info)
+                }
+            }
+
+            VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+                SToggle("Spaces, Pins, and Favorites", isOn: $store.includeSidebar,
+                        description: store.isRefresh ? ArciumArcImportCopy.refreshCaption : "Folders and order included.")
+                    .disabled(!store.sidebarAvailable || store.selectedToken == nil)
+                SToggle("History", isOn: $store.includeHistory,
+                        description: store.includeHistory ? ArciumArcImportCopy.historyCaption : nil)
+                    .disabled(!store.historyAvailable || store.selectedToken == nil)
+                Label(ArciumArcImportCopy.footnote, systemImage: "lock")
+                    .settingsFont(\.caption)
+                    .foregroundStyle(theme.textSecondary)
+                    .padding(.top, SettingsSpacing.xxs)
+            }
+        }
+    }
+
+    private func sectionLabel(_ text: String) -> some View {
+        Text(text.uppercased())
+            .settingsFont(\.overline)
+            .foregroundStyle(theme.textSecondary)
+            .accessibilityAddTraits(.isHeader)
+    }
+}
