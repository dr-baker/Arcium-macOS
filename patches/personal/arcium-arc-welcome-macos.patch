+@MainActor
+@objc(ArciumWelcomeController)
+public final class ArciumWelcomeController: NSHostingController<AnyView> {
+    private let store: ArciumWelcomeStore
+
+    @objc(initWithSnapshot:delegate:)
+    public init(snapshot: NSDictionary, delegate: ArciumWelcomeDelegate) {
+        let store = ArciumWelcomeStore(snapshot: snapshot, delegate: delegate,
