+private struct ArciumWelcomeBody: View {
+    @ObservedObject var store: ArciumWelcomeStore
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    var body: some View {
+        VStack(spacing: 0) {
+            ArciumStepDots(steps: store.steps, current: store.step)
+                .padding(.top, 20)
+
+            ScrollView {
+                page
+                    .frame(maxWidth: 520, alignment: .leading)
+                    .frame(maxWidth: .infinity)
+                    .padding(.horizontal, 40)
+                    .padding(.vertical, 28)
+                    .id(store.step)
+                    .transition(reduceMotion ? .opacity : .asymmetric(
+                        insertion: .opacity.combined(with: .offset(x: 16)),
+                        removal: .opacity))
+            }
+            .animation(reduceMotion ? nil : .smooth(duration: 0.24), value: store.step)
+
+            footer
+                .padding(.horizontal, SettingsSpacing.xl)
+                .padding(.vertical, SettingsSpacing.md)
+        }
+        .settingsSheetSurface()
+        .frame(minWidth: 620, idealWidth: 720, minHeight: 500, idealHeight: 560)
+    }
+
+    @ViewBuilder private var page: some View {
+        switch store.step {
+        case .welcome: ArciumWelcomeIntro()
+        case .arc: ArciumWelcomeArcStep(store: store)
+        case .services: ArciumWelcomeServicesStep(store: store)
+        case .passwords: ArciumWelcomePasswordStep(store: store)
+        case .defaultBrowser: ArciumWelcomeDefaultBrowserStep()
+        case .done: ArciumWelcomeDoneStep(store: store)
+        }
+    }
+
+    @ViewBuilder private var footer: some View {
+        HStack(spacing: SettingsSpacing.xs) {
+            if store.stepIndex > 0 {
+                Button("Back") { store.back() }
+                    .buttonStyle(.settings(.quiet))
+            }
+            Spacer()
+            switch store.step {
+            case .welcome:
+                Button("Get started") { store.next() }
+                    .buttonStyle(.settings(.primary))
+                    .keyboardShortcut(.defaultAction)
+            case .arc:
+                if store.snapshot.imports.isEmpty, store.snapshot.arcProfileCount > 0 {
+                    Button("Skip") { store.next() }.buttonStyle(.settings(.secondary))
+                    Button("Import from Arc…") { store.openArcImport() }
+                        .buttonStyle(.settings(.primary))
+                        .keyboardShortcut(.defaultAction)
+                } else {
+                    Button("Continue") { store.next() }
+                        .buttonStyle(.settings(.primary))
+                        .keyboardShortcut(.defaultAction)
+                }
+            case .passwords:
+                Button("Continue") { store.next() }
+                    .buttonStyle(.settings(.primary))
+                    .keyboardShortcut(.defaultAction)
+            case .services:
+                Button("Continue") { store.next() }
+                    .buttonStyle(.settings(.primary))
+                    .keyboardShortcut(.defaultAction)
+                    .accessibilityHint("Saves these choices and allows the services you left on.")
+            case .defaultBrowser:
+                Button("Not now") { store.next() }.buttonStyle(.settings(.secondary))
+                Button("Make Arcium default") { store.makeDefault() }
+                    .buttonStyle(.settings(.primary))
+                    .keyboardShortcut(.defaultAction)
+            case .done:
+                Button("Start browsing") { store.finish() }
+                    .buttonStyle(.settings(.primary))
+                    .keyboardShortcut(.defaultAction)
+            }
+        }
+    }
+}
