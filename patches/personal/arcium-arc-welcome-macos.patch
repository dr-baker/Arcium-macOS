Index: src/chrome/browser/ui/cocoa/arcium_settings_swift/Sources/ArciumSettingsUI/ArciumArcImport.swift
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_settings_swift/Sources/ArciumSettingsUI/ArciumArcImport.swift
@@ -0,0 +1,781 @@
+import AppKit
+import Combine
+import Foundation
+import SettingsUI
+import SettingsUIStyle
+import SwiftUI
+
+@objc public protocol ArciumArcImportDelegate: AnyObject {
+    @objc(arcImportActionInvokedWithName:payload:)
+    func arcImportActionInvoked(name: String, payload: NSDictionary)
+}
+
+// MARK: - Snapshot
+
+struct ArciumArcImportSource: Equatable, Identifiable {
+    var token = ""
+    var title = ""
+    var detail = ""
+    var canImportSidebar = false
+    var canImportHistory = false
+    var previouslyImported = false
+    var id: String { token }
+    var isSelectable: Bool { canImportSidebar || canImportHistory }
+
+    init(_ fields: [String: Any]) {
+        token = fields["token"] as? String ?? ""
+        title = fields["title"] as? String ?? ""
+        detail = fields["detail"] as? String ?? ""
+        canImportSidebar = fields["canImportSidebar"] as? Bool ?? false
+        canImportHistory = fields["canImportHistory"] as? Bool ?? false
+        previouslyImported = fields["previouslyImported"] as? Bool ?? false
+    }
+}
+
+struct ArciumArcImportJob: Equatable, Identifiable {
+    enum Outcome: String { case none, succeeded, empty, failed, cancelled }
+
+    var id = 0
+    var token = ""
+    var sourceTitle = ""
+    var destinationName = ""
+    var includesSidebar = false
+    var includesHistory = false
+    var refresh = false
+    var step = "none"
+    var outcome = Outcome.none
+    var failure = "none"
+    var partial = false
+    var historyFinished = false
+    var spaces = 0
+    var pins = 0
+    var folders = 0
+    var favorites = 0
+    var firstSpaceID = ""
+
+    init(_ fields: [String: Any]) {
+        id = fields["id"] as? Int ?? 0
+        token = fields["token"] as? String ?? ""
+        sourceTitle = fields["sourceTitle"] as? String ?? ""
+        destinationName = fields["destinationName"] as? String ?? ""
+        includesSidebar = fields["includesSidebar"] as? Bool ?? false
+        includesHistory = fields["includesHistory"] as? Bool ?? false
+        refresh = fields["refresh"] as? Bool ?? false
+        step = fields["step"] as? String ?? "none"
+        outcome = Outcome(rawValue: fields["outcome"] as? String ?? "") ?? .none
+        failure = fields["failure"] as? String ?? "none"
+        partial = fields["partial"] as? Bool ?? false
+        historyFinished = fields["historyFinished"] as? Bool ?? false
+        spaces = max(0, fields["spaces"] as? Int ?? 0)
+        pins = max(0, fields["pins"] as? Int ?? 0)
+        folders = max(0, fields["folders"] as? Int ?? 0)
+        favorites = max(0, fields["favorites"] as? Int ?? 0)
+        firstSpaceID = fields["firstSpaceID"] as? String ?? ""
+    }
+
+    var isFinished: Bool { outcome != .none }
+}
+
+struct ArciumArcImportSnapshot: Equatable {
+    enum Phase: String { case discovering, ready, running, finished }
+
+    var phase = Phase.discovering
+    var destinationAvailable = true
+    var destinationName = ""
+    var sidebarAllowed = true
+    var historyAllowed = true
+    var sources: [ArciumArcImportSource] = []
+    var job: ArciumArcImportJob?
+    var finishedJobs: [ArciumArcImportJob] = []
+    var startError: String?
+    var palette = ArciumSpacePaletteSnapshot()
+
+    init(_ fields: [String: Any] = [:]) {
+        phase = Phase(rawValue: fields["phase"] as? String ?? "") ?? .discovering
+        destinationAvailable = fields["destinationAvailable"] as? Bool ?? false
+        destinationName = fields["destinationName"] as? String ?? ""
+        sidebarAllowed = fields["sidebarAllowed"] as? Bool ?? false
+        historyAllowed = fields["historyAllowed"] as? Bool ?? false
+        sources = (fields["sources"] as? [[String: Any]] ?? []).map(ArciumArcImportSource.init)
+        job = (fields["job"] as? [String: Any]).map(ArciumArcImportJob.init)
+        finishedJobs = (fields["finishedJobs"] as? [[String: Any]] ?? []).map(ArciumArcImportJob.init)
+        startError = fields["startError"] as? String
+        palette = ArciumSpacePaletteSnapshot(fields["spacePalette"] as? [String: Any] ?? [:])
+    }
+
+    /// Titles of other detected Arc profiles that already own records here.
+    func sharedProfileTitles(excluding token: String?) -> [String] {
+        sources.filter { $0.previouslyImported && $0.token != token }.map(\.title)
+    }
+}
+
+// MARK: - Copy
+
+/// Every user-visible result string lives here so tests can check claims.
+enum ArciumArcImportCopy {
+    static let footnote = "Passwords and sign-ins stay in Arc."
+
+    static func plural(_ count: Int, _ noun: String) -> String {
+        "\(count) \(noun)\(count == 1 ? "" : "s")"
+    }
+
+    static func counts(_ job: ArciumArcImportJob) -> String {
+        var parts = [plural(job.spaces, "Space"), plural(job.pins, "Pin")]
+        if job.folders > 0 { parts.append(plural(job.folders, "folder")) }
+        parts.append(plural(job.favorites, "Favorite"))
+        return parts.joined(separator: " · ")
+    }
+
+    static func runningLabel(_ job: ArciumArcImportJob) -> String {
+        switch job.step {
+        case "history": "Importing history…"
+        case "sidebar": job.refresh ? "Refreshing Spaces and Pins…" : "Importing Spaces and Pins…"
+        default: "Starting…"
+        }
+    }
+
+    static func title(_ job: ArciumArcImportJob) -> String {
+        switch job.outcome {
+        case .succeeded: job.includesSidebar ? "Imported \(job.sourceTitle)" : "History import finished for \(job.sourceTitle)"
+        case .empty: job.refresh ? "\(job.sourceTitle)'s sidebar is now empty" : "Nothing to import from \(job.sourceTitle)"
+        case .cancelled: "Import stopped"
+        case .none: job.sourceTitle
+        case .failed:
+            switch job.failure {
+            case "sidebar_unreadable": "Couldn't read \(job.sourceTitle)'s sidebar"
+            case "sidebar_not_saved": "Arcium couldn't save the sidebar"
+            case "history_incomplete": "History didn't finish"
+            case "destination_closed": "This profile closed during import"
+            default: "Import didn't finish"
+            }
+        }
+    }
+
+    /// Never claims that nothing changed after a category started: the
+    /// importer can write data before it reports a category as ended.
+    static let mayHaveAdded = "Some items may already have been added."
+
+    static func body(_ job: ArciumArcImportJob) -> String? {
+        switch job.outcome {
+        case .succeeded:
+            let history = job.includesHistory && job.historyFinished ? historyFinishedCaption : nil
+            return job.includesSidebar ? [counts(job), history].compactMap(\.self).joined(separator: "\n") : history
+        case .empty:
+            return job.refresh
+                ? "Arc has no saved sidebar items for this profile. Previously imported Spaces, Pins, folders, and Favorites from this Arc profile were removed."
+                : "Arc has no saved Spaces, Pins, or Favorites for this profile."
+        case .cancelled:
+            return job.partial ? mayHaveAdded : "Stopped before any category started."
+        case .failed:
+            let reason: String? = switch job.failure {
+            case "sidebar_unreadable": "Quit Arc and try again, or choose another profile."
+            default: nil
+            }
+            let parts = [reason, job.partial ? mayHaveAdded : nil].compactMap(\.self)
+            return parts.isEmpty ? nil : parts.joined(separator: " ")
+        case .none:
+            return nil
+        }
+    }
+
+    static func startError(_ code: String) -> String {
+        switch code {
+        case "busy": "Another import into this profile is running."
+        case "source_changed": "Arc's profiles changed. Choose again."
+        case "nothing_selected": "Choose what to import."
+        case "destination_closed": "This profile closed."
+        default: "The import couldn't start."
+        }
+    }
+
+    static let refreshCaption = "Refresh replaces the imported Spaces, Pins, folders, and Favorites. Changes you made inside those Spaces will be replaced by Arc's version. Other Spaces stay."
+    static let historyFinishedCaption = "History import finished. Check History to confirm what was added."
+    static let historyCaption = "Adds visits. Importing history again adds duplicates."
+}
+
+// MARK: - Store
+
+@MainActor
+final class ArciumArcImportStore: ObservableObject {
+    @Published private(set) var snapshot: ArciumArcImportSnapshot
+    @Published private(set) var selectedToken: String?
+    @Published var includeSidebar = true
+    @Published var includeHistory = false
+    weak var delegate: ArciumArcImportDelegate?
+    let preset: SettingsStylePreset?
+
+    init(snapshot: NSDictionary, delegate: ArciumArcImportDelegate?, preset: SettingsStylePreset? = nil) {
+        self.delegate = delegate
+        self.preset = preset
+        self.snapshot = ArciumArcImportSnapshot(snapshot as? [String: Any] ?? [:])
+        normalizeSelection()
+    }
+
+    func updateSnapshot(_ dictionary: NSDictionary) {
+        snapshot = ArciumArcImportSnapshot(dictionary as? [String: Any] ?? [:])
+        normalizeSelection()
+    }
+
+    var selectedSource: ArciumArcImportSource? {
+        snapshot.sources.first { $0.token == selectedToken }
+    }
+
+    var isRunning: Bool { snapshot.phase == .running }
+    var canClose: Bool { !isRunning }
+    var isRefresh: Bool { includeSidebar && selectedSource?.previouslyImported == true }
+    var primaryTitle: String { isRefresh ? "Refresh sidebar" : "Import" }
+
+    var sidebarAvailable: Bool { snapshot.sidebarAllowed && selectedSource?.canImportSidebar != false }
+    var historyAvailable: Bool { snapshot.historyAllowed && selectedSource?.canImportHistory != false }
+
+    var canStart: Bool {
+        guard snapshot.destinationAvailable, snapshot.phase == .ready,
+              let source = selectedSource, source.isSelectable else { return false }
+        return (includeSidebar && sidebarAvailable) || (includeHistory && historyAvailable)
+    }
+
+    func select(_ token: String) {
+        guard !isRunning, token != selectedToken,
+              snapshot.sources.contains(where: { $0.token == token && $0.isSelectable }) else { return }
+        selectedToken = token
+        // History is a fresh, explicit choice for every source.
+        includeHistory = false
+        includeSidebar = true
+    }
+
+    func start() {
+        guard canStart, let token = selectedToken else { return }
+        send("start", ["token": token,
+                       "sidebar": includeSidebar && sidebarAvailable,
+                       "history": includeHistory && historyAvailable])
+    }
+
+    func cancel() { if isRunning { send("cancel") } }
+    func reset() {
+        guard !isRunning else { return }
+        includeSidebar = true
+        includeHistory = false
+        send("reset")
+    }
+    func rediscover() { send("rediscover") }
+    func close() { if canClose { send("close") } }
+    func otherBrowsers() { if canClose { send("other_browsers") } }
+    func openSpace(_ job: ArciumArcImportJob) { send("open_space", ["jobID": job.id]) }
+
+    /// Return to selection; retrying history requires a fresh explicit choice.
+    func retry(_ job: ArciumArcImportJob) {
+        guard !isRunning else { return }
+        selectedToken = snapshot.sources.first { $0.token == job.token && $0.isSelectable }?.token
+        includeSidebar = job.includesSidebar
+        includeHistory = false
+        send("reset")
+    }
+
+    private func send(_ name: String, _ payload: [String: Any] = [:]) {
+        delegate?.arcImportActionInvoked(name: name, payload: payload as NSDictionary)
+    }
+
+    private func normalizeSelection() {
+        let selectable = snapshot.sources.filter(\.isSelectable)
+        if let token = snapshot.job?.token, isRunning || snapshot.phase == .finished,
+           snapshot.sources.contains(where: { $0.token == token }) {
+            selectedToken = token
+        } else if let selectedToken, !selectable.contains(where: { $0.token == selectedToken }) {
+            self.selectedToken = nil
+        }
+        // Preselect only when there is no choice to make.
+        if selectedToken == nil, selectable.count == 1 {
+            selectedToken = selectable[0].token
+            includeHistory = false
+        }
+    }
+}
