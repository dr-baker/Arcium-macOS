+struct ArciumSpacePaletteSnapshot: Equatable {
+    var id = ""
+    var name = ""
+    var available = false
+    var controlsChroma = 1.0
+    var panelsChroma = 0.35
+    var lightChromeOpacity = 1.0
+    var darkChromeOpacity = 1.0
+    var lightPanelOpacity = 1.0
+    var darkPanelOpacity = 1.0
+    var light: [String: String] = [:]
+    var dark: [String: String] = [:]
+
+    init(_ dictionary: [String: Any] = [:]) {
+        id = dictionary["id"] as? String ?? ""
+        name = dictionary["name"] as? String ?? ""
+        available = strictBoolean(dictionary["available"]) == true && !id.isEmpty
+        if let value = finiteDouble(dictionary["controlsChroma"]), (0...2).contains(value) {
+            controlsChroma = value
+        }
+        if let value = finiteDouble(dictionary["panelsChroma"]), (0...2).contains(value) {
+            panelsChroma = value
+        }
+        func opacity(_ key: String) -> Double {
+            guard let value = finiteDouble(dictionary[key]), (0...1).contains(value) else { return 1 }
+            return value
+        }
+        lightChromeOpacity = opacity("lightChromeOpacity")
+        darkChromeOpacity = opacity("darkChromeOpacity")
+        lightPanelOpacity = opacity("lightPanelOpacity")
+        darkPanelOpacity = opacity("darkPanelOpacity")
+        light = dictionary["light"] as? [String: String] ?? [:]
+        dark = dictionary["dark"] as? [String: String] ?? [:]
+    }
+
+    // Rendering consumes the browser's resolved colors. Swift never generates
+    // another palette from a profile-wide accent or a separate color recipe.
+    func theme(fallback: SettingsTheme) -> SettingsTheme {
+        let roles = ["chrome", "field", "hover", "panel", "text", "mutedText",
+                     "outline", "accent", "onAccent"]
+        guard roles.allSatisfy({ SettingsRGB(hex: light[$0] ?? "") != nil
+                                && SettingsRGB(hex: dark[$0] ?? "") != nil }) else { return fallback }
+        func color(_ role: String) -> Color {
+            let a = SettingsRGB(hex: light[role]!)!
+            let b = SettingsRGB(hex: dark[role]!)!
+            return Color(nsColor: NSColor(name: nil) { appearance in
+                let rgb = appearance.bestMatch(from: [.aqua, .darkAqua]) == .darkAqua ? b : a
+                return NSColor(srgbRed: rgb.red, green: rgb.green, blue: rgb.blue, alpha: 1)
+            })
+        }
+        return SettingsTheme(
+            accent: color("accent"),
+            windowFrame: color("chrome"), windowCanvas: color("chrome"),
+            windowCanvasWash: color("panel"), panel: color("panel"),
+            panelRaised: color("panel"), panelInset: color("field"),
+            sidebarRail: color("chrome"), sidebarPanel: color("panel"),
+            card: color("panel"), cardElevated: color("panel"),
+            control: color("field"), controlSecondary: color("field"),
+            controlHover: color("hover"), controlSelectionFill: color("accent"),
+            selection: color("accent"), selectionHover: color("accent"),
+            selectionText: color("onAccent"),
+            borderSubtle: color("outline"), borderEmphasis: color("outline"),
+            borderControl: color("outline"),
+            borderDanger: fallback.borderDanger, borderWarning: fallback.borderWarning,
+            borderSuccess: fallback.borderSuccess,
+            shadowAmbient: fallback.shadowAmbient, shadowLifted: fallback.shadowLifted,
+            textPrimary: color("text"), textSecondary: color("mutedText"),
+            textTertiary: color("mutedText"),
+            error: fallback.error, warning: fallback.warning, success: fallback.success,
+            errorSurface: fallback.errorSurface, errorText: fallback.errorText,
+            warningSurface: fallback.warningSurface, warningText: fallback.warningText,
+            successSurface: fallback.successSurface, successText: fallback.successText,
+            borderWidth: fallback.borderWidth,
+            increasedContrastBorderWidth: fallback.increasedContrastBorderWidth,
+            windowChromeDarkOpacity: darkChromeOpacity, windowChromeLightOpacity: lightChromeOpacity,
+            sidebarRailDarkOpacity: darkChromeOpacity, sidebarRailLightOpacity: lightChromeOpacity,
+            windowFrameTintOpacity: max(lightChromeOpacity, darkChromeOpacity),
+            panelTintOpacity: max(lightPanelOpacity, darkPanelOpacity),
+            cardOpacity: 1, controlOpacity: 1, cardTintOpacity: 1,
+            controlTintOpacity: 1, navRailTintOpacity: max(lightChromeOpacity, darkChromeOpacity),
+            compactNavTintOpacity: max(lightChromeOpacity, darkChromeOpacity), radiusScale: fallback.radiusScale
+        )
+    }
+}
