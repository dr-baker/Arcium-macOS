===================================================================
--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_settings_swift/Tests/ArciumSettingsUITests/ArciumBackdropColorEditingTests.swift
@@ -0,0 +1,44 @@
+import XCTest
+@testable import SettingsUI
+
+final class ArciumBackdropColorEditingTests: XCTestCase {
+    @MainActor
+    func testPaletteEditingDoesNotDependOnDecoration() {
+        for enabled in [false, true] {
+            for effects in [false, true] {
+                XCTAssertTrue(SBackdropEditor.allowsColorEditing(
+                    editable: true, colorsOnly: true,
+                    enabled: enabled, effectsAvailable: effects))
+                XCTAssertFalse(SBackdropEditor.allowsColorEditing(
+                    editable: false, colorsOnly: true,
+                    enabled: enabled, effectsAvailable: effects))
+                XCTAssertEqual(SBackdropEditor.allowsColorEditing(
+                    editable: true, colorsOnly: false,
+                    enabled: enabled, effectsAvailable: effects), enabled && effects)
+            }
+        }
+    }
+
+    @MainActor
+    func testDeferredColorPlacementKeepsEffectsDisabled() {
+        let saved = SettingsBackdropConfiguration(enabled: false)
+        let start = saved.glows[0]
+        var moved = saved
+        moved.glows[0].x = 0.72
+        let result = SBackdropEditor.resolveDrag(
+            glowID: start.id, startGlow: start,
+            localConfiguration: moved, deferredConfiguration: saved,
+            allowsDisabledColors: true)
+        XCTAssertTrue(result.shouldCommit)
+        XCTAssertFalse(result.configuration.enabled)
+        XCTAssertEqual(result.configuration.glows[0].x, 0.72)
+        XCTAssertEqual(result.configuration.glows[0].colorHex, start.colorHex)
+        XCTAssertEqual(result.configuration.grain, saved.grain)
+
+        let backdrop = SBackdropEditor.resolveDrag(
+            glowID: start.id, startGlow: start,
+            localConfiguration: moved, deferredConfiguration: saved)
+        XCTAssertFalse(backdrop.shouldCommit)
+        XCTAssertFalse(backdrop.configuration.enabled)
+    }
+}
