+IN_PROC_BROWSER_TEST_F(AppControllerBrowserTest,
+                       LittleArcExternalLinkPromotesLiveTab) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  std::ignore = AppController.sharedController;
+  browser()->profile()->GetPrefs()->SetBoolean(
+      prefs::kHeliumLittleArcExternalLinks, true);
+
+  const int original_tab_count = browser()->tab_strip_model()->count();
+  content::WebContents* original_active_tab =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  const GURL url = embedded_test_server()->GetURL("/simple.html");
+  ui_test_utils::BrowserCreatedObserver browser_created_observer;
+  content::TestNavigationObserver navigation_observer(url);
+  navigation_observer.StartWatchingNewWebContents();
+
+  SendOpenUrlToAppController(url);
+  BrowserWindowInterface* popup_window = browser_created_observer.Wait();
+  navigation_observer.Wait();
+  ASSERT_TRUE(popup_window);
+  Browser* popup = popup_window->GetBrowserForMigrationOnly();
+  ASSERT_TRUE(popup);
+  EXPECT_TRUE(popup->is_type_popup());
+  EXPECT_TRUE(helium::IsLittleArcBrowser(popup));
+  EXPECT_TRUE(popup->omit_from_session_restore());
+  EXPECT_FALSE(popup->should_trigger_session_restore());
+  EXPECT_EQ(original_tab_count, browser()->tab_strip_model()->count());
+  EXPECT_EQ(original_active_tab,
+            browser()->tab_strip_model()->GetActiveWebContents());
+
+  content::WebContents* promoted_contents =
+      popup->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(promoted_contents);
+  ui_test_utils::BrowserDestroyedObserver destroyed_observer(popup);
+  EXPECT_TRUE(chrome::ExecuteCommand(popup, IDC_OPEN_FILE));
+  destroyed_observer.Wait();
+
+  EXPECT_EQ(original_tab_count + 1, browser()->tab_strip_model()->count());
+  EXPECT_EQ(promoted_contents,
+            browser()->tab_strip_model()->GetActiveWebContents());
+  EXPECT_EQ(url, promoted_contents->GetLastCommittedURL());
+}
+
+IN_PROC_BROWSER_TEST_F(AppControllerBrowserTest,
+                       LittleArcSkipsMultipleExternalLinks) {
+  std::ignore = AppController.sharedController;
+  browser()->profile()->GetPrefs()->SetBoolean(
+      prefs::kHeliumLittleArcExternalLinks, true);
+
+  EXPECT_EQ(nullptr, helium::OpenUrlsInLittleArc(
+                         browser()->profile(),
+                         {GURL("https://example.test/one"),
+                          GURL("https://example.test/two")}));
+  EXPECT_EQ(1u, GlobalBrowserCollection::GetInstance()->GetSize());
+}
