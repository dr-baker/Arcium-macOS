@@ -614,6 +614,49 @@ final class ArciumSettingsUIContractTest
     }
 
     @MainActor
+    func testToolbarVisibilityUsesHostPreferenceAndExternalSnapshots() {
+        let delegate = TestDelegate()
+        let store = ArciumSettingsStore(snapshot: ["available": true, "appearance": [
+            "showToolbar": true,
+            "available": ["show_toolbar": true],
+            "managed": ["show_toolbar": false]
+        ]], delegate: delegate)
+        XCTAssertTrue(store.appearanceBoolean("show_toolbar"))
+        store.setAppearanceBoolean("show_toolbar", value: false)
+        XCTAssertEqual(delegate.settings.map(\.key), ["show_toolbar"])
+        XCTAssertEqual(delegate.settings.first?.value as? Bool, false)
+        store.updateSnapshot(["available": true, "appearance": [
+            "showToolbar": false, "available": ["show_toolbar": true]
+        ]])
+        XCTAssertFalse(store.appearanceBoolean("show_toolbar"))
+        store.updateSnapshot(["available": true, "appearance": [
+            "showToolbar": true, "available": ["show_toolbar": true]
+        ]])
+        XCTAssertTrue(store.appearanceBoolean("show_toolbar"))
+    }
+
+    @MainActor
+    func testToolbarVisibilityRejectsUnavailableManagedAndSidebarWrites() {
+        let delegate = TestDelegate()
+        let snapshots: [[String: Any]] = [
+            ["showToolbar": true],
+            ["showToolbar": true, "available": ["show_toolbar": false]],
+            ["showToolbar": true, "available": ["show_toolbar": true],
+             "managed": ["show_toolbar": true]],
+            ["showToolbar": true, "available": ["show_toolbar": true],
+             "sidebarNavigationConfigured": true]
+        ]
+        for appearance in snapshots {
+            let store = ArciumSettingsStore(snapshot: ["available": true,
+                "appearance": appearance], delegate: delegate)
+            store.setAppearanceBoolean("show_toolbar", value: false)
+            XCTAssertTrue(store.appearanceBoolean("show_toolbar"))
+        }
+        XCTAssertTrue(delegate.settings.isEmpty)
+        XCTAssertFalse(ArciumAppearanceSnapshot(["showToolbar": 1]).showToolbar)
+    }
