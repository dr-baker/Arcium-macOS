+    private static func panelMaterialDescription(_ material: String) -> String {
+        switch material {
+        case "fast": "The \u{2318}T command bar and Ctrl+Tab switcher. Fast: the system blur material, with no live refraction."
+        case "liquid": "The \u{2318}T command bar and Ctrl+Tab switcher. Liquid: clear Liquid Glass, always lit as if active."
+        case "frosted": "The \u{2318}T command bar and Ctrl+Tab switcher. Frosted: clear Liquid Glass in its quieter inactive look."
+        case "glassmorphic": "The \u{2318}T command bar and Ctrl+Tab switcher. Glassmorphic: the switcher's original refraction shader; the command bar uses Liquid."
+        default: "The \u{2318}T command bar and Ctrl+Tab switcher, drawn as a solid panel."
+        }
+    }
+
+    private static func color(hex: String) -> Color {
+        guard hex.count == 7, let value = UInt32(hex.dropFirst(), radix: 16) else { return .black }
+        return Color(.sRGB, red: Double((value >> 16) & 0xFF) / 255,
+                     green: Double((value >> 8) & 0xFF) / 255, blue: Double(value & 0xFF) / 255)
+    }
+
+    private static func hex(_ color: Color) -> String {
+        guard let rgb = NSColor(color).usingColorSpace(.sRGB) else { return "#1D1E1C" }
+        func byte(_ component: CGFloat) -> Int { Int((min(max(component, 0), 1) * 255).rounded()) }
+        return String(format: "#%02X%02X%02X", byte(rgb.redComponent), byte(rgb.greenComponent),
+                      byte(rgb.blueComponent))
+    }
