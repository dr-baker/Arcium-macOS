+/// Values a floating-surface preset fills in; Custom stores its own.
+struct ArciumSurfaceTuning: Equatable {
+    static let materials = ["fast", "liquid", "frosted", "glassmorphic", "solid"]
+    static let finishes = ["glass", "refractive", "solid"]
+    static let maxScrimBlur = 30.0
+    var panelMaterial = "liquid"
+    var panelTint = 0.3
+    /// "#RRGGBB", or empty to follow the browser theme.
+    var panelTintColor = ""
+    var panelShadow = true
+    var controlFinish = "glass"
+    var controlTint = 0.55
+    var controlEdge = 0.38
+    var scrimBlur = 9.0
+    var scrimDim = 0.28
+    init(_ dictionary: [String: Any] = [:]) {
+        if let value = dictionary["panelMaterial"] as? String, Self.materials.contains(value) {
+            panelMaterial = value
+        }
+        if let value = dictionary["panelTintColor"] as? String, Self.isTintColor(value) {
+            panelTintColor = value
+        }
+        panelShadow = strictBoolean(dictionary["panelShadow"]) ?? panelShadow
+        if let value = dictionary["controlFinish"] as? String, Self.finishes.contains(value) {
+            controlFinish = value
+        }
+        func unit(_ key: String, _ fallback: Double, max: Double = 1) -> Double {
+            guard let value = finiteDouble(dictionary[key]), (0...max).contains(value) else { return fallback }
+            return value
+        }
+        panelTint = unit("panelTint", panelTint)
+        controlTint = unit("controlTint", controlTint)
+        controlEdge = unit("controlEdge", controlEdge)
+        scrimBlur = unit("scrimBlur", scrimBlur, max: Self.maxScrimBlur)
+        scrimDim = unit("scrimDim", scrimDim)
+    }
+    static func isTintColor(_ value: String) -> Bool {
+        value.isEmpty || (value.count == 7 && value.first == "#"
+                          && value.dropFirst().allSatisfy(\.isHexDigit))
+    }
+    var dictionary: [String: Any] {
+        ["panelMaterial": panelMaterial, "panelTint": panelTint, "panelTintColor": panelTintColor,
+         "panelShadow": panelShadow,
+         "controlFinish": controlFinish, "controlTint": controlTint, "controlEdge": controlEdge,
+         "scrimBlur": scrimBlur, "scrimDim": scrimDim]
+    }
+}
