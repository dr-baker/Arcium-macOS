+// Port of SettingsUI's SettingsGlassAppearanceBridge. Native glass draws its
+// active or inactive look from the window's key appearance; NSGlassEffectView
+// has no `state` like NSVisualEffectView. Chromium owns these windows, and
+// AppKit observes them with KVO, so instead of a window subclass the four
+// queries are overridden once on the window's class and consult a per-window
+// override. Windows without one keep AppKit's answer. Validated on macOS 26.
+enum class ForcedAppearance { kFollow, kActive, kInactive };
+
+constexpr const char* kAppearanceSelectors[] = {
+    "hasKeyAppearance", "_hasKeyAppearance", "_hasActiveAppearance",
+    "_hasActiveAppearanceIgnoringKeyFocus"};
+const char kForcedAppearanceKey = 0;
+
+bool ForcedAppearanceSupported() {
+  static const bool supported = [] {
+    if (NSProcessInfo.processInfo.operatingSystemVersion.majorVersion != 26) {
+      return false;
+    }
+    for (const char* name : kAppearanceSelectors) {
+      Method method =
+          class_getInstanceMethod([NSWindow class], sel_registerName(name));
+      // Each query returns BOOL and takes no arguments.
+      if (!method || method_getNumberOfArguments(method) != 2) {
+        return false;
+      }
+      char result[8] = {};
+      method_getReturnType(method, result, sizeof(result));
+      if (result[0] != 'B' && result[0] != 'c') {
+        return false;
+      }
+    }
+    return true;
+  }();
+  return supported;
+}
+
+void InstallAppearanceOverrides(Class window_class) {
+  static base::NoDestructor<std::set<Class>> installed;
+  if (!installed->insert(window_class).second) {
+    return;
+  }
+  for (const char* name : kAppearanceSelectors) {
+    SEL selector = sel_registerName(name);
+    Method method = class_getInstanceMethod(window_class, selector);
+    using Query = BOOL (*)(id, SEL);
+    const Query original =
+        reinterpret_cast<Query>(method_getImplementation(method));
+    IMP forced = imp_implementationWithBlock(^BOOL(id window) {
+      if (NSNumber* value =
+              objc_getAssociatedObject(window, &kForcedAppearanceKey)) {
+        return value.boolValue;
+      }
+      return original(window, selector);
+    });
+    if (!class_addMethod(window_class, selector, forced,
+                         method_getTypeEncoding(method))) {
+      // The class implements the query itself; wrap that implementation.
+      method_setImplementation(method, forced);
+    }
+  }
+}
+
+void InvalidateAppearance(NSView* view) {
+  [view viewDidChangeEffectiveAppearance];
+  view.needsDisplay = YES;
+  for (NSView* child in view.subviews) {
+    InvalidateAppearance(child);
+  }
+}
+
+void SetForcedAppearance(NSWindow* window, ForcedAppearance appearance) {
+  if (!window || !ForcedAppearanceSupported()) {
+    return;
+  }
+  NSNumber* current = objc_getAssociatedObject(window, &kForcedAppearanceKey);
+  NSNumber* wanted =
+      appearance == ForcedAppearance::kFollow
+          ? nil
+          : @(appearance == ForcedAppearance::kActive);
+  if (current == wanted || [current isEqual:wanted]) {
+    return;
+  }
+  // -class reports the real class beneath any KVO subclass.
+  InstallAppearanceOverrides([window class]);
+  objc_setAssociatedObject(window, &kForcedAppearanceKey, wanted,
+                           OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  // As SettingsGlassAppearanceBridge.refresh: redraw for the new appearance.
+  if (window.contentView) {
+    InvalidateAppearance(window.contentView);
+  }
+  [window invalidateShadow];
+}
+
+ForcedAppearance AppearanceFor(helium::PanelMaterial material) {
+  switch (material) {
+    case helium::PanelMaterial::kLiquid:
+    case helium::PanelMaterial::kGlassmorphic:
+      return ForcedAppearance::kActive;
+    case helium::PanelMaterial::kFrosted:
+      return ForcedAppearance::kInactive;
+    case helium::PanelMaterial::kSolid:
+    case helium::PanelMaterial::kFast:
+      return ForcedAppearance::kFollow;
+  }
+}
