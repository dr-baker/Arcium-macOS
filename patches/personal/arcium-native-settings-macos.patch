+        _size = size
+        self.sizeRange = sizeRange
+        self.sizeStep = sizeStep
+        self.sizeFormat = sizeFormat
+        _intensity = intensity
+        self.intensityRange = intensityRange
+        self.intensityStep = intensityStep
+        self.intensityFormat = intensityFormat
+        _matchAllColors = matchAllColors
+        self.sizeHelp = sizeHelp
+        self.intensityHelp = intensityHelp
+        self.matchAllColorsDescription = matchAllColorsDescription
+        self.matchAllColorsHelp = matchAllColorsHelp
+        self.commitMode = commitMode
+        self.onMatchAllColors = onMatchAllColors
+        self.preview = preview()
+    }
