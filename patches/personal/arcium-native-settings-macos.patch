+- (void)showUnavailableArcShortcuts {
+  if (!model_ || !model_->shortcut_service()) {
+    return;
+  }
+  const browser_shortcuts::arcium::PresetReport report =
+      model_->GetArcPresetReport();
+  NSMutableString* details = [[NSMutableString alloc] init];
+  for (const browser_shortcuts::arcium::CommandReport& entry :
+       report.unavailable) {
+    [details appendFormat:@"%@ — %@\n",
+                          base::SysUTF8ToNSString(entry.action_name),
+                          base::SysUTF8ToNSString(entry.reason)];
+  }
+  [self presentAlertWithTitle:@"Arc shortcuts unavailable in this build"
+              informativeText:details
+             firstButtonTitle:@"OK"
+            secondButtonTitle:nil
+                   completion:nil];
+}
