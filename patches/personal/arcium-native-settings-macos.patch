@@ -0,0 +1,64 @@
+import Foundation
+import SwiftUI
+
+public struct SettingsRGB: Sendable, Equatable, Codable {
+    public let red: Double
+    public let green: Double
+    public let blue: Double
+
+    public init(red: Double, green: Double, blue: Double) {
+        func bounded(_ value: Double) -> Double { value.isFinite ? min(max(value, 0), 1) : 0 }
+        self.red = bounded(red)
+        self.green = bounded(green)
+        self.blue = bounded(blue)
+    }
+
+    public init?(hex: String) {
+        let digits = hex.trimmingCharacters(in: .whitespacesAndNewlines).replacingOccurrences(of: "#", with: "")
+        guard digits.count == 6, digits.allSatisfy({ $0.isHexDigit }), let value = UInt32(digits, radix: 16) else { return nil }
+        self.init(red: Double((value >> 16) & 255) / 255,
+                  green: Double((value >> 8) & 255) / 255, blue: Double(value & 255) / 255)
+    }
+
+    /// Convert encoded sRGB to OKLCH. Achromatic colors have a canonical zero hue.
+    public var oklch: SettingsOKLCH {
+        func linear(_ value: Double) -> Double {
+            value <= 0.04045 ? value / 12.92 : pow((value + 0.055) / 1.055, 2.4)
+        }
+        let r = linear(red), g = linear(green), b = linear(blue)
+        let l = cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
+        let m = cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
+        let s = cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
+        let lightness = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
+        let a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
+        let axisB = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
+        let chroma = hypot(a, axisB)
+        let angle = atan2(axisB, a) * 180 / .pi
+        return SettingsOKLCH(lightness: lightness, chroma: chroma < 0.000001 ? 0 : chroma,
+                             hue: chroma < 0.000001 ? 0 : (angle + 360).truncatingRemainder(dividingBy: 360))
+    }
+
+    public var color: Color { Color(.sRGB, red: red, green: green, blue: blue) }
+    public var hex: String {
+        String(format: "#%02X%02X%02X", Int((red * 255).rounded()), Int((green * 255).rounded()), Int((blue * 255).rounded()))
+    }
+    public var luminance: Double {
+        func linear(_ value: Double) -> Double {
+            value <= 0.04045 ? value / 12.92 : pow((value + 0.055) / 1.055, 2.4)
+        }
+        return 0.2126 * linear(red) + 0.7152 * linear(green) + 0.0722 * linear(blue)
+    }
+    public func contrast(against other: Self) -> Double {
+        (max(luminance, other.luminance) + 0.05) / (min(luminance, other.luminance) + 0.05)
+    }
+
+    /// Source-over alpha compositing against an opaque backdrop.
+    public func composited(over backdrop: Self, opacity: Double) -> Self {
+        let alpha = opacity.isFinite ? min(max(opacity, 0), 1) : 0
+        return SettingsRGB(
+            red: red * alpha + backdrop.red * (1 - alpha),
+            green: green * alpha + backdrop.green * (1 - alpha),
+            blue: blue * alpha + backdrop.blue * (1 - alpha)
+        )
+    }
+}
