+private struct ChromeAppearancePointMarker: View {
+    let point: ArciumChromeAppearancePoint
+    let index: Int
+    let isSelected: Bool
+    let size: CGSize
+    let editable: Bool
+    let select: () -> Void
+    let edit: () -> Void
+    let move: (String, CGPoint, CGSize, Bool) -> Void
+    let moveByAccessibility: (String, Double, Double) -> Void
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        ZStack {
+            Circle().fill(point.color)
+            Circle()
+                .strokeBorder(
+                    isSelected ? theme.selectionText : .white.opacity(0.85),
+                    lineWidth: isSelected ? 3 : 1
+                )
+            Text("\(index + 1)")
+                .font(.system(size: 11, weight: .bold, design: .rounded))
+                .foregroundStyle(.white)
+                .shadow(color: .black.opacity(0.6), radius: 2)
+        }
+        .frame(width: 30, height: 30)
+        .contentShape(Circle())
+        .disabled(!editable)
+        .focusable(editable)
+        .onKeyPress(.return) { select(); return .handled }
+        .onKeyPress(.space) { select(); return .handled }
+        .accessibilityElement(children: .ignore)
+        .accessibilityAddTraits(.isButton)
+        .accessibilityLabel("Color point \(index + 1)")
+        .accessibilityValue("Position \(percent(point.x)), \(percent(point.y))")
+        .accessibilityHint("Drag to move this color point. Double-click to open the color picker.")
+        .accessibilityAction { select() }
+        .accessibilityAction(named: "Choose color", edit)
+        .accessibilityAction(named: "Move left") { moveByAccessibility(point.id, -0.05, 0) }
+        .accessibilityAction(named: "Move right") { moveByAccessibility(point.id, 0.05, 0) }
+        .accessibilityAction(named: "Move up") { moveByAccessibility(point.id, 0, -0.05) }
+        .accessibilityAction(named: "Move down") { moveByAccessibility(point.id, 0, 0.05) }
+        .gesture(
+            TapGesture(count: 2)
+                .onEnded { edit() }
+                .exclusively(before: TapGesture().onEnded { select() })
+        )
+        .highPriorityGesture(
+            DragGesture(minimumDistance: 3, coordinateSpace: .named("arcium-chrome-preview"))
+                .onChanged { value in
+                    move(point.id, value.location, size, false)
+                }
+                .onEnded { value in
+                    move(point.id, value.location, size, true)
+                }
+        )
+        .help("Drag to move color point \(index + 1). Double-click to open the color picker.")
+    }
+
+    private func percent(_ value: Double) -> String {
+        "\(Int((value * 100).rounded()))%"
+    }
+}
