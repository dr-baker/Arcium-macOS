+// Keeps the SettingsUI host view and the native glass sibling in a stable
+// hierarchy. NSWindow.contentViewController otherwise owns the content view
+// directly and can replace sibling views when its hosted view is installed.
+@interface ArciumSettingsContentViewController : NSViewController {
+ @private
+  NSViewController* hosted_controller_;
+  NSView* background_view_;
+}
+- (instancetype)initWithHostedController:(NSViewController*)controller;
+- (void)setBackgroundView:(NSView*)backgroundView;
+- (void)setEffectiveAppearanceChangedHandler:(void (^)(void))handler;
+@end
+
+@implementation ArciumSettingsContentViewController
+
+- (instancetype)initWithHostedController:(NSViewController*)controller {
+  self = [super initWithNibName:nil bundle:nil];
+  if (self) {
+    hosted_controller_ = controller;
+  }
+  return self;
+}
+
+- (void)loadView {
+  ArciumSettingsContentView* root_view =
+      [[ArciumSettingsContentView alloc]
+          initWithFrame:NSMakeRect(0, 0, 860, 650)];
+  self.view = root_view;
+
+  [self addChildViewController:hosted_controller_];
+  NSView* hosted_view = hosted_controller_.view;
+  hosted_view.translatesAutoresizingMaskIntoConstraints = NO;
+  [root_view addSubview:hosted_view];
+  [NSLayoutConstraint activateConstraints:@[
+    [hosted_view.leadingAnchor constraintEqualToAnchor:root_view.leadingAnchor],
+    [hosted_view.trailingAnchor
+        constraintEqualToAnchor:root_view.trailingAnchor],
+    [hosted_view.topAnchor constraintEqualToAnchor:root_view.topAnchor],
+    [hosted_view.bottomAnchor constraintEqualToAnchor:root_view.bottomAnchor],
+  ]];
+}
+
+- (void)setBackgroundView:(NSView*)backgroundView {
+  (void)self.view;
+  [background_view_ removeFromSuperview];
+  background_view_ = backgroundView;
+  if (!background_view_) {
+    return;
+  }
+
+  background_view_.translatesAutoresizingMaskIntoConstraints = NO;
+  [self.view addSubview:background_view_
+             positioned:NSWindowBelow
+             relativeTo:nil];
+  [NSLayoutConstraint activateConstraints:@[
+    [background_view_.leadingAnchor
+        constraintEqualToAnchor:self.view.leadingAnchor],
+    [background_view_.trailingAnchor
+        constraintEqualToAnchor:self.view.trailingAnchor],
+    [background_view_.topAnchor constraintEqualToAnchor:self.view.topAnchor],
+    [background_view_.bottomAnchor
+        constraintEqualToAnchor:self.view.bottomAnchor],
+  ]];
+}
+
+- (void)setEffectiveAppearanceChangedHandler:(void (^)(void))handler {
+  (void)self.view;
+  ((ArciumSettingsContentView*)self.view).effectiveAppearanceChanged = handler;
+}
+
+@end
