+import Foundation
+
+/// OKLCH in D65: L in 0...1, chroma >= 0, hue in degrees.
+/// Uses the CSS Color 4 Oklab matrices; maps into sRGB by reducing chroma
+/// at fixed lightness and hue. This is conservative clipping, not CSS local-MINDE.
+public struct SettingsOKLCH: Sendable, Equatable, Codable {
+    public var lightness: Double
+    public var chroma: Double
+    public var hue: Double
+
+    public init(lightness: Double, chroma: Double, hue: Double) {
+        self.lightness = lightness
+        self.chroma = chroma
+        self.hue = hue
+    }
+
+    public var resolvedChroma: Double {
+        let requested = chroma.isFinite ? min(max(chroma, 0), 0.5) : 0
+        if inGamut(linearRGB(chroma: requested)) { return requested }
+        var lower = 0.0
+        var upper = requested
+        for _ in 0..<24 {
+            let mid = (lower + upper) / 2
+            if inGamut(linearRGB(chroma: mid)) { lower = mid } else { upper = mid }
+        }
+        return lower
+    }
+
+    public var rgb: SettingsRGB {
+        let values = linearRGB(chroma: resolvedChroma)
+        func encode(_ v: Double) -> Double {
+            let value = min(max(v, 0), 1)
+            return value <= 0.0031308 ? 12.92 * value : 1.055 * pow(value, 1 / 2.4) - 0.055
+        }
+        return SettingsRGB(red: encode(values.0), green: encode(values.1), blue: encode(values.2))
+    }
+
+    private func inGamut(_ rgb: (Double, Double, Double)) -> Bool {
+        [rgb.0, rgb.1, rgb.2].allSatisfy { $0 >= -0.0000001 && $0 <= 1.0000001 }
+    }
+
+    private func linearRGB(chroma: Double) -> (Double, Double, Double) {
+        let l = lightness.isFinite ? min(max(lightness, 0), 1) : 0
+        let angle = (hue.isFinite ? hue.truncatingRemainder(dividingBy: 360) : 0) * .pi / 180
+        let a = chroma * cos(angle)
+        let b = chroma * sin(angle)
+        let x = pow(l + 0.3963377774 * a + 0.2158037573 * b, 3)
+        let y = pow(l - 0.1055613458 * a - 0.0638541728 * b, 3)
+        let z = pow(l - 0.0894841775 * a - 1.2914855480 * b, 3)
+        return (4.0767416621 * x - 3.3077115913 * y + 0.2309699292 * z,
+                -1.2684380046 * x + 2.6097574011 * y - 0.3413193965 * z,
+                -0.0041960863 * x - 0.7034186147 * y + 1.7076147010 * z)
+    }
+}
