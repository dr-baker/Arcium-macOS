+struct ArciumSettingsSnapshot: Equatable {
+    var available = true
+    var general: ArciumGeneralSnapshot
+    var tabs: ArciumTabsSnapshot
+    var spaces: ArciumSpacesSnapshot
+    var appearance: ArciumAppearanceSnapshot
+    var shortcuts: ArciumShortcutsSnapshot
