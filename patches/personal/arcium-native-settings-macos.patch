+    }
+
+    public var dictionaryRepresentation: [String: Any] {
+        [
+            "id": id,
+            "color": colorHex,
+            "x": x,
+            "y": y,
+            "radius": radius,
+            "opacity": opacity
+        ]
+    }
+
+    public func normalized() -> Self {
+        Self(
+            id: id,
+            colorHex: colorHex,
+            x: x,
+            y: y,
+            radius: radius,
+            opacity: opacity
+        )
