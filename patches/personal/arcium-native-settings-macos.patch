+        var seen = Set<String>()
+        var result: [ArciumChromeAppearancePoint] = []
+        for (index, value) in values.prefix(4).enumerated() {
+            var point = value.normalized()
+            let fallbackID = "point-\(index + 1)"
+            var candidateID = point.id.isEmpty ? fallbackID : point.id
+            if seen.contains(candidateID) {
+                candidateID = fallbackID
+                var suffix = 2
+                while seen.contains(candidateID) {
+                    candidateID = "\(fallbackID)-\(suffix)"
+                    suffix += 1
+                }
+            }
+            point.id = candidateID
+            seen.insert(candidateID)
+            result.append(point)
+        }
+        return result
+    }
