+# Copyright 2026 The Helium Authors
+# Use of this source code is governed by the GPL-3.0 license.
+
+import("//build/config/mac/mac_sdk.gni")
+import("arcium_settings_ui_vendor_inputs.gni")
+
+assert(is_mac)
+assert(mac_min_system_version == "26.0")
+
+_package = "//chrome/browser/ui/cocoa/arcium_settings_swift"
+_staged = "$target_gen_dir/staged"
+_scratch = "$root_out_dir/arcium_settings_ui_swift_scratch"
+
+if (current_cpu == "arm64") {
+  _arch = "arm64"
+} else {
+  assert(current_cpu == "x64", "SettingsUI requires arm64 or x64")
+  _arch = "x86_64"
+}
+
+# Use the same Xcode toolchain and SDK selected for the macOS product.
+if (use_system_xcode) {
+  _swift = "${mac_bin_path}/swift"
+  _swift_frontend = "${mac_bin_path}/swift-frontend"
+} else {
+  _toolchain = "//build/mac_files/xcode_binaries/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin"
+  _swift = "$_toolchain/swift"
+  _swift_frontend = "$_toolchain/swift-frontend"
+}
+
+_resources = [
+  "ColorTokensKit_ColorTokensKit.bundle/ColorPalettes.json",
+  "ArciumSettingsUI_ArciumSettingsUI.bundle/yellow-blue grain.json",
+]
+
+action("build") {
+  script = "build_arcium_settings_ui.py"
+  inputs = arcium_settings_ui_vendor_inputs + [
+    "Package.swift",
+    "Sources/ArciumSettingsUI/ArciumSettingsModels.swift",
+    "Sources/ArciumSettingsUI/ArciumChromeAppearanceEditor.swift",
+    "Sources/ArciumSettingsUI/ArciumColorHarmonyPicker.swift",
+    "Sources/ArciumSettingsUI/ArciumSettingsViews.swift",
+    "Sources/ArciumSettingsUI/ArciumSettingsUIController.swift",
+    "Sources/ArciumSettingsUI/Resources/yellow-blue grain.json",
+    _swift,
+    _swift_frontend,
+  ]
+  outputs = [ "$_staged/libArciumSettingsUI.dylib" ]
+  foreach(resource, _resources) {
+    outputs += [ "$_staged/$resource" ]
+  }
+  args = [
+    "--package-dir", rebase_path(_package, root_build_dir),
+    "--scratch-path", rebase_path(_scratch, root_build_dir),
+    "--output-dir", rebase_path(_staged, root_build_dir),
+    "--product", "ArciumSettingsUI",
+    "--arch", _arch,
+    "--swift", rebase_path(_swift, root_build_dir),
+    "--sdk", rebase_path(mac_sdk_path, root_build_dir),
+  ]
+  foreach(resource, _resources) {
+    args += [ "--resource-file", resource ]
+  }
+}
+
+bundle_data("library") {
+  sources = [ "$_staged/libArciumSettingsUI.dylib" ]
+  outputs = [ "{{bundle_contents_dir}}/Frameworks/{{source_file_part}}" ]
+  public_deps = [ ":build" ]
+}
+
+# Install resources in the signed app resource directory. Production loaders
+# resolve these explicitly without SwiftPM developer build-path fallbacks.
+bundle_data("palette") {
+  sources = [ "$_staged/ColorTokensKit_ColorTokensKit.bundle/ColorPalettes.json" ]
+  outputs = [ "{{bundle_resources_dir}}/ColorTokensKit_ColorTokensKit.bundle/{{source_file_part}}" ]
+  public_deps = [ ":build" ]
+}
+
+bundle_data("preset") {
+  sources = [ "$_staged/ArciumSettingsUI_ArciumSettingsUI.bundle/yellow-blue grain.json" ]
+  outputs = [ "{{bundle_resources_dir}}/ArciumSettingsUI_ArciumSettingsUI.bundle/{{source_file_part}}" ]
+  public_deps = [ ":build" ]
+}
+
+group("bundle") {
+  public_deps = [ ":library", ":palette", ":preset" ]
+}
