+// Swift runtime metadata and view classes live for the process lifetime.
+// Do not unload this module when an individual profile window closes.
+bool LoadSettingsUIModule() {
+  static void* module = nullptr;
+  if (module) {
+    return true;
+  }
+  NSURL* library = [NSBundle.mainBundle.privateFrameworksURL
+      URLByAppendingPathComponent:@"libArciumSettingsUI.dylib"];
+  if (!library) {
+    return false;
+  }
+  module = dlopen(library.fileSystemRepresentation, RTLD_NOW | RTLD_LOCAL);
+  if (!module) {
+    LOG(ERROR) << "Could not load Arcium SettingsUI: " << dlerror();
+  }
+  return module != nullptr;
+}
