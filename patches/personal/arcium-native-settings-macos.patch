+import AppKit
+import Foundation
+import SettingsUI
+import SwiftUI
+
+@objc public protocol ArciumSettingsUIDelegate: AnyObject {
+    @objc(settingChangedWithKey:value:)
+    func settingChanged(key: String, value: Any)
+
+    @objc(actionInvokedWithName:payload:)
+    func actionInvoked(name: String, payload: NSDictionary)
+}
+
+/// Hosts the native SwiftUI settings interface in Chromium's profile-owned
+/// settings window. NSHostingController integrates SwiftUI navigation/toolbars.
+@MainActor
+@objc(ArciumSettingsUIController)
+public final class ArciumSettingsUIController: NSHostingController<AnyView> {
+    private let store: ArciumSettingsStore
+
+    @objc(initWithSnapshot:delegate:)
+    public init(snapshot: NSDictionary, delegate: ArciumSettingsUIDelegate) {
+        let store = ArciumSettingsStore(snapshot: snapshot, delegate: delegate)
+        self.store = store
+        super.init(rootView: AnyView(ArciumSettingsRootView(store: store)))
+    }
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+        fatalError("Arcium settings does not support storyboards")
+    }
+
+    @objc(updateSnapshot:)
+    public func updateSnapshot(_ snapshot: NSDictionary) {
+        store.updateSnapshot(snapshot)
+    }
+}
