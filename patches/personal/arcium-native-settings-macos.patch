+import AppKit
+import CoreImage
+import CoreImage.CIFilterBuiltins
+import SwiftUI
+
+/// Retains one full-area image per backdrop. Shrinking only crops it; growing
+/// allocates in 256-point increments so live resize does not render every frame.
+struct SettingsBackdropGrain: View {
+    var colors: [Color] = []
+    @Environment(\.colorScheme) private var colorScheme
+    @State private var texture: CGImage?
+    private static let context = CIContext(options: [.cacheIntermediates: false])
+
+    var body: some View {
+        GeometryReader { geometry in
+            ZStack(alignment: .topLeading) {
+                Color.clear
+                if let texture {
+                    Image(decorative: texture, scale: 1)
+                        .interpolation(.none)
+                }
+            }
+            .frame(width: geometry.size.width, height: geometry.size.height, alignment: .topLeading)
+            .clipped()
+            .onChange(of: colors) { _, _ in updateTexture(for: geometry.size, force: true) }
+            .onChange(of: colorScheme) { _, _ in updateTexture(for: geometry.size, force: true) }
+            .onChange(of: geometry.size, initial: true) { _, size in
+                updateTexture(for: size)
+            }
+        }
+        .allowsHitTesting(false)
+        .accessibilityHidden(true)
+    }
+
+    private func updateTexture(for size: CGSize, force: Bool = false) {
+        guard size.width.isFinite, size.height.isFinite,
+              size.width > 0, size.height > 0 else { return }
+        if !force, let texture, CGFloat(texture.width) >= size.width,
+           CGFloat(texture.height) >= size.height { return }
+        let width = max(texture?.width ?? 0, Int(ceil(size.width / 256)) * 256)
+        let height = max(texture?.height ?? 0, Int(ceil(size.height / 256)) * 256)
+        let noise = CIFilter.randomGenerator()
+        let monochrome = CIFilter.colorControls()
+        monochrome.inputImage = noise.outputImage
+        monochrome.saturation = 0
+        // RGB noise averaged into luminance clusters around middle gray. Expand
+        // that range before blending so grain remains visible on quiet surfaces.
+        monochrome.contrast = 2.5
+        guard var output = monochrome.outputImage else { return }
+        if let first = colors.first, let last = colors.last {
+            let tint = CIFilter.falseColor()
+            tint.inputImage = output.applyingFilter("CIColorClamp", parameters: [
+                "inputMinComponents": CIVector(x: 0, y: 0, z: 0, w: 1),
+                "inputMaxComponents": CIVector(x: 1, y: 1, z: 1, w: 1)
+            ])
+            let appearance = NSAppearance(named: colorScheme == .dark ? .darkAqua : .aqua)!
+            appearance.performAsCurrentDrawingAppearance {
+                tint.color0 = CIColor(cgColor: NSColor(first).cgColor)
+                tint.color1 = CIColor(cgColor: NSColor(last).cgColor)
+            }
+            output = tint.outputImage ?? output
+        }
+        texture = Self.context.createCGImage(output,
+            from: CGRect(x: 0, y: 0, width: width, height: height))
+    }
+}
