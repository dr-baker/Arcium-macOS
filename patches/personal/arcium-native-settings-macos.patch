+#!/usr/bin/env python3
+"""Build the vendored Arcium SettingsUI Swift product for a GN action.
+
+The GN target passes every resource file it intends to install.  Keeping that
+list explicit makes both the action outputs and the final bundle contents
+reviewable; this helper does not copy an unbounded SwiftPM output directory.
+Code signing remains the enclosing Chromium macOS bundle's responsibility.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+from pathlib import Path, PurePosixPath
+import shutil
+import subprocess
+import sys
+import tempfile
+from typing import Iterable
+
+
+class BuildError(RuntimeError):
+  pass
+
+
+def _parse_args() -> argparse.Namespace:
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--package-dir', required=True,
+                      help='Swift package directory containing Package.swift.')
+  parser.add_argument('--scratch-path', required=True,
+                      help='SwiftPM scratch path owned by this GN action.')
+  parser.add_argument('--output-dir', required=True,
+                      help='Staged GN output directory.')
+  parser.add_argument('--sdk', help='Selected macOS SDK path from GN.')
+  parser.add_argument('--product', default='ArciumSettingsUI',
+                      help='Dynamic SwiftPM product to copy.')
+  parser.add_argument('--arch', choices=('arm64', 'x86_64'), required=True)
+  parser.add_argument('--jobs', type=int, default=2,
+                      help='Maximum number of SwiftPM build jobs (default: 2).')
+  parser.add_argument('--configuration', default='release',
+                      choices=('debug', 'release'))
+  parser.add_argument('--swift',
+                      help='Swift executable; defaults to SWIFT_EXECUTABLE, swift, or xcrun.')
+  parser.add_argument(
+      '--resource-file', action='append', default=[],
+      help=('Bundle-relative resource path emitted by SwiftPM, for example '
+            'ColorTokensKit_ColorTokensKit.bundle/ColorPalettes.json. Repeat for '
+            'each file that GN will install.'))
+  return parser.parse_args()
+
+
+def _resolve(path: str) -> Path:
+  return Path(path).expanduser().resolve()
+
+
+def _swift_command(explicit: str | None) -> list[str]:
+  if explicit:
+    return [explicit]
+  env_path = os.environ.get('SWIFT_EXECUTABLE')
+  if env_path:
+    return [env_path]
+  path = shutil.which('swift')
+  if path:
+    return [path]
+  xcrun = shutil.which('xcrun')
+  if xcrun:
+    try:
+      path = subprocess.check_output(
+          [xcrun, '--find', 'swift'], text=True).strip()
+    except (OSError, subprocess.CalledProcessError) as error:
+      raise BuildError('xcrun could not locate swift') from error
+    if path:
+      return [path]
+  raise BuildError('could not locate Swift; pass --swift or set SWIFT_EXECUTABLE')
+
+
+def _run(command: list[str]) -> None:
+  try:
+    subprocess.run(command, check=True)
+  except OSError as error:
+    raise BuildError(f'could not execute {command[0]}: {error}') from error
+  except subprocess.CalledProcessError as error:
+    raise BuildError(f'SwiftPM failed with exit status {error.returncode}') from error
+
+
+def _show_bin_path(swift: list[str], package: Path, scratch: Path,
+                   configuration: str, arch: str, jobs: int) -> Path:
+  command = swift + [
+      'build', '--package-path', str(package), '--scratch-path', str(scratch),
+      '--configuration', configuration, '--arch', arch,
+      '--jobs', str(jobs), '--show-bin-path',
+  ]
+  try:
+    result = subprocess.run(command, check=True, capture_output=True,
+                            text=True)
+  except OSError as error:
+    raise BuildError(f'could not execute {command[0]}: {error}') from error
+  except subprocess.CalledProcessError as error:
+    detail = error.stderr.strip()
+    raise BuildError('SwiftPM bin-path query failed' +
+                     (f': {detail}' if detail else '')) from error
+  lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
+  if not lines:
+    raise BuildError('SwiftPM returned no binary output path')
+  path = Path(lines[-1])
+  if not path.is_dir():
+    raise BuildError(f'SwiftPM binary output path does not exist: {path}')
+  return path
+
+
+def _resource_paths(bin_path: Path,
+                    resource_files: Iterable[str]) -> list[tuple[PurePosixPath, Path]]:
+  parsed: list[PurePosixPath] = []
+  for raw in resource_files:
+    rel = PurePosixPath(raw)
+    if (rel.is_absolute() or '..' in rel.parts or len(rel.parts) < 2 or
+        not rel.parts[0].endswith('.bundle')):
+      raise BuildError(f'invalid --resource-file path: {raw}')
+    if rel in parsed:
+      raise BuildError(f'duplicate --resource-file path: {raw}')
+    parsed.append(rel)
+
+  if not parsed:
+    raise BuildError('at least one --resource-file is required')
+
+  by_bundle: dict[str, set[PurePosixPath]] = {}
+  resolved: list[tuple[PurePosixPath, Path]] = []
+  for rel in parsed:
+    bundle_name = rel.parts[0]
+    bundle = bin_path / bundle_name
+    source = bin_path.joinpath(*rel.parts)
+    if not bundle.is_dir():
+      raise BuildError(f'SwiftPM resource bundle is missing: {bundle}')
+    if not source.is_file() or source.is_symlink():
+      raise BuildError(f'SwiftPM resource file is missing or not regular: {source}')
+    by_bundle.setdefault(bundle_name, set()).add(PurePosixPath(*rel.parts[1:]))
+    resolved.append((rel, source))
+
+  # Refuse silently dropping newly-added package resources or whole bundles.
+  # GN must list every file so incremental builds and bundle manifests stay
+  # complete.
+  discovered = {
+      candidate.name for candidate in bin_path.iterdir()
+      if candidate.is_dir() and not candidate.is_symlink() and
+      candidate.name.endswith('.bundle')
+  }
+  requested = set(by_bundle)
+  missing_bundles = sorted(discovered - requested)
+  if missing_bundles:
+    raise BuildError(
+        'unlisted SwiftPM resource bundles: ' + ', '.join(missing_bundles))
+  for bundle_name, expected in by_bundle.items():
+    bundle = bin_path / bundle_name
+    actual: set[PurePosixPath] = set()
+    for candidate in bundle.rglob('*'):
+      if candidate.is_file():
+        if candidate.is_symlink():
+          raise BuildError(f'SwiftPM resource is a symlink: {candidate}')
+        actual.add(PurePosixPath(*candidate.relative_to(bundle).parts))
+    missing = sorted(expected - actual)
+    extra = sorted(actual - expected)
+    if missing or extra:
+      message = [f'resource manifest mismatch for {bundle_name}']
+      if missing:
+        message.append('missing: ' + ', '.join(map(str, missing)))
+      if extra:
+        message.append('unlisted: ' + ', '.join(map(str, extra)))
+      raise BuildError('; '.join(message))
+  return resolved
+
+
+def _copy_outputs(product: str, output: Path,
+                  dylib: Path,
+                  resources: list[tuple[PurePosixPath, Path]]) -> None:
+  output.mkdir(parents=True, exist_ok=True)
+  with tempfile.TemporaryDirectory(prefix='.arcium-settings-ui-',
+                                    dir=output.parent) as temporary:
+    stage = Path(temporary)
+    staged_dylib = stage / f'lib{product}.dylib'
+    shutil.copy2(dylib, staged_dylib)
+    for rel, source in resources:
+      destination = stage.joinpath(*rel.parts)
+      destination.parent.mkdir(parents=True, exist_ok=True)
+      shutil.copy2(source, destination)
+
+    final_dylib = output / staged_dylib.name
+    if final_dylib.exists() or final_dylib.is_symlink():
+      final_dylib.unlink()
+    os.replace(staged_dylib, final_dylib)
+
+    bundles = sorted({rel.parts[0] for rel, _ in resources})
+    for bundle_name in bundles:
+      destination = output / bundle_name
+      if destination.exists() or destination.is_symlink():
+        if destination.is_dir() and not destination.is_symlink():
+          shutil.rmtree(destination)
+        else:
+          destination.unlink()
+      os.replace(stage / bundle_name, destination)
+
+
+def main() -> int:
+  args = _parse_args()
+  if args.jobs <= 0:
+    raise BuildError('--jobs must be positive')
+  package = _resolve(args.package_dir)
+  scratch = _resolve(args.scratch_path)
+  output = _resolve(args.output_dir)
+  if not (package / 'Package.swift').is_file():
+    raise BuildError(f'Package.swift is missing from {package}')
+  scratch.mkdir(parents=True, exist_ok=True)
+  swift = _swift_command(args.swift)
+  build = swift + [
+      'build', '--package-path', str(package), '--scratch-path', str(scratch),
+      '--configuration', args.configuration, '--arch', args.arch,
+      '--product', args.product, '--jobs', str(args.jobs),
+  ]
+  if args.sdk:
+    build += ['--sdk', str(_resolve(args.sdk))]
+  _run(build)
+  bin_path = _show_bin_path(
+      swift, package, scratch, args.configuration, args.arch, args.jobs)
+  dylib = bin_path / f'lib{args.product}.dylib'
+  if not dylib.is_file() or dylib.is_symlink():
+    raise BuildError(f'dynamic product was not emitted: {dylib}')
+  resources = _resource_paths(bin_path, args.resource_file)
+  _copy_outputs(args.product, output, dylib, resources)
+  return 0
+
+
+if __name__ == '__main__':
+  try:
+    raise SystemExit(main())
+  except BuildError as error:
+    print(f'arcium settings UI build: error: {error}', file=sys.stderr)
+    raise SystemExit(1)
