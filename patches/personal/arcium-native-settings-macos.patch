+struct SettingsChromeVisualState {
+  ui::ColorProviderKey::ColorMode color_mode =
+      ui::ColorProviderKey::ColorMode::kLight;
+  SkColor theme_color = SK_ColorWHITE;
+};
+
+bool IsMatchingNormalBrowser(BrowserWindowInterface* browser,
+                             const Profile* profile) {
+  Profile* browser_profile = browser ? browser->GetProfile() : nullptr;
+  if (!browser_profile || !profile || browser_profile != profile ||
+      browser_profile->GetOriginalProfile() != profile) {
+    return false;
+  }
+
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  return browser_view && browser_view->GetIsNormalType();
+}
+
+std::optional<SettingsChromeVisualState> GetBrowserChromeVisualState(
+    Profile* profile) {
+  if (!profile) {
+    return std::nullopt;
+  }
+
+  GlobalBrowserCollection* collection = GlobalBrowserCollection::GetInstance();
+  if (collection) {
+    std::optional<SettingsChromeVisualState> result;
+    collection->ForEach(
+        [&result, profile](BrowserWindowInterface* browser) {
+          if (!IsMatchingNormalBrowser(browser, profile)) {
+            return true;
+          }
+
+          BrowserView* browser_view =
+              BrowserView::GetBrowserViewForBrowser(browser);
+          views::Widget* widget = browser_view ? browser_view->GetWidget()
+                                                : nullptr;
+          const ui::ColorProvider* color_provider =
+              widget ? widget->GetColorProvider() : nullptr;
+          if (!color_provider) {
+            return true;
+          }
+
+          SettingsChromeVisualState state;
+          state.color_mode = widget->GetColorMode();
+          state.theme_color = color_provider->GetColor(kColorToolbar);
+          if (auto palette_color = arcium_settings::GetSharedPaletteChromeColor(
+                  profile, state.color_mode ==
+                              ui::ColorProviderKey::ColorMode::kDark)) {
+            state.theme_color = *palette_color;
+          }
+          result = state;
+          return false;
+        },
+        BrowserCollection::Order::kActivation);
+    if (result.has_value()) {
+      return result;
+    }
+  }
+
+  // Without a browser window, use the public theme-service fallback. Normal
+  // browser windows above remain the authority for their resolved toolbar color.
+  ThemeService* theme_service = ThemeServiceFactory::GetForProfile(profile);
+  if (!theme_service) {
+    return std::nullopt;
+  }
+
+  const bool is_dark = theme_service->BrowserUsesDarkColors();
+  const ui::ColorProvider* color_provider = theme_service->GetColorProvider();
+
+  SettingsChromeVisualState state;
+  state.color_mode = is_dark ? ui::ColorProviderKey::ColorMode::kDark
+                             : ui::ColorProviderKey::ColorMode::kLight;
+  if (color_provider) {
+    state.theme_color = color_provider->GetColor(kColorToolbar);
+  }
+  if (auto palette_color = arcium_settings::GetSharedPaletteChromeColor(
+          profile, is_dark)) {
+    state.theme_color = *palette_color;
+  }
+  return state;
+}
+
+void SetSettingsWindowGlassState(NSWindow* window, bool enabled) {
+  if (!window) {
+    return;
+  }
+
+  // Match BrowserNativeWidgetMac. A fully clear window background makes
+  // AppKit continuously invalidate the surface; alpha 0.001 remains
+  // visually clear while keeping the window stable.
+  [window setBackgroundColor:
+               enabled ? [[NSColor windowBackgroundColor]
+                              colorWithAlphaComponent:0.001]
+                       : [NSColor windowBackgroundColor]];
+  [window setOpaque:!enabled];
+}
