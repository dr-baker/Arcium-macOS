+      @"canModify" : @(service->CanModifyConfiguration()),
+      @"commands" : commands,
+      @"arcSupportedCount" : @(report.supported.size()),
+      @"arcUnavailable" : unavailable,
+      @"hasPrevious" : @(model->HasPreviousArcPreset()),
+      @"recordingCommandID" : recording_button_ ? @(recording_button_.commandID)
+                                                : @(-1),
+    };
+    return @{
+      @"available" : @(available),
+      @"general" : general,
+      @"tabs" : tabs,
+      @"spaces" : spaces,
+      @"appearance" : appearance,
+      @"shortcuts" : shortcuts,
+    };
+  }
+
+  NSDictionary* shortcuts = @{
+    @"availableSection" : @(available),
+    @"available" : @NO,
+    @"canModify" : @NO,
+    @"commands" : @[],
+    @"arcSupportedCount" : @0,
+    @"arcUnavailable" : @[],
+    @"hasPrevious" : @NO,
+    @"recordingCommandID" : @(-1),
+  };
+  return @{
+    @"available" : @(available),
+    @"general" : general,
+    @"tabs" : tabs,
+    @"spaces" : spaces,
+    @"appearance" : appearance,
+    @"shortcuts" : shortcuts,
+  };
+}
