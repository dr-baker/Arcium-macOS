+            fillOpacity: isSelected ? 0.64 : theme.controlTintOpacity,
+            border: isSelected ? theme.controlSelectionBorder : theme.controlSurfaceBorder,
+            shadowColor: theme.shadowAmbient.opacity(isHovered ? 0.12 : 0.05),
