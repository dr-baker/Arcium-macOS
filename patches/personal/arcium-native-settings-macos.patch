+        overrideActive = strictBoolean(dictionary["overrideActive"]) ?? false
+        accent = string(dictionary["accent"]).flatMap { SettingsRGB(hex: $0)?.hex }
+        if overrideActive,
+           let raw = dictionary["configuration"],
+           JSONSerialization.isValidJSONObject(raw),
+           let data = try? JSONSerialization.data(withJSONObject: raw) {
+            if let candidate = try? JSONDecoder().decode(SettingsPaletteConfiguration.self, from: data),
+               isValidSharedPalette(candidate) { configuration = candidate }
+        }
+    }
