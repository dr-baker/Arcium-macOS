+private struct ChromeAppearancePreview: View {
+    let configuration: ArciumChromeAppearanceConfiguration
+    let selectedPointID: String?
+    let editable: Bool
+    let effectsAvailable: Bool
+    let selectPoint: (String) -> Void
+    let editPoint: (String) -> Void
+    let movePoint: (String, CGPoint, CGSize, Bool) -> Void
+    let movePointByAccessibility: (String, Double, Double) -> Void
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        GeometryReader { geometry in
+            ZStack(alignment: .topLeading) {
+                // The whole field previews window colors and grain; it is not page content.
+                theme.windowCanvas
+                ForEach(configuration.points, id: \.id) { point in
+                    RadialGradient(
+                        colors: [
+                            point.color.opacity(
+                                configuration.enabled && effectsAvailable
+                                    ? point.opacity * configuration.tintStrength
+                                    : 0
+                            ),
+                            .clear
+                        ],
+                        center: UnitPoint(x: point.x, y: point.y),
+                        startRadius: 0,
+                        endRadius: min(geometry.size.width, geometry.size.height) * point.radius
+                    )
+                    .allowsHitTesting(false)
+                }
+                previewGrainOverlay
+
+                ForEach(Array(configuration.points.enumerated()), id: \.element.id) { index, point in
+                    ChromeAppearancePointMarker(
+                        point: point,
+                        index: index,
+                        isSelected: point.id == selectedPointID || configuration.matchColorAdjustments,
+                        size: geometry.size,
+                        editable: editable,
+                        select: { selectPoint(point.id) },
+                        edit: { editPoint(point.id) },
+                        move: movePoint,
+                        moveByAccessibility: movePointByAccessibility
+                    )
+                    .position(
+                        x: point.x * geometry.size.width,
+                        y: point.y * geometry.size.height
+                    )
+                }
+            }
+            .coordinateSpace(name: "arcium-chrome-preview")
+            .clipShape(RoundedRectangle(cornerRadius: 13, style: .continuous))
+            .overlay {
+                RoundedRectangle(cornerRadius: 13, style: .continuous)
+                    .stroke(theme.borderSubtle, lineWidth: theme.borderWidth)
+            }
+        }
+        .frame(height: 232)
+        .accessibilityElement(children: .contain)
+        .accessibilityLabel("Window color placement")
+    }
+
+    private var previewFinish: SettingsBackdropFinish {
+        SettingsBackdropFinish(
+            opacity: 1,
+            saturation: 1,
+            grain: configuration.enabled && effectsAvailable ? configuration.grain : 0,
+            vignette: 0,
+            grainColors: []
+        )
+    }
+
+    @ViewBuilder private var previewGrainOverlay: some View {
+        GeometryReader { geometry in
+            SettingsBackdropGrainOverlay(finish: previewFinish)
+                .frame(
+                    width: geometry.size.width * 2,
+                    height: geometry.size.height * 2
+                )
+                .scaleEffect(CGFloat(configuration.grainScale), anchor: .center)
+                .frame(width: geometry.size.width, height: geometry.size.height)
+                .clipped()
+        }
+    }
+
+}
