+}
+
+- (instancetype)initWithProfile:(Profile*)profile {
+  if (!profile) {
+    return nil;
+  }
+
+  NSWindow* window = [[NSWindow alloc]
+      initWithContentRect:NSMakeRect(0, 0, 860, 650)
+                styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                          NSWindowStyleMaskResizable |
+                          NSWindowStyleMaskMiniaturizable |
+                          NSWindowStyleMaskFullSizeContentView
+                  backing:NSBackingStoreBuffered
+                    defer:NO];
+  self = [super initWithWindow:window];
+  if (!self) {
+    return nil;
+  }
+
+  original_window_appearance_ = window.appearance;
+  profile_ = profile;
+  profile_key_ = SettingsProfileKey(profile);
+  profile_keep_alive_ = ScopedProfileKeepAlive::TryAcquire(
+      profile_, ProfileKeepAliveOrigin::kArciumSettingsWindow);
+  if (!profile_keep_alive_) {
+    return nil;
+  }
+
+  window.delegate = self;
+  window.title = @"Settings";
+  window.titleVisibility = NSWindowTitleHidden;
+  window.titlebarAppearsTransparent = YES;
+  window.toolbar = nil;
+  window.titlebarSeparatorStyle = NSTitlebarSeparatorStyleNone;
+  window.minSize = NSMakeSize(650, 500);
+  window.contentMinSize = NSMakeSize(650, 500);
+  window.restorable = NO;
+
+  model_ = std::make_unique<arcium_settings::ArciumSettingsModel>(
+      profile_,
+      base::BindRepeating(&SettingsModelChanged, (__bridge void*)self),
+      base::BindRepeating(&SettingsModelProfileWillBeDestroyed,
+                          (__bridge void*)self));
+
+  __weak ArciumSettingsWindowController* weak_self = self;
+  accessibility_notification_token_ =
+      [NSWorkspace.sharedWorkspace.notificationCenter
+          addObserverForName:
+              NSWorkspaceAccessibilityDisplayOptionsDidChangeNotification
+                      object:nil
+                       queue:NSOperationQueue.mainQueue
+                  usingBlock:^(NSNotification* notification) {
+                    [weak_self modelDidChange];
+                  }];
+
+  if (![self buildWindow]) {
+    return nil;
+  }
+  [window center];
+  return self;
+}
