+- (void)publishSnapshot {
+  if (profile_destroying_ || !settings_ui_controller_) {
+    return;
+  }
+  SEL update_selector =
+      NSSelectorFromString(kArciumSettingsUIUpdateSnapshotSelector);
+  if (![settings_ui_controller_ respondsToSelector:update_selector]) {
+    return;
+  }
+  using UpdateSnapshot = void (*)(id, SEL, NSDictionary*);
+  reinterpret_cast<UpdateSnapshot>(objc_msgSend)(
+      settings_ui_controller_, update_selector, [self settingsSnapshot]);
+}
+
+- (void)modelDidChange {
+  if (profile_destroying_ || window_closing_ || model_change_scheduled_ ||
+      native_background_update_in_progress_) {
+    return;
+  }
+  model_change_scheduled_ = YES;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    if (!self || self->profile_destroying_ || self->window_closing_) {
+      return;
+    }
+    self->model_change_scheduled_ = NO;
+    [self updateNativeGlassBackground];
+    [self publishSnapshot];
+  });
+}
