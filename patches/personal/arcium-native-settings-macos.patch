+import SwiftUI
+
+/// A connected row of choices with optional, non-blocking recommendations.
+public struct SConnectedPicker<Value: Hashable>: View {
+    private let title: String
+    @Binding private var selection: Value
+    private let options: [(Value, String)]
+    private let recommendation: (Value) -> String?
+    @Environment(\.settingsTheme) private var theme
+
+    /// Return a reason for discouraged choices; nil means recommended.
+    public init(_ title: String, selection: Binding<Value>, options: [(Value, String)],
+                discouragedReason: @escaping (Value) -> String? = { _ in nil }) {
+        self.title = title
+        _selection = selection
+        self.options = options
+        recommendation = discouragedReason
+    }
+
+    public var body: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.sm) {
+            Text(title).settingsFont(\.body)
+            ViewThatFits(in: .horizontal) {
+                choices
+                ScrollView(.horizontal) { choices }
+                    .scrollIndicators(.hidden)
+            }
+        }
+        .accessibilityElement(children: .contain)
+        .accessibilityLabel(title)
+    }
+
+    private var choices: some View {
+        HStack(spacing: 0) {
+            ForEach(options.indices, id: \.self) { index in
+                let option = options[index]
+                let selected = selection == option.0
+                let reason = recommendation(option.0)
+                if index > 0 {
+                    Rectangle().fill(theme.borderSubtle).frame(width: 0.5)
+                }
+                Button { selection = option.0 } label: {
+                    Text(option.1)
+                        .settingsFont(\.body)
+                        .lineLimit(1)
+                        .fixedSize(horizontal: true, vertical: false)
+                        .foregroundStyle(selected ? theme.accent : theme.textPrimary)
+                        .opacity(reason == nil ? 1 : (selected ? 0.7 : 0.4))
+                        .padding(.horizontal, 12)
+                        .frame(maxWidth: .infinity, minHeight: 32)
+                        .background(selected ? theme.accent.opacity(0.15) : .clear)
+                        .contentShape(.rect)
+                }
+                .buttonStyle(.plain)
+                .accessibilityLabel(option.1)
+                .accessibilityAddTraits(selected ? .isSelected : [])
+                .accessibilityHint(reason ?? "")
+                .help(reason ?? option.1)
+            }
+        }
+        .fixedSize(horizontal: false, vertical: true)
+        .background(theme.control.opacity(0.35))
+        .clipShape(.rect(cornerRadius: 7))
+        .overlay {
+            RoundedRectangle(cornerRadius: 7).strokeBorder(theme.borderSubtle, lineWidth: 0.5)
+                .allowsHitTesting(false)
+        }
+    }
+}
