+                            .help("Remove selected color")
+                            .disabled(onRemoveColor == nil || draftColors.count <= 1)
+                            Text("\(draftColors.count)")
+                                .settingsFont(\.smallNumeric)
+                                .foregroundStyle(theme.textSecondary)
+                                .frame(minWidth: 20)
+                                .accessibilityLabel("Color count")
+                                .accessibilityValue("\(draftColors.count) colors")
+                            Button("Add color", systemImage: "plus") {
+                                onAddColor?()
+                            }
+                            .labelStyle(.iconOnly)
+                            .buttonStyle(.borderless)
+                            .settingsSymbol()
+                            .help("Add color")
+                            .disabled(onAddColor == nil || draftColors.count >= 4)
+                        }
+                    }
+                    Spacer(minLength: SettingsSpacing.sm)
