+import SwiftUI
+
+/// Displays short category sets horizontally and uses a menu when they do not fit.
+/// Selection validity belongs to the application, which owns the available categories.
+public struct SettingsCategoryBar<Category: Identifiable>: View where Category.ID: Hashable {
+    @Environment(\.settingsTheme) private var theme
+    private let categories: [Category]
+    @Binding private var selection: Category.ID
+    private let title: (Category) -> String
+    private let symbol: (Category) -> String
+    private let help: (Category) -> String
+
+    public init(
+        categories: [Category],
+        selection: Binding<Category.ID>,
+        title: @escaping (Category) -> String,
+        symbol: @escaping (Category) -> String,
+        help: @escaping (Category) -> String = { _ in "" }
+    ) {
+        self.categories = categories
+        _selection = selection
+        self.title = title
+        self.symbol = symbol
+        self.help = help
+    }
+
+    public var body: some View {
+        if categories.count > 1 {
+            ViewThatFits(in: .horizontal) {
+                HStack(spacing: SettingsSpacing.xs) {
+                    ForEach(categories) { category in
+                        Button { selection = category.id } label: {
+                            Label(title(category), systemImage: symbol(category))
+                                .labelStyle(SettingsIconLabelStyle())
+                                .settingsFont(\.smallCaption)
+                                .lineLimit(1)
+                                .padding(.horizontal, SettingsSpacing.sm)
+                                .padding(.vertical, SettingsSpacing.xs)
+                        }
+                        .buttonStyle(.bordered)
+                        .tint(selection == category.id ? theme.accent : theme.textSecondary)
+                        .help(help(category))
+                        .accessibilityAddTraits(selection == category.id ? .isSelected : [])
+                    }
+                }
+                .fixedSize(horizontal: true, vertical: false)
+                Picker("Category", selection: $selection) {
+                    ForEach(categories) { category in Text(title(category)).tag(category.id) }
+                }
+                .pickerStyle(.menu)
+                .accessibilityLabel("Category")
+            }
+        }
+    }
+}
