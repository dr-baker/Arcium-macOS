+import Foundation
+import XCTest
+@testable import ArciumSettingsUI
+import SettingsUI
+
+final class ArciumSettingsUIContractTests: XCTestCase {
+    @MainActor
+    func testRandomPlacementPreservesGlowPropertiesAndKeepsPointsSeparated() {
+        var points = ArciumChromeAppearanceConfiguration.defaultPoints
+        points.append(.init(id: "third", colorHex: "#FF5500", x: 0, y: 1, radius: 0.7, opacity: 0.3))
+        points.append(.init(id: "fourth", colorHex: "#55FF00", x: 1, y: 0, radius: 0.6, opacity: 0.2))
+        for samples in [Array(repeating: 0.0, count: 8), Array(repeating: 1.0, count: 8), [.nan, .infinity]] {
+            let result = ArciumChromeAppearanceEditor.randomizedPointPositions(points, randomValues: samples)
+            XCTAssertEqual(result.count, points.count)
+            for (index, point) in result.enumerated() {
+                XCTAssertTrue((0.14...0.86).contains(point.x))
+                XCTAssertTrue((0.14...0.86).contains(point.y))
+                var restored = point
+                restored.x = points[index].x
+                restored.y = points[index].y
+                XCTAssertEqual(restored, points[index])
+                for other in result.dropFirst(index + 1) {
