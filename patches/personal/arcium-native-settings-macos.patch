+import AppKit
+import SwiftUI
+
+/// A low-contrast animated backdrop that follows the hosting window lifecycle.
+public struct SettingsBackdrop: View {
+    private let colorField: SettingsColorField
+    private let usesRetainedRenderer: Bool
+    private let animationSpeed: Double
+    private let framesPerSecond: Double
+    private let onTimelineUpdate: ((Date) -> Void)?
+    private let finish: SettingsBackdropFinish
+    private let glows: [SettingsBackdropGlow]?
+    private let motion: SettingsBackdropMotion
+    private let preferredColorScheme: ColorScheme?
+    private let animationEnabled: Bool
+    private let isInteractionEngaged: Bool
+
+    @Environment(\.accessibilityReduceMotion) private var accessibilityReduceMotion
+    @Environment(\.colorScheme) private var systemColorScheme
+    @State private var lifecycleState = SettingsBackdropLifecycleState.inactive
+
+    public init(
+        colorScheme: ColorScheme? = nil,
+        colorField: SettingsColorField = .window,
+        usesRetainedRenderer: Bool = true,
+        glows: [SettingsBackdropGlow]? = nil,
+        finish: SettingsBackdropFinish = .init(),
+        motion: SettingsBackdropMotion = .init(),
+        animationEnabled: Bool = false,
+        isInteractionEngaged: Bool = false,
+        animationSpeed: Double = 1,
+        framesPerSecond: Double = 24,
+        onTimelineUpdate: ((Date) -> Void)? = nil
+    ) {
+        self.colorField = colorField
+        self.usesRetainedRenderer = usesRetainedRenderer
+        self.animationSpeed = animationSpeed.isFinite ? min(max(animationSpeed, 0.1), 24) : 1
+        self.framesPerSecond = framesPerSecond.isFinite ? min(max(framesPerSecond, 1), 60) : 24
+        self.onTimelineUpdate = onTimelineUpdate
+        self.finish = finish
+        self.glows = glows
+        self.motion = motion
+        preferredColorScheme = colorScheme
+        self.animationEnabled = animationEnabled
+        self.isInteractionEngaged = isInteractionEngaged
+    }
+
+    private var effectiveColorScheme: ColorScheme {
+        preferredColorScheme ?? systemColorScheme
+    }
+
+    private var isDark: Bool {
+        effectiveColorScheme == .dark
+    }
+
+    private var baseWashOpacity: Double {
+        isDark ? 0.10 : 0.05
+    }
+
+    private var bloomOpacity: Double {
+        isDark ? 0.036 : 0.027
+    }
+
+    private var shouldTick: Bool {
+        SettingsBackdropAnimationPolicy.shouldTick(
+            animationEnabled: animationEnabled,
+            isInteractionEngaged: isInteractionEngaged,
+            accessibilityReduceMotion: accessibilityReduceMotion,
+            lifecycleState: lifecycleState
+        )
+    }
+
+    public var body: some View {
+        Group {
+            if colorField == .display, let glows {
+                SettingsDisplayBackdrop { size in
+                    SettingsBackdrop(colorScheme: effectiveColorScheme,
+                        usesRetainedRenderer: usesRetainedRenderer,
+                        glows: displayGlows(glows, size: size), motion: motion,
+                        animationEnabled: animationEnabled, isInteractionEngaged: isInteractionEngaged,
+                        animationSpeed: animationSpeed, framesPerSecond: framesPerSecond,
+                        onTimelineUpdate: onTimelineUpdate)
+                        .frame(width: size.width, height: size.height)
+                }
+            } else if usesRetainedRenderer, let glows {
+                SettingsRetainedBackdrop(glows: glows, motion: motion,
+                    animated: animationEnabled && !accessibilityReduceMotion,
+                    running: shouldTick, speed: animationSpeed, scheme: effectiveColorScheme)
+            } else if animationEnabled && !accessibilityReduceMotion {
+                // Keep the animated layer mounted while temporarily paused so
+                // interaction and window lifecycle changes hold its last frame.
+                TimelineView(.animation(minimumInterval: 1.0 / framesPerSecond, paused: !shouldTick)) { context in
+                    renderedFrame(phase: context.date.timeIntervalSinceReferenceDate * animationSpeed)
+                        .onChange(of: context.date) { _, date in
+                            if shouldTick { onTimelineUpdate?(date) }
+                        }
+                }
+            } else {
+                renderedFrame(phase: 0)
+            }
+        }
+        .modifier(SettingsBackdropFinishModifier(finish: finish, colorScheme: effectiveColorScheme))
+        .accessibilityHidden(true)
+        .allowsHitTesting(false)
+        .background {
+            SettingsBackdropLifecycleReader { lifecycleState = $0 }
+                .frame(width: 0, height: 0)
+        }
+    }
+
+    private func displayGlows(_ seeds: [SettingsBackdropGlow], size: CGSize) -> [SettingsBackdropGlow] {
+        SettingsDisplayFieldLayout.points(size: size, colorCount: seeds.count).enumerated().map { index, item in
+            let seed = seeds[item.color]
+            return SettingsBackdropGlow(id: "display-\(index)", color: seed.color,
+                x: item.point.x / size.width, y: item.point.y / size.height,
+                radius: seed.radius * 1_000 / max(size.width, size.height),
+                intensity: seed.intensity * 0.65)
+        }
+    }
+
+    @ViewBuilder
+    private func renderedFrame(phase: Double) -> some View {
+        if let glows {
+            GeometryReader { geometry in
+                ZStack {
+                    ForEach(glows.indices, id: \.self) { index in
+                        let glow = glows[index]
+                        let sample = motion.sample(
+                            phase: phase,
+                            index: index,
+                            isAnimated: animationEnabled && !accessibilityReduceMotion
+                        )
+                        RadialGradient(
+                            colors: [
+                                glow.color.opacity(bounded(
+                                    glow.intensity * sample.opacityMultiplier,
+                                    range: 0...1
+                                )),
+                                .clear
+                            ],
+                            center: UnitPoint(
+                                x: bounded(glow.x, range: 0...1) + sample.xOffset,
+                                y: bounded(glow.y, range: 0...1) + sample.yOffset
+                            ),
+                            startRadius: 0,
+                            endRadius: max(geometry.size.width, geometry.size.height) * bounded(glow.radius, range: 0.05...1.5)
+                        )
+                    }
+                }
+            }
+        } else {
+            backdropFrame(phase: phase)
+        }
+    }
+
+    private func bounded(_ value: Double, range: ClosedRange<Double>) -> Double {
+        value.isFinite ? min(max(value, range.lowerBound), range.upperBound) : range.lowerBound
+    }
+
+    private func backdropFrame(phase: Double) -> some View {
+        let slow = phase / 22
+        let slower = phase / 31
+        let isAnimated = animationEnabled && !accessibilityReduceMotion
+        let travelScale = motion.travel / 0.10
+        let pulseScale = motion.pulse / 0.15
+
+        return ZStack {
+            LinearGradient(
+                colors: isDark
+                    ? [
+                        Color(red: 0.16, green: 0.06, blue: 0.28).opacity(baseWashOpacity),
+                        Color(red: 0.10, green: 0.07, blue: 0.24).opacity(baseWashOpacity * 0.8),
+                        Color(red: 0.05, green: 0.12, blue: 0.22).opacity(baseWashOpacity * 0.65)
+                    ]
+                    : [
+                        Color(red: 0.55, green: 0.12, blue: 0.28).opacity(baseWashOpacity),
+                        Color(red: 0.45, green: 0.12, blue: 0.26).opacity(baseWashOpacity * 0.8),
+                        Color(red: 0.32, green: 0.16, blue: 0.26).opacity(baseWashOpacity * 0.65)
+                    ],
+                startPoint: .top,
+                endPoint: .bottom
+            )
+
+            RadialGradient(
+                colors: [
+                    (isDark ? Color(red: 0.66, green: 0.20, blue: 0.36) : Color(red: 0.90, green: 0.26, blue: 0.66)).opacity(bounded(
+                        bloomOpacity * motion.strength * pulse(slow, amount: 0.12 * pulseScale, isAnimated: isAnimated),
+                        range: 0...1
+                    )),
+                    .clear
+                ],
+                center: UnitPoint(
+                    x: bounded(0.04 + oscillation(sin(slow) * 0.025 * travelScale, isAnimated: isAnimated), range: 0...1),
+                    y: bounded(0.08 + oscillation(cos(slower) * 0.025 * travelScale, isAnimated: isAnimated), range: 0...1)
+                ),
+                startRadius: 24,
+                endRadius: 520
+            )
+
+            RadialGradient(
+                colors: [
+                    (isDark ? Color(red: 0.46, green: 0.24, blue: 0.74) : Color(red: 0.68, green: 0.24, blue: 0.56)).opacity(bounded(
+                        bloomOpacity * 0.9 * motion.strength * pulse(slower, amount: 0.10 * pulseScale, isAnimated: isAnimated),
+                        range: 0...1
+                    )),
+                    .clear
+                ],
+                center: UnitPoint(
+                    x: bounded(0.78 + oscillation(cos(slower) * 0.025 * travelScale, isAnimated: isAnimated), range: 0...1),
+                    y: bounded(0.22 + oscillation(sin(slow) * 0.02 * travelScale, isAnimated: isAnimated), range: 0...1)
+                ),
+                startRadius: 20,
+                endRadius: 460
+            )
+
+            RadialGradient(
+                colors: [
+                    (isDark ? Color(red: 0.20, green: 0.44, blue: 0.78) : Color(red: 0.42, green: 0.30, blue: 0.86)).opacity(bounded(
+                        bloomOpacity * 0.78 * motion.strength * pulse(slow + 1.8, amount: 0.10 * pulseScale, isAnimated: isAnimated),
+                        range: 0...1
+                    )),
+                    .clear
+                ],
+                center: UnitPoint(
+                    x: bounded(0.52 + oscillation(sin(slower) * 0.02 * travelScale, isAnimated: isAnimated), range: 0...1),
+                    y: bounded(0.92 + oscillation(cos(slow) * 0.018 * travelScale, isAnimated: isAnimated), range: 0...1)
+                ),
+                startRadius: 30,
+                endRadius: 560
+            )
+        }
+        .ignoresSafeArea()
+    }
+
+    private func oscillation(_ value: Double, isAnimated: Bool) -> Double {
+        isAnimated ? value : 0
+    }
+
+    private func pulse(_ phase: Double, amount: Double, isAnimated: Bool) -> Double {
+        isAnimated ? 1 + sin(phase) * amount : 1
+    }
+}
+
+private struct SettingsBackdropLifecycleReader: NSViewRepresentable {
+    let onChange: (SettingsBackdropLifecycleState) -> Void
+
+    func makeNSView(context: Context) -> SettingsBackdropLifecycleReportingView {
+        let view = SettingsBackdropLifecycleReportingView()
+        view.onChange = onChange
+        return view
+    }
+
+    func updateNSView(_ nsView: SettingsBackdropLifecycleReportingView, context: Context) {
+        nsView.onChange = onChange
+        nsView.reportLifecycleState()
+    }
+}
+
+private final class SettingsBackdropLifecycleReportingView: NSView {
+    var onChange: ((SettingsBackdropLifecycleState) -> Void)?
+
+    private var notificationTokens: [NSObjectProtocol] = []
+    private var lastReportedState: SettingsBackdropLifecycleState?
+
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        tearDownNotifications()
+
+        guard let window = lifecycleWindow else {
+            reportLifecycleState()
+            return
+        }
+
+        let notificationCenter = NotificationCenter.default
+        notificationTokens = [
+            NSWindow.didBecomeKeyNotification,
+            NSWindow.didResignKeyNotification,
+            NSWindow.didChangeOcclusionStateNotification,
+            NSWindow.didMiniaturizeNotification,
+            NSWindow.didDeminiaturizeNotification
+        ].map { name in
+            notificationCenter.addObserver(forName: name, object: window, queue: .main) { @Sendable [weak self] _ in
+                MainActor.assumeIsolated {
+                    self?.reportLifecycleState()
+                }
+            }
+        }
+
+        notificationTokens += [
+            NSApplication.didBecomeActiveNotification,
+            NSApplication.didResignActiveNotification,
+            NSApplication.didHideNotification,
+            NSApplication.didUnhideNotification,
+            NSApplication.didChangeOcclusionStateNotification
+        ].map { name in
+            notificationCenter.addObserver(
+                forName: name,
+                object: NSApplication.shared,
+                queue: .main
+            ) { @Sendable [weak self] _ in
+                MainActor.assumeIsolated {
+                    self?.reportLifecycleState()
+                }
+            }
+        }
+
+        reportLifecycleState()
+    }
+
+    override func removeFromSuperview() {
+        tearDownNotifications()
+        super.removeFromSuperview()
+    }
+
+    deinit {
+        if Thread.isMainThread {
+            MainActor.assumeIsolated { tearDownNotifications() }
+        } else {
+            DispatchQueue.main.sync { tearDownNotifications() }
+        }
+    }
+
+    private var lifecycleWindow: NSWindow? {
+        (window as? SettingsGlowWindow)?.lifecycleOwner ?? window
+    }
+
+    func reportLifecycleState() {
+        let state = lifecycleWindow.map(SettingsBackdropLifecycleState.init(window:)) ?? .inactive
+        guard state != lastReportedState else { return }
+        lastReportedState = state
+
+        // SwiftUI can ask for an NSView update during its own render pass.
+        // Defer the state write so the callback cannot mutate that pass.
+        Task { @MainActor [weak self] in
+            guard self?.lastReportedState == state else { return }
+            self?.onChange?(state)
+        }
+    }
+
+    private func tearDownNotifications() {
+        let notificationCenter = NotificationCenter.default
+        notificationTokens.forEach(notificationCenter.removeObserver)
+        notificationTokens.removeAll()
+    }
+}
