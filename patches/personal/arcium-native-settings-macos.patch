+import AppKit
+import SwiftUI
+
+struct SettingsDisplayBackdrop<Content: View>: NSViewRepresentable {
+    let content: (CGSize) -> Content
+    func makeNSView(context: Context) -> DisplayBackdropView<Content> { DisplayBackdropView() }
+    func updateNSView(_ view: DisplayBackdropView<Content>, context: Context) {
+        view.builder = content
+        view.updateField(refresh: true)
+    }
+    static func dismantleNSView(_ view: DisplayBackdropView<Content>, coordinator: ()) {
+        NotificationCenter.default.removeObserver(view)
+    }
+}
+
+final class DisplayBackdropView<Content: View>: NSView {
+    var builder: ((CGSize) -> Content)?
+    private let fieldContainer = NSView()
+    private var host: NSHostingView<Content>?
+    private var fieldSize = CGSize.zero
+    private var fieldOffset: CGPoint?
+    override var isFlipped: Bool { true }
+    override init(frame: NSRect) {
+        super.init(frame: frame)
+        wantsLayer = true
+        layer?.masksToBounds = true
+        fieldContainer.wantsLayer = true
+        addSubview(fieldContainer)
+    }
+    required init?(coder: NSCoder) { nil }
+    override func hitTest(_ point: NSPoint) -> NSView? { nil }
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        NotificationCenter.default.removeObserver(self)
+        if let window {
+            for name in [NSWindow.didMoveNotification, NSWindow.didResizeNotification, NSWindow.didChangeScreenNotification] {
+                NotificationCenter.default.addObserver(self, selector: #selector(moved), name: name, object: window)
+            }
+        }
+        updateField(refresh: true)
+    }
+    @objc private func moved() { updateField(refresh: false) }
+    override func layout() { super.layout(); updateField(refresh: false) }
+    func updateField(refresh: Bool) {
+        guard let window, let screen = window.screen, let builder else { return }
+        let size = screen.frame.size
+        if host == nil {
+            let host = NSHostingView(rootView: builder(size))
+            host.sizingOptions = []
+            fieldContainer.addSubview(host)
+            self.host = host
+        } else if refresh || size != fieldSize {
+            host?.rootView = builder(size)
+        }
+        if fieldSize != size {
+            fieldContainer.frame = CGRect(origin: .zero, size: size)
+            host?.frame = CGRect(origin: .zero, size: size)
+            fieldSize = size
+        }
+        let visible = window.convertToScreen(convert(bounds, to: nil))
+        // Translate the container's sublayers rather than changing NSHostingView's
+        // frame for every drag event. The hosting view keeps a fixed layout.
+        let offset = CGPoint(x: screen.frame.minX - visible.minX,
+                             y: visible.maxY - screen.frame.maxY)
+        guard fieldOffset != offset else { return }
+        fieldOffset = offset
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        fieldContainer.layer?.transform = CATransform3DMakeTranslation(offset.x, offset.y, 0)
+        CATransaction.commit()
+    }
+}
