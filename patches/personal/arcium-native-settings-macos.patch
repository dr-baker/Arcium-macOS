+import CoreGraphics
+import Foundation
+import SwiftUI
+
+/// Optional decoration applied only to the backdrop, never to settings text.
+public struct SettingsBackdropFinish: Sendable {
+    public var opacity: Double
+    public var saturation: Double
+    public var grain: Double
+    public var vignette: Double
+    /// Optional dark/light noise endpoints. Empty uses monochrome.
+    public var grainColors: [Color]
+    public var grainBlendMode: SettingsGrainBlendMode
+
+    public init(opacity: Double = 1, saturation: Double = 1, grain: Double = 0, vignette: Double = 0, grainBlendMode: SettingsGrainBlendMode = .overlay, grainColors: [Color] = []) {
+        self.opacity = opacity
+        self.saturation = saturation
+        self.grain = grain
+        self.vignette = vignette
+        self.grainBlendMode = grainBlendMode
+        self.grainColors = grainColors
+    }
+}
+
+struct SettingsBackdropFinishModifier: ViewModifier {
+    let finish: SettingsBackdropFinish
+    let colorScheme: ColorScheme
+    @Environment(\.accessibilityReduceTransparency) private var reduceTransparency
+
+    func body(content: Content) -> some View {
+        content
+            .saturation(bounded(finish.saturation, maximum: 2))
+            .opacity(bounded(finish.opacity, maximum: 1))
+            .overlay {
+                SettingsBackdropGrainOverlay(finish: finish)
+            }
+            .overlay {
+                if !reduceTransparency, finish.vignette > 0 {
+                    GeometryReader { geometry in
+                        RadialGradient(colors: [.clear, (colorScheme == .dark ? Color.black : Color.white).opacity(bounded(finish.vignette, maximum: 1))], center: .center, startRadius: 0, endRadius: max(geometry.size.width, geometry.size.height) * 0.65)
+                    }
+                }
+            }
+    }
+
+    private func bounded(_ value: Double, maximum: Double) -> Double {
+        value.isFinite ? min(max(value, 0), maximum) : 0
+    }
+
+}
