+import SwiftUI
+
+public struct SHelp: Equatable, Sendable {
+    public let description: String
+    public let defaultText: String?
+
+    public init(description: String, defaultText: String? = nil) {
+        self.description = description
+        self.defaultText = defaultText
+    }
+}
+
+public enum SCommitMode: Equatable, Sendable {
+    case onDragEnd
+    case debounced(milliseconds: Int)
+
+    public var debounceMilliseconds: Int? {
+        switch self {
+        case .onDragEnd: nil
+        case .debounced(let milliseconds): max(0, milliseconds)
+        }
+    }
+}
+
+public struct SInfo: View {
+    public let help: SHelp
+    public let title: String
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var isHovered = false
+    @State private var hoverPopover = false
+    @State private var clickPinned = false
+
+    private var showPopover: Bool { hoverPopover || clickPinned }
+
+    public init(help: SHelp, title: String = "More info") {
+        self.help = help
+        self.title = title
+    }
+
+    public var body: some View {
+        Button(title, systemImage: "info.circle") { clickPinned.toggle() }
+            .labelStyle(.iconOnly)
+            .buttonStyle(.plain)
+            .foregroundStyle(isHovered ? theme.accent : theme.textTertiary)
+            .font(.system(size: 12, weight: .medium))
+            .frame(width: 18, height: 18)
+            .background { Circle().fill(theme.control.opacity(isHovered ? 0.28 : 0)) }
+            .scaleEffect(reduceMotion ? 1 : (isHovered ? SettingsEffects.infoHoverScale : 1))
+            .accessibilityHint(help.description)
+            .animation(SettingsMotion.hover, value: isHovered)
+            .onHover { hovering in
+                isHovered = hovering
+                hoverPopover = hovering
+            }
+            .popover(
+                isPresented: Binding(
+                    get: { showPopover },
+                    set: { presented in
+                        if !presented { hoverPopover = false; clickPinned = false }
+                    }
+                ),
+                attachmentAnchor: .rect(.bounds),
+                arrowEdge: .trailing
+            ) {
+                infoBubble
+                    .presentationBackground(.clear)
+                    .presentationCornerRadius(theme.radius(SettingsRadius.control))
+            }
+            .zIndex(showPopover ? 100 : 0)
+    }
+
+    private var infoBubble: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+            Text(help.description)
+                .settingsFont(\.caption)
+                .foregroundStyle(theme.textPrimary)
+                .fixedSize(horizontal: false, vertical: true)
+            if let defaultText = help.defaultText {
+                Text("Default: \(defaultText)")
+                    .settingsFont(\.smallCaption)
+                    .foregroundStyle(theme.textSecondary)
