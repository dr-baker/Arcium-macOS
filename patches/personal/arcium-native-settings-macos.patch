+private struct ShortcutInventory: View {
+    @ObservedObject var store: ArciumSettingsStore
+    @Namespace private var selectionNamespace
+
+    var body: some View {
+        ScrollView {
+            LazyVStack(alignment: .leading, spacing: 2) {
+                if store.filteredShortcuts.isEmpty {
+                    Text(store.shortcutQuery.isEmpty ? "No shortcuts are available." : "No commands match this search.")
+                        .settingsFont(\.caption)
+                        .foregroundStyle(.secondary)
+                        .frame(maxWidth: .infinity, alignment: .leading)
+                        .padding(SettingsSpacing.sm)
+                } else {
+                    ForEach(store.filteredShortcuts) { command in
+                        SInventoryRow(
+                            isSelected: store.selectedShortcutID == command.id,
+                            selectionNamespace: selectionNamespace,
+                            action: { store.selectShortcut(command.id) }
+                        ) {
+                            ShortcutInventoryLabel(command: command)
+                        }
+                        .accessibilityLabel("\(command.name), \(shortcutSummary(command))")
+                        .help(command.name)
+                    }
+                }
+            }
+            .padding(.horizontal, SettingsSpacing.xs)
+            .padding(.vertical, SettingsSpacing.xs)
+        }
+        .scrollIndicators(.automatic)
+        .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+        .accessibilityLabel("Shortcut commands")
+        .disabled(store.isRecordingShortcut)
+    }
+}
+
+private struct ShortcutInventoryLabel: View {
+    let command: ArciumShortcutCommand
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        HStack(spacing: SettingsSpacing.xs) {
+            Text(command.name)
+                .lineLimit(1)
+                .truncationMode(.tail)
+                .frame(maxWidth: .infinity, alignment: .leading)
+
+            if command.modified {
+                Circle()
+                    .fill(theme.accent)
+                    .frame(width: 5, height: 5)
+                    .accessibilityLabel("Modified")
+            }
+
+            ShortcutSummaryView(command: command)
+                .layoutPriority(1)
+        }
+        .frame(maxWidth: .infinity, minHeight: 30, alignment: .leading)
+    }
+}
+
+private struct ShortcutSummaryView: View {
+    let command: ArciumShortcutCommand
+
+    var body: some View {
+        HStack(spacing: 4) {
+            if let first = command.bindings.first {
+                ShortcutKeycap(text: first.display)
+                if command.bindings.count > 1 {
+                    Text("+\(command.bindings.count - 1)")
+                        .settingsFont(\.smallCaption)
+                        .foregroundStyle(.secondary)
+                        .lineLimit(1)
+                }
+            } else {
+                Text("Unassigned")
+                    .settingsFont(\.smallCaption)
+                    .foregroundStyle(.secondary)
+                    .lineLimit(1)
+            }
+        }
+    }
+}
+
+private struct ShortcutKeycap: View {
+    let text: String
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        Text(text.isEmpty ? "—" : text)
+            .settingsFont(\.smallNumeric)
+            .lineLimit(1)
+            .truncationMode(.middle)
+            .padding(.horizontal, 6)
+            .frame(minWidth: 34, minHeight: 22)
+            .background(theme.control.opacity(0.78), in: RoundedRectangle(cornerRadius: 6, style: .continuous))
+            .overlay {
+                RoundedRectangle(cornerRadius: 6, style: .continuous)
+                    .stroke(theme.controlSurfaceBorder, lineWidth: theme.borderWidth)
+            }
+            .accessibilityLabel(text.isEmpty ? "No shortcut" : text)
+    }
+}
+
+private struct ShortcutEditor: View {
+    @ObservedObject var store: ArciumSettingsStore
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        Group {
+            if let command = store.selectedShortcut {
+                VStack(alignment: .leading, spacing: SettingsSpacing.md) {
+                    HStack(alignment: .firstTextBaseline, spacing: SettingsSpacing.xs) {
+                        Text(command.name)
+                            .settingsFont(\.section)
+                            .lineLimit(2)
+                            .truncationMode(.tail)
+                        if command.modified {
+                            Text("Modified")
+                                .settingsFont(\.smallCaption)
+                                .foregroundStyle(theme.accent)
+                        }
+                    }
+                    .accessibilityAddTraits(.isHeader)
+
+                    Text(command.bindings.isEmpty
+                         ? "No shortcuts assigned to this command."
+                         : "Choose a binding to change or remove it.")
+                        .settingsFont(\.caption)
+                        .foregroundStyle(theme.textSecondary)
+                        .fixedSize(horizontal: false, vertical: true)
+
+                    VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+                        ForEach(command.bindings) { binding in
+                            HStack(spacing: SettingsSpacing.sm) {
+                                ShortcutKeycap(text: binding.display)
+                                    .frame(maxWidth: 180, alignment: .leading)
+                                if binding.locked {
+                                    Text("Managed")
+                                        .settingsFont(\.smallCaption)
+                                        .foregroundStyle(theme.textSecondary)
+                                }
+                                Spacer(minLength: 0)
+                                Button("Change") {
+                                    store.emitShortcutAction("change_shortcut", command: command, binding: binding)
+                                }
+                                .disabled(!store.snapshot.shortcuts.canModify || binding.locked || store.isRecordingShortcut)
+                                Button("Remove") {
+                                    store.emitShortcutAction("remove_shortcut", command: command, binding: binding)
+                                }
+                                .disabled(!store.snapshot.shortcuts.canModify || binding.locked || store.isRecordingShortcut)
+                            }
+                            .padding(.horizontal, SettingsSpacing.sm)
+                            .padding(.vertical, SettingsSpacing.xs)
+                            .background(theme.control.opacity(0.18), in: RoundedRectangle(cornerRadius: SettingsRadius.control, style: .continuous))
+                            .accessibilityElement(children: .contain)
+                        }
+                    }
+
+                    HStack(spacing: SettingsSpacing.sm) {
+                        Button("Add shortcut") {
+                            store.emitShortcutAction("add_shortcut", command: command)
+                        }
+                        .buttonStyle(.borderedProminent)
+                        .tint(theme.accent)
+                        .disabled(!store.snapshot.shortcuts.canModify || store.isRecordingShortcut)
+
+                        Button("Reset command") {
+                            store.emitShortcutAction("reset_command", command: command)
+                        }
+                        .buttonStyle(.bordered)
+                        .disabled(!store.snapshot.shortcuts.canModify || store.isRecordingShortcut)
+                    }
+
+                    if !store.snapshot.shortcuts.canModify {
+                        Text("Shortcut settings are controlled by the browser or an administrator.")
+                            .settingsFont(\.caption)
+                            .foregroundStyle(theme.textSecondary)
+                            .fixedSize(horizontal: false, vertical: true)
+                    }
+
+                    Spacer(minLength: 0)
+                }
+                .padding(SettingsSpacing.md)
+                .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+            } else {
+                Text(store.shortcutQuery.isEmpty ? "Select a command to edit its shortcuts." : "No matching command is selected.")
+                    .settingsFont(\.body)
+                    .foregroundStyle(.secondary)
+                    .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+                    .padding(SettingsSpacing.md)
+            }
+        }
+    }
+}
+
+private func shortcutSummary(_ command: ArciumShortcutCommand) -> String {
+    guard let first = command.bindings.first else { return "Unassigned" }
+    if command.bindings.count == 1 { return first.display }
+    return "\(first.display), plus \(command.bindings.count - 1) more"
+}
