+        let normalized = Self.normalizedColors(colors)
+        let index = Self.activeIndex(selectedIndex, count: normalized.count)
+        let selected = index.flatMap {
+            ArciumHarmonyColorHSV(hex: normalized[$0], fallbackHue: 0)
+        }
+        _draftColors = State(initialValue: normalized)
+        _lastObservedColors = State(initialValue: normalized)
+        _brightness = State(initialValue: selected?.brightness ?? 1)
+        _hueFallback = State(initialValue: selected?.hue ?? 0)
+        _hexText = State(initialValue: selected?.hex ?? "#FFFFFF")
+    }
+
+    public var body: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.sm) {
+            VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+                HStack(spacing: SettingsSpacing.xs) {
+                    Text("Colors")
+                        .settingsFont(\.cardTitle)
+                        .foregroundStyle(theme.textPrimary)
+                    if onAddColor != nil || onRemoveColor != nil {
+                        HStack(spacing: SettingsSpacing.xxs) {
+                            Button("Remove selected color", systemImage: "minus") {
+                                onRemoveColor?()
