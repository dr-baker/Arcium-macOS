+private struct SAdaptiveControlLayout: Layout {
+    let horizontalSpacing: CGFloat
+    let verticalSpacing: CGFloat
+
+    func sizeThatFits(proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) -> CGSize {
+        measure(proposal: proposal, subviews: subviews).size
+    }
+
+    func placeSubviews(in bounds: CGRect, proposal: ProposedViewSize, subviews: Subviews, cache: inout ()) {
+        guard subviews.count == 2 else { return }
+        let result = measure(
+            proposal: ProposedViewSize(width: bounds.width, height: proposal.height),
+            subviews: subviews
+        )
+        if result.horizontal {
+            subviews[0].place(at: CGPoint(x: bounds.minX, y: bounds.midY), anchor: .leading, proposal: ProposedViewSize(result.label))
+            subviews[1].place(
+                at: CGPoint(x: bounds.maxX, y: bounds.midY),
+                anchor: .trailing,
+                proposal: ProposedViewSize(width: max(0, bounds.width - result.label.width - horizontalSpacing), height: result.control.height)
+            )
+        } else {
+            subviews[0].place(at: bounds.origin, anchor: .topLeading, proposal: ProposedViewSize(width: bounds.width, height: result.label.height))
+            subviews[1].place(
+                at: CGPoint(x: bounds.minX, y: bounds.minY + result.label.height + verticalSpacing),
+                anchor: .topLeading,
+                proposal: ProposedViewSize(width: bounds.width, height: result.control.height)
+            )
+        }
+    }
+
+    private func measure(proposal: ProposedViewSize, subviews: Subviews) -> Measurement {
+        guard subviews.count == 2 else { return .init(size: .zero, label: .zero, control: .zero, horizontal: true) }
+        let labelIdeal = subviews[0].sizeThatFits(.unspecified)
+        let controlIdeal = subviews[1].sizeThatFits(.unspecified)
+        let idealWidth = labelIdeal.width + horizontalSpacing + controlIdeal.width
+        let width = proposal.width.flatMap { $0.isFinite ? $0 : nil } ?? idealWidth
+        if idealWidth <= width {
+            let control = subviews[1].sizeThatFits(ProposedViewSize(width: max(0, width - labelIdeal.width - horizontalSpacing), height: proposal.height))
+            return .init(size: CGSize(width: width, height: max(labelIdeal.height, control.height)), label: labelIdeal, control: control, horizontal: true)
+        }
+        let label = subviews[0].sizeThatFits(ProposedViewSize(width: width, height: nil))
+        let control = subviews[1].sizeThatFits(ProposedViewSize(width: width, height: nil))
+        return .init(size: CGSize(width: width, height: label.height + verticalSpacing + control.height), label: label, control: control, horizontal: false)
+    }
+
+    private struct Measurement {
+        let size: CGSize
+        let label: CGSize
+        let control: CGSize
+        let horizontal: Bool
+    }
+}
