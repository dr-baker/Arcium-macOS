+@MainActor
+final class ArciumSettingsStore: ObservableObject {
+    @Published private(set) var snapshot: ArciumSettingsSnapshot
+    @Published private(set) var pendingSharedPalette: SettingsPaletteConfiguration?
+    @Published private(set) var selectedCategory: ArciumSettingsCategory = .general
+    @Published var selectedShortcutID: Int?
+    @Published var shortcutQuery = "" {
+        didSet { normalizeShortcutSelection() }
+    }
+    @Published var shortcutColumnWidth = 280.0
+
+    weak var delegate: ArciumSettingsUIDelegate?
+    let preset: SettingsStylePreset?
+    let presetError: String?
+
+    init(
+        snapshot: NSDictionary,
+        delegate: ArciumSettingsUIDelegate,
+        presetBundleURL: URL? = Bundle.main.resourceURL?.appendingPathComponent(
+            "ArciumSettingsUI_ArciumSettingsUI.bundle"
+        )
+    ) {
+        self.delegate = delegate
+        self.snapshot = ArciumSettingsSnapshot(dictionary: snapshot)
+        self.pendingSharedPalette = nil
+
+        do {
+            guard let presetBundleURL,
+                  let bundle = Bundle(url: presetBundleURL),
+                  let url = bundle.url(
+                forResource: "yellow-blue grain",
+                withExtension: "json"
+            ) else {
+                throw CocoaError(.fileNoSuchFile)
+            }
+            let data = try Data(contentsOf: url)
+            preset = try SettingsStylePreset.decodeJSON(data)
+            presetError = nil
+        } catch {
+            preset = nil
+            presetError = "The bundled yellow-blue grain preset could not be loaded. \(error.localizedDescription)"
+        }
+
+        selectedShortcutID = self.snapshot.shortcuts.commands.first?.id
+    }
+
+    func updateSnapshot(_ dictionary: NSDictionary) {
+        let next = ArciumSettingsSnapshot(dictionary: dictionary)
+        if let pending = pendingSharedPalette {
+            let palette = next.appearance.palette
+            if !palette.available || palette.managed || palette.configuration == pending {
+                pendingSharedPalette = nil
+            }
+        }
+        snapshot = next
+        normalizeShortcutSelection()
+    }
+
+    var selectedShortcut: ArciumShortcutCommand? {
+        guard let selectedShortcutID else { return nil }
+        return snapshot.shortcuts.commands.first { $0.id == selectedShortcutID }
+    }
+
+    var isRecordingShortcut: Bool {
+        snapshot.shortcuts.recordingCommandID != nil
+    }
+
+    var filteredShortcuts: [ArciumShortcutCommand] {
+        let query = shortcutQuery.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !query.isEmpty else { return snapshot.shortcuts.commands }
+        return snapshot.shortcuts.commands.filter { command in
+            command.name.localizedCaseInsensitiveContains(query)
+                || command.bindings.contains {
+                    $0.display.localizedCaseInsensitiveContains(query)
+                        || $0.serialized.localizedCaseInsensitiveContains(query)
+                }
+        }
+    }
+
+    func selectCategory(_ category: ArciumSettingsCategory) {
+        guard category != selectedCategory else { return }
+        // Cancel native capture before navigation, even if its snapshot is pending.
+        actionInvoked(name: "cancel_recording")
+        selectedCategory = category
+    }
+
+    func selectShortcut(_ id: Int) {
+        selectedShortcutID = id
+    }
+
+    func settingChanged(key: String, value: Any) {
+        delegate?.settingChanged(key: key, value: value)
+    }
+
+    func actionInvoked(name: String, payload: [String: Any] = [:]) {
+        if name == "reset_shared_palette" {
+            pendingSharedPalette = nil
+        }
+        let dictionary = NSMutableDictionary(capacity: payload.count)
+        payload.forEach { dictionary[$0.key] = $0.value }
+        delegate?.actionInvoked(name: name, payload: dictionary)
+    }
+
+    func setChromeAppearance(_ configuration: [String: Any]) {
+        settingChanged(key: "chrome_appearance", value: configuration)
+    }
+
+    func resetChromeAppearance() {
+        actionInvoked(name: "reset_chrome_appearance")
+    }
+
+    func emitShortcutAction(
+        _ name: String,
+        command: ArciumShortcutCommand,
+        binding: ArciumShortcutBinding? = nil
+    ) {
+        var payload: [String: Any] = ["command_id": command.id]
+        if let binding {
+            payload["serialized"] = binding.serialized
+            payload["display"] = binding.display
+        }
+        actionInvoked(name: name, payload: payload)
+    }
+
+    func sharedBrand(from preset: SettingsStylePreset) -> SettingsStyleBrand {
+        if let pendingSharedPalette {
+            return SettingsStyleBrand(colorSource: .brand, palette: pendingSharedPalette)
+        }
+        let shared = snapshot.appearance.palette
+        if let configuration = shared.configuration {
+            return SettingsStyleBrand(colorSource: .brand, palette: configuration)
+        }
+        if let hex = shared.accent, let rgb = SettingsRGB(hex: hex) {
+            var palette = preset.brand.palette
+            palette.brand = rgb.oklch
+            palette.accentSource = .brand
+            return SettingsStyleBrand(colorSource: .brand, palette: palette)
+        }
+        return preset.brand
+    }
+
+    func sharedPalette() -> SettingsPaletteConfiguration {
+        if let pendingSharedPalette {
+            return pendingSharedPalette
+        }
+        guard let preset else { return SettingsPaletteConfiguration() }
+        return sharedBrand(from: preset).palette
+    }
+
+    func applySharedPalette(_ palette: SettingsPaletteConfiguration) {
+        guard snapshot.appearance.palette.canEdit, isValidSharedPalette(palette),
+              let data = try? JSONEncoder().encode(palette),
+              let configuration = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return }
+        pendingSharedPalette = palette
+        settingChanged(key: "shared_palette", value: [
+            "configuration": configuration,
+            "accent": palette.resolvedAccent.rgb.hex,
+            "lightChromeColor": palette.colors(dark: false)[.windowCanvas]!.hex,
+            "darkChromeColor": palette.colors(dark: true)[.windowCanvas]!.hex
+        ])
+        if snapshot.appearance.chrome.canEdit,
+           var chrome = snapshot.appearance.chrome.configuration.editorConfiguration {
+            let colors = palette.backdropColors
+            chrome.colorHarmony = .custom
+            for index in chrome.points.indices {
+                if let rgb = NSColor(colors[index % colors.count]).usingColorSpace(.sRGB) {
+                    chrome.points[index].colorHex = SettingsRGB(red: rgb.redComponent, green: rgb.greenComponent, blue: rgb.blueComponent).hex
+                }
+            }
+            setChromeAppearance(chrome.dictionaryRepresentation)
+        }
+    }
+
+    func setSidebarWidth(_ width: Double) {
+        guard snapshot.appearance.sidebarWidthAvailable,
+              !snapshot.appearance.sidebarWidthManaged, width.isFinite else { return }
+        settingChanged(key: "sidebar_width", value: Int(min(max(width.rounded(), 160), 400)))
+    }
+
+    var chromeUIScaleFactor: Double {
+        let factor = Double(snapshot.appearance.chromeUIScale) / 100
+        return factor.isFinite && factor > 0 ? factor : 1
+    }
+
+    var displayedSidebarWidth: Double {
+        (Double(snapshot.appearance.sidebarWidth) * chromeUIScaleFactor).rounded()
+    }
+
+    func setDisplayedSidebarWidth(_ width: Double) {
+        guard width.isFinite else { return }
+        setSidebarWidth(width / chromeUIScaleFactor)
+    }
+
+    func setChromeUIScale(_ scale: Double) {
+        guard snapshot.appearance.chromeUIScaleAvailable,
+              !snapshot.appearance.chromeUIScaleManaged,
+              scale.isFinite else { return }
+        let bounded = min(max(scale, 80), 125)
+        let stepped = (bounded / 5).rounded() * 5
+        settingChanged(key: "chrome_ui_scale", value: Int(stepped))
+    }
+
+    func resetChromeUIScale() {
+        guard snapshot.appearance.chromeUIScaleAvailable,
+              !snapshot.appearance.chromeUIScaleManaged,
+              !snapshot.appearance.chromeUIScaleIsDefault else { return }
+        actionInvoked(name: "reset_chrome_ui_scale")
+    }
+
+    func appearanceMode() -> SettingsAppearance {
+        switch snapshot.appearance.mode.lowercased() {
+        case "light": .light
+        case "dark": .dark
+        default: .system
+        }
+    }
+
+    func styleAppearance(systemColorScheme: ColorScheme) -> SettingsStyleAppearance? {
+        guard let preset else { return nil }
+        let mode = appearanceMode()
+        switch mode.colorScheme ?? systemColorScheme {
+        case .dark: return preset.dark
+        default: return preset.light
+        }
+    }
+
+    func applyAppearanceMode(_ mode: SettingsAppearance) {
+        let value: String
+        switch mode {
+        case .system: value = "system"
+        case .light: value = "light"
+        case .dark: value = "dark"
+        }
+        settingChanged(key: "settings_appearance", value: value)
+    }
+
+    func generalBoolean(_ key: String) -> Bool {
+        switch key {
+        case "prompt_for_download": snapshot.general.promptForDownload
+        case "little_arc_external_links": snapshot.general.littleArcExternalLinks
+        case "confirm_to_quit": snapshot.general.confirmToQuit
+        default: false
+        }
+    }
+
+    func setGeneralBoolean(_ key: String, value: Bool) {
+        guard ["prompt_for_download", "little_arc_external_links", "confirm_to_quit"].contains(key) else {
+            return
+        }
+        settingChanged(key: key, value: value)
+    }
+
+    func tabsBoolean(_ key: String) -> Bool {
+        switch key {
+        case "new_tab_next_to_active": snapshot.tabs.newTabNextToActive
+        case "tab_cycling_mru": snapshot.tabs.tabCyclingMRU
+        case "shift_right_click_context_menu": snapshot.tabs.shiftRightClickContextMenu
+        default: false
+        }
+    }
+
+    func setTabsBoolean(_ key: String, value: Bool) {
+        guard ["new_tab_next_to_active", "tab_cycling_mru", "shift_right_click_context_menu"].contains(key) else {
+            return
+        }
+        settingChanged(key: key, value: value)
+    }
+
+    func appearanceBoolean(_ key: String) -> Bool {
+        switch key {
+        case "rounded_frame": snapshot.appearance.roundedFrame
+        case "centered_location_bar": snapshot.appearance.centeredLocationBar
+        case "minimal_location_bar": snapshot.appearance.minimalLocationBar
+        case "show_home_button": snapshot.appearance.showHomeButton
+        case "show_back_button": snapshot.appearance.showBackButton
+        case "show_forward_button": snapshot.appearance.showForwardButton
+        case "show_reload_button": snapshot.appearance.showReloadButton
+        case "show_avatar_button": snapshot.appearance.showAvatarButton
+        case "show_extensions_button": snapshot.appearance.showExtensionsButton
+        case "show_menu_button": snapshot.appearance.showMenuButton
+        case "show_media_button": snapshot.appearance.showMediaButton
+        case "show_vertical_tabs_collapse_button": snapshot.appearance.showVerticalTabsCollapseButton
+        case "show_dynamic_new_tab_button": snapshot.appearance.showDynamicNewTabButton
+        case "vertical_right_aligned": snapshot.appearance.verticalRightAligned
+        case "zen_mode": snapshot.appearance.zenMode
+        case "zen_mode_sidebar_pinned": snapshot.appearance.zenModeSidebarPinned
+        case "zen_mode_top_chrome_pinned": snapshot.appearance.zenModeTopChromePinned
+        default: false
+        }
+    }
+
+    func setAppearanceBoolean(_ key: String, value: Bool) {
+        guard [
+            "rounded_frame", "centered_location_bar", "minimal_location_bar",
+            "show_home_button", "show_back_button", "show_forward_button",
+            "show_reload_button", "show_avatar_button", "show_extensions_button",
+            "show_menu_button", "show_media_button",
+            "show_vertical_tabs_collapse_button", "show_dynamic_new_tab_button",
+            "vertical_right_aligned", "zen_mode", "zen_mode_sidebar_pinned",
+            "zen_mode_top_chrome_pinned"
+        ].contains(key) else {
+            return
+        }
+        settingChanged(key: key, value: value)
+    }
+
+    func setStartupType(_ value: Int) {
+        guard snapshot.general.startupOptions.contains(where: { $0.value == value }) else {
+            return
+        }
+        settingChanged(key: "startup_type", value: value)
+    }
+
+    func setLayout(_ value: Int) {
+        guard snapshot.tabs.layoutOptions.contains(where: { $0.value == value }) else {
+            return
+        }
+        settingChanged(key: "helium_layout", value: value)
+    }
+
+    func setActiveSpace(_ id: String) {
+        guard snapshot.spaces.items.contains(where: { $0.id == id }) else { return }
+        settingChanged(key: "active_space_id", value: id)
+    }
+
+    private func normalizeShortcutSelection() {
+        let visibleCommands = filteredShortcuts
+        guard let selectedShortcutID,
+              visibleCommands.contains(where: { $0.id == selectedShortcutID }) else {
+            self.selectedShortcutID = visibleCommands.first?.id
+            return
+        }
+    }
+}
+
+private func dictionaryValues(_ value: Any?) -> [String: Any] {
+    if let value = value as? [String: Any] {
+        return value
+    }
+    guard let dictionary = value as? NSDictionary else { return [:] }
+    var result: [String: Any] = [:]
+    for (key, value) in dictionary {
+        if let key = key as? String {
+            result[key] = value
+        }
+    }
+    return result
+}
+
+private func dictionaries(_ value: Any?) -> [[String: Any]] {
+    guard let array = value as? NSArray else { return [] }
+    return array.compactMap { dictionaryValues($0) }
+}
+
+private func booleanMap(_ value: Any?) -> [String: Bool] {
+    dictionaryValues(value).reduce(into: [:]) { result, pair in
+        result[pair.key] = boolean(pair.value)
+    }
+}
+
+private func choices(_ value: Any?) -> [ArciumChoice] {
+    dictionaries(value).compactMap { item in
+        guard let value = integerOptional(item["value"]),
+              let label = string(item["label"]), !label.isEmpty else {
+            return nil
+        }
+        return ArciumChoice(value: value, label: label)
+    }
+}
+
+private func boolean(_ value: Any?, defaultValue: Bool = false) -> Bool {
+    if let value = value as? Bool { return value }
+    if let value = value as? NSNumber { return value.boolValue }
+    return defaultValue
+}
+
+private func strictBoolean(_ value: Any?) -> Bool? {
+    if type(of: value) == Bool.self, let value = value as? Bool {
+        return value
+    }
+    guard let value = value as? NSNumber,
+          CFGetTypeID(value) == CFBooleanGetTypeID() else {
+        return nil
+    }
+    return value.boolValue
+}
+
+private func finiteDouble(_ value: Any?) -> Double? {
+    if let value = value as? NSNumber {
+        guard CFGetTypeID(value) != CFBooleanGetTypeID() else { return nil }
+        let double = value.doubleValue
+        return double.isFinite ? double : nil
+    }
+    if value is Bool { return nil }
+    if let value = value as? Double, value.isFinite { return value }
+    if let value = value as? Float, value.isFinite { return Double(value) }
+    if let value = value as? Int { return Double(value) }
+    return nil
+}
+
+private func arrayValues(_ value: Any?) -> [Any]? {
+    if let value = value as? [Any] { return value }
+    if let value = value as? NSArray { return value.map { $0 } }
+    return nil
+}
+
+private func integer(_ value: Any?) -> Int {
+    integerOptional(value) ?? 0
+}
+
+private func integerOptional(_ value: Any?) -> Int? {
+    if let value = value as? Int { return value }
+    if let value = value as? NSNumber { return value.intValue }
+    return nil
+}
+
+private func finiteIntegerOptional(_ value: Any?) -> Int? {
+    if let value = value as? Int { return value }
+    guard let value = value as? NSNumber,
+          CFGetTypeID(value) != CFBooleanGetTypeID(),
+          value.doubleValue.isFinite else {
+        return nil
+    }
+    return value.intValue
+}
+
+private func string(_ value: Any?) -> String? {
+    if let value = value as? String { return value }
+    if let value = value as? NSString { return value as String }
+    return nil
+}
+
+private func isValidSharedPalette(_ palette: SettingsPaletteConfiguration) -> Bool {
+    func contains(_ value: Double, _ range: ClosedRange<Double>) -> Bool {
+        value.isFinite && range.contains(value)
+    }
+    func validSeed(_ seed: SettingsOKLCH) -> Bool {
+        contains(seed.lightness, 0...1) && contains(seed.chroma, 0...0.5) && contains(seed.hue, 0...360)
+    }
+    return validSeed(palette.brand) && validSeed(palette.customAccent) && validSeed(palette.companion)
+        && contains(palette.neutralHue, 0...360) && contains(palette.neutralChroma, 0...0.04)
+        && contains(palette.textContrast, 4.5...7) && contains(palette.lightCanvas, 0...1)
+        && contains(palette.darkCanvas, 0...1)
+}
