+import CoreGraphics
+import Foundation
+
+public enum SettingsColorField: String, CaseIterable, Codable, Sendable {
+    case window = "Window"
+    case display = "Display"
+}
+
+/// Deterministic best-candidate sampling: each color gets its own even, irregular
+/// coverage. No lattice, no regeneration when a window moves.
+enum SettingsDisplayFieldLayout {
+    static func points(size: CGSize, colorCount: Int) -> [(color: Int, point: CGPoint)] {
+        guard size.width > 0, size.height > 0, colorCount > 0 else { return [] }
+        let count = max(4, min(24, Int(ceil(size.width * size.height / 250_000))))
+        var seed: UInt64 = 0xD15A1A7
+        func random() -> Double {
+            seed = seed &* 6364136223846793005 &+ 1442695040888963407
+            return Double(seed >> 11) / Double(UInt64.max >> 11)
+        }
+        var result: [(color: Int, point: CGPoint)] = []
+        for color in 0..<colorCount {
+            var own: [CGPoint] = []
+            for _ in 0..<count {
+                var best = CGPoint.zero
+                var bestDistance = -Double.infinity
+                for _ in 0..<48 {
+                    let p = CGPoint(x: random() * size.width, y: random() * size.height)
+                    let distance = own.map { hypot(p.x - $0.x, p.y - $0.y) }.min() ?? 1
+                    if distance > bestDistance { best = p; bestDistance = distance }
+                }
+                own.append(best)
+                result.append((color, best))
+            }
+        }
+        return result
+    }
+}
