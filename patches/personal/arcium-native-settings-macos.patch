+    private var isCustomEditingEnabled: Bool { editable && draft.enabled }
+
+    private var isDecorativeEditingEnabled: Bool {
+        isCustomEditingEnabled && effectsAvailable
+    }
+
+    private var isSurfaceEditingEnabled: Bool {
+        isCustomEditingEnabled && effectsAvailable
+    }
+
+    private var isLiquidGlassEditingEnabled: Bool {
+        isSurfaceEditingEnabled && activeMaterial == .liquidGlass
+    }
+
+    private var isFrostedEditingEnabled: Bool {
+        isSurfaceEditingEnabled && activeMaterial == .frosted
+    }
+
+    private var isForcedFallback: Bool {
+        guard draft.enabled else { return false }
+        if draft.material != .auto, let activeMaterial, activeMaterial != draft.material {
+            return true
+        }
+        return hasFallbackReason
+    }
+
+    private var normalizedFallbackReason: String {
+        fallbackReason?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+    }
+
+    private var hasFallbackReason: Bool {
+        !normalizedFallbackReason.isEmpty
+            && normalizedFallbackReason != "none"
+            && normalizedFallbackReason != "disabled"
+    }
+
+    private var fallbackStatus: String? {
+        guard draft.enabled else { return nil }
+        let active = activeMaterial
+        let reason = userFacingFallbackReason
+        if let active, let reason {
+            return "Using \(active.title). \(reason)"
+        }
+        if draft.material != .auto, let active, active != draft.material {
+            return "Using \(active.title). The selected material is unavailable."
+        }
+        if let reason {
+            return reason
+        }
+        if let active {
+            return "Using \(active.title)."
+        }
+        return nil
+    }
+
+    private var userFacingFallbackReason: String? {
+        let value = normalizedFallbackReason
+        guard !value.isEmpty, value != "none", value != "disabled" else { return nil }
+        switch value {
+        case "reduce-transparency":
+            return "Reduce Transparency is on in macOS."
+        case "command-line-opaque":
+            return "The browser was launched with opaque window chrome."
+        case "command-line-chromium-unsupported":
+            return "The browser launch options selected the standard Chrome renderer."
+        case "command-line-override":
+            return "A browser launch option selected this material."
+        case "command-line-liquid-glass-unavailable":
+            return "Liquid Glass is unavailable with the selected browser launch option."
+        case "command-line-frosted-unavailable":
+            return "Frosted material is unavailable with the selected browser launch option."
+        case "no-supported-renderer":
+            return "No supported window-effects renderer is available on this Mac."
+        case "liquid-glass-unavailable":
+            return "Liquid Glass is unavailable on this Mac."
+        case "frosted-unavailable":
+            return "Frosted material is unavailable on this Mac."
+        default:
+            return "The selected window material is unavailable."
+        }
+    }
