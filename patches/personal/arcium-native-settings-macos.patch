+import AppKit
+import SwiftUI
+
+/// Hosts decorative content in a click-through child window below its owner.
+/// Supply a value-based backdrop, never a shared live settings model.
+public struct SettingsBehindWindowBackdrop<Content: View>: NSViewRepresentable {
+    private let content: Content
+    public init(@ViewBuilder content: () -> Content) { self.content = content() }
+    public func makeNSView(context: Context) -> NSView { BehindBackdropAnchor<Content>() }
+    public func updateNSView(_ nsView: NSView, context: Context) {
+        (nsView as? BehindBackdropAnchor<Content>)?.setContent(content)
+    }
+    public static func dismantleNSView(_ nsView: NSView, coordinator: ()) {
+        (nsView as? BehindBackdropAnchor<Content>)?.detach()
+    }
+}
+
+final class SettingsGlowWindow: NSWindow {
+    weak var lifecycleOwner: NSWindow?
+    override var canBecomeKey: Bool { false }
+    override var canBecomeMain: Bool { false }
+}
+
+private final class BehindBackdropAnchor<Content: View>: NSView {
+    private var child: SettingsGlowWindow?
+    private var host: NSHostingView<Content>?
+    private var content: Content?
+
+    func setContent(_ content: Content) {
+        self.content = content
+        if let host { host.rootView = content }
+        else { attach() }
+    }
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        detach()
+        attach()
+    }
+    private func attach() {
+        guard child == nil, let owner = window, let content else { return }
+        let child = SettingsGlowWindow(contentRect: owner.frame, styleMask: .borderless, backing: .buffered, defer: false)
+        child.lifecycleOwner = owner
+        child.isReleasedWhenClosed = false
+        child.isOpaque = false
+        child.backgroundColor = .clear
+        child.hasShadow = false
+        child.ignoresMouseEvents = true
+        child.isExcludedFromWindowsMenu = true
+        child.tabbingMode = .disallowed
+        child.collectionBehavior = [.fullScreenAuxiliary, .ignoresCycle]
+        self.child = child
+        owner.addChildWindow(child, ordered: .below)
+        let host = NSHostingView(rootView: content)
+        host.sizingOptions = []
+        host.wantsLayer = true
+        host.layer?.cornerRadius = 12
+        host.layer?.masksToBounds = true
+        child.contentView = host
+        self.host = host
+        for name in [NSWindow.didResizeNotification, NSWindow.didMoveNotification,
+                     NSWindow.didDeminiaturizeNotification, NSWindow.didMiniaturizeNotification,
+                     NSWindow.willCloseNotification] {
+            NotificationCenter.default.addObserver(self, selector: #selector(ownerChanged(_:)), name: name, object: owner)
+        }
+        syncFrame()
+    }
+    @objc private func ownerChanged(_ notification: Notification) {
+        if notification.name == NSWindow.willCloseNotification { detach(); return }
+        syncFrame()
+    }
+    private func syncFrame() {
+        guard let child, let owner = child.lifecycleOwner else { return }
+        child.setFrame(owner.frame, display: true)
+        if owner.isMiniaturized { child.orderOut(nil) }
+        else if owner.isVisible, child.parent == nil { owner.addChildWindow(child, ordered: .below) }
+    }
+    func detach() {
+        NotificationCenter.default.removeObserver(self)
+        if let child {
+            child.parent?.removeChildWindow(child)
+            child.orderOut(nil)
+            child.contentView = nil
+            child.close()
+        }
+        host = nil
+        child = nil
+    }
+}
