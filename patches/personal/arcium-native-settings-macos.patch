+public struct SSlider: View {
+    public let title: String
+    @Binding private var value: Double
+    public let range: ClosedRange<Double>
+    public let step: Double
+    public let format: (Double) -> String
+    public let help: SHelp?
+    public let commitMode: SCommitMode
+    public let style: SControlRowStyle
+    public let onPreviewChange: ((Double) -> Void)?
+    public let onEditingChanged: ((Bool) -> Void)?
+    @State private var localValue: Double
+    @State private var debounceTask: Task<Void, Never>?
+    @State private var previewTask: Task<Void, Never>?
+    @State private var pendingPreviewValue: Double?
+    @State private var isDragging = false
+    @State private var isHovered = false
+    @Environment(\.settingsTheme) private var theme
+
+    private init(
+        title: String,
+        value: Binding<Double>,
+        range: ClosedRange<Double>,
+        step: Double,
+        format: @escaping (Double) -> String,
+        help: SHelp?,
+        commitMode: SCommitMode,
+        style: SControlRowStyle,
+        onPreviewChange: ((Double) -> Void)? = nil,
+        onEditingChanged: ((Bool) -> Void)? = nil
+    ) {
+        self.title = title
+        _value = value
+        self.range = range
+        self.step = step
+        self.format = format
+        self.help = help
+        self.commitMode = commitMode
+        self.style = style
+        self.onPreviewChange = onPreviewChange
+        self.onEditingChanged = onEditingChanged
+        _localValue = State(initialValue: value.wrappedValue)
+    }
+
+    public init(
+        _ title: String,
+        value: Binding<Double>,
+        range: ClosedRange<Double>,
+        step: Double,
+        format: @escaping (Double) -> String,
+        help: SHelp? = nil,
+        commitMode: SCommitMode = .onDragEnd,
+        style: SControlRowStyle = .standard,
+        onPreviewChange: ((Double) -> Void)? = nil,
+        onEditingChanged: ((Bool) -> Void)? = nil
+    ) {
+        self.init(
+            title: title,
+            value: value,
+            range: range,
+            step: step,
+            format: format,
+            help: help,
+            commitMode: commitMode,
+            style: style,
+            onPreviewChange: onPreviewChange,
+            onEditingChanged: onEditingChanged
+        )
+    }
+
+    public init(
+        _ title: String,
+        value: Binding<CGFloat>,
+        range: ClosedRange<CGFloat>,
+        step: CGFloat,
+        format: @escaping (CGFloat) -> String,
+        help: SHelp? = nil,
+        commitMode: SCommitMode = .onDragEnd,
+        style: SControlRowStyle = .standard
+    ) {
+        let binding = Binding<Double>(
+            get: { Double(value.wrappedValue) },
+            set: { value.wrappedValue = CGFloat($0) }
+        )
+        self.init(
+            title: title,
+            value: binding,
+            range: Double(range.lowerBound)...Double(range.upperBound),
+            step: Double(step),
+            format: { format(CGFloat($0)) },
+            help: help,
+            commitMode: commitMode,
+            style: style
+        )
+    }
+
+    public init(
+        _ title: String,
+        value: Binding<Int>,
+        range: ClosedRange<Int>,
+        step: Int,
+        format: @escaping (Int) -> String,
+        help: SHelp? = nil,
+        commitMode: SCommitMode = .onDragEnd,
+        style: SControlRowStyle = .standard
+    ) {
+        let binding = Binding<Double>(
+            get: { Double(value.wrappedValue) },
+            set: { value.wrappedValue = min(max(Int($0.rounded()), range.lowerBound), range.upperBound) }
+        )
+        self.init(
+            title: title,
+            value: binding,
+            range: Double(range.lowerBound)...Double(range.upperBound),
+            step: Double(step),
+            format: { format(Int($0.rounded())) },
+            help: help,
+            commitMode: commitMode,
+            style: style
+        )
+    }
+
+    public var body: some View {
+        SControlRow(style: style) {
+            SControlRowLabel(title: title, help: help)
+        } control: {
+            HStack(spacing: SettingsSpacing.sm) {
+                Slider(
+                    value: Binding(
+                        get: { localValue },
+                        set: { proposed in
+                            let snapped = range.lowerBound + ((proposed - range.lowerBound) / step).rounded() * step
+                            localValue = min(range.upperBound, max(range.lowerBound, snapped))
+                        }
+                    ),
+                    in: range,
+                    onEditingChanged: { editing in
+                        if editing {
+                            isDragging = true
+                            onEditingChanged?(true)
+                        } else {
+                            finishEditing()
+                            isDragging = false
+                            onEditingChanged?(false)
+                        }
+                    }
+                )
+                .accessibilityLabel(title)
+                .accessibilityValue(format(localValue))
+                .accessibilityAdjustableAction { direction in
+                    switch direction {
+                    case .increment: adjust(by: step)
+                    case .decrement: adjust(by: -step)
+                    @unknown default: break
+                    }
+                }
+                .onKeyPress(.rightArrow) { adjust(by: step); return .handled }
+                .onKeyPress(.upArrow) { adjust(by: step); return .handled }
+                .onKeyPress(.leftArrow) { adjust(by: -step); return .handled }
+                .onKeyPress(.downArrow) { adjust(by: -step); return .handled }
+                .tint(theme.accent)
+                .onChange(of: localValue) { _, newValue in handleLocalValueChange(newValue) }
+                .onChange(of: value) { _, newValue in
+                    if !isDragging, localValue != newValue { localValue = newValue }
+                }
+                Text(format(localValue))
+                    .accessibilityHidden(true)
+                    .settingsFont(\.numeric)
+                    .frame(width: SettingsSizing.sliderValueWidth, alignment: .trailing)
+                    .foregroundStyle(isHovered ? theme.textPrimary : theme.textSecondary)
+            }
+            .padding(.horizontal, SettingsSpacing.xs)
+            .padding(.vertical, SettingsSpacing.xxs)
+            .modifier(SettingsHoverSurfaceModifier(cornerRadius: SettingsRadius.control))
+            .onHover { isHovered = $0 }
+        }
+        .onDisappear {
+            debounceTask?.cancel()
+            debounceTask = nil
+            cancelPendingPreview()
+            if isDragging {
+                isDragging = false
+                onEditingChanged?(false)
+            }
+        }
+    }
+
+    private func adjust(by increment: Double) {
+        localValue = min(range.upperBound, max(range.lowerBound, localValue + increment))
+    }
+
+    private func handleLocalValueChange(_ newValue: Double) {
+        if isDragging {
+            schedulePreview(newValue)
+        }
+        switch commitMode {
+        case .onDragEnd:
+            if !isDragging { commit(newValue) }
+        case .debounced(let milliseconds):
+            debounceTask?.cancel()
+            debounceTask = Task { @MainActor in
+                try? await Task.sleep(for: .milliseconds(max(0, milliseconds)))
+                guard !Task.isCancelled else { return }
+                commit(newValue)
+            }
+        }
+    }
+
+    private func schedulePreview(_ newValue: Double) {
+        guard onPreviewChange != nil else { return }
+        pendingPreviewValue = newValue
+        guard previewTask == nil else { return }
+
+        let callback = onPreviewChange
+        previewTask = Task { @MainActor in
+            try? await Task.sleep(for: .milliseconds(34))
+            guard !Task.isCancelled else { return }
+            let latestValue = pendingPreviewValue
+            pendingPreviewValue = nil
+            previewTask = nil
+            if let latestValue {
+                callback?(latestValue)
+            }
+        }
+    }
+
+    private func cancelPendingPreview() {
+        previewTask?.cancel()
+        previewTask = nil
+        pendingPreviewValue = nil
+    }
+
+    private func finishEditing() {
+        debounceTask?.cancel()
+        debounceTask = nil
+        cancelPendingPreview()
+
+        let finalValue = localValue
+        onPreviewChange?(finalValue)
+        // A preview callback may have updated the same binding-backed draft.
+        // Still perform the final host commit so the owner receives the end
+        // of the gesture after the last preview.
+        commit(finalValue, force: onPreviewChange != nil)
+    }
+
+    private func commit(_ newValue: Double, force: Bool = false) {
+        if force || value != newValue { value = newValue }
+    }
+}
