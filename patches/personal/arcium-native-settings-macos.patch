+  std::unique_ptr<arcium_settings::ArciumSettingsModel> model_;
+  NSViewController* settings_ui_controller_;
+  ArciumShortcutRecorderButton* recording_button_;
+  ArciumSettingsContentViewController* content_controller_;
+  NSView* native_background_view_;
+  BOOL model_change_scheduled_;
+  BOOL window_closing_;
+  BOOL native_background_update_in_progress_;
+  BOOL native_background_is_profile_surface_;
+  BOOL settings_window_is_translucent_;
+  BOOL settings_window_appearance_overridden_;
+  NSAppearance* original_window_appearance_;
+  std::optional<ui::ColorProviderKey::ColorMode> last_color_mode_;
+  std::optional<SkColor> last_theme_color_;
