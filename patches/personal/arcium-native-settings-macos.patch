+- (void)windowWillClose:(NSNotification*)notification {
+  window_closing_ = YES;
+  [content_controller_ setEffectiveAppearanceChangedHandler:nil];
+  [self removeNativeGlassBackground];
+  [self restoreNativeWindowAppearance];
+  if (!profile_key_) {
+    return;
+  }
+  ArciumSettingsWindowController* __attribute__((
+      objc_precise_lifetime)) keep_alive = self;
+  NSValue* key = profile_key_;
+  if (accessibility_notification_token_) {
+    [NSWorkspace.sharedWorkspace.notificationCenter
+        removeObserver:accessibility_notification_token_];
+    accessibility_notification_token_ = nil;
+  }
+  [self detachRecordingButton];
+  [Controllers() removeObjectForKey:key];
+  (void)keep_alive;
+}
