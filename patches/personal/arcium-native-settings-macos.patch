+private struct SControlRow<Label: View, Control: View>: View {
+    let description: String?
+    let style: SControlRowStyle
+    let label: Label
+    let control: Control
+    @Environment(\.settingsTheme) private var theme
+    @Environment(\.isEnabled) private var isEnabled
+    @State private var isHovered = false
+
+    init(
+        description: String? = nil,
+        style: SControlRowStyle = .standard,
+        @ViewBuilder label: () -> Label,
+        @ViewBuilder control: () -> Control
+    ) {
+        self.description = description
+        self.style = style
+        self.label = label()
+        self.control = control()
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+            if style == .standard {
+                SAdaptiveControlLayout(horizontalSpacing: SettingsSpacing.sm, verticalSpacing: SettingsSpacing.xs) {
+                    label
+                    control.frame(maxWidth: .infinity, alignment: .trailing)
+                }
+                .frame(maxWidth: .infinity, alignment: .leading)
+            } else {
+                HStack(alignment: .center, spacing: SettingsSpacing.sm) { label; control }
+            }
+            if let description {
+                Text(description)
+                    .settingsFont(\.caption)
+                    .foregroundStyle(theme.textSecondary)
+                    .fixedSize(horizontal: false, vertical: true)
+                    .frame(maxWidth: .infinity, alignment: .leading)
+            }
+        }
+        .opacity(isEnabled ? 1 : SettingsEffects.disabledOpacity)
+        .padding(.vertical, style == .standard ? SettingsSpacing.xxs : 0)
+        .background {
+            if style == .standard {
+                RoundedRectangle(cornerRadius: theme.radius(SettingsRadius.row), style: .continuous)
+                    .fill(theme.controlSecondary.opacity(isEnabled && isHovered ? 0.14 : 0))
+            }
+        }
+        .contentShape(.rect(cornerRadius: theme.radius(SettingsRadius.row)))
+        .animation(SettingsMotion.hover, value: isHovered)
+        .onHover { hovering in if style == .standard, isEnabled { isHovered = hovering } }
+    }
+}
