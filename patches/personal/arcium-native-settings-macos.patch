+
+struct ArciumChromeAppearanceSnapshot: Equatable {
+    struct Point: Equatable {
+        var id: String
+        var color: String
+        var x: Double
+        var y: Double
+        var radius: Double
+        var opacity: Double
+
+        init?(_ dictionary: [String: Any]) {
+            guard Set(dictionary.keys) == [
+                "id", "color", "x", "y", "radius", "opacity"
+            ],
+                  let id = string(dictionary["id"]), !id.isEmpty,
+                  let color = string(dictionary["color"]),
+                  Self.isValidColor(color),
+                  let x = finiteDouble(dictionary["x"]),
+                  let y = finiteDouble(dictionary["y"]),
+                  let radius = finiteDouble(dictionary["radius"]),
+                  let opacity = finiteDouble(dictionary["opacity"]),
+                  (0...1).contains(x),
+                  (0...1).contains(y),
+                  (0.1...1.5).contains(radius),
+                  (0...1).contains(opacity) else {
+                return nil
+            }
+            self.id = id
+            self.color = color.uppercased()
+            self.x = x
+            self.y = y
+            self.radius = radius
+            self.opacity = opacity
+        }
+
+        private static func isValidColor(_ value: String) -> Bool {
+            let bytes = Array(value.utf8)
+            guard bytes.count == 7, bytes[0] == 35 else {
+                return false
+            }
+            return bytes.dropFirst().allSatisfy { byte in
+                (byte >= 48 && byte <= 57)
+                    || (byte >= 65 && byte <= 70)
+                    || (byte >= 97 && byte <= 102)
+            }
+        }
+    }
+
+    struct Configuration: Equatable {
+        var enabled = false
+        var material = "auto"
+        var materialOpacity = 0.0
+        var glassTintOpacity = 0.0
+        var glassStyle = "regular"
+        var frostedStyle = "automatic"
+        var frostedTintStrength = 0.0
+        var tintStrength = 0.0
+        var grain = 0.0
+        var grainScale = 0.0
+        var matchColorAdjustments = false
+        var colorHarmony = ArciumColorHarmony.custom
+        var points: [Point] = []
+        var isValid = false
+
+        init(_ dictionary: [String: Any]) {
+            let requiredKeys: Set<String> = [
+                "enabled", "material", "materialOpacity", "glassTintOpacity",
+                "glassStyle", "frostedStyle", "frostedTintStrength",
+                "tintStrength", "grain", "grainScale", "matchColorAdjustments", "points"
+            ]
+            let keys = Set(dictionary.keys)
+            guard keys == requiredKeys || keys == requiredKeys.union(["colorHarmony"]),
+                  let colorHarmony = ArciumColorHarmony(rawValue:
+                    dictionary["colorHarmony"] == nil ? "custom" : string(dictionary["colorHarmony"]) ?? ""),
+                  let enabled = strictBoolean(dictionary["enabled"]),
+                  let matchColorAdjustments = strictBoolean(dictionary["matchColorAdjustments"]),
+                  let requestedMaterial = string(dictionary["material"]),
+                  ["auto", "liquidGlass", "frosted", "solid"].contains(requestedMaterial),
+                  let materialOpacity = finiteDouble(dictionary["materialOpacity"]),
+                  (0...1).contains(materialOpacity),
+                  let glassTintOpacity = finiteDouble(dictionary["glassTintOpacity"]),
+                  (0...1).contains(glassTintOpacity),
+                  let requestedGlassStyle = string(dictionary["glassStyle"]),
+                  ["regular", "clear"].contains(requestedGlassStyle),
+                  let requestedFrostedStyle = string(dictionary["frostedStyle"]),
+                  ["automatic", "sidebar", "menu", "popover", "hud"].contains(requestedFrostedStyle),
+                  let frostedTintStrength = finiteDouble(dictionary["frostedTintStrength"]),
+                  (0...2).contains(frostedTintStrength),
+                  let tintStrength = finiteDouble(dictionary["tintStrength"]),
+                  (0...1).contains(tintStrength),
+                  let grain = finiteDouble(dictionary["grain"]),
+                  (0...0.3).contains(grain),
+                  let grainScale = finiteDouble(dictionary["grainScale"]),
+                  (0.5...2).contains(grainScale),
+                  let rawPoints = arrayValues(dictionary["points"]),
+                  rawPoints.count <= 4 else {
+                return
+            }
+
+            var seen = Set<String>()
+            var parsedPoints: [Point] = []
+            for rawPoint in rawPoints {
+                guard let point = Point(dictionaryValues(rawPoint)),
+                      seen.insert(point.id).inserted else {
+                    return
+                }
+                parsedPoints.append(point)
+            }
+
+            self.enabled = enabled
+            self.material = requestedMaterial
+            self.materialOpacity = materialOpacity
+            self.glassTintOpacity = glassTintOpacity
+            self.glassStyle = requestedGlassStyle
+            self.frostedStyle = requestedFrostedStyle
+            self.frostedTintStrength = frostedTintStrength
+            self.tintStrength = tintStrength
+            self.grain = grain
+            self.grainScale = grainScale
+            self.matchColorAdjustments = matchColorAdjustments
+            self.colorHarmony = colorHarmony
+            self.points = parsedPoints
+            self.isValid = true
+        }
+    }
+
+    var configuration: Configuration
+    var managed = false
+    var available = false
+    var activeMaterial: String?
+    var fallbackReason: String?
+    var effectsAvailable = false
+    var usesTranslucentNativeBase = false
+    var paintsChromeTransparent = false
+
+    init(_ dictionary: [String: Any]) {
+        configuration = Configuration(dictionaryValues(dictionary["configuration"]))
+        managed = strictBoolean(dictionary["managed"]) ?? false
+        available = strictBoolean(dictionary["available"]) ?? false
+        activeMaterial = string(dictionary["activeMaterial"])
+        fallbackReason = string(dictionary["fallbackReason"])
+        effectsAvailable = strictBoolean(dictionary["effectsAvailable"]) ?? false
+        usesTranslucentNativeBase =
+            strictBoolean(dictionary["usesTranslucentNativeBase"]) ?? false
+        paintsChromeTransparent =
+            strictBoolean(dictionary["paintsChromeTransparent"]) ?? false
+    }
+
+    /// Presentation copy only; retain fallbackReason for native diagnostics.
+    var fallbackDescription: String? {
+        switch fallbackReason {
+        case nil, "", "none", "disabled":
+            return nil
+        case "reduce-transparency":
+            return "macOS Reduce Transparency requires a solid background."
+        case "command-line-opaque":
+            return "Arcium is set to use a solid window background."
+        case "command-line-chromium-unsupported":
+            return "This glass renderer cannot show the window background. In Experiments, set Arcium glass backend to Automatic."
+        case "command-line-override":
+            return "The glass renderer override is choosing the background material."
+        case "command-line-liquid-glass-unavailable", "liquid-glass-unavailable":
+            return "Liquid Glass is unavailable on this Mac."
+        case "command-line-frosted-unavailable", "frosted-unavailable":
+            return "Frosted glass is unavailable on this Mac."
+        case "no-supported-renderer":
+            return "Native glass backgrounds are unavailable on this Mac."
+        default:
+            return fallbackReason
+        }
+    }
+
+    var canEdit: Bool { available && !managed && configuration.isValid }
+    var canReset: Bool { available && !managed }
+    var isAvailable: Bool { available }
+}
