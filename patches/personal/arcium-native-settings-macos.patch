+import SwiftUI
+
+extension SettingsPaletteConfiguration {
+    public var brand: SettingsOKLCH {
+        get { SettingsOKLCH(lightness: brandLightness, chroma: chroma, hue: hue) }
+        set { brandLightness = newValue.lightness; chroma = newValue.chroma; hue = newValue.hue }
+    }
+
+    public var resolvedAccent: SettingsOKLCH {
+        switch accentSource {
+        case .brand: brand
+        case .companion: resolvedCompanion
+        case .custom: customAccent
+        }
+    }
+
+    public var resolvedCompanion: SettingsOKLCH {
+        if harmony == .custom { return companion }
+        let offset: Double = switch harmony {
+        case .monochromatic: 0
+        case .analogous: 35
+        case .complementary: 180
+        case .splitComplementary: 150
+        case .custom: 0
+        }
+        return SettingsOKLCH(lightness: brandLightness, chroma: chroma * 0.8, hue: wrapped(hue + offset))
+    }
+
+    public var resolvedNeutralHue: Double {
+        switch chromeSource {
+        case .brand: wrapped(hue)
+        case .companion: wrapped(resolvedCompanion.hue)
+        case .neutral: 0
+        case .custom: wrapped(neutralHue)
+        }
+    }
+
+    public var resolvedNeutralChroma: Double { chromeSource == .neutral ? 0 : neutralChroma }
+
+    /// Three decorative colors; the host retains position, spread, and intensity.
+    public var backdropColors: [Color] {
+        let thirdHue = switch harmony {
+        case .analogous: wrapped(hue - 35)
+        case .splitComplementary: wrapped(hue + 210)
+        default: wrapped(resolvedCompanion.hue)
+        }
+        let seeds = [brand, resolvedCompanion,
+                     SettingsOKLCH(lightness: brandLightness, chroma: resolvedCompanion.chroma * 0.7, hue: thirdHue)]
+        // Decorative lightness is lifted so very dark brand inputs still produce a glow.
+        return seeds.map { SettingsOKLCH(lightness: 0.72, chroma: $0.chroma, hue: $0.hue).rgb.color }
+    }
+
+    public func recoloring(_ glows: [SettingsBackdropGlow]) -> [SettingsBackdropGlow] {
+        let colors = backdropColors
+        return glows.enumerated().map { index, glow in
+            var result = glow
+            result.color = colors[index % colors.count]
+            return result
+        }
+    }
+
+    private func wrapped(_ value: Double) -> Double {
+        guard value.isFinite else { return 0 }
+        return (value.truncatingRemainder(dividingBy: 360) + 360).truncatingRemainder(dividingBy: 360)
+    }
+}
