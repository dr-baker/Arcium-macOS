+- (void)dealloc {
+  profile_destroying_ = YES;
+  if (accessibility_notification_token_) {
+    [NSWorkspace.sharedWorkspace.notificationCenter
+        removeObserver:accessibility_notification_token_];
+    accessibility_notification_token_ = nil;
+  }
+  [content_controller_ setEffectiveAppearanceChangedHandler:nil];
+  [self removeNativeGlassBackground];
+  [self restoreNativeWindowAppearance];
+  [self detachRecordingButton];
+  content_controller_ = nil;
+  settings_ui_controller_ = nil;
+  if (model_) {
+    model_->Shutdown();
+  }
+}
+
+- (BOOL)buildWindow {
+  if (!self.window) {
+    return NO;
+  }
+
+  NSDictionary* snapshot = [self settingsSnapshot];
+  Class facade_class =
+      LoadSettingsUIModule()
+          ? NSClassFromString(kArciumSettingsUIControllerClassName)
+          : Nil;
+  SEL initializer = NSSelectorFromString(kArciumSettingsUIInitializerSelector);
+  if (!facade_class || ![facade_class instancesRespondToSelector:initializer]) {
+    NSAlert* alert = [[NSAlert alloc] init];
+    alert.messageText = @"Settings could not be opened";
+    alert.informativeText = @"Arcium’s settings component could not be loaded.";
+    [alert addButtonWithTitle:@"OK"];
+    [alert runModal];
+    return NO;
+  }
+
+  id allocated = [facade_class alloc];
+  using Initializer = id (*)(id, SEL, NSDictionary*, id);
+  id facade = reinterpret_cast<Initializer>(objc_msgSend)(
+      allocated, initializer, snapshot, self);
+  if (!facade || ![facade isKindOfClass:[NSViewController class]]) {
+    NSAlert* alert = [[NSAlert alloc] init];
+    alert.messageText = @"Settings could not be opened";
+    alert.informativeText =
+        @"The native SettingsUI module did not provide a compatible "
+         "Settings controller.";
+    [alert addButtonWithTitle:@"OK"];
+    [alert runModal];
+    return NO;
+  }
+
+  settings_ui_controller_ = (NSViewController*)facade;
+  if (!settings_ui_controller_.view) {
+    NSAlert* alert = [[NSAlert alloc] init];
+    alert.messageText = @"Settings could not be opened";
+    alert.informativeText = @"The native Settings view is empty.";
+    [alert addButtonWithTitle:@"OK"];
+    [alert runModal];
+    return NO;
+  }
+
+  content_controller_ = [[ArciumSettingsContentViewController alloc]
+      initWithHostedController:settings_ui_controller_];
+  self.window.contentViewController = content_controller_;
+  // Installing an NSHostingController can apply its preferred content size;
+  // restore the native default after the view controller is attached.
+  [self.window setContentSize:NSMakeSize(860, 650)];
+  [content_controller_.view layoutSubtreeIfNeeded];
+
+  __weak ArciumSettingsWindowController* weak_self = self;
+  [content_controller_
+      setEffectiveAppearanceChangedHandler:^{
+        ArciumSettingsWindowController* strong_self = weak_self;
+        if (strong_self) {
+          [strong_self modelDidChange];
+        }
+      }];
+  [self updateNativeGlassBackground];
+  return YES;
+}
+
+- (void)applyNativeWindowAppearanceForColorMode:
+    (ui::ColorProviderKey::ColorMode)colorMode {
+  if (!self.window) {
+    return;
+  }
+
+  const int appearance_mode = model_ ? model_->GetAppearanceMode()
+                                     : static_cast<int>(
+                                           ThemeService::BrowserColorScheme::
+                                               kSystem);
+  if (appearance_mode == static_cast<int>(
+                             ThemeService::BrowserColorScheme::kSystem)) {
+    // Keep Auto attached to NSApp so a later macOS appearance change reaches
+    // both the wrapper and the hosted SwiftUI view. Explicit modes need the
+    // same window appearance propagation used by NativeWidgetNSWindowBridge.
+    if (settings_window_appearance_overridden_) {
+      [self.window setAppearance:original_window_appearance_];
+      settings_window_appearance_overridden_ = NO;
+    }
+    return;
+  }
+
+  const bool use_dark_appearance =
+      appearance_mode ==
+          static_cast<int>(ThemeService::BrowserColorScheme::kDark) ||
+      (appearance_mode !=
+           static_cast<int>(ThemeService::BrowserColorScheme::kLight) &&
+       colorMode == ui::ColorProviderKey::ColorMode::kDark);
+  NSAppearanceName appearance_name =
+      use_dark_appearance
+          ? NSAppearanceNameDarkAqua
+          : NSAppearanceNameAqua;
+  NSAppearance* appearance = [NSAppearance appearanceNamed:appearance_name];
+  if (appearance && ![self.window.appearance isEqual:appearance]) {
+    [self.window setAppearance:appearance];
+  }
+  settings_window_appearance_overridden_ = appearance != nil;
+}
+
+- (void)removeNativeGlassBackground {
+  if (content_controller_) {
+    [content_controller_ setBackgroundView:nil];
+  }
+  native_background_view_ = nil;
+  native_background_is_profile_surface_ = NO;
+  last_color_mode_.reset();
+  last_theme_color_.reset();
+  if (settings_window_is_translucent_) {
+    SetSettingsWindowGlassState(self.window, false);
+    settings_window_is_translucent_ = NO;
+  }
+}
+
+- (void)restoreNativeWindowAppearance {
+  if (settings_window_appearance_overridden_) {
+    [self.window setAppearance:original_window_appearance_];
+    settings_window_appearance_overridden_ = NO;
+  }
+}
+
+- (void)updateNativeGlassBackground {
+  if (profile_destroying_ || native_background_update_in_progress_ ||
+      !profile_ || !model_ || !content_controller_) {
+    return;
+  }
+
+  native_background_update_in_progress_ = YES;
+
+  const bool has_chrome_appearance_preference =
+      model_->HasPreference(helium::kArciumChromeAppearancePref);
+  const helium::GlassSurfaceConfiguration configuration =
+      helium::ParseGlassSurfaceConfiguration(model_->GetChromeAppearance());
