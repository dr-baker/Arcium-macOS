+enum ArciumSettingsCategory: String, CaseIterable, Identifiable {
+    case general
+    case tabsAndSpaces
+    case appearance
+    case shortcuts
+
+    var id: String { rawValue }
+
+    var title: String {
+        switch self {
+        case .general: "General"
+        case .tabsAndSpaces: "Tabs & Spaces"
+        case .appearance: "Appearance"
+        case .shortcuts: "Keyboard Shortcuts"
+        }
+    }
+
+    var symbolName: String {
+        switch self {
+        case .general: "gearshape"
+        case .tabsAndSpaces: "square.split.2x2"
+        case .appearance: "paintbrush"
+        case .shortcuts: "command"
+        }
+    }
+
+    var help: String {
+        switch self {
+        case .general: "Startup, downloads, and quit behavior"
+        case .tabsAndSpaces: "Tab behavior, layout, and default Space"
+        case .appearance: "Browser chrome and visual appearance"
+        case .shortcuts: "Search and edit browser shortcuts"
