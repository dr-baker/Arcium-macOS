+
+    private func pointValueBinding(
+        for id: String,
+        get: @escaping (ArciumChromeAppearancePoint) -> Double,
+        set: @escaping (inout ArciumChromeAppearancePoint, Double) -> Void
+    ) -> Binding<Double> {
+        Binding(
+            get: {
+                guard let point = draft.points.first(where: { $0.id == id }) else { return 0 }
+                return get(point)
+            },
+            set: { value in
+                guard isDecorativeEditingEnabled else {
+                    cancelSliderPreview()
+                    return
+                }
+                commitSlider { next in
+                    applyPointValue(to: &next, id: id, value: value, set: set)
+                }
+            }
+        )
+    }
+
+    private func previewPointValue(
+        for id: String,
+        value: Double,
+        set: @escaping (inout ArciumChromeAppearancePoint, Double) -> Void
+    ) {
+        guard isDecorativeEditingEnabled else { return }
+        previewSlider { next in
+            applyPointValue(to: &next, id: id, value: value, set: set)
+        }
+    }
+
+    private func applyPointValue(
+        to configuration: inout ArciumChromeAppearanceConfiguration,
+        id: String,
+        value: Double,
+        set: (inout ArciumChromeAppearancePoint, Double) -> Void
+    ) {
+        for index in configuration.points.indices
+        where configuration.matchColorAdjustments || configuration.points[index].id == id {
+            set(&configuration.points[index], value)
+        }
+    }
+
+    private func previewSlider(
+        when enabled: Bool = true,
+        _ mutation: (inout ArciumChromeAppearanceConfiguration) -> Void
+    ) {
+        guard enabled else {
+            cancelSliderPreview()
+            return
+        }
+        sliderPreviewActive = true
+        var next = draft
+        mutation(&next)
+        draft = next.normalized()
+        normalizeSelectedPoint()
+    }
+
+    private func commitSlider(_ mutation: (inout ArciumChromeAppearanceConfiguration) -> Void) {
+        guard deferredSliderConfiguration?.enabled ?? draft.enabled else {
+            cancelSliderPreview()
+            return
+        }
+        var next = deferredSliderConfiguration ?? draft
+        mutation(&next)
+        sliderPreviewActive = false
+        deferredSliderConfiguration = nil
+        commit(next, force: true)
+    }
+
+    private func handleSliderEditing(_ editing: Bool) {
+        if editing {
+            sliderPreviewActive = true
+        } else if sliderPreviewActive {
+            // SSlider commits before it reports the end of an interaction. If
+            // a slider disappears mid-drag, discard its local preview instead.
+            cancelSliderPreview()
+        }
+    }
+
+    private func cancelSliderPreview() {
+        guard sliderPreviewActive || deferredSliderConfiguration != nil else { return }
+        let authoritative = (deferredSliderConfiguration ?? configuration).normalized()
+        sliderPreviewActive = false
+        deferredSliderConfiguration = nil
+        draft = authoritative
+        normalizeSelectedPoint()
+    }
+
+    private var harmonyBinding: Binding<ArciumColorHarmony> {
+        Binding(
+            get: { draft.colorHarmony },
+            set: { mode in
+                guard isDecorativeEditingEnabled else { return }
+                // The picker commits mode and generated colors together through
+                // applyHarmonyColors, avoiding an intermediate host snapshot.
+                draft.colorHarmony = mode
+            }
+        )
+    }
+
+    private func applyHarmonyColors(_ colors: [String]) {
+        guard isDecorativeEditingEnabled, colors.count == draft.points.count else { return }
+        commit(draft.applyingColorPalette(colors, harmony: draft.colorHarmony), force: true)
+    }
+
+    private func updateDraft(_ mutation: (inout ArciumChromeAppearanceConfiguration) -> Void) {
+        var next = draft
+        mutation(&next)
+        commit(next)
+    }
+
+    private func randomizePointPositions() {
+        guard isDecorativeEditingEnabled, !draft.points.isEmpty else { return }
+        let randomValues = (0..<(draft.points.count * 2)).map { _ in
+            Double.random(in: 0...1)
+        }
+        var next = draft
+        next.points = Self.randomizedPointPositions(draft.points, randomValues: randomValues)
+        commit(next, force: true)
+    }
+
+    private func commit(_ value: ArciumChromeAppearanceConfiguration, force: Bool = false) {
+        let next = value.normalized()
+        guard force || next != draft else { return }
+        draft = next
+        normalizeSelectedPoint()
+        onCommit(next.dictionaryRepresentation)
+    }
+
+    private func reconcile(_ value: ArciumChromeAppearanceConfiguration) {
+        let next = value.normalized()
+        guard next != draft else { return }
+        if draggingPointID != nil {
+            deferredConfiguration = next
+            return
+        }
+        if sliderPreviewActive {
+            deferredSliderConfiguration = next
+            return
+        }
+        draft = next
+        normalizeSelectedPoint()
+    }
+
+    private func normalizeSelectedPoint() {
+        guard let selectedPointID,
+              draft.points.contains(where: { $0.id == selectedPointID }) else {
+            self.selectedPointID = draft.points.first?.id
+            return
+        }
+    }
+
+    private func addPoint() {
+        guard isDecorativeEditingEnabled, draft.points.count < 4 else { return }
+        let usedIDs = Set(draft.points.map(\.id))
+        let id = (1...4).map { "point-\($0)" }.first { !usedIDs.contains($0) } ?? "point-\(draft.points.count + 1)"
+        let offset = Double(draft.points.count)
+        let point = ArciumChromeAppearancePoint(
+            id: id,
+            colorHex: defaultPointColors[draft.points.count % defaultPointColors.count],
+            x: min(0.82, 0.22 + offset * 0.18),
+            y: min(0.82, 0.24 + offset * 0.15),
+            radius: draft.matchColorAdjustments ? (selectedPoint ?? draft.points.first)?.radius ?? 0.45 : 0.45,
+            opacity: draft.matchColorAdjustments ? (selectedPoint ?? draft.points.first)?.opacity ?? 0.15 : 0.15
+        )
+        var next = draft
+        next.points.append(point)
+        next.colorHarmony = .automatic(for: next.points.count)
+        next = next.applyingColorPalette(
+            ArciumColorHarmonyPicker.applyingHarmony(
+                to: next.points.map(\.colorHex), selectedIndex: 0, mode: next.colorHarmony),
+            harmony: next.colorHarmony)
+        selectedPointID = point.id
+        commit(next)
+    }
+
+    private func removeSelectedPoint() {
+        guard isDecorativeEditingEnabled, let selectedPointID else { return }
+        var next = draft
+        next.points.removeAll { $0.id == selectedPointID }
+        if next.colorHarmony != .custom {
+            next.colorHarmony = .automatic(for: next.points.count)
+            next = next.applyingColorPalette(
+                ArciumColorHarmonyPicker.applyingHarmony(
+                    to: next.points.map(\.colorHex), selectedIndex: 0, mode: next.colorHarmony),
+                harmony: next.colorHarmony)
+        }
+        colorPickerPresented = colorPickerPresented && !next.points.isEmpty
+        self.selectedPointID = next.points.first?.id
+        commit(next)
+    }
+
+    private func beginMovingPoint(_ id: String) {
+        selectedPointID = id
+        if draggingPointID == nil {
+            draggingPointID = id
+            dragStartPoint = draft.points.first { $0.id == id }
+        }
+    }
+
+    private func movePoint(_ id: String, location: CGPoint, size: CGSize, isEnding: Bool) {
+        guard isDecorativeEditingEnabled else { return }
+        beginMovingPoint(id)
+        let width = max(size.width, 1)
+        let height = max(size.height, 1)
+        var next = draft
+        guard let index = next.points.firstIndex(where: { $0.id == id }) else { return }
+        next.points[index].x = min(max(Double(location.x / width), 0), 1)
+        next.points[index].y = min(max(Double(location.y / height), 0), 1)
+        draft = next.normalized()
+        if isEnding { finishMovingPoint(id) }
+    }
+
+    private func finishMovingPoint(_ id: String) {
+        guard draggingPointID == id else { return }
+        let resolution = Self.resolveDrag(
+            pointID: id,
+            startPoint: dragStartPoint,
+            localConfiguration: draft,
+            deferredConfiguration: deferredConfiguration
+        )
+        draggingPointID = nil
+        dragStartPoint = nil
+        deferredConfiguration = nil
+
+        if resolution.shouldCommit {
+            commit(resolution.configuration, force: true)
+        } else {
+            // An external snapshot may have arrived during a no-op drag, or
+            // the host may have removed the point. It is authoritative, so
+            // update the local draft without resurrecting stale state.
+            draft = resolution.configuration
+            normalizeSelectedPoint()
+        }
+    }
+
+    internal static func resolveDrag(
+        pointID: String,
+        startPoint: ArciumChromeAppearancePoint?,
+        localConfiguration: ArciumChromeAppearanceConfiguration,
+        deferredConfiguration: ArciumChromeAppearanceConfiguration?
+    ) -> (configuration: ArciumChromeAppearanceConfiguration, shouldCommit: Bool) {
+        let final = localConfiguration.normalized()
+        let localPoint = final.points.first { $0.id == pointID }
+        let localDidMove = if let startPoint, let localPoint {
+            startPoint.x != localPoint.x || startPoint.y != localPoint.y
+        } else {
+            false
+        }
+
+        if let deferredConfiguration {
+            guard deferredConfiguration.enabled else {
+                // A host reset or disable wins over an in-flight point drag.
+                return (deferredConfiguration.normalized(), false)
+            }
+            guard let localPoint,
+                  let index = deferredConfiguration.points.firstIndex(where: { $0.id == pointID }) else {
+                // The host removed or replaced the point while it was being
+                // dragged. Keep the authoritative snapshot and never
+                // resurrect stale local state.
+                return (deferredConfiguration.normalized(), false)
+            }
+            guard localDidMove else {
+                // A no-op drag should not overwrite a coordinate changed by
+                // the host while the gesture was in flight.
+                return (deferredConfiguration.normalized(), false)
+            }
+            var merged = deferredConfiguration.normalized()
+            merged.points[index].x = localPoint.x
+            merged.points[index].y = localPoint.y
+            return (merged.normalized(), true)
+        }
+        return (final, localDidMove)
+    }
+
+    internal static func randomizedPointPositions(
+        _ points: [ArciumChromeAppearancePoint],
+        randomValues: [Double]
+    ) -> [ArciumChromeAppearancePoint] {
+        guard !points.isEmpty else { return [] }
+
+        let margin = 0.14
+        let jitter: Double = points.count == 1 ? 0.24 : points.count <= 4 ? 0.08 : 0.05
+        let anchors: [(x: Double, y: Double)] = switch points.count {
+        case 1:
+            [(0.50, 0.50)]
+        case 2:
+            [(0.28, 0.30), (0.72, 0.70)]
+        case 3:
+            [(0.25, 0.25), (0.75, 0.30), (0.50, 0.75)]
+        case 4:
+            [(0.25, 0.25), (0.75, 0.25), (0.25, 0.75), (0.75, 0.75)]
+        default:
+            points.indices.map { index in
+                let angle = (Double(index) / Double(points.count)) * 2 * .pi - .pi / 2
+                return (0.5 + 0.28 * cos(angle), 0.5 + 0.28 * sin(angle))
+            }
+        }
+
+        func sample(_ index: Int) -> Double {
+            guard randomValues.indices.contains(index), randomValues[index].isFinite else { return 0.5 }
+            return min(max(randomValues[index], 0), 1)
+        }
+
+        let rotationSteps = min(Int(sample(0) * 4), 3)
+        let reflected = sample(1) >= 0.5
+
+        func transformedAnchor(_ anchor: (x: Double, y: Double)) -> (x: Double, y: Double) {
+            var dx = anchor.x - 0.5
+            var dy = anchor.y - 0.5
+            for _ in 0..<rotationSteps {
+                (dx, dy) = (-dy, dx)
+            }
+            if reflected { dx = -dx }
+            return (0.5 + dx, 0.5 + dy)
+        }
+
+        return points.enumerated().map { index, point in
+            let anchor = transformedAnchor(anchors[index % anchors.count])
+            let x = min(max(anchor.x + (sample(index * 2) - 0.5) * 2 * jitter, margin), 1 - margin)
+            let y = min(max(anchor.y + (sample(index * 2 + 1) - 0.5) * 2 * jitter, margin), 1 - margin)
+            var next = point
+            next.x = x
+            next.y = y
+            return next
+        }
+    }
+
+    private func cancelMovingPoint() {
+        guard draggingPointID != nil else { return }
+        let authoritative = (deferredConfiguration ?? configuration).normalized()
+        draggingPointID = nil
+        dragStartPoint = nil
+        deferredConfiguration = nil
+        draft = authoritative
+        normalizeSelectedPoint()
+    }
+
+    private func movePointByAccessibility(_ id: String, dx: Double, dy: Double) {
+        guard isDecorativeEditingEnabled else { return }
+        var next = draft
+        guard let index = next.points.firstIndex(where: { $0.id == id }) else { return }
+        next.points[index].x = min(max(next.points[index].x + dx, 0), 1)
+        next.points[index].y = min(max(next.points[index].y + dy, 0), 1)
+        selectedPointID = id
+        commit(next)
+    }
+
+    private func percent(_ value: Double) -> String {
+        "\(Int((value * 100).rounded()))%"
+    }
+
+    private func grainPercent(_ value: Double) -> String {
+        "\(Int((value / 0.3 * 100).rounded()))%"
+    }
+
+    private func scaleFormat(_ value: Double) -> String {
+        "\(value.formatted(.number.precision(.fractionLength(2))))×"
+    }
+
+    private func radiusFormat(_ value: Double) -> String {
+        "\(value.formatted(.number.precision(.fractionLength(2))))×"
+    }
+
+    private let defaultPointColors = ["#F2C94C", "#3D8BFF", "#F2994A", "#56CCF2"]
+}
