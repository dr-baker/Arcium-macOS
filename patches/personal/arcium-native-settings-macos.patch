+import AppKit
+
+/// The window and application state that determines whether a backdrop may animate.
+public struct SettingsBackdropLifecycleState: Equatable, Sendable {
+    public let windowIsKey: Bool
+    public let applicationIsActive: Bool
+    public let windowIsVisible: Bool
+    public let windowIsMiniaturized: Bool
+    public let windowIsOccluded: Bool
+    public let applicationIsHidden: Bool
+
+    public static let inactive = Self(
+        windowIsKey: false,
+        applicationIsActive: false,
+        windowIsVisible: false,
+        windowIsMiniaturized: false,
+        windowIsOccluded: true,
+        applicationIsHidden: false
+    )
+
+    public init(
+        windowIsKey: Bool,
+        applicationIsActive: Bool,
+        windowIsVisible: Bool,
+        windowIsMiniaturized: Bool,
+        windowIsOccluded: Bool,
+        applicationIsHidden: Bool
+    ) {
+        self.windowIsKey = windowIsKey
+        self.applicationIsActive = applicationIsActive
+        self.windowIsVisible = windowIsVisible
+        self.windowIsMiniaturized = windowIsMiniaturized
+        self.windowIsOccluded = windowIsOccluded
+        self.applicationIsHidden = applicationIsHidden
+    }
+
+    @MainActor
+    public init(window: NSWindow) {
+        self.init(
+            windowIsKey: window.isKeyWindow,
+            applicationIsActive: NSApplication.shared.isActive,
+            windowIsVisible: window.isVisible,
+            windowIsMiniaturized: window.isMiniaturized,
+            windowIsOccluded: !window.occlusionState.contains(.visible),
+            applicationIsHidden: NSApplication.shared.isHidden
+        )
+    }
+}
+
+/// Decides whether the backdrop's timeline should advance for the current state.
+public enum SettingsBackdropAnimationPolicy {
+    public static func shouldTick(
+        animationEnabled: Bool,
+        isInteractionEngaged: Bool,
+        accessibilityReduceMotion: Bool,
+        lifecycleState: SettingsBackdropLifecycleState
+    ) -> Bool {
+        animationEnabled
+            && !isInteractionEngaged
+            && !accessibilityReduceMotion
+            && lifecycleState.windowIsKey
+            && lifecycleState.applicationIsActive
+            && lifecycleState.windowIsVisible
+            && !lifecycleState.windowIsMiniaturized
+            && !lifecycleState.windowIsOccluded
+            && !lifecycleState.applicationIsHidden
+    }
+}
