+- (void)actionInvokedWithName:(NSString*)name payload:(NSDictionary*)payload {
+  if (profile_destroying_ || !model_ || !name.length) {
+    return;
+  }
+  if ([name isEqualToString:@"reset_chrome_ui_scale"]) {
+    model_->ClearPreference(arcium::kChromeUIScalePref);
+    [self modelDidChange];
+    return;
+  }
+  if ([name isEqualToString:@"reset_shared_palette"]) {
+    if (!model_->ResetSharedPalette()) {
+      [self modelDidChange];
+    }
+    return;
+  }
+  [self modelDidChange];
+  if ([name isEqualToString:@"apply_arc_defaults"]) {
+    [self applyArcDefaults];
+  } else if ([name isEqualToString:@"restore_previous"]) {
+    [self restorePreviousShortcuts];
+  } else if ([name isEqualToString:@"reset_all"]) {
+    [self resetAllShortcuts];
+  } else if ([name isEqualToString:@"show_unavailable_arc_shortcuts"]) {
+    [self showUnavailableArcShortcuts];
+  } else if ([name isEqualToString:@"open_advanced"]) {
+    Profile* profile = model_ ? model_->profile() : nullptr;
+    if (profile) {
+      chrome::ShowSettingsSubPageForProfile(profile, "");
+    }
+  } else if ([name isEqualToString:@"reset_appearance"]) {
+    if (model_->SetAppearanceMode(0)) {
+      [self modelDidChange];
+    }
+  } else if ([name isEqualToString:@"reset_chrome_appearance"]) {
+    if (model_->HasPreference(helium::kArciumChromeAppearancePref) &&
+        !model_->IsManaged(helium::kArciumChromeAppearancePref)) {
+      model_->ResetChromeAppearance();
+    }
+  } else if ([name isEqualToString:@"cancel_recording"]) {
+    [self finishRecording:recording_button_];
+  } else if ([name isEqualToString:@"begin_recording"] ||
+             [name isEqualToString:@"add_shortcut"] ||
+             [name isEqualToString:@"change_shortcut"]) {
+    int command_id = -1;
+    if (!GetIntegerObject(payload[@"command_id"], &command_id)) {
+      return;
+    }
+    NSString* shortcut = [payload[@"serialized"] isKindOfClass:[NSString class]]
+                             ? payload[@"serialized"]
+                             : @"";
+    [self beginRecordingForCommand:command_id shortcut:shortcut];
+  } else if ([name isEqualToString:@"remove_shortcut"]) {
+    [self removeShortcutWithPayload:payload];
+  } else if ([name isEqualToString:@"reset_command"]) {
+    [self resetCommandWithPayload:payload];
+  }
+}
+
+- (void)beginRecordingForCommand:(int)commandID shortcut:(NSString*)shortcut {
+  browser_shortcuts::BrowserShortcutService* service =
+      model_ ? model_->shortcut_service() : nullptr;
+  if (profile_destroying_ || !service || !service->CanModifyConfiguration() ||
+      !service->HasCommand(commandID)) {
+    return;
+  }
+
+  if (shortcut.length) {
+    bool found_modifiable_binding = false;
+    for (const browser_shortcuts::CommandInfo& command :
+         service->GetCommands()) {
+      if (command.command_id != commandID) {
+        continue;
+      }
+      for (const browser_shortcuts::ShortcutInfo& binding :
+           command.accelerators) {
+        if ([shortcut
+                isEqualToString:base::SysUTF8ToNSString(binding.serialized)]) {
+          found_modifiable_binding = binding.user_modifiable;
+          break;
+        }
+      }
+      break;
+    }
+    if (!found_modifiable_binding) {
+      return;
+    }
+  }
+
+  [self finishRecording:recording_button_];
+  ArciumShortcutRecorderButton* recorder = [[ArciumShortcutRecorderButton alloc]
+      initWithFrame:NSMakeRect(0, 0, 1, 1)];
+  recorder.commandID = commandID;
+  recorder.shortcut = shortcut ?: @"";
+  recorder.display = @"Recording";
+  recorder.recorderDelegate = self;
+  recorder.alphaValue = 0.0;
+  recorder.translatesAutoresizingMaskIntoConstraints = YES;
+  [settings_ui_controller_.view addSubview:recorder];
+  recording_button_ = recorder;
+  [recorder beginRecording];
+  if (!recorder.isRecording) {
+    [self finishRecording:recorder];
+    return;
+  }
+  [self modelDidChange];
+}
+
+- (void)finishRecording:(ArciumShortcutRecorderButton*)recorder {
+  if (!recorder) {
+    return;
+  }
+  if (recorder == recording_button_) {
+    recording_button_ = nil;
+  }
+  [recorder cancelRecording];
+  [recorder removeFromSuperview];
+  if (self.window.firstResponder == recorder) {
+    [self.window makeFirstResponder:nil];
+  }
+}
+
+- (void)detachRecordingButton {
+  ArciumShortcutRecorderButton* recorder = recording_button_;
+  recording_button_ = nil;
+  if (!recorder) {
+    return;
+  }
+  recorder.recorderDelegate = nil;
+  [recorder cancelRecording];
+  [recorder removeFromSuperview];
+}
+
+- (void)shortcutRecorderDidCancel:(ArciumShortcutRecorderButton*)recorder {
+  if (recorder != recording_button_) {
+    return;
+  }
+  [self finishRecording:recorder];
+  [self modelDidChange];
+}
+
+- (void)shortcutRecorder:(ArciumShortcutRecorderButton*)recorder
+     didRecordSerialized:(NSString*)serialized
+                 display:(NSString*)display {
+  if (recorder != recording_button_ || !model_ || !model_->shortcut_service()) {
+    return;
+  }
+  const int command_id = static_cast<int>(recorder.commandID);
+  NSString* previous_shortcut = [recorder.shortcut copy] ?: @"";
+  [self finishRecording:recorder];
+  [self assignRecordedShortcut:serialized
+                       display:display
+                     commandID:command_id
+              previousShortcut:previous_shortcut];
+}
+
+- (void)assignRecordedShortcut:(NSString*)serialized
+                       display:(NSString*)display
+                     commandID:(int)commandID
+              previousShortcut:(NSString*)previousShortcut {
+  browser_shortcuts::BrowserShortcutService* service =
+      model_ ? model_->shortcut_service() : nullptr;
+  if (profile_destroying_ || !service || !service->CanModifyConfiguration() ||
+      !serialized.length) {
+    return;
+  }
+  const std::string serialized_utf8 = std::string(UTF8View(serialized));
+  if (service->IsAcceleratorLocked(serialized_utf8, commandID)) {
+    [self presentAlertWithTitle:@"That shortcut is reserved"
+                informativeText:@"Choose another shortcut for this command."
+               firstButtonTitle:@"OK"
+              secondButtonTitle:nil
+                     completion:nil];
+    return;
+  }
+
+  std::optional<int> conflict =
+      service->FindCommandForAccelerator(serialized_utf8);
+  if (conflict && *conflict != commandID) {
+    NSString* information =
+        [NSString stringWithFormat:@"%@ is currently assigned to %@.", display,
+                                   CommandName(service, *conflict)];
+    [self presentAlertWithTitle:@"Replace an existing shortcut?"
+                informativeText:information
+               firstButtonTitle:@"Replace"
+              secondButtonTitle:@"Cancel"
+                     completion:^(NSModalResponse response) {
+                       if (response == NSAlertFirstButtonReturn) {
+                         [self commitRecordedShortcut:serialized
+                                              display:display
+                                            commandID:commandID
+                                     previousShortcut:previousShortcut];
+                       }
+                     }];
+    return;
+  }
+
+  [self commitRecordedShortcut:serialized
+                       display:display
+                     commandID:commandID
+              previousShortcut:previousShortcut];
+}
+
+- (void)commitRecordedShortcut:(NSString*)serialized
+                       display:(NSString*)display
+                     commandID:(int)commandID
+              previousShortcut:(NSString*)previousShortcut {
+  browser_shortcuts::BrowserShortcutService* service =
+      model_ ? model_->shortcut_service() : nullptr;
+  if (profile_destroying_ || !service || !service->CanModifyConfiguration() ||
+      !serialized.length) {
+    return;
+  }
+  const std::string serialized_utf8 = std::string(UTF8View(serialized));
+  if (service->IsAcceleratorLocked(serialized_utf8, commandID)) {
+    [self presentAlertWithTitle:@"That shortcut is reserved"
+                informativeText:@"Choose another shortcut for this command."
+               firstButtonTitle:@"OK"
+              secondButtonTitle:nil
+                     completion:nil];
+    return;
+  }
+
+  const browser_shortcuts::AssignmentResult result =
+      service->AssignAcceleratorToCommand(commandID, serialized_utf8);
+  if (result == browser_shortcuts::AssignmentResult::kShortcutLocked) {
+    [self presentAlertWithTitle:@"That shortcut is reserved"
+                informativeText:@"Choose another shortcut for this command."
+               firstButtonTitle:@"OK"
+              secondButtonTitle:nil
+                     completion:nil];
+    return;
+  }
+  if (result != browser_shortcuts::AssignmentResult::kSuccess) {
+    NSBeep();
+    return;
+  }
+  if (previousShortcut.length &&
+      ![previousShortcut isEqualToString:serialized]) {
+    service->UnassignAcceleratorFromCommand(
+        commandID, std::string(UTF8View(previousShortcut)));
+  }
+  [self modelDidChange];
+}
+
+- (void)removeShortcutWithPayload:(NSDictionary*)payload {
+  int command_id = -1;
+  if (!GetIntegerObject(payload[@"command_id"], &command_id)) {
+    return;
+  }
+  NSString* serialized = [payload[@"serialized"] isKindOfClass:[NSString class]]
+                             ? payload[@"serialized"]
+                             : @"";
+  browser_shortcuts::BrowserShortcutService* service =
+      model_ ? model_->shortcut_service() : nullptr;
+  if (!service || !service->CanModifyConfiguration() || !serialized.length ||
+      service->IsAcceleratorLocked(std::string(UTF8View(serialized)),
+                                   command_id)) {
+    return;
+  }
+  if (service->UnassignAcceleratorFromCommand(
+          command_id, std::string(UTF8View(serialized)))) {
+    [self modelDidChange];
+  }
+}
+
+- (void)resetCommandWithPayload:(NSDictionary*)payload {
+  int command_id = -1;
+  if (!GetIntegerObject(payload[@"command_id"], &command_id)) {
+    return;
+  }
+  browser_shortcuts::BrowserShortcutService* service =
+      model_ ? model_->shortcut_service() : nullptr;
+  if (!service || !service->CanModifyConfiguration() ||
+      !service->HasCommand(command_id)) {
+    return;
+  }
+  if (service->ResetAcceleratorsForCommand(command_id)) {
+    [self modelDidChange];
+  }
+}
+
+- (void)applyArcDefaults {
+  browser_shortcuts::BrowserShortcutService* service =
+      model_ ? model_->shortcut_service() : nullptr;
+  if (!service || !service->CanModifyConfiguration()) {
+    return;
+  }
+  [self presentAlertWithTitle:@"Use Arc shortcut defaults?"
+              informativeText:@"Your current shortcut configuration will be "
+                              @"saved so it can be restored later."
+             firstButtonTitle:@"Use Arc defaults"
+            secondButtonTitle:@"Cancel"
+                   completion:^(NSModalResponse response) {
+                     if (response != NSAlertFirstButtonReturn ||
+                         self->profile_destroying_ || !self->model_ ||
+                         !self->model_->profile()) {
+                       return;
+                     }
+                     const browser_shortcuts::arcium::PresetResult result =
+                         self->model_->ApplyArcPreset();
+                     if (!PresetSucceeded(result)) {
+                       [self showPresetFailure:result];
+                     }
+                   }];
+}
+
+- (void)restorePreviousShortcuts {
+  browser_shortcuts::BrowserShortcutService* service =
+      model_ ? model_->shortcut_service() : nullptr;
+  if (!service || !service->CanModifyConfiguration() ||
+      !model_->HasPreviousArcPreset()) {
+    return;
+  }
+  [self presentAlertWithTitle:@"Restore previous shortcuts?"
+              informativeText:@"This replaces shortcut edits made since Arc "
+                              @"defaults were first applied."
+             firstButtonTitle:@"Restore previous"
+            secondButtonTitle:@"Cancel"
+                   completion:^(NSModalResponse response) {
+                     if (response != NSAlertFirstButtonReturn ||
+                         self->profile_destroying_ || !self->model_ ||
+                         !self->model_->profile()) {
+                       return;
+                     }
+                     const browser_shortcuts::arcium::PresetResult result =
+                         self->model_->RestoreArcPreset();
+                     if (!PresetSucceeded(result)) {
+                       [self showPresetFailure:result];
+                     }
+                   }];
+}
+
+- (void)resetAllShortcuts {
+  browser_shortcuts::BrowserShortcutService* service =
+      model_ ? model_->shortcut_service() : nullptr;
+  if (!service || !service->CanModifyConfiguration()) {
+    return;
+  }
+  [self
+      presentAlertWithTitle:@"Reset all browser shortcuts?"
+            informativeText:
+                @"Every customizable shortcut will return to its default."
+           firstButtonTitle:@"Reset all"
+          secondButtonTitle:@"Cancel"
+                 completion:^(NSModalResponse response) {
+                   if (response != NSAlertFirstButtonReturn ||
+                       self->profile_destroying_ || !self->model_ ||
+                       !self->model_->profile()) {
+                     return;
+                   }
+                   browser_shortcuts::BrowserShortcutService* current_service =
+                       self->model_->shortcut_service();
+                   if (current_service &&
+                       current_service->CanModifyConfiguration()) {
+                     current_service->ResetAccelerators();
+                     [self modelDidChange];
+                   }
+                 }];
+}
+
+@end
+
+namespace arcium_settings {
+
+bool ShowForProfile(Profile* profile) {
+  if (!profile) {
+    return false;
+  }
+  Profile* original = profile->GetOriginalProfile();
+  if (!original || !original->GetPrefs()) {
+    return false;
+  }
+
+  NSValue* key = SettingsProfileKey(original);
+  ArciumSettingsWindowController* controller = Controllers()[key];
+  if (!controller) {
+    controller =
+        [[ArciumSettingsWindowController alloc] initWithProfile:original];
+    if (!controller) {
+      return false;
+    }
+    Controllers()[key] = controller;
+  }
+  [controller showWindow:nil];
+  return true;
+}
+
+bool ShowExistingWindow() {
+  for (ArciumSettingsWindowController* controller in Controllers().allValues) {
+    if (controller.window.isKeyWindow || controller.window.isMainWindow) {
+      [controller showWindow:nil];
+      return true;
+    }
+  }
+  return false;
+}
+
+void CloseAllForShutdown() {
+  NSArray<ArciumSettingsWindowController*>* controllers =
+      [Controllers().allValues copy];
+  for (ArciumSettingsWindowController* controller in controllers) {
+    [controller prepareForShutdown];
+  }
+  [Controllers() removeAllObjects];
+}
+
+}  // namespace arcium_settings
