===================================================================
--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_shortcut_recorder.mm
@@ -0,0 +1,289 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#import "chrome/browser/ui/cocoa/arcium_shortcut_recorder.h"
+
+#import <AppKit/AppKit.h>
+#include <Carbon/Carbon.h>
+
+#include <string>
+
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/ui/browser_shortcuts/browser_shortcut_serialization.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/events/cocoa/cocoa_event_utils.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_code_conversion_mac.h"
+
+namespace {
+
+constexpr int kShortcutModifiers = ui::EF_SHIFT_DOWN | ui::EF_CONTROL_DOWN |
+                                   ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN;
+
+bool IsModifierOnlyKeyCode(unsigned short key_code) {
+  switch (key_code) {
+    case kVK_CapsLock:
+    case kVK_Shift:
+    case kVK_RightShift:
+    case kVK_Control:
+    case kVK_RightControl:
+    case kVK_Option:
+    case kVK_RightOption:
+    case kVK_Command:
+    case kVK_RightCommand:
+    case kVK_Function:
+      return true;
+    default:
+      return false;
+  }
+}
+
+NSString* DisplayOrAddShortcut(NSString* display) {
+  return display.length ? display : @"Add shortcut";
+}
+
+}  // namespace
+
+@interface ArciumShortcutRecorderButton () {
+  __weak id<ArciumShortcutRecorderDelegate> recorder_delegate_;
+  NSInteger command_id_;
+  NSString* shortcut_;
+  NSString* display_;
+  BOOL recording_;
+  id local_key_down_monitor_;
+  __weak NSWindow* observed_window_;
+}
+
+- (BOOL)shouldCaptureKeyDown:(NSEvent*)event;
+- (NSEvent*)handleCapturedKeyDown:(NSEvent*)event;
+- (void)installKeyDownMonitor;
+- (void)removeKeyDownMonitor;
+- (void)removeWindowObservers;
+- (void)stopRecordingAndRestoreTitle;
+- (void)cancelRecordingAndNotifyDelegate;
+- (BOOL)resignFirstResponder;
+- (void)windowDidResignKey:(NSNotification*)notification;
+- (void)windowWillClose:(NSNotification*)notification;
+@end
+
+@implementation ArciumShortcutRecorderButton
+
+@synthesize recorderDelegate = recorder_delegate_;
+@synthesize commandID = command_id_;
+@synthesize shortcut = shortcut_;
+@synthesize display = display_;
+@synthesize recording = recording_;
+
+- (instancetype)initWithFrame:(NSRect)frameRect {
+  self = [super initWithFrame:frameRect];
+  if (self) {
+    self.accessibilityHelp = @"Click to record a keyboard shortcut.";
+    self.accessibilityValue = DisplayOrAddShortcut(self.display);
+  }
+  return self;
+}
+
+- (instancetype)initWithCoder:(NSCoder*)coder {
+  self = [super initWithCoder:coder];
+  if (self) {
+    self.accessibilityHelp = @"Click to record a keyboard shortcut.";
+    self.accessibilityValue = DisplayOrAddShortcut(self.display);
+  }
+  return self;
+}
+
+- (void)setDisplay:(NSString*)display {
+  display_ = [display copy];
+  if (!self.isRecording) {
+    NSString* title = DisplayOrAddShortcut(display_);
+    self.title = title;
+    self.accessibilityValue = title;
+  }
+}
+
+- (BOOL)acceptsFirstResponder {
+  return YES;
+}
+
+- (void)beginRecording {
+  [self stopRecordingAndRestoreTitle];
+  if (!self.window) {
+    return;
+  }
+
+  self.recording = YES;
+  self.title = @"Press keys…";
+  self.toolTip = @"Press a shortcut, or press Escape to cancel";
+  self.accessibilityHelp =
+      @"Press a shortcut, or press Escape to cancel recording.";
+  self.accessibilityValue = @"Recording";
+
+  if (![self.window makeFirstResponder:self]) {
+    [self stopRecordingAndRestoreTitle];
+    return;
+  }
+
+  observed_window_ = self.window;
+  NSNotificationCenter* notifications = [NSNotificationCenter defaultCenter];
+  [notifications addObserver:self
+                    selector:@selector(windowDidResignKey:)
+                        name:NSWindowDidResignKeyNotification
+                      object:observed_window_];
+  [notifications addObserver:self
+                    selector:@selector(windowWillClose:)
+                        name:NSWindowWillCloseNotification
+                      object:observed_window_];
+  [self installKeyDownMonitor];
+  [self setNeedsDisplay:YES];
+}
+
+- (void)cancelRecording {
+  [self stopRecordingAndRestoreTitle];
+}
+
+- (void)cancelRecordingAndNotifyDelegate {
+  if (!self.isRecording) {
+    return;
+  }
+  [self stopRecordingAndRestoreTitle];
+  id<ArciumShortcutRecorderDelegate> delegate = self.recorderDelegate;
+  if ([delegate respondsToSelector:@selector(shortcutRecorderDidCancel:)]) {
+    [delegate shortcutRecorderDidCancel:self];
+  }
+}
+
+- (void)keyDown:(NSEvent*)event {
+  if ([self shouldCaptureKeyDown:event]) {
+    [self handleCapturedKeyDown:event];
+    return;
+  }
+  [super keyDown:event];
+}
+
+- (void)viewWillMoveToWindow:(NSWindow*)newWindow {
+  if (newWindow != self.window) {
+    [self cancelRecordingAndNotifyDelegate];
+  }
+  [super viewWillMoveToWindow:newWindow];
+}
+
+- (void)dealloc {
+  [self removeKeyDownMonitor];
+  [self removeWindowObservers];
+}
+
+- (BOOL)resignFirstResponder {
+  [self cancelRecordingAndNotifyDelegate];
+  return [super resignFirstResponder];
+}
+
+- (BOOL)shouldCaptureKeyDown:(NSEvent*)event {
+  return self.recording && self.window && self.window.isKeyWindow &&
+         event.window == self.window && self.window.firstResponder == self;
+}
+
+- (NSEvent*)handleCapturedKeyDown:(NSEvent*)event {
+  if (event.isARepeat) {
+    return nil;
+  }
+
+  if (event.keyCode == kVK_Escape) {
+    [self cancelRecordingAndNotifyDelegate];
+    return nil;
+  }
+
+  if (IsModifierOnlyKeyCode(event.keyCode)) {
+    NSBeep();
+    return nil;
+  }
+
+  ui::KeyboardCode key_code = ui::KeyboardCodeFromNSEvent(event);
+  if (key_code == ui::VKEY_UNKNOWN) {
+    NSBeep();
+    return nil;
+  }
+
+  const int modifiers =
+      ui::EventFlagsFromModifiers(event.modifierFlags) & kShortcutModifiers;
+  const ui::Accelerator accelerator(key_code, modifiers);
+  const std::string serialized =
+      browser_shortcuts::AcceleratorToString(accelerator);
+  const std::u16string display =
+      browser_shortcuts::AcceleratorToDisplayString(accelerator);
+  if (serialized.empty() || display.empty()) {
+    NSBeep();
+    return nil;
+  }
+
+  [self stopRecordingAndRestoreTitle];
+  id<ArciumShortcutRecorderDelegate> delegate = self.recorderDelegate;
+  if ([delegate respondsToSelector:@selector(shortcutRecorder:
+                                          didRecordSerialized:display:)]) {
+    [delegate shortcutRecorder:self
+           didRecordSerialized:base::SysUTF8ToNSString(serialized)
+                       display:base::SysUTF16ToNSString(display)];
+  }
+  return nil;
+}
+
+- (void)installKeyDownMonitor {
+  [self removeKeyDownMonitor];
+
+  __weak ArciumShortcutRecorderButton* weakSelf = self;
+  local_key_down_monitor_ = [NSEvent
+      addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown
+                                   handler:^NSEvent*(NSEvent* event) {
+                                     ArciumShortcutRecorderButton* strongSelf =
+                                         weakSelf;
+                                     if (!strongSelf ||
+                                         ![strongSelf
+                                             shouldCaptureKeyDown:event]) {
+                                       return event;
+                                     }
+                                     return [strongSelf
+                                         handleCapturedKeyDown:event];
+                                   }];
+}
+
+- (void)removeKeyDownMonitor {
+  if (!local_key_down_monitor_) {
+    return;
+  }
+  id monitor = local_key_down_monitor_;
+  local_key_down_monitor_ = nil;
+  [NSEvent removeMonitor:monitor];
+}
+
+- (void)removeWindowObservers {
+  NSNotificationCenter* notifications = [NSNotificationCenter defaultCenter];
+  [notifications removeObserver:self
+                           name:NSWindowDidResignKeyNotification
+                         object:observed_window_];
+  [notifications removeObserver:self
+                           name:NSWindowWillCloseNotification
+                         object:observed_window_];
+  observed_window_ = nil;
+}
+
+- (void)stopRecordingAndRestoreTitle {
+  self.recording = NO;
+  [self removeKeyDownMonitor];
+  [self removeWindowObservers];
+
+  NSString* title = DisplayOrAddShortcut(self.display);
+  self.title = title;
+  self.accessibilityValue = title;
+  self.accessibilityHelp = @"Click to record a keyboard shortcut.";
+  [self setNeedsDisplay:YES];
+}
+
+- (void)windowDidResignKey:(NSNotification*)notification {
+  [self cancelRecordingAndNotifyDelegate];
+}
+
+- (void)windowWillClose:(NSNotification*)notification {
+  [self cancelRecordingAndNotifyDelegate];
+}
+
+@end
