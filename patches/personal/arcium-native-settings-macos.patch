+import Foundation
+import SettingsUI
+import SwiftUI
+
+/// Color relationships used by the browser chrome color editor.
+public enum ArciumColorHarmony: String, CaseIterable, Hashable, Identifiable, Sendable {
+    case custom
+    case complementary
+    case splitComplementary
+    case triadic
+    case tetradic
+
+    public var id: String { rawValue }
+
+    public var title: String {
+        switch self {
+        case .custom: "Custom"
+        case .complementary: "Complementary"
+        case .splitComplementary: "Split complementary"
+        case .triadic: "Triadic"
+        case .tetradic: "Tetradic"
+        }
+    }
+
+    /// Hue offsets are normalized to one full turn and are anchored at array
+    /// index zero. A mode keeps the requested color count; counts other than
+    /// the mode's canonical count use an even progression around the wheel.
+    public func offsets(for count: Int) -> [Double] {
+        let count = max(0, count)
+        guard count > 0 else { return [] }
+        switch self {
+        case .custom:
+            return Array(repeating: 0, count: count)
+        case .complementary:
+            return count == 2 ? [0, 0.5] : Self.evenOffsets(for: count)
+        case .splitComplementary:
+            return count == 3 ? [0, 5.0 / 12.0, 7.0 / 12.0] : Self.evenOffsets(for: count)
+        case .triadic:
+            return count == 3 ? [0, 1.0 / 3.0, 2.0 / 3.0] : Self.evenOffsets(for: count)
+        case .tetradic:
+            return count == 4 ? [0, 0.25, 0.5, 0.75] : Self.evenOffsets(for: count)
+        }
+    }
+
+    /// Selects the Arc-style progression that fits a palette's point count.
+    public static func automatic(for count: Int) -> Self {
+        switch max(1, min(count, 4)) {
+        case 1: .custom
+        case 2: .complementary
+        case 3: .splitComplementary
+        default: .tetradic
+        }
+    }
+
+    private static func evenOffsets(for count: Int) -> [Double] {
+        guard count > 1 else { return [0] }
+        return (0..<count).map { Double($0) / Double(count) }
+    }
+}
+
+/// An HSV color with a normalized hue in `0...1` and saturation/brightness in
+/// `0...1`. The fallback hue keeps grayscale colors stable when a harmony is
+/// applied or a user moves the hue/saturation field.
+public struct ArciumHarmonyColorHSV: Equatable, Sendable {
+    public var hue: Double
+    public var saturation: Double
+    public var brightness: Double
+
+    public init(hue: Double, saturation: Double, brightness: Double) {
+        self.hue = Self.wrapped(hue)
+        self.saturation = Self.clamped(saturation)
+        self.brightness = Self.clamped(brightness)
+    }
+
+    public init?(hex: String, fallbackHue: Double = 0) {
+        guard let rgb = SettingsRGB(hex: hex) else { return nil }
+
+        let maximum = max(rgb.red, max(rgb.green, rgb.blue))
+        let minimum = min(rgb.red, min(rgb.green, rgb.blue))
+        let delta = maximum - minimum
+        let saturation = maximum == 0 ? 0 : delta / maximum
+        let hue: Double
+        if delta < 0.000001 {
+            hue = Self.wrapped(fallbackHue)
+        } else if maximum == rgb.red {
+            hue = ((rgb.green - rgb.blue) / delta).truncatingRemainder(dividingBy: 6) / 6
+        } else if maximum == rgb.green {
+            hue = ((rgb.blue - rgb.red) / delta + 2) / 6
+        } else {
+            hue = ((rgb.red - rgb.green) / delta + 4) / 6
+        }
+
+        self.init(hue: hue, saturation: saturation, brightness: maximum)
+    }
+
+    public var hueDegrees: Double { hue * 360 }
+
+    public var hex: String {
+        guard brightness > 0 else { return "#000000" }
+        guard saturation > 0 else {
+            return SettingsRGB(red: brightness, green: brightness, blue: brightness).hex
+        }
+
+        let position = Self.wrapped(hue) * 6
+        let sector = Int(floor(position)) % 6
+        let fraction = position - floor(position)
+        let p = brightness * (1 - saturation)
+        let q = brightness * (1 - saturation * fraction)
+        let t = brightness * (1 - saturation * (1 - fraction))
+        let rgb: (Double, Double, Double)
+        switch sector {
+        case 0: rgb = (brightness, t, p)
+        case 1: rgb = (q, brightness, p)
+        case 2: rgb = (p, brightness, t)
+        case 3: rgb = (p, q, brightness)
+        case 4: rgb = (t, p, brightness)
+        default: rgb = (brightness, p, q)
+        }
+        return SettingsRGB(red: rgb.0, green: rgb.1, blue: rgb.2).hex
+    }
+
+    public var color: Color {
+        (SettingsRGB(hex: hex) ?? SettingsRGB(red: 1, green: 1, blue: 1)).color
+    }
+
+    public func applyingHueOffset(_ offset: Double) -> Self {
+        Self(hue: hue + offset, saturation: saturation, brightness: brightness)
+    }
+
+    public static func wrapped(_ value: Double) -> Double {
+        guard value.isFinite else { return 0 }
+        let result = value.truncatingRemainder(dividingBy: 1)
+        return result >= 0 ? result : result + 1
+    }
+
+    private static func clamped(_ value: Double) -> Double {
+        value.isFinite ? min(max(value, 0), 1) : 0
+    }
+}
+
+/// A normalized hue and radial saturation used by the harmony color wheel.
+public struct ArciumHarmonyWheelValue: Equatable, Sendable {
+    public let hue: Double
+    public let saturation: Double
+
+    public init(hue: Double, saturation: Double) {
+        self.hue = ArciumHarmonyColorHSV.wrapped(hue)
+        self.saturation = saturation.isFinite ? min(max(saturation, 0), 1) : 0
+    }
+}
+
+/// A small host-owned harmony picker. It edits only the supplied color array;
+/// the host remains responsible for persistence and for choosing the active
+/// point through `selectedIndex`.
+public struct ArciumColorHarmonyPicker: View {
+    public let colors: [String]
+    public let selectedIndex: Int
+
+    @Binding private var mode: ArciumColorHarmony
+    private let onAddColor: (() -> Void)?
+    private let onRemoveColor: (() -> Void)?
+    private let onColorsChanged: ([String]) -> Void
+    @Environment(\.settingsTheme) private var theme
+    @State private var draftColors: [String]
+    @State private var lastObservedColors: [String]
+    @State private var deferredExternalColors: [String]?
+    @State private var isDragging = false
+    @State private var brightness = 1.0
+    @State private var hueFallback = 0.0
+    @State private var hexText = "#FFFFFF"
+    @State private var invalidHex = false
