+import AppKit
+import Foundation
+import SwiftUI
+
+/// Host-owned palette experiment. Semantic hues remain distinct from brand hue.
+public struct SettingsPaletteConfiguration: Sendable, Equatable, Codable {
+    public var accentSource = SettingsPaletteAccentSource.brand
+    public var customAccent = SettingsOKLCH(lightness: 0.65, chroma: 0.14, hue: 245)
+    public var brandLightness = 0.65
+    public var harmony = SettingsPaletteHarmony.analogous
+    public var chromeSource = SettingsPaletteChromeSource.brand
+    public var companion = SettingsOKLCH(lightness: 0.65, chroma: 0.14, hue: 35)
+    public var hue = 285.0
+    public var chroma = 0.14
+    public var neutralHue = 270.0
+    public var neutralChroma = 0.015
+    public var textContrast = 4.5
+    public var lightCanvas = 0.97
+    public var darkCanvas = 0.17
+
+    public init() {}
+
+    public func ramp(hue: Double? = nil, chroma: Double? = nil) -> [SettingsOKLCH] {
+        [0.98, 0.95, 0.90, 0.82, 0.72, 0.62, 0.52, 0.42, 0.32, 0.24, 0.17, 0.10].map { lightness in
+            SettingsOKLCH(lightness: lightness,
+                chroma: (chroma ?? self.chroma) * sin(.pi * lightness), hue: hue ?? self.hue)
+        }
+    }
+
+    public func colors(
+        dark: Bool,
+        cardOpacity: Double = 1,
+        panelOpacity: Double = 1
+    ) -> [SettingsThemeColorToken: SettingsRGB] {
+        let canvasL = dark ? darkCanvas : lightCanvas
+        func neutral(_ l: Double) -> SettingsRGB {
+            SettingsOKLCH(lightness: l, chroma: resolvedNeutralChroma, hue: resolvedNeutralHue).rgb
+        }
+        let canvas = neutral(canvasL)
+        let panel = neutral(dark ? min(canvasL + 0.045, 0.35) : 0.995)
+        let card = neutral(dark ? min(canvasL + 0.075, 0.4) : 0.98)
+        let control = neutral(dark ? min(canvasL + 0.11, 0.45) : 0.95)
+        let visiblePanel = panel.composited(over: canvas, opacity: panelOpacity)
+        let visibleCard = card.composited(over: visiblePanel, opacity: cardOpacity)
+        let backgrounds = [canvas, visiblePanel, visibleCard, control]
+        func accessible(_ hue: Double, _ chroma: Double, target: Double, start: Double) -> SettingsRGB {
+            // Search toward the readable pole and check every candidate after gamut mapping.
+            let pole = dark ? 1.0 : 0.0
+            for step in 0...200 {
+                let l = start + (pole - start) * Double(step) / 200
+                let rgb = SettingsOKLCH(lightness: l, chroma: chroma, hue: hue).rgb
+                if backgrounds.allSatisfy({ rgb.contrast(against: $0) >= target }) { return rgb }
+            }
+            return neutral(pole)
+        }
+        let target = textContrast.isFinite ? min(max(textContrast, 4.5), 7) : 4.5
+        let text = accessible(resolvedNeutralHue, resolvedNeutralChroma, target: 7, start: dark ? 0.94 : 0.16)
+        let secondary = accessible(resolvedNeutralHue, resolvedNeutralChroma, target: target, start: dark ? 0.65 : 0.55)
+        let accent = accessible(resolvedAccent.hue, resolvedAccent.chroma, target: target, start: dark ? 0.65 : 0.55)
+        let error = accessible(25, 0.16, target: target, start: dark ? 0.7 : 0.5)
+        let warning = accessible(80, 0.14, target: target, start: dark ? 0.7 : 0.5)
+        let success = accessible(150, 0.13, target: target, start: dark ? 0.7 : 0.5)
+        let black = neutral(0)
+        let white = neutral(1)
+        let onAccent = black.contrast(against: accent) > white.contrast(against: accent) ? black : white
+        var result: [SettingsThemeColorToken: SettingsRGB] = [:]
+        for token in SettingsThemeColorToken.allCases {
+            switch token {
+            case .windowFrame, .windowCanvas, .sidebarRail: result[token] = canvas
+            case .windowCanvasWash, .panel, .sidebarPanel: result[token] = panel
+            case .panelRaised, .card, .cardElevated: result[token] = card
+            case .panelInset, .control, .controlSecondary, .controlHover: result[token] = control
+            case .controlSelectionFill, .selection, .selectionStrong, .selectionHover: result[token] = accent
+            case .selectionText: result[token] = onAccent
+            case .textPrimary: result[token] = text
+            case .textSecondary, .textTertiary: result[token] = secondary
+            case .borderSubtle: result[token] = neutral(dark ? 0.4 : 0.8)
+            case .borderEmphasis, .borderControl: result[token] = neutral(dark ? 0.55 : 0.65)
+            case .borderDanger, .error, .errorText: result[token] = error
+            case .borderWarning, .warning, .warningText: result[token] = warning
+            case .borderSuccess, .success, .successText: result[token] = success
+            case .errorSurface: result[token] = SettingsOKLCH(lightness: dark ? 0.24 : 0.95, chroma: 0.03, hue: 25).rgb
+            case .warningSurface: result[token] = SettingsOKLCH(lightness: dark ? 0.24 : 0.95, chroma: 0.03, hue: 80).rgb
+            case .successSurface: result[token] = SettingsOKLCH(lightness: dark ? 0.24 : 0.95, chroma: 0.03, hue: 150).rgb
+            case .shadowAmbient, .shadowLifted: result[token] = black
+            }
+        }
+        return result
+    }
+
+    public func theme(
+        borderWidth: CGFloat = 0.5,
+        cardOpacity: CGFloat = 1,
+        panelOpacity: CGFloat = 1
+    ) -> SettingsTheme {
+        let light = colors(dark: false, cardOpacity: cardOpacity, panelOpacity: panelOpacity)
+        let dark = colors(dark: true, cardOpacity: cardOpacity, panelOpacity: panelOpacity)
+        func adaptive(_ token: SettingsThemeColorToken) -> Color {
+            let a = light[token]!
+            let b = dark[token]!
+            return Color(nsColor: NSColor(name: nil) { appearance in
+                let rgb = appearance.bestMatch(from: [.aqua, .darkAqua]) == .darkAqua ? b : a
+                return NSColor(srgbRed: rgb.red, green: rgb.green, blue: rgb.blue, alpha: 1)
+            })
+        }
+        return SettingsTheme(
+            accent: adaptive(.selectionStrong),
+            windowFrame: adaptive(.windowFrame),
+            windowCanvas: adaptive(.windowCanvas),
+            windowCanvasWash: adaptive(.windowCanvasWash),
+            panel: adaptive(.panel),
+            panelRaised: adaptive(.panelRaised),
+            panelInset: adaptive(.panelInset),
+            sidebarRail: adaptive(.sidebarRail),
+            sidebarPanel: adaptive(.sidebarPanel),
+            card: adaptive(.card),
+            cardElevated: adaptive(.cardElevated),
+            control: adaptive(.control),
+            controlSecondary: adaptive(.controlSecondary),
+            controlHover: adaptive(.controlHover),
+            controlSelectionFill: adaptive(.controlSelectionFill),
+            selection: adaptive(.selection),
+            selectionHover: adaptive(.selectionHover),
+            selectionText: adaptive(.selectionText),
+            borderSubtle: adaptive(.borderSubtle),
+            borderEmphasis: adaptive(.borderEmphasis),
+            borderControl: adaptive(.borderControl),
+            borderDanger: adaptive(.borderDanger),
+            borderWarning: adaptive(.borderWarning),
+            borderSuccess: adaptive(.borderSuccess),
+            shadowAmbient: adaptive(.shadowAmbient).opacity(0.2),
+            shadowLifted: adaptive(.shadowLifted).opacity(0.2),
+            textPrimary: adaptive(.textPrimary),
+            textSecondary: adaptive(.textSecondary),
+            textTertiary: adaptive(.textTertiary),
+            error: adaptive(.error),
+            warning: adaptive(.warning),
+            success: adaptive(.success),
+            errorSurface: adaptive(.errorSurface),
+            errorText: adaptive(.errorText),
+            warningSurface: adaptive(.warningSurface),
+            warningText: adaptive(.warningText),
+            successSurface: adaptive(.successSurface),
+            successText: adaptive(.successText),
+            borderWidth: borderWidth,
+            increasedContrastBorderWidth: borderWidth == 0 ? 0 : 1,
+            cardOpacity: cardOpacity
+        )
+    }
+}
