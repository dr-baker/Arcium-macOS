+import Foundation
+import CoreGraphics
+import SettingsUI
+import XCTest
+@testable import ArciumSettingsUI
+
+final class ArciumColorHarmonyTests: XCTestCase {
+    @MainActor
+    func testCanonicalOffsetsAndAutomaticProgression() {
+        XCTAssertEqual(ArciumColorHarmony.complementary.offsets(for: 2), [0, 0.5])
+        XCTAssertEqual(
+            ArciumColorHarmony.splitComplementary.offsets(for: 3),
+            [0, 5.0 / 12.0, 7.0 / 12.0]
+        )
+        XCTAssertEqual(ArciumColorHarmony.triadic.offsets(for: 3), [0, 1.0 / 3.0, 2.0 / 3.0])
+        XCTAssertEqual(ArciumColorHarmony.tetradic.offsets(for: 4), [0, 0.25, 0.5, 0.75])
+
+        XCTAssertEqual(ArciumColorHarmony.automatic(for: 1), .custom)
+        XCTAssertEqual(ArciumColorHarmony.automatic(for: 2), .complementary)
+        XCTAssertEqual(ArciumColorHarmony.automatic(for: 3), .splitComplementary)
+        XCTAssertEqual(ArciumColorHarmony.automatic(for: 4), .tetradic)
+    }
+
+    @MainActor
+    func testHarmonyWrapsHueAndUsesSelectedIndexAsActiveHandle() throws {
+        let colors = ["#CC3333", "#33CCCC"]
+        let selected = try XCTUnwrap(ArciumHarmonyColorHSV(hex: colors[1]))
+        let result = ArciumColorHarmonyPicker.applyingHarmony(
+            to: colors,
+            selectedIndex: 1,
+            mode: .complementary
+        )
+
+        XCTAssertEqual(result.count, colors.count)
+        let first = try XCTUnwrap(ArciumHarmonyColorHSV(hex: result[0]))
+        let second = try XCTUnwrap(ArciumHarmonyColorHSV(hex: result[1]))
+        XCTAssertEqual(second.saturation, selected.saturation, accuracy: 0.01)
+        XCTAssertEqual(second.brightness, selected.brightness, accuracy: 0.01)
+        XCTAssertEqual(first.saturation, selected.saturation, accuracy: 0.01)
+        XCTAssertEqual(first.brightness, selected.brightness, accuracy: 0.01)
+        XCTAssertEqual(
+            ArciumHarmonyColorHSV.wrapped(second.hue - first.hue),
+            0.5,
+            accuracy: 0.01
+        )
+    }
+
+    @MainActor
+    func testCustomModeChangesOnlySelectedColor() {
+        let colors = ["#FF0000", "#00FF00", "#0000FF"]
+        let result = ArciumColorHarmonyPicker.applyingHarmony(
+            to: colors,
+            selectedIndex: 1,
+            mode: .custom
+        )
+
+        XCTAssertEqual(result, colors)
+        XCTAssertEqual(result.count, 3)
+    }
+
+    @MainActor
+    func testInvalidHexIsRejected() {
+        XCTAssertNil(ArciumHarmonyColorHSV(hex: "blue"))
+        XCTAssertNil(ArciumHarmonyColorHSV(hex: "#12345"))
+        XCTAssertNil(ArciumHarmonyColorHSV(hex: "#GGGGGG"))
+    }
+
+    @MainActor
+    func testAchromaticColorsKeepThePassedFallbackHue() throws {
+        let gray = try XCTUnwrap(ArciumHarmonyColorHSV(hex: "#808080", fallbackHue: 0.37))
+        XCTAssertEqual(gray.saturation, 0, accuracy: 0.0001)
+        XCTAssertEqual(gray.hue, 0.37, accuracy: 0.0001)
+
+        let black = try XCTUnwrap(ArciumHarmonyColorHSV(hex: "#000000", fallbackHue: 1.37))
+        XCTAssertEqual(black.saturation, 0, accuracy: 0.0001)
+        XCTAssertEqual(black.hue, 0.37, accuracy: 0.0001)
+    }
+
+    @MainActor
+    func testHarmonyPreservesPaletteCountAndSelectedHSV() throws {
+        let colors = ["#204060", "#806040", "#406020", "#604080"]
+        let selected = try XCTUnwrap(ArciumHarmonyColorHSV(hex: colors[2]))
+        let result = ArciumColorHarmonyPicker.applyingHarmony(
+            to: colors,
+            selectedIndex: 2,
+            mode: .tetradic
+        )
+
+        XCTAssertEqual(result.count, colors.count)
+        let resultSelected = try XCTUnwrap(ArciumHarmonyColorHSV(hex: result[2]))
+        XCTAssertEqual(resultSelected.saturation, selected.saturation, accuracy: 0.01)
+        XCTAssertEqual(resultSelected.brightness, selected.brightness, accuracy: 0.01)
+        XCTAssertEqual(result.map { $0.count }, Array(repeating: 7, count: 4))
+    }
+
+    @MainActor
+    func testNonCanonicalModeCountsStillReturnDeterministicCount() {
+        for mode in ArciumColorHarmony.allCases {
+            for count in 1...4 {
+                let offsets = mode.offsets(for: count)
+                XCTAssertEqual(offsets.count, count)
+                XCTAssertEqual(offsets.first, 0)
+                XCTAssertTrue(offsets.allSatisfy { $0 >= 0 && $0 < 1 })
+            }
+        }
+    }
+
+    @MainActor
+    func testHarmonyKeepsLargerInputSafeAndOrdered() throws {
+        let colors = ["#CC3333", "#33CCCC", "#33CC33", "#CCCC33", "#CC33CC"]
+        let result = ArciumColorHarmonyPicker.applyingHarmony(
+            to: colors,
+            selectedIndex: 4,
+            mode: .complementary
+        )
+
+        XCTAssertEqual(result.count, colors.count)
+        XCTAssertTrue(result.allSatisfy { SettingsRGB(hex: $0) != nil })
+    }
+
+    @MainActor
+    func testHarmonyPreservesGrayscaleValueAcrossCompanions() throws {
+        let colors = ["#808080", "#C0C0C0"]
+        let selected = try XCTUnwrap(ArciumHarmonyColorHSV(hex: colors[0], fallbackHue: 0.61))
+        let result = ArciumColorHarmonyPicker.applyingHarmony(
+            to: colors,
+            selectedIndex: 0,
+            mode: .complementary,
+            fallbackHue: 0.61
+        )
+
+        XCTAssertEqual(result.count, 2)
+        let companions = try result.map {
+            try XCTUnwrap(ArciumHarmonyColorHSV(hex: $0, fallbackHue: 0.61))
+        }
+        XCTAssertTrue(companions.allSatisfy { $0.saturation == 0 })
+        XCTAssertTrue(companions.allSatisfy { abs($0.brightness - selected.brightness) < 0.01 })
+    }
+
+    @MainActor
+    func testWheelCenterAndEdgeCoordinateConversion() {
+        let size = CGSize(width: 200, height: 200)
+        let center = ArciumColorHarmonyPicker.wheelPoint(hue: 0.2, saturation: 0, in: size)
+        XCTAssertEqual(center.x, 100, accuracy: 0.0001)
+        XCTAssertEqual(center.y, 100, accuracy: 0.0001)
+
+        let centerValue = ArciumColorHarmonyPicker.wheelValue(
+            at: center,
+            in: size,
+            fallbackHue: 0.37
+        )
+        XCTAssertEqual(centerValue?.hue ?? -1, 0.37, accuracy: 0.0001)
+        XCTAssertEqual(centerValue?.saturation ?? -1, 0, accuracy: 0.0001)
+
+        let top = ArciumColorHarmonyPicker.wheelPoint(hue: 0, saturation: 1, in: size)
+        XCTAssertEqual(top.x, 100, accuracy: 0.0001)
+        XCTAssertEqual(top.y, 0, accuracy: 0.0001)
+        let topValue = ArciumColorHarmonyPicker.wheelValue(at: top, in: size)
+        XCTAssertEqual(topValue?.hue ?? -1, 0, accuracy: 0.0001)
+        XCTAssertEqual(topValue?.saturation ?? -1, 1, accuracy: 0.0001)
+
+        let right = ArciumColorHarmonyPicker.wheelPoint(hue: 0.25, saturation: 1, in: size)
+        XCTAssertEqual(right.x, 200, accuracy: 0.0001)
+        XCTAssertEqual(right.y, 100, accuracy: 0.0001)
+        let rightValue = ArciumColorHarmonyPicker.wheelValue(at: right, in: size)
+        XCTAssertEqual(rightValue?.hue ?? -1, 0.25, accuracy: 0.0001)
+        XCTAssertEqual(rightValue?.saturation ?? -1, 1, accuracy: 0.0001)
+    }
+
+    @MainActor
+    func testWheelOutsidePointsClampToEdgeAndWrapAngles() {
+        let size = CGSize(width: 200, height: 200)
+        let outside = ArciumColorHarmonyPicker.wheelValue(
+            at: CGPoint(x: 250, y: 100),
+            in: size
+        )
+        XCTAssertEqual(outside?.hue ?? -1, 0.25, accuracy: 0.0001)
+        XCTAssertEqual(outside?.saturation ?? -1, 1, accuracy: 0.0001)
+
+        let wrapped = ArciumColorHarmonyPicker.wheelPoint(hue: -0.25, saturation: 1, in: size)
+        let wrappedValue = ArciumColorHarmonyPicker.wheelValue(at: wrapped, in: size)
+        XCTAssertEqual(wrappedValue?.hue ?? -1, 0.75, accuracy: 0.0001)
+    }
+
+    @MainActor
+    func testCustomRandomizationUsesOneSamplePerColor() {
+        let samples = [
+            ArciumHarmonyColorHSV(hue: 0.1, saturation: 0.6, brightness: 0.8),
+            ArciumHarmonyColorHSV(hue: 0.4, saturation: 0.7, brightness: 0.9),
+            ArciumHarmonyColorHSV(hue: 0.8, saturation: 0.5, brightness: 1)
+        ]
+        var nextSample = 0
+        let result = ArciumColorHarmonyPicker.randomizedColors(count: samples.count, mode: .custom) {
+            defer { nextSample += 1 }
+            return samples[nextSample]
+        }
+
+        XCTAssertEqual(nextSample, samples.count)
+        XCTAssertEqual(result, samples.map(\.hex))
+    }
+
+    @MainActor
+    func testLinkedRandomizationUsesOneBaseAndHarmonyOffsets() throws {
+        let base = ArciumHarmonyColorHSV(hue: 0.9, saturation: 0.7, brightness: 0.8)
+        var sampleCount = 0
+        let result = ArciumColorHarmonyPicker.randomizedColors(count: 3, mode: .splitComplementary) {
+            sampleCount += 1
+            return base
+        }
+
+        XCTAssertEqual(sampleCount, 1)
+        let parsed = try result.map { try XCTUnwrap(ArciumHarmonyColorHSV(hex: $0)) }
+        let offsets = ArciumColorHarmony.splitComplementary.offsets(for: 3)
+        for index in parsed.indices {
+            XCTAssertEqual(
+                ArciumHarmonyColorHSV.wrapped(parsed[index].hue - parsed[0].hue),
+                offsets[index],
+                accuracy: 0.01
+            )
+            XCTAssertEqual(parsed[index].saturation, base.saturation, accuracy: 0.01)
+            XCTAssertEqual(parsed[index].brightness, base.brightness, accuracy: 0.01)
+        }
+    }
+}
