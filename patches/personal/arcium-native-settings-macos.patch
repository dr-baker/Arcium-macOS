+    @MainActor
+    func testSharedPalettePendingDraftSurvivesOlderAcknowledgement() throws {
+        let delegate = TestDelegate()
+        let store = ArciumSettingsStore(snapshot: [
+            "available": true,
+            "appearance": [
+                "palette": ["available": true, "managed": false]
+            ]
+        ], delegate: delegate, presetBundleURL: Bundle.module.bundleURL)
+        let originalSnapshot = store.snapshot
+
+        var first = store.sharedPalette()
+        first.hue = 120
+        store.applySharedPalette(first)
+
+        var latest = store.sharedPalette()
+        XCTAssertEqual(latest.hue, 120, "The second edit must retain the unacknowledged first edit")
+        latest.neutralChroma = 0.03
+        store.applySharedPalette(latest)
+
+        XCTAssertEqual(store.pendingSharedPalette, latest)
+        XCTAssertEqual(store.sharedPalette(), latest)
+        XCTAssertEqual(store.snapshot, originalSnapshot)
+
+        store.updateSnapshot(try Self.snapshotWithPalette(first))
+        XCTAssertEqual(store.pendingSharedPalette, latest)
+        XCTAssertEqual(store.sharedPalette(), latest)
+
+        store.updateSnapshot(try Self.snapshotWithPalette(latest))
+        XCTAssertNil(store.pendingSharedPalette)
+        XCTAssertEqual(store.sharedPalette(), latest)
+
+        var external = latest
+        external.hue = 42
+        store.updateSnapshot(try Self.snapshotWithPalette(external))
+        XCTAssertEqual(store.sharedPalette(), external)
+    }
