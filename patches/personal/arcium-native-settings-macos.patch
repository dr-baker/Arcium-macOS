+
+bool IsBooleanObject(id value) {
+  return [value isKindOfClass:[NSNumber class]];
+}
+
+bool GetBooleanObject(id value, bool* result) {
+  if (!result || !IsBooleanObject(value)) {
+    return false;
+  }
+  *result = [value boolValue];
+  return true;
+}
+
+bool GetIntegerObject(id value, int* result) {
+  if (!result || !IsBooleanObject(value)) {
+    return false;
+  }
+  const long long integer = [value longLongValue];
+  if (integer < std::numeric_limits<int>::min() ||
+      integer > std::numeric_limits<int>::max()) {
+    return false;
+  }
+  *result = static_cast<int>(integer);
+  return true;
+}
