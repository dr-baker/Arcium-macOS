+struct ArciumShortcutBinding: Identifiable, Equatable {
+    let serialized: String
+    let display: String
+    let locked: Bool
+
+    var id: String { serialized }
+}
+
+struct ArciumShortcutCommand: Identifiable, Equatable {
+    let id: Int
+    let name: String
+    let bindings: [ArciumShortcutBinding]
+    let modified: Bool
+}
+
+struct ArciumShortcutUnavailable: Identifiable, Equatable {
+    let name: String
+    let reason: String
+
+    var id: String { name }
+}
+
+struct ArciumShortcutsSnapshot: Equatable {
+    var canModify = false
+    var commands: [ArciumShortcutCommand] = []
+    var arcSupportedCount = 0
+    var arcUnavailable: [ArciumShortcutUnavailable] = []
+    var hasPrevious = false
+    var recordingCommandID: Int? = nil
+    var isAvailable = true
+
+    init(_ dictionary: [String: Any]) {
+        canModify = boolean(dictionary["canModify"])
+        commands = dictionaries(dictionary["commands"]).compactMap {
+            (command: [String: Any]) -> ArciumShortcutCommand? in
+            guard let id = integerOptional(command["id"]),
+                  let name = string(command["name"]), !name.isEmpty else {
+                return nil
+            }
+            let bindings = dictionaries(command["bindings"]).compactMap {
+                (binding: [String: Any]) -> ArciumShortcutBinding? in
+                guard let serialized = string(binding["serialized"]), !serialized.isEmpty else {
+                    return nil
+                }
+                return ArciumShortcutBinding(
+                    serialized: serialized,
+                    display: string(binding["display"]) ?? serialized,
+                    locked: boolean(binding["locked"])
+                )
+            }
+            return ArciumShortcutCommand(
+                id: id,
+                name: name,
+                bindings: bindings,
+                modified: boolean(command["modified"])
+            )
+        }
+        arcSupportedCount = integer(dictionary["arcSupportedCount"])
+        arcUnavailable = dictionaries(dictionary["arcUnavailable"]).compactMap {
+            (item: [String: Any]) -> ArciumShortcutUnavailable? in
+            guard let name = string(item["name"]), !name.isEmpty else { return nil }
+            return ArciumShortcutUnavailable(
+                name: name,
+                reason: string(item["reason"]) ?? "Unavailable in this build"
+            )
+        }
+        hasPrevious = boolean(dictionary["hasPrevious"])
+        if let recordingID = integerOptional(dictionary["recordingCommandID"]), recordingID >= 0 {
+            recordingCommandID = recordingID
+        }
+        isAvailable = boolean(dictionary["available"], defaultValue: false)
+    }
+}
