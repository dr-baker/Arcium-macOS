+        general = ArciumGeneralSnapshot(dictionaryValues(values["general"]))
+        tabs = ArciumTabsSnapshot(dictionaryValues(values["tabs"]))
+        spaces = ArciumSpacesSnapshot(dictionaryValues(values["spaces"]))
+        appearance = ArciumAppearanceSnapshot(dictionaryValues(values["appearance"]))
+        shortcuts = ArciumShortcutsSnapshot(dictionaryValues(values["shortcuts"]))
+    }
+
+    static func empty() -> Self {
+        Self(
+            available: true,
+            general: ArciumGeneralSnapshot([:]),
+            tabs: ArciumTabsSnapshot([:]),
+            spaces: ArciumSpacesSnapshot([:]),
+            appearance: ArciumAppearanceSnapshot([:]),
+            shortcuts: ArciumShortcutsSnapshot([:])
+        )
+    }
+
+    private init(
+        available: Bool,
+        general: ArciumGeneralSnapshot,
+        tabs: ArciumTabsSnapshot,
+        spaces: ArciumSpacesSnapshot,
+        appearance: ArciumAppearanceSnapshot,
+        shortcuts: ArciumShortcutsSnapshot
+    ) {
+        self.available = available
+        self.general = general
+        self.tabs = tabs
+        self.spaces = spaces
+        self.appearance = appearance
+        self.shortcuts = shortcuts
+    }
+}
