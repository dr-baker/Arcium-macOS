+
+    /// Applies the selected color's hue to a palette while preserving array
+    /// order, count, and each mode's offset from index zero.
+    public static func applyingHarmony(
+        to colors: [String],
+        selectedIndex: Int,
+        mode: ArciumColorHarmony,
+        fallbackHue: Double = 0
+    ) -> [String] {
+        guard let index = activeIndex(selectedIndex, count: colors.count),
+              let selected = ArciumHarmonyColorHSV(hex: colors[index], fallbackHue: fallbackHue) else {
+            return colors
+        }
+        guard mode != .custom else { return colors }
+
+        let offsets = mode.offsets(for: colors.count)
+        let baseHue = ArciumHarmonyColorHSV.wrapped(selected.hue - offsets[index])
+        return colors.indices.map { pointIndex in
+            ArciumHarmonyColorHSV(
+                hue: baseHue + offsets[pointIndex],
+                saturation: selected.saturation,
+                brightness: selected.brightness
+            ).hex
+        }
+    }
+
+    /// Returns the wheel location for a normalized hue and saturation. Hue
+    /// zero is at the top and the wheel advances clockwise.
+    public static func wheelPoint(
+        hue: Double,
+        saturation: Double,
+        in size: CGSize
+    ) -> CGPoint {
+        let width = size.width.isFinite ? max(size.width, 0) : 0
+        let height = size.height.isFinite ? max(size.height, 0) : 0
+        let center = CGPoint(x: width / 2, y: height / 2)
+        let radius = min(width, height) / 2
+        guard radius > 0 else { return center }
+
+        let boundedSaturation = saturation.isFinite ? min(max(saturation, 0), 1) : 0
+        let angle = ArciumHarmonyColorHSV.wrapped(hue) * 2 * .pi - .pi / 2
+        return CGPoint(
+            x: center.x + cos(angle) * radius * boundedSaturation,
+            y: center.y + sin(angle) * radius * boundedSaturation
+        )
+    }
+
+    /// Converts a point to wheel hue and radial saturation. Points outside
+    /// the wheel are clamped to its edge; the fallback keeps the hue stable at
+    /// the achromatic center.
+    public static func wheelValue(
+        at location: CGPoint,
+        in size: CGSize,
+        fallbackHue: Double = 0
+    ) -> ArciumHarmonyWheelValue? {
+        let width = size.width.isFinite ? max(size.width, 0) : 0
+        let height = size.height.isFinite ? max(size.height, 0) : 0
+        let radius = min(width, height) / 2
+        guard radius > 0,
+              location.x.isFinite,
+              location.y.isFinite else { return nil }
+
+        let center = CGPoint(x: width / 2, y: height / 2)
+        let deltaX = location.x - center.x
+        let deltaY = location.y - center.y
+        let distance = hypot(deltaX, deltaY)
+        let saturation = min(max(distance / radius, 0), 1)
+        guard distance > 0.000001 else {
+            return ArciumHarmonyWheelValue(hue: fallbackHue, saturation: saturation)
+        }
+
+        let angle = atan2(deltaY, deltaX)
+        let hue = (angle + .pi / 2) / (2 * .pi)
+        return ArciumHarmonyWheelValue(hue: hue, saturation: saturation)
+    }
+
+    private var activePointIndex: Int? {
+        Self.activeIndex(selectedIndex, count: draftColors.count)
+    }
+
+    private var harmonyOptions: [ArciumColorHarmony] {
+        let canonical: [ArciumColorHarmony]
+        switch draftColors.count {
+        case 0, 1:
+            canonical = [.custom]
+        case 2:
+            canonical = [.custom, .complementary]
+        case 3:
+            canonical = [.custom, .splitComplementary, .triadic]
+        case 4:
+            canonical = [.custom, .tetradic]
+        default:
+            canonical = ArciumColorHarmony.allCases
+        }
+        return canonical.contains(mode) ? canonical : canonical + [mode]
+    }
+
+    private var randomizeButton: some View {
+        Button("Randomize colors", systemImage: "die.face.5", action: randomizeColors)
+            .labelStyle(.iconOnly)
+            .buttonStyle(.borderless)
+            .settingsSymbol()
+            .font(.system(size: 18))
+            .accessibilityLabel("Randomize colors")
+            .help("Randomize colors")
+            .disabled(draftColors.isEmpty)
+    }
+
+    private func randomizeColors() {
+        guard !draftColors.isEmpty else { return }
+        let next = Self.randomizedColors(count: draftColors.count, mode: mode) {
+            ArciumHarmonyColorHSV(
+                hue: Double.random(in: 0..<1),
+                saturation: Double.random(in: 0.4...0.85),
+                brightness: Double.random(in: 0.7...1)
+            )
+        }
+        updateDraft(next, commit: true, force: true)
+        syncTransientState()
+    }
+
+    static func randomizedColors(
+        count: Int,
+        mode: ArciumColorHarmony,
+        randomHSV: () -> ArciumHarmonyColorHSV
+    ) -> [String] {
+        guard count > 0 else { return [] }
+        if mode == .custom {
+            return (0..<count).map { _ in randomHSV().hex }
+        }
+        let base = randomHSV()
+        return applyingHarmony(
+            to: Array(repeating: base.hex, count: count),
+            selectedIndex: 0,
+            mode: mode
+        )
+    }
+
+    private var selectedHSV: ArciumHarmonyColorHSV? {
+        guard let activePointIndex else { return nil }
+        return ArciumHarmonyColorHSV(hex: draftColors[activePointIndex], fallbackHue: hueFallback)
+    }
+
+    private var harmonyBinding: Binding<ArciumColorHarmony> {
+        Binding(
+            get: { mode },
+            set: { nextMode in
+                guard nextMode != mode else { return }
+                mode = nextMode
+                if nextMode == .custom {
+                    // The mode binding is host-owned. Emit even when the
+                    // colors are unchanged so the host can persist the mode
+                    // and colors as one configuration update.
+                    updateDraft(draftColors, commit: true, force: true)
+                    return
+                }
+                guard let selectedHSV,
+                      let activePointIndex else {
+                    updateDraft(draftColors, commit: true, force: true)
+                    return
+                }
+                let offsets = nextMode.offsets(for: draftColors.count)
+                let baseHue = ArciumHarmonyColorHSV.wrapped(selectedHSV.hue - offsets[activePointIndex])
+                let nextColors = draftColors.indices.map { index in
+                    ArciumHarmonyColorHSV(
+                        hue: baseHue + offsets[index],
+                        saturation: selectedHSV.saturation,
+                        brightness: selectedHSV.brightness
+                    ).hex
+                }
+                updateDraft(nextColors, commit: true, force: true)
+            }
+        )
+    }
+
+    private var brightnessBinding: Binding<Double> {
+        Binding(
+            get: { brightness },
+            set: { value in
+                let nextBrightness = value.isFinite ? min(max(value, 0), 1) : brightness
+                guard let selectedHSV else { return }
+                brightness = nextBrightness
+                applySelected(selectedHSV.withBrightness(nextBrightness), commit: !isDragging)
+            }
+        )
+    }
+
+    @ViewBuilder private var hueSaturationField: some View {
+        GeometryReader { geometry in
+            wheelContent(in: geometry.size)
+        }
+        .frame(height: 260)
+    }
+
+    @ViewBuilder
+    private func wheelContent(in size: CGSize) -> some View {
+        // Keep enough room around the edge for the selected marker and its
+        // outer focus ring.
+        let diameter = max(min(size.width, size.height) - 36, 0)
+        let wheelSize = CGSize(width: diameter, height: diameter)
+        let wheelOrigin = CGPoint(
+            x: (size.width - diameter) / 2,
+            y: (size.height - diameter) / 2
+        )
+
+        ZStack(alignment: .topLeading) {
+            Circle()
+                .fill(hueWheelGradient)
+                .frame(width: diameter, height: diameter)
+                .position(x: size.width / 2, y: size.height / 2)
+            Circle()
+                .fill(
+                    RadialGradient(
+                        colors: [Color(white: brightness), .clear],
+                        center: .center,
+                        startRadius: 0,
+                        endRadius: max(diameter / 2, 1)
+                    )
+                )
+                .frame(width: diameter, height: diameter)
+                .position(x: size.width / 2, y: size.height / 2)
+            Circle()
+                .stroke(theme.borderSubtle, lineWidth: theme.borderWidth)
+                .frame(width: diameter, height: diameter)
+                .position(x: size.width / 2, y: size.height / 2)
+
+            ForEach(markers) { marker in
+                harmonyMarker(marker)
+                    .position(
+                        x: wheelOrigin.x + Self.wheelPoint(
+                            hue: marker.hue, saturation: marker.saturation, in: wheelSize
+                        ).x,
+                        y: wheelOrigin.y + Self.wheelPoint(
+                            hue: marker.hue, saturation: marker.saturation, in: wheelSize
+                        ).y
+                    )
+                    .zIndex(marker.isSelected ? 1 : 0)
+                    .allowsHitTesting(false)
+            }
+        }
+        .frame(width: size.width, height: size.height)
+        .contentShape(Rectangle())
+        .focusable()
+        .gesture(
+            DragGesture(minimumDistance: 0)
+                .onChanged { value in
+                    isDragging = true
+                    updateWheel(
+                        location: value.location,
+                        size: wheelSize,
+                        origin: wheelOrigin
+                    )
+                }
+                .onEnded { _ in finishInteraction() }
+        )
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("Hue and saturation wheel")
+        .accessibilityValue(fieldAccessibilityValue)
+        .accessibilityHint("Adjust hue around the wheel and saturation from the center to the edge.")
+        .onKeyPress(.leftArrow) {
+            adjustSelected(hueBy: -0.025, saturationBy: 0)
+            return .handled
+        }
+        .onKeyPress(.rightArrow) {
+            adjustSelected(hueBy: 0.025, saturationBy: 0)
+            return .handled
+        }
+        .onKeyPress(.upArrow) {
+            adjustSelected(hueBy: 0, saturationBy: 0.05)
+            return .handled
+        }
+        .onKeyPress(.downArrow) {
+            adjustSelected(hueBy: 0, saturationBy: -0.05)
+            return .handled
+        }
+        .accessibilityAdjustableAction { direction in
+            switch direction {
+            case .increment: adjustSelected(hueBy: 0, saturationBy: 0.05)
+            case .decrement: adjustSelected(hueBy: 0, saturationBy: -0.05)
+            @unknown default: break
+            }
+        }
+        .accessibilityAction(named: "Increase hue") { adjustSelected(hueBy: 0.025, saturationBy: 0) }
+        .accessibilityAction(named: "Decrease hue") { adjustSelected(hueBy: -0.025, saturationBy: 0) }
+        .accessibilityAction(named: "Increase saturation") { adjustSelected(hueBy: 0, saturationBy: 0.05) }
+        .accessibilityAction(named: "Decrease saturation") { adjustSelected(hueBy: 0, saturationBy: -0.05) }
+    }
+
+    private var hueWheelGradient: AngularGradient {
+        let colors = (0...12).map { index in
+            ArciumHarmonyColorHSV(
+                hue: Double(index) / 12,
+                saturation: 1,
+                brightness: brightness
+            ).color
+        }
+        return AngularGradient(
+            gradient: Gradient(colors: colors),
+            center: .center,
+            startAngle: .degrees(-90),
+            endAngle: .degrees(270)
+        )
+    }
+
+    private var markers: [HarmonyMarker] {
+        guard !draftColors.isEmpty, let activePointIndex else { return [] }
+        let selected = selectedHSV ?? ArciumHarmonyColorHSV(
+            hue: hueFallback,
+            saturation: 1,
+            brightness: brightness
+        )
+        let offsets = mode.offsets(for: draftColors.count)
+        if mode == .custom {
+            return draftColors.indices.compactMap { index in
+                guard let hsv = ArciumHarmonyColorHSV(hex: draftColors[index], fallbackHue: hueFallback) else { return nil }
+                return HarmonyMarker(index: index, color: hsv, isSelected: index == activePointIndex)
+            }
+        }
+
+        let baseHue = ArciumHarmonyColorHSV.wrapped(selected.hue - offsets[activePointIndex])
+        return draftColors.indices.map { index in
+            HarmonyMarker(
+                index: index,
+                color: ArciumHarmonyColorHSV(
+                    hue: baseHue + offsets[index],
+                    saturation: selected.saturation,
+                    brightness: selected.brightness
+                ),
+                isSelected: index == activePointIndex
+            )
+        }
+    }
+
+    private func harmonyMarker(_ marker: HarmonyMarker) -> some View {
+        let size: CGFloat = marker.isSelected ? 26 : 20
+        let lightMarker = if let rgb = SettingsRGB(hex: marker.color.hex) {
+            rgb.luminance > 0.42
+        } else {
+            false
+        }
+        let textColor: Color = lightMarker ? .black : .white
+        let shadowColor: Color = lightMarker ? .white.opacity(0.35) : .black.opacity(0.7)
+
+        return ZStack {
+            Circle()
+                .fill(marker.color.color.opacity(marker.isSelected ? 0.95 : 0.48))
+            Text("\(marker.index + 1)")
+                .font(.system(size: marker.isSelected ? 11 : 10, weight: .bold, design: .rounded))
+                .foregroundStyle(textColor)
+                .shadow(color: shadowColor, radius: 1)
+        }
+        .frame(width: size, height: size)
+        .overlay {
+            Circle().stroke(.white.opacity(0.96), lineWidth: marker.isSelected ? 2.5 : 2)
+        }
+        .overlay {
+            Circle().stroke(.black.opacity(0.82), lineWidth: marker.isSelected ? 1.25 : 1)
+        }
+        .overlay {
+            if marker.isSelected {
+                Circle().stroke(theme.accent.opacity(0.95), lineWidth: 2).padding(-3)
+            }
+        }
+    }
+
+    private var fieldAccessibilityValue: String {
+        guard let selectedHSV else { return "No color selected" }
+        return "Hue \(Int((selectedHSV.hue * 360).rounded())) degrees, saturation \(percent(selectedHSV.saturation))"
+    }
+
+    private func updateWheel(location: CGPoint, size: CGSize, origin: CGPoint) {
+        guard let selectedHSV else { return }
+        let localLocation = CGPoint(x: location.x - origin.x, y: location.y - origin.y)
+        guard let wheelValue = Self.wheelValue(
+            at: localLocation,
+            in: size,
+            fallbackHue: hueFallback
+        ) else { return }
+        applySelected(
+            ArciumHarmonyColorHSV(
+                hue: wheelValue.hue,
+                saturation: wheelValue.saturation,
+                brightness: selectedHSV.brightness
+            ),
+            commit: false
+        )
+    }
+
+    private func adjustSelected(hueBy: Double, saturationBy: Double) {
+        guard let selectedHSV else { return }
+        applySelected(
+            ArciumHarmonyColorHSV(
+                hue: selectedHSV.hue + hueBy,
+                saturation: selectedHSV.saturation + saturationBy,
+                brightness: selectedHSV.brightness
+            ),
+            commit: true
+        )
+    }
+
+    private func applySelected(_ selected: ArciumHarmonyColorHSV, commit: Bool) {
+        guard let activePointIndex else { return }
+        hueFallback = selected.hue
+        brightness = selected.brightness
+        hexText = selected.hex
+        invalidHex = false
+
+        if mode == .custom {
+            var next = draftColors
+            next[activePointIndex] = selected.hex
+            updateDraft(next, commit: commit)
+            return
+        }
+
+        let offsets = mode.offsets(for: draftColors.count)
+        let baseHue = ArciumHarmonyColorHSV.wrapped(selected.hue - offsets[activePointIndex])
+        let next = draftColors.indices.map { index in
+            ArciumHarmonyColorHSV(
+                hue: baseHue + offsets[index],
+                saturation: selected.saturation,
+                brightness: selected.brightness
+            ).hex
+        }
+        updateDraft(next, commit: commit)
+    }
+
+    private func updateDraft(_ next: [String], commit: Bool, force: Bool = false) {
+        draftColors = next
+        guard commit else { return }
+        guard force || next != lastObservedColors else { return }
+        lastObservedColors = next
+        deferredExternalColors = nil
+        onColorsChanged(next)
+    }
+
+    private func finishInteraction() {
+        guard isDragging else { return }
+        isDragging = false
+        if let deferredExternalColors {
+            draftColors = deferredExternalColors
+            self.deferredExternalColors = nil
+            lastObservedColors = draftColors
+            syncTransientState()
+            return
+        }
+        guard draftColors != lastObservedColors else { return }
+        lastObservedColors = draftColors
+        onColorsChanged(draftColors)
+    }
+
+    private func commitHex() {
+        guard let selected = ArciumHarmonyColorHSV(hex: hexText, fallbackHue: hueFallback) else {
+            invalidHex = true
+            return
+        }
+        applySelected(selected, commit: true)
+    }
+
+    private func syncTransientState() {
+        guard let selectedHSV else {
+            brightness = 1
+            hueFallback = 0
+            hexText = "#FFFFFF"
+            invalidHex = false
+            return
+        }
+        brightness = selectedHSV.brightness
+        hexText = selectedHSV.hex
+        if selectedHSV.saturation > 0.000001 {
+            hueFallback = selectedHSV.hue
+        }
+        invalidHex = false
+    }
+
+    private func receiveExternalColors(_ values: [String]) {
+        let next = Self.normalizedColors(values)
+        if isDragging {
+            if next == draftColors {
+                deferredExternalColors = nil
+            } else {
+                deferredExternalColors = next
+            }
+            lastObservedColors = next
+            return
+        }
+
+        lastObservedColors = next
+        guard next != draftColors else { return }
+        draftColors = next
+        deferredExternalColors = nil
+        syncTransientState()
+    }
+
+    private static func activeIndex(_ index: Int, count: Int) -> Int? {
+        guard count > 0 else { return nil }
+        return min(max(index, 0), count - 1)
+    }
+
+    private static func normalizedColors(_ values: [String]) -> [String] {
+        values.map { SettingsRGB(hex: $0)?.hex ?? "#FFFFFF" }
+    }
+
+    private func percent(_ value: Double) -> String {
+        "\(Int((value * 100).rounded()))%"
+    }
+
+    private struct HarmonyMarker: Identifiable {
+        let index: Int
+        let color: ArciumHarmonyColorHSV
+        let isSelected: Bool
+
+        var id: Int { index }
+        var hue: Double { color.hue }
+        var saturation: Double { color.saturation }
+    }
+}
+
+private extension ArciumColorHarmony {
+    var shortTitle: String {
+        switch self {
+        case .custom: "Free"
+        case .complementary: "Opposite"
+        case .splitComplementary: "Split"
+        case .triadic: "Triad"
+        case .tetradic: "Square"
+        }
+    }
+}
+
+private extension ArciumHarmonyColorHSV {
+    func withBrightness(_ value: Double) -> Self {
+        Self(hue: hue, saturation: saturation, brightness: value)
+    }
+}
