+
+id NSObjectFromBaseValue(const base::Value& value);
+
+NSDictionary* NSDictionaryFromBaseDict(const base::DictValue& dictionary) {
+  NSMutableDictionary* result =
+      [[NSMutableDictionary alloc] initWithCapacity:dictionary.size()];
+  for (const auto& [key, child] : dictionary) {
+    NSString* foundation_key = base::SysUTF8ToNSString(key);
+    id foundation_value = NSObjectFromBaseValue(child);
+    if (!foundation_key || !foundation_value) {
+      continue;
+    }
+    result[foundation_key] = foundation_value;
+  }
+  return result;
+}
+
+NSArray* NSArrayFromBaseList(const base::ListValue& list) {
+  NSMutableArray* result =
+      [[NSMutableArray alloc] initWithCapacity:list.size()];
+  for (const base::Value& child : list) {
+    id foundation_value = NSObjectFromBaseValue(child);
+    if (foundation_value) {
+      [result addObject:foundation_value];
+    }
+  }
+  return result;
+}
+
+id NSObjectFromBaseValue(const base::Value& value) {
+  switch (value.type()) {
+    case base::Value::Type::BOOLEAN:
+      return @(value.GetBool());
+    case base::Value::Type::INTEGER:
+      return @(value.GetInt());
+    case base::Value::Type::DOUBLE:
+      return @(value.GetDouble());
+    case base::Value::Type::STRING:
+      return base::SysUTF8ToNSString(value.GetString());
+    case base::Value::Type::DICT:
+      return NSDictionaryFromBaseDict(value.GetDict());
+    case base::Value::Type::LIST:
+      return NSArrayFromBaseList(value.GetList());
+    case base::Value::Type::NONE:
+    case base::Value::Type::BINARY:
+      return nil;
+  }
+  return nil;
+}
+
+std::optional<base::Value> BaseValueFromNSObject(id value);
+
+std::optional<base::DictValue> BaseDictFromNSObject(NSDictionary* dictionary) {
+  if (!dictionary) {
+    return std::nullopt;
+  }
+
+  base::DictValue result;
+  for (id raw_key in dictionary) {
+    if (![raw_key isKindOfClass:[NSString class]]) {
+      return std::nullopt;
+    }
+    NSString* key = (NSString*)raw_key;
+    const char* utf8_key = key.UTF8String;
+    if (!utf8_key) {
+      return std::nullopt;
+    }
+    std::optional<base::Value> child =
+        BaseValueFromNSObject(dictionary[raw_key]);
+    if (!child) {
+      return std::nullopt;
+    }
+    result.Set(utf8_key, std::move(*child));
+  }
+  return std::optional<base::DictValue>(std::move(result));
+}
+
+std::optional<base::ListValue> BaseListFromNSObject(NSArray* array) {
+  if (!array) {
+    return std::nullopt;
+  }
+
+  base::ListValue result;
+  for (id child in array) {
+    std::optional<base::Value> converted = BaseValueFromNSObject(child);
+    if (!converted) {
+      return std::nullopt;
+    }
+    result.Append(std::move(*converted));
+  }
+  return std::optional<base::ListValue>(std::move(result));
+}
+
+std::optional<base::Value> BaseValueFromNSObject(id value) {
+  if ([value isKindOfClass:[NSNumber class]]) {
+    NSNumber* number = (NSNumber*)value;
+    if (CFGetTypeID((__bridge CFTypeRef)number) == CFBooleanGetTypeID()) {
+      return base::Value(number.boolValue);
+    }
+    const double number_value = number.doubleValue;
+    if (!std::isfinite(number_value)) {
+      return std::nullopt;
+    }
+    return base::Value(number_value);
+  }
+  if ([value isKindOfClass:[NSString class]]) {
+    NSString* string = (NSString*)value;
+    const char* utf8_value = string.UTF8String;
+    return utf8_value ? std::optional<base::Value>(base::Value(utf8_value))
+                      : std::nullopt;
+  }
+  if ([value isKindOfClass:[NSDictionary class]]) {
+    std::optional<base::DictValue> dictionary =
+        BaseDictFromNSObject((NSDictionary*)value);
+    return dictionary
+               ? std::optional<base::Value>(base::Value(std::move(*dictionary)))
+               : std::nullopt;
+  }
+  if ([value isKindOfClass:[NSArray class]]) {
+    std::optional<base::ListValue> list = BaseListFromNSObject((NSArray*)value);
+    return list ? std::optional<base::Value>(base::Value(std::move(*list)))
+                : std::nullopt;
+  }
+  return std::nullopt;
+}
+
+bool PresetSucceeded(browser_shortcuts::arcium::PresetResult result) {
+  return result == browser_shortcuts::arcium::PresetResult::kApplied ||
+         result == browser_shortcuts::arcium::PresetResult::kNoChange;
+}
+
+NSString* PresetFailureMessage(browser_shortcuts::arcium::PresetResult result) {
+  switch (result) {
+    case browser_shortcuts::arcium::PresetResult::kPreferencesLocked:
+      return @"Shortcut preferences are managed by your administrator.";
+    case browser_shortcuts::arcium::PresetResult::kNoSupportedCommands:
+      return @"No Arc shortcut mapping is available in this build.";
+    case browser_shortcuts::arcium::PresetResult::kAcceleratorConflict:
+      return @"The Arc shortcuts conflict with a locked browser shortcut.";
+    case browser_shortcuts::arcium::PresetResult::kShortcutLocked:
+      return @"One or more Arc shortcuts are reserved by the browser.";
+    case browser_shortcuts::arcium::PresetResult::kNoPreviousConfiguration:
+      return @"There is no saved shortcut configuration to restore.";
+    default:
+      return @"The shortcut configuration could not be changed.";
+  }
+}
+
+NSString* CommandName(browser_shortcuts::BrowserShortcutService* service,
+                      int command_id) {
+  if (!service) {
+    return @"another command";
+  }
+  for (const browser_shortcuts::CommandInfo& command : service->GetCommands()) {
+    if (command.command_id == command_id) {
+      return StringFromUTF16(command.name);
+    }
+  }
+  return @"another command";
+}
