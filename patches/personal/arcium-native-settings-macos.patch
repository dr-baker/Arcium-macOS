+private struct ShortcutSettingsPage: View {
+    @ObservedObject var store: ArciumSettingsStore
+
+    var body: some View {
+        GeometryReader { geometry in
+            VStack(alignment: .leading, spacing: SettingsSpacing.sm) {
+                ShortcutPageHeader(store: store)
+
+                SettingsWorkspace(
+                    pageID: "shortcuts",
+                    inventoryTitle: "Commands",
+                    isInventoryVisible: true,
+                    isStacked: geometry.size.width < 560,
+                    columnWidth: Binding(
+                        get: { store.shortcutColumnWidth },
+                        set: { store.shortcutColumnWidth = $0 }
+                    ),
+                    widthRange: 230...320
+                ) {
+                    ShortcutInventory(store: store)
+                } detail: { _ in
+                    ShortcutEditor(store: store)
+                }
+            }
+            .padding(SettingsSpacing.lg)
+        }
+    }
+}
+
+private struct ShortcutPageHeader: View {
+    @ObservedObject var store: ArciumSettingsStore
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: SettingsSpacing.xs) {
+            HStack(alignment: .center, spacing: SettingsSpacing.sm) {
+                VStack(alignment: .leading, spacing: 2) {
+                    Text("Keyboard Shortcuts")
+                        .settingsFont(\.title)
+                    Text("Search commands and edit only the selected command's bindings.")
+                        .settingsFont(\.caption)
+                        .foregroundStyle(theme.textSecondary)
+                        .lineLimit(1)
+                }
+                Spacer(minLength: 0)
+                Button("Apply Arc defaults") {
+                    store.actionInvoked(name: "apply_arc_defaults")
+                }
+                .buttonStyle(.borderedProminent)
+                .tint(theme.accent)
+                .disabled(!store.snapshot.shortcuts.canModify || store.isRecordingShortcut)
+
+                Menu("More") {
+                    Button("Restore previous shortcuts") {
+                        store.actionInvoked(name: "restore_previous")
+                    }
+                    .disabled(!store.snapshot.shortcuts.canModify || !store.snapshot.shortcuts.hasPrevious)
+                    Button("Reset all shortcuts") {
+                        store.actionInvoked(name: "reset_all")
+                    }
+                    .disabled(!store.snapshot.shortcuts.canModify)
+                    if !store.snapshot.shortcuts.arcUnavailable.isEmpty {
+                        Divider()
+                        Button("View unavailable shortcuts…") {
+                            store.actionInvoked(name: "show_unavailable_arc_shortcuts")
+                        }
+                    }
+                }
+                .menuStyle(.borderlessButton)
+                .disabled(!store.snapshot.shortcuts.isAvailable || store.isRecordingShortcut)
+            }
+
+            if let recordingID = store.snapshot.shortcuts.recordingCommandID {
+                HStack(spacing: SettingsSpacing.xs) {
+                    Image(systemName: "record.circle")
+                        .foregroundStyle(theme.warning)
+                        .accessibilityHidden(true)
+                    let commandName = store.snapshot.shortcuts.commands.first {
+                        $0.id == recordingID
+                    }?.name ?? "this command"
+                    Text("Press a shortcut for \(commandName). Escape cancels.")
+                        .settingsFont(\.caption)
+                        .foregroundStyle(theme.textPrimary)
+                        .lineLimit(2)
+                    Spacer(minLength: 0)
+                    Button("Cancel") {
+                        store.actionInvoked(name: "cancel_recording")
+                    }
+                    .buttonStyle(.bordered)
+                }
+                .padding(.horizontal, SettingsSpacing.sm)
+                .padding(.vertical, SettingsSpacing.xs)
+                .background(theme.warning.opacity(0.12), in: RoundedRectangle(cornerRadius: SettingsRadius.control, style: .continuous))
+                .accessibilityElement(children: .contain)
+            }
+
+            HStack(spacing: SettingsSpacing.sm) {
+                Image(systemName: "magnifyingglass")
+                    .foregroundStyle(theme.textSecondary)
+                TextField("Search commands or shortcuts", text: $store.shortcutQuery)
+                    .textFieldStyle(.plain)
+                    .accessibilityLabel("Search commands or shortcuts")
+                if !store.shortcutQuery.isEmpty {
+                    Button("Clear search", systemImage: "xmark.circle.fill") {
+                        store.shortcutQuery = ""
+                    }
+                    .labelStyle(.iconOnly)
+                    .buttonStyle(.plain)
+                    .foregroundStyle(theme.textSecondary)
+                }
+            }
+            .padding(.horizontal, SettingsSpacing.sm)
+            .padding(.vertical, SettingsSpacing.xs)
+            .settingsInteractiveControlSurface(cornerRadius: SettingsRadius.control)
+            .disabled(store.isRecordingShortcut)
