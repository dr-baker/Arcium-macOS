+        matchAllColorsDescription: String? = "Apply size and intensity changes to every color.",
+        matchAllColorsHelp: SHelp? = nil,
+        commitMode: SCommitMode = .onDragEnd,
+        onMatchAllColors: @escaping (Bool) -> Void = { _ in },
