+                .labelStyle(SettingsIconLabelStyle())
+        } else if let error = store.presetError {
+            PresetLoadErrorView(message: error)
+        } else {
+            PresetLoadErrorView(message: "The settings style preset is unavailable.")
+        }
+    }
