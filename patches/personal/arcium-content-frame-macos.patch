+struct ArciumContentFrame: Equatable {
+    enum ShadowMode: String, CaseIterable, Sendable {
+        case automatic = "default"
+        case none, custom
+
+        var title: String {
+            switch self {
+            case .automatic: "Default"
+            case .none: "None"
+            case .custom: "Customize…"
+            }
+        }
+    }
+
+    enum NumberField: String, CaseIterable, Identifiable, Sendable {
+        case borderWidth, opacity, blur, x, y, spread
+        var id: String { rawValue }
+
+        var title: String {
+            switch self {
+            case .borderWidth: "Border"
+            case .opacity: "Opacity"
+            case .blur: "Blur"
+            case .x: "Horizontal offset"
+            case .y: "Vertical offset"
+            case .spread: "Spread"
+            }
+        }
+
+        var range: ClosedRange<Int> {
+            switch self {
+            case .borderWidth: 0...6
+            case .opacity: 0...100
+            case .blur: 0...48
+            case .x, .y: -24...24
+            case .spread: -12...12
+            }
+        }
+
+        var keyPath: WritableKeyPath<ArciumContentFrame, Int> {
+            switch self {
+            case .borderWidth: \.borderWidth
+            case .opacity: \.opacity
+            case .blur: \.blur
+            case .x: \.x
+            case .y: \.y
+            case .spread: \.spread
+            }
+        }
+
+        var unit: String { self == .opacity ? "%" : " px" }
+    }
+
+    static let shadowFields: [NumberField] = [.opacity, .blur, .x, .y, .spread]
+
+    var borderWidth = 0
+    var x = 0
+    var y = 0
+    var blur = 24
+    var spread = 0
+    var opacity = 20
+    var color = "#000000"
+    var shadowMode: ShadowMode = .automatic
+
+    init() {}
+
+    init(_ dictionary: [String: Any]) {
+        guard dictionary.count == 7 || dictionary.count == 8,
+              let color = dictionary["color"] as? String,
+              Self.validColor(color) else { return }
+        var value = Self()
+        for field in NumberField.allCases {
+            guard let number = exactIntegerOptional(dictionary[field.rawValue]),
+                  field.range.contains(number) else { return }
+            value[keyPath: field.keyPath] = number
+        }
+        if dictionary.count == 7 && dictionary["shadowMode"] == nil {
+            value.shadowMode = .custom
+        } else {
+            guard dictionary.count == 8,
+                  let mode = dictionary["shadowMode"] as? String,
+                  let parsed = ShadowMode(rawValue: mode) else { return }
+            value.shadowMode = parsed
+        }
+        value.color = color
+        self = value
+    }
+
+    static func defaultStyle(dark: Bool, accent: String) -> Self {
+        var value = Self()
+        value.blur = dark ? 48 : 24
+        value.spread = dark ? 4 : 0
+        value.opacity = dark ? 12 : 20
+        value.color = dark ? accent : "#000000"
+        return value
+    }
+
+    var isValid: Bool {
+        NumberField.allCases.allSatisfy { $0.range.contains(self[keyPath: $0.keyPath]) }
+            && Self.validColor(color)
+    }
+
+    private static func validColor(_ value: String) -> Bool {
+        value.utf8.count == 7 && value.utf8.first == 35
+            && value.utf8.dropFirst().allSatisfy {
+                (48...57).contains($0) || (65...70).contains($0) || (97...102).contains($0)
+            }
+    }
+
+    var payload: [String: Any] {
+        var value: [String: Any] = ["color": color, "shadowMode": shadowMode.rawValue]
+        for field in NumberField.allCases { value[field.rawValue] = self[keyPath: field.keyPath] }
+        return value
+    }
+}
