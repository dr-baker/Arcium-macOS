+
+private struct ArciumContentFrameEditor: View {
+    @ObservedObject var store: ArciumSettingsStore
+
+    private var frame: ArciumContentFrame { store.snapshot.appearance.contentFrame }
+    private var editable: Bool {
+        store.snapshot.appearance.contentFrameAvailable
+            && !store.snapshot.appearance.contentFrameManaged
+            && store.snapshot.appearance.roundedFrame
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 16) {
+            slider("Border", \.borderWidth, range: 0...6)
+            HStack(spacing: 8) {
+                Button("Soft shadow") { apply(ArciumContentFrame()) }
+                Button("Glow") { apply(.glow) }
+                Button("None") {
+                    var value = frame
+                    value.opacity = 0
+                    store.setContentFrame(value)
+                }
+            }
+            .buttonStyle(.bordered)
+            slider("Opacity", \.opacity, range: 0...100, unit: "%")
+            slider("Blur", \.blur, range: 0...48)
+            ColorPicker("Color", selection: Binding(
+                get: { SettingsRGB(hex: frame.color)?.color ?? .black },
+                set: { color in
+                    guard let rgb = NSColor(color).usingColorSpace(.sRGB) else { return }
+                    func byte(_ component: CGFloat) -> Int {
+                        Int((min(max(component, 0), 1) * 255).rounded())
+                    }
+                    var value = frame
+                    value.color = String(format: "#%02X%02X%02X", byte(rgb.redComponent),
+                                         byte(rgb.greenComponent), byte(rgb.blueComponent))
+                    store.setContentFrame(value)
+                }
+            ), supportsOpacity: false)
+            DisclosureGroup("Shadow details") {
+                VStack(spacing: 16) {
+                    slider("Horizontal offset", \.x, range: -24...24)
+                    slider("Vertical offset", \.y, range: -24...24)
+                    slider("Spread", \.spread, range: -12...12)
+                }
+                .padding(.top, 12)
+            }
+            HStack {
+                Text("Changes appear in your browser windows.")
+                    .settingsFont(\.caption).foregroundStyle(.secondary)
+                Spacer(minLength: 0)
+                Button("Use Arc style") { store.setContentFrame(ArciumContentFrame()) }
+                    .buttonStyle(.bordered)
+            }
+        }
+        .disabled(!editable)
+    }
+
+    private func apply(_ preset: ArciumContentFrame) {
+        var value = preset
+        value.borderWidth = frame.borderWidth
+        store.setContentFrame(value)
+    }
+
+    private func slider(_ title: String, _ key: WritableKeyPath<ArciumContentFrame, Int>,
+                        range: ClosedRange<Double>, unit: String = " px") -> some View {
+        let update: (Double) -> Void = { number in
+            guard number.isFinite else { return }
+            var value = frame
+            value[keyPath: key] = Int(min(max(number.rounded(), range.lowerBound), range.upperBound))
+            store.setContentFrame(value)
+        }
+        return SSlider(title, value: Binding(
+            get: { Double(frame[keyPath: key]) }, set: { update($0) }
+        ), range: range, step: 1, format: { "\(Int($0.rounded()))\(unit)" },
+            commitMode: .onDragEnd, onPreviewChange: update)
+    }
+}
