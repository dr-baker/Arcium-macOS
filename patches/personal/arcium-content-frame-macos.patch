     @MainActor
+    func testContentFrameDefaultsAndTypedCallbacks() throws {
+        let defaults = ArciumContentFrame()
+        XCTAssertEqual(defaults.borderWidth, 0)
+        XCTAssertEqual(defaults.opacity, 25)
+        let delegate = TestDelegate()
+        let store = ArciumSettingsStore(snapshot: ["available": true, "appearance": [
+            "contentFrame": defaults.payload, "contentFrameAvailable": true,
+            "contentFrameManaged": false
+        ]], delegate: delegate)
+        var glow = ArciumContentFrame.glow
+        glow.borderWidth = 6
+        glow.spread = 12
+        store.setContentFrame(glow)
+        XCTAssertEqual(delegate.settings.map(\.key), ["content_frame"])
+        let payload = try XCTUnwrap(delegate.settings.first?.value as? [String: Any])
+        XCTAssertEqual(ArciumContentFrame(payload), glow)
+        XCTAssertEqual(payload["borderWidth"] as? Int, 6)
+        XCTAssertEqual(payload["y"] as? Int, 0)
+        XCTAssertEqual(payload["color"] as? String, "#8C7BFF")
+        glow.borderWidth = 7
+        store.setContentFrame(glow)
+        XCTAssertEqual(delegate.settings.count, 1)
+    }
+
+    @MainActor
+    func testContentFrameRejectsMalformedAndReadOnlyWrites() {
+        for field in ["borderWidth", "x", "y", "blur", "spread", "opacity"] {
+            for invalid: Any in [true, 0.5, Double.infinity, Double.nan, 1000, "2"] {
+                var payload = ArciumContentFrame.glow.payload
+                payload[field] = invalid
+                XCTAssertEqual(ArciumContentFrame(payload), ArciumContentFrame(), field)
+            }
+        }
+        for color in ["red", "#123", "#GGGGGG", "#FFFFFF00", "#0xFFFF", "#+FFFFF"] {
+            var payload = ArciumContentFrame.glow.payload
+            payload["color"] = color
+            XCTAssertEqual(ArciumContentFrame(payload), ArciumContentFrame())
+        }
+        let delegate = TestDelegate()
+        for (available, managed) in [(false, false), (true, true)] {
+            let store = ArciumSettingsStore(snapshot: ["available": true, "appearance": [
+                "contentFrameAvailable": available, "contentFrameManaged": managed
+            ]], delegate: delegate)
+            store.setContentFrame(.glow)
+        }
+        XCTAssertTrue(delegate.settings.isEmpty)
+    }
