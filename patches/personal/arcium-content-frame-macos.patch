+private struct ArciumContentFrameEditor: View {
+    @ObservedObject var store: ArciumSettingsStore
+    let onCustomize: () -> Void
+
+    private var frame: ArciumContentFrame { store.snapshot.appearance.contentFrame }
+
+    var body: some View {
+        ArciumContentFrameSlider(field: .borderWidth, frame: Binding(
+            get: { frame }, set: { store.setContentFrame($0) }
+        ))
+        .disabled(!store.canEditContentFrame)
+        SLabeledControl("Shadow") {
+            SSegmentedControl("Shadow",
+                options: ArciumContentFrame.ShadowMode.allCases.map { (value: $0, label: $0.title) },
+                selection: Binding(get: { frame.shadowMode }, set: { select($0) }))
+        }
+        .disabled(!store.canEditContentFrame)
+    }
+
+    private func select(_ mode: ArciumContentFrame.ShadowMode) {
+        if mode == .custom {
+            onCustomize()
+        } else {
+            var value = frame
+            value.shadowMode = mode
+            store.setContentFrame(value)
+        }
+    }
+}
+
+private struct ArciumContentFrameCustomization: View {
+    @ObservedObject var store: ArciumSettingsStore
+    @State private var draft: ArciumContentFrame
+
+    init(store: ArciumSettingsStore) {
+        self.store = store
+        _draft = State(initialValue: store.contentFrameForCustomization())
+    }
+
+    private var frame: Binding<ArciumContentFrame> {
+        Binding(get: { draft }, set: { next in
+            guard store.canEditContentFrame else { return }
+            var value = next
+            value.shadowMode = .custom
+            draft = value
+            store.setContentFrame(value)
+        })
+    }
+
+    var body: some View {
+        SGroupedSections(showsSurfaces: false, showsDividers: false) {
+            Section {
+                ForEach(ArciumContentFrame.shadowFields) { field in
+                    ArciumContentFrameSlider(field: field, frame: frame)
+                }
+            }
+            Section("Color") {
+                SColorHarmonyPicker(colors: Binding(
+                    get: { [draft.color] },
+                    set: { colors in
+                        guard colors.count == 1 else { return }
+                        var value = draft
+                        value.color = colors[0]
+                        guard value.isValid else { return }
+                        frame.wrappedValue = value
+                    }
+                ), selectedIndex: .constant(0), mode: .constant(.custom), title: "Shadow color")
+            }
+        }
+        .disabled(!store.canEditContentFrame)
+    }
+}
+
+private struct ArciumContentFrameSlider: View {
+    let field: ArciumContentFrame.NumberField
+    @Binding var frame: ArciumContentFrame
+
+    var body: some View {
+        let update: (Double) -> Void = { number in
+            guard number.isFinite else { return }
+            var value = frame
+            value[keyPath: field.keyPath] = Int(min(max(number.rounded(),
+                Double(field.range.lowerBound)), Double(field.range.upperBound)))
+            frame = value
+        }
+        SSlider(field.title, value: Binding(
+            get: { Double(frame[keyPath: field.keyPath]) }, set: { update($0) }
+        ), range: Double(field.range.lowerBound)...Double(field.range.upperBound), step: 1,
+            format: { "\(Int($0.rounded()))\(field.unit)" },
+            commitMode: .onDragEnd, onPreviewChange: update)
+    }
+}
