+struct ArciumContentFrame: Equatable {
+    var borderWidth = 0
+    var x = 0
+    var y = 0
+    var blur = 8
+    var spread = 0
+    var opacity = 25
+    var color = "#000000"
+
+    static var glow: Self {
+        var value = Self()
+        value.y = 0
+        value.blur = 16
+        value.opacity = 50
+        value.color = "#8C7BFF"
+        return value
+    }
+
+    init(_ dictionary: [String: Any] = [:]) {
+        guard dictionary.count == 7,
+              let border = exactIntegerOptional(dictionary["borderWidth"]),
+              let x = exactIntegerOptional(dictionary["x"]),
+              let y = exactIntegerOptional(dictionary["y"]),
+              let blur = exactIntegerOptional(dictionary["blur"]),
+              let spread = exactIntegerOptional(dictionary["spread"]),
+              let opacity = exactIntegerOptional(dictionary["opacity"]),
+              let color = dictionary["color"] as? String,
+              (0...6).contains(border), (-24...24).contains(x),
+              (-24...24).contains(y), (0...48).contains(blur),
+              (-12...12).contains(spread), (0...100).contains(opacity),
+              Self.validColor(color) else { return }
+        borderWidth = border
+        self.x = x
+        self.y = y
+        self.blur = blur
+        self.spread = spread
+        self.opacity = opacity
+        self.color = color
+    }
+
+    var isValid: Bool {
+        (0...6).contains(borderWidth) && (-24...24).contains(x)
+            && (-24...24).contains(y) && (0...48).contains(blur)
+            && (-12...12).contains(spread) && (0...100).contains(opacity)
+            && Self.validColor(color)
+    }
+
+    private static func validColor(_ value: String) -> Bool {
+        value.utf8.count == 7 && value.utf8.first == 35
+            && value.utf8.dropFirst().allSatisfy {
+                (48...57).contains($0) || (65...70).contains($0) || (97...102).contains($0)
+            }
+    }
+
+    var payload: [String: Any] {
+        ["borderWidth": borderWidth, "x": x, "y": y, "blur": blur,
+         "spread": spread, "opacity": opacity, "color": color]
+    }
+}
