 @MainActor
 final class ArciumSettingsUIContractTests: XCTestCase {
+    func testTintColorEditingDoesNotRequireOrCreateGlowPoints() throws {
+        var empty = makeConfiguration()
+        empty.colorEffect = .tint
+        empty.glows = []
+        let color = try XCTUnwrap(SettingsRGB(hex: "#2A9ED0"))
+        let edited = empty.applyingTintColor(color)
+        let dictionary = ArciumChromeAppearanceAdapter.dictionaryRepresentation(for: edited)
+        let restored = try XCTUnwrap(ArciumChromeAppearanceSnapshot.Configuration(dictionary).backdropConfiguration)
+        XCTAssertEqual(restored.tintColor, color)
+        XCTAssertTrue(restored.glows.isEmpty)
+        XCTAssertEqual(restored.grain, empty.grain)
+        XCTAssertEqual(restored.colorEffect, .tint)
+        XCTAssertEqual(dictionary["tintColor"] as? String, "#2A9ED0")
+        let legacy = ArciumChromeAppearanceSnapshot.Configuration(
+            ArciumChromeAppearanceAdapter.dictionaryRepresentation(for: empty))
+        XCTAssertTrue(legacy.isValid)
+        XCTAssertNil(legacy.tintColor)
+        let delegate = TestDelegate()
+        let store = ArciumSettingsStore(
+            snapshot: snapshot(chrome: empty, managed: false, available: true),
+            delegate: delegate)
+        store.setChromeAppearance(edited)
+        let payload = try XCTUnwrap(delegate.settings.last?.value as? [String: Any])
+        XCTAssertEqual(payload["spaceID"] as? String, "space-a")
+        let sent = try XCTUnwrap(payload["configuration"] as? [String: Any])
+        XCTAssertEqual(sent["tintColor"] as? String, "#2A9ED0")
+        XCTAssertEqual((sent["points"] as? [[String: Any]])?.count, 0)
+        XCTAssertEqual(store.pendingChromeAppearance?.tintColor, color)
+    }
+
+    func testTintOverrideAndGlowRecipeSurviveModeChanges() throws {
+        let original = makeConfiguration()
+        let color = try XCTUnwrap(SettingsRGB(hex: "#D05080"))
+        for mode in SettingsBackdropColorEffect.allCases {
+            var edited = original.applyingTintColor(color)
+            edited.colorEffect = mode
+            let restored = try XCTUnwrap(ArciumChromeAppearanceSnapshot.Configuration(
+                ArciumChromeAppearanceAdapter.dictionaryRepresentation(for: edited)).backdropConfiguration)
+            XCTAssertEqual(restored.tintColor, color)
+            XCTAssertEqual(restored.glows, original.glows)
+            XCTAssertEqual(restored.grain, original.grain)
+            let typed = try JSONDecoder().decode(SettingsBackdropConfiguration.self,
+                from: JSONEncoder().encode(edited))
+            XCTAssertEqual(typed, edited.normalized())
+            let style = try edited.updating(SettingsStyleBackdrop(),
+                viewportSize: CGSize(width: 100, height: 100))
+            let persisted = try JSONDecoder().decode(SettingsStyleBackdrop.self,
+                from: JSONEncoder().encode(style))
+            let restoredStyle = SettingsBackdropConfiguration(styleBackdrop: persisted)
+            XCTAssertEqual(restoredStyle.tintColor, color)
+            XCTAssertEqual(restoredStyle.glows, original.glows)
+        }
+    }
+
+    func testOptionalTintColorRejectsMalformedNativeValues() {
+        var native = ArciumChromeAppearanceAdapter.dictionaryRepresentation(for: makeConfiguration())
+        for invalid: Any in ["red", "#12345", "#001122FF", "#GG0011", false, NSNull()] {
+            native["tintColor"] = invalid
+            XCTAssertFalse(ArciumChromeAppearanceSnapshot.Configuration(native).isValid)
+        }
+    }
+
+    func testWindowColorModesRoundTripWithoutChangingSavedRecipe() throws {
+        let original = makeConfiguration()
+        for effect in SettingsBackdropColorEffect.allCases {
+            var next = original
+            next.colorEffect = effect
+            let encoded = ArciumChromeAppearanceAdapter.dictionaryRepresentation(for: next)
+            let restored = try XCTUnwrap(ArciumChromeAppearanceSnapshot.Configuration(encoded).backdropConfiguration)
+            XCTAssertEqual(restored.colorEffect, effect)
+            XCTAssertEqual(restored.glows, original.glows)
+            XCTAssertEqual(restored.grain, original.grain)
+            XCTAssertEqual(restored.glassTintOpacity, original.glassTintOpacity)
+            XCTAssertEqual(restored, next.normalized())
+        }
+    }
+
+    func testLegacyWindowColorDefaultsAndUnknownModeRejection() throws {
+        var encoded = ArciumChromeAppearanceAdapter.dictionaryRepresentation(for: makeConfiguration())
+        encoded.removeValue(forKey: "colorEffect")
+        XCTAssertEqual(ArciumChromeAppearanceSnapshot.Configuration(encoded).colorEffect, .glows)
+        XCTAssertTrue(ArciumChromeAppearanceSnapshot.Configuration(encoded).isValid)
+        encoded["colorEffect"] = "rainbow"
+        XCTAssertFalse(ArciumChromeAppearanceSnapshot.Configuration(encoded).isValid)
+        encoded["colorEffect"] = false
+        XCTAssertFalse(ArciumChromeAppearanceSnapshot.Configuration(encoded).isValid)
+    }
+
+    func testEmptyGlowRecipeRoundTripsWithoutAddingDefaults() throws {
+        var original = makeConfiguration()
+        original.glows = []
+        let encoded = ArciumChromeAppearanceAdapter.dictionaryRepresentation(for: original)
+        let restored = try XCTUnwrap(ArciumChromeAppearanceSnapshot.Configuration(encoded).backdropConfiguration)
+        XCTAssertTrue(restored.glows.isEmpty)
+        XCTAssertEqual(restored, original.normalized())
+    }
