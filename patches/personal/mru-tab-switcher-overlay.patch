+// Displays the selected tab while Ctrl+Tab walks a stable MRU snapshot.
+class MRUTabSwitcherOverlay {
+ public:
+  explicit MRUTabSwitcherOverlay(BrowserView* browser_view)
+      : browser_view_(browser_view) {}
+
+  MRUTabSwitcherOverlay(const MRUTabSwitcherOverlay&) = delete;
+  MRUTabSwitcherOverlay& operator=(const MRUTabSwitcherOverlay&) = delete;
+  ~MRUTabSwitcherOverlay() = default;
+
+  void Update(const std::vector<content::WebContents*>& tabs,
+              size_t selected_index) {
+    EnsureWidget();
+    bubble_->Update(tabs, selected_index);
+    if (!widget_->IsVisible()) {
+      widget_->ShowInactive();
+    }
+  }
+
+ private:
+  class BubbleView : public views::BubbleDialogDelegateView {
+   public:
+    explicit BubbleView(BrowserView* browser_view)
+        : views::BubbleDialogDelegateView(browser_view,
+                                          views::BubbleBorder::FLOAT,
+                                          views::BubbleBorder::DIALOG_SHADOW,
+                                          /*autosize=*/false),
+          browser_view_(browser_view) {
+      SetButtons(ui::mojom::DialogButton::kNone);
+      SetCanActivate(false);
+      set_accept_events(false);
+      set_close_on_deactivate(false);
+      set_focus_traversable_from_anchor_view(false);
+      set_highlight_button_when_shown(false);
+      SetAccessibleTitle(l10n_util::GetStringUTF16(IDS_RECENT_TABS_MENU));
+      SetPreferredSize(kOverlaySize);
+
+      SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kVertical,
+          gfx::Insets::VH(kVerticalInset, kHorizontalInset), kElementSpacing));
+
+      title_label_ = AddChildView(std::make_unique<views::Label>());
+      title_label_->SetTextStyle(views::style::STYLE_EMPHASIZED);
+      title_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      title_label_->SetElideBehavior(gfx::ELIDE_TAIL);
+      title_label_->SetMaximumWidthSingleLine(kPreviewSize.width());
+
+      domain_label_ = AddChildView(std::make_unique<views::Label>());
+      domain_label_->SetTextStyle(views::style::STYLE_SECONDARY);
+      domain_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      domain_label_->SetElideBehavior(gfx::ELIDE_TAIL);
+      domain_label_->SetMaximumWidthSingleLine(kPreviewSize.width());
+
+      auto preview_container = std::make_unique<views::View>();
+      preview_container->SetPreferredSize(kPreviewSize);
+      preview_container->SetBackground(views::CreateRoundedRectBackground(
+          kColorTabHoverCardBackground, kPreviewCornerRadius));
+      preview_container->SetLayoutManager(
+          std::make_unique<views::FillLayout>());
+
+      preview_image_ =
+          preview_container->AddChildView(std::make_unique<views::ImageView>());
+      preview_image_->SetImageSize(kPreviewSize);
+      preview_image_->SetCornerRadius(kPreviewCornerRadius);
+
+      placeholder_icon_ =
+          preview_container->AddChildView(std::make_unique<views::ImageView>());
+      placeholder_icon_->SetImageSize(kPlaceholderIconSize);
+
+      AddChildView(std::move(preview_container));
+
+      icon_strip_ = AddChildView(std::make_unique<views::View>());
+      icon_strip_->SetPreferredSize(
+          gfx::Size(kPreviewSize.width(), kIconChipSize));
+      auto* strip_layout =
+          icon_strip_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+              views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+              kIconSpacing));
+      strip_layout->set_main_axis_alignment(
+          views::BoxLayout::MainAxisAlignment::kCenter);
+
+      position_label_ = AddChildView(std::make_unique<views::Label>());
+      position_label_->SetTextStyle(views::style::STYLE_SECONDARY);
+      position_label_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+
+      thumbnail_subscription_ =
+          thumbnail_observer_.AddCallback(base::BindRepeating(
+              &BubbleView::OnThumbnailAvailable, base::Unretained(this)));
+    }
+
+    BubbleView(const BubbleView&) = delete;
+    BubbleView& operator=(const BubbleView&) = delete;
+    ~BubbleView() override = default;
+
+    void Update(const std::vector<content::WebContents*>& tabs,
+                size_t selected_index) {
+      if (tabs.empty() || selected_index >= tabs.size()) {
+        return;
+      }
+
+      content::WebContents* selected = tabs[selected_index];
+      TabUIHelper* selected_helper = GetTabUIHelper(selected);
+      title_label_->SetText(selected_helper ? selected_helper->GetTitle()
+                                            : selected->GetTitle());
+      domain_label_->SetText(
+          base::UTF8ToUTF16(selected->GetVisibleURL().host()));
+      position_label_->SetText(base::NumberToString16(selected_index + 1) +
+                               u" / " + base::NumberToString16(tabs.size()));
+
+      preview_image_->SetImage(ui::ImageModel());
+      placeholder_icon_->SetImage(
+          selected_helper ? selected_helper->GetFavicon() : ui::ImageModel());
+      placeholder_icon_->SetVisible(true);
+
+      ThumbnailTabHelper* thumbnail_helper =
+          ThumbnailTabHelper::FromWebContents(selected);
+      thumbnail_observer_.Observe(
+          thumbnail_helper ? thumbnail_helper->thumbnail() : nullptr);
+
+      RebuildIconStrip(tabs, selected_index);
+    }
+
+   private:
+    static constexpr gfx::Size kOverlaySize = gfx::Size(448, 390);
+    static constexpr gfx::Size kPreviewSize = gfx::Size(408, 230);
+    static constexpr gfx::Size kPlaceholderIconSize = gfx::Size(32, 32);
+    static constexpr int kHorizontalInset = 20;
+    static constexpr int kVerticalInset = 16;
+    static constexpr int kElementSpacing = 8;
+    static constexpr int kPreviewCornerRadius = 12;
+    static constexpr int kIconChipSize = 36;
+    static constexpr int kIconSize = 20;
+    static constexpr int kIconSpacing = 8;
+    static constexpr size_t kMaxVisibleIcons = 9;
+
+    TabUIHelper* GetTabUIHelper(content::WebContents* contents) const {
+      TabStripModel* model = browser_view_->browser()->tab_strip_model();
+      const int index = model->GetIndexOfWebContents(contents);
+      return index == TabStripModel::kNoTab
+                 ? nullptr
+                 : TabUIHelper::From(model->GetTabAtIndex(index));
+    }
+
+    void RebuildIconStrip(const std::vector<content::WebContents*>& tabs,
+                          size_t selected_index) {
+      icon_strip_->RemoveAllChildViews();
+
+      const size_t visible_count = std::min(kMaxVisibleIcons, tabs.size());
+      size_t first_visible = 0;
+      if (tabs.size() > visible_count) {
+        const size_t half = visible_count / 2;
+        first_visible = selected_index > half ? selected_index - half : 0;
+        first_visible = std::min(first_visible, tabs.size() - visible_count);
+      }
+
+      for (size_t offset = 0; offset < visible_count; ++offset) {
+        const size_t index = first_visible + offset;
+        TabUIHelper* helper = GetTabUIHelper(tabs[index]);
+
+        auto chip = std::make_unique<views::View>();
+        chip->SetPreferredSize(gfx::Size(kIconChipSize, kIconChipSize));
+        chip->SetBorder(
+            index == selected_index
+                ? views::CreateRoundedRectBorder(2, kIconChipSize / 2,
+                                                 kColorTabHoverCardForeground)
+                : views::CreateEmptyBorder(2));
+        chip->SetLayoutManager(std::make_unique<views::FillLayout>());
+
+        auto icon = std::make_unique<views::ImageView>();
+        icon->SetImage(helper ? helper->GetFavicon() : ui::ImageModel());
+        icon->SetImageSize(gfx::Size(kIconSize, kIconSize));
+        const std::u16string title =
+            helper ? helper->GetTitle() : tabs[index]->GetTitle();
+        icon->SetTooltipText(title);
+        chip->SetTooltipText(title);
+        chip->AddChildView(std::move(icon));
+        icon_strip_->AddChildView(std::move(chip));
+      }
+
+      icon_strip_->InvalidateLayout();
+    }
+
+    void OnThumbnailAvailable(TabHoverCardThumbnailObserver*,
+                              gfx::ImageSkia thumbnail) {
+      if (thumbnail.isNull()) {
+        return;
+      }
+      preview_image_->SetImage(
+          ui::ImageModel::FromImageSkia(std::move(thumbnail)));
+      placeholder_icon_->SetVisible(false);
+    }
+
+    const raw_ptr<BrowserView> browser_view_;
+    raw_ptr<views::Label> title_label_ = nullptr;
+    raw_ptr<views::Label> domain_label_ = nullptr;
+    raw_ptr<views::ImageView> preview_image_ = nullptr;
+    raw_ptr<views::ImageView> placeholder_icon_ = nullptr;
+    raw_ptr<views::View> icon_strip_ = nullptr;
+    raw_ptr<views::Label> position_label_ = nullptr;
+    TabHoverCardThumbnailObserver thumbnail_observer_;
+    base::CallbackListSubscription thumbnail_subscription_;
+  };
+
+  void EnsureWidget() {
+    if (widget_) {
+      return;
+    }
+
+    bubble_ = std::make_unique<BubbleView>(browser_view_);
+    widget_ = views::BubbleDialogDelegate::CreateBubble(
+        bubble_.get(), base::BindOnce(&MRUTabSwitcherOverlay::OnWidgetClosed,
+                                      weak_factory_.GetWeakPtr()));
+  }
+
+  void OnWidgetClosed(views::Widget::ClosedReason) {
+    widget_.reset();
+    bubble_.reset();
+  }
+
+  const raw_ptr<BrowserView> browser_view_;
+  std::unique_ptr<BubbleView> bubble_;
+  std::unique_ptr<views::Widget> widget_;
+  base::WeakPtrFactory<MRUTabSwitcherOverlay> weak_factory_{this};
+};
