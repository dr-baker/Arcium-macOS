+    private func snapshot(spaceID: String = "space-a", webMode: String = "system",
+                          interfaceMode: String = "dark",
+                          available: Bool = true, managed: Bool = false) -> NSDictionary {
+        NSDictionary(dictionary: ["available": true, "appearance": [
+            "availableSection": true, "mode": interfaceMode, "modeAvailable": true,
+            "modeManaged": false, "webMode": webMode,
+            "webModeAvailable": available, "webModeManaged": managed,
+            "spacePalette": ["id": spaceID, "name": "Space", "available": true]
+        ]])
+    }
+
+    @MainActor
+    func testWebModeUsesCapturedSpaceAndSeparateInterfaceAction() throws {
+        let delegate = TestDelegate()
+        let store = ArciumSettingsStore(snapshot: snapshot(), delegate: delegate)
+        XCTAssertEqual(store.appearanceMode(), .dark)
+        XCTAssertEqual(store.webAppearanceMode(), .system)
+        store.applyWebAppearanceMode(.light, spaceID: "space-a")
+        XCTAssertEqual(delegate.settings.map(\.key), ["space_web_mode"])
+        let page = try XCTUnwrap(delegate.settings.first?.value as? [String: Any])
+        XCTAssertEqual(page["spaceID"] as? String, "space-a")
+        XCTAssertEqual(page["mode"] as? String, "light")
+        store.updateSnapshot(snapshot(webMode: "light"))
+        XCTAssertEqual(store.appearanceMode(), .dark)
+        XCTAssertEqual(store.webAppearanceMode(), .light)
+        store.updateSnapshot(snapshot(spaceID: "space-b", webMode: "dark"))
+        store.applyWebAppearanceMode(.system, spaceID: "space-a")
+        XCTAssertEqual(delegate.settings.count, 1)
+        store.applyAppearanceMode(.light, spaceID: "space-b")
+        XCTAssertEqual(delegate.settings.map(\.key), ["space_web_mode", "space_mode"])
+        let interface = try XCTUnwrap(delegate.settings.last?.value as? [String: Any])
+        XCTAssertEqual(interface["spaceID"] as? String, "space-b")
+        XCTAssertEqual(interface["mode"] as? String, "light")
+    }
+
+    @MainActor
+    func testWebModeRemainsEditableWhenChromePolicyDisablesPalette() {
+        let delegate = TestDelegate()
+        let value = snapshot() as! [String: Any]
+        var appearance = value["appearance"] as! [String: Any]
+        appearance["modeManaged"] = true
+        appearance["spacePalette"] = ["id": "space-a", "available": false]
+        let store = ArciumSettingsStore(snapshot: NSDictionary(dictionary: [
+            "available": true, "appearance": appearance
+        ]), delegate: delegate)
+        store.applyWebAppearanceMode(.light, spaceID: "space-a")
+        XCTAssertEqual(delegate.settings.map(\.key), ["space_web_mode"])
+    }
+
+    @MainActor
+    func testWebModeUnavailableManagedOrMissingMetadataEmitsNothing() {
+        let delegate = TestDelegate()
+        for (available, managed) in [(false, false), (true, true)] {
+            let store = ArciumSettingsStore(snapshot: snapshot(available: available, managed: managed),
+                                            delegate: delegate)
+            store.applyWebAppearanceMode(.dark)
+        }
+        let missing = ArciumSettingsStore(snapshot: NSDictionary(dictionary: [
+            "available": true, "appearance": ["availableSection": true,
+                "spacePalette": ["id": "space-a", "available": true]]
+        ]), delegate: delegate)
+        missing.applyWebAppearanceMode(.dark)
+        XCTAssertTrue(delegate.settings.isEmpty)
+    }
+
+    @MainActor
+    func testWebModeFollowsResolvedChromeRatherThanSystem() {
+        let delegate = TestDelegate()
+        let store = ArciumSettingsStore(snapshot: snapshot(), delegate: delegate)
+        XCTAssertEqual(store.webColorScheme(systemColorScheme: .light), .dark)
+        store.updateSnapshot(snapshot(webMode: "light"))
+        XCTAssertEqual(store.webColorScheme(systemColorScheme: .dark), .light)
+        store.updateSnapshot(snapshot(webMode: "dark", interfaceMode: "light"))
+        XCTAssertEqual(store.webColorScheme(systemColorScheme: .light), .dark)
+        store.updateSnapshot(snapshot(interfaceMode: "light"))
+        XCTAssertEqual(store.webColorScheme(systemColorScheme: .dark), .light)
+        store.updateSnapshot(snapshot(interfaceMode: "system"))
+        XCTAssertEqual(store.webColorScheme(systemColorScheme: .light), .light)
+        XCTAssertEqual(store.webColorScheme(systemColorScheme: .dark), .dark)
+    }
