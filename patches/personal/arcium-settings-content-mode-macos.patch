+    func applyWebAppearanceMode(_ mode: SettingsAppearance, spaceID: String? = nil) {
+        let target = snapshot.appearance.spacePalette
+        guard snapshot.appearance.webModeAvailable,
+              !snapshot.appearance.webModeManaged,
+              !target.id.isEmpty, (spaceID ?? target.id) == target.id else { return }
+        let value: String
+        switch mode {
+        case .system: value = "system"
+        case .light: value = "light"
+        case .dark: value = "dark"
+        }
+        settingChanged(key: "space_web_mode", value: ["spaceID": target.id, "mode": value])
+    }
