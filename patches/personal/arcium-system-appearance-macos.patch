+
+#include "chrome/browser/ui/helium/arcium_settings_model.h"
+
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/test/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/helium/helium_space.h"
+#include "chrome/browser/ui/helium/helium_space_service.h"
+#include "chrome/browser/ui/helium/helium_space_service_factory.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/native_theme/mock_os_settings_provider.h"
+#include "ui/native_theme/native_theme.h"
+
+namespace arcium_settings {
+namespace {
+class ArciumSystemAppearanceModelTest : public BrowserWithTestWindowTest {
+ protected:
+  void SetUp() override {
+    BrowserWithTestWindowTest::SetUp();
+    service_ =
+        helium::HeliumSpaceServiceFactory::GetInstance()
+            ->SetTestingSubclassFactoryAndUse(
+                profile(), base::BindOnce([](content::BrowserContext* context) {
+                  return std::make_unique<helium::HeliumSpaceService>(
+                      static_cast<Profile*>(context));
+                }));
+    ASSERT_TRUE(service_);
+  }
+  void TearDown() override {
+    service_ = nullptr;
+    BrowserWithTestWindowTest::TearDown();
+  }
+  raw_ptr<helium::HeliumSpaceService> service_ = nullptr;
+};
+
+TEST_F(ArciumSystemAppearanceModelTest,
+       NativeChangesRefreshFixedChromeAndStopAtShutdown) {
+  ui::MockOsSettingsProvider os;
+  os.SetPreferredColorScheme(ui::NativeTheme::PreferredColorScheme::kLight);
+  int changes = 0;
+  ArciumSettingsModel model(profile(),
+                            base::BindLambdaForTesting([&] { ++changes; }),
+                            base::DoNothing());
+  ASSERT_TRUE(model.SetAppearanceSpace(service_->GetDefaultSpace()->id()));
+  ASSERT_TRUE(model.SetAppearanceMode(
+      static_cast<int>(ThemeService::BrowserColorScheme::kLight)));
+  const int before = changes;
+  os.SetPreferredColorScheme(ui::NativeTheme::PreferredColorScheme::kDark);
+  EXPECT_GT(changes, before);
+  EXPECT_EQ(static_cast<int>(ThemeService::BrowserColorScheme::kDark),
+            model.GetSystemAppearanceMode());
+  EXPECT_EQ(static_cast<int>(ThemeService::BrowserColorScheme::kLight),
+            model.GetAppearanceMode());
+  ASSERT_TRUE(model.SetAppearanceMode(
+      static_cast<int>(ThemeService::BrowserColorScheme::kDark)));
+  const int dark_before = changes;
+  os.SetPreferredColorScheme(ui::NativeTheme::PreferredColorScheme::kLight);
+  EXPECT_GT(changes, dark_before);
+  EXPECT_EQ(static_cast<int>(ThemeService::BrowserColorScheme::kLight),
+            model.GetSystemAppearanceMode());
+  EXPECT_EQ(static_cast<int>(ThemeService::BrowserColorScheme::kDark),
+            model.GetAppearanceMode());
+  model.Shutdown();
+  const int stopped = changes;
+  os.SetPreferredColorScheme(ui::NativeTheme::PreferredColorScheme::kDark);
+  EXPECT_EQ(stopped, changes);
+}
+
+TEST_F(ArciumSystemAppearanceModelTest, DestructionDetachesNativeObservation) {
+  ui::MockOsSettingsProvider os;
+  os.SetPreferredColorScheme(ui::NativeTheme::PreferredColorScheme::kLight);
+  int changes = 0;
+  {
+    ArciumSettingsModel model(profile(),
+                              base::BindLambdaForTesting([&] { ++changes; }),
+                              base::DoNothing());
+    os.SetPreferredColorScheme(ui::NativeTheme::PreferredColorScheme::kDark);
+    EXPECT_GT(changes, 0);
+  }
+  const int destroyed = changes;
+  os.SetPreferredColorScheme(ui::NativeTheme::PreferredColorScheme::kLight);
+  EXPECT_EQ(destroyed, changes);
+}
+}  // namespace
+}  // namespace arcium_settings
