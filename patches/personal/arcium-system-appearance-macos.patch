+// The bridge publishes actual native System mode separately from window chrome.
+// Older snapshots fall back to NSApp, which is not forced by NSWindow.appearance.
+func arciumContentColorScheme(_ mode: String, systemMode: String) -> ColorScheme {
+    switch mode.lowercased() {
+    case "light": return .light
+    case "dark": return .dark
+    default:
+        switch systemMode.lowercased() {
+        case "light": return .light
+        case "dark": return .dark
+        default:
+            return NSApp.effectiveAppearance.bestMatch(from: [.aqua, .darkAqua]) == .darkAqua
+                ? .dark : .light
+        }
+    }
+}
