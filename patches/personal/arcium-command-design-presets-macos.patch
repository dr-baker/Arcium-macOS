+private struct ArciumCommandBarPresetDocument: FileDocument {
+    static var readableContentTypes: [UTType] { [.json] }
+    let layout: ArciumCommandPanelLayout
+    init(layout: ArciumCommandPanelLayout) { self.layout = layout }
+    init(configuration: ReadConfiguration) throws {
+        guard let data = configuration.file.regularFileContents else { throw ArciumCommandBarPreset.Failure.invalid }
+        layout = try ArciumCommandBarPreset.decode(data)
+    }
+    func fileWrapper(configuration: WriteConfiguration) throws -> FileWrapper {
+        FileWrapper(regularFileWithContents: try ArciumCommandBarPreset.encode(layout))
+    }
+}
