+// Portable production settings only. Workshop context and scripted results are
+// deliberately excluded when a design is applied to a browser profile.
+nonisolated enum ArciumCommandBarPreset {
+    static let maximumBytes = 1024 * 1024
+    enum Failure: LocalizedError {
+        case invalid
+        var errorDescription: String? { "Choose a valid Arcium command-bar design file." }
+    }
+    static func decode(_ data: Data) throws -> ArciumCommandPanelLayout {
+        guard data.count <= maximumBytes,
+              let document = try JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+            throw Failure.invalid
+        }
+        let layout: [String: Any]
+        if let schema = document["schema"] as? String {
+            guard exactIntegerOptional(document["version"]) == 1,
+                  (schema == "arcium-command-bar-layout" ||
+                   (schema == "arcium-ui-workshop" && document["component"] as? String == "command-bar")),
+                  let value = document["layout"] as? [String: Any] else { throw Failure.invalid }
+            layout = value
+        } else {
+            layout = document
+        }
+        let required: Set<String> = ["labels", "icons", "scope_reveal", "connected", "scope_width",
+                                     "scope_tints", "glow_strength", "activity_dots"]
+        let keys = Set(layout.keys)
+        guard keys == required || keys == required.union(["result_count"]) else { throw Failure.invalid }
+        for (key, upper) in [("labels", 2), ("icons", 3), ("scope_reveal", 5), ("scope_width", 2)] {
+            guard let value = exactIntegerOptional(layout[key]), (0...upper).contains(value) else { throw Failure.invalid }
+        }
+        for key in ["connected", "scope_tints", "activity_dots"] {
+            guard strictBoolean(layout[key]) != nil else { throw Failure.invalid }
+        }
+        guard let strength = finiteDouble(layout["glow_strength"]), (0...2).contains(strength) else { throw Failure.invalid }
+        if let raw = layout["result_count"] {
+            guard let value = exactIntegerOptional(raw), (1...20).contains(value) else { throw Failure.invalid }
+        }
+        return ArciumCommandPanelLayout(layout)
+    }
+    static func encode(_ layout: ArciumCommandPanelLayout) throws -> Data {
+        try JSONSerialization.data(withJSONObject: ["schema": "arcium-command-bar-layout", "version": 1,
+                                                    "layout": layout.dictionary], options: [.prettyPrinted, .sortedKeys])
+    }
+    static func read(_ url: URL) throws -> ArciumCommandPanelLayout {
+        let file = try FileHandle(forReadingFrom: url)
+        defer { try? file.close() }
+        guard let data = try file.read(upToCount: maximumBytes + 1) else { throw Failure.invalid }
+        return try decode(data)
+    }
+}
