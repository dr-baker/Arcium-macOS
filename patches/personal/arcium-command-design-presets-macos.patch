+import XCTest
+@testable import ArciumSettingsUI
+
+final class ArciumCommandBarPresetTests: XCTestCase {
+    func testEveryRevealAndWidthRoundTrips() throws {
+        for reveal in 0...5 { for width in ArciumCommandPanelLayout.Width.allCases {
+            var layout = ArciumCommandPanelLayout()
+            layout.reveal = reveal; layout.width = width
+            layout.icons = 3; layout.labels = 2; layout.resultCount = 20
+            layout.glowStrength = 1.35; layout.activityDots = false
+            XCTAssertEqual(try ArciumCommandBarPreset.decode(ArciumCommandBarPreset.encode(layout)), layout)
+        }}
+    }
+    func testLegacyEightFieldsNormalizeDisconnectedFlushAndResultCount() throws {
+        var value = ArciumCommandPanelLayout().dictionary
+        value.removeValue(forKey: "result_count")
+        value["connected"] = false; value["scope_width"] = 0
+        let layout = try ArciumCommandBarPreset.decode(JSONSerialization.data(withJSONObject: value))
+        XCTAssertEqual(layout.width, .offset)
+        XCTAssertEqual(layout.resultCount, 8)
+        XCTAssertEqual(try ArciumCommandBarPreset.decode(ArciumCommandBarPreset.encode(layout)), layout)
+    }
+    func testWorkshopEnvelopeAppliesOnlyProductionLayout() throws {
+        var layout = ArciumCommandPanelLayout(); layout.icons = 0; layout.resultCount = 3
+        let document: [String: Any] = ["schema": "arcium-ui-workshop", "version": 1,
+            "component": "command-bar", "fixture": "streaming", "query": "Example",
+            "context": ["scale": 1.25], "layout": layout.dictionary]
+        XCTAssertEqual(try ArciumCommandBarPreset.decode(JSONSerialization.data(withJSONObject: document)), layout)
+    }
+    func testBooleanEnumsAndUnknownLayoutKeysAreRejected() throws {
+        for key in ["labels", "icons", "scope_reveal", "scope_width", "glow_strength", "result_count"] {
+            var value = ArciumCommandPanelLayout().dictionary; value[key] = true
+            XCTAssertThrowsError(try ArciumCommandBarPreset.decode(JSONSerialization.data(withJSONObject: value)))
+        }
+        var value = ArciumCommandPanelLayout().dictionary; value["unknown"] = 0
+        XCTAssertThrowsError(try ArciumCommandBarPreset.decode(JSONSerialization.data(withJSONObject: value)))
+    }
+    func testWrongVersionAndComponentAreRejected() throws {
+        for document: [String: Any] in [
+            ["schema": "arcium-command-bar-layout", "version": 2, "layout": ArciumCommandPanelLayout().dictionary],
+            ["schema": "arcium-ui-workshop", "version": 1, "component": "sidebar", "layout": ArciumCommandPanelLayout().dictionary]] {
+            XCTAssertThrowsError(try ArciumCommandBarPreset.decode(JSONSerialization.data(withJSONObject: document)))
+        }
+    }
+    func testOversizedAndMalformedFilesAreRejected() {
+        XCTAssertThrowsError(try ArciumCommandBarPreset.decode(Data(repeating: 32, count: ArciumCommandBarPreset.maximumBytes + 1)))
+        XCTAssertThrowsError(try ArciumCommandBarPreset.decode(Data("invalid".utf8)))
+    }
+}
