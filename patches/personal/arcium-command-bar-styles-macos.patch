+// A small style-selection diagram; the adjacent live preview uses production UI.
+private struct ArciumCommandStyleThumbnail: View {
+    let style: ArciumCommandPanelLayout.Style
+    @Environment(\.settingsTheme) private var theme
+    var body: some View {
+        Canvas { context, size in
+            let body = CGRect(x: 4, y: 28, width: size.width - 8, height: 34)
+            context.fill(Path(roundedRect: body, cornerRadius: 6), with: .color(theme.control.opacity(0.22)))
+            let gap: CGFloat = style.attached ? 0 : 5
+            let available = size.width - 16
+            let widths: [CGFloat] = style.attached
+                ? Array(repeating: available / 4, count: 4)
+                : [available * 0.32, available * 0.2, available * 0.2, available * 0.2]
+            var x: CGFloat = 8
+            for index in 0..<4 {
+                let height: CGFloat = switch style {
+                case .minimal: 3
+                case .subtle: index == 0 ? 7 : 3
+                case .stacked: 20
+                case .peek: 7
+                }
+                let bottom: CGFloat = style.attached ? 30 : 22
+                let tab = CGRect(x: x, y: bottom - height, width: max(8, widths[index] - gap), height: height)
+                context.fill(Path(roundedRect: tab, cornerRadius: min(5, height / 2)),
+                             with: .color(index == 0 ? theme.accent.opacity(0.8) : theme.textSecondary.opacity(0.28)))
+                if style == .stacked {
+                    context.fill(Path(ellipseIn: CGRect(x: tab.midX - 2, y: tab.midY - 2, width: 4, height: 4)),
+                                 with: .color(theme.textPrimary.opacity(0.7)))
+                }
+                x += widths[index]
+            }
+            for index in 0..<2 {
+                let row = CGRect(x: 12, y: 36 + CGFloat(index) * 10, width: size.width * (index == 0 ? 0.65 : 0.44), height: 3)
+                context.fill(Path(roundedRect: row, cornerRadius: 1.5), with: .color(theme.textSecondary.opacity(0.4)))
+            }
+        }
+    }
 }
 
