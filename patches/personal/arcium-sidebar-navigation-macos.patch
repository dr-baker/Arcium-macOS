+bool IsSidebarNavigationAvailableForProfile(Profile* profile) {
+  GlobalBrowserCollection* collection = GlobalBrowserCollection::GetInstance();
+  if (!profile || !collection) {
+    return false;
+  }
+
+  bool available = false;
+  collection->ForEach(
+      [&available, profile](BrowserWindowInterface* browser) {
+        if (!IsMatchingNormalBrowser(browser, profile)) {
+          return true;
+        }
+        available = BrowserView::GetBrowserViewForBrowser(browser)
+                        ->IsSidebarNavigationAvailable();
+        return false;
+      },
+      BrowserCollection::Order::kActivation);
+  return available;
+}
+
