+  return prefs && prefs->FindPreference(arcium::kArcSidebarNavigationEnabledPref) &&
+         prefs->GetBoolean(arcium::kArcSidebarNavigationEnabledPref) &&
+         IsSidebarNavigationAvailableForProfile(profile);
