+
+struct ArciumSpaceThemeDraftView: View {
+    @ObservedObject var draft: ArciumSpaceThemeDraft
+    @Environment(\.colorScheme) private var systemScheme
+
+    private func scheme(_ mode: String) -> ColorScheme? {
+        switch mode { case "light": .light; case "dark": .dark; default: nil }
+    }
+
+    var body: some View {
+        if let preset = draft.preset, draft.configuration != nil {
+            let colorScheme = scheme(draft.webMode) ?? scheme(draft.mode) ?? systemScheme
+            let style = colorScheme == .dark ? preset.dark : preset.light
+            let theme = draft.palette.theme(fallback: style.theme(brand: preset.brand), colorScheme: colorScheme)
+            ArciumLiveSettingsSheet(title: "Space theme", onClose: { draft.finish() }) {
+                ArciumSpacePaletteEditor(configuration: configuration,
+                    resolvedTintColor: resolvedTintColor)
+                SGroupedSections(showsSurfaces: false, showsDividers: false) {
+                    Section("Background") {
+                        SSlider("Color strength", value: value(\.tintStrength), range: 0...1,
+                                step: 0.01, format: percent,
+                                commitMode: .throttled(milliseconds: 80))
+                        SSlider("Grain", value: value(\.grain), range: 0...0.3,
+                                step: 0.01, format: percent,
+                                commitMode: .throttled(milliseconds: 80))
+                    }
+                }
+            }
+            .settingsTheme(theme)
+            .settingsFont(preset.font)
+            .settingsFontScale(CGFloat(style.surface.fontScale))
+            .settingsLayout(SettingsLayoutConfiguration(pageGutter: 24, compactPageGutter: 16,
+                maximumPageWidth: 960, cardPadding: 14, sectionSpacing: 20, rowSpacing: 7, inputWidth: 260))
+            .preferredColorScheme(colorScheme)
+        } else {
+            VStack(spacing: 20) {
+                Text("The Space palette editor could not be loaded.")
+                Button("Done") { draft.finish() }.keyboardShortcut(.defaultAction)
+            }.padding(32).onExitCommand { draft.finish() }
+        }
+    }
+
+    private var resolvedTintColor: SettingsRGB? {
+        let dark = scheme(draft.mode).map { $0 == .dark }
+            ?? (NSApp.effectiveAppearance.bestMatch(from: [.aqua, .darkAqua]) == .darkAqua)
+        return (dark ? draft.palette.dark : draft.palette.light)["chrome"]
+            .flatMap(SettingsRGB.init(hex:))
+    }
+
+    private var configuration: Binding<SettingsBackdropConfiguration> {
+        Binding(get: { draft.configuration ?? SettingsBackdropConfiguration(radiusReference: .shortestEdge) },
+                set: { draft.setConfiguration($0) })
+    }
+
+    private func value(_ keyPath: WritableKeyPath<SettingsBackdropConfiguration, Double>) -> Binding<Double> {
+        Binding(get: { configuration.wrappedValue[keyPath: keyPath] }, set: { value in
+            var next = configuration.wrappedValue
+            next[keyPath: keyPath] = value
+            draft.setConfiguration(next)
+        })
+    }
+
+    private func percent(_ value: Double) -> String { "\(Int((value * 100).rounded()))%" }
+}
