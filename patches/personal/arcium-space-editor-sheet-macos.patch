+@objc public protocol ArciumSpaceThemeEditorDelegate: AnyObject {
+    @objc(spaceThemeEditorDidChangeConfiguration:)
+    func configurationChanged(_ configuration: NSDictionary)
+
+    @objc(spaceThemeEditorDidFinish)
+    func finished()
+}
+
+/// Presentation state for an unsaved draft. Its delegate has no profile writes.
+@MainActor
+final class ArciumSpaceThemeDraft: ObservableObject {
+    @Published private(set) var configuration: SettingsBackdropConfiguration?
+    @Published private(set) var palette = ArciumSpacePaletteSnapshot()
+    @Published private(set) var mode = "system"
+    @Published private(set) var webMode = "system"
+    weak var delegate: ArciumSpaceThemeEditorDelegate?
+    let preset: SettingsStylePreset?
+
+    init(snapshot: NSDictionary, delegate: ArciumSpaceThemeEditorDelegate) {
+        self.delegate = delegate
+        preset = try? loadArciumSettingsStylePreset(from:
+            Bundle.main.resourceURL?.appendingPathComponent("ArciumSettingsUI_ArciumSettingsUI.bundle"))
+        updateSnapshot(snapshot)
+    }
+
+    func updateSnapshot(_ snapshot: NSDictionary) {
+        let fields = snapshot["configuration"] as? [String: Any] ?? [:]
+        configuration = ArciumChromeAppearanceSnapshot.Configuration(fields).backdropConfiguration
+        palette = ArciumSpacePaletteSnapshot(snapshot["spacePalette"] as? [String: Any] ?? [:])
+        mode = snapshot["mode"] as? String ?? "system"
+        webMode = snapshot["webMode"] as? String ?? "system"
+    }
+
+    func setConfiguration(_ next: SettingsBackdropConfiguration) {
+        guard configuration != nil else { return }
+        configuration = next
+        delegate?.configurationChanged(
+            ArciumChromeAppearanceAdapter.dictionaryRepresentation(for: next) as NSDictionary)
+    }
+
+    func finish() { delegate?.finished() }
+}
+
+@MainActor
+@objc(ArciumSpaceThemeEditorController)
+public final class ArciumSpaceThemeEditorController: NSHostingController<AnyView> {
+    private let draft: ArciumSpaceThemeDraft
+
+    @objc(initWithSnapshot:delegate:)
+    public init(snapshot: NSDictionary, delegate: ArciumSpaceThemeEditorDelegate) {
+        let draft = ArciumSpaceThemeDraft(snapshot: snapshot, delegate: delegate)
+        self.draft = draft
+        super.init(rootView: AnyView(ArciumSpaceThemeDraftView(draft: draft)))
+    }
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+        fatalError("Arcium Space themes do not support storyboards")
+    }
+
+    @objc(updateSnapshot:)
+    public func updateSnapshot(_ snapshot: NSDictionary) { draft.updateSnapshot(snapshot) }
+}
