+// This controller owns only the creation/editing draft. Profile configuration is
+// read once for inherited context; all writes return to the compact editor.
+@interface ArciumSpaceThemeDraftController
+    : NSWindowController <NSWindowDelegate, ArciumSpaceThemeEditorDelegate>
+- (instancetype)initWithParent:(NSWindow*)parent
+                       widget:(views::Widget*)widget
+                      profile:(Profile*)profile
+                        theme:(const helium::SpaceTheme&)theme
+                      changed:(base::RepeatingCallback<void(const helium::SpaceTheme&)>)changed;
+- (void)closeDraft;
+@end
+
+@implementation ArciumSpaceThemeDraftController {
+  helium::SpaceTheme theme_;
+  helium::GlassSurfaceConfiguration base_configuration_;
+  base::RepeatingCallback<void(const helium::SpaceTheme&)> changed_;
+  std::unique_ptr<ScopedProfileKeepAlive> profile_keep_alive_;
+  NSViewController* facade_;
+  base::DictValue fallback_roles_;
+  BOOL uses_fallback_roles_;
+  BOOL closed_;
+}
+
+- (NSDictionary*)draftSnapshot {
+  const auto input = helium::SpacePaletteKey(&theme_, base_configuration_);
+  auto light = arcium::GenerateSpacePalette(input, false);
+  auto dark = arcium::GenerateSpacePalette(input, true);
+  return @{
+    @"configuration": NSDictionaryFromBaseDict(
+        helium::SerializeGlassSurfaceConfiguration(
+            helium::SpacePaletteAppearance(&theme_, base_configuration_))),
+    @"mode": AppearanceModeString(static_cast<int>(theme_.mode)),
+    @"webMode": AppearanceModeString(static_cast<int>(theme_.web_mode)),
+    @"spacePalette": @{
+      @"id": @"space-draft", @"available": @YES,
+      @"light": (uses_fallback_roles_ ? NSDictionaryFromBaseDict(fallback_roles_)
+          : NSDictionaryFromBaseDict(helium::SpacePaletteRoles(light))),
+      @"dark": (uses_fallback_roles_ ? NSDictionaryFromBaseDict(fallback_roles_)
+          : NSDictionaryFromBaseDict(helium::SpacePaletteRoles(dark)))
+    }
+  };
+}
+
+- (instancetype)initWithParent:(NSWindow*)parent
+                       widget:(views::Widget*)widget
+                      profile:(Profile*)profile
+                        theme:(const helium::SpaceTheme&)theme
+                      changed:(base::RepeatingCallback<void(const helium::SpaceTheme&)>)changed {
+  NSWindow* window = [[NSWindow alloc]
+      initWithContentRect:NSMakeRect(0, 0, 680, 620)
+                styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                          NSWindowStyleMaskResizable
+                  backing:NSBackingStoreBuffered defer:NO];
+  self = [super initWithWindow:window];
+  if (!self) return nil;
+  window.releasedWhenClosed = NO;
+  window.title = @"Space theme";
+  window.delegate = self;
+  window.minSize = NSMakeSize(540, 440);
+  theme_ = theme;
+  changed_ = std::move(changed);
+  base_configuration_ = profile
+      ? helium::ReadGlassSurfaceConfiguration(profile->GetPrefs())
+      : helium::DefaultGlassSurfaceConfiguration();
+  if (profile) {
+    profile_keep_alive_ = std::make_unique<ScopedProfileKeepAlive>(
+        profile, ProfileKeepAliveOrigin::kArciumSettingsWindow);
+  }
+  auto* theme_service = profile ? ThemeServiceFactory::GetForProfile(profile) : nullptr;
+  const auto* native_theme = widget->GetNativeTheme();
+  uses_fallback_roles_ =
+      (theme_service && theme_service->UsingPolicyTheme()) ||
+      native_theme->preferred_contrast() == ui::NativeTheme::PreferredContrast::kMore ||
+      widget->GetForcedColors() != ui::ColorProviderKey::ForcedColors::kNone;
+  if (uses_fallback_roles_) {
+    const auto* provider = widget->GetColorProvider();
+    arcium::SpacePaletteColors colors = {
+        .chrome = provider->GetColor(kColorToolbar),
+        .chrome_background = provider->GetColor(kColorToolbar),
+        .field = provider->GetColor(kColorLocationBarBackground),
+        .field_hovered = provider->GetColor(kColorLocationBarBackgroundHovered),
+        .panel = provider->GetColor(kColorOmniboxResultsBackground),
+        .panel_background = provider->GetColor(kColorOmniboxResultsBackground),
+        .text = provider->GetColor(kColorOmniboxText),
+        .muted_text = provider->GetColor(kColorOmniboxTextDimmed),
+        .outline = provider->GetColor(ui::kColorSysOutline),
+        .accent = provider->GetColor(ui::kColorSysPrimary),
+        .on_accent = provider->GetColor(ui::kColorSysOnPrimary),
+        .content_canvas = provider->GetColor(kColorToolbar),
+        .content_panel = provider->GetColor(kColorOmniboxResultsBackground),
+        .content_field = provider->GetColor(kColorLocationBarBackground),
+        .content_hovered = provider->GetColor(kColorLocationBarBackgroundHovered)};
+    fallback_roles_ = helium::SpacePaletteRoles(colors);
+  }
+  Class facade_class = LoadSettingsUIModule()
+      ? NSClassFromString(@"ArciumSpaceThemeEditorController") : Nil;
+  SEL initializer = NSSelectorFromString(kArciumSettingsUIInitializerSelector);
+  if (!facade_class || ![facade_class instancesRespondToSelector:initializer]) {
+    return nil;
+  }
+  using Initializer = id (*)(id, SEL, NSDictionary*, id);
+  id facade = reinterpret_cast<Initializer>(objc_msgSend)(
+      [facade_class alloc], initializer, [self draftSnapshot], self);
+  if (![facade isKindOfClass:[NSViewController class]]) return nil;
+  facade_ = facade;
+  window.contentViewController = facade_;
+  [parent beginSheet:window completionHandler:nil];
+  [window makeKeyWindow];
+  return self;
+}
+
+- (void)spaceThemeEditorDidChangeConfiguration:(NSDictionary*)configuration {
+  if (closed_ || !changed_) return;
+  auto dictionary = BaseDictFromNSObject(configuration);
+  auto parsed = dictionary
+      ? helium::ParseGlassSurfaceConfigurationStrict(*dictionary) : std::nullopt;
+  if (!parsed) return;
+  theme_ = helium::WithSpacePaletteAppearance(theme_, *parsed);
+  // Copy the callback: preview propagation may close the compact editor.
+  auto changed = changed_;
+  changed.Run(theme_);
+  if (!closed_) {
+    using Update = void (*)(id, SEL, NSDictionary*);
+    reinterpret_cast<Update>(objc_msgSend)(facade_,
+        NSSelectorFromString(kArciumSettingsUIUpdateSnapshotSelector),
+        [self draftSnapshot]);
+  }
+}
+
+- (void)spaceThemeEditorDidFinish { [self closeDraft]; }
+- (BOOL)windowShouldClose:(NSWindow*)sender {
+  [self closeDraft];
+  return NO;
+}
+- (void)closeDraft {
+  if (closed_) return;
+  closed_ = YES;
+  changed_.Reset();
+  [self.window.sheetParent endSheet:self.window];
+  [self.window orderOut:nil];
+  profile_keep_alive_.reset();
+}
+@end
+
 namespace arcium_settings {
 
+base::ScopedClosureRunner ShowSpaceThemeDraft(
+    BrowserWindowInterface* browser, Profile* profile,
+    const helium::SpaceTheme& theme,
+    base::RepeatingCallback<void(const helium::SpaceTheme&)> changed) {
+  auto* view = browser ? BrowserView::GetBrowserViewForBrowser(
+      browser->GetBrowserForMigrationOnly()) : nullptr;
+  auto* widget = view ? view->GetWidget() : nullptr;
+  NSWindow* parent = widget ? widget->GetNativeWindow().GetNativeNSWindow() : nil;
+  if (!parent || parent.attachedSheet) return {};
+  auto* controller = [[ArciumSpaceThemeDraftController alloc]
+      initWithParent:parent widget:widget profile:profile theme:theme
+             changed:std::move(changed)];
+  if (!controller) return {};
+  return base::ScopedClosureRunner(base::BindOnce(
+      [](ArciumSpaceThemeDraftController* controller) { [controller closeDraft]; },
+      controller));
+}
