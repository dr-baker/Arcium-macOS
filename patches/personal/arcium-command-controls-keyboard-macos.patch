 @interface ArciumCommandControlsWindow : NSWindow
+@property(nonatomic, copy) void (^arciumCancelHandler)(void);
 @end
 @implementation ArciumCommandControlsWindow
 - (BOOL)canBecomeKeyWindow { return YES; }
+- (void)cancelOperation:(id)sender {
+  void (^handler)(void) = self.arciumCancelHandler;
+  if (!handler) return;
+  self.arciumCancelHandler = nil;
+  // Close once, after AppKit finishes dispatching the current key event.
+  dispatch_async(dispatch_get_main_queue(), handler);
+}
+- (BOOL)handleEditorEscape:(NSEvent*)event {
+  const auto modifiers = NSEventModifierFlagCommand | NSEventModifierFlagControl |
+                         NSEventModifierFlagOption | NSEventModifierFlagShift;
+  if (event.type != NSEventTypeKeyDown || event.keyCode != 53 ||
+      (event.modifierFlags & modifiers)) return NO;
+  [self cancelOperation:nil];
+  return YES;
+}
+- (BOOL)performKeyEquivalent:(NSEvent*)event {
+  return [self handleEditorEscape:event] || [super performKeyEquivalent:event];
+}
+- (void)sendEvent:(NSEvent*)event {
+  if (![self handleEditorEscape:event]) [super sendEvent:event];
+}
 @end
 
