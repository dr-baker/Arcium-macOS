+- (NSView*)hitTest:(NSPoint)point {
+  if (_invalidated || _state.blocked) {
+    return nil;
+  }
+  NSPoint local = [self convertPoint:point fromView:self.superview];
+  if (!NSPointInRect(local, self.bounds)) {
+    return nil;
+  }
+  if (!_nativeVisible && _tucked == geo::Side::kNone) {
+    return self;
+  }
+  for (NSView* control in @[
+         _slider, _resizeView, _restoreButton, _returnButton, _tuckButton,
+         _closeButton, _playButton, _backButton, _forwardButton, _muteButton
+       ]) {
+    if (control.hiddenOrHasHiddenAncestor ||
+        control.superview.alphaValue == 0 || control.alphaValue == 0) {
+      continue;
+    }
+    NSPoint p = [control convertPoint:local fromView:self];
+    if (NSPointInRect(p, control.bounds)) {
+      return control;
+    }
+  }
+  return _tucked == geo::Side::kNone ? self : nil;
+}
+- (BOOL)acceptsFirstMouse:(NSEvent*)event {
+  return !_state.blocked;
+}
+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (_tracking) {
+    [self removeTrackingArea:_tracking];
+  }
+  _tracking = [[NSTrackingArea alloc]
+      initWithRect:NSZeroRect
+           options:NSTrackingMouseEnteredAndExited | NSTrackingMouseMoved |
+                   NSTrackingActiveAlways | NSTrackingInVisibleRect
+             owner:self
+          userInfo:nil];
+  [self addTrackingArea:_tracking];
+}
+- (void)armHideTimer {
+  [_hideTimer invalidate];
+  if (_seeking || [self hasControlsFocus] || _state.blocked ||
+      _tucked != geo::Side::kNone) {
+    return;
+  }
+  __weak ArciumPiPNativeOverlay* weakSelf = self;
+  _hideTimer = [NSTimer
+      scheduledTimerWithTimeInterval:3
+                             repeats:NO
+                               block:^(NSTimer* timer) {
+                                 ArciumPiPNativeOverlay* overlay = weakSelf;
+                                 if (!overlay || overlay->_invalidated ||
+                                     overlay->_seeking ||
+                                     [overlay hasControlsFocus]) {
+                                   return;
+                                 }
+                                 overlay->_nativeVisible = NO;
+                                 [overlay refreshChrome];
+                               }];
+}
+- (void)mouseEntered:(NSEvent*)event {
+  _mouseInside = YES;
+  if (_state.blocked || _tucked != geo::Side::kNone) {
+    return;
+  }
+  _nativeVisible = YES;
+  [self refreshChrome];
+  [self armHideTimer];
+}
+- (void)mouseMoved:(NSEvent*)event {
+  _mouseInside = YES;
+  if (_state.blocked || _tucked != geo::Side::kNone) {
+    return;
+  }
+  if (!_nativeVisible) {
+    _nativeVisible = YES;
+    [self refreshChrome];
+  }
+  [self armHideTimer];
+}
+- (void)mouseExited:(NSEvent*)event {
+  _mouseInside = NO;
+  if (!_seeking && !_dragging && ![self hasControlsFocus]) {
+    _nativeVisible = NO;
+    [self refreshChrome];
+  }
+}
+- (double)dragTime {
+  return lastEventTimestamp + NSProcessInfo.processInfo.systemUptime - lastEventUptime;
+}
+- (NSPoint)screenPoint:(NSEvent*)event {
+  return [event.window convertPointToScreen:event.locationInWindow];
+}
+- (void)updateMotionScreen:(NSPoint)pointer {
+  NSScreen* active = [self anchorScreen];
+  for (NSScreen* screen in NSScreen.screens) {
+    if (NSPointInRect(pointer, screen.frame)) { active = screen; break; }
+  }
+  if (!active || !motion) return;
+  [self rememberScreen:active];
+  std::vector<geo::Screen> screens;
+  size_t index = 0;
+  for (NSScreen* screen in NSScreen.screens) {
+    if (screen == active) index = screens.size();
+    screens.push_back({ToRect(screen.frame), ToRect(screen.visibleFrame)});
+  }
+  const auto raw = motion->phase == Phase::Dragging ? motion->rawPosition({pointer.x,pointer.y}) : motion->position;
+  const auto edges = geo::ExteriorEdges(
+      {raw.x, raw.y, motion->size.width, motion->size.height}, screens, index);
+  const NSRect area = active.visibleFrame;
+  const auto fit = geo::Resize({motion->position.x, motion->position.y, motion->size.width, motion->size.height},
+      ToRect(area), _aspect, _preferredWidth > 0 ? _preferredWidth : motion->size.width, _sizeLimits);
+  motion->size = {fit.width, fit.height};
+  motion->settings.margin = std::min({pip_motion::selectedSettings().margin,
+      std::max(0.0, (area.size.width-fit.width)/2), std::max(0.0, (area.size.height-fit.height)/2)});
+  motion->environment({area.origin.x, area.origin.y, area.size.width, area.size.height},
+                      motion->size, {edges.left, edges.right, edges.bottom, edges.top},
+                      pip_motion::Rect{active.frame.origin.x,active.frame.origin.y,active.frame.size.width,active.frame.size.height});
+}
+- (void)mouseDown:(NSEvent*)event {
+  if (_invalidated || _state.blocked || !_pipWindow) return;
+  [self deliver:Action::kInteraction value:0];
+  if (!motion) {
