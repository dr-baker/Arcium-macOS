+- (void)returnToTab:(id)sender {
+  if (_invalidated || _state.blocked || _returning) return;
+  [self stopMotion];
+  if (!_state.HasEffect(Effect::kReturn) || ReduceMotion() || !_openerWindow.visible) {
+    [self deliver:Action::kReturn value:0]; return;
+  }
+  _returning = YES; _returnFrame = _pipWindow.frame;
+  [self refreshChrome];
+  _returnStart = NSProcessInfo.processInfo.systemUptime;
+  const uint64_t generation = _sessionGeneration;
+  __weak ArciumPiPNativeOverlay* weakSelf = self;
+  _returnTimer = [NSTimer timerWithTimeInterval:1.0/120 repeats:YES block:^(NSTimer* timer) {
+    ArciumPiPNativeOverlay* overlay = weakSelf;
+    if (!overlay || overlay->_invalidated || !overlay->_returning ||
+        overlay->_sessionGeneration != generation) { [timer invalidate]; return; }
+    const double u = std::clamp((NSProcessInfo.processInfo.systemUptime - overlay->_returnStart) / .22, 0.0, 1.0);
+    const double ease = 1 - std::pow(1-u, 3);
+    const NSRect original = overlay->_returnFrame;
+    const NSRect home = overlay->_openerWindow.frame;
+    pip_motion::Point delta{NSMidX(home)-NSMidX(original), NSMidY(home)-NSMidY(original)};
+    delta = delta * (std::min(80.0, length(delta)) / std::max(1.0, length(delta)));
+    const double scale = 1 - .16 * ease;
+    [overlay setWindowFrame:NSMakeRect(NSMidX(original)+delta.x*ease-NSWidth(original)*scale/2,
+        NSMidY(original)+delta.y*ease-NSHeight(original)*scale/2,
+        NSWidth(original)*scale, NSHeight(original)*scale) animate:NO];
+    overlay->_pipWindow.alphaValue = 1-ease;
+    if (u >= 1) {
+      [overlay->_returnTimer invalidate]; overlay->_returnTimer = nil;
+      overlay->_pipWindow.alphaValue = 1;
+      [overlay setWindowFrame:overlay->_returnFrame animate:NO];
+      [overlay deliver:Action::kReturn value:0];
+    }
+  }];
