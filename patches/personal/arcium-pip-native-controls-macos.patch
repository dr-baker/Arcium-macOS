+- (instancetype)initWithWindow:(NSWindow*)window
+                      callback:(ActionCallback)callback
+             brightnessSampler:(arcium::pip::BrightnessSampler)sampler {
+  self = [super initWithFrame:window.contentView.bounds];
+  if (!self) {
+    return nil;
+  }
+  _pipWindow = window;
+  _brightnessSampler = std::move(sampler);
+  _buttonBrightness = ContrastSamples{};
+  _lastBrightnessRequest = -1;
+  _originalShadow = window.hasShadow;
+  [self configureEffects];
+  slowSince = -1;
+  hapticKey = pendingKey = -1;
+  _delivery = std::make_shared<Delivery>(Delivery{std::move(callback)});
+  _observers = [NSMutableArray array];
+  _aspect = NSWidth(window.frame) / std::max(1.0, NSHeight(window.frame));
+  _tucked = geo::Side::kNone;
+  self.appearance = [NSAppearance appearanceNamed:NSAppearanceNameDarkAqua];
+  self.accessibilityElement = YES;
+  self.accessibilityRole = NSAccessibilityGroupRole;
+  self.accessibilityLabel = @"Picture in Picture controls";
+  [self buildChrome];
+  [self refreshChrome];
+  __weak ArciumPiPNativeOverlay* weakSelf = self;
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  for (NSNotificationName name in @[
+         NSWindowDidResizeNotification, NSWindowDidMoveNotification,
+         NSWindowWillStartLiveResizeNotification, NSWindowDidEndLiveResizeNotification,
+         NSWindowDidChangeScreenNotification
+       ]) {
+    [_observers addObject:[center addObserverForName:name
+                                              object:window
+                                               queue:NSOperationQueue.mainQueue
+                                          usingBlock:^(NSNotification* note) {
+                                            [weakSelf
+                                                windowGeometryChanged:note];
+                                          }]];
+  }
+  [_observers
+      addObject:[center addObserverForName:
+                            NSApplicationDidChangeScreenParametersNotification
+                                    object:nil
+                                     queue:NSOperationQueue.mainQueue
+                                usingBlock:^(NSNotification* note) {
+                                  [weakSelf screenConfigurationChanged];
+                                }]];
+  [_observers addObject:[center addObserverForName:NSWindowWillCloseNotification
+                                            object:window
+                                             queue:NSOperationQueue.mainQueue
+                                        usingBlock:^(NSNotification* note) {
+                                          [weakSelf invalidate];
+                                        }]];
+  NSNotificationCenter* workspaceCenter =
+      NSWorkspace.sharedWorkspace.notificationCenter;
+  [_observers
+      addObject:
+          [workspaceCenter
+              addObserverForName:
+                  NSWorkspaceAccessibilityDisplayOptionsDidChangeNotification
+                          object:nil
+                           queue:NSOperationQueue.mainQueue
+                      usingBlock:^(NSNotification* note) {
+                        ArciumPiPNativeOverlay* overlay = weakSelf;
+                        if (!overlay || overlay->_invalidated) {
+                          return;
+                        }
+                        [overlay buildChrome];
+                        [overlay refreshChrome];
+                      }]];
+  self.allowedTouchTypes = NSTouchTypeMaskIndirect;
+  _pinchRecognizer = [[NSMagnificationGestureRecognizer alloc]
+      initWithTarget:self action:@selector(recognizePinch:)];
+  _pinchRecognizer.delaysMagnificationEvents = YES;
+  [self addGestureRecognizer:_pinchRecognizer];
+  _eventMonitor = [NSEvent addLocalMonitorForEventsMatchingMask:
+      NSEventMaskScrollWheel | NSEventMaskMagnify | NSEventMaskLeftMouseDown |
+      NSEventMaskRightMouseDown | NSEventMaskOtherMouseDown | NSEventMaskKeyDown |
+      NSEventMaskLeftMouseDragged | NSEventMaskLeftMouseUp | NSEventMaskMouseMoved handler:^NSEvent*(NSEvent* event) {
+    ArciumPiPNativeOverlay* overlay = weakSelf;
+    if (!overlay || ![overlay acceptsGestureInput]) return event;
+    if (event.type == NSEventTypeMouseMoved) {
+      if (overlay->_mouseInside && ![overlay eventOverCard:event]) [overlay mouseExited:event];
+      return event;
+    }
+    // Pointer ownership outlives hidden glyphs and re-hit-tests outside the card.
+    if ([overlay consumeMouseInput:event]) return nil;
+    if (event.type == NSEventTypeLeftMouseDragged || event.type == NSEventTypeLeftMouseUp)
+      return event;
+    if (event.type == NSEventTypeLeftMouseDown || event.type == NSEventTypeRightMouseDown ||
+        event.type == NSEventTypeOtherMouseDown) {
+      if (event.window == overlay->_pipWindow) [overlay pointerInteraction];
+      else if (overlay->_keyboardControlsFocus) [overlay releaseControlsFocus];
+      return event;
+    }
+    if (event.type == NSEventTypeKeyDown) {
+      if (event.window == overlay->_pipWindow) {
+        overlay->_pointerControlsFocus = NO;
+        if ([overlay hasControlsFocus]) overlay->_keyboardControlsFocus = YES;
+        [overlay armHideTimer];
+      }
+      return event;
+    }
+    // The card recognizer owns card magnification; the monitor covers events
+    // addressed to another window while the pointer remains over the card.
+    if (event.type == NSEventTypeMagnify) {
+      if (event.window == overlay->_pipWindow) return event;
+      return [overlay consumeMagnify:event] ? nil : event;
+    }
+    return [overlay consumeScroll:event] ? nil : event;
+  }];
+  _corner = geo::Corner::kBottomRight;
+  return self;
+}
