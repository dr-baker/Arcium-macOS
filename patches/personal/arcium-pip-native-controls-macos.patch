+double ButtonShade(NSButton* button) {
+  for (NSView* view = button; view; view = view.superview) {
+    if ([view isKindOfClass:NSClassFromString(@"ArciumPiPCapsule")])
+      return [NSColor colorWithCGColor:view.layer.backgroundColor].alphaComponent;
+  }
+  return -1;
+}
+ContrastSamples Brightness(double value) {
+  ContrastSamples samples;
+  samples.values.fill(value);
+  return samples;
+}
+TEST_F(ArciumPiPNativeControlsTest, BrightButtonsDimIndependentlyFromDarkButtons) {
+  DestroyControls();
+  std::function<void(ContrastSamples)> complete;
+  ContrastRequest requested;
+  controls_ = std::make_unique<NativeControls>(window_, [](Action, double) {},
+      [&](ContrastRequest request, std::function<void(ContrastSamples)> callback) {
+        requested = request;
+        complete = std::move(callback);
+      });
+  MountControls();
+  ((ArciumPiPTestWindow*)window_).testVisible = YES;
+  [Overlay() mouseMoved:nil];
+  Update();
+  ASSERT_TRUE(complete);
+  for (const auto& region : requested.regions) {
+    EXPECT_GT(region.width, 0);
+    EXPECT_GT(region.height, 0);
+    EXPECT_GE(region.x, 0);
+    EXPECT_GE(region.y, 0);
+    EXPECT_LE(region.x + region.width, 1);
+    EXPECT_LE(region.y + region.height, 1);
+  }
+  auto samples = Brightness(.1);
+  samples.values[static_cast<size_t>(ContrastControl::kPlay)] = .95;
+  samples.values[static_cast<size_t>(ContrastControl::kMute)] = .95;
+  complete(samples);
+  EXPECT_NEAR(ButtonShade(Button(@"Play")), .35, .001);
+  EXPECT_NEAR(ButtonShade(Button(@"Mute")), .35, .001);
+  EXPECT_NEAR(ButtonShade(Button(@"Return to tab")), 0, .001);
+  EXPECT_NEAR(ButtonShade(Button(@"Forward 15 seconds")), 0, .001);
+  EXPECT_TRUE([Button(@"Play").contentTintColor isEqual:NSColor.whiteColor]);
+  [Overlay() applyPinch:.1 ended:NO cancelled:NO];
+  Pump();
+  EXPECT_FALSE(IsPresented(Button(@"Play")));
+  EXPECT_FALSE(IsPresented(Slider()));
+  EXPECT_FALSE(IsPresented([Overlay() valueForKey:@"title"]));
+  [Overlay() mouseMoved:nil];
+  Update();
+  EXPECT_FALSE(IsPresented(Button(@"Back 15 seconds")));
+  [Overlay() applyPinch:0 ended:YES cancelled:NO];
+  Pump();
+  EXPECT_TRUE(IsPresented(Button(@"Play")));
+  ((ArciumPiPTestWindow*)window_).testVisible = NO;
+}
