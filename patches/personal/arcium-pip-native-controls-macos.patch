+
+void VideoOverlayWindowNativeWidgetMac::ApplyWindowPolicy() {
+  auto* window = static_cast<NativeWidgetMacNSWindow*>(
+      GetNativeWindow().GetNativeNSWindow());
+  if (!window) {
+    return;
+  }
+  [window setActivationIndependence:YES];
+  window.hidesOnDeactivate = NO;
+  auto behavior = window.collectionBehavior;
+  behavior &= ~(NSWindowCollectionBehaviorMoveToActiveSpace |
+                NSWindowCollectionBehaviorFullScreenPrimary |
+                NSWindowCollectionBehaviorFullScreenNone |
+                NSWindowCollectionBehaviorPrimary |
+                NSWindowCollectionBehaviorAuxiliary);
+  behavior |= NSWindowCollectionBehaviorCanJoinAllSpaces |
+              NSWindowCollectionBehaviorFullScreenAuxiliary;
+  if (@available(macOS 13.0, *)) {
+    behavior |= NSWindowCollectionBehaviorCanJoinAllApplications;
+  }
+  window.collectionBehavior = behavior;
+}
+
+void VideoOverlayWindowNativeWidgetMac::SaveUserPlacement() {
+  if (!controls_ || !profile_) {
+    return;
+  }
+  auto placement = controls_->TakeUserPlacement();
+  if (!placement) {
+    return;
+  }
+  if (profile_->GetPrefs()->GetDict(arcium::pip::kPlacementPref) !=
+      placement_pref_snapshot_) {
+    return;
+  }
+  base::DictValue value;
+  value.Set("version", 2);
+  value.Set("corner", static_cast<int>(placement->corner));
+  value.Set("width", placement->width);
+  if (placement->has_position) {
+    value.Set("x", placement->x);
+    value.Set("y", placement->y);
+  }
+  placement_pref_snapshot_ = value.Clone();
+  profile_->GetPrefs()->SetDict(arcium::pip::kPlacementPref, std::move(value));
+}
+
+void VideoOverlayWindowNativeWidgetMac::PreparePlacement() {
+  if (!controls_ || !video_) {
+    return;
+  }
+  SaveUserPlacement();
+  arcium::pip::Placement placement;
+  if (profile_) {
+    const auto& value =
+        profile_->GetPrefs()->GetDict(arcium::pip::kPlacementPref);
+    placement_pref_snapshot_ = value.Clone();
+    const int corner = value.FindInt("corner").value_or(-1);
+    const double width = value.FindDouble("width").value_or(0);
+    const int version = value.FindInt("version").value_or(0);
+    if ((version == 1 || version == 2) && corner >= 0 &&
+        corner <= 3 && std::isfinite(width) && width > 0 && width <= 16384) {
+      placement.corner = static_cast<arcium::pip::geometry::Corner>(corner);
+      placement.width = width;
+      const double x = value.FindDouble("x").value_or(-1);
+      const double y = value.FindDouble("y").value_or(-1);
+      if (version == 2 && std::isfinite(x) && std::isfinite(y) &&
+          x >= 0 && x <= 1 && y >= 0 && y <= 1) {
+        placement.has_position = true;
+        placement.x = x; placement.y = y;
+      }
+    }
+  }
+  auto* contents = video_->GetController()->GetWebContents();
+  NSWindow* opener =
+      contents ? contents->GetTopLevelNativeWindow().GetNativeNSWindow() : nil;
+  const auto natural = video_->natural_size_;
+  const double aspect =
+      natural.IsEmpty()
+          ? 16.0 / 9.0
+          : static_cast<double>(natural.width()) / natural.height();
+  controls_->PreparePlacement(placement, opener, aspect,
+                              SizeLimitsFor(video_.get()));
+}
+
+void VideoOverlayWindowNativeWidgetMac::Reanchor() {
+  if (controls_ && video_) {
+    const auto natural = video_->natural_size_;
+    controls_->Reanchor(
+        natural.IsEmpty()
+            ? 16.0 / 9.0
+            : static_cast<double>(natural.width()) / natural.height(),
+        SizeLimitsFor(video_.get()));
+  }
+}
+
+void VideoOverlayWindowNativeWidgetMac::Show(ui::mojom::WindowShowState state,
+                                             const gfx::Rect& restore_bounds) {
+  if (![GetNativeWindow().GetNativeNSWindow() isVisible]) {
+    PreparePlacement();
+  }
+  NativeWidgetMac::Show(state, restore_bounds);
+  ApplyWindowPolicy();
+  if (video_) {
+    video_->RefreshNativeControls();
+  }
+}
+
+void VideoOverlayWindowNativeWidgetMac::OnWindowDestroying(
+    gfx::NativeWindow window) {
+  Observe(nullptr);
+  SaveUserPlacement();
+  effects_pref_registrar_.Reset();
+  profile_observation_.Reset();
+  if (video_) {
+    video_->DetachNativeControlsHost();
+  }
+  weak_factory_.InvalidateWeakPtrs();
+  if (video_) {
+    video_->native_controls_widget_ = nullptr;
+  }
+  controls_.reset();
+  NativeWidgetMac::OnWindowDestroying(window);
+}
+
+gfx::NativeView VideoOverlayWindowNativeWidgetMac::GetNativeControlsView()
+    const {
+  return controls_ ? controls_->GetNativeView() : gfx::NativeView();
+}
+void VideoOverlayWindowNativeWidgetMac::SetNativeControlsAccessibilityParent(
+    gfx::NativeViewAccessible parent) {
+  if (controls_) {
+    controls_->SetAccessibilityParent(parent);
+  }
+}
+void VideoOverlayWindowNativeWidgetMac::FocusNativeControls(bool reverse) {
+  if (controls_) {
+    controls_->FocusControls(reverse);
+  }
+}
+void VideoOverlayWindowNativeWidgetMac::ClearNativeControlsFocus() {
+  if (video_ && video_->native_controls_host_) {
+    auto* focus = video_->GetFocusManager();
+    auto* host = video_->native_controls_host_.get();
+    if (focus && (focus->GetFocusedView() == host ||
+                  focus->GetStoredFocusView() == host)) {
+      focus->SetFocusedView(nullptr);
+      focus->SetStoredFocusView(nullptr);
+    }
+  }
+}
+void VideoOverlayWindowNativeWidgetMac::ReleaseNativeControlsFocus() {
+  ClearNativeControlsFocus();
+  if (controls_)
+    controls_->ReleaseFocus();
+}
+
+bool VideoOverlayWindowNativeWidgetMac::RefreshNativeControls() {
+  if (!controls_ || !video_ || !video_->GetRootView()) {
+    return false;
+  }
+  auto* video = video_.get();
+  arcium::pip::State state;
+  if (profile_) {
+    for (size_t i = 0; i < arcium::pip::kEffectPreferences.size(); ++i)
+      state.effects[i] = profile_->GetPrefs()->GetBoolean(arcium::pip::kEffectPreferences[i].pref);
+  }
+  state.size_limits = SizeLimitsFor(video);
+  state.playing = video->playback_state_for_testing_ ==
+                  content::VideoOverlayWindow::kPlaying;
+  state.can_play =
+      video->show_play_pause_button_ && video->show_playback_controls_;
+  state.duration = video->position_.duration().InSecondsF();
+  state.position = video->position_.GetPosition().InSecondsF();
+  state.playback_rate = video->position_.playback_rate();
+  state.can_seek = !video->is_live_ && video->show_playback_controls_ &&
+                   video->position_.duration() != base::TimeDelta::Max() &&
+                   std::isfinite(state.duration) && state.duration > 0;
+  state.can_mute = video->toggle_mute_button_ != nullptr;
+  state.muted = state.can_mute && video->controller_->GetMuteStatus();
+  // Specialty media actions retain their complete Chromium controls surface.
+  state.blocked =
+      video->IsOverlayViewShown() || video->show_toggle_microphone_button_ ||
+      video->show_toggle_camera_button_ || video->show_hang_up_button_ ||
+      video->show_skip_ad_button_ || video->show_next_track_button_ ||
+      video->show_previous_track_button_ ||
+      video->show_previous_slide_button_ || video->show_next_slide_button_;
+  state.show_controls = video->native_controls_visible_;
+  state.show_title = video->force_title_and_scrim_visible_.value_or(
+      video->initial_title_hide_timer_.IsRunning() ||
+      (!video->IsTrustedForMediaPlayback() && !video->meets_user_interaction_));
+  state.title = video->origin_->GetText();
+  if (auto* contents = web_contents()) {
+    if (!contents->GetTitle().empty())
+      state.title = contents->GetTitle();
+  }
+  state.accent = video->GetColorProvider()->GetColor(ui::kColorSysPrimary);
+  controls_->Update(state);
+  return !state.blocked;
+}
+
+void VideoOverlayWindowNativeWidgetMac::RestorePlacementForHide() {
+  SaveUserPlacement();
+  ReleaseNativeControlsFocus();
+  if (controls_) {
+    controls_->RestorePlacementForHide();
+  }
+}
+
+void VideoOverlayWindowNativeWidgetMac::UseLegacyControlsForTesting() {
+  if (video_) {
+    video_->DetachNativeControlsHost();
+  }
+  controls_.reset();
+  if (video_) {
+    video_->UpdateControlsVisibility(video_->native_controls_visible_, false);
+  }
+}
+
+void VideoOverlayWindowNativeWidgetMac::OnNativeAction(
+    arcium::pip::Action action,
+    double value) {
+  if (!video_ || video_->IsOverlayViewShown()) {
+    return;
+  }
+  auto* video = video_.get();
+  using Action = arcium::pip::Action;
+  if (!video->meets_user_interaction_) {
+    if (video->initial_title_hide_timer_.IsRunning()) {
+      video->user_interacted_before_timer_fired_ = true;
+    } else {
+      video->meets_user_interaction_ = true;
+      video->UpdateControlsVisibility(video->native_controls_visible_, false);
+    }
+  }
+  switch (action) {
+    case Action::kInteraction:
+      break;
+    case Action::kReturn:
+      PictureInPictureWindowManager::GetInstance()
+          ->ExitPictureInPictureViaWindowUi(
+              PictureInPictureWindowManager::UiBehavior::
+                  kCloseWindowAndFocusOpener);
+      return;
+    case Action::kClose:
+      video->CloseAndPauseIfAvailable();
+      return;
+    case Action::kPlayPause:
+      if (video->show_play_pause_button_) {
+        video->TogglePlayPause();
+      }
+      break;
+    case Action::kBack15:
+      if (!video->is_live_) {
+        video->Replay15Seconds();
+      }
+      break;
+    case Action::kForward15:
+      if (!video->is_live_) {
+        video->Forward15Seconds();
+      }
+      break;
+    case Action::kPlacementChanged:
+      SaveUserPlacement();
+      break;
+    case Action::kMute:
+      video->controller_->RequestMute(!video->controller_->GetMuteStatus());
+      break;
+    case Action::kSeek:
+      if (std::isfinite(value) && !video->is_live_ &&
+          video->position_.duration() > base::TimeDelta() &&
+          video->position_.duration() != base::TimeDelta::Max()) {
+        video->controller_->SeekTo(video->position_.duration() *
+                                   std::clamp(value, 0.0, 1.0));
+      }
+      break;
+  }
+  if (video_) {
+    video_->RefreshNativeControls();
+  }
+}
