+- (void)applyState:(const State&)state {
+  if (_invalidated) {
+    return;
+  }
+  if (state.blocked) {
+    [self stopMotion];
+    [self releaseControlsFocus];
+  }
+  if (state.blocked && _tucked != geo::Side::kNone) {
+    [self restore:nil];
+  }
+  if ((state.blocked || !state.can_seek) && _seeking) {
+    [self endSeek];
+  }
+  if (!_hasSnapshot) {
+    _nativeVisible = state.show_controls;
+  } else if (state.show_controls && !_state.show_controls && !_mouseInside) {
+    _nativeVisible = YES;
+  }
+  const bool limits_changed = !(_sizeLimits == state.size_limits);
+  _sizeLimits = state.size_limits;
+  _state = state;
+  if (!std::isfinite(_state.position)) {
+    _state.position = 0;
+  }
+  if (!std::isfinite(_state.duration) || _state.duration <= 0) {
+    _state.can_seek = false;
+  }
+  if (!std::isfinite(_state.playback_rate)) {
+    _state.playback_rate = 0;
+  }
+  _snapshotTime = NSProcessInfo.processInfo.systemUptime;
+  _hasSnapshot = YES;
+  if (limits_changed && _placementReady && _pipWindow.visible &&
+      !_state.blocked && !_dragging && !_resizing && !_scrolling &&
+      !_magnifying) {
+    [self reanchor:_aspect limits:_sizeLimits];
+  }
+  [self refreshChrome];
+  if ([self hasControlsFocus]) {
+    [self layoutSubtreeIfNeeded];
+    NSView* focused = (NSView*)_pipWindow.firstResponder;
+    if (focused.hiddenOrHasHiddenAncestor ||
+        ([focused isKindOfClass:NSControl.class] &&
+         !((NSControl*)focused).enabled)) {
+      [self focusControls:NO];
+    }
+  }
+}
+
+- (double)currentPosition {
+  double time = _state.position;
+  if (_state.playing && !_seeking) {
+    time += (NSProcessInfo.processInfo.systemUptime - _snapshotTime) *
+            _state.playback_rate;
+  }
+  return std::clamp(time, 0.0, std::max(0.0, _state.duration));
+}
+- (void)updateProgress {
+  if (_seeking) {
+    return;
+  }
+  double position = [self currentPosition];
+  _slider.doubleValue = _state.duration > 0 ? position / _state.duration : 0;
+  _timestamp.stringValue =
+      [NSString stringWithFormat:@"%@ / %@", TimeLabel(position),
+                                 TimeLabel(_state.duration)];
+  _slider.accessibilityValueDescription =
+      [NSString stringWithFormat:@"%@ of %@", TimeLabel(position),
+                                 TimeLabel(_state.duration)];
+}
+- (void)refreshChrome {
+  if (_invalidated) {
+    return;
+  }
+  const BOOL visible =
+      _nativeVisible && !_state.blocked && _tucked == geo::Side::kNone;
+  _glassContainer.hidden = _state.blocked;
+  const BOOL animate = !_state.blocked && _tucked == geo::Side::kNone;
+  for (NSView* view in @[ _returnGlass, _tuckGlass, _closeGlass ]) {
+    Present(view, visible, animate);
+  }
+  _restoreGlass.hidden = _state.blocked || _tucked == geo::Side::kNone;
+  Present(_slider, visible && _state.can_seek, animate);
+  Present(_timestamp, visible && _state.can_seek, animate);
+  Present(_title,
+          !_state.blocked && _tucked == geo::Side::kNone &&
+              (visible || _state.show_title) && !_state.title.empty(),
+          animate);
+  Present(_resizeView, visible, animate);
+  Present(_playGlass, visible && _state.can_play, animate);
+  Present(_muteGlass, visible && _state.can_mute, animate);
+  _playButton.image = Symbol(_state.playing ? @"pause.fill" : @"play.fill", 20);
+  _playButton.accessibilityLabel = _state.playing ? @"Pause" : @"Play";
+  _playButton.cell.accessibilityLabel = _playButton.accessibilityLabel;
+  _playButton.toolTip = _playButton.accessibilityLabel;
+  _muteButton.image =
+      Symbol(_state.muted ? @"speaker.slash.fill" : @"speaker.wave.2.fill", 13);
+  _muteButton.accessibilityLabel = _state.muted ? @"Unmute" : @"Mute";
+  _muteButton.cell.accessibilityLabel = _muteButton.accessibilityLabel;
+  _muteButton.toolTip = _muteButton.accessibilityLabel;
+  _title.stringValue = [[NSString alloc]
+      initWithCharacters:reinterpret_cast<const unichar*>(_state.title.data())
+                  length:_state.title.size()];
+  _slider.enabled = _state.can_seek;
+  ((ArciumPiPSliderCell*)_slider.cell).accent = Accent(_state.accent);
+  _restoreButton.image =
+      Symbol(_tucked == geo::Side::kLeft ? @"chevron.right" : @"chevron.left");
+  [self updateProgress];
+  BOOL tick = visible && _state.playing && _state.can_seek && !_seeking &&
+              self.window.visible;
+  if (!tick) {
+    [_progressTimer invalidate];
+    _progressTimer = nil;
+  } else if (!_progressTimer) {
+    __weak ArciumPiPNativeOverlay* weakSelf = self;
+    _progressTimer = [NSTimer
+        scheduledTimerWithTimeInterval:0.1
+                               repeats:YES
+                                 block:^(NSTimer* timer) {
+                                   ArciumPiPNativeOverlay* overlay = weakSelf;
+                                   if (!overlay || !overlay.window.visible) {
+                                     [timer invalidate];
+                                     if (overlay) {
+                                       overlay->_progressTimer = nil;
+                                     }
+                                     return;
+                                   }
+                                   [overlay updateProgress];
+                                 }];
+    _progressTimer.tolerance = 0.03;
+  }
+  [self setNeedsLayout:YES];
+}
