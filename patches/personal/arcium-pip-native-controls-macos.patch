+  const double width = motion->size.width;
+  NSScreen* screen = [self anchorScreen];
+  const auto fit = geo::Resize({motion->position.x, motion->position.y, width, motion->size.height},
+      ToRect(screen.visibleFrame), _aspect, width, _sizeLimits);
+  const pip_motion::Point center{motion->position.x + width / 2,
+                                 motion->position.y + motion->size.height / 2};
