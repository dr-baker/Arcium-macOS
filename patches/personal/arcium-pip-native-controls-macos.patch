+void VideoOverlayWindowNativeWidgetMac::InitNativeWidget(
+    views::Widget::InitParams params) {
+  NativeWidgetMac::InitNativeWidget(std::move(params));
+  NSWindow* window = GetNativeWindow().GetNativeNSWindow();
+  if (!window || !GetInProcessNSWindowBridge()) {
+    return;
+  }
+  ApplyWindowPolicy();
+  if (auto* contents = video_->GetController()->GetWebContents()) {
+    profile_ = Profile::FromBrowserContext(contents->GetBrowserContext())
+                   ->GetWeakPtr();
+  }
+  controls_ = std::make_unique<arcium::pip::NativeControls>(
+      window, [weak = weak_factory_.GetWeakPtr()](arcium::pip::Action action,
+                                                  double value) {
+        if (weak) {
+          weak->OnNativeAction(action, value);
+        }
+      });
+  controls_->SetBeforeFocusRelease([weak = weak_factory_.GetWeakPtr()] {
+    if (weak)
