+  NSScreen* screen = [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  [self rememberScreen:screen];
+  const auto frame = geo::Resize(
+      ToRect(_pipWindow.frame), ToRect(screen.visibleFrame), _aspect,
+      _preferredWidth > 0 ? _preferredWidth : NSWidth(_pipWindow.frame),
+      _sizeLimits);
+  [self setWindowFrame:ToNSRect(_hasPosition ?
+      geo::AtFraction(frame, ToRect(screen.visibleFrame), _positionFraction.x, _positionFraction.y) :
+      geo::Anchor(frame, ToRect(screen.visibleFrame), _corner)) animate:NO];
+}
+- (std::optional<Placement>)takeUserPlacement {
+  return std::exchange(_userPlacement, std::nullopt);
+}
+- (void)snap {
+  NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  [self rememberScreen:screen];
+  _corner =
+      geo::NearestCorner(ToRect(_pipWindow.frame), ToRect(screen.visibleFrame));
+  NSRect frame = ToNSRect(geo::Anchor(ToRect(_pipWindow.frame),
+                                      ToRect(screen.visibleFrame), _corner));
+  [self setWindowFrame:frame animate:YES];
+  _restoreFrame = frame;
+  _hasPosition = NO;
+  _userPlacement = Placement{
+      _corner, _preferredWidth > 0 ? _preferredWidth : NSWidth(frame)};
+  [self deliver:Action::kPlacementChanged value:0];
+}
+- (void)tuckToSide:(geo::Side)side {
+  [self stopMotion];
+  if (_state.blocked || !_pipWindow) {
+    return;
+  }
+  NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  _restoreDisplay = screen.deviceDescription[@"NSScreenNumber"];
+  _restoreFrame = ToNSRect(
+      geo::Fit(ToRect(_pipWindow.frame), ToRect(screen.visibleFrame)));
+  _corner =
+      geo::NearestCorner(ToRect(_restoreFrame), ToRect(screen.visibleFrame));
+  [self rememberScreen:screen];
+  _tucked = side;
+  _nativeVisible = NO;
+  [self refreshChrome];
+  [self placeTuckedWindowAnimated:YES];
+}
+- (void)placeTuckedWindowAnimated:(BOOL)animate {
+  NSArray<NSScreen*>* screens = NSScreen.screens;
+  std::vector<geo::Screen> layout;
+  size_t preferred = 0;
+  for (NSScreen* screen in screens) {
+    if ([screen.deviceDescription[@"NSScreenNumber"] isEqual:_anchorDisplay]) {
+      preferred = layout.size();
+    }
+    layout.push_back({ToRect(screen.frame), ToRect(screen.visibleFrame)});
+  }
+  auto placement = geo::ExteriorTuck(ToRect(_restoreFrame), layout, preferred,
+                                      _tucked);
+  if (!placement) {
+    [self restore:nil];
+    return;
+  }
+  [self rememberScreen:screens[placement->screen]];
+  [self setWindowFrame:ToNSRect(placement->frame) animate:animate];
+}
+- (void)restore:(id)sender {
+  [self stopMotion];
+  if (_state.blocked || _tucked == geo::Side::kNone) {
+    return;
+  }
+  NSScreen* screen = [self anchorScreen];
+  for (NSScreen* candidate in NSScreen.screens) {
+    if ([candidate.deviceDescription[@"NSScreenNumber"]
+            isEqual:_restoreDisplay]) {
+      screen = candidate;
+    }
+  }
+  [self rememberScreen:screen];
+  _tucked = geo::Side::kNone;
+  if (screen) {
+    auto frame = geo::Resize(
+        ToRect(_restoreFrame), ToRect(screen.visibleFrame), _aspect,
+        _preferredWidth > 0 ? _preferredWidth : NSWidth(_restoreFrame),
+        _sizeLimits);
+    if (_placementReady && !_hasPosition) frame = geo::Anchor(frame, ToRect(screen.visibleFrame), _corner);
+    [self setWindowFrame:ToNSRect(frame) animate:YES];
+  }
+  _nativeVisible = YES;
+  [self refreshChrome];
+  [self armHideTimer];
+}
+- (void)tuck:(id)sender {
+  if (_state.blocked) {
+    return;
+  }
+  NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  [self tuckToSide:NSMidX(_pipWindow.frame) < NSMidX(screen.frame)
+                       ? geo::Side::kLeft
+                       : geo::Side::kRight];
+}
+- (void)windowGeometryChanged:(NSNotification*)note {
+  if (_invalidated) {
+    return;
+  }
+  [self setNeedsLayout:YES];
+  if (_adjusting || _dragging || _motionTimer || _scrolling || _resizing) {
+    return;
+  }
+  if (!_placementReady) {
+    _aspect =
+        NSWidth(_pipWindow.frame) / std::max(1.0, NSHeight(_pipWindow.frame));
+  }
+  if (_tucked != geo::Side::kNone) {
+    _restoreFrame.size = _pipWindow.frame.size;
+    [self screenConfigurationChanged];
+    return;
+  }
+  if (_pipWindow.screen) {
+    [self rememberScreen:_pipWindow.screen];
+  }
+}
+- (void)screenConfigurationChanged {
+  [self stopMotion];
+  if (_invalidated || !_pipWindow) {
+    return;
+  }
+  NSScreen* screen = [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  [self rememberScreen:screen];
+  if (_tucked == geo::Side::kNone) {
+    [self reanchor:_aspect limits:_sizeLimits];
+  } else {
+    NSScreen* restoreScreen = screen;
+    for (NSScreen* candidate in NSScreen.screens) {
+      if ([candidate.deviceDescription[@"NSScreenNumber"]
+              isEqual:_restoreDisplay]) {
+        restoreScreen = candidate;
+      }
+    }
+    _restoreFrame = ToNSRect(geo::Fit(ToRect(_restoreFrame), ToRect(restoreScreen.visibleFrame)));
+    [self placeTuckedWindowAnimated:NO];
+  }
+}
+
+- (BOOL)consumeScroll:(NSEvent*)event {
+  if (_invalidated || _state.blocked || _seeking ||
+      !event.hasPreciseScrollingDeltas) {
+    return NO;
+  }
+  if (event.momentumPhase != NSEventPhaseNone) {
+    BOOL consume = _consumeMomentum;
+    if (event.momentumPhase & (NSEventPhaseEnded | NSEventPhaseCancelled)) {
+      _consumeMomentum = NO;
+    }
+    return consume;
+  }
+  if (event.phase == NSEventPhaseNone) {
+    return NO;
+  }
+  if (_tucked != geo::Side::kNone) {
+    if (event.phase & NSEventPhaseBegan) {
+      _gestureX = 0;
+      _consumeMomentum = YES;
+    }
+    _gestureX += event.scrollingDeltaX;
+    if ((event.phase & NSEventPhaseEnded) &&
+        ((_tucked == geo::Side::kLeft && _gestureX > 30) ||
+         (_tucked == geo::Side::kRight && _gestureX < -30))) {
+      [self restore:nil];
+    }
+    return YES;
+  }
+  if (event.phase & NSEventPhaseBegan) {
+    [self stopMotion];
+    NSPoint point = [self.superview convertPoint:event.locationInWindow
+                                        fromView:nil];
+    if ([self hitTest:point] != self) {
+      return NO;
+    }
+    [self deliver:Action::kInteraction value:0];
+    _scrolling = YES;
+    _gestureAxis = GestureAxis::kPending;
+    _consumeMomentum = YES;
+    [self rememberScreen:_pipWindow.screen ?: [self anchorScreen]];
+    _gestureStartFrame = _pipWindow.frame;
+    _gestureX = _gestureY = 0;
+    _nativeVisible = NO;
+    [self refreshChrome];
+  }
+  if (!_scrolling) {
+    return NO;
+  }
+  _gestureX += event.scrollingDeltaX;
+  _gestureY += event.scrollingDeltaY;
+  if (_gestureAxis == GestureAxis::kPending &&
+      std::max(std::abs(_gestureX), std::abs(_gestureY)) >= 8) {
+    _gestureAxis = std::abs(_gestureX) >= std::abs(_gestureY)
+                       ? GestureAxis::kHorizontal
+                       : GestureAxis::kVertical;
+  }
+  if (event.phase & NSEventPhaseChanged) {
+    NSRect frame =
+        NSOffsetRect(_gestureStartFrame,
+                     _gestureAxis == GestureAxis::kHorizontal ? _gestureX : 0,
+                     _gestureAxis == GestureAxis::kVertical ? _gestureY : 0);
+    [self setWindowFrame:frame animate:NO];
+  }
+  if (event.phase & (NSEventPhaseEnded | NSEventPhaseCancelled)) {
+    _scrolling = NO;
+    if (event.phase & NSEventPhaseCancelled) {
+      [self setWindowFrame:_gestureStartFrame animate:YES];
+      _nativeVisible = YES;
+      [self refreshChrome];
+      [self armHideTimer];
+      return YES;
+    }
+    if (!(event.phase & NSEventPhaseCancelled)) {
+      if (_gestureAxis == GestureAxis::kVertical && _gestureY < -90 &&
+          std::abs(_gestureY) > std::abs(_gestureX) * 1.4) {
+        [self deliver:Action::kClose value:0];
+        return YES;
+      }
+      NSScreen* screen = [self anchorScreen];
+      BOOL leftHalf = NSMidX(_gestureStartFrame) < NSMidX(screen.frame);
+      BOOL outward =
+          (leftHalf && _gestureX < -70) || (!leftHalf && _gestureX > 70);
+      if (_gestureAxis == GestureAxis::kHorizontal && outward &&
+          std::abs(_gestureX) > std::abs(_gestureY) * 1.3) {
+        [self setWindowFrame:_gestureStartFrame animate:NO];
+        [self tuckToSide:_gestureX < 0 ? geo::Side::kLeft : geo::Side::kRight];
+        return YES;
+      }
+    }
+    [self rememberPlacement];
+    _nativeVisible = YES;
+    [self refreshChrome];
+    [self armHideTimer];
+  }
+  return YES;
+}
+- (void)resizeEvent:(NSEvent*)event phase:(NSInteger)phase {
+  if (_state.blocked || _tucked != geo::Side::kNone) {
+    return;
+  }
+  if (phase == 0) {
+    [self stopMotion];
+    _resizing = YES;
+    _resizeStartFrame = _pipWindow.frame;
+    _resizeStartMouse = NSEvent.mouseLocation;
+  } else if (phase == 1 && _resizing) {
+    NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+    if (!screen) {
+      return;
+    }
+    NSPoint mouse = NSEvent.mouseLocation;
+    double dx = mouse.x - _resizeStartMouse.x;
+    double dy = _resizeStartMouse.y - mouse.y;
+    double width = NSWidth(_resizeStartFrame) + (dx + dy * _aspect) * 0.5;
+    [self setWindowFrame:ToNSRect(geo::Resize(ToRect(_resizeStartFrame),
+                                              ToRect(screen.visibleFrame),
+                                              _aspect, width, _sizeLimits))
+                 animate:NO];
+  } else if (phase == 2 && _resizing) {
+    _resizing = NO;
+    _preferredWidth = NSWidth(_pipWindow.frame);
+    [self rememberPlacement];
+  }
+}
+- (void)magnifyWithEvent:(NSEvent*)event {
+  if (_state.blocked || _tucked != geo::Side::kNone) {
+    return;
+  }
+  if (!_magnifying || (event.phase & NSEventPhaseBegan)) {
+    [self stopMotion];
+    _magnifying = YES;
+    _magnifyStartFrame = _pipWindow.frame;
+  }
+  if (event.phase & NSEventPhaseCancelled) {
+    _magnifying = NO;
+    [self setWindowFrame:_magnifyStartFrame animate:NO];
+    return;
+  }
+  NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  [self
+      setWindowFrame:ToNSRect(geo::Resize(
+                         ToRect(_pipWindow.frame), ToRect(screen.visibleFrame),
+                         _aspect,
+                         NSWidth(_pipWindow.frame) * (1 + event.magnification),
+                         _sizeLimits))
+             animate:NO];
+  if (event.phase & NSEventPhaseEnded) {
+    _magnifying = NO;
+    _preferredWidth = NSWidth(_pipWindow.frame);
+    [self rememberPlacement];
+  }
+}
+
+- (void)beginSeek {
+  if (_state.blocked || !_state.can_seek) {
+    return;
+  }
+  _seeking = YES;
+  [_hideTimer invalidate];
+  [self refreshChrome];
+  [self deliver:Action::kInteraction value:0];
+}
+- (void)endSeek {
+  if (!_seeking) {
+    return;
+  }
+  _seeking = NO;
+  [self refreshChrome];
+  [self armHideTimer];
+}
+- (void)seek:(id)sender {
+  if (sender != _slider || _state.blocked || !_state.can_seek) {
+    return;
+  }
+  double fraction = std::clamp(_slider.doubleValue, 0.0, 1.0);
+  [self deliver:Action::kSeek value:fraction];
+  _timestamp.stringValue = [NSString
+      stringWithFormat:@"%@ / %@", TimeLabel(fraction * _state.duration),
+                       TimeLabel(_state.duration)];
+  [self armHideTimer];
+}
+- (void)playPause:(id)sender {
+  if (!_state.blocked && _state.can_play) {
+    [self deliver:Action::kPlayPause value:0];
+  }
+}
+- (void)back:(id)sender {
+  if (!_state.blocked && _state.can_seek) {
+    [self deliver:Action::kBack15 value:0];
+  }
+}
+- (void)forward:(id)sender {
+  if (!_state.blocked && _state.can_seek) {
+    [self deliver:Action::kForward15 value:0];
+  }
+}
+- (void)returnToTab:(id)sender {
+  if (!_state.blocked) {
+    [self deliver:Action::kReturn value:0];
+  }
+}
+- (void)close:(id)sender {
+  if (!_state.blocked) {
+    [self deliver:Action::kClose value:0];
+  }
+}
+- (void)mute:(id)sender {
+  if (!_state.blocked && _state.can_mute) {
+    [self deliver:Action::kMute value:_state.muted ? 0 : 1];
+  }
+}
+
+- (id)accessibilityParent {
+  return _axParent ?: [super accessibilityParent];
+}
+- (void)setAccessibilityParent:(id)parent {
+  _axParent = parent;
+}
+
+- (BOOL)hasControlsFocus {
+  NSResponder* responder = _pipWindow.firstResponder;
+  return [responder isKindOfClass:NSView.class] &&
+         [(NSView*)responder isDescendantOf:self];
+}
+- (NSArray<NSView*>*)focusableControls {
+  NSMutableArray<NSView*>* result = [NSMutableArray array];
+  for (NSControl* control in @[
+         _returnButton, _tuckButton, _closeButton, _backButton, _playButton,
+         _forwardButton, _muteButton, _slider, _restoreButton
+       ]) {
+    if (!control.hiddenOrHasHiddenAncestor && control.enabled) {
+      [result addObject:control];
+    }
+  }
+  return result;
+}
+- (void)updateKeyLoop {
+  NSArray<NSView*>* controls = [self focusableControls];
+  for (NSUInteger i = 0; i < controls.count; ++i) {
+    controls[i].nextKeyView = controls[(i + 1) % controls.count];
+  }
+}
+- (void)focusControls:(BOOL)reverse {
+  if (_invalidated || _state.blocked || _releasingFocus) {
+    return;
+  }
+  _nativeVisible = YES;
+  [self refreshChrome];
+  [self layoutSubtreeIfNeeded];
+  NSArray<NSView*>* controls = [self focusableControls];
+  if (controls.count) {
+    [_pipWindow makeFirstResponder:reverse ? controls.lastObject
+                                           : controls.firstObject];
+  }
+  [_hideTimer invalidate];
+  _hideTimer = nil;
+}
+- (void)setBeforeFocusRelease:(std::function<void()>)callback {
+  _beforeFocusRelease = std::move(callback);
+}
+- (void)releaseControlsFocus {
+  if (_releasingFocus || ![self hasControlsFocus])
+    return;
+  __attribute__((objc_precise_lifetime)) ArciumPiPNativeOverlay* keepAlive =
+      self;
+  (void)keepAlive;
+  _releasingFocus = YES;
+  auto beforeRelease = _beforeFocusRelease;
+  if (beforeRelease)
+    beforeRelease();
+  if (!_invalidated && [self hasControlsFocus]) {
+    [_pipWindow makeFirstResponder:_pipWindow.contentView];
+    [self armHideTimer];
+  }
+  _releasingFocus = NO;
+}
+
+- (void)prepareForHide {
+  if (_invalidated) {
+    return;
+  }
+  [self stopMotion];
+  ++_sessionGeneration;
+  // A media session can reuse this hidden window. Drop queued input from the
+  // previous session without changing playback or destroying the native host.
+  ActionCallback callback = _delivery ? _delivery->callback : ActionCallback{};
+  _delivery = std::make_shared<Delivery>(Delivery{std::move(callback)});
+  const BOOL wasTucked = _tucked != geo::Side::kNone;
+  NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+  if (wasTucked) {
+    for (NSScreen* candidate in NSScreen.screens) {
+      if ([candidate.deviceDescription[@"NSScreenNumber"]
+              isEqual:_restoreDisplay]) {
+        screen = candidate;
+      }
+    }
+  }
+  NSRect frame = wasTucked
+                     ? _restoreFrame
+                     : (_magnifying ? _magnifyStartFrame : _pipWindow.frame);
+  _tucked = geo::Side::kNone;
+  _nativeVisible = NO;
+  _hasSnapshot = NO;
+  _placementReady = NO;
+  _mouseInside = NO;
+  _dragging = _resizing = _scrolling = _seeking = _magnifying = NO;
+  _consumeMomentum = NO;
+  _gestureAxis = GestureAxis::kPending;
+  [_hideTimer invalidate];
+  _hideTimer = nil;
+  [_progressTimer invalidate];
+  _progressTimer = nil;
+  if (screen) {
+    [self rememberScreen:screen];
+    [self setWindowFrame:ToNSRect(geo::Fit(ToRect(frame),
+                                             ToRect(screen.visibleFrame)))
+                 animate:NO];
+  }
+  [self refreshChrome];
+}
+
+- (void)invalidate {
+  if (_invalidated) {
+    return;
+  }
+  [self releaseControlsFocus];
+  _axParent = nil;
+  _beforeFocusRelease = nullptr;
+  [self stopMotion];
+  _invalidated = YES;
+  if (_delivery) {
+    _delivery->callback = nullptr;
+  }
+  _delivery.reset();
+  [_progressTimer invalidate];
+  _progressTimer = nil;
+  [_hideTimer invalidate];
+  _hideTimer = nil;
+  if (_eventMonitor) {
+    [NSEvent removeMonitor:_eventMonitor];
+    _eventMonitor = nil;
+  }
+  for (id observer in _observers) {
+    [NSNotificationCenter.defaultCenter removeObserver:observer];
+    [NSWorkspace.sharedWorkspace.notificationCenter removeObserver:observer];
+  }
+  [_observers removeAllObjects];
+  _slider.beginDrag = nil;
+  _slider.endDrag = nil;
+  _resizeView.resizeEvent = nil;
+  ((ArciumPiPButton*)_restoreButton).dragEvent = nil;
+}
+@end
+
+namespace arcium::pip {
+struct NativeControls::Impl {
+  __strong ArciumPiPNativeOverlay* view;
+};
+NativeControls::NativeControls(NSWindow* window, ActionCallback callback)
+    : impl_(std::make_unique<Impl>()) {
+  NSCAssert(NSThread.isMainThread,
+            @"PiP controls must be created on the main thread");
+  impl_->view =
+      [[ArciumPiPNativeOverlay alloc] initWithWindow:window
+                                            callback:std::move(callback)];
+}
+NativeControls::~NativeControls() {
+  NSCAssert(NSThread.isMainThread,
+            @"PiP controls must be destroyed on the main thread");
+  [impl_->view invalidate];
+}
+gfx::NativeView NativeControls::GetNativeView() const {
+  return gfx::NativeView(impl_->view);
+}
+void NativeControls::SetAccessibilityParent(gfx::NativeViewAccessible parent) {
+  impl_->view.accessibilityParent =
+      parent.Get() ? NSAccessibilityUnignoredAncestor(parent.Get()) : nil;
+}
+void NativeControls::FocusControls(bool reverse) {
+  [impl_->view focusControls:reverse];
+}
+void NativeControls::SetBeforeFocusRelease(std::function<void()> callback) {
+  [impl_->view setBeforeFocusRelease:std::move(callback)];
+}
+void NativeControls::ReleaseFocus() {
+  [impl_->view releaseControlsFocus];
+}
+void NativeControls::Update(const State& state) {
+  [impl_->view applyState:state];
+}
+void NativeControls::PreparePlacement(const Placement& placement,
+                                      NSWindow* opener,
+                                      double aspect,
+                                      geometry::SizeLimits limits) {
+  [impl_->view preparePlacement:placement
+                         opener:opener
+                         aspect:aspect
+                         limits:limits];
+}
+void NativeControls::Reanchor(double aspect, geometry::SizeLimits limits) {
+  [impl_->view reanchor:aspect limits:limits];
+}
+std::optional<Placement> NativeControls::TakeUserPlacement() {
+  return [impl_->view takeUserPlacement];
+}
+void NativeControls::RestorePlacementForHide() {
+  [impl_->view prepareForHide];
+}
+}  // namespace arcium::pip
