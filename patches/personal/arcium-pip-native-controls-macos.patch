+      {area.x, area.y, area.width, area.height}, motion->settings.margin);
+  const auto integral = geo::CenteredIntegralResize(ToRect(_magnifyStartFrame),
+      {motion->position.x, motion->position.y, motion->size.width, motion->size.height},
+      integralArea, _sizeLimits);
