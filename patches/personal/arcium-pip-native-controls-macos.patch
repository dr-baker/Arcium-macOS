+#ifndef CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_CONTRAST_H_
+#define CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_CONTRAST_H_
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <span>
+
+#include "arcium_pip_geometry.h"
+
+namespace arcium::pip {
+enum class ContrastControl { kReturn, kTuck, kClose, kPlay, kBack, kForward, kMute, kCount };
+inline constexpr size_t kContrastRegionCount = static_cast<size_t>(ContrastControl::kCount);
+inline constexpr int kContrastWidth = 96;
+inline constexpr int kContrastHeight = 54;
+// Top-left normalized coordinates in the complete PiP content, including bars.
+struct ContrastRegion {
+  double x = 0, y = 0, width = 0, height = 0;
+  bool operator==(const ContrastRegion&) const = default;
+};
+struct ContrastRequest {
+  std::array<ContrastRegion, kContrastRegionCount> regions{};
+  bool operator==(const ContrastRequest&) const = default;
+};
+struct ContrastSamples {
+  std::array<double, kContrastRegionCount> values;
+  ContrastSamples() { values.fill(-1); }
+};
+inline ContrastRegion NormalizeContrastRegion(geometry::Rect frame, geometry::Rect bounds) {
+  if (bounds.width <= 0 || bounds.height <= 0) return {};
+  return {(frame.x - bounds.x) / bounds.width,
+          (bounds.y + bounds.height - frame.y - frame.height) / bounds.height,
+          frame.width / bounds.width, frame.height / bounds.height};
+}
+// The bitmap contains video alone. Samples outside its actual letterboxed
+// rectangle contribute black, matching the PiP window's background.
+inline ContrastSamples MeasureButtonContrast(const ContrastRequest& request,
+    ContrastRegion video, std::span<const float> pixels) {
+  ContrastSamples result;
+  if (pixels.size() != kContrastWidth * kContrastHeight ||
+      !std::isfinite(video.x) || !std::isfinite(video.y) ||
+      !std::isfinite(video.width) || !std::isfinite(video.height) ||
+      video.width <= 0 || video.height <= 0) return result;
+  auto at = [&](double x, double y) {
+    const double sx = std::clamp((x - video.x) / video.width * kContrastWidth - .5,
+                                 0.0, double(kContrastWidth - 1));
+    const double sy = std::clamp((y - video.y) / video.height * kContrastHeight - .5,
+                                 0.0, double(kContrastHeight - 1));
+    const int x0 = static_cast<int>(sx), y0 = static_cast<int>(sy);
+    const int x1 = std::min(x0 + 1, kContrastWidth - 1);
+    const int y1 = std::min(y0 + 1, kContrastHeight - 1);
+    const double a = std::lerp(pixels[y0 * kContrastWidth + x0], pixels[y0 * kContrastWidth + x1], sx - x0);
+    const double b = std::lerp(pixels[y1 * kContrastWidth + x0], pixels[y1 * kContrastWidth + x1], sx - x0);
+    return std::lerp(a, b, sy - y0);
+  };
+  for (size_t i = 0; i < request.regions.size(); ++i) {
+    const auto& region = request.regions[i];
+    if (!std::isfinite(region.x) || !std::isfinite(region.y) ||
+        !std::isfinite(region.width) || !std::isfinite(region.height) ||
+        region.width <= 0 || region.height <= 0) continue;
+    double sum = 0;
+    int count = 0;
+    // Average inside the round button footprint, not its square corners.
+    for (int y = 0; y < 8; ++y) for (int x = 0; x < 8; ++x) {
+      const double u = (x + .5) / 8, v = (y + .5) / 8;
+      if (std::pow(2 * u - 1, 2) + std::pow(2 * v - 1, 2) > 1) continue;
+      const double px = region.x + u * region.width;
+      const double py = region.y + v * region.height;
+      ++count;
+      if (px >= video.x && px < video.x + video.width &&
+          py >= video.y && py < video.y + video.height)
+        sum += at(px, py);
+    }
+    result.values[i] = count ? std::clamp(sum / count, 0.0, 1.0) : -1;
+  }
+  return result;
+}
+}  // namespace arcium::pip
+#endif
