+TEST_F(ArciumPiPNativeControlsTest, EffectsTuckAndRestoreIgnoreDeferredAppKitAnimation) {
+  const NSRect original = window_.frame;
+  NSScreen* screen = window_.screen ?: NSScreen.mainScreen;
+  ASSERT_TRUE(screen);
+  const bool left = NSMidX(original) < NSMidX(screen.frame);
+  std::vector<geometry::Screen> layout;
+  size_t preferred = 0;
+  for (NSScreen* candidate in NSScreen.screens) {
+    if (candidate == screen) preferred = layout.size();
+    const NSRect frame = candidate.frame, area = candidate.visibleFrame;
+    layout.push_back({{frame.origin.x, frame.origin.y, frame.size.width, frame.size.height},
+                      {area.origin.x, area.origin.y, area.size.width, area.size.height}});
+  }
+  const auto expected = geometry::ExteriorTuck(
+      {original.origin.x, original.origin.y, original.size.width, original.size.height},
+      layout, preferred, left ? geometry::Side::kLeft : geometry::Side::kRight);
+  ASSERT_TRUE(expected);
+  state_.effects[static_cast<size_t>(Effect::kEdgeShade)] = true;
+  Update();
+  // Live AppKit animation initially reports the old frame. Hidden windows
+  // normally jump to the final frame and would conceal competing writers.
+  [(ArciumPiPTestWindow*)window_ setDeferAnimatedFrames:YES];
+  [Button(@"Tuck to screen edge") performClick:nil];
+  double now = NSProcessInfo.processInfo.systemUptime;
+  for (int i = 1; i <= 120; ++i)
+    [Overlay() renderMotionAt:now + i * .05];
+  EXPECT_FALSE([[Overlay() valueForKey:@"motionFramesRunning"] boolValue]);
+  const auto frame = expected->frame;
+  const NSRect tucked = NSMakeRect(frame.x, frame.y, frame.width, frame.height);
+  ExpectSameFrame(window_.frame, tucked);
+  ExpectPresentedWithinOverlay(Button(@"Restore Picture in Picture"));
+  EXPECT_NE([Overlay() valueForKey:@"shadeView"], nil);
+  Update();
+  ExpectSameFrame(window_.frame, tucked);
+  [Button(@"Restore Picture in Picture") performClick:nil];
+  now = NSProcessInfo.processInfo.systemUptime;
+  for (int i = 1; i <= 120; ++i)
+    [Overlay() renderMotionAt:now + i * .05];
+  ExpectSameFrame(window_.frame, original);
+  EXPECT_FALSE([[Overlay() valueForKey:@"motionFramesRunning"] boolValue]);
+  [(ArciumPiPTestWindow*)window_ setDeferAnimatedFrames:NO];
+}
