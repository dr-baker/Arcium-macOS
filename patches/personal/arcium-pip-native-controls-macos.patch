+@interface ArciumPiPResizeView : NSView
+@property(nonatomic, copy) void (^resizeEvent)(NSEvent*, NSInteger);
+@end
+@implementation ArciumPiPResizeView
+@synthesize resizeEvent = _resizeEvent;
+- (void)drawRect:(NSRect)dirtyRect {
+  [[NSColor colorWithWhite:1 alpha:0.65] setStroke];
+  for (int i = 0; i < 3; ++i) {
+    NSBezierPath* line = [NSBezierPath bezierPath];
+    [line moveToPoint:NSMakePoint(8 + i * 4, 5)];
+    [line lineToPoint:NSMakePoint(19, 16 - i * 4)];
+    line.lineWidth = 1.25;
+    [line stroke];
+  }
+}
+- (void)mouseDown:(NSEvent*)event {
+  if (self.resizeEvent) {
+    self.resizeEvent(event, 0);
+  }
+}
+- (void)mouseDragged:(NSEvent*)event {
+  if (self.resizeEvent) {
+    self.resizeEvent(event, 1);
+  }
+}
+- (void)mouseUp:(NSEvent*)event {
+  if (self.resizeEvent) {
+    self.resizeEvent(event, 2);
+  }
+}
+- (void)resetCursorRects {
+  [self addCursorRect:self.bounds cursor:NSCursor.crosshairCursor];
+}
+@end
