+- (void)mouseDown:(NSEvent*)event {
+  if (!self.enabled) {
+    return;
+  }
+  __attribute__((objc_precise_lifetime)) ArciumPiPSlider* keepAlive = self;
+  (void)keepAlive;
+  if (self.beginDrag) {
+    self.beginDrag();
+  }
+  [super mouseDown:event];
+  if (self.endDrag) {
+    self.endDrag();
+  }
+}
