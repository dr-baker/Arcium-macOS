+
+#include "arcium_pip_native_controls.h"
+
+#import <AppKit/AppKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+#include <algorithm>
+#include <cmath>
+#include <array>
+#include <random>
+#include <utility>
+#include <vector>
+
+#include "arcium_pip_geometry.h"
+#include "arcium_pip_motion.h"
+#include "arcium_pip_gestures.h"
+
+
+namespace {
+using arcium::pip::Action;
+using arcium::pip::ActionCallback;
+using arcium::pip::Placement;
+using arcium::pip::State;
+using arcium::pip::Effect;
+using arcium::pip::ContrastRequest;
+using arcium::pip::ContrastSamples;
+namespace geo = arcium::pip::geometry;
+using pip_motion::Motion;
+using pip_motion::Outcome;
+using pip_motion::Decision;
+using pip_motion::Phase;
+using pip_motion::Side;
+using pip_motion::Docking;
+using pip_motion::length;
+using pip_motion::dockCueDistance;
+using Feedback = pip_motion::FeedbackSettings;
+constexpr double kShadowPad = 200;
+void approach(double& value, double target, double rise, double fall, double dt) {
+  const double tau = std::abs(target) > std::abs(value) ? rise : fall;
+  value += (target - value) * (1 - std::exp(-dt / tau));
+  if (std::abs(target - value) < .001) value = target;
+}
+double smoothstep(double x) { x = std::clamp(x, 0.0, 1.0); return x*x*(3-2*x); }
+CGColorRef gray(double white, double alpha) {
+  return [NSColor colorWithWhite:white alpha:alpha].CGColor;
+}
+
+
+struct Delivery {
+  ActionCallback callback;
+};
+
+geo::Rect ToRect(NSRect r) {
+  return {r.origin.x, r.origin.y, r.size.width, r.size.height};
+}
+NSRect ToNSRect(geo::Rect r) {
+  return NSMakeRect(r.x, r.y, r.width, r.height);
+}
+NSColor* Accent(uint32_t argb) {
+  return [NSColor colorWithSRGBRed:((argb >> 16) & 255) / 255.0
+                             green:((argb >> 8) & 255) / 255.0
+                              blue:(argb & 255) / 255.0
+                             alpha:1];
+}
+bool ReduceMotion() {
+  return NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion;
+}
+NSString* TimeLabel(double seconds) {
+  if (!std::isfinite(seconds) || seconds < 0) {
+    return @"0:00";
+  }
+  int64_t total = static_cast<int64_t>(std::min(seconds, 359999.0));
+  if (total >= 3600) {
+    return [NSString stringWithFormat:@"%lld:%02lld:%02lld", total / 3600,
+                                      (total / 60) % 60, total % 60];
+  }
+  return [NSString stringWithFormat:@"%lld:%02lld", total / 60, total % 60];
+}
+NSImage* Symbol(NSString* name, CGFloat size = 15) {
+  return [[NSImage imageWithSystemSymbolName:name accessibilityDescription:nil]
+      imageWithSymbolConfiguration:
+          [NSImageSymbolConfiguration
+              configurationWithPointSize:size
+                                  weight:NSFontWeightMedium]];
+}
+NSView* Capsule(NSView* content, CGFloat radius);
+void Present(NSView* view, BOOL visible, BOOL animate) {
+  const CGFloat target = visible ? 1 : 0;
+  if ((!view.hidden && view.alphaValue == target) ||
+      (view.hidden && !visible)) {
+    return;
+  }
+  if (!animate || ReduceMotion()) {
+    view.alphaValue = target;
+    view.hidden = !visible;
+    return;
+  }
+  if (visible && view.hidden) {
+    view.alphaValue = 0;
+    view.hidden = NO;
+  }
+  [NSAnimationContext
+      runAnimationGroup:^(NSAnimationContext* context) {
+        context.duration = visible ? .14 : .18;
+        context.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseOut];
+        view.animator.alphaValue = target;
+      }
+      completionHandler:^{
+        if (!visible && view.alphaValue == 0) {
+          view.hidden = YES;
+        }
+      }];
+}
+void Place(NSView* surface, NSView* content, NSRect frame) {
+  const CGFloat radius = std::min(NSWidth(frame),NSHeight(frame))/2;
+  if (@available(macOS 26.0, *)) {
+    if ([surface isKindOfClass:NSGlassEffectView.class])
+      ((NSGlassEffectView*)surface).cornerRadius = radius;
+  }
+  surface.layer.cornerRadius = radius;
+  surface.frame = frame;
+  content.frame = NSMakeRect(0, 0, frame.size.width, frame.size.height);
+}
+}  // namespace
+
+// PiP prioritizes the video: clear material and a stable white foreground.
+@interface ArciumPiPCapsule : NSView {
+  BOOL _opaqueFallback;
+  double _contrastAlpha;
+}
+- (instancetype)initWithContent:(NSView*)content radius:(CGFloat)radius;
+- (void)applyBrightness:(double)brightness animate:(BOOL)animate;
+@end
+@implementation ArciumPiPCapsule
+- (instancetype)initWithContent:(NSView*)content radius:(CGFloat)radius {
+  self = [super initWithFrame:NSMakeRect(0, 0, radius * 2, radius * 2)];
+  if (!self) return nil;
+  self.wantsLayer = YES;
+  self.layer.cornerRadius = radius;
+  self.layer.cornerCurve = kCACornerCurveContinuous;
+  _contrastAlpha = .15;
+  self.layer.backgroundColor = gray(0, _contrastAlpha);
+  content.frame = self.bounds;
+  content.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  if ([content isKindOfClass:NSButton.class])
+    ((NSButton*)content).contentTintColor = NSColor.whiteColor;
+  if (@available(macOS 26.0, *)) {
+    if (!NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceTransparency &&
+        !NSWorkspace.sharedWorkspace.accessibilityDisplayShouldIncreaseContrast) {
+      NSGlassEffectView* glass = [[NSGlassEffectView alloc] initWithFrame:self.bounds];
+      glass.style = NSGlassEffectViewStyleClear;
+      glass.cornerRadius = radius;
+      glass.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+      glass.contentView = content;
+      [self addSubview:glass];
+      return self;
+    }
+  }
+  // Opaque accessibility fallback; older systems retain a quiet dark backing.
+  const BOOL opaque = NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceTransparency ||
+      NSWorkspace.sharedWorkspace.accessibilityDisplayShouldIncreaseContrast;
+  _opaqueFallback = opaque;
+  self.layer.backgroundColor = opaque ? gray(.12, 1) : gray(0, _contrastAlpha);
+  [self addSubview:content];
+  return self;
+}
+- (void)applyBrightness:(double)brightness animate:(BOOL)animate {
+  if (_opaqueFallback) return;
+  const double alpha = !std::isfinite(brightness) || brightness < 0 ? .15 :
+      .35 * smoothstep((brightness - .60) / .25);
+  if (std::abs(alpha - _contrastAlpha) < .001) return;
+  _contrastAlpha = alpha;
+  CGColorRef previous = ((CALayer*)self.layer.presentationLayer).backgroundColor ?: self.layer.backgroundColor;
+  CABasicAnimation* transition = [CABasicAnimation animationWithKeyPath:@"backgroundColor"];
+  transition.fromValue = (__bridge id)previous;
+  transition.toValue = (__bridge id)gray(0, alpha);
+  transition.duration = .25;
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  self.layer.backgroundColor = gray(0, alpha);
