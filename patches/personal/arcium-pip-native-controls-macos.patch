+- (void)cancelReturn {
+  [_returnTimer invalidate]; _returnTimer = nil;
+  if (_returning && _pipWindow) {
+    _pipWindow.alphaValue = 1;
+    [self setWindowFrame:_returnFrame animate:NO];
+  }
+  _returning = NO;
