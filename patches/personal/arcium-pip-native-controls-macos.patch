+// Copyright 2026 The Arcium Authors
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_GEOMETRY_H_
+#define CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_GEOMETRY_H_
+#include <algorithm>
+#include <cmath>
+
+namespace arcium::pip::geometry {
+struct Rect {
+  double x, y, width, height;
+};
+enum class Corner { kBottomLeft, kBottomRight, kTopLeft, kTopRight };
+enum class Side { kNone, kLeft, kRight };
+constexpr double kMargin = 12;
+constexpr double kHandleWidth = 28;
+inline Rect Normalize(Rect r) {
+  r.x = std::isfinite(r.x) ? r.x : 0;
+  r.y = std::isfinite(r.y) ? r.y : 0;
+  r.width = std::isfinite(r.width) ? std::max(0.0, r.width) : 0;
+  r.height = std::isfinite(r.height) ? std::max(0.0, r.height) : 0;
+  return r;
+}
+inline Rect Clamp(Rect r, Rect area) {
+  area = Normalize(area);
+  r = Normalize(r);
+  r.width = std::min(r.width, area.width);
+  r.height = std::min(r.height, area.height);
+  r.x = std::clamp(r.x, area.x, area.x + area.width - r.width);
+  r.y = std::clamp(r.y, area.y, area.y + area.height - r.height);
+  return r;
+}
+inline Corner NearestCorner(Rect r, Rect area) {
+  r = Normalize(r);
+  area = Normalize(area);
+  bool right = r.x + r.width / 2 > area.x + area.width / 2;
+  bool top = r.y + r.height / 2 > area.y + area.height / 2;
+  return top ? (right ? Corner::kTopRight : Corner::kTopLeft)
+             : (right ? Corner::kBottomRight : Corner::kBottomLeft);
+}
+inline Rect Anchor(Rect r, Rect area, Corner corner) {
+  area = Normalize(area);
+  r = Clamp(r, area);
+  const double mx = std::min(kMargin, (area.width - r.width) / 2);
+  const double my = std::min(kMargin, (area.height - r.height) / 2);
+  const bool right =
+      corner == Corner::kBottomRight || corner == Corner::kTopRight;
+  const bool top = corner == Corner::kTopLeft || corner == Corner::kTopRight;
+  r.x = right ? area.x + area.width - r.width - mx : area.x + mx;
+  r.y = top ? area.y + area.height - r.height - my : area.y + my;
+  return r;
+}
+inline Rect Tuck(Rect r, Rect screen, Rect work_area, Side side) {
+  screen = Normalize(screen);
+  r = Clamp(r, work_area);
+  if (side == Side::kNone) {
+    return r;
+  }
+  const double handle = std::min(kHandleWidth, screen.width);
+  r.x = side == Side::kLeft ? screen.x - r.width + handle
+                            : screen.x + screen.width - handle;
+  return r;
+}
+inline Rect Resize(Rect r, Rect area, double aspect, double width) {
+  area = Normalize(area);
+  r = Normalize(r);
+  width = std::isfinite(width) ? width : r.width;
+  aspect = std::isfinite(aspect) && aspect > 0 ? aspect : 16.0 / 9.0;
+  const double max_width = std::min(area.width, area.height * aspect);
+  const double min_width = std::min(max_width, std::max(284.0, 160.0 * aspect));
+  width = std::clamp(width, min_width, max_width);
+  const double top = r.y + r.height;
+  r.width = width;
+  r.height = width / aspect;
+  r.y = top - r.height;
+  return Clamp(r, area);
+}
+}  // namespace arcium::pip::geometry
+#endif
