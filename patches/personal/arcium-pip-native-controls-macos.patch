+- (void)applyPinch:(CGFloat)delta ended:(BOOL)ended cancelled:(BOOL)cancelled {
+  if (_invalidated || _state.blocked || _seeking || _returning || _tucked != geo::Side::kNone) return;
+  _consumeMomentum = NO; _pendingPan = NO;
+  if (!_magnifying) {
+    if (ended || cancelled) return;
+    [self stopMotion];
+    if (![self ensureMotion]) return;
+    [self updateMotionScreen:NSMakePoint(NSMidX(_pipWindow.frame), NSMidY(_pipWindow.frame))];
+    _magnifyStartFrame = _pipWindow.frame;
+    _magnifyPreferredWidth = _preferredWidth;
+    gestures->beginPinch(); _magnifying = YES;
+    [self refreshChrome];
+    [self deliver:Action::kInteraction value:0];
+  }
+  if (!cancelled) gestures->magnify(delta);
