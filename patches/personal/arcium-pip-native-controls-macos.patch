+void VideoOverlayWindowNativeWidgetMac::InitNativeWidget(
+    views::Widget::InitParams params) {
+  NativeWidgetMac::InitNativeWidget(std::move(params));
+  NSWindow* window = GetNativeWindow().GetNativeNSWindow();
+  if (!window || !GetInProcessNSWindowBridge()) {
+    return;
+  }
+  ApplyWindowPolicy();
+  if (auto* contents = video_->GetController()->GetWebContents()) {
+    Observe(contents);
+    profile_ = Profile::FromBrowserContext(contents->GetBrowserContext())
+                   ->GetWeakPtr();
+    profile_observation_.Observe(profile_.get());
+    effects_pref_registrar_.Init(profile_->GetPrefs());
+    for (const auto& effect : arcium::pip::kEffectPreferences) {
+      effects_pref_registrar_.Add(effect.pref, base::BindRepeating(
+          [](base::WeakPtr<VideoOverlayWindowNativeWidgetMac> widget) {
+            if (widget) widget->RefreshNativeControls();
+          }, weak_factory_.GetWeakPtr()));
+    }
+  }
+  controls_ = std::make_unique<arcium::pip::NativeControls>(
+      window, [weak = weak_factory_.GetWeakPtr()](arcium::pip::Action action,
+                                                  double value) {
+        if (weak) {
+          weak->OnNativeAction(action, value);
+        }
+      }, [video = video_](arcium::pip::ContrastRequest request,
+                         std::function<void(arcium::pip::ContrastSamples)> callback) {
+        if (video) video->SampleNativeControlsBrightness(request, base::BindOnce(
+            [](std::function<void(arcium::pip::ContrastSamples)> completion,
+               arcium::pip::ContrastSamples brightness) { completion(brightness); },
+            std::move(callback)));
+        else callback({});
+      });
+  controls_->SetBeforeFocusRelease([weak = weak_factory_.GetWeakPtr()] {
+    if (weak)
+      weak->ClearNativeControlsFocus();
+  });
+}
+
+void VideoOverlayWindowNativeWidgetMac::OnProfileWillBeDestroyed(Profile* profile) {
+  effects_pref_registrar_.Reset();
+  profile_observation_.Reset();
+  profile_ = nullptr;
+}
+
+void VideoOverlayWindowNativeWidgetMac::TitleWasSet(content::NavigationEntry*) {
+  RefreshNativeControls();
+}
