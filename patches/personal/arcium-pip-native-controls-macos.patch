+TEST_F(ArciumPiPNativeControlsTest, ContrastSamplingSurvivesFocusAndRejectsStaleResults) {
+  DestroyControls();
+  std::vector<std::function<void(ContrastSamples)>> completions;
+  controls_ = std::make_unique<NativeControls>(window_, [](Action, double) {},
+      [&completions](ContrastRequest, std::function<void(ContrastSamples)> callback) {
+        completions.push_back(std::move(callback));
+      });
+  MountControls();
+  ((ArciumPiPTestWindow*)window_).testVisible = YES;
+  [Overlay() mouseMoved:nil];
+  Update();
+  ASSERT_EQ(completions.size(), 1u);
+  controls_->FocusControls(false);
+  EXPECT_TRUE([Overlay() valueForKey:@"brightnessTimer"]);
+  completions[0](Brightness(.1));
+  EXPECT_NEAR(ButtonShade(Button(@"Play")), 0, .001);
+  [Overlay() pointerInteraction];
+  [Overlay() mouseExited:nil];
+  [Overlay() mouseMoved:nil];
+  [Overlay() sampleBrightness];
+  EXPECT_EQ(completions.size(), 1u);
+  // Advance the sampling boundary without delaying the suite or showing UI.
+  [Overlay() setValue:@(NSProcessInfo.processInfo.systemUptime - 1.01) forKey:@"lastBrightnessRequest"];
+  [Overlay() sampleBrightness];
+  ASSERT_EQ(completions.size(), 2u);
+  [Overlay() applyPinch:.1 ended:NO cancelled:NO];
+  EXPECT_FALSE([Overlay() valueForKey:@"brightnessTimer"]);
+  completions[1](Brightness(.95));
+  EXPECT_NEAR(ButtonShade(Button(@"Play")), 0, .001);
+  [Overlay() applyPinch:0 ended:YES cancelled:NO];
+  [Overlay() setValue:@(NSProcessInfo.processInfo.systemUptime - 1.01) forKey:@"lastBrightnessRequest"];
+  [Overlay() sampleBrightness];
+  ASSERT_EQ(completions.size(), 3u);
+  DestroyControls();
+  completions[2](Brightness(.95));  // Weak completion after teardown is harmless.
+  ((ArciumPiPTestWindow*)window_).testVisible = NO;
+}
