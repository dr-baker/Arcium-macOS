+++ src/chrome/browser/ui/views/overlay/arcium_pip_geometry_unittest.cc
@@ -0,0 +1,201 @@
+// Copyright 2026 The Arcium Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/ui/views/overlay/arcium_pip_geometry.h"
+#include "chrome/browser/ui/views/overlay/arcium_pip_motion.h"
+
+#include <array>
+#include <cmath>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace arcium::pip::geometry {
+namespace {
+bool Inside(Rect frame, Rect area) {
+  return frame.x >= area.x && frame.y >= area.y &&
+         frame.x + frame.width <= area.x + area.width + 1e-6 &&
+         frame.y + frame.height <= area.y + area.height + 1e-6;
+}
+
+TEST(ArciumPiPGeometryTest, FourCornersStayInNegativeOriginWorkArea) {
+  const Rect area{-1920, -76, 1920, 1032};
+  for (Corner corner : {Corner::kBottomLeft, Corner::kBottomRight,
+                        Corner::kTopLeft, Corner::kTopRight}) {
+    Rect frame = Anchor({-500, 200, 400, 225}, area, corner);
+    EXPECT_TRUE(Inside(frame, area));
+    EXPECT_EQ(NearestCorner(frame, area), corner);
+  }
+}
+
+TEST(ArciumPiPGeometryTest, TuckKeepsRestoreHandleOnEitherEdge) {
+  const Rect screen{-1920, -100, 1920, 1080};
+  const Rect work{-1920, -76, 1920, 1032};
+  Rect left = Tuck({-500, 200, 400, 225}, screen, work, Side::kLeft);
+  Rect right = Tuck({-500, 200, 400, 225}, screen, work, Side::kRight);
+  EXPECT_NEAR(left.x + left.width - screen.x, kHandleWidth, 1e-9);
+  EXPECT_DOUBLE_EQ(screen.x + screen.width - right.x, kHandleWidth);
+  EXPECT_DOUBLE_EQ(left.width, 400);
+  EXPECT_DOUBLE_EQ(right.height, 225);
+}
+
+TEST(ArciumPiPGeometryTest, ResizeKeepsAspectAndReachableBounds) {
+  const Rect area{-1920, -76, 1920, 1032};
+  for (double aspect : {0.5625, 1.0, 16.0 / 9.0, 2.4}) {
+    for (double width : {1.0, 284.0, 400.0, 1200.0, 9999.0}) {
+      Rect frame = Resize({-500, 200, 400, 225}, area, aspect, width);
+      EXPECT_TRUE(Inside(frame, area));
+      EXPECT_NEAR(frame.width / frame.height, aspect, 1e-6);
+      EXPECT_GE(frame.width, 284);
+      EXPECT_GE(frame.height, 160);
+    }
+  }
+}
+
+TEST(ArciumPiPGeometryTest, PlacementFitsSmallerWorkAreaProportionally) {
+  const Rect area{-600, 50, 600, 400};
+  const Rect original{0, 0, 800, 450};
+  const Rect fitted = Fit(original, area);
+  EXPECT_TRUE(Inside(fitted, area));
+  EXPECT_DOUBLE_EQ(fitted.width, 600);
+  EXPECT_DOUBLE_EQ(fitted.height, 337.5);
+  for (Corner corner : {Corner::kBottomLeft, Corner::kBottomRight,
+                        Corner::kTopLeft, Corner::kTopRight}) {
+    Rect frame = Anchor(original, area, corner);
+    EXPECT_TRUE(Inside(frame, area));
+    EXPECT_NEAR(frame.width / frame.height, 16.0 / 9.0, 1e-6);
+  }
+  for (Side side : {Side::kLeft, Side::kRight}) {
+    Rect frame = Tuck(original, area, area, side);
+    EXPECT_NEAR(frame.width / frame.height, 16.0 / 9.0, 1e-6);
+    EXPECT_DOUBLE_EQ(frame.width, fitted.width);
+    EXPECT_DOUBLE_EQ(frame.height, fitted.height);
+  }
+}
+
+TEST(ArciumPiPGeometryTest, TuckMovesToExteriorWhenNeighborAppears) {
+  const Rect restore{1000, 300, 400, 225};
+  const std::array<Screen, 1> original{{{{0, 0, 1440, 900}, {0, 0, 1440, 875}}}};
+  auto before = ExteriorTuck(restore, original, 0, Side::kRight);
+  ASSERT_TRUE(before);
+  EXPECT_EQ(before->screen, 0u);
+  EXPECT_DOUBLE_EQ(before->frame.x, 1440 - kHandleWidth);
+  const std::array<Screen, 2> changed{{
+      original[0], {{1440, 0, 1280, 1024}, {1440, 0, 1280, 1000}}}};
+  auto after = ExteriorTuck(restore, changed, before->screen, Side::kRight);
+  ASSERT_TRUE(after);
+  EXPECT_EQ(after->screen, 1u);
+  EXPECT_DOUBLE_EQ(after->frame.x, 2720 - kHandleWidth);
+  EXPECT_DOUBLE_EQ(after->frame.width, restore.width);
+  EXPECT_DOUBLE_EQ(after->frame.height, restore.height);
+}
+
+TEST(ArciumPiPGeometryTest, ExteriorTuckChecksFinalVerticalPlacement) {
+  const std::array<Screen, 2> screens{{
+      {{0, 0, 1000, 1000}, {0, 700, 1000, 200}},
+      {{1000, 600, 1000, 400}, {1000, 600, 1000, 400}}}};
+  auto placement = ExteriorTuck({500, 0, 800, 450}, screens, 0, Side::kRight);
+  ASSERT_TRUE(placement);
+  EXPECT_EQ(placement->screen, 1u);
+  EXPECT_DOUBLE_EQ(placement->frame.x, 2000 - kHandleWidth);
+  EXPECT_GE(placement->frame.y, 600);
+  EXPECT_NEAR(placement->frame.width / placement->frame.height, 16.0 / 9.0, 1e-6);
+  EXPECT_FALSE(ExteriorTuck({0, 0, 400, 225}, {}, 0, Side::kRight));
+}
+
+TEST(ArciumPiPGeometryTest, RememberedWidthRespectsMaximumDimensions) {
+  const Rect area{-1440, 50, 1440, 900};
+  const SizeLimits limits{284, 160, 1152, 720};
+  const Rect frame = Resize({0, 0, 400, 225}, area, 16.0 / 9.0, 1200, limits);
+  EXPECT_TRUE(Inside(frame, area));
+  EXPECT_DOUBLE_EQ(frame.width, 1152);
+  EXPECT_DOUBLE_EQ(frame.height, 648);
+}
+
+TEST(ArciumPiPGeometryTest, ExtremeAspectKeepsControlsUsableWithLetterboxing) {
+  const Rect area{0, 0, 1440, 900};
+  const SizeLimits limits{284, 160, 1152, 720};
+  const auto portrait = Resize({0, 0, 400, 225}, area, 0.1, 1200, limits);
+  EXPECT_DOUBLE_EQ(portrait.width, 284);
+  EXPECT_DOUBLE_EQ(portrait.height, 720);
+  const auto landscape = Resize({0, 0, 400, 225}, area, 10, 1200, limits);
+  EXPECT_DOUBLE_EQ(landscape.width, 1152);
+  EXPECT_DOUBLE_EQ(landscape.height, 160);
+}
+
+TEST(ArciumPiPGeometryTest,
+     PermissionMinimumTakesPriorityOverConflictingMaximum) {
+  const Rect area{0, 0, 1440, 900};
+  const SizeLimits limits{600, 300, 400, 240};
+  const auto frame = Resize({0, 0, 400, 225}, area, 16.0 / 9.0, 360, limits);
+  EXPECT_TRUE(Inside(frame, area));
+  EXPECT_DOUBLE_EQ(frame.width, 600);
+  EXPECT_DOUBLE_EQ(frame.height, 300);
+}
+
+TEST(ArciumPiPGeometryTest, TinyAndInvalidScreensStayFinite) {
+  Rect tiny = Resize({0, 0, 400, 225}, {0, 0, 240, 120}, 16.0 / 9.0, 500);
+  EXPECT_TRUE(Inside(tiny, {0, 0, 240, 120}));
+  EXPECT_NEAR(tiny.width / tiny.height, 16.0 / 9.0, 1e-6);
+  for (Rect area :
+       {Rect{0, 0, 0, 0}, Rect{5, -1, -8, -4}, Rect{NAN, NAN, INFINITY, NAN}}) {
+    Rect frame = Resize({0, 0, 400, 225}, area, NAN, NAN);
+    EXPECT_TRUE(std::isfinite(frame.x));
+    EXPECT_TRUE(std::isfinite(frame.y));
+    EXPECT_DOUBLE_EQ(frame.width, 0);
+    EXPECT_DOUBLE_EQ(frame.height, 0);
+  }
+}
+TEST(ArciumPiPGeometryTest, PressEdgesIgnoreHorizontalAndVerticalSeams) {
+  std::vector<Screen> screens = {{{0,0,1000,700},{0,0,1000,700}},
+      {{1000,0,1800,1100},{1000,0,1800,1100}},
+      {{0,700,1000,700},{0,700,1000,700}}};
+  auto edges = ExteriorEdges({700,300,320,180}, screens, 0);
+  EXPECT_FALSE(edges.right); EXPECT_TRUE(edges.left);
+  edges = ExteriorEdges({300,600,320,180}, screens, 0);
+  EXPECT_FALSE(edges.top); EXPECT_TRUE(edges.bottom);
+  edges = ExteriorEdges({2400,300,320,180}, screens, 1);
+  EXPECT_TRUE(edges.right); EXPECT_FALSE(edges.left);
+}
+TEST(ArciumPiPGeometryTest, StaggeredSharedSpanAndGapRemainDistinct) {
+  std::vector<Screen> screens = {{{-1000,0,1000,700},{-1000,0,1000,700}},
+      {{0,400,1200,900},{0,400,1200,900}}};
+  EXPECT_TRUE(ExteriorEdges({-330,100,320,180}, screens, 0).right);
+  EXPECT_FALSE(ExteriorEdges({-330,300,320,180}, screens, 0).right);
+  screens[1].frame.x = 50;
+  EXPECT_TRUE(ExteriorEdges({-330,450,320,180}, screens, 0).right);
+}
+TEST(ArciumPiPGeometryTest, FreePlacementPreservesFractionsAcrossDisplays) {
+  const auto small = AtFraction({0,0,320,180},{0,0,1000,700},.35,.6);
+  const auto big = AtFraction(small,{1000,-400,2000,1400},.35,.6);
+  EXPECT_NEAR(big.x,1000+kMargin+.35*(2000-320-2*kMargin),1e-6);
+  EXPECT_NEAR(big.y,-400+kMargin+.6*(1400-180-2*kMargin),1e-6);
+  EXPECT_DOUBLE_EQ(big.width,small.width);
+}
+TEST(ArciumPiPGeometryTest, MigratedTuckRestoresOriginalDisplayWithoutClampingAtSeam) {
+  pip_motion::Motion motion;
+  motion.settings = pip_motion::selectedSettings();
+  motion.environment({1000,0,1600,1000},{320,180});
+  motion.seed({2600-motion.settings.handle,250},pip_motion::Side::Right,{350,250});
+  motion.begin({2590,300},1); motion.end(1.1);
+  EXPECT_DOUBLE_EQ(motion.target.x,350);
+  motion.environment({0,0,1000,700},{320,180},{},pip_motion::Rect{0,0,2600,1000});
+  for (int i=0;i<1200;++i) motion.step(1.0/120);
+  EXPECT_EQ(motion.phase,pip_motion::Phase::Resting);
+  EXPECT_DOUBLE_EQ(motion.position.x,350);
+  EXPECT_DOUBLE_EQ(motion.position.y,250);
+}
+TEST(ArciumPiPGeometryTest, SelectedMotionRequiresTwentyPercentMoreDockDepth) {
+  pip_motion::Motion motion;
+  motion.settings = pip_motion::selectedSettings();
+  EXPECT_DOUBLE_EQ(motion.settings.press_dock,2.4);
+  EXPECT_DOUBLE_EQ(motion.settings.press_tuck,24.7);
+  motion.placeAt({1000-320-motion.settings.margin,250});
+  auto pointer = motion.position + pip_motion::Point{100,80};
+  motion.begin(pointer,1);
+  motion.drag(pointer + pip_motion::Point{pip_motion::rubberInput(320*.0239,320,.631),0},1.1);
+  EXPECT_EQ(motion.predict(1.3,true).decision,pip_motion::Decision::Keep);
+  motion.drag(pointer + pip_motion::Point{pip_motion::rubberInput(320*.0241,320,.631),0},1.4);
+  EXPECT_EQ(motion.predict(1.6,true).decision,pip_motion::Decision::Dock);
+}
