+  _tucked = geo::Side::kNone;
+  _nativeVisible = NO;
+  _hasSnapshot = NO;
+  _placementReady = NO;
+  _mouseInside = NO;
+  _dragging = _resizing = _scrolling = _seeking = _magnifying = _liveResizing = NO;
