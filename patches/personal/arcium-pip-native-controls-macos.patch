+void VideoOverlayWindowNativeWidgetMac::OnWindowDestroying(
+    gfx::NativeWindow window) {
+  if (video_) {
+    video_->DetachNativeControlsHost();
+  }
+  weak_factory_.InvalidateWeakPtrs();
+  if (video_) {
+    video_->native_controls_widget_ = nullptr;
+  }
+  controls_.reset();
+  NativeWidgetMac::OnWindowDestroying(window);
+}
+
+gfx::NativeView VideoOverlayWindowNativeWidgetMac::GetNativeControlsView()
+    const {
+  return controls_ ? controls_->GetNativeView() : gfx::NativeView();
