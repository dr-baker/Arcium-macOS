+
+void VideoOverlayWindowViews::DetachNativeControlsHost() {
+  auto* host = std::exchange(native_controls_host_, nullptr).get();
+  native_controls_active_ = false;
+  if (!host) return;
+  host->SetFocusBehavior(views::View::FocusBehavior::NEVER);
+  auto* focus = GetFocusManager();
+  if (focus && (focus->GetFocusedView() == host || focus->GetStoredFocusView() == host)) {
+    focus->SetFocusedView(nullptr);
+    focus->SetStoredFocusView(nullptr);
+  }
+  if (native_controls_widget_) {
+    native_controls_widget_->ReleaseNativeControlsFocus();
+    native_controls_widget_->SetNativeControlsAccessibilityParent({});
+  }
+  host->SetVisible(false);
+  if (host->native_view()) host->Detach();
+  controls_container_view_->SetVisible(native_controls_visible_);
+  title_view_->SetVisible(native_title_visible_);
+}
