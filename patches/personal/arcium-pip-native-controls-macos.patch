+void VideoOverlayWindowViews::RefreshNativeControls() {
+  if (!native_controls_widget_ || !native_controls_host_ ||
+      !native_controls_host_->native_view())
+    return;
+  const bool was_active = native_controls_active_;
+  native_controls_active_ = native_controls_widget_->RefreshNativeControls();
+  if (!native_controls_active_)
