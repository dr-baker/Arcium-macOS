+- (void)layout {
+  [super layout];
+  const CGFloat w = NSWidth(self.bounds), h = NSHeight(self.bounds);
+  _glassContainer.frame = self.bounds;
+  _glassContent.frame = self.bounds;
+  Place(_returnGlass, _returnButton, NSMakeRect(12, h - 44, 32, 32));
+  Place(_closeGlass, _closeButton, NSMakeRect(w - 44, h - 44, 32, 32));
+  Place(_tuckGlass, _tuckButton, NSMakeRect(w - 82, h - 44, 32, 32));
+  CGFloat centerY = std::max(88.0, h * 0.5);
+  Place(_playGlass, _playButton,
+        NSMakeRect(w * 0.5 - 24, centerY - 24, 48, 48));
+  Place(_backGlass, _backButton,
+        NSMakeRect(w * 0.5 - 80, centerY - 18, 36, 36));
+  Place(_forwardGlass, _forwardButton,
+        NSMakeRect(w * 0.5 + 44, centerY - 18, 36, 36));
+  BOOL seekButtons = w >= 320 && h >= 180 && _state.can_seek &&
+                     _nativeVisible && !_state.blocked &&
+                     _tucked == geo::Side::kNone;
+  Present(_backGlass, seekButtons,
+          !_state.blocked && _tucked == geo::Side::kNone);
+  Present(_forwardGlass, seekButtons,
+          !_state.blocked && _tucked == geo::Side::kNone);
+  Place(_muteGlass, _muteButton, NSMakeRect(12, 12, 28, 28));
+  _slider.frame = NSMakeRect(16, 40, w - 32, 24);
+  _timestamp.frame = NSMakeRect(48, 13, w - 96, 14);
+  _title.frame = NSMakeRect(52, h - 35, std::max(0.0, w - 144), 16);
+  _resizeView.frame = NSMakeRect(w - 24, 0, 24, 24);
+  CGFloat handleX = _tucked == geo::Side::kLeft ? w - geo::kHandleWidth : 0;
+  Place(_restoreGlass, _restoreButton,
+        NSMakeRect(handleX, h * 0.5 - 32, geo::kHandleWidth, 64));
+  [self updateKeyLoop];
+}
