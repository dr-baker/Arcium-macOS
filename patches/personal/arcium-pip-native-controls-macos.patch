+- (instancetype)initWithWindow:(NSWindow*)window
+                      callback:(ActionCallback)callback;
+- (void)applyState:(const State&)state;
+- (BOOL)hasControlsFocus;
+- (void)focusControls:(BOOL)reverse;
+- (void)releaseControlsFocus;
+- (void)setBeforeFocusRelease:(std::function<void()>)callback;
+- (void)updateKeyLoop;
+- (void)invalidate;
