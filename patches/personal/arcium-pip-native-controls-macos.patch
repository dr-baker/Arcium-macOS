+NSView* FindNative(NSView* root, NSString* label) {
+  if ([root.accessibilityLabel isEqualToString:label]) {
+    return root;
+  }
+  for (NSView* child in root.subviews) {
+    if (auto* found = FindNative(child, label)) {
+      return found;
+    }
+  }
+  return nil;
+}
+bool FindAXLabel(id root,
+                 NSString* label,
+                 NSMutableSet<NSValue*>* seen,
+                 int depth = 0) {
+  if (!root || depth > 40) {
+    return false;
+  }
+  NSValue* identity = [NSValue valueWithNonretainedObject:root];
+  if ([seen containsObject:identity]) {
+    return false;
+  }
+  [seen addObject:identity];
+  if ([root respondsToSelector:@selector(accessibilityLabel)] &&
+      [[root accessibilityLabel] isEqualToString:label]) {
+    return true;
+  }
+  if ([root respondsToSelector:@selector(accessibilityChildren)]) {
+    for (id child in [root accessibilityChildren]) {
+      if (FindAXLabel(child, label, seen, depth + 1)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+NSWindow* PrepareNativeWindow(VideoOverlayWindowViews* window) {
+  NSWindow* native = window->GetNativeWindow().GetNativeNSWindow();
+  [native.contentView layoutSubtreeIfNeeded];
+  CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+  // SetBounds delivers native move/resize notifications before input is tested.
+  // Finish Chromium's move suppression before revealing the hidden fixture.
+  window->FireEnableControlsAfterMoveTimerForTesting();
+  window->UpdateControlsVisibility(true, false);
+  [native.contentView layoutSubtreeIfNeeded];
+  CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+  [native.contentView layoutSubtreeIfNeeded];
+  return native;
+}
+}  // namespace
+void VerifyNativeLanding(VideoOverlayWindowViews* window,
+                         int corner,
+                         double width) {
+  NSWindow* native = window->GetNativeWindow().GetNativeNSWindow();
+  CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+  ASSERT_FALSE(native.visible);
+  NSScreen* screen = native.screen;
+  ASSERT_TRUE(screen);
+  const NSRect frame = native.frame;
+  const NSRect area = screen.visibleFrame;
+  const bool right = corner == 1 || corner == 3;
+  const bool top = corner == 2 || corner == 3;
+  EXPECT_NEAR(right ? NSMaxX(frame) : NSMinX(frame),
+              right ? NSMaxX(area) - geometry::kMargin : NSMinX(area) + geometry::kMargin, 0.5);
+  EXPECT_NEAR(top ? NSMaxY(frame) : NSMinY(frame),
+              top ? NSMaxY(area) - geometry::kMargin : NSMinY(area) + geometry::kMargin, 0.5);
+  if (width > 0) {
+    EXPECT_NEAR(NSWidth(frame), width, 0.5);
+  }
+}
+void SettleNativePlacement(VideoOverlayWindowViews* window) {
+  NSWindow* native = PrepareNativeWindow(window);
+  NSView* overlay =
+      FindNative(native.contentView, @"Picture in Picture controls");
+  ASSERT_TRUE(overlay);
+  [overlay snap];
+}
+void VerifyChromiumNativeHitTargetAction(VideoOverlayWindowViews* window) {
+  NSWindow* native = PrepareNativeWindow(window);
+  ASSERT_FALSE(native.visible);
+  NSButton* pause = (NSButton*)FindNative(native.contentView, @"Pause");
+  ASSERT_TRUE(pause);
+  ASSERT_FALSE(pause.hiddenOrHasHiddenAncestor);
+  NSPoint point = [pause
+      convertPoint:NSMakePoint(NSMidX(pause.bounds), NSMidY(pause.bounds))
+            toView:nil];
+  NSPoint framePoint = [native.contentView.superview convertPoint:point
+                                                         fromView:nil];
+  NSView* target = [native.contentView hitTest:framePoint];
+  ASSERT_EQ(target, pause);
+  gfx::Point viewsPoint(point.x, NSHeight(native.contentView.bounds) - point.y);
+  EXPECT_EQ(window->GetNonClientComponent(viewsPoint), HTCLIENT);
+  // Hidden windows cannot establish physical mouse delivery. Exercise the
+  // actual hit target's native accessibility action without showing the app.
+  [((NSButton*)target).cell accessibilityPerformPress];
+  CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.03, false);
+  EXPECT_TRUE(FindNative(native.contentView, @"Play"));
+  EXPECT_FALSE(native.visible);
+}
+void VerifyChromiumNativeScrub(VideoOverlayWindowViews* window,
+                              bool end_before_hide,
+                              bool hide) {
+  NSWindow* native = PrepareNativeWindow(window);
+  NSView* overlay = FindNative(native.contentView, @"Picture in Picture controls");
+  ASSERT_TRUE(overlay);
+  const auto playback = window->playback_state_for_testing();
+  [overlay beginSeek];
+  CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+  NSSlider* slider = (NSSlider*)FindNative(native.contentView, @"Playback position");
+  ASSERT_TRUE(slider);
+  slider.doubleValue = 0.6;
+  [slider sendAction:slider.action to:slider.target];
+  CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+  if (end_before_hide) {
+    [overlay endSeek];
+  }
+  if (hide) {
+    window->Hide();
+  }
+  if (!end_before_hide) {
+    [overlay endSeek];
+  }
+  CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+  EXPECT_EQ(window->playback_state_for_testing(), playback);
+  EXPECT_TRUE(FindNative(native.contentView,
+                        playback == content::VideoOverlayWindow::kPlaying
+                            ? @"Pause" : @"Play"));
+  EXPECT_FALSE(native.visible);
+}
+void VerifyChromiumNativeAccessibilityAndFocus(
+    VideoOverlayWindowViews* window) {
+  NSWindow* native = PrepareNativeWindow(window);
+  NSView* overlay =
+      FindNative(native.contentView, @"Picture in Picture controls");
+  ASSERT_TRUE(overlay);
+  EXPECT_TRUE(overlay.accessibilityElement);
+  EXPECT_NSEQ(overlay.accessibilityRole, NSAccessibilityGroupRole);
+  EXPECT_TRUE(
+      FindAXLabel(native, @"Picture in Picture controls", [NSMutableSet set]));
+  EXPECT_TRUE(FindAXLabel(native, @"Pause", [NSMutableSet set]));
+  ASSERT_TRUE(overlay.accessibilityParent);
+  NSMutableSet<NSValue*>* parents = [NSMutableSet set];
+  id ancestor = overlay;
+  for (int depth = 0; ancestor && depth < 40; ++depth) {
+    NSValue* identity = [NSValue valueWithNonretainedObject:ancestor];
+    ASSERT_FALSE([parents containsObject:identity]);
+    [parents addObject:identity];
+    ancestor = [ancestor respondsToSelector:@selector(accessibilityParent)]
+                   ? [ancestor accessibilityParent]
+                   : nil;
+  }
+  EXPECT_NE(overlay.accessibilityParent, overlay);
+  [native makeFirstResponder:native.contentView];
+  ui::KeyEvent tab(ui::EventType::kKeyPressed, ui::VKEY_TAB, ui::EF_NONE);
+  window->GetFocusManager()->OnKeyEvent(tab);
+  NSResponder* first = native.firstResponder;
+  ASSERT_TRUE([first isKindOfClass:NSButton.class]);
+  EXPECT_NSEQ(((NSView*)first).accessibilityLabel, @"Return to tab");
+  NSView* next = ((NSView*)first).nextValidKeyView;
+  ASSERT_TRUE(next);
+  EXPECT_NSEQ(next.accessibilityLabel, @"Tuck to screen edge");
+  [native makeFirstResponder:next];
+  EXPECT_EQ(native.firstResponder, next);
+  EXPECT_FALSE(native.visible);
+}
+void VerifyFocusedNativeRebuildAndDetach(VideoOverlayWindowViews* window) {
+  NSWindow* native = PrepareNativeWindow(window);
+  NSView* overlay =
+      FindNative(native.contentView, @"Picture in Picture controls");
+  ASSERT_TRUE(overlay);
+  NSView* button = FindNative(native.contentView, @"Pause");
+  ASSERT_TRUE(button);
+  NSPoint point = [button
+      convertPoint:NSMakePoint(NSMidX(button.bounds), NSMidY(button.bounds))
+            toView:nil];
+  gfx::Point location(point.x, NSHeight(native.contentView.bounds) - point.y);
+  views::View* host = window->GetRootView()->GetEventHandlerForPoint(location);
+  ASSERT_TRUE(host);
+  auto* focus = window->GetFocusManager();
+  for (int iteration = 0; iteration < 2; ++iteration) {
+    focus->SetFocusedView(host);
+    focus->StoreFocusedView(false);
+    ASSERT_EQ(focus->GetFocusedView(), nullptr);
+    ASSERT_EQ(focus->GetStoredFocusView(), host);
+    NSResponder* outgoing = native.firstResponder;
+    [overlay buildChrome];
+    CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+    ASSERT_TRUE([native.firstResponder isKindOfClass:NSView.class]);
+    EXPECT_NE(native.firstResponder, outgoing);
+    EXPECT_TRUE([(NSView*)native.firstResponder isDescendantOf:overlay]);
+    EXPECT_EQ(focus->GetStoredFocusView(), nullptr);
+  }
+  window->UseLegacyControlsForTesting();
+  EXPECT_EQ(overlay.superview, nil);
+  EXPECT_FALSE([native.firstResponder isKindOfClass:NSView.class] &&
+               [(NSView*)native.firstResponder isDescendantOf:overlay]);
+  EXPECT_NE(focus->GetFocusedView(), host);
+  EXPECT_NE(focus->GetStoredFocusView(), host);
+  EXPECT_FALSE(native.visible);
+}
+void VerifyNativeHostVisibility(VideoOverlayWindowViews* window,
+                                bool expected) {
+  NSWindow* native = PrepareNativeWindow(window);
+  NSView* overlay =
+      FindNative(native.contentView, @"Picture in Picture controls");
+  if (expected) {
+    ASSERT_TRUE(overlay);
+    EXPECT_FALSE(overlay.hiddenOrHasHiddenAncestor);
+  } else if (overlay) {
+    EXPECT_TRUE(overlay.hiddenOrHasHiddenAncestor);
+    EXPECT_FALSE([native.firstResponder isKindOfClass:NSView.class] &&
+                 [(NSView*)native.firstResponder isDescendantOf:overlay]);
+  }
+  EXPECT_FALSE(native.visible);
+}
+}  // namespace arcium::pip::test
