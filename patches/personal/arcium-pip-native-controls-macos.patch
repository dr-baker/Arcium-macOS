+#ifndef CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_NATIVE_CONTROLS_H_
+#define CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_NATIVE_CONTROLS_H_
+
+#include <cstdint>
+#include <array>
+#include <cstddef>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "chrome/browser/ui/views/overlay/arcium_pip_contrast.h"
+#include "ui/gfx/native_ui_types.h"
+
+#ifdef __OBJC__
+@class NSWindow;
+#else
+class NSWindow;
+#endif
+
+
+namespace arcium::pip {
+
+inline constexpr char kPlacementPref[] = "arcium.pip.placement";
+
+struct Placement {
+  geometry::Corner corner = geometry::Corner::kBottomRight;
+  double width = 0;
+  bool has_position = false;
+  double x = 1, y = 0;
+};
+
+enum class Action {
+  kPlayPause,
+  kBack15,
+  kForward15,
+  kSeek,
+  kReturn,
+  kClose,
+  kMute,
+  kInteraction,
+  kPlacementChanged,
+};
+
+enum class Effect {
+  kPickup,
+  kSettle,
+  kDockLean,
+  kShadows,
+  kDockShadow,
+  kEdgeShade,
+  kStrings,
+  kLanding,
+  kHaptics,
+  kReturn,
+  kCount,
+};
+
+struct EffectPreference {
+  const char* pref;
+  const char* key;
+  const char* title;
+  const char* description;
+  bool default_enabled = false;
+};
+inline constexpr std::array<EffectPreference, static_cast<size_t>(Effect::kCount)>
+    kEffectPreferences = {{
+  {"arcium.pip.effects.pickup", "pip_effect_pickup", "Pickup lift", "Grow the window slightly while holding it."},
+  {"arcium.pip.effects.settle", "pip_effect_settle", "Settle cue", "Lower the lifted window as a deliberate drop becomes likely. Requires pickup lift."},
+  {"arcium.pip.effects.dock_lean", "pip_effect_dock_lean", "Dock lean", "Lean toward the edge where the window will dock."},
+  {"arcium.pip.effects.shadows", "pip_effect_shadows", "Custom shadows", "Draw soft shadows that respond to window movement."},
+  {"arcium.pip.effects.dock_shadow", "pip_effect_dock_shadow", "Projected dock shadow", "Move the custom shadow toward the docking destination. Requires custom shadows."},
+  {"arcium.pip.effects.edge_shade", "pip_effect_edge_shade", "Edge shading", "Shade the window as it moves into a screen edge.", true},
+  {"arcium.pip.effects.strings", "pip_effect_strings", "Pressure strings", "Show elastic pressure strings along edges and around corners."},
+  {"arcium.pip.effects.landing", "pip_effect_landing", "Landing press", "Dip slightly when the window comes to rest."},
+  {"arcium.pip.effects.haptics", "pip_effect_haptics", "Haptic feedback", "Play light Force Touch trackpad taps for movement decisions."},
+  {"arcium.pip.effects.return", "pip_effect_return", "Return animation", "Shrink and fade when returning the video to its browser tab."},
+}};
+
+struct State {
+  std::array<bool, kEffectPreferences.size()> effects{};
+  bool HasEffect(Effect effect) const { return effects[static_cast<size_t>(effect)]; }
+  bool HasVisualEffects() const {
+    return HasEffect(Effect::kPickup) || HasEffect(Effect::kSettle) ||
+           HasEffect(Effect::kDockLean) || HasEffect(Effect::kShadows) ||
+           HasEffect(Effect::kDockShadow) || HasEffect(Effect::kEdgeShade) ||
+           HasEffect(Effect::kStrings) || HasEffect(Effect::kLanding);
+  }
+  geometry::SizeLimits size_limits;
+  bool playing = false;
+  bool can_play = false;
+  bool can_seek = false;
+  bool muted = false;
+  bool can_mute = false;
+  bool blocked = false;
+  bool show_controls = false;
+  bool show_title = false;
+  double position = 0;
+  double duration = 0;
+  double playback_rate = 1;
+  uint32_t accent = 0xFFACB9CF;
+  std::u16string title;
+};
+
+// Actions are delivered asynchronously on the main queue and canceled on
+// teardown. kSeek carries a normalized fraction and preserves playback state.
+using ActionCallback = std::function<void(Action, double)>;
+// One asynchronous video-only sample for all button regions. Negative results are unavailable.
+using BrightnessSampler = std::function<void(ContrastRequest, std::function<void(ContrastSamples)>)>;
+
+// Construct/update/destroy on the main thread, after native widget
+// initialization. The caller attaches the returned view with NativeViewHost
+// and detaches it before destroying the controls. Video transport is unchanged.
+class NativeControls {
+ public:
+  NativeControls(NSWindow* window, ActionCallback callback,
+                 BrightnessSampler brightness_sampler = {});
+  ~NativeControls();
+  NativeControls(const NativeControls&) = delete;
+  NativeControls& operator=(const NativeControls&) = delete;
+  gfx::NativeView GetNativeView() const;
+  void SetAccessibilityParent(gfx::NativeViewAccessible parent);
+  void FocusControls(bool reverse);
+  void ReleaseFocus();
+  void SetBeforeFocusRelease(std::function<void()> callback);
+  void Update(const State& state);
+  void RestorePlacementForHide();
+  void PreparePlacement(const Placement& placement,
+                        NSWindow* opener,
+                        double aspect,
+                        geometry::SizeLimits limits);
+  void Reanchor(double aspect, geometry::SizeLimits limits);
+  std::optional<Placement> TakeUserPlacement();
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace arcium::pip
+#endif
