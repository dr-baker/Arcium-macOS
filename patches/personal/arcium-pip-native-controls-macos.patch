+             ended:recognizer.state == NSGestureRecognizerStateEnded cancelled:cancelled];
+  recognizer.magnification = 0;
+}
+- (BOOL)consumeMagnify:(NSEvent*)event {
+  if (!_magnifying && !_scrolling && !_pendingPan && ![self eventOverCard:event]) return NO;
+  if (event.phase == NSEventPhaseNone) {
+    [self applyPinch:event.magnification ended:NO cancelled:NO];
+    [self applyPinch:0 ended:YES cancelled:NO];
+  } else {
+    [self applyPinch:event.magnification ended:(event.phase & NSEventPhaseEnded) != 0
+           cancelled:(event.phase & NSEventPhaseCancelled) != 0];
+  }
+  return !_invalidated && !_state.blocked && !_returning && _tucked == geo::Side::kNone;
+}
+- (void)resizeEvent:(NSEvent*)event phase:(NSInteger)phase {
+  if (_state.blocked || _tucked != geo::Side::kNone) {
+    return;
+  }
+  if (phase == 0) {
+    [self stopMotion];
+    _suppressMouseUp = NO;
+    _resizing = YES;
+    [self refreshChrome];
+    _resizeStartFrame = _pipWindow.frame;
+    _resizeStartMouse = event.window ? [self screenPoint:event] : NSEvent.mouseLocation;
+  } else if (phase == 1 && _resizing) {
+    NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+    if (!screen) {
+      return;
+    }
+    NSPoint mouse = event.window ? [self screenPoint:event] : NSEvent.mouseLocation;
+    double dx = mouse.x - _resizeStartMouse.x;
+    double dy = _resizeStartMouse.y - mouse.y;
+    double width = NSWidth(_resizeStartFrame) + (dx + dy * _aspect) * 0.5;
+    [self queueResizeFrame:ToNSRect(geo::Resize(ToRect(_resizeStartFrame),
+                                              ToRect(screen.visibleFrame),
+                                              _aspect, width, _sizeLimits))];
+  } else if (phase == 2 && _resizing) {
+    [self flushResizeFrame];
+    [self pauseMotionFrames];
+    _resizing = NO;
+    _nativeVisible = _mouseInside || [self keepsKeyboardControlsVisible];
+    [self refreshChrome];
+    [self armHideTimer];
+    _preferredWidth = NSWidth(_pipWindow.frame);
+    if (_state.HasVisualEffects() && [self ensureMotion] && ![self updateMotionVisuals])
+      [self startMotionTimer];
+    [self rememberPlacement];
+  }
+}
+- (void)magnifyWithEvent:(NSEvent*)event {
+  // The recognizer owns events on this window. Other-window magnification is
+  // handled by the application monitor without double-applying the delta.
+  [super magnifyWithEvent:event];
+}
