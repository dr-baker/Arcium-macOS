+  if (ended || cancelled) {
+    motion->resize({frame.size.width, frame.size.height});
+    motion->placeAt({frame.origin.x, frame.origin.y});
+    if (!cancelled) _preferredWidth = frame.size.width;
+    _pendingResizeFrame.reset();
