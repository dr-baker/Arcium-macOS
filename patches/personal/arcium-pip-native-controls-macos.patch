+
+void VideoOverlayWindowNativeWidgetMac::ApplyWindowPolicy() {
+  auto* window = static_cast<NativeWidgetMacNSWindow*>(
+      GetNativeWindow().GetNativeNSWindow());
+  if (!window) {
+    return;
+  }
+  [window setActivationIndependence:YES];
+  window.hidesOnDeactivate = NO;
+  auto behavior = window.collectionBehavior;
+  behavior &= ~(NSWindowCollectionBehaviorMoveToActiveSpace |
+                NSWindowCollectionBehaviorFullScreenPrimary |
+                NSWindowCollectionBehaviorFullScreenNone |
+                NSWindowCollectionBehaviorPrimary |
+                NSWindowCollectionBehaviorAuxiliary);
+  behavior |= NSWindowCollectionBehaviorCanJoinAllSpaces |
+              NSWindowCollectionBehaviorFullScreenAuxiliary;
+  if (@available(macOS 13.0, *)) {
+    behavior |= NSWindowCollectionBehaviorCanJoinAllApplications;
+  }
+  window.collectionBehavior = behavior;
+}
+
+void VideoOverlayWindowNativeWidgetMac::SaveUserPlacement() {
+  if (!controls_ || !profile_) {
+    return;
+  }
+  auto placement = controls_->TakeUserPlacement();
+  if (!placement) {
+    return;
+  }
+  if (profile_->GetPrefs()->GetDict(arcium::pip::kPlacementPref) !=
+      placement_pref_snapshot_) {
+    return;
+  }
+  base::DictValue value;
+  value.Set("version", 2);
+  value.Set("corner", static_cast<int>(placement->corner));
+  value.Set("width", placement->width);
+  if (placement->has_position) {
+    value.Set("x", placement->x);
+    value.Set("y", placement->y);
+  }
+  placement_pref_snapshot_ = value.Clone();
+  profile_->GetPrefs()->SetDict(arcium::pip::kPlacementPref, std::move(value));
+}
+
+void VideoOverlayWindowNativeWidgetMac::PreparePlacement() {
+  if (!controls_ || !video_) {
+    return;
+  }
+  SaveUserPlacement();
+  arcium::pip::Placement placement;
+  if (profile_) {
+    const auto& value =
+        profile_->GetPrefs()->GetDict(arcium::pip::kPlacementPref);
+    placement_pref_snapshot_ = value.Clone();
+    const int corner = value.FindInt("corner").value_or(-1);
+    const double width = value.FindDouble("width").value_or(0);
+    const int version = value.FindInt("version").value_or(0);
+    if ((version == 1 || version == 2) && corner >= 0 &&
+        corner <= 3 && std::isfinite(width) && width > 0 && width <= 16384) {
+      placement.corner = static_cast<arcium::pip::geometry::Corner>(corner);
+      placement.width = width;
+      const double x = value.FindDouble("x").value_or(-1);
+      const double y = value.FindDouble("y").value_or(-1);
+      if (version == 2 && std::isfinite(x) && std::isfinite(y) &&
+          x >= 0 && x <= 1 && y >= 0 && y <= 1) {
+        placement.has_position = true;
+        placement.x = x; placement.y = y;
+      }
+    }
+  }
+  auto* contents = video_->GetController()->GetWebContents();
+  NSWindow* opener =
+      contents ? contents->GetTopLevelNativeWindow().GetNativeNSWindow() : nil;
+  const auto natural = video_->natural_size_;
+  const double aspect =
+      natural.IsEmpty()
+          ? 16.0 / 9.0
+          : static_cast<double>(natural.width()) / natural.height();
+  controls_->PreparePlacement(placement, opener, aspect,
+                              SizeLimitsFor(video_.get()));
+}
+
+void VideoOverlayWindowNativeWidgetMac::Reanchor() {
+  if (controls_ && video_) {
+    const auto natural = video_->natural_size_;
+    controls_->Reanchor(
+        natural.IsEmpty()
+            ? 16.0 / 9.0
+            : static_cast<double>(natural.width()) / natural.height(),
+        SizeLimitsFor(video_.get()));
+  }
+}
