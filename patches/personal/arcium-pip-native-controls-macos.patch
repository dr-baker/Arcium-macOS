+TEST_F(ArciumPiPNativeControlsTest, RehitTestedHandleRestoresFreelyPlacedWindow) {
+  const NSRect start = window_.frame;
+  for (auto side : {geometry::Side::kLeft, geometry::Side::kRight}) {
+    [Overlay() tuckToSide:side];
+    Pump();
+    auto* event = [[ArciumPiPDragTestEvent alloc] init];
+    event.testWindow = window_;
+    event.testTime = NSProcessInfo.processInfo.systemUptime;
+    NSButton* handle = Button(@"Restore Picture in Picture");
+    ASSERT_TRUE(IsPresented(handle));
+    const NSPoint center = [handle convertPoint:NSMakePoint(NSMidX(handle.bounds), NSMidY(handle.bounds)) toView:nil];
+    event.globalPoint = [window_ convertPointToScreen:center];
+    NSView* down = [window_.contentView hitTest:event.locationInWindow];
+    ASSERT_TRUE(down);
+    [down mouseDown:event];
+    EXPECT_FALSE(IsPresented(handle));
+    // NSWindow resolves the target again for mouse-up; the hidden glyph must
+    // never remove the input surface that completes the click.
+    NSView* up = [window_.contentView hitTest:event.locationInWindow];
+    ASSERT_TRUE(up) << "Hiding the tucked glyph lost the mouse-up target";
+    event.testTime += .1;
+    [up mouseUp:event];
+    EXPECT_FALSE([[Overlay() valueForKey:@"dragging"] boolValue]);
+    for (int i = 0; i < 250; ++i) Pump();
+    ExpectSameFrame(window_.frame, start);
+  }
+}
