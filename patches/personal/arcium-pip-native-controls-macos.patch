+TEST_F(ArciumSystemAppearanceModelTest, PiPEffectsDefaultToEdgeShadingAndNotifyNativeSettings) {
+  int changes = 0;
+  int enabled_defaults = 0;
+  ArciumSettingsModel model(profile(),
+      base::BindLambdaForTesting([&] { ++changes; }), base::DoNothing());
+  for (const auto& effect : arcium::pip::kEffectPreferences) {
+    SCOPED_TRACE(effect.pref);
+    ASSERT_TRUE(model.HasPreference(effect.pref));
+    enabled_defaults += effect.default_enabled;
+    EXPECT_EQ(model.GetBoolean(effect.pref), effect.default_enabled);
+    EXPECT_EQ(profile()->GetPrefs()->GetBoolean(effect.pref), effect.default_enabled);
+    int before = changes;
+    model.SetBoolean(effect.pref,!effect.default_enabled);
+    EXPECT_EQ(profile()->GetPrefs()->GetBoolean(effect.pref), !effect.default_enabled);
+    EXPECT_GT(changes,before);
+    before = changes;
+    profile()->GetPrefs()->SetBoolean(effect.pref,effect.default_enabled);
+    EXPECT_EQ(model.GetBoolean(effect.pref), effect.default_enabled);
+    EXPECT_GT(changes,before);
+  }
+  EXPECT_EQ(enabled_defaults, 1);
+  EXPECT_TRUE(arcium::pip::kEffectPreferences[
+      static_cast<size_t>(arcium::pip::Effect::kEdgeShade)].default_enabled);
+  model.Shutdown();
+  const int stopped = changes;
+  for (const auto& effect : arcium::pip::kEffectPreferences)
+    profile()->GetPrefs()->SetBoolean(effect.pref,!effect.default_enabled);
+  EXPECT_EQ(stopped,changes);
+}
