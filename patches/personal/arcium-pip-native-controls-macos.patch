+@end
+
+@implementation ArciumPiPNativeOverlay
+- (instancetype)initWithWindow:(NSWindow*)window
+                      callback:(ActionCallback)callback {
+  self = [super initWithFrame:window.contentView.bounds];
+  if (!self) {
+    return nil;
+  }
+  _pipWindow = window;
+  _delivery = std::make_shared<Delivery>(Delivery{std::move(callback)});
+  _observers = [NSMutableArray array];
+  _aspect = NSWidth(window.frame) / std::max(1.0, NSHeight(window.frame));
+  _tucked = geo::Side::kNone;
+  self.appearance = [NSAppearance appearanceNamed:NSAppearanceNameDarkAqua];
+  self.accessibilityElement = YES;
+  self.accessibilityRole = NSAccessibilityGroupRole;
+  self.accessibilityLabel = @"Picture in Picture controls";
+  [self buildChrome];
+  [self refreshChrome];
+  __weak ArciumPiPNativeOverlay* weakSelf = self;
+  NSNotificationCenter* center = NSNotificationCenter.defaultCenter;
+  for (NSNotificationName name in @[
+         NSWindowDidResizeNotification, NSWindowDidMoveNotification,
+         NSWindowDidChangeScreenNotification
+       ]) {
+    [_observers addObject:[center addObserverForName:name
+                                              object:window
+                                               queue:NSOperationQueue.mainQueue
+                                          usingBlock:^(NSNotification* note) {
+                                            [weakSelf
+                                                windowGeometryChanged:note];
+                                          }]];
+  }
+  [_observers
+      addObject:[center addObserverForName:
+                            NSApplicationDidChangeScreenParametersNotification
+                                    object:nil
+                                     queue:NSOperationQueue.mainQueue
+                                usingBlock:^(NSNotification* note) {
+                                  [weakSelf screenConfigurationChanged];
+                                }]];
+  [_observers addObject:[center addObserverForName:NSWindowWillCloseNotification
+                                            object:window
+                                             queue:NSOperationQueue.mainQueue
+                                        usingBlock:^(NSNotification* note) {
+                                          [weakSelf invalidate];
+                                        }]];
+  NSNotificationCenter* workspaceCenter =
+      NSWorkspace.sharedWorkspace.notificationCenter;
+  [_observers
+      addObject:
+          [workspaceCenter
+              addObserverForName:
+                  NSWorkspaceAccessibilityDisplayOptionsDidChangeNotification
+                          object:nil
+                           queue:NSOperationQueue.mainQueue
+                      usingBlock:^(NSNotification* note) {
+                        ArciumPiPNativeOverlay* overlay = weakSelf;
+                        if (!overlay || overlay->_invalidated) {
+                          return;
+                        }
+                        [overlay buildChrome];
+                        [overlay refreshChrome];
+                      }]];
+  _eventMonitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:NSEventMaskScrollWheel
+                                   handler:^NSEvent*(NSEvent* event) {
+                                     ArciumPiPNativeOverlay* overlay = weakSelf;
+                                     if (overlay &&
+                                         event.window == overlay->_pipWindow &&
+                                         [overlay consumeScroll:event]) {
+                                       return nil;
+                                     }
+                                     return event;
+                                   }];
+  [self screenConfigurationChanged];
+  return self;
+}
+
+- (void)deliver:(Action)action value:(double)value {
+  std::weak_ptr<Delivery> weak = _delivery;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    auto delivery = weak.lock();
+    if (!delivery || !delivery->callback) {
+      return;
+    }
+    auto callback = delivery->callback;
+    callback(action, value);
+  });
+}
+
+- (NSButton*)button:(NSString*)symbol
+              label:(NSString*)label
+             action:(SEL)action {
+  NSButton* button = [ArciumPiPButton buttonWithImage:Symbol(symbol)
+                                               target:self
+                                               action:action];
+  button.bordered = NO;
+  button.bezelStyle = NSBezelStyleCircular;
+  button.imagePosition = NSImageOnly;
+  button.contentTintColor = NSColor.whiteColor;
+  button.toolTip = label;
+  button.accessibilityLabel = label;
+  button.focusRingType = NSFocusRingTypeExterior;
+  return button;
+}
+
+- (void)buildChrome {
+  BOOL restoreFocus = [self hasControlsFocus];
+  [self releaseControlsFocus];
+  [self endSeek];
+  _slider.beginDrag = nil;
+  _slider.endDrag = nil;
+  _resizeView.resizeEvent = nil;
+  _resizing = NO;
+  [_glassContainer removeFromSuperview];
+  [_slider removeFromSuperview];
+  [_title removeFromSuperview];
+  [_timestamp removeFromSuperview];
+  [_resizeView removeFromSuperview];
+  _glassContent = [[NSView alloc] initWithFrame:self.bounds];
+  _glassContent.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  if (@available(macOS 26.0, *)) {
+    NSGlassEffectContainerView* container =
+        [[NSGlassEffectContainerView alloc] initWithFrame:self.bounds];
+    container.spacing = 0;
+    container.contentView = _glassContent;
+    _glassContainer = container;
+  } else {
+    _glassContainer = [[NSView alloc] initWithFrame:self.bounds];
+    [_glassContainer addSubview:_glassContent];
+  }
+  _glassContainer.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [self addSubview:_glassContainer];
+  _returnButton = [self button:@"pip.exit"
+                         label:@"Return to tab"
+                        action:@selector(returnToTab:)];
+  _tuckButton = [self button:@"rectangle.righthalf.inset.filled.arrow.right"
+                       label:@"Tuck to screen edge"
+                      action:@selector(tuck:)];
