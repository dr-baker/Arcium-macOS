+// Copyright 2026 The Arcium Authors
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_NATIVE_CONTROLS_H_
+#define CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_NATIVE_CONTROLS_H_
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+
+#include "ui/gfx/native_ui_types.h"
+
+#ifdef __OBJC__
+@class NSWindow;
+#else
+class NSWindow;
+#endif
+
+namespace arcium::pip {
+
+enum class Action {
+  kPlayPause,
+  kBack15,
+  kForward15,
+  kSeek,
+  kReturn,
+  kClose,
+  kMute,
+  kSeekBegin,
+  kSeekEnd,
+  kInteraction,
+};
+
+struct State {
+  bool playing = false;
+  bool can_play = false;
+  bool can_seek = false;
+  bool muted = false;
+  bool can_mute = false;
+  bool blocked = false;
+  bool show_controls = false;
+  bool show_title = false;
+  double position = 0;
+  double duration = 0;
+  double playback_rate = 1;
+  uint32_t accent = 0xFFACB9CF;
+  std::u16string title;
+};
+
+// Actions are delivered asynchronously on the main queue and canceled on
+// teardown. kSeek carries a normalized fraction. SeekBegin/End carry resume
+// intent (0 or 1).
+using ActionCallback = std::function<void(Action, double)>;
+
+// Construct/update/destroy on the main thread, after native widget
+// initialization. The caller attaches the returned view with NativeViewHost
+// and detaches it before destroying the controls. Video transport is unchanged.
+class NativeControls {
+ public:
+  NativeControls(NSWindow* window, ActionCallback callback);
+  ~NativeControls();
+  NativeControls(const NativeControls&) = delete;
+  NativeControls& operator=(const NativeControls&) = delete;
+  gfx::NativeView GetNativeView() const;
+  void SetAccessibilityParent(gfx::NativeViewAccessible parent);
+  void FocusControls(bool reverse);
+  void ReleaseFocus();
+  void SetBeforeFocusRelease(std::function<void()> callback);
+  void Update(const State& state);
+  void RestorePlacementForHide();
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace arcium::pip
+#endif
