+- (NSView*)hitTest:(NSPoint)point {
+  if (_invalidated || _state.blocked) {
+    return nil;
+  }
+  NSPoint local = [self convertPoint:point fromView:self.superview];
+  if (!NSPointInRect(local, self.bounds)) {
+    return nil;
+  }
+  if (!_nativeVisible && _tucked == geo::Side::kNone) {
+    return self;
+  }
+  for (NSView* control in @[
+         _slider, _resizeView, _restoreButton, _returnButton, _tuckButton,
+         _closeButton, _playButton, _backButton, _forwardButton, _muteButton
+       ]) {
+    if (control.hiddenOrHasHiddenAncestor ||
+        control.superview.alphaValue == 0 || control.alphaValue == 0) {
+      continue;
+    }
+    NSPoint p = [control convertPoint:local fromView:self];
+    if (NSPointInRect(p, control.bounds)) {
+      return control;
+    }
+  }
+  return _tucked == geo::Side::kNone ? self : nil;
+}
+- (BOOL)acceptsFirstMouse:(NSEvent*)event {
+  return !_state.blocked;
+}
+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (_tracking) {
+    [self removeTrackingArea:_tracking];
+  }
+  _tracking = [[NSTrackingArea alloc]
+      initWithRect:NSZeroRect
+           options:NSTrackingMouseEnteredAndExited | NSTrackingMouseMoved |
+                   NSTrackingActiveAlways | NSTrackingInVisibleRect
+             owner:self
+          userInfo:nil];
+  [self addTrackingArea:_tracking];
+}
+- (void)armHideTimer {
+  [_hideTimer invalidate];
+  if (_seeking || [self hasControlsFocus] || _state.blocked ||
+      _tucked != geo::Side::kNone) {
+    return;
+  }
+  __weak ArciumPiPNativeOverlay* weakSelf = self;
+  _hideTimer = [NSTimer
+      scheduledTimerWithTimeInterval:3
+                             repeats:NO
+                               block:^(NSTimer* timer) {
+                                 ArciumPiPNativeOverlay* overlay = weakSelf;
+                                 if (!overlay || overlay->_invalidated ||
+                                     overlay->_seeking ||
+                                     [overlay hasControlsFocus]) {
+                                   return;
+                                 }
+                                 overlay->_nativeVisible = NO;
+                                 [overlay refreshChrome];
+                               }];
+}
+- (void)mouseEntered:(NSEvent*)event {
+  _mouseInside = YES;
+  if (_state.blocked || _tucked != geo::Side::kNone) {
+    return;
+  }
+  _nativeVisible = YES;
+  [self refreshChrome];
+  [self armHideTimer];
+}
+- (void)mouseMoved:(NSEvent*)event {
+  _mouseInside = YES;
+  if (_state.blocked || _tucked != geo::Side::kNone) {
+    return;
+  }
+  if (!_nativeVisible) {
+    _nativeVisible = YES;
+    [self refreshChrome];
+  }
+  [self armHideTimer];
+}
+- (void)mouseExited:(NSEvent*)event {
+  _mouseInside = NO;
+  if (!_seeking && !_dragging && ![self hasControlsFocus]) {
+    _nativeVisible = NO;
+    [self refreshChrome];
+  }
+}
+- (void)mouseDown:(NSEvent*)event {
+  if (_state.blocked || _tucked != geo::Side::kNone) {
+    return;
+  }
+  __attribute__((objc_precise_lifetime)) ArciumPiPNativeOverlay* keepAlive =
+      self;
+  (void)keepAlive;
+  [self deliver:Action::kInteraction value:0];
+  _dragging = YES;
+  _nativeVisible = NO;
+  [self refreshChrome];
+  const uint64_t session = _sessionGeneration;
+  [_pipWindow performWindowDragWithEvent:event];
+  if (_invalidated || session != _sessionGeneration) {
+    return;
+  }
+  _dragging = NO;
+  NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+  NSPoint pointer = NSEvent.mouseLocation;
+  if (screen && (pointer.x <= NSMinX(screen.frame) + 8 ||
+                 pointer.x >= NSMaxX(screen.frame) - 8)) {
+    [self tuckToSide:pointer.x <= NSMinX(screen.frame) + 8 ? geo::Side::kLeft
+                                                           : geo::Side::kRight];
+    return;
+  }
+  [self snap];
+  _nativeVisible = YES;
+  [self refreshChrome];
+  [self armHideTimer];
+}
+
+- (NSScreen*)anchorScreen {
+  for (NSScreen* screen in NSScreen.screens) {
+    if ([screen.deviceDescription[@"NSScreenNumber"] isEqual:_anchorDisplay]) {
+      return screen;
+    }
+  }
+  return _pipWindow.screen ?: NSScreen.mainScreen ?: NSScreen.screens.firstObject;
+}
+- (void)rememberScreen:(NSScreen*)screen {
+  _anchorDisplay = screen.deviceDescription[@"NSScreenNumber"];
+}
+- (void)setWindowFrame:(NSRect)frame animate:(BOOL)animate {
+  if (!_pipWindow) {
+    return;
+  }
+  _adjusting = YES;
+  [_pipWindow setFrame:frame display:YES animate:animate && !ReduceMotion()];
+  _adjusting = NO;
+}
+- (void)snap {
+  NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  [self rememberScreen:screen];
+  _corner =
+      geo::NearestCorner(ToRect(_pipWindow.frame), ToRect(screen.visibleFrame));
+  NSRect frame = ToNSRect(geo::Anchor(ToRect(_pipWindow.frame),
+                                      ToRect(screen.visibleFrame), _corner));
+  [self setWindowFrame:frame animate:YES];
+  _restoreFrame = frame;
+}
+- (void)tuckToSide:(geo::Side)side {
+  if (_state.blocked || !_pipWindow) {
+    return;
+  }
+  NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  _restoreDisplay = screen.deviceDescription[@"NSScreenNumber"];
+  _restoreFrame = ToNSRect(
+      geo::Clamp(ToRect(_pipWindow.frame), ToRect(screen.visibleFrame)));
+  _corner =
+      geo::NearestCorner(ToRect(_restoreFrame), ToRect(screen.visibleFrame));
+  // At an interior display seam the window would remain visible on a neighbor.
+  // Find the exterior desktop edge at this vertical band before stashing.
+  for (NSScreen* candidate in NSScreen.screens) {
+    if (NSMaxY(candidate.frame) <= NSMinY(_restoreFrame) ||
+        NSMinY(candidate.frame) >= NSMaxY(_restoreFrame)) {
+      continue;
+    }
+    if ((side == geo::Side::kLeft &&
+         NSMinX(candidate.frame) < NSMinX(screen.frame)) ||
+        (side == geo::Side::kRight &&
+         NSMaxX(candidate.frame) > NSMaxX(screen.frame))) {
+      screen = candidate;
+    }
+  }
+  [self rememberScreen:screen];
+  _tucked = side;
+  _nativeVisible = NO;
+  [self refreshChrome];
+  [self setWindowFrame:ToNSRect(geo::Tuck(ToRect(_restoreFrame),
+                                          ToRect(screen.frame),
+                                          ToRect(screen.visibleFrame), side))
+               animate:YES];
+}
+- (void)restore:(id)sender {
+  if (_state.blocked || _tucked == geo::Side::kNone) {
+    return;
+  }
+  NSScreen* screen = [self anchorScreen];
+  for (NSScreen* candidate in NSScreen.screens) {
+    if ([candidate.deviceDescription[@"NSScreenNumber"]
+            isEqual:_restoreDisplay]) {
+      screen = candidate;
+    }
+  }
+  [self rememberScreen:screen];
+  _tucked = geo::Side::kNone;
+  if (screen) {
+    [self setWindowFrame:ToNSRect(geo::Clamp(ToRect(_restoreFrame),
+                                             ToRect(screen.visibleFrame)))
+                 animate:YES];
+  }
+  _nativeVisible = YES;
+  [self refreshChrome];
+  [self armHideTimer];
+}
+- (void)tuck:(id)sender {
+  if (_state.blocked) {
+    return;
+  }
+  NSScreen* screen = _pipWindow.screen ?: [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  [self tuckToSide:NSMidX(_pipWindow.frame) < NSMidX(screen.frame)
+                       ? geo::Side::kLeft
+                       : geo::Side::kRight];
+}
+- (void)windowGeometryChanged:(NSNotification*)note {
+  if (_invalidated) {
+    return;
+  }
+  [self setNeedsLayout:YES];
+  if (_adjusting || _dragging || _scrolling || _resizing) {
+    return;
+  }
+  _aspect =
+      NSWidth(_pipWindow.frame) / std::max(1.0, NSHeight(_pipWindow.frame));
+  if (_tucked != geo::Side::kNone) {
+    _restoreFrame.size = _pipWindow.frame.size;
+    [self screenConfigurationChanged];
+    return;
+  }
+  if (_pipWindow.screen) {
+    [self rememberScreen:_pipWindow.screen];
+  }
+}
+- (void)screenConfigurationChanged {
+  if (_invalidated || !_pipWindow) {
+    return;
+  }
+  NSScreen* screen = [self anchorScreen];
+  if (!screen) {
+    return;
+  }
+  [self rememberScreen:screen];
+  if (_tucked == geo::Side::kNone) {
+    _corner = geo::NearestCorner(ToRect(_pipWindow.frame),
+                                 ToRect(screen.visibleFrame));
+    [self setWindowFrame:ToNSRect(geo::Anchor(ToRect(_pipWindow.frame),
+                                              ToRect(screen.visibleFrame),
+                                              _corner))
+                 animate:NO];
+  } else {
+    NSScreen* restoreScreen = screen;
+    for (NSScreen* candidate in NSScreen.screens) {
+      if ([candidate.deviceDescription[@"NSScreenNumber"]
+              isEqual:_restoreDisplay]) {
+        restoreScreen = candidate;
+      }
+    }
+    _restoreFrame = ToNSRect(geo::Anchor(
+        ToRect(_restoreFrame), ToRect(restoreScreen.visibleFrame), _corner));
+    [self setWindowFrame:ToNSRect(geo::Tuck(
+                             ToRect(_restoreFrame), ToRect(screen.frame),
+                             ToRect(screen.visibleFrame), _tucked))
+                 animate:NO];
+  }
+}
