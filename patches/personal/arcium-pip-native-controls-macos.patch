Index: src/chrome/browser/ui/views/overlay/arcium_pip_native_controls_unittest.mm
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/views/overlay/arcium_pip_native_controls_unittest.mm
@@ -0,0 +1,920 @@
+// Copyright 2026 The Arcium Authors
+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/browser/ui/views/overlay/arcium_pip_native_controls.h"
+
+#import <AppKit/AppKit.h>
+
+#include <algorithm>
+#include <cmath>
+#include <memory>
+#include <vector>
+
+#include "chrome/browser/ui/views/overlay/video_overlay_window_views.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "testing/gtest_mac.h"
+#include "ui/base/hit_test.h"
+#include "ui/base/test/cocoa_helper.h"
+#include "ui/events/test/cocoa_test_event_utils.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/root_view.h"
+
+// These selectors inject input at the native overlay boundary. Expectations
+// below inspect control presentation, emitted actions, and native window
+// frames.
+@interface NSView (ArciumPiPNativeControlsTestInput)
+- (void)beginSeek;
+- (void)buildChrome;
+- (void)seek:(id)sender;
+- (void)endSeek;
+- (void)snap;
+- (BOOL)consumeScroll:(NSEvent*)event;
+@end
+
+@interface ArciumPiPMagnificationTestEvent : NSEvent
+@property NSEventPhase testPhase;
+@property CGFloat testMagnitude;
+@end
+@implementation ArciumPiPMagnificationTestEvent
+- (NSEventPhase)phase {
+  return self.testPhase;
+}
+- (CGFloat)magnification {
+  return self.testMagnitude;
+}
+@end
+
+@interface ArciumPiPDragTestEvent : NSEvent
+@property(nonatomic, weak) NSWindow* testWindow;
+@property NSPoint globalPoint;
+@property double testTime;
+@end
+@implementation ArciumPiPDragTestEvent
+- (NSWindow*)window { return self.testWindow; }
+- (NSPoint)locationInWindow { return [self.testWindow convertPointFromScreen:self.globalPoint]; }
+- (NSTimeInterval)timestamp { return self.testTime; }
+@end
+
+namespace arcium::pip {
+namespace {
+
+struct EmittedAction {
+  Action action;
+  double value;
+};
+
+NSView* FindAccessibleView(NSView* root, NSString* label) {
+  if ([root.accessibilityLabel isEqualToString:label]) {
+    return root;
+  }
+  for (NSView* child in root.subviews) {
+    if (NSView* found = FindAccessibleView(child, label)) {
+      return found;
+    }
+  }
+  return nil;
+}
+
+bool IsPresented(NSView* view) {
+  if (!view || view.hiddenOrHasHiddenAncestor) {
+    return false;
+  }
+  for (NSView* ancestor = view; ancestor; ancestor = ancestor.superview) {
+    if (ancestor.alphaValue == 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void ExpectSameFrame(NSRect actual, NSRect expected) {
+  EXPECT_NEAR(NSMinX(actual), NSMinX(expected), 0.5);
+  EXPECT_NEAR(NSMinY(actual), NSMinY(expected), 0.5);
+  EXPECT_NEAR(NSWidth(actual), NSWidth(expected), 0.5);
+  EXPECT_NEAR(NSHeight(actual), NSHeight(expected), 0.5);
+}
+
+class ArciumPiPNativeControlsTest : public ui::CocoaTest {
+ public:
+  void SetUp() override {
+    ui::CocoaTest::SetUp();
+    ASSERT_TRUE(NSThread.isMainThread);
+    if (NSScreen.screens.count == 0) {
+      GTEST_SKIP() << "Requires a native display";
+    }
+    NSScreen* screen = NSScreen.mainScreen ?: NSScreen.screens.firstObject;
+    NSRect area = screen.visibleFrame;
+    window_ = [[NSWindow alloc]
+        initWithContentRect:NSMakeRect(NSMidX(area) - 200, NSMidY(area) - 112.5,
+                                       400, 225)
+                  styleMask:NSWindowStyleMaskBorderless
+                    backing:NSBackingStoreBuffered
+                      defer:YES];
+    window_.releasedWhenClosed = NO;
+    // The production surface is mounted into this window, which stays hidden
+    // for the complete test. No orderFront, key-window, or app activation
+    // calls.
+    controls_ = std::make_unique<NativeControls>(
+        window_, [this](Action action, double value) {
+          actions_.push_back({action, value});
+        });
+    MountControls();
+    state_.can_play = true;
+    state_.can_seek = true;
+    state_.can_mute = true;
+    state_.show_controls = true;
+    state_.show_title = true;
+    state_.position = 42;
+    state_.duration = 100;
+    state_.playback_rate = 0;
+    state_.title = u"Native PiP test";
+    Update();
+    ASSERT_FALSE(window_.visible);
+    ASSERT_TRUE(Overlay());
+  }
+
+  void TearDown() override {
+    DestroyControls();
+    if (window_) {
+      EXPECT_FALSE(window_.visible);
+      [window_ close];
+      window_ = nil;
+    }
+    Pump();
+    ui::CocoaTest::TearDown();
+  }
+
+ protected:
+  void MountControls() {
+    NSView* view = controls_->GetNativeView().GetNativeNSView();
+    view.frame = window_.contentView.bounds;
+    view.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    [window_.contentView addSubview:view];
+  }
+  void DestroyControls() {
+    if (!controls_) {
+      return;
+    }
+    [controls_->GetNativeView().GetNativeNSView() removeFromSuperview];
+    controls_.reset();
+  }
+  NSView* Overlay() {
+    return FindAccessibleView(window_.contentView,
+                              @"Picture in Picture controls");
+  }
+  NSButton* Button(NSString* label) {
+    NSView* view = FindAccessibleView(window_.contentView, label);
+    return [view isKindOfClass:NSButton.class] ? static_cast<NSButton*>(view)
+                                               : nil;
+  }
+  NSSlider* Slider() {
+    NSView* view =
+        FindAccessibleView(window_.contentView, @"Playback position");
+    return [view isKindOfClass:NSSlider.class] ? static_cast<NSSlider*>(view)
+                                               : nil;
+  }
+  void Pump() {
+    // NativeControls posts onto the main dispatch queue. CocoaTest initializes
+    // AppKit; its native run loop delivers these blocks without displaying UI.
+    [window_.contentView layoutSubtreeIfNeeded];
+    CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+    [window_.contentView layoutSubtreeIfNeeded];
+  }
+  void Update() {
+    controls_->Update(state_);
+    [window_.contentView layoutSubtreeIfNeeded];
+    Pump();
+  }
+  void Resize(NSSize size) {
+    [window_ setContentSize:size];
+    [window_.contentView layoutSubtreeIfNeeded];
+    Pump();
+    EXPECT_NEAR(NSWidth(Overlay().bounds), NSWidth(window_.contentView.bounds),
+                0.5);
+    EXPECT_NEAR(NSHeight(Overlay().bounds),
+                NSHeight(window_.contentView.bounds), 0.5);
+  }
+  size_t Count(Action action) const {
+    return std::count_if(actions_.begin(), actions_.end(),
+                         [action](const EmittedAction& emitted) {
+                           return emitted.action == action;
+                         });
+  }
+  bool Scroll(NSEventPhase phase, CGFloat dx = 0, CGFloat dy = 0) {
+    NSPoint background =
+        NSMakePoint(20, NSHeight(window_.contentView.bounds) * 0.5);
+    NSButton* restore = Button(@"Restore Picture in Picture");
+    if (IsPresented(restore)) {
+      background = [restore convertPoint:NSMakePoint(NSMidX(restore.bounds),
+                                                     NSMidY(restore.bounds))
+                                  toView:nil];
+    }
+    background.x = std::round(background.x);
+    background.y = std::round(background.y);
+    NSEvent* event = cocoa_test_event_utils::TestScrollEvent(
+        background, window_, dx, dy, true, phase, NSEventPhaseNone);
+    EXPECT_EQ(event.phase, phase);
+    EXPECT_TRUE(event.hasPreciseScrollingDeltas);
+    return [Overlay() consumeScroll:event];
+  }
+  void ExpectPresentedWithinOverlay(NSView* control) {
+    ASSERT_TRUE(IsPresented(control));
+    NSRect bounds = [control convertRect:control.bounds toView:Overlay()];
+    EXPECT_TRUE(NSContainsRect(Overlay().bounds, bounds))
+        << "overlay=" << NSStringFromRect(Overlay().bounds).UTF8String
+        << " control=" << NSStringFromRect(bounds).UTF8String;
+  }
+
+  NSWindow* __strong window_ = nil;
+  std::unique_ptr<NativeControls> controls_;
+  State state_;
+  std::vector<EmittedAction> actions_;
+};
