+- (void)applyState:(const State&)state {
+  if (_invalidated) {
+    return;
+  }
+  if (state.blocked) {
+    [self cancelReturn];
+    [self stopMotion];
+    [self releaseControlsFocus];
+  }
+  if (state.blocked && _tucked != geo::Side::kNone) {
+    [self restoreAnimated:NO];
+  }
+  if ((state.blocked || !state.can_seek) && _seeking) {
+    [self endSeek];
+  }
+  const BOOL reveal = !_hasSnapshot ? state.show_controls :
+      state.show_controls && !_state.show_controls && !_mouseInside;
+  if (!_hasSnapshot) _nativeVisible = state.show_controls;
+  else if (reveal) _nativeVisible = YES;
+  const bool limits_changed = !(_sizeLimits == state.size_limits);
+  _sizeLimits = state.size_limits;
+  const bool effects_changed = _state.effects != state.effects;
+  _state = state;
+  [self configureEffects];
+  if (!std::isfinite(_state.position)) {
+    _state.position = 0;
+  }
+  if (!std::isfinite(_state.duration) || _state.duration <= 0) {
+    _state.can_seek = false;
+  }
+  if (!std::isfinite(_state.playback_rate)) {
+    _state.playback_rate = 0;
+  }
+  _snapshotTime = NSProcessInfo.processInfo.systemUptime;
+  _hasSnapshot = YES;
+  if (limits_changed && _placementReady && _pipWindow.visible &&
+      !_state.blocked && !_dragging && !_resizing && !_scrolling &&
+      !_magnifying) {
+    [self reanchor:_aspect limits:_sizeLimits];
+  }
+  [self refreshChrome];
+  if (reveal) [self armHideTimer];
+  if ([self hasControlsFocus] && ![self chromeSuppressed]) {
+    [self layoutSubtreeIfNeeded];
+    NSView* focused = (NSView*)_pipWindow.firstResponder;
+    if (focused.hiddenOrHasHiddenAncestor ||
+        ([focused isKindOfClass:NSControl.class] &&
+         !((NSControl*)focused).enabled)) {
+      if ([self keepsKeyboardControlsVisible]) [self focusControls:NO];
+      else [self releaseControlsFocus];
+    }
+  }
+  const bool needs_presentation = !motion && _state.HasVisualEffects() &&
+      _pipWindow.visible && self.window == _pipWindow && !_state.blocked &&
+      !_returning && !_resizing && !_pipWindow.inLiveResize;
+  if (effects_changed || needs_presentation) {
+    if (_magnifying || _resizing) {
+      // Keep resize ownership intact. Recreate decoration at the final size
+      // when the gesture completes, never at an intermediate size.
+      [self clearMotionPresentation];
+    } else if (motion || (needs_presentation && [self ensureMotion])) {
+      const BOOL done = [self updateMotionVisuals];
+      if (!done || motion->phase == Phase::Dragging || motion->phase == Phase::Settling)
+        [self startMotionTimer];
+    }
+  }
+  if (_returning && !_state.HasEffect(Effect::kReturn) && !_state.blocked) {
+    [self cancelReturn]; [self deliver:Action::kReturn value:0];
+  }
+}
+
+- (double)currentPosition {
+  double time = _state.position;
+  if (_state.playing && !_seeking) {
+    time += (NSProcessInfo.processInfo.systemUptime - _snapshotTime) *
+            _state.playback_rate;
+  }
+  return std::clamp(time, 0.0, std::max(0.0, _state.duration));
+}
+- (void)updateProgress {
+  if (_seeking) {
+    return;
+  }
+  double position = [self currentPosition];
+  _slider.doubleValue = _state.duration > 0 ? position / _state.duration : 0;
+  _timestamp.stringValue =
+      [NSString stringWithFormat:@"%@ / %@", TimeLabel(position),
+                                 TimeLabel(_state.duration)];
+  _slider.accessibilityValueDescription =
+      [NSString stringWithFormat:@"%@ of %@", TimeLabel(position),
+                                 TimeLabel(_state.duration)];
+}
+- (BOOL)chromeSuppressed {
+  return _dragging || _scrolling || _magnifying || _resizing || _liveResizing ||
+      _pipWindow.inLiveResize || _returning ||
+      (motion && motion->phase == Phase::Settling);
+}
+- (NSArray<ArciumPiPCapsule*>*)contrastCapsules {
+  // Stable ContrastControl slots, including currently hidden seek buttons.
+  return @[(ArciumPiPCapsule*)_returnGlass, (ArciumPiPCapsule*)_tuckGlass,
+           (ArciumPiPCapsule*)_closeGlass, (ArciumPiPCapsule*)_playGlass,
+           (ArciumPiPCapsule*)_backGlass, (ArciumPiPCapsule*)_forwardGlass,
+           (ArciumPiPCapsule*)_muteGlass];
+}
+- (ContrastRequest)contrastRequest {
+  ContrastRequest request;
+  NSArray<ArciumPiPCapsule*>* capsules = [self contrastCapsules];
+  for (NSUInteger i = 0; i < capsules.count; ++i) {
+    const NSRect frame = [capsules[i] convertRect:capsules[i].bounds toView:self];
+    request.regions[i] = arcium::pip::NormalizeContrastRegion(ToRect(frame), ToRect(self.bounds));
+  }
+  return request;
+}
+- (void)sampleBrightness {
+  if (_invalidated || _brightnessPending || !_brightnessSampler ||
+      [self chromeSuppressed] || !_nativeVisible || _state.blocked ||
+      _tucked != geo::Side::kNone || !_pipWindow.visible) return;
+  const double now = NSProcessInfo.processInfo.systemUptime;
+  if (_lastBrightnessRequest >= 0 && now - _lastBrightnessRequest < 1) return;
+  [self layoutSubtreeIfNeeded];
+  const ContrastRequest request = [self contrastRequest];
+  _lastBrightnessRequest = now;
+  _brightnessPending = YES;
+  const NSUInteger generation = _brightnessGeneration;
+  __weak ArciumPiPNativeOverlay* weakSelf = self;
+  _brightnessSampler(request, [weakSelf, generation, request](ContrastSamples brightness) {
+    ArciumPiPNativeOverlay* view = weakSelf;
+    if (!view || view->_invalidated) return;
+    view->_brightnessPending = NO;
+    if (generation != view->_brightnessGeneration || [view chromeSuppressed]) return;
+    [view layoutSubtreeIfNeeded];
+    if (!(request == [view contrastRequest])) return;
+    view->_buttonBrightness = brightness;
+    [view refreshChrome];
+  });
+}
+- (void)refreshChrome {
+  if (_invalidated) {
+    return;
+  }
+  const BOOL suppressed = [self chromeSuppressed];
+  const BOOL visible = _nativeVisible && !_state.blocked && !suppressed &&
+      _tucked == geo::Side::kNone;
+  [self setNeedsLayout:YES];
+  // GPU-downscaled video samples only while stationary chrome is visible.
+  if (!visible) {
+    if (_brightnessTimer) ++_brightnessGeneration;
+    [_brightnessTimer invalidate]; _brightnessTimer = nil;
+  } else if (_brightnessSampler && !_brightnessTimer) {
+    __weak ArciumPiPNativeOverlay* weakSelf = self;
+    _brightnessTimer = [NSTimer timerWithTimeInterval:1 repeats:YES block:^(NSTimer*) {
+      [weakSelf sampleBrightness];
+    }];
+    _brightnessTimer.tolerance = .2;
+    [NSRunLoop.mainRunLoop addTimer:_brightnessTimer forMode:NSRunLoopCommonModes];
+    [self sampleBrightness];
+  }
+  NSArray<ArciumPiPCapsule*>* capsules = [self contrastCapsules];
+  for (NSUInteger i = 0; i < capsules.count; ++i)
+    [capsules[i] applyBrightness:_buttonBrightness.values[i] animate:visible];
+  _glassContainer.hidden = _state.blocked || suppressed ||
+      (!visible && _tucked == geo::Side::kNone);
+  const BOOL animate = !suppressed && !_state.blocked && _tucked == geo::Side::kNone;
+  for (NSView* view in @[ _returnGlass, _tuckGlass, _closeGlass ]) {
+    Present(view, visible, animate);
+  }
+  _restoreHost.hidden = suppressed || _state.blocked || _tucked == geo::Side::kNone;
+  Present(_slider, visible && _state.can_seek, animate);
+  Present(_timestamp, visible && _state.can_seek, animate);
+  Present(_hoverShade, visible, animate);
+  const BOOL titleVisible = !suppressed && !_state.blocked && _tucked == geo::Side::kNone &&
+      (visible || _state.show_title) && !_state.title.empty();
+  Present(_vignetteView, visible || titleVisible, animate);
+  Present(_title,
+          !suppressed && !_state.blocked && _tucked == geo::Side::kNone &&
+              (visible || _state.show_title) && !_state.title.empty(),
+          animate);
+  Present(_resizeView, visible, animate);
+  Present(_playGlass, visible && _state.can_play, animate);
+  Present(_muteGlass, visible && _state.can_mute, animate);
+  if (visible) _playButton.image = Symbol(_state.playing ? @"pause.fill" : @"play.fill", 20 * std::max(.8,_controlScale));
+  _playButton.accessibilityLabel = _state.playing ? @"Pause" : @"Play";
+  _playButton.cell.accessibilityLabel = _playButton.accessibilityLabel;
+  _playButton.toolTip = _playButton.accessibilityLabel;
+  if (visible) _muteButton.image =
+      Symbol(_state.muted ? @"speaker.slash.fill" : @"speaker.wave.2.fill", 13 * std::max(.8,_controlScale));
+  _muteButton.accessibilityLabel = _state.muted ? @"Unmute" : @"Mute";
+  _muteButton.cell.accessibilityLabel = _muteButton.accessibilityLabel;
+  _muteButton.toolTip = _muteButton.accessibilityLabel;
+  _title.stringValue = [[NSString alloc]
+      initWithCharacters:reinterpret_cast<const unichar*>(_state.title.data())
+                  length:_state.title.size()];
+  _title.toolTip = _title.stringValue;
+  _slider.enabled = _state.can_seek;
+  NSColor* accent = Accent(_state.accent);
+  ((ArciumPiPSliderCell*)_slider.cell).accent = accent;
+  if (!suppressed) _restoreButton.image =
+      Symbol(_tucked == geo::Side::kLeft ? @"chevron.right" : @"chevron.left", 18);
+  if (visible) [self updateProgress];
+  BOOL tick = visible && _state.playing && _state.can_seek && !_seeking &&
+              self.window.visible;
+  if (!tick) {
+    [_progressTimer invalidate];
+    _progressTimer = nil;
+  } else if (!_progressTimer) {
+    __weak ArciumPiPNativeOverlay* weakSelf = self;
+    _progressTimer = [NSTimer
+        scheduledTimerWithTimeInterval:0.1
+                               repeats:YES
