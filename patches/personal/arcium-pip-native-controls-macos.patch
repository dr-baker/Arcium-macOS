+@interface ArciumPiPButton : NSButton
+@property(nonatomic, copy) void (^dragEvent)(NSEvent*, NSInteger);
+@end
+namespace {
+bool HandleNativeTab(NSView* control, NSEvent* event) {
+  if (event.keyCode != 48) {
+    return false;
+  }
+  NSView* next = (event.modifierFlags & NSEventModifierFlagShift)
+                     ? control.previousValidKeyView
+                     : control.nextValidKeyView;
+  if (next) {
+    [control.window makeFirstResponder:next];
+  }
+  return true;
+}
+}  // namespace
+@implementation ArciumPiPButton
+- (void)mouseDown:(NSEvent*)event { if (self.dragEvent) self.dragEvent(event, 0); else [super mouseDown:event]; }
+- (void)mouseDragged:(NSEvent*)event { if (self.dragEvent) self.dragEvent(event, 1); else [super mouseDragged:event]; }
+- (void)mouseUp:(NSEvent*)event { if (self.dragEvent) self.dragEvent(event, 2); else [super mouseUp:event]; }
+- (BOOL)acceptsFirstResponder {
+  return YES;
+}
+- (BOOL)canBecomeKeyView {
+  return self.enabled && !self.hiddenOrHasHiddenAncestor;
+}
+- (void)keyDown:(NSEvent*)event {
+  if (!HandleNativeTab(self, event)) {
+    [super keyDown:event];
+  }
+}
+- (BOOL)acceptsFirstMouse:(NSEvent*)event {
+  return YES;
+}
+@end
+
+@interface ArciumPiPSliderCell : NSSliderCell
+@property(nonatomic, strong) NSColor* accent;
+@end
+@implementation ArciumPiPSliderCell
+@synthesize accent = _accent;
+- (void)drawBarInside:(NSRect)rect flipped:(BOOL)flipped {
+  NSRect track = NSMakeRect(NSMinX(rect), NSMidY(rect) - 1.5, NSWidth(rect), 3);
+  [[NSColor colorWithWhite:1 alpha:0.25] setFill];
+  [[NSBezierPath bezierPathWithRoundedRect:track xRadius:1.5 yRadius:1.5] fill];
+  double fraction = (self.doubleValue - self.minValue) /
+                    std::max(0.001, self.maxValue - self.minValue);
+  track.size.width *= std::clamp(fraction, 0.0, 1.0);
+  [[NSColor colorWithWhite:1 alpha:0.92] setFill];
+  [[NSBezierPath bezierPathWithRoundedRect:track xRadius:1.5 yRadius:1.5] fill];
+}
+- (void)drawKnob:(NSRect)rect {
+  NSRect knob = NSMakeRect(NSMidX(rect) - 5, NSMidY(rect) - 5, 10, 10);
+  [[NSColor colorWithWhite:0 alpha:0.28] setFill];
+  [[NSBezierPath bezierPathWithOvalInRect:NSInsetRect(knob, -0.5, -0.5)] fill];
+  [NSColor.whiteColor setFill];
+  [[NSBezierPath bezierPathWithOvalInRect:knob] fill];
+  [[self.accent colorWithAlphaComponent:0.52] setFill];
+  [[NSBezierPath bezierPathWithOvalInRect:NSInsetRect(knob, 2, 2)] fill];
+}
+@end
+
