+// Copyright 2026 The Arcium Authors
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_GEOMETRY_H_
+#define CHROME_BROWSER_UI_VIEWS_OVERLAY_ARCIUM_PIP_GEOMETRY_H_
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <limits>
+#include <optional>
+#include <span>
+
+namespace arcium::pip::geometry {
+struct Rect {
+  double x, y, width, height;
+};
+struct SizeLimits {
+  double minimum_width = 284;
+  double minimum_height = 160;
+  double maximum_width = std::numeric_limits<double>::infinity();
+  double maximum_height = std::numeric_limits<double>::infinity();
+  bool operator==(const SizeLimits&) const = default;
+};
+enum class Corner { kBottomLeft, kBottomRight, kTopLeft, kTopRight };
+enum class Side { kNone, kLeft, kRight };
+constexpr double kMargin = 21.93;
+constexpr double kHandleWidth = 26.35;
+inline Rect Normalize(Rect r) {
+  r.x = std::isfinite(r.x) ? r.x : 0;
+  r.y = std::isfinite(r.y) ? r.y : 0;
+  r.width = std::isfinite(r.width) ? std::max(0.0, r.width) : 0;
+  r.height = std::isfinite(r.height) ? std::max(0.0, r.height) : 0;
+  return r;
+}
+inline Rect ClampPosition(Rect r, Rect area) {
+  area = Normalize(area);
+  r = Normalize(r);
+  r.x = std::clamp(r.x, area.x, area.x + std::max(0.0, area.width - r.width));
+  r.y = std::clamp(r.y, area.y, area.y + std::max(0.0, area.height - r.height));
+  return r;
+}
+inline Rect Fit(Rect r, Rect area) {
+  area = Normalize(area);
+  r = Normalize(r);
+  double scale = 1;
+  if (r.width > area.width) {
+    scale = std::min(scale, area.width / r.width);
+  }
+  if (r.height > area.height) {
+    scale = std::min(scale, area.height / r.height);
+  }
+  r.width *= scale;
+  r.height *= scale;
+  return ClampPosition(r, area);
+}
+inline Corner NearestCorner(Rect r, Rect area) {
+  r = Normalize(r);
+  area = Normalize(area);
+  bool right = r.x + r.width / 2 > area.x + area.width / 2;
+  bool top = r.y + r.height / 2 > area.y + area.height / 2;
+  return top ? (right ? Corner::kTopRight : Corner::kTopLeft)
+             : (right ? Corner::kBottomRight : Corner::kBottomLeft);
+}
+inline Rect Anchor(Rect r, Rect area, Corner corner) {
+  area = Normalize(area);
+  r = Fit(r, area);
+  const double mx = std::min(kMargin, (area.width - r.width) / 2);
+  const double my = std::min(kMargin, (area.height - r.height) / 2);
+  const bool right =
+      corner == Corner::kBottomRight || corner == Corner::kTopRight;
+  const bool top = corner == Corner::kTopLeft || corner == Corner::kTopRight;
+  r.x = right ? area.x + area.width - r.width - mx : area.x + mx;
+  r.y = top ? area.y + area.height - r.height - my : area.y + my;
+  return r;
+}
+inline Rect Tuck(Rect r, Rect screen, Rect work_area, Side side) {
+  screen = Normalize(screen);
+  r = Fit(r, work_area);
+  if (side == Side::kNone) {
+    return r;
+  }
+  const double handle = std::min({kHandleWidth, screen.width, r.width});
+  r.x = side == Side::kLeft ? screen.x - r.width + handle
+                            : screen.x + screen.width - handle;
+  return r;
+}
+struct Screen {
+  Rect frame;
+  Rect work_area;
+};
+struct Edges {
+  bool left = true, right = true, bottom = true, top = true;
+};
+// A seam is traversable if a neighboring display overlaps any of the card's
+// span across that edge. Gaps and uncovered portions remain exterior.
+inline Edges ExteriorEdges(Rect card, std::span<const Screen> screens, size_t active) {
+  Edges edges;
+  if (active >= screens.size()) return edges;
+  const Rect own = screens[active].frame;
+  for (size_t i = 0; i < screens.size(); ++i) {
+    if (i == active) continue;
+    const Rect other = screens[i].frame;
+    const bool vertical = card.y < other.y + other.height && card.y + card.height > other.y;
+    const bool horizontal = card.x < other.x + other.width && card.x + card.width > other.x;
+    if (vertical && other.x < own.x && other.x + other.width >= own.x - 1) edges.left = false;
+    if (vertical && other.x <= own.x + own.width + 1 && other.x + other.width > own.x + own.width) edges.right = false;
+    if (horizontal && other.y < own.y && other.y + other.height >= own.y - 1) edges.bottom = false;
+    if (horizontal && other.y <= own.y + own.height + 1 && other.y + other.height > own.y + own.height) edges.top = false;
+  }
+  return edges;
+}
+inline Rect AtFraction(Rect frame, Rect area, double x, double y) {
+  frame = Fit(frame, area);
+  const double mx = std::min(kMargin, (area.width - frame.width) / 2);
+  const double my = std::min(kMargin, (area.height - frame.height) / 2);
+  frame.x = area.x + mx + std::clamp(x, 0.0, 1.0) * std::max(0.0, area.width - frame.width - 2 * mx);
+  frame.y = area.y + my + std::clamp(y, 0.0, 1.0) * std::max(0.0, area.height - frame.height - 2 * my);
+  return frame;
+}
+struct TuckedPlacement {
+  Rect frame;
+  size_t screen;
+};
+inline std::optional<TuckedPlacement> ExteriorTuck(
+    Rect restore, std::span<const Screen> screens, size_t preferred, Side side) {
+  if (screens.empty() || side == Side::kNone) {
+    return std::nullopt;
+  }
+  preferred = std::min(preferred, screens.size() - 1);
+  const Rect desired = Tuck(restore, screens[preferred].frame,
+                            screens[preferred].work_area, side);
+  std::optional<TuckedPlacement> best;
+  double best_distance = 0;
+  for (size_t i = 0; i < screens.size(); ++i) {
+    const Rect frame = Tuck(restore, screens[i].frame, screens[i].work_area, side);
+    const double handle = std::min({kHandleWidth, Normalize(screens[i].frame).width,
+                                    frame.width});
+    Rect hidden = frame;
+    hidden.width -= handle;
+    if (side == Side::kRight) {
+      hidden.x += handle;
+    }
+    bool exposed = false;
+    for (size_t j = 0; j < screens.size(); ++j) {
+      const Rect other = Normalize(screens[j].frame);
+      if (j != i && hidden.width > 0 && hidden.height > 0 &&
+          hidden.x < other.x + other.width && hidden.x + hidden.width > other.x &&
+          hidden.y < other.y + other.height && hidden.y + hidden.height > other.y) {
+        exposed = true;
+        break;
+      }
+    }
+    if (exposed) {
+      continue;
+    }
+    const double distance = std::hypot(frame.x - desired.x, frame.y - desired.y);
+    if (!best || distance < best_distance) {
+      best = TuckedPlacement{frame, i};
+      best_distance = distance;
+    }
+  }
+  return best;
+}
+inline Rect Resize(Rect r,
+                   Rect area,
+                   double aspect,
+                   double width,
+                   SizeLimits limits = {}) {
+  area = Normalize(area);
+  r = Normalize(r);
+  width = std::isfinite(width) ? width : r.width;
+  aspect = std::isfinite(aspect) && aspect > 0 ? aspect : 16.0 / 9.0;
+  double height;
+  if (area.width < limits.minimum_width ||
+      area.height < limits.minimum_height) {
+    width = std::clamp(width, 0.0, std::min(area.width, area.height * aspect));
+    height = width / aspect;
+  } else {
+    const double maximum_width = std::min(
+        area.width, std::max(limits.minimum_width, limits.maximum_width));
+    const double maximum_height = std::min(
+        area.height, std::max(limits.minimum_height, limits.maximum_height));
+    width = std::clamp(width, limits.minimum_width, maximum_width);
+    height = std::clamp(width / aspect, limits.minimum_height, maximum_height);
+    width = std::clamp(height * aspect, limits.minimum_width, maximum_width);
+  }
+  const double top = r.y + r.height;
+  r.width = width;
+  r.height = height;
+  r.y = top - height;
+  return ClampPosition(r, area);
+}
+}  // namespace arcium::pip::geometry
+#endif
