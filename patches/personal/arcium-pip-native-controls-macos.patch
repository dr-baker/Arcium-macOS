+void VideoOverlayWindowViews::SampleNativeControlsBrightness(
+    const arcium::pip::ContrastRequest& regions,
+    base::OnceCallback<void(arcium::pip::ContrastSamples)> callback) {
+  using namespace arcium::pip;
+  auto* layer = video_view_ ? video_view_->layer() : nullptr;
+  if (!layer || !GetCompositor() || !IsVisible() || layer->bounds().IsEmpty() ||
+      !native_controls_host_ || native_controls_host_->size().IsEmpty()) {
+    std::move(callback).Run({});
+    return;
+  }
+  const gfx::Rect video_bounds = video_view_->bounds();
+  const gfx::Size host_size = native_controls_host_->size();
+  // One video-only copy serves every button. Downsample before CPU access;
+  // native controls and other browser contents never enter the sample.
+  auto request = std::make_unique<viz::CopyOutputRequest>(
+      viz::CopyOutputRequest::ResultFormat::RGBA,
+      viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+      base::BindOnce([](base::WeakPtr<VideoOverlayWindowViews> window,
+                        ContrastRequest regions, gfx::Rect video_bounds,
+                        gfx::Size host_size,
+                        base::OnceCallback<void(ContrastSamples)> callback,
+                        std::unique_ptr<viz::CopyOutputResult> result) {
+        if (!window || !window->native_controls_host_ ||
+            window->video_view_->bounds() != video_bounds ||
+            window->native_controls_host_->size() != host_size || result->IsEmpty()) {
+          std::move(callback).Run({}); return;
+        }
+        auto pixels = result->ScopedAccessSkBitmap();
+        const auto& bitmap = pixels.bitmap();
+        if (bitmap.width() != kContrastWidth || bitmap.height() != kContrastHeight) {
+          std::move(callback).Run({}); return;
+        }
+        std::array<float, kContrastWidth * kContrastHeight> luminance;
+        for (int y = 0; y < bitmap.height(); ++y)
+          for (int x = 0; x < bitmap.width(); ++x) {
+            const SkColor color = bitmap.getColor(x, y);
+            luminance[y * kContrastWidth + x] =
+                (.2126 * SkColorGetR(color) + .7152 * SkColorGetG(color) +
+                 .0722 * SkColorGetB(color)) / 255.0;
+          }
+        const ContrastRegion video{
+            double(video_bounds.x()) / host_size.width(),
+            double(video_bounds.y()) / host_size.height(),
+            double(video_bounds.width()) / host_size.width(),
+            double(video_bounds.height()) / host_size.height()};
+        std::move(callback).Run(MeasureButtonContrast(regions, video, luminance));
+      }, weak_factory_.GetWeakPtr(), regions, video_bounds, host_size, std::move(callback)));
+  request->set_result_task_runner(base::SingleThreadTaskRunner::GetCurrentDefault());
+  // ui::Layer transforms area and scale together into device coordinates.
+  const gfx::Size source = layer->bounds().size();
+  request->set_area(gfx::Rect(source));
+  request->SetScaleRatio(gfx::Vector2d(source.width(), source.height()),
+                        {kContrastWidth, kContrastHeight});
+  request->set_result_selection(gfx::Rect(kContrastWidth, kContrastHeight));
+  layer->RequestCopyOfOutput(std::move(request));
+}
+
+void VideoOverlayWindowViews::RefreshNativeControls() {
+  if (!native_controls_widget_ || !native_controls_host_ ||
+      !native_controls_host_->native_view())
+    return;
+  const bool was_active = native_controls_active_;
+  native_controls_active_ = native_controls_widget_->RefreshNativeControls();
+  if (!native_controls_active_)
+    native_controls_widget_->ReleaseNativeControlsFocus();
+  native_controls_host_->SetVisible(native_controls_active_);
+  if (!native_controls_active_ && !was_active)
+    return;
+  fade_animation_.reset();
+  title_and_top_scrim_fade_animation_.reset();
+  controls_container_view_->SetVisible(!native_controls_active_ && native_controls_visible_);
+  title_view_->SetVisible(!native_controls_active_ && native_title_visible_);
+  const float controls_opacity =
+      !native_controls_active_ && native_controls_visible_ ? 1.0f : 0.0f;
+  const float title_opacity =
+      !native_controls_active_ && native_title_visible_ ? 1.0f : 0.0f;
+  for (views::View* view : {controls_container_view_.get(),
+                           controls_scrim_view_.get(),
+                           controls_bottom_scrim_view_.get()}) {
+    view->layer()->SetOpacity(controls_opacity);
+  }
+  title_view_->layer()->SetOpacity(title_opacity);
+  controls_top_scrim_view_->layer()->SetOpacity(title_opacity);
+}
+
+void VideoOverlayWindowViews::FocusNativeControls(bool reverse) {
+  if (native_controls_active_ && native_controls_widget_)
+    native_controls_widget_->FocusNativeControls(reverse);
+}
+
+void VideoOverlayWindowViews::DetachNativeControlsHost() {
+  auto* host = std::exchange(native_controls_host_, nullptr).get();
+  native_controls_active_ = false;
+  if (!host) return;
+  host->SetFocusBehavior(views::View::FocusBehavior::NEVER);
+  auto* focus = GetFocusManager();
+  if (focus && (focus->GetFocusedView() == host || focus->GetStoredFocusView() == host)) {
+    focus->SetFocusedView(nullptr);
+    focus->SetStoredFocusView(nullptr);
+  }
+  if (native_controls_widget_) {
+    native_controls_widget_->ReleaseNativeControlsFocus();
+    native_controls_widget_->SetNativeControlsAccessibilityParent({});
+  }
+  host->SetVisible(false);
+  if (host->native_view()) host->Detach();
+  controls_container_view_->SetVisible(native_controls_visible_);
+  title_view_->SetVisible(native_title_visible_);
+}
