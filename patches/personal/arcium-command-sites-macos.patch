+private struct ArciumCommandSitesEditor: View {
+    @ObservedObject var store: ArciumSettingsStore
+    @State private var editing: ArciumCommandSite?
+    @Environment(\.settingsTheme) private var theme
+
+    private var sites: ArciumCommandSites { store.snapshot.appearance.commandSites }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            Text("Each site gets a scope in the command bar. It searches the site and lists matching tabs, saved items and shortcuts.")
+                .settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+            VStack(spacing: 0) {
+                let all = sites.sites
+                ForEach(Array(all.enumerated()), id: \.element.id) { index, site in
+                    row(site, index: index, count: all.count)
+                    if index < all.count - 1 { Divider() }
+                }
+            }
+            .padding(.horizontal, 12)
+            .settingsInteractiveControlSurface(isSelected: false)
+            HStack {
+                Button("Add Site…") {
+                    editing = ArciumCommandSite(id: "", label: "")
+                }
+                .disabled(sites.customs.count >= ArciumCommandSites.maxCustom
+                          || sites.visibleCount >= ArciumCommandSites.maxVisible)
+                .accessibilityIdentifier("command-bar-sites-add")
+                Spacer()
+                Text("\(sites.visibleCount) of \(ArciumCommandSites.maxVisible) shown")
+                    .settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+            }
+        }
+        .disabled(!store.canEditCommandSites)
+        .sheet(item: $editing) { site in
+            ArciumCommandSiteEditor(store: store, site: site,
+                                    defaults: sites.builtins.first { $0.id == site.id })
+        }
+    }
+
+    private func row(_ site: ArciumCommandSite, index: Int, count: Int) -> some View {
+        let visible = !sites.hidden.contains(site.id)
+        return HStack(spacing: 10) {
+            Toggle(isOn: Binding(get: { visible },
+                                 set: { store.setCommandSites(sites.setting(site.id, visible: $0)) })) {
+                EmptyView()
+            }
+            .labelsHidden()
+            .toggleStyle(.switch)
+            .controlSize(.small)
+            .disabled(!visible && sites.visibleCount >= ArciumCommandSites.maxVisible)
+            .accessibilityLabel("Show \(site.label)")
+            VStack(alignment: .leading, spacing: 2) {
+                Text(site.label).settingsFont(\.body).foregroundStyle(theme.textPrimary)
+                Text(rowDetail(site)).settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+            }
+            Spacer()
+            Button("Edit…") { editing = site }
+                .accessibilityIdentifier("command-bar-site-edit-" + site.id)
+            Menu {
+                Button("Move Up") { store.setCommandSites(sites.moving(site.id, by: -1)) }
+                    .disabled(index == 0)
+                Button("Move Down") { store.setCommandSites(sites.moving(site.id, by: 1)) }
+                    .disabled(index == count - 1)
+                Divider()
+                if site.builtin {
+                    Button("Restore Defaults") { store.setCommandSites(sites.removing(site.id)) }
+                        .disabled(!sites.isCustomized(site.id))
+                } else {
+                    Button("Delete", role: .destructive) { store.setCommandSites(sites.removing(site.id)) }
+                }
+            } label: {
+                Image(systemName: "ellipsis.circle")
+            }
+            .menuStyle(.button)
+            .buttonStyle(.borderless)
+            .menuIndicator(.hidden)
+            .fixedSize()
+            .accessibilityLabel("More for \(site.label)")
+        }
+        .padding(.vertical, 8)
+    }
+
+    private func rowDetail(_ site: ArciumCommandSite) -> String {
+        let shortcuts = site.shortcuts.count == 1 ? "1 shortcut" : "\(site.shortcuts.count) shortcuts"
+        return [site.detail, shortcuts].filter { !$0.isEmpty }.joined(separator: " · ")
+    }
+}
