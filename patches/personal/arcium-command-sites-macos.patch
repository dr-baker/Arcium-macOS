Index: src/chrome/browser/ui/cocoa/arcium_settings_swift/Tests/ArciumSettingsUITests/ArciumCommandSitesTests.swift
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/cocoa/arcium_settings_swift/Tests/ArciumSettingsUITests/ArciumCommandSitesTests.swift
@@ -0,0 +1,172 @@
+import XCTest
+@testable import ArciumSettingsUI
+
+final class ArciumCommandSitesTests: XCTestCase {
+    private final class Delegate: NSObject, ArciumSettingsUIDelegate {
+        var settings: [(key: String, value: Any)] = []
+        var actions: [(name: String, payload: NSDictionary)] = []
+        func settingChanged(key: String, value: Any) { settings.append((key, value)) }
+        func actionInvoked(name: String, payload: NSDictionary) { actions.append((name, payload)) }
+    }
+
+    private static var builtins: [[String: Any]] { [
+        ["id": "youtube", "label": "YouTube", "domains": ["youtube.com", "youtu.be"],
+         "search": "https://www.youtube.com/results?search_query=%s", "verb": "search",
+         "tint": "#e34b49",
+         "shortcuts": [["title": "Subscriptions", "url": "https://www.youtube.com/feed/subscriptions"]]],
+        ["id": "x", "label": "X", "domains": ["x.com"], "search": "https://x.com/search?q=%s",
+         "verb": "search", "tint": "#748ca6",
+         "shortcuts": [["title": "Home", "url": "https://x.com/home"]]],
+        ["id": "chatgpt", "label": "ChatGPT", "domains": ["chatgpt.com"],
+         "search": "https://chatgpt.com/?q=%s", "verb": "ask", "tint": "#53a98c",
+         "shortcuts": [["title": "New chat", "url": "https://chatgpt.com/"]]],
+    ] }
+
+    private func sites(_ saved: [String: Any] = [:]) -> ArciumCommandSites {
+        ArciumCommandSites(["builtins": Self.builtins, "sites": saved])
+    }
+
+    func testDefaultsListBuiltinsInOrderAndWriteNothing() {
+        let sites = sites()
+        XCTAssertEqual(sites.sites.map(\.id), ["youtube", "x", "chatgpt"])
+        XCTAssertEqual(sites.visibleSummary, "YouTube, X, ChatGPT")
+        XCTAssertTrue(sites.dictionary.isEmpty)
+        XCTAssertEqual(sites.site("chatgpt")?.verb, "ask")
+    }
+
+    func testSavedOrderHiddenOverridesAndCustomSitesResolve() {
+        let sites = sites([
+            "order": ["chatgpt", "docs", "missing"],
+            "hidden": ["x", "missing"],
+            "sites": [
+                "youtube": ["label": "Videos"],
+                "docs": ["label": "Docs", "domains": ["docs.rs"]],
+            ],
+        ])
+        XCTAssertEqual(sites.sites.map(\.id), ["chatgpt", "docs", "youtube", "x"])
+        XCTAssertEqual(sites.hidden, ["x"])
+        XCTAssertEqual(sites.site("youtube")?.label, "Videos")
+        XCTAssertEqual(sites.site("youtube")?.shortcuts.count, 1)
+        XCTAssertTrue(sites.isCustomized("youtube"))
+        XCTAssertEqual(sites.visibleSummary, "ChatGPT, Docs, Videos")
+        XCTAssertEqual(sites.visibleCount, 3)
+    }
+
+    func testBuiltinEditsWriteOnlyChangedFields() {
+        var youtube = sites().site("youtube")!
+        youtube.label = "YouTube"
+        var written = sites().replacing(youtube).dictionary
+        XCTAssertTrue(written.isEmpty)
+
+        youtube.label = " Videos "
+        youtube.shortcuts.append(ArciumCommandSiteShortcut(title: "Later", url: "https://www.youtube.com/playlist?list=WL"))
+        written = sites().replacing(youtube).dictionary
+        let entry = (written["sites"] as? [String: Any])?["youtube"] as? [String: Any]
+        XCTAssertEqual(entry?["label"] as? String, "Videos")
+        XCTAssertNil(entry?["tint"])
+        XCTAssertEqual((entry?["shortcuts"] as? [[String: Any]])?.count, 2)
+        XCTAssertNil(entry?["search"])
+        XCTAssertNil(entry?["domains"])
+
+        let restored = ArciumCommandSites(["builtins": Self.builtins, "sites": written]).removing("youtube")
+        XCTAssertTrue(restored.dictionary.isEmpty)
+    }
+
+    func testVisibilityOrderAndDeletion() {
+        var sites = sites(["sites": ["docs": ["label": "Docs", "domains": ["docs.rs"]]]])
+        sites = sites.setting("x", visible: false)
+        XCTAssertEqual(sites.dictionary["hidden"] as? [String], ["x"])
+        sites = sites.moving("docs", by: -3)
+        XCTAssertEqual(sites.dictionary["order"] as? [String], ["docs", "youtube", "x", "chatgpt"])
+        sites = sites.setting("docs", visible: false).removing("docs")
+        XCTAssertEqual(sites.dictionary["order"] as? [String], ["youtube", "x", "chatgpt"])
+        XCTAssertEqual(sites.dictionary["hidden"] as? [String], ["x"])
+        XCTAssertNil(sites.dictionary["sites"])
+        sites = sites.setting("x", visible: true)
+        XCTAssertNil(sites.dictionary["hidden"])
+    }
+
+    func testCustomSiteValidation() {
+        var site = ArciumCommandSite(id: "", label: "Docs")
+        XCTAssertFalse(site.isValid)
+        site.domains = ["docs.rs"]
+        XCTAssertTrue(site.isValid)
+        for template in ["https://docs.rs/%s", "https://%s.docs.rs/", "https://docs.rs/?q=%s&r=%s",
+                         "javascript:alert(%s)", "https://docs.rs/?%s", "https://docs.rs/#q=%s"] {
+            site.search = template
+            XCTAssertFalse(site.isValid, template)
+        }
+        site.search = "https://docs.rs/releases/search?query=%s"
+        XCTAssertTrue(site.isValid)
+        site.domains = ["Docs.rs"]
+        XCTAssertFalse(site.isValid)
+        site.domains = []
+        XCTAssertTrue(site.isValid)
+        site.shortcuts = [ArciumCommandSiteShortcut(title: "Bad", url: "file:///etc/hosts")]
+        XCTAssertFalse(site.isValid)
+        site.shortcuts = [ArciumCommandSiteShortcut(title: "Releases", url: "https://docs.rs/releases"),
+                          ArciumCommandSiteShortcut(title: "Again", url: "https://docs.rs/releases")]
+        XCTAssertFalse(site.isValid)
+        site.shortcuts = [ArciumCommandSiteShortcut(title: "Root", url: "https://Docs.rs"),
+                          ArciumCommandSiteShortcut(title: "Slash", url: "https://docs.rs:443/")]
+        XCTAssertFalse(site.isValid)
+        site.shortcuts = [ArciumCommandSiteShortcut(title: "Releases", url: "https://docs.rs/releases")]
+        XCTAssertTrue(site.isValid)
+        site.label = String(repeating: "🙂", count: 21)
+        XCTAssertFalse(site.isValid)
+        site.label = String(repeating: "🙂", count: 20)
+        XCTAssertTrue(site.isValid)
+        site.label = "Docs"
+        for domain in ["192.168.0.1", "docs.123", "dócs.rs", "[::1]"] {
+            site.domains = [domain]
+            XCTAssertFalse(site.isValid, domain)
+        }
+        site.domains = []
+        site.search = "https://127.0.0.1/?q=%s"
+        XCTAssertFalse(site.isValid)
+        site.search = "https://docs.rs/releases/search?query=%s"
+        XCTAssertEqual(site.customDictionary["search"] as? String, "https://docs.rs/releases/search?query=%s")
+        XCTAssertNil(site.customDictionary["tint"])
+        XCTAssertNil(site.customDictionary["verb"])
+    }
+
+    func testSaveIsAcceptedOnlyWhenTheBrowserPublishesIt() {
+        var youtube = sites().site("youtube")!
+        youtube.label = "Videos"
+        let expected = sites().replacing(youtube)
+        XCTAssertTrue(ArciumCommandSiteSave.edited(expected).accepted(by: expected))
+        XCTAssertFalse(ArciumCommandSiteSave.edited(expected).accepted(by: sites()))
+        let added = sites(["sites": ["site-1": ["label": "Docs", "domains": ["docs.rs"]]]])
+        XCTAssertTrue(ArciumCommandSiteSave.added(before: []).accepted(by: added))
+        XCTAssertFalse(ArciumCommandSiteSave.added(before: ["site-1"]).accepted(by: added))
+    }
+
+    @MainActor
+    func testStoreSendsSparseSitesAndAddsThroughTheBrowser() {
+        let delegate = Delegate()
+        let store = ArciumSettingsStore(snapshot: ["available": true, "appearance": [
+            "commandSitesAvailable": true,
+            "commandSites": ["builtins": Self.builtins, "sites": ["hidden": ["x"]]],
+        ]], delegate: delegate)
+        XCTAssertEqual(store.snapshot.appearance.commandSites.hidden, ["x"])
+        store.setCommandSites(store.snapshot.appearance.commandSites.setting("x", visible: true))
+        XCTAssertEqual(delegate.settings.map(\.key), ["command_sites"])
+        XCTAssertTrue((delegate.settings.first?.value as? [String: Any])?.isEmpty ?? false)
+
+        var site = ArciumCommandSite(id: "", label: "Docs")
+        site.domains = ["docs.rs"]
+        store.addCommandSite(site)
+        XCTAssertEqual(delegate.actions.map(\.name), ["add_command_site"])
+        XCTAssertEqual(delegate.actions.first?.payload["label"] as? String, "Docs")
+        store.addCommandSite(ArciumCommandSite(id: "", label: ""))
+        XCTAssertEqual(delegate.actions.count, 1)
+
+        let managed = ArciumSettingsStore(snapshot: ["available": true, "appearance": [
+            "commandSitesAvailable": true, "commandSitesManaged": true,
+        ]], delegate: delegate)
+        managed.setCommandSites(ArciumCommandSites())
+        managed.addCommandSite(site)
+        XCTAssertEqual(delegate.settings.count, 1)
+        XCTAssertEqual(delegate.actions.count, 1)
+    }
+}
