+// The Sites row of command bar Settings; the caller supplies the Section.
+struct ArciumCommandSitesSummary: View {
+    @ObservedObject var store: ArciumSettingsStore
+    @State private var showingEditor = false
+    @Environment(\.settingsTheme) private var theme
+
+    var body: some View {
+        HStack(alignment: .firstTextBaseline) {
+            VStack(alignment: .leading, spacing: 2) {
+                Text("Scopes").settingsFont(\.body).foregroundStyle(theme.textPrimary)
+                Text(store.snapshot.appearance.commandSites.visibleSummary)
+                    .settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+                    .lineLimit(2)
+            }
+            Spacer()
+            Button("Edit…") { showingEditor = true }
+                .accessibilityIdentifier("command-bar-sites-edit")
+        }
+        .disabled(!store.canEditCommandSites)
+        .sheet(isPresented: $showingEditor) {
+            ArciumLiveSettingsSheet(title: "Sites", minimumHeight: 380, idealHeight: 540) {
+                ArciumCommandSitesEditor(store: store)
+            }
+        }
+    }
+}
