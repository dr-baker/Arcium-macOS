+private struct ArciumCommandSiteEditor: View {
+    @ObservedObject var store: ArciumSettingsStore
+    @State var site: ArciumCommandSite
+    let defaults: ArciumCommandSite?
+    @State private var domainsText: String
+    // The browser validates every write. Keep the draft open until a snapshot
+    // shows the saved site, and say so if the browser rejected it.
+    @State private var pending: ArciumCommandSiteSave?
+    @State private var rejected = false
+    @Environment(\.dismiss) private var dismiss
+    @Environment(\.settingsTheme) private var theme
+
+    init(store: ArciumSettingsStore, site: ArciumCommandSite, defaults: ArciumCommandSite?) {
+        self.store = store
+        _site = State(initialValue: site)
+        _domainsText = State(initialValue: site.domains.joined(separator: ", "))
+        self.defaults = defaults
+    }
+
+    private func save() {
+        let sites = store.snapshot.appearance.commandSites
+        let draft = edited
+        rejected = false
+        if draft.id.isEmpty {
+            pending = .added(before: Set(sites.customs.keys))
+            store.addCommandSite(draft)
+        } else {
+            let expected = sites.replacing(draft)
+            pending = .edited(expected)
+            store.setCommandSites(expected)
+        }
+    }
+
+    private func settle(_ sites: ArciumCommandSites) {
+        guard let pending else { return }
+        self.pending = nil
+        if pending.accepted(by: sites) {
+            dismiss()
+        } else {
+            rejected = true
+        }
+    }
+
+    private var edited: ArciumCommandSite {
+        var result = site
+        if !result.builtin {
+            result.domains = domainsText.split(separator: ",")
+                .map { $0.trimmingCharacters(in: .whitespaces).lowercased() }
+                .filter { !$0.isEmpty }
+            result.search = result.search.trimmingCharacters(in: .whitespaces)
+        }
+        result.shortcuts = result.shortcuts.map {
+            ArciumCommandSiteShortcut(title: $0.title.trimmingCharacters(in: .whitespaces),
+                                      url: $0.url.trimmingCharacters(in: .whitespaces))
+        }
+        return result
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            Text(site.id.isEmpty ? "Add Site" : site.label)
+                .settingsFont(\.section).foregroundStyle(theme.textPrimary)
+                .padding(.horizontal, 24).padding(.vertical, 16)
+            ScrollView {
+                VStack(alignment: .leading, spacing: 14) {
+                    LabeledContent("Name") {
+                        TextField("Name", text: $site.label, prompt: Text("Docs"))
+                            .labelsHidden()
+                            .accessibilityIdentifier("command-bar-site-name")
+                    }
+                    if site.builtin {
+                        LabeledContent("Searches") {
+                            Text(site.search.replacingOccurrences(of: "%s", with: "…"))
+                                .settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+                                .textSelection(.enabled)
+                        }
+                    } else {
+                        LabeledContent("Domains") {
+                            TextField("Domains", text: $domainsText, prompt: Text("docs.rs, crates.io"))
+                                .labelsHidden()
+                                .accessibilityIdentifier("command-bar-site-domains")
+                        }
+                        LabeledContent("Search URL") {
+                            TextField("Search URL", text: $site.search,
+                                      prompt: Text("https://example.com/search?q=%s"))
+                                .labelsHidden()
+                                .accessibilityIdentifier("command-bar-site-search")
+                        }
+                        Picker("Typing", selection: $site.verb) {
+                            Text("Searches the site").tag("search")
+                            Text("Asks the site").tag("ask")
+                        }
+                        Text("Tabs on these domains appear in the scope. Use %s where the query goes.")
+                            .settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+                    }
+                    Divider()
+                    Text("Shortcuts").settingsFont(\.body).foregroundStyle(theme.textPrimary)
+                    Text("Shown when the scope opens with nothing typed.")
+                        .settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+                    ForEach(site.shortcuts.indices, id: \.self) { index in
+                        HStack {
+                            TextField("Title", text: $site.shortcuts[index].title)
+                                .frame(width: 150)
+                                .accessibilityLabel("Shortcut \(index + 1) title")
+                            TextField("URL", text: $site.shortcuts[index].url,
+                                      prompt: Text("https://"))
+                                .accessibilityLabel("Shortcut \(index + 1) URL")
+                            Button {
+                                site.shortcuts.remove(at: index)
+                            } label: {
+                                Image(systemName: "minus.circle")
+                            }
+                            .buttonStyle(.borderless)
+                            .accessibilityLabel("Remove shortcut \(index + 1)")
+                        }
+                    }
+                    HStack {
+                        Button("Add Shortcut") {
+                            site.shortcuts.append(ArciumCommandSiteShortcut(title: "", url: "https://"))
+                        }
+                        .disabled(site.shortcuts.count >= ArciumCommandSite.maxShortcuts)
+                        if let defaults {
+                            Button("Restore Default Shortcuts") { site.shortcuts = defaults.shortcuts }
+                                .disabled(site.shortcuts == defaults.shortcuts)
+                        }
+                    }
+                }
+                .padding(.horizontal, 24).padding(.vertical, 8)
+            }
+            HStack {
+                if rejected {
+                    Text("Arcium couldn't save this site. Check its links and try again.")
+                        .settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+                        .accessibilityIdentifier("command-bar-site-rejected")
+                } else if !edited.isValid {
+                    Text("Check the name, domains, search URL and shortcut links.")
+                        .settingsFont(\.caption).foregroundStyle(theme.textSecondary)
+                }
+                Spacer()
+                Button("Cancel") { dismiss() }
+                    .keyboardShortcut(.cancelAction)
+                Button(site.id.isEmpty ? "Add" : "Save") { save() }
+                    .keyboardShortcut(.defaultAction)
+                    .disabled(!edited.isValid || pending != nil)
+                    .accessibilityIdentifier("command-bar-site-save")
+            }
+            .padding(.horizontal, 24).padding(.vertical, 16)
+        }
+        .settingsSheetSurface()
+        .frame(minWidth: 520, idealWidth: 600, minHeight: 360, idealHeight: 480)
+        // The host republishes after every site write, accepted or not.
+        .onReceive(store.$snapshot.dropFirst()) { settle($0.appearance.commandSites) }
+    }
+}
+
+nonisolated enum ArciumCommandSiteSave: Equatable, Sendable {
+    case added(before: Set<String>)
+    case edited(ArciumCommandSites)
+
+    func accepted(by sites: ArciumCommandSites) -> Bool {
+        switch self {
+        case .added(let before):
+            return !Set(sites.customs.keys).subtracting(before).isEmpty
+        case .edited(let expected):
+            return NSDictionary(dictionary: expected.dictionary).isEqual(to: sites.dictionary)
+        }
+    }
