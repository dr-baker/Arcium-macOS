+nonisolated struct ArciumCommandSites: Equatable, Sendable {
+    static let maxVisible = 8
+    static let maxCustom = 8
+
+    nonisolated struct Override: Equatable, Sendable {
+        var label: String?
+        var tint: String?
+        var shortcuts: [ArciumCommandSiteShortcut]?
+    }
+
+    var builtins: [ArciumCommandSite] = []
+    var order: [String]?
+    var hidden: [String] = []
+    var overrides: [String: Override] = [:]
+    var customs: [String: ArciumCommandSite] = [:]
+
+    init() {}
+
+    init(_ dictionary: [String: Any]) {
+        builtins = (dictionary["builtins"] as? [Any] ?? []).compactMap { value in
+            guard let item = value as? [String: Any], let id = item["id"] as? String else { return nil }
+            return ArciumCommandSite(id: id, item, builtin: true)
+        }
+        let saved = dictionary["sites"] as? [String: Any] ?? [:]
+        for (id, value) in saved["sites"] as? [String: Any] ?? [:] {
+            guard let item = value as? [String: Any] else { continue }
+            if builtins.contains(where: { $0.id == id }) {
+                overrides[id] = Override(
+                    label: item["label"] as? String, tint: item["tint"] as? String,
+                    shortcuts: (item["shortcuts"] as? [Any]).map {
+                        $0.compactMap(ArciumCommandSiteShortcut.init)
+                    })
+            } else if let site = ArciumCommandSite(id: id, item, builtin: false) {
+                customs[id] = site
+            }
+        }
+        let known = Set(builtins.map(\.id)).union(customs.keys)
+        order = (saved["order"] as? [Any])?.compactMap { $0 as? String }.filter(known.contains)
+        hidden = (saved["hidden"] as? [Any] ?? []).compactMap { $0 as? String }.filter(known.contains)
+    }
+
+    /// Every editable site in rail order, including hidden ones.
+    var sites: [ArciumCommandSite] {
+        var ids: [String] = []
+        for id in (order ?? []) + builtins.map(\.id) + customs.keys.sorted() where !ids.contains(id) {
+            ids.append(id)
+        }
+        return ids.compactMap(site)
+    }
+
+    var visibleCount: Int { sites.filter { !hidden.contains($0.id) }.count }
+    var visibleSummary: String {
+        let labels = sites.filter { !hidden.contains($0.id) }.map(\.label)
+        return labels.isEmpty ? "No sites" : labels.joined(separator: ", ")
+    }
+
+    func site(_ id: String) -> ArciumCommandSite? {
+        if let custom = customs[id] { return custom }
+        guard var site = builtins.first(where: { $0.id == id }) else { return nil }
+        if let override = overrides[id] {
+            site.label = override.label ?? site.label
+            site.tint = override.tint ?? site.tint
+            site.shortcuts = override.shortcuts ?? site.shortcuts
+        }
+        return site
+    }
+
+    func isCustomized(_ id: String) -> Bool { overrides[id] != nil }
+
+    // MARK: Edits. Each returns the complete sparse preference to write.
+
+    func setting(_ id: String, visible: Bool) -> ArciumCommandSites {
+        var copy = self
+        copy.hidden.removeAll { $0 == id }
+        if !visible { copy.hidden.append(id) }
+        return copy
+    }
+
+    func moving(_ id: String, by offset: Int) -> ArciumCommandSites {
+        var ids = sites.map(\.id)
+        guard let index = ids.firstIndex(of: id) else { return self }
+        let target = min(max(index + offset, 0), ids.count - 1)
+        ids.remove(at: index)
+        ids.insert(id, at: target)
+        var copy = self
+        copy.order = ids
+        return copy
+    }
+
+    func replacing(_ site: ArciumCommandSite) -> ArciumCommandSites {
+        var copy = self
+        guard site.builtin else {
+            copy.customs[site.id] = site
+            return copy
+        }
+        guard let defaults = builtins.first(where: { $0.id == site.id }) else { return self }
+        let label = site.label.trimmingCharacters(in: .whitespaces)
+        let override = Override(
+            label: label == defaults.label ? nil : label,
+            tint: site.tint == defaults.tint ? nil : site.tint,
+            shortcuts: site.shortcuts == defaults.shortcuts ? nil : site.shortcuts)
+        copy.overrides[site.id] = override == Override() ? nil : override
+        return copy
+    }
+
+    /// Deletes a custom site, or restores a built-in site's defaults.
+    func removing(_ id: String) -> ArciumCommandSites {
+        var copy = self
+        if copy.customs.removeValue(forKey: id) != nil {
+            copy.order?.removeAll { $0 == id }
+            copy.hidden.removeAll { $0 == id }
+        } else {
+            copy.overrides[id] = nil
+        }
+        return copy
+    }
+
+    var dictionary: [String: Any] {
+        var result: [String: Any] = [:]
+        if let order { result["order"] = order }
+        if !hidden.isEmpty { result["hidden"] = hidden }
+        var entries: [String: Any] = [:]
+        for (id, override) in overrides {
+            var item: [String: Any] = [:]
+            if let label = override.label { item["label"] = label }
+            if let tint = override.tint { item["tint"] = tint }
+            if let shortcuts = override.shortcuts { item["shortcuts"] = shortcuts.map(\.dictionary) }
+            entries[id] = item
+        }
+        for (id, site) in customs { entries[id] = site.customDictionary }
+        if !entries.isEmpty { result["sites"] = entries }
+        return result
+    }
+}
+
+extension ArciumSettingsStore {
+    var canEditCommandSites: Bool {
+        snapshot.appearance.commandSitesAvailable && !snapshot.appearance.commandSitesManaged
+    }
+
+    func setCommandSites(_ sites: ArciumCommandSites) {
+        guard canEditCommandSites else { return }
+        settingChanged(key: "command_sites", value: sites.dictionary)
+    }
+
+    func addCommandSite(_ site: ArciumCommandSite) {
+        guard canEditCommandSites, !site.builtin, site.isValid else { return }
+        actionInvoked(name: "add_command_site", payload: site.customDictionary)
+    }
+}
