+// Mirrors the sparse "arcium.command_bar.sites" preference. The browser owns
+// validation; this editor never writes resolved built-in defaults back.
+nonisolated struct ArciumCommandSiteShortcut: Equatable, Hashable, Sendable {
+    var title: String
+    var url: String
+
+    init(title: String, url: String) {
+        self.title = title
+        self.url = url
+    }
+
+    init?(_ value: Any?) {
+        guard let dictionary = value as? [String: Any],
+              let title = dictionary["title"] as? String,
+              let url = dictionary["url"] as? String else { return nil }
+        self.init(title: title, url: url)
+    }
+
+    var dictionary: [String: Any] { ["title": title, "url": url] }
+    var isValid: Bool { ArciumCommandSite.isLabel(title) && ArciumCommandSite.isWebURL(url) }
+}
+
+nonisolated struct ArciumCommandSite: Equatable, Identifiable, Sendable {
+    static let maxShortcuts = 8
+    static let maxDomains = 4
+
+    var id: String
+    var label: String
+    var domains: [String] = []
+    var search = ""
+    var verb = "search"
+    var tint = ""
+    var shortcuts: [ArciumCommandSiteShortcut] = []
+    var builtin = false
+
+    init(id: String, label: String, builtin: Bool = false) {
+        self.id = id
+        self.label = label
+        self.builtin = builtin
+    }
+
+    init?(id: String, _ dictionary: [String: Any], builtin: Bool) {
+        guard let label = dictionary["label"] as? String else { return nil }
+        self.init(id: id, label: label, builtin: builtin)
+        domains = (dictionary["domains"] as? [Any] ?? []).compactMap { $0 as? String }
+        search = dictionary["search"] as? String ?? ""
+        verb = dictionary["verb"] as? String == "ask" ? "ask" : "search"
+        tint = dictionary["tint"] as? String ?? ""
+        shortcuts = (dictionary["shortcuts"] as? [Any] ?? []).compactMap(ArciumCommandSiteShortcut.init)
+    }
+
+    var detail: String {
+        if let domain = domains.first { return domain }
+        return URL(string: search.replacingOccurrences(of: "%s", with: "q"))?.host() ?? ""
+    }
+
+    // Custom sites store every field; tint stays optional so the browser can
+    // assign its default color.
+    var customDictionary: [String: Any] {
+        var result: [String: Any] = ["label": label.trimmingCharacters(in: .whitespaces)]
+        if !domains.isEmpty { result["domains"] = domains }
+        if !search.isEmpty { result["search"] = search }
+        if verb == "ask" { result["verb"] = verb }
+        if !tint.isEmpty { result["tint"] = tint }
+        if !shortcuts.isEmpty { result["shortcuts"] = shortcuts.map(\.dictionary) }
+        return result
+    }
+
+    // The browser measures labels in UTF-16 code units after trimming.
+    static func isLabel(_ text: String) -> Bool {
+        let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        return !trimmed.isEmpty && trimmed.utf16.count <= 40
+    }
+
+    static func isWebURL(_ text: String) -> Bool {
+        guard text.utf8.count <= 2048, let url = URL(string: text),
+              let scheme = url.scheme?.lowercased(), scheme == "https" || scheme == "http",
+              let host = url.host(), !host.isEmpty else { return false }
+        return url.user() == nil && url.password() == nil
+    }
+
+    static func isIPAddress(_ host: String) -> Bool {
+        host.contains(":") || host.hasPrefix("[")
+            || host.split(separator: ".").last.map { $0.allSatisfy(\.isNumber) } == true
+    }
+
+    // Canonical ASCII hostnames only, as the browser requires.
+    static func isDomain(_ text: String) -> Bool {
+        let parts = text.split(separator: ".", omittingEmptySubsequences: false)
+        return parts.count >= 2 && text.utf8.count <= 253 && !isIPAddress(text)
+            && parts.allSatisfy { part in
+                !part.isEmpty && part.unicodeScalars.allSatisfy {
+                    ("a"..."z").contains($0) || ("0"..."9").contains($0) || $0 == "-"
+                }
+            }
+    }
+
+    /// Mirrors browser URL canonicalization for duplicate detection: case-
+    /// insensitive scheme and host, default ports dropped, empty path as "/".
+    static func canonicalURL(_ text: String) -> String {
+        guard var components = URLComponents(string: text) else { return text }
+        components.scheme = components.scheme?.lowercased()
+        components.host = components.host?.lowercased()
+        if (components.scheme == "https" && components.port == 443)
+            || (components.scheme == "http" && components.port == 80) {
+            components.port = nil
+        }
+        if components.path.isEmpty { components.path = "/" }
+        return components.string ?? text
+    }
+
+    // One %s, as a query value: "https://example.com/search?q=%s".
+    static func isSearchTemplate(_ text: String) -> Bool {
+        let pieces = text.components(separatedBy: "%s")
+        let probe = text.replacingOccurrences(of: "%s", with: "q")
+        guard pieces.count == 2, isWebURL(probe),
+              let host = URL(string: probe)?.host(), !isIPAddress(host),
+              let question = pieces[0].firstIndex(of: "?") else { return false }
+        return pieces[0].hasSuffix("=") && !pieces[0].contains("#")
+            && pieces[0].index(after: question) < pieces[0].index(before: pieces[0].endIndex)
+    }
+
+    /// Mirrors the browser's write rules closely enough to disable Save; the
+    /// browser still validates every write.
+    var isValid: Bool {
+        guard Self.isLabel(label),
+              shortcuts.count <= Self.maxShortcuts,
+              shortcuts.allSatisfy(\.isValid),
+              Set(shortcuts.map { Self.canonicalURL($0.url) }).count == shortcuts.count,
+              tint.isEmpty || tint.range(of: "^#[0-9a-fA-F]{6}$", options: .regularExpression) != nil
+        else { return false }
+        if builtin { return true }
+        return (!domains.isEmpty || !search.isEmpty)
+            && domains.count <= Self.maxDomains && domains.allSatisfy(Self.isDomain)
+            && Set(domains).count == domains.count
+            && (search.isEmpty || Self.isSearchTemplate(search))
+    }
+}
